--!strict
-- ARENAS
-- Every arena uses the same regulation-inspired field so spacing and muscle
-- memory carry over. Arenas differ in look, lighting, wind and (special
-- variants only) optional rebound walls. Ranked uses Competitive arenas, whose
-- wind is zero or light and always shown on the HUD.

export type Arena = {
	id: string,
	Display: string,
	Description: string,
	Theme: string,
	Competitive: boolean,
	Wind: Vector3, -- studs/s, constant for the whole match, flips with the teams
	Rebound: boolean,
	Ground: { Material: Enum.Material, A: Color3, B: Color3 },
	Surround: { Material: Enum.Material, Color: Color3 },
	LineColor: Color3,
	Lights: boolean,
	Crowd: number,
	Lighting: { [string]: any },
	Atmosphere: { [string]: any },
	ColorCorrection: { [string]: any },
	Bloom: { [string]: any },
}

