        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ArenaService</string>
            <string name="Source"><![CDATA[--!strict
-- ArenaService — current arena, field geometry and wind. Rebuilds the world
-- between matches.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArenasConfig = require(Shared.Config.Arenas)
local ModesConfig = require(Shared.Config.Modes)
local FieldGeometry = require(Shared.Rules.FieldGeometry)
local Net = require(Shared.Net)
local ArenaBuilder = require(script.Parent.Parent.Arena.ArenaBuilder)

local ArenaService = {}

local current: any = nil
local built: ArenaBuilder.Built? = nil
local field: FieldGeometry.Field? = nil
local fieldSpec: any = nil

function ArenaService.build(arenaId: string, fieldName: string)
	local arena = (ArenasConfig.List :: any)[arenaId] or ArenasConfig.List[ArenasConfig.Default]
	local spec = (ModesConfig.Fields :: any)[fieldName] or ModesConfig.Fields.Standard
	current = arena
	fieldSpec = spec
	built = ArenaBuilder.build(arena, spec, workspace)
	field = FieldGeometry.new({
		center = Vector3.new(0, 0, 0),
		width = spec.width,
		length = spec.length,
		endZone = spec.endZone,
		brick = spec.brick,
	})
	local state = Net.state()
	state:SetAttribute("Arena", arena.id)
	state:SetAttribute("ArenaName", arena.Display)
	state:SetAttribute("Wind", arena.Wind)
	state:SetAttribute("FieldWidth", spec.width)
	state:SetAttribute("FieldLength", spec.length)
	state:SetAttribute("FieldEndZone", spec.endZone)
	state:SetAttribute("FieldBrick", spec.brick)
end

function ArenaService.field(): FieldGeometry.Field
	assert(field, "arena not built")
	return field :: FieldGeometry.Field
end

function ArenaService.fieldSpec(): any
	return fieldSpec
end

function ArenaService.arena(): any
	return current
end

function ArenaService.wind(): { x: number, y: number, z: number }
	local w = if current then current.Wind else Vector3.zero
	return { x = w.X, y = w.Y, z = w.Z }
end

function ArenaService.windVector(): Vector3
	return if current then current.Wind else Vector3.zero
end

function ArenaService.endZone(side: string): BasePart?
	if built then
		return built.endZones[side]
	end
	return nil
end

function ArenaService.spawnCFrame(): CFrame
	if built then
		return built.spawn.CFrame + Vector3.new(0, 3, 0)
	end
	return CFrame.new(0, 5, -70)
end

function ArenaService.margin(): number
	return ArenaBuilder.Margin
end

function ArenaService.Init(_s: any)
	ArenaService.build(ArenasConfig.Default, "Standard")
end

function ArenaService.Start() end

return ArenaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BotService — server-driven teammates/opponents so a match is playable with
	one human (and Studio solo testing works).

	Bots use the same rules, catch geometry, throw model and solver as humans.
	They are deliberately imperfect: reaction delay, aim noise and a skill
	value per bot (deterministic, seeded). They do not use the advanced
	movement techniques except jumping and diving; outplaying them with
	movement tech is part of the fun.

	Behaviour summary
	  offense, disc held by a teammate   handlers reset beside the disc;
	                                     cutters pick open space upfield
	                                     (scored by distance from defenders
	                                     and progress) and sprint to it
	  offense, holding                   wait a beat, read lanes, throw a
	                                     solved lead pass to the most open
	                                     receiver; panic-throw late in stall
	  defense                            the closest defender marks (hands
	                                     up, force side), the rest play
	                                     goal-side man-to-man with a
	                                     reaction lag
	  disc in the air                    the best-placed bot on each team
	                                     chases the earliest reachable point
	                                     on the flight; jumps or lays out
	                                     when needed
	  disc on the ground                 nearest offensive bot picks it up
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local Rng = require(Shared.Util.Rng)
local VecMath = require(Shared.Util.VecMath)
local TeamsConfig = require(Shared.Config.Teams)
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local Solver = require(Shared.Disc.Solver)
local FieldGeometry = require(Shared.Rules.FieldGeometry)
local RulesEngine = require(Shared.Rules.RulesEngine)
local Locomotion = require(Shared.Animation.Locomotion)

local BotService = {}

local services: any
local folder: Folder

type Brain = {
	id: number,
	name: string,
	team: string,
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	loco: Locomotion.Controller?,
	rng: Rng.Rng,
	skill: number,
	reaction: number,
	nextThink: number,
	target: Vector3?,
	speed: number,
	cutUntil: number,
	holdUntil: number,
	diveLockUntil: number,
	lastReach: number,
	lagBuffer: { { t: number, p: Vector3 } },
	custom: ((Brain, number) -> ())?,
	mode: string,
}

local brains: { [number]: Brain } = {}
local nextId = Actors.BotIdBase
local seedCounter = 0

local NAMES = {
	"Huck Norris",
	"Flick Jagger",
	"Layla Out",
	"Hammer Time",
	"Scoober Doo",
	"Stall Ten",
	"Pivot Pete",
	"Blade Runner",
	"Callahan Kid",
	"Greatest Gwen",
	"Bricky",
	"Swing Lowe",
	"Dump Truck",
	"Deep Dana",
	"Break Mark",
	"Zone Defense",
	"Spin Doctor",
	"Pancake",
	"Hospital Hal",
	"Sky Walker",
}

local SKIN = {
	Color3.fromRGB(255, 220, 190),
	Color3.fromRGB(234, 184, 146),
	Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(141, 92, 62),
	Color3.fromRGB(96, 62, 42),
}

local SPRINT = 24
local JOG = 16

local function now(): number
	return Net.now()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function teamColor(team: string): (Color3, Color3)
	if team == "A" then
		return TeamsConfig.A.Color, TeamsConfig.A.Dark
	elseif team == "B" then
		return TeamsConfig.B.Color, TeamsConfig.B.Dark
	end
	return TeamsConfig.Neutral.Color, Color3.fromRGB(80, 80, 90)
end

function BotService.spawn(team: string, custom: ((any, number) -> ())?, role: string?): number
	nextId -= 1
	seedCounter += 1
	local id = nextId
	local rng = Rng.new(seedCounter * 2654435761 + 97)
	local name = NAMES[((seedCounter - 1) % #NAMES) + 1]
	local shirt, shorts = teamColor(team)
	local desc = Instance.new("HumanoidDescription")
	local skin = SKIN[rng:int(1, #SKIN)]
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = shirt
	desc.LeftLegColor = shorts
	desc.RightLegColor = shorts

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] could not create bot model: " .. tostring(model))
		return id
	end
	local m = model :: Model
	m.Name = "Bot_" .. name
	local humanoid = m:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = m:FindFirstChild("HumanoidRootPart") :: BasePart
	if not humanoid or not root then
		m:Destroy()
		return id
	end
	m:PivotTo(services.ArenaService.spawnCFrame() + Vector3.new(rng:range(-6, 6), 0, rng:range(-3, 3)))
	m.Parent = folder
	root:SetNetworkOwner(nil)
	local actor = services.PlayerService.registerBot(id, name .. " [BOT]", team, m)
	if role then
		services.PlayerService.setTeam(actor, team, role)
	end
	humanoid.AutoRotate = true
	for _, st in
		{
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.Seated,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.FallingDown,
		}
	do
		humanoid:SetStateEnabled(st, false)
	end
	humanoid.UseJumpPower = true
	humanoid.JumpPower = MovementConfig.JumpVelocity
	humanoid.WalkSpeed = JOG
	local brain: Brain = {
		id = id,
		name = name,
		team = team,
		model = m,
		humanoid = humanoid,
		root = root,
		loco = nil,
		rng = rng,
		skill = rng:range(0.6, 0.85),
		reaction = rng:range(0.18, 0.32),
		nextThink = 0,
		target = nil,
		speed = JOG,
		cutUntil = 0,
		holdUntil = 0,
		diveLockUntil = 0,
		lastReach = 0,
		lagBuffer = {},
		custom = custom,
		mode = "Ground",
	}
	brains[id] = brain
	task.spawn(function()
		local okLoco, loco = pcall(Locomotion.new, humanoid)
		if okLoco then
			brain.loco = loco
		end
	end)
	return id
end

function BotService.remove(id: number)
	local b = brains[id]
	brains[id] = nil
	if b and b.loco then
		Locomotion.destroy(b.loco)
	end
	services.PlayerService.unregisterBot(id)
end

function BotService.brain(id: number): Brain?
	return brains[id]
end

---------------------------------------------------------------------------
-- motor helpers
---------------------------------------------------------------------------

local function frozen(b: Brain): boolean
	return b.model:GetAttribute("UBFrozen") == true
end

local function moveToward(b: Brain, target: Vector3?, speed: number)
	if not target then
		b.humanoid:Move(Vector3.zero)
		return
	end
	local delta = flat(target - b.root.Position)
	if delta.Magnitude < 1.0 then
		b.humanoid:Move(Vector3.zero)
		return
	end
	b.humanoid.WalkSpeed = speed
	b.humanoid:Move(delta.Unit)
end

local function face(b: Brain, point: Vector3)
	local p = b.root.Position
	local dir = flat(point - p)
	if dir.Magnitude > 0.1 then
		b.root.CFrame = CFrame.lookAt(p, p + dir)
	end
end

local function setMode(b: Brain, mode: string)
	if b.mode ~= mode then
		b.mode = mode
		services.MovementService.setBotMode(b.id, mode)
	end
end

local function dive(b: Brain, dir: Vector3)
	local t = now()
	if t < b.diveLockUntil then
		return
	end
	b.diveLockUntil = t + 1.6
	local d = VecMath.flatUnit(dir)
	services.MovementService.botTech(b.id, "Dive", d, "Dive")
	b.mode = "Dive"
	b.humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	b.root.AssemblyLinearVelocity = d * 27 + Vector3.new(0, 18, 0)
	task.delay(0.45, function()
		if brains[b.id] then
			setMode(b, "DiveSlide")
		end
	end)
	task.delay(0.9, function()
		if brains[b.id] then
			setMode(b, "Recover")
		end
	end)
	task.delay(1.35, function()
		if brains[b.id] then
			setMode(b, "Ground")
		end
	end)
end

local function jump(b: Brain)
	if b.humanoid.FloorMaterial ~= Enum.Material.Air then
		b.humanoid.Jump = true
		services.MovementService.botTech(b.id, "Jump", VecMath.flatUnit(b.root.CFrame.LookVector), "Air")
		task.delay(0.6, function()
			if brains[b.id] and b.mode == "Air" then
				setMode(b, "Ground")
			end
		end)
	end
end

local function reachFor(b: Brain, point: Vector3)
	local t = now()
	if t - b.lastReach < 0.7 then
		return
	end
	b.lastReach = t
	local dir = point - (b.root.Position + Vector3.new(0, 1.5, 0))
	services.CatchingService.reach(b.id, dir)
end

-- position of an actor `lag` seconds ago (reaction delay for defenders)
local function laggedPosition(b: Brain, targetId: number, lag: number): Vector3?
	local root = Actors.rootOf(targetId)
	if not root then
		return nil
	end
	local t = now()
	table.insert(b.lagBuffer, { t = t, p = root.Position })
	while #b.lagBuffer > 2 and b.lagBuffer[2].t < t - lag do
		table.remove(b.lagBuffer, 1)
	end
	return b.lagBuffer[1].p
end

---------------------------------------------------------------------------
-- reading the game
---------------------------------------------------------------------------

local function teammates(b: Brain): { any }
	local list = {}
	for _, a in services.PlayerService.onTeam(b.team) do
		if a.id ~= b.id then
			table.insert(list, a)
		end
	end
	return list
end

local function opponents(b: Brain): { any }
	return services.PlayerService.onTeam(RulesEngine.other(b.team))
end

local function nearestDistance(pos: Vector3, actors: { any }): number
	local best = math.huge
	for _, a in actors do
		local r = services.PlayerService.root(a)
		if r then
			best = math.min(best, flat(r.Position - pos).Magnitude)
		end
	end
	return best
end

local function laneClearance(from: Vector3, to: Vector3, actors: { any }): number
	local best = math.huge
	for _, a in actors do
		local r = services.PlayerService.root(a)
		if r then
			local c = VecMath.closestOnSegment(flat(from), flat(to), flat(r.Position))
			best = math.min(best, (c - flat(r.Position)).Magnitude)
		end
	end
	return best
end

-- Earliest point on the current flight this bot can reach in time.
local function interceptPoint(b: Brain, d: any): (Vector3?, number?)
	local s = d.sim
	if not s then
		return nil, nil
	end
	local copy = DiscPhysics.copy(s)
	local base = now()
	local ground = d.groundY
	local myPos = b.root.Position
	local dt = 1 / 30
	local reaction = b.reaction * (1.4 - b.skill)
	while copy.t < s.t + 6 do
		DiscPhysics.step(copy, dt, d.wind)
		local h = copy.py - ground
		if h <= DiscConfig.Physics.GroundContact then
			break
		end
		if h < 9 then
			local tLeft = (d.launchTime + copy.t) - base
			local p = Vector3.new(copy.px, ground, copy.pz)
			local runTime = flat(p - myPos).Magnitude / SPRINT + reaction
			if runTime <= tLeft + 0.05 then
				return Vector3.new(copy.px, copy.py, copy.pz), tLeft
			end
		end
	end
	return nil, nil
end

local function chaseFlight(b: Brain, d: any): boolean
	local point, tLeft = interceptPoint(b, d)
	if not point or not tLeft then
		return false
	end
	local horiz = flat(point - b.root.Position)
	local dist = horiz.Magnitude
	b.target = Vector3.new(point.X, b.root.Position.Y, point.Z)
	b.speed = SPRINT
	local discPos = services.DiscService.currentPosition(d)
	if discPos then
		local toDisc = discPos - b.root.Position
		local flatDist = flat(toDisc).Magnitude
		local height = discPos.Y - d.groundY
		if flatDist < 6 and height > 6.5 and tLeft < 0.45 then
			jump(b)
		end
		if flatDist < 5.5 then
			reachFor(b, discPos)
		end
		-- lay out for a disc that would otherwise be just out of reach
		if flatDist > 3.5 and flatDist < 7 and height < 4.5 and tLeft < 0.35 and b.rng:next() < b.skill then
			dive(b, toDisc)
		end
	end
	local _ = dist
	return true
end

-- Which bot on a team should chase the current flight? (closest arrival)
local function isBestChaser(b: Brain, d: any): boolean
	local myPoint, myT = interceptPoint(b, d)
	if not myPoint or not myT then
		return false
	end
	local myDist = flat(myPoint - b.root.Position).Magnitude
	for _, a in services.PlayerService.onTeam(b.team) do
		if a.id ~= b.id then
			local r = services.PlayerService.root(a)
			if r and flat(myPoint - r.Position).Magnitude < myDist - 2 then
				if a.isBot then
					return false
				end
				-- a human teammate is closer: let them have it
				return false
			end
		end
	end
	return true
end

---------------------------------------------------------------------------
-- decisions
---------------------------------------------------------------------------

local function thinkHolder(b: Brain, e: RulesEngine.State)
	local t = now()
	b.target = nil
	if b.holdUntil == 0 then
		b.holdUntil = t + b.rng:range(0.8, 2.2) * (1.3 - b.skill)
		return
	end
	local stall = services.DefenseService.stallCount()
	local stallMax = services.MatchService.mode().StallMax
	if t < b.holdUntil and stall < stallMax - 3 then
		return
	end
	local f = services.ArenaService.field()
	local attackDir = FieldGeometry.attackDirection(e.attack[b.team])
	local opp = opponents(b)
	local best, bestScore = nil, -math.huge
	for _, a in teammates(b) do
		local r = services.PlayerService.root(a)
		if r then
			local lead = r.Position + flat(r.AssemblyLinearVelocity) * 0.9
			if FieldGeometry.inBounds(f, lead) then
				local open = math.min(nearestDistance(lead, opp), 18)
				local lane = math.min(laneClearance(b.root.Position, lead, opp), 10)
				local progress = (lead - b.root.Position):Dot(attackDir)
				local dist = flat(lead - b.root.Position).Magnitude
				local score = open * 1.2 + lane * 1.6 + progress * 0.08 - math.max(0, dist - 90) * 0.15
				if dist < 8 then
					score -= 20
				end
				if score > bestScore then
					best, bestScore = a, score
				end
			end
		end
	end
	if not best then
		return
	end
	if bestScore < 10 and stall < stallMax - 2 then
		b.holdUntil = t + 0.4
		return
	end
	local r = services.PlayerService.root(best) :: BasePart
	-- release from the side away from the marker
	local markerId = Net.state():GetAttribute("MarkerId")
	local throwType = "Backhand"
	if type(markerId) == "number" and markerId ~= 0 then
		local mroot = Actors.rootOf(markerId)
		if mroot then
			local right = VecMath.flatUnit(b.root.CFrame.RightVector)
			throwType = if (mroot.Position - b.root.Position):Dot(right) < 0 then "Forehand" else "Backhand"
		end
	end
	local lane = laneClearance(b.root.Position, r.Position, opp)
	if lane < 3 and flat(r.Position - b.root.Position).Magnitude > 30 and b.rng:next() < 0.5 then
		throwType = "Hammer"
	end
	local sol = Solver.solve({
		rootPos = b.root.Position,
		throwType = throwType,
		target = r.Position + Vector3.new(0, 1, 0),
		targetVel = flat(r.AssemblyLinearVelocity),
		groundY = f.groundY,
		wind = services.ArenaService.wind(),
		coarse = true,
	})
	if not sol or (sol.miss > 3.5 and stall < stallMax - 2) then
		-- no catchable pass to that receiver right now; look again shortly
		b.holdUntil = t + 0.3
		return
	end
	local params = sol.params
	local noise = (1 - b.skill) * 0.07
	params.yaw += b.rng:range(-noise, noise)
	params.pitch += b.rng:range(-noise, noise) * 0.6
	face(b, r.Position)
	b.holdUntil = 0
	services.ThrowService.throw(b.id, params, true)
end

local function thinkOffense(b: Brain, e: RulesEngine.State)
	local t = now()
	local holderRoot = if e.holder then Actors.rootOf(e.holder) else nil
	if not holderRoot then
		return
	end
	local attackDir = FieldGeometry.attackDirection(e.attack[b.team])
	local f = services.ArenaService.field()
	local distToHolder = flat(b.root.Position - holderRoot.Position).Magnitude
	-- the closest teammate stays available as a reset ("dump") option
	local isHandler = true
	for _, a in teammates(b) do
		if a.id ~= e.holder then
			local r = services.PlayerService.root(a)
			if r and flat(r.Position - holderRoot.Position).Magnitude < distToHolder then
				isHandler = false
				break
			end
		end
	end
	if t < b.cutUntil and b.target then
		return
	end
	local opp = opponents(b)
	local bestSpot, bestScore = nil, -math.huge
	for _ = 1, 10 do
		local forward = if isHandler then b.rng:range(-12, 6) else b.rng:range(20, 75)
		local side = if isHandler then b.rng:range(-14, 14) else b.rng:range(-f.halfWidth + 8, f.halfWidth - 8)
		local spot = holderRoot.Position + attackDir * forward
		spot = Vector3.new(spot.X, b.root.Position.Y, if isHandler then holderRoot.Position.Z + side else side)
		local clamped = FieldGeometry.clampInBounds(f, spot, 6)
		spot = Vector3.new(clamped.X, b.root.Position.Y, clamped.Z)
		local open = math.min(nearestDistance(spot, opp), 20)
		local crowd = math.min(nearestDistance(spot, teammates(b)), 15)
		local score = open * 1.5 + crowd + (spot - holderRoot.Position):Dot(attackDir) * 0.05
		if score > bestScore then
			bestSpot, bestScore = spot, score
		end
	end
	b.target = bestSpot
	b.speed = if isHandler then JOG else SPRINT
	b.cutUntil = t + b.rng:range(1.2, 2.6)
end

local function thinkDefense(b: Brain, e: RulesEngine.State)
	local holder = e.holder
	if not holder then
		return
	end
	local holderRoot = Actors.rootOf(holder)
	if not holderRoot then
		return
	end
	-- "goal side": between an attacker and the end zone the offense attacks
	local offenseTeam = RulesEngine.other(b.team)
	local goalSide = FieldGeometry.attackDirection(e.attack[offenseTeam])
	local myDist = flat(b.root.Position - holderRoot.Position).Magnitude
	local marker = true
	for _, a in services.PlayerService.onTeam(b.team) do
		if a.id ~= b.id then
			local r = services.PlayerService.root(a)
			if r and flat(r.Position - holderRoot.Position).Magnitude < myDist then
				marker = false
				break
			end
		end
	end
	if marker then
		-- force one side: shade toward the open-side sideline
		local forceSide = Vector3.new(0, 0, if e.pointNumber % 2 == 0 then 1 else -1)
		local spot = holderRoot.Position + goalSide * 3.4 + forceSide * 1.0
		b.target = Vector3.new(spot.X, b.root.Position.Y, spot.Z)
		b.speed = JOG
		local windup = holderRoot.Parent and holderRoot.Parent:GetAttribute("WindupType")
		local stance = if windup == "Hammer" or windup == "Scoober" then "High" else "Low"
		if myDist < 7 then
			services.DefenseService.setStance(b.id, true, stance)
			face(b, holderRoot.Position)
		end
		return
	end
	services.DefenseService.setStance(b.id, false, "Low")
	-- man-to-man: guard the closest attacker no teammate is already on
	local opp = opponents(b)
	local best, bestD = nil, math.huge
	for _, a in opp do
		if a.id ~= holder then
			local r = services.PlayerService.root(a)
			if r then
				local dd = flat(r.Position - b.root.Position).Magnitude
				local claimed = false
				for _, mate in services.PlayerService.onTeam(b.team) do
					if mate.id ~= b.id then
						local mr = services.PlayerService.root(mate)
						if mr and flat(mr.Position - r.Position).Magnitude < dd - 1 then
							claimed = true
							break
						end
					end
				end
				if not claimed and dd < bestD then
					best, bestD = a, dd
				end
			end
		end
	end
	if not best then
		local spot = holderRoot.Position + goalSide * 25
		b.target = Vector3.new(spot.X, b.root.Position.Y, spot.Z)
		b.speed = JOG
		return
	end
	local lagged = laggedPosition(b, best.id, b.reaction * (1.5 - b.skill))
	if lagged then
		local toDisc = VecMath.flatUnit(holderRoot.Position - lagged)
		local spot = lagged + goalSide * 3 + toDisc * 2
		b.target = Vector3.new(spot.X, b.root.Position.Y, spot.Z)
		b.speed = SPRINT
	end
end

local function thinkMatch(b: Brain)
	local e = services.MatchService.engine()
	local phase = services.MatchService.phase()
	if not e or frozen(b) then
		b.target = nil
		return
	end
	if phase == "PointOver" then
		b.target = nil
		if b.rng:next() < 0.05 then
			jump(b)
		end
		return
	end
	if phase ~= "Live" then
		b.target = nil
		return
	end
	local d = services.MatchService.disc()
	if not d then
		return
	end
	if e.disc == "Flight" and (d.mode == "Flight") then
		local isOffense = b.team == d.throwerTeam
		if d.pull then
			isOffense = b.team == e.offense
			if not isOffense then
				-- the pulling team sprints down to cover
				local pullDir = -FieldGeometry.attackDirection(e.attack[e.offense])
				local spot = b.root.Position + pullDir * 30
				b.target = Vector3.new(spot.X, b.root.Position.Y, spot.Z)
				b.speed = SPRINT
				return
			end
		end
		if isBestChaser(b, d) and chaseFlight(b, d) then
			return
		end
		-- not chasing: keep structure
		if b.team == e.offense or isOffense then
			thinkOffense(b, e)
		else
			thinkDefense(b, e)
		end
		return
	end
	if e.disc == "Ground" then
		local spot = d.folder:GetAttribute("GroundPos") :: Vector3?
		if spot and b.team == e.offense then
			-- nearest offensive actor goes for it
			local myD = flat(spot - b.root.Position).Magnitude
			for _, a in services.PlayerService.onTeam(b.team) do
				if a.id ~= b.id then
					local r = services.PlayerService.root(a)
					if r and flat(spot - r.Position).Magnitude < myD then
						b.target = nil
						return
					end
				end
			end
			b.target = Vector3.new(spot.X, b.root.Position.Y, spot.Z)
			b.speed = SPRINT
		elseif spot then
			b.target = Vector3.new(spot.X, b.root.Position.Y, spot.Z) + (b.root.Position - spot).Unit * 10
			b.speed = JOG
		end
		return
	end
	if e.disc == "Held" then
		if e.holder == b.id then
			thinkHolder(b, e)
		elseif e.holderTeam == b.team then
			thinkOffense(b, e)
		else
			thinkDefense(b, e)
		end
	end
end

function BotService.schedulePull(id: number)
	local b = brains[id]
	if not b then
		return
	end
	task.delay(b.rng:range(1.0, 2.2), function()
		if brains[id] and services.MatchService.phase() == "Pull" then
			services.MatchService.pullNow(id)
		end
	end)
end

local function update(dt: number)
	local t = now()
	for _, b in brains do
		if b.model.Parent == nil then
			continue
		end
		if b.custom then
			b.custom(b, dt)
		elseif t >= b.nextThink then
			b.nextThink = t + 0.1
			local ok, err = pcall(function()
				thinkMatch(b)
			end)
			if not ok then
				warn("[BotService] " .. tostring(err))
			end
		end
		local holding = b.model:GetAttribute("HasDisc") == true
		if frozen(b) or holding or t < b.diveLockUntil - 0.7 then
			b.humanoid:Move(Vector3.zero)
		else
			moveToward(b, b.target, b.speed)
		end
		if b.loco then
			local v = b.root.AssemblyLinearVelocity
			local state = b.humanoid:GetState()
			local m: Locomotion.Mode = "Ground"
			if b.mode == "Dive" or b.mode == "DiveSlide" or b.mode == "Recover" then
				m = "Pose"
			elseif state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
				m = if v.Y > 2 then "Rising" else "Falling"
			end
			Locomotion.update(b.loco :: Locomotion.Controller, dt, flat(v).Magnitude, m)
		end
	end
end

-- Helpers for scripted (training) bots.
BotService.moveToward = moveToward
BotService.face = face
BotService.reachFor = reachFor
BotService.chaseFlight = chaseFlight

function BotService.Init(s: any)
	services = s
	local f = workspace:FindFirstChild(Actors.BotFolderName)
	if not f then
		local nf = Instance.new("Folder")
		nf.Name = Actors.BotFolderName
		nf.Parent = workspace
		f = nf
	end
	folder = f :: Folder
end

function BotService.Start()
	RunService.Heartbeat:Connect(update)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">CatchingService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CatchingService — every catch, block and bobble is decided here.

	Humans: the client sees its own body at its true position and the disc at
	the shared server time, so it detects contact and sends a claim stamped
	with that server time. The server rewinds the DISC (cheap: deterministic
	history) to the claimed time and tests it against the claimer's catch
	zones built from the server's view of their character (which lags by
	about the same one-way latency the claim did). Slack grows with ping and
	is capped. Claims are collected for ResolveDelay so near-simultaneous
	touches become a fair contest instead of first-packet-wins.

	Bots: checked directly on the server every simulation step.

	Outcomes:
	  Catch          clean (or uncontested fingertip on a normal-speed disc)
	  Block          a defender's fingertip contact knocks the disc down
	  Bobble         contested / very fast fingertip contact pops the disc up
	The disc stays live after blocks and bobbles; anyone may still catch it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local VecMath = require(Shared.Util.VecMath)
local Net = require(Shared.Net)

local C = DiscConfig.Catch

local CatchingService = {}

local services: any

type ReachState = { at: number, dir: Vector3 }
local reaches: { [number]: ReachState } = {}
local lastClaim: { [number]: number } = {}

local function now(): number
	return Net.now()
end

local function facingOf(root: BasePart): Vector3
	return VecMath.flatUnit(root.CFrame.LookVector)
end

local function bodyFor(
	actorId: number,
	root: BasePart,
	kind: string?,
	reachDir: Vector3?,
	t: number
): CatchGeometry.BodyState
	local reach = reaches[actorId]
	local reaching = false
	local dir: Vector3? = nil
	if reach and t >= reach.at - 0.12 and t <= reach.at + C.ReachWindow + 0.12 then
		reaching = true
		dir = if reachDir and reachDir.Magnitude > 0.5 then reachDir.Unit else reach.dir
	end
	local diving = services.MovementService.isDiving(actorId)
	local diveDir: Vector3? = nil
	if diving then
		local actor = services.PlayerService.get(actorId)
		local c = actor and actor.character
		local td = c and c:GetAttribute("TechDir")
		diveDir = if typeof(td) == "Vector3" and (td :: Vector3).Magnitude > 0.5 then td :: Vector3 else facingOf(root)
	end
	local _ = kind
	return {
		root = root.Position,
		facing = facingOf(root),
		reaching = reaching,
		reachDir = dir,
		diving = diving,
		diveDir = diveDir,
		sliding = services.MovementService.isSliding(actorId),
	}
end

local function slackFor(actorId: number): number
	local player = services.Actors.playerOf(actorId)
	local ping = 0
	if player then
		local ok, value = pcall(function()
			return player:GetNetworkPing()
		end)
		if ok and type(value) == "number" then
			ping = value
		end
	end
	return math.min(C.BaseSlack + ping * C.PingSlackPerSecond, C.MaxSlack)
end

local function claimable(d: any, t: number): boolean
	if d.mode == "Flight" then
		return true
	end
	return d.mode == "Landed" and t <= d.landAt + 0.02
end

local function addClaim(
	d: any,
	actorId: number,
	team: string,
	t: number,
	ev: CatchGeometry.Evaluation,
	actorVel: Vector3
)
	local rel = (services.DiscService.velocity(d) - actorVel).Magnitude
	for _, c in d.claims do
		if c.id == actorId then
			if t < c.t then
				c.t, c.depth, c.quality, c.zone, c.relativeSpeed = t, ev.depth, ev.quality, ev.zone.kind, rel
			end
			return
		end
	end
	table.insert(d.claims, {
		id = actorId,
		team = team,
		t = t,
		depth = ev.depth,
		quality = ev.quality,
		relativeSpeed = rel,
		zone = ev.zone.kind,
		hand = ev.hand,
	})
	if d.resolveAt == nil then
		d.resolveAt = now() + C.ResolveDelay
	end
end

-- Validates a claim. Returns true if it was queued.
function CatchingService.claim(actorId: number, d: any, t: number, kind: string?, reachDir: Vector3?): boolean
	local actor = services.PlayerService.get(actorId)
	if not actor or actor.role == "Spectate" then
		return false
	end
	local root = services.PlayerService.root(actor)
	if not root then
		return false
	end
	local tNow = now()
	if t ~= t or t < tNow - C.MaxRewind or t > tNow + 0.05 then
		t = math.clamp(if t == t then t else tNow, tNow - C.MaxRewind, tNow)
	end
	if not claimable(d, t) or t < d.noCatchUntil then
		return false
	end
	if d.thrower == actorId and not d.touched then
		return false
	end
	if actor.character and actor.character:GetAttribute("UBFrozen") == true then
		return false
	end
	if not d.handler.canClaim(d, actorId, actor.team) then
		return false
	end
	local discPos = services.DiscService.positionAt(d, t)
	if not discPos then
		return false
	end
	local zones = CatchGeometry.zones(bodyFor(actorId, root, kind, reachDir, t))
	local slack = if actor.isBot then 0 else slackFor(actorId)
	local ev = CatchGeometry.evaluate(zones, discPos, slack)
	if not ev then
		return false
	end
	addClaim(d, actorId, actor.team, t, ev, root.AssemblyLinearVelocity)
	return true
end

-- Server-side check for bots along one simulation step of a flight.
function CatchingService.sweepBots(d: any, _from: Vector3, to: Vector3, t: number)
	if t < d.noCatchUntil then
		return
	end
	for _, actor in services.PlayerService.all() do
		if actor.isBot and actor.role == "Match" or (actor.isBot and actor.role == "Training") then
			local root = services.PlayerService.root(actor)
			if root and (root.Position - to).Magnitude < 9 then
				if not (d.thrower == actor.id and not d.touched) and d.handler.canClaim(d, actor.id, actor.team) then
					local zones = CatchGeometry.zones(bodyFor(actor.id, root, nil, nil, t))
					local ev = CatchGeometry.evaluate(zones, to, 0)
					if ev then
						addClaim(d, actor.id, actor.team, t, ev, root.AssemblyLinearVelocity)
					end
				end
			end
		end
	end
end

local function notifyClaimers(d: any, winnerId: number?, result: string)
	for _, c in d.claims do
		local player = services.Actors.playerOf(c.id)
		if player then
			Net.event("CatchResult")
				:FireClient(player, d.id, c.id == winnerId and result == "Catch", result, d.flightId)
		end
	end
end

function CatchingService.resolve(d: any)
	if #d.claims == 0 then
		return
	end
	if d.mode ~= "Flight" and d.mode ~= "Landed" then
		d.claims = {}
		return
	end
	local resolution = CatchGeometry.resolve(d.claims)
	if not resolution then
		d.claims = {}
		return
	end
	local w = resolution.winner :: any
	local winnerActor = services.PlayerService.get(w.id)
	local root = winnerActor and services.PlayerService.root(winnerActor)
	if not winnerActor or not root then
		d.claims = {}
		return
	end
	local discPos = services.DiscService.positionAt(d, w.t) or root.Position
	local discVel = services.DiscService.velocity(d)
	local isDefender = d.throwerTeam ~= nil and w.team ~= d.throwerTeam and not d.pull
	local outcome: string
	if isDefender and w.quality == "Fingertip" then
		outcome = "Block"
	elseif resolution.bobble then
		outcome = "Bobble"
	else
		outcome = "Catch"
	end

	notifyClaimers(d, w.id, outcome)
	local claims = d.claims
	d.claims = {}

	if outcome == "Catch" then
		local track = services.MovementService.track(w.id)
		local grounded = if track then track.grounded else true
		local jumpOrigin = if track then track.lastGroundedPos else root.Position
		services.DiscService.giveTo(d, w.id)
		Net.event("Effect"):FireAllClients("Catch", discPos, w.id, w.quality, w.zone)
		d.handler.onCaught(d, {
			id = w.id,
			team = w.team,
			pos = root.Position,
			grounded = grounded,
			jumpOrigin = jumpOrigin,
			quality = w.quality,
			zone = w.zone,
			relativeSpeed = w.relativeSpeed,
			contested = resolution.contested,
			t = w.t,
			discPos = discPos,
			claims = claims,
		})
		return
	end

	-- deflections keep the disc alive
	local away = VecMath.flatUnit(discPos - root.Position)
	local newVel: Vector3
	if outcome == "Block" then
		newVel = discVel * C.BlockCarry + Vector3.new(0, C.BlockDown, 0) + away * 6
	else
		newVel = discVel * C.BobbleCarry + Vector3.new(0, C.BobbleUp, 0) + away * 2
	end
	local pos = Vector3.new(discPos.X, math.max(discPos.Y, d.groundY + 0.6), discPos.Z)
	services.DiscService.deflect(d, pos, newVel, Vector3.new(0.3, 1, 0.2).Unit, 12)
	Net.event("Effect"):FireAllClients(outcome, discPos, w.id, w.quality, w.zone)
	d.handler.onTouched(
		d,
		{ id = w.id, team = w.team, kind = outcome, pos = discPos, zone = w.zone, reason = resolution.reason }
	)
end

function CatchingService.reachState(actorId: number): ReachState?
	return reaches[actorId]
end

-- Opens a reach window (humans via remote, bots directly).
function CatchingService.reach(actorId: number, dir: Vector3)
	local tNow = now()
	local prev = reaches[actorId]
	if prev and tNow - prev.at < C.ReachWindow + C.ReachCooldown * 0.6 then
		return
	end
	local unit = if dir.Magnitude > 0.1 and dir.Magnitude == dir.Magnitude then dir.Unit else Vector3.new(0, 0, -1)
	reaches[actorId] = { at = tNow, dir = unit }
	local actor = services.PlayerService.get(actorId)
	if actor and actor.character then
		actor.character:SetAttribute("ReachDir", unit)
		actor.character:SetAttribute("Reach", tNow)
	end
end

function CatchingService.Init(s: any)
	services = s
end

function CatchingService.Start()
	Net.event("Reach").OnServerEvent:Connect(function(player, dir)
		local actor = services.PlayerService.fromPlayer(player)
		if actor and typeof(dir) == "Vector3" then
			CatchingService.reach(actor.id, dir)
		end
	end)
	Net.event("Catch").OnServerEvent:Connect(function(player, discId, t, kind, reachDir)
		local actor = services.PlayerService.fromPlayer(player)
		if not actor or type(discId) ~= "string" or type(t) ~= "number" then
			return
		end
		local clock = os.clock()
		if (lastClaim[actor.id] or 0) > clock - 0.05 then
			return
		end
		lastClaim[actor.id] = clock
		local d = services.DiscService.get(discId)
		if not d then
			return
		end
		local rd = if typeof(reachDir) == "Vector3" then reachDir else nil
		local ok = CatchingService.claim(actor.id, d, t, if type(kind) == "string" then kind else nil, rd)
		if not ok then
			Net.event("CatchResult"):FireClient(player, d.id, false, "Denied", d.flightId)
		end
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		reaches[actor.id] = nil
		lastClaim[actor.id] = nil
	end)
end

return CatchingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — player profiles with DataStoreService.

	  * UpdateAsync everywhere (no blind SetAsync), with retries + backoff.
	  * Session lock: a profile records the JobId that owns it; another server
	    must wait for the lock to expire (or the owner to release it) before
	    taking over, which prevents two servers overwriting each other.
	  * Template merge + validation on load, so old or damaged data upgrades.
	  * Autosave every 90 s, save on leave, save-all in BindToClose.
	  * No API access (e.g. Studio without "Enable Studio Access to API
	    Services") -> profiles live in memory and are marked non-persistent.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local InputConfig = require(Shared.Config.Input)
local ProgressionConfig = require(Shared.Config.Progression)

local DataService = {}

DataService.Loaded = Signal.new()

local STORE_NAME = "UB_Profiles_v1"
local LOCK_TIMEOUT = 180 -- seconds before a crashed server's lock is considered stale
local AUTOSAVE = 90
local VERSION = 1

local store: DataStore? = nil
local persistentAvailable = false
local jobId = if game.JobId ~= "" then game.JobId else ("studio-" .. HttpService:GenerateGUID(false))

export type Profile = {
	data: { [string]: any },
	persistent: boolean,
	dirty: boolean,
	loadedAt: number,
	released: boolean,
}

local profiles: { [Player]: Profile } = {}

local function template(): { [string]: any }
	return {
		version = VERSION,
		xp = 0,
		stats = {},
		techMastery = {},
		rating = ProgressionConfig.Rating.Start,
		ratedGames = 0,
		peakRating = ProgressionConfig.Rating.Start,
		personalBests = {},
		drillsDone = {},
		achievements = {},
		cosmetics = { disc = "Classic", trail = "None", celebration = "Point", banner = "Slate", title = "Rookie" },
		settings = { values = table.clone(InputConfig.DefaultSettings), keyboard = {}, gamepad = {} },
		firstJoin = os.time(),
		lastJoin = os.time(),
	}
end

-- Fills missing keys from the template and drops values of the wrong type.
local function reconcile(data: any): { [string]: any }
	local base = template()
	if type(data) ~= "table" then
		return base
	end
	for k, v in base do
		local cur = data[k]
		if cur == nil or type(cur) ~= type(v) then
			data[k] = v
		elseif type(v) == "table" and k ~= "stats" and k ~= "techMastery" and k ~= "personalBests" then
			for k2, v2 in v do
				if cur[k2] == nil or type(cur[k2]) ~= type(v2) then
					cur[k2] = v2
				end
			end
		end
	end
	for k, v in data.stats do
		if type(v) ~= "number" then
			data.stats[k] = nil
		end
	end
	data.version = VERSION
	return data
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T?)
	local delay = 1
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[DataService] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < 4 then
			task.wait(delay)
			delay *= 2
		end
	end
	return false, nil
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function load(player: Player): Profile
	if not persistentAvailable or not store then
		return { data = template(), persistent = false, dirty = false, loadedAt = os.clock(), released = false }
	end
	local ds = store :: DataStore
	local loaded: any = nil
	for _ = 1, 5 do
		local stolen = false
		local ok = withRetries("load " .. player.UserId, function()
			ds:UpdateAsync(key(player), function(old: any)
				local now = os.time()
				if type(old) == "table" and type(old.lock) == "table" then
					local lock = old.lock
					if lock.job ~= jobId and type(lock.at) == "number" and now - lock.at < LOCK_TIMEOUT then
						loaded = nil
						return nil -- someone else owns it; don't write
					end
					stolen = lock.job ~= jobId
				end
				local data = reconcile(if type(old) == "table" then old.data else nil)
				data.lastJoin = now
				loaded = data
				return { data = data, lock = { job = jobId, at = now } }
			end)
			return true
		end)
		if not ok then
			break
		end
		if loaded then
			if stolen then
				warn("[DataService] took over a stale session lock for " .. player.UserId)
			end
			return { data = loaded, persistent = true, dirty = false, loadedAt = os.clock(), released = false }
		end
		task.wait(6) -- another server is releasing it
		if not player.Parent then
			break
		end
	end
	warn("[DataService] could not lock profile for " .. player.UserId .. "; using a temporary profile")
	return { data = template(), persistent = false, dirty = false, loadedAt = os.clock(), released = false }
end

local function save(player: Player, release: boolean)
	local profile = profiles[player]
	if not profile or not profile.persistent or profile.released or not store then
		return
	end
	local ds = store :: DataStore
	local data = profile.data
	withRetries("save " .. player.UserId, function()
		ds:UpdateAsync(key(player), function(old: any)
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= jobId then
				-- we lost the lock (another server took over after a timeout)
				return nil
			end
			return { data = data, lock = if release then nil else { job = jobId, at = os.time() } }
		end)
		return true
	end)
	profile.dirty = false
	if release then
		profile.released = true
	end
end

function DataService.get(player: Player): { [string]: any }?
	local p = profiles[player]
	return if p then p.data else nil
end

function DataService.isPersistent(player: Player): boolean
	local p = profiles[player]
	return p ~= nil and p.persistent
end

-- Applies fn(data) and marks the profile dirty.
function DataService.update(player: Player, fn: ({ [string]: any }) -> ())
	local p = profiles[player]
	if not p then
		return
	end
	fn(p.data)
	p.dirty = true
end

function DataService.saveNow(player: Player)
	task.spawn(save, player, false)
end

function DataService.Init(_services: any)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok and result then
		store = result
		-- probe once: Studio without API access throws here
		local probeOk = pcall(function()
			(result :: DataStore):GetAsync("__probe")
		end)
		persistentAvailable = probeOk
	end
	if not persistentAvailable then
		warn(
			"[DataService] DataStores unavailable — profiles will not be saved this session."
				.. (
					if RunService:IsStudio()
						then " (Enable 'Studio Access to API Services' in Game Settings > Security.)"
						else ""
				)
		)
	end
end

function DataService.Start()
	local function onJoin(player: Player)
		local profile = load(player)
		if not player.Parent then
			if profile.persistent then
				profiles[player] = profile
				save(player, true)
				profiles[player] = nil
			end
			return
		end
		profiles[player] = profile
		DataService.Loaded:Fire(player, profile.data)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player, true)
		profiles[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for player, profile in profiles do
				if profile.dirty then
					task.spawn(save, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">DefenseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DefenseService — the mark.

	  Stall count   advances once per StallInterval while an opposing player
	                is within StallRange of the holder. Pauses when nobody is
	                marking, on a double team (a second defender in range who
	                is not guarding anyone else), or on a disc-space violation
	                (marker inside DiscSpace). Resets after 1.5 s unmarked.
	  Mark stance   defenders hold Secondary to raise their hands; aiming up
	                or down chooses High (hammers / hop throws) or Low (wide,
	                waist-to-chest: stops normal and step-out releases).
	                Jumping lifts the active zone. Stance is replicated as a
	                character attribute so the thrower can read it.
	  Hand blocks   on release the first HandBlockCheckTime seconds of the
	                flight are tested against every nearby defender's hand
	                zone. Contact = a point block. Everything is geometry the
	                thrower can see; there is no hidden roll.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local M = DiscConfig.Mark

local DefenseService = {}

DefenseService.StallOut = Signal.new() -- (holderId)
DefenseService.StallTick = Signal.new() -- (count)

local services: any

type Stance = { on: boolean, stance: string, at: number }
local stances: { [number]: Stance } = {}

local stall = {
	active = false,
	holder = nil :: number?,
	clock = 0,
	count = 0,
	unmarkedFor = 0,
	discSpaceFor = 0,
	stateName = "None",
	interval = 1,
	max = 10,
	marker = nil :: number?,
}

local function now(): number
	return Net.now()
end

function DefenseService.setStance(actorId: number, on: boolean, stance: string?)
	local st = if stance == "High" then "High" else "Low"
	stances[actorId] = { on = on, stance = st, at = now() }
	local actor = services.PlayerService.get(actorId)
	if actor and actor.character then
		actor.character:SetAttribute("Mark", if on then st else "")
	end
end

function DefenseService.stanceOf(actorId: number): string
	local s = stances[actorId]
	if s and s.on then
		return s.stance
	end
	return "Relaxed"
end

-- Called by MatchService whenever possession changes hands.
function DefenseService.startStall(holderId: number?, interval: number, maxCount: number)
	stall.active = holderId ~= nil
	stall.holder = holderId
	stall.clock = 0
	stall.count = 0
	stall.unmarkedFor = 0
	stall.discSpaceFor = 0
	stall.interval = interval
	stall.max = maxCount
	stall.marker = nil
	local state = Net.state()
	state:SetAttribute("Stall", 0)
	state:SetAttribute("StallMax", maxCount)
	state:SetAttribute("StallState", if holderId then "Unmarked" else "None")
	state:SetAttribute("MarkerId", 0)
end

function DefenseService.stopStall()
	DefenseService.startStall(nil, stall.interval, stall.max)
end

function DefenseService.stallCount(): number
	return stall.count
end

local function setState(name: string)
	if stall.stateName ~= name then
		stall.stateName = name
		Net.state():SetAttribute("StallState", name)
	end
end

local function stepStall(dt: number)
	if not stall.active or not stall.holder then
		return
	end
	local holder = services.PlayerService.get(stall.holder)
	local hroot = holder and services.PlayerService.root(holder)
	if not holder or not hroot then
		return
	end
	local defenders = {}
	local offenders = {}
	for _, a in services.PlayerService.all() do
		if a.role == "Match" and a.id ~= holder.id then
			local r = services.PlayerService.root(a)
			if r then
				if a.team ~= holder.team then
					local d = (Vector3.new(r.Position.X - hroot.Position.X, 0, r.Position.Z - hroot.Position.Z)).Magnitude
					table.insert(defenders, { actor = a, root = r, dist = d })
				else
					table.insert(offenders, r.Position)
				end
			end
		end
	end
	table.sort(defenders, function(x, y)
		return x.dist < y.dist
	end)
	local marker = defenders[1]
	if not marker or marker.dist > M.StallRange then
		stall.unmarkedFor += dt
		stall.marker = nil
		Net.state():SetAttribute("MarkerId", 0)
		if stall.unmarkedFor > 1.5 and stall.count > 0 then
			stall.count = 0
			stall.clock = 0
			Net.state():SetAttribute("Stall", 0)
		end
		setState("Unmarked")
		return
	end
	stall.unmarkedFor = 0
	if stall.marker ~= marker.actor.id then
		stall.marker = marker.actor.id
		Net.state():SetAttribute("MarkerId", marker.actor.id)
	end

	-- double team: a second defender in range who is not guarding anyone else
	local second = defenders[2]
	if second and second.dist <= M.StallRange then
		local guarding = false
		for _, op in offenders do
			if (op - second.root.Position).Magnitude <= M.StallRange then
				guarding = true
				break
			end
		end
		if not guarding then
			setState("DoubleTeam")
			return
		end
	end

	-- disc space
	if marker.dist < M.DiscSpace then
		stall.discSpaceFor += dt
		if stall.discSpaceFor > 0.4 then
			setState("DiscSpace")
			return
		end
	else
		stall.discSpaceFor = 0
	end

	setState("Counting")
	stall.clock += dt
	local count = math.floor(stall.clock / stall.interval)
	if count ~= stall.count then
		stall.count = count
		Net.state():SetAttribute("Stall", count)
		DefenseService.StallTick:Fire(count)
		if count >= stall.max then
			local h = stall.holder
			stall.active = false
			DefenseService.StallOut:Fire(h)
		end
	end
end

-- Returns (blockerId, timeIntoFlight, blockPosition) if the release hits a
-- defender's hands, else nil.
function DefenseService.checkHandBlock(
	launch: DiscPhysics.State,
	throwerId: number,
	throwerTeam: string,
	groundY: number,
	wind: DiscPhysics.Wind?
): (number?, number?, Vector3?)
	local thrower = services.PlayerService.get(throwerId)
	local troot = thrower and services.PlayerService.root(thrower)
	if not troot then
		return nil, nil, nil
	end
	local candidates = {}
	for _, a in services.PlayerService.all() do
		if a.role == "Match" and a.team ~= throwerTeam and a.team ~= "N" then
			local r = services.PlayerService.root(a)
			if r and (r.Position - troot.Position).Magnitude < 14 then
				local track = services.MovementService.track(a.id)
				local jumpH = 0
				if track and not track.grounded then
					jumpH = math.max(0, track.heightAboveGround - 3)
				end
				table.insert(candidates, {
					id = a.id,
					pos = r.Position,
					toward = troot.Position - r.Position,
					stance = DefenseService.stanceOf(a.id),
					jumpH = jumpH,
				})
			end
		end
	end
	if #candidates == 0 then
		return nil, nil, nil
	end
	local s = DiscPhysics.copy(launch)
	local dt = DiscConfig.Physics.Dt
	while s.t < DiscConfig.Throw.HandBlockCheckTime do
		DiscPhysics.step(s, dt, wind)
		local p = Vector3.new(s.px, s.py, s.pz)
		for _, c in candidates do
			if CatchGeometry.inMarkZone(c.pos, groundY, c.toward, c.stance :: any, c.jumpH, p) then
				return c.id, s.t, p
			end
		end
	end
	return nil, nil, nil
end

function DefenseService.Init(s: any)
	services = s
end

function DefenseService.Start()
	Net.event("MarkStance").OnServerEvent:Connect(function(player, on, stance)
		local actor = services.PlayerService.fromPlayer(player)
		if actor and type(on) == "boolean" then
			DefenseService.setStance(actor.id, on, if type(stance) == "string" then stance else "Low")
		end
	end)
	Net.unreliable("MarkAim").OnServerEvent:Connect(function(player, pitch)
		local actor = services.PlayerService.fromPlayer(player)
		if not actor or type(pitch) ~= "number" or pitch ~= pitch then
			return
		end
		local s = stances[actor.id]
		if s and s.on then
			local st = if pitch > math.rad(12) then "High" else "Low"
			if st ~= s.stance then
				DefenseService.setStance(actor.id, true, st)
			end
		end
	end)
	RunService.Heartbeat:Connect(stepStall)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		stances[actor.id] = nil
	end)
end

return DefenseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">DiscService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DiscService — server-authoritative discs.

	Each disc is a Configuration in ReplicatedStorage.UBDiscs whose attributes
	are the single source of truth every client renders from:
	  Mode        "None" | "Held" | "Flight" | "Ground"
	  HolderId    actor id while held
	  FlightId    increments for every new flight segment (throw, tip, block)
	  LaunchTime  server time at which the segment starts
	  LaunchPos / LaunchVel / LaunchNormal (Vector3), Spin, Wind, GroundY
	  GroundPos   resting spot while on the ground
	  ThrowerId, ThrowerTeam, ThrowType, Quality, Skin, Context, Owner, Pull

	Flights are deterministic (DiscPhysics with a fixed step from identical
	launch values), so clients reproduce the server's trajectory exactly
	without any per-frame position replication. The server keeps a short
	position history for lag-compensated catch validation.

	Multiple discs exist at once: the match disc plus one per training session.
	A context handler decides what catches and landings mean for each disc.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)

local P = DiscConfig.Physics

local DiscService = {}

export type Sample = { t: number, x: number, y: number, z: number }

export type Handler = {
	-- may this actor claim this disc right now?
	canClaim: (disc: Disc, actorId: number, team: string) -> boolean,
	onCaught: (disc: Disc, info: { [string]: any }) -> (),
	onTouched: (disc: Disc, info: { [string]: any }) -> (),
	onGrounded: (disc: Disc, landPos: Vector3, history: { Sample }) -> (),
	-- may this holder throw right now? (e.g. a puller must wait for the whistle)
	canThrow: (disc: Disc, actorId: number) -> boolean,
	onThrown: (disc: Disc, info: { [string]: any }) -> (),
}

export type Disc = {
	id: string,
	folder: Configuration,
	context: string,
	owner: number?,
	handler: Handler,
	mode: string,
	holder: number?,
	sim: DiscPhysics.State?,
	flightId: number,
	launchTime: number,
	wind: DiscPhysics.Wind,
	groundY: number,
	history: { Sample },
	flightSamples: { Sample },
	thrower: number?,
	throwerTeam: string?,
	throwType: string?,
	quality: string?,
	releasePos: Vector3?,
	releaseAt: number,
	noCatchUntil: number,
	touched: boolean,
	claims: { any },
	resolveAt: number?,
	pull: boolean,
	skin: string,
	meta: { [string]: any },
	landAt: number,
	landPos: Vector3?,
	groundAt: number,
}

-- Late catch claims (lag compensation) may still arrive for this long after
-- the server sees the disc touch down.
local GROUND_GRACE = 0.2

local discs: { [string]: Disc } = {}
local services: any

local function now(): number
	return Net.now()
end

local function write(d: Disc, key: string, value: any)
	d.folder:SetAttribute(key, value)
end

function DiscService.create(context: string, owner: number?, handler: Handler): Disc
	local id = string.sub(HttpService:GenerateGUID(false), 1, 8)
	local folder = Instance.new("Configuration")
	folder.Name = "Disc_" .. id
	local d: Disc = {
		id = id,
		folder = folder,
		context = context,
		owner = owner,
		handler = handler,
		mode = "None",
		holder = nil,
		sim = nil,
		flightId = 0,
		launchTime = 0,
		wind = { x = 0, y = 0, z = 0 },
		groundY = 0,
		history = {},
		flightSamples = {},
		thrower = nil,
		throwerTeam = nil,
		throwType = nil,
		quality = nil,
		releasePos = nil,
		releaseAt = 0,
		noCatchUntil = 0,
		touched = false,
		claims = {},
		resolveAt = nil,
		pull = false,
		skin = "Classic",
		meta = {},
		landAt = 0,
		landPos = nil,
		groundAt = 0,
	}
	folder:SetAttribute("Id", id)
	folder:SetAttribute("Context", context)
	folder:SetAttribute("Owner", owner or 0)
	folder:SetAttribute("Mode", "None")
	folder:SetAttribute("FlightId", 0)
	folder:SetAttribute("Skin", "Classic")
	folder.Parent = Net.discs()
	discs[id] = d
	return d
end

function DiscService.destroy(d: Disc)
	if d.holder and services.MovementService then
		services.MovementService.setHolding(d.holder, false)
	end
	discs[d.id] = nil
	d.folder:Destroy()
end

function DiscService.get(id: string): Disc?
	return discs[id]
end

function DiscService.all(): { Disc }
	local list = {}
	for _, d in discs do
		table.insert(list, d)
	end
	return list
end

function DiscService.heldBy(actorId: number): Disc?
	for _, d in discs do
		if d.mode == "Held" and d.holder == actorId then
			return d
		end
	end
	return nil
end

local function setHolderAttr(d: Disc, actorId: number?)
	local prev = d.holder
	if prev and prev ~= actorId then
		local actor = services.PlayerService.get(prev)
		if actor and actor.character then
			actor.character:SetAttribute("HasDisc", false)
		end
		services.MovementService.setHolding(prev, false)
	end
	d.holder = actorId
	write(d, "HolderId", actorId or 0)
	if actorId then
		local actor = services.PlayerService.get(actorId)
		if actor and actor.character then
			actor.character:SetAttribute("HasDisc", true)
			actor.character:SetAttribute("HeldSince", now())
		end
	end
end

function DiscService.setSkin(d: Disc, skin: string)
	d.skin = skin
	write(d, "Skin", skin)
end

function DiscService.giveTo(d: Disc, actorId: number)
	d.mode = "Held"
	d.sim = nil
	d.claims = {}
	d.resolveAt = nil
	d.pull = false
	setHolderAttr(d, actorId)
	write(d, "Mode", "Held")
	write(d, "Pull", false)
	services.MovementService.setHolding(actorId, true)
end

function DiscService.placeOnGround(d: Disc, pos: Vector3)
	d.mode = "Ground"
	d.sim = nil
	d.claims = {}
	d.resolveAt = nil
	setHolderAttr(d, nil)
	write(d, "GroundPos", Vector3.new(pos.X, d.groundY + 0.15, pos.Z))
	write(d, "Mode", "Ground")
end

function DiscService.hide(d: Disc)
	d.mode = "None"
	d.sim = nil
	d.claims = {}
	d.resolveAt = nil
	setHolderAttr(d, nil)
	write(d, "Mode", "None")
end

export type LaunchMeta = {
	thrower: number?,
	throwerTeam: string?,
	throwType: string?,
	quality: string?,
	pull: boolean?,
	noCatch: number?,
	keepThrower: boolean?,
	groundY: number?,
	wind: Vector3?,
}

-- Starts a new flight segment from (pos, vel, normal, spin).
function DiscService.launch(d: Disc, pos: Vector3, vel: Vector3, normal: Vector3, spin: number, meta: LaunchMeta)
	local t0 = now()
	d.flightId += 1
	d.mode = "Flight"
	d.claims = {}
	d.resolveAt = nil
	if not meta.keepThrower then
		d.thrower = meta.thrower
		d.throwerTeam = meta.throwerTeam
		d.throwType = meta.throwType
		d.quality = meta.quality
		d.releasePos = pos
		d.releaseAt = t0
		d.touched = false
		d.pull = meta.pull == true
		d.flightSamples = {}
	end
	d.noCatchUntil = t0 + (meta.noCatch or DiscConfig.Throw.NoCatchTime)
	d.groundY = meta.groundY or d.groundY
	local windVec = meta.wind or Vector3.new(d.wind.x, d.wind.y, d.wind.z)
	setHolderAttr(d, nil)

	write(d, "LaunchPos", pos)
	write(d, "LaunchVel", vel)
	write(d, "LaunchNormal", normal)
	write(d, "Spin", spin)
	write(d, "LaunchTime", t0)
	write(d, "Wind", windVec)
	write(d, "GroundY", d.groundY)
	write(d, "ThrowerId", d.thrower or 0)
	write(d, "ThrowerTeam", d.throwerTeam or "")
	write(d, "ThrowType", d.throwType or "")
	write(d, "Quality", d.quality or "")
	write(d, "Pull", d.pull)
	write(d, "Mode", "Flight")
	write(d, "FlightId", d.flightId)

	-- Simulate from the replicated (read-back) values so the server runs
	-- exactly what clients will run.
	local rp = d.folder:GetAttribute("LaunchPos") :: Vector3
	local rv = d.folder:GetAttribute("LaunchVel") :: Vector3
	local rn = d.folder:GetAttribute("LaunchNormal") :: Vector3
	local rw = d.folder:GetAttribute("Wind") :: Vector3
	d.wind = { x = rw.X, y = rw.Y, z = rw.Z }
	d.sim = DiscPhysics.fromVectors(rp, rv, rn, spin)
	d.launchTime = t0
	d.history = { { t = t0, x = rp.X, y = rp.Y, z = rp.Z } }
	table.insert(d.flightSamples, { t = t0, x = rp.X, y = rp.Y, z = rp.Z })
end

-- Re-launch the current flight from its present position (tips, blocks, bobbles).
function DiscService.deflect(d: Disc, pos: Vector3, vel: Vector3, normal: Vector3?, spin: number?)
	local n = normal or Vector3.new(0, 1, 0)
	local s = spin or (if d.sim then (d.sim :: DiscPhysics.State).spin * 0.5 else 20)
	d.touched = true
	DiscService.launch(d, pos, vel, n, s, { keepThrower = true, noCatch = 0.06 })
end

-- Disc position at absolute server time t (interpolated from history).
function DiscService.positionAt(d: Disc, t: number): Vector3?
	if d.mode ~= "Flight" and d.mode ~= "Landed" then
		return nil
	end
	if d.mode == "Landed" and t >= d.landAt and d.landPos then
		return d.landPos
	end
	local h = d.history
	local n = #h
	if n == 0 then
		return nil
	end
	if t >= h[n].t then
		local s = d.sim
		if s then
			local x, y, z = DiscPhysics.positionAt(s, t - d.launchTime)
			return Vector3.new(x, y, z)
		end
		return Vector3.new(h[n].x, h[n].y, h[n].z)
	end
	if t <= h[1].t then
		return Vector3.new(h[1].x, h[1].y, h[1].z)
	end
	-- binary search
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if h[mid].t <= t then
			lo = mid
		else
			hi = mid
		end
	end
	local a, b = h[lo], h[hi]
	local f = (t - a.t) / math.max(b.t - a.t, 1e-6)
	return Vector3.new(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f, a.z + (b.z - a.z) * f)
end

function DiscService.velocity(d: Disc): Vector3
	local s = d.sim
	if s then
		return DiscPhysics.velocity(s)
	end
	return Vector3.zero
end

function DiscService.currentPosition(d: Disc): Vector3?
	if d.mode == "Flight" or d.mode == "Landed" then
		return DiscService.positionAt(d, now())
	elseif d.mode == "Ground" then
		return d.folder:GetAttribute("GroundPos") :: Vector3?
	elseif d.mode == "Held" and d.holder then
		local root = Actors.rootOf(d.holder)
		if root then
			return root.Position
		end
	end
	return nil
end

local function stepFlight(d: Disc, tNow: number)
	local s = d.sim
	if not s then
		return
	end
	local target = tNow - d.launchTime
	local dt = P.Dt
	local ground = d.groundY + P.GroundContact
	while s.t + dt <= target + 1e-9 do
		local ox, oy, oz = s.px, s.py, s.pz
		DiscPhysics.step(s, dt, d.wind)
		local absT = d.launchTime + s.t
		table.insert(d.history, { t = absT, x = s.px, y = s.py, z = s.pz })
		if #d.flightSamples == 0 or absT - d.flightSamples[#d.flightSamples].t >= 0.05 then
			table.insert(d.flightSamples, { t = absT, x = s.px, y = s.py, z = s.pz })
		end
		-- bots catch on the server, sweeping each step segment
		services.CatchingService.sweepBots(d, Vector3.new(ox, oy, oz), Vector3.new(s.px, s.py, s.pz), absT)
		if d.mode ~= "Flight" then
			return
		end
		if s.py <= ground or s.t > P.MaxFlightTime or math.abs(s.px) > 5000 or math.abs(s.pz) > 5000 then
			local f = if oy - s.py > 1e-9 then math.clamp((oy - ground) / (oy - s.py), 0, 1) else 1
			local land = Vector3.new(ox + (s.px - ox) * f, d.groundY, oz + (s.pz - oz) * f)
			d.mode = "Landed"
			d.landAt = d.launchTime + s.t - dt + dt * f
			d.landPos = land
			d.groundAt = tNow + GROUND_GRACE
			table.insert(d.flightSamples, { t = d.landAt, x = land.X, y = land.Y, z = land.Z })
			return
		end
	end
	-- trim history
	local cutoff = tNow - P.HistorySeconds
	local trim = 0
	for i = 1, #d.history do
		if d.history[i].t < cutoff then
			trim = i
		else
			break
		end
	end
	if trim > 1 then
		local kept = table.move(d.history, trim, #d.history, 1, {})
		d.history = kept
	end
end

function DiscService.Init(s: any)
	services = s
end

function DiscService.Start()
	RunService.Heartbeat:Connect(function()
		local t = now()
		for _, d in discs do
			if d.mode == "Flight" then
				stepFlight(d, t)
			end
			if d.resolveAt and t >= (d.resolveAt :: number) then
				d.resolveAt = nil
				services.CatchingService.resolve(d)
			end
			if d.mode == "Landed" and d.resolveAt == nil and t >= d.groundAt then
				d.mode = "Grounding"
				d.sim = nil
				d.handler.onGrounded(d, d.landPos or Vector3.zero, d.flightSamples)
				if (d.mode :: string) == "Grounding" then
					-- handler did not place it; rest where it landed
					DiscService.placeOnGround(d, d.landPos or Vector3.zero)
				end
			end
		end
	end)
end

return DiscService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">HighlightService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HighlightService — recognises plays worth celebrating.

	Highlights come only from validated server facts: the zone that made a
	catch, whether the catcher was airborne, distances, defenders nearby,
	technique chains the server accepted and converted into the play. A
	highlight never pauses play: clients show a short banner, the crowd reacts.

	  LAYOUT        catch made with the dive zone
	  SKY           airborne catch with a defender within 4.5 studs
	  HUCK          completion of 120+ studs
	  CONTESTED     clean catch that won a contest
	  FLOW xN       N consecutive quick releases (catch-and-go passing)
	  COMBO         movement chain converted into the catch (tiered)
	  LAYOUT D / HAND BLOCK / BLOCK / INTERCEPTION
	  CALLAHAN, GREATEST, HAMMER / BLADE GOAL, CLUTCH, UNIVERSE, FLOW STATE
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local ProgressionConfig = require(Shared.Config.Progression)

local HighlightService = {}

local services: any

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function HighlightService.broadcast(kind: string, actorId: number, score: number, text: string, tags: { string }?)
	local actor = services.PlayerService.get(actorId)
	local root = actor and services.PlayerService.root(actor)
	Net.event("Highlight"):FireAllClients({
		kind = kind,
		id = actorId,
		name = if actor then actor.name else "",
		team = if actor then actor.team else "",
		text = text,
		score = score,
		tags = tags or {},
		pos = if root then root.Position else nil,
	})
	if services.MatchService.phase() ~= "Intermission" then
		services.MatchService.stat(actorId, "highlights")
	end
end

local function defenderNear(actorId: number, team: string, radius: number): boolean
	local root = Actors.rootOf(actorId)
	if not root then
		return false
	end
	for _, a in services.PlayerService.all() do
		if a.role == "Match" and a.team ~= team and a.team ~= "N" then
			local r = services.PlayerService.root(a)
			if r and (r.Position - root.Position).Magnitude <= radius then
				return true
			end
		end
	end
	return false
end

local function has(outcomes: { any }, kind: string): any
	for _, o in outcomes do
		if o.kind == kind then
			return o
		end
	end
	return nil
end

local function convertCombo(actorId: number, payoff: string): any
	local summary = services.MovementService.convertCombo(actorId, payoff)
	if not summary then
		return nil
	end
	local player = Actors.playerOf(actorId)
	if player then
		Net.event("Combo"):FireClient(player, summary)
		services.ProgressionService.combo(player, summary)
	end
	return summary
end

function HighlightService.onCatch(info: any, lastPass: any, outcomes: { any })
	local tags: { string } = {}
	local score = 0
	local completion = has(outcomes, "Completion")
	local interception = has(outcomes, "Interception")
	if info.zone == "Dive" then
		table.insert(tags, if interception then "LAYOUT D" else "LAYOUT")
		score += 500
		services.MatchService.stat(info.id, "layouts")
	end
	if not info.grounded and info.zone ~= "Dive" and defenderNear(info.id, info.team, 4.5) then
		table.insert(tags, "SKY")
		score += 450
	end
	if completion and lastPass and lastPass.releasePos then
		local dist = flat(info.pos - lastPass.releasePos).Magnitude
		if dist >= 120 then
			table.insert(tags, "HUCK")
			score += 300
			services.MatchService.stat(info.id, "hucks")
			if lastPass.thrower then
				services.MatchService.stat(lastPass.thrower, "hucks")
			end
		end
		if (lastPass.flow or 0) >= 3 then
			table.insert(tags, "FLOW x" .. lastPass.flow)
			score += 120 * lastPass.flow
		end
	end
	if info.contested and info.quality == "Clean" then
		table.insert(tags, "CONTESTED")
		score += 250
	end
	if interception then
		table.insert(tags, "INTERCEPTION")
		score += 300
	end
	local payoff = if info.zone == "Dive" then "Layout Catch" elseif interception then "Interception" else "Catch"
	local combo = convertCombo(info.id, payoff)
	if combo and combo.tier then
		table.insert(tags, combo.tier .. " COMBO")
		score += math.floor(combo.score / 4)
	end
	if #tags > 0 and score >= 250 then
		HighlightService.broadcast("Catch", info.id, score, table.concat(tags, "  ·  "), tags)
	end
end

function HighlightService.onTouched(info: any, _lastPass: any)
	if info.kind == "Bobble" then
		return
	end
	local tags: { string } = {}
	local score = 250
	if info.kind == "HandBlock" then
		table.insert(tags, "HAND BLOCK")
		score = 600
	elseif info.zone == "Dive" then
		table.insert(tags, "LAYOUT D")
		score = 650
		services.MatchService.stat(info.id, "layouts")
	else
		table.insert(tags, "BLOCK")
	end
	local combo = convertCombo(info.id, "Block")
	if combo and combo.tier then
		table.insert(tags, combo.tier .. " COMBO")
		score += math.floor(combo.score / 4)
	end
	HighlightService.broadcast("Block", info.id, score, table.concat(tags, "  ·  "), tags)
end

function HighlightService.onGoal(o: any, lastPass: any, clutch: boolean)
	local tags: { string } = {}
	local score = 400
	if o.callahan then
		table.insert(tags, "CALLAHAN")
		score += 1200
	end
	if lastPass and not o.callahan then
		if lastPass.throwType == "Hammer" then
			table.insert(tags, "HAMMER")
			score += 250
		elseif lastPass.throwType == "Blade" then
			table.insert(tags, "BLADE")
			score += 200
		elseif lastPass.throwType == "Scoober" then
			table.insert(tags, "SCOOBER")
			score += 250
		end
	end
	if (o.passes or 0) >= 10 then
		table.insert(tags, "FLOW STATE")
		score += 300
	end
	if o.universe then
		table.insert(tags, "UNIVERSE")
		score += 500
	elseif clutch then
		table.insert(tags, "CLUTCH")
		score += 300
	end
	local name = Actors.nameOf(o.scorer)
	local text = if #tags > 0 then table.concat(tags, "  ·  ") else "GOAL"
	HighlightService.broadcast("Goal", o.scorer, score, text, tags)
	local _ = name
	local _ = ProgressionConfig
end

function HighlightService.Init(s: any)
	services = s
end

function HighlightService.Start() end

return HighlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- LeaderboardService — seasonal ranked leaderboard on an OrderedDataStore.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ProgressionConfig = require(Shared.Config.Progression)

local LeaderboardService = {}

local store: OrderedDataStore? = nil
local cache: { any } = {}
local cachedAt = -math.huge
local lastSubmit: { [number]: number } = {}
local names: { [number]: string } = {}

function LeaderboardService.submit(player: Player, rating: number)
	local ods = store
	if not ods then
		return
	end
	local clock = os.clock()
	if (lastSubmit[player.UserId] or -math.huge) > clock - 30 then
		return
	end
	lastSubmit[player.UserId] = clock
	task.spawn(function()
		pcall(function()
			(ods :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(rating))
		end)
	end)
end

local function refresh()
	local ods = store
	if not ods then
		return
	end
	local ok, pages = pcall(function()
		return (ods :: OrderedDataStore):GetSortedAsync(false, 50)
	end)
	if not ok or not pages then
		return
	end
	local list = {}
	for rank, entry in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(entry.key) or 0
		local name = names[userId]
		if not name then
			local okName, result = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			name = if okName and type(result) == "string" then result else ("Player " .. entry.key)
			names[userId] = name
		end
		table.insert(list, {
			rank = rank,
			userId = userId,
			name = name,
			rating = entry.value,
			division = ProgressionConfig.division(entry.value).name,
		})
	end
	cache = list
	cachedAt = os.clock()
end

function LeaderboardService.Init(_s: any)
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("UB_Rating_" .. ProgressionConfig.Rating.Season)
	end)
	if ok then
		store = result
	end
end

function LeaderboardService.Start()
	Net.func("GetLeaderboard").OnServerInvoke = function(_player)
		return { season = ProgressionConfig.Rating.Season, entries = cache, age = os.clock() - cachedAt }
	end
	-- refresh in the background so the remote never yields on DataStore calls
	task.spawn(function()
		while true do
			refresh()
			task.wait(90)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MatchService — the match loop.

	  Intermission  free-play warm-up disc, mode + arena votes (private-server
	                host can configure rules and start early)
	  PointSetup    teams line up on the goal lines they defend, frozen; end
	                zones glow in the colour of the team attacking them
	  Pull          the defending team's puller throws to the receivers
	                (modes without pulls skip straight to Live)
	  Live          the RulesEngine decides what every catch, landing, block
	                and stall-out means; this service applies the result
	  PointOver     celebration, then the next point (teams switch ends)
	  MatchOver     summary, progression, ranked rating, back to Intermission

	Match state is published as attributes on ReplicatedStorage.UBState so
	late joiners and every UI read the same truth.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ModesConfig = require(Shared.Config.Modes)
local ArenasConfig = require(Shared.Config.Arenas)
local TeamsConfig = require(Shared.Config.Teams)
local DiscConfig = require(Shared.Config.Disc)
local RulesEngine = require(Shared.Rules.RulesEngine)
local FieldGeometry = require(Shared.Rules.FieldGeometry)
local Solver = require(Shared.Disc.Solver)

local MatchService = {}

local services: any
local stateFolder: Folder

type Stats = { [string]: number }

type MatchState = {
	phase: string,
	phaseEnd: number,
	mode: any,
	arenaId: string,
	fieldName: string,
	engine: RulesEngine.State?,
	disc: any,
	warmupDisc: any,
	matchEnd: number,
	matchCount: number,
	rotation: { [string]: number },
	puller: number?,
	stats: { [number]: Stats },
	lastPass: { [string]: any }?,
	lastCatchAt: { [number]: number },
	flow: number,
	votes: { mode: { [number]: string }, arena: { [number]: string } },
	voteModes: { string },
	voteArenas: { string },
	privateConfig: { [string]: any },
	hostId: number,
	groundSince: number,
	pendingMatchOver: boolean,
	pointStartedAt: number,
	botsUsed: boolean,
}

local S: MatchState = {
	phase = "Boot",
	phaseEnd = 0,
	mode = ModesConfig.copy("Casual"),
	arenaId = ArenasConfig.Default,
	fieldName = "Standard",
	engine = nil,
	disc = nil,
	warmupDisc = nil,
	matchEnd = 0,
	matchCount = 0,
	rotation = { A = 0, B = 0 },
	puller = nil,
	stats = {},
	lastPass = nil,
	lastCatchAt = {},
	flow = 0,
	votes = { mode = {}, arena = {} },
	voteModes = {},
	voteArenas = {},
	privateConfig = {},
	hostId = 0,
	groundSince = 0,
	pendingMatchOver = false,
	pointStartedAt = 0,
	botsUsed = false,
}

local function now(): number
	return Net.now()
end

local function set(key: string, value: any)
	stateFolder:SetAttribute(key, value)
end

local function notifyAll(kind: string, text: string, data: any?)
	Net.event("Notify"):FireAllClients(kind, text, data)
end

local function notify(actorId: number, kind: string, text: string, data: any?)
	local p = services.Actors.playerOf(actorId)
	if p then
		Net.event("Notify"):FireClient(p, kind, text, data)
	end
end

function MatchService.phase(): string
	return S.phase
end

function MatchService.mode(): any
	return S.mode
end

function MatchService.engine(): RulesEngine.State?
	return S.engine
end

function MatchService.disc(): any
	return S.disc
end

---------------------------------------------------------------------------
-- stats
---------------------------------------------------------------------------

function MatchService.stat(actorId: number, key: string, n: number?)
	local st = S.stats[actorId]
	if not st then
		st = {}
		S.stats[actorId] = st
	end
	local amount = n or 1
	st[key] = (st[key] or 0) + amount
	local actor = services.PlayerService.get(actorId)
	if actor and not actor.isBot and S.phase ~= "Intermission" then
		services.ProgressionService.stat(actor, key, amount)
	end
end

---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------

local function setPhase(name: string, duration: number?)
	S.phase = name
	S.phaseEnd = if duration then now() + duration else math.huge
	set("Phase", name)
	set("PhaseEnd", if duration then S.phaseEnd else 0)
end

local function teamColor(team: string): Color3
	return if team == "A" then TeamsConfig.A.Color else TeamsConfig.B.Color
end

local function teamName(team: string): string
	return if team == "A" then TeamsConfig.A.Name else TeamsConfig.B.Name
end

local function recolorEndZones()
	local e = S.engine
	for _, side in { "East", "West" } do
		local part = services.ArenaService.endZone(side)
		if part then
			local attacker: string? = nil
			if e then
				if e.attack.A == side then
					attacker = "A"
				elseif e.attack.B == side then
					attacker = "B"
				end
			end
			part.Color = if attacker then teamColor(attacker) else Color3.fromRGB(200, 200, 210)
			local gui = part:FindFirstChild("Label")
			local text = gui and gui:FindFirstChild("Text")
			if text and text:IsA("TextLabel") then
				text.Text = if attacker then (teamName(attacker) .. " SCORES HERE") else ""
			end
		end
	end
end

local function publishScore()
	local e = S.engine
	set("ScoreA", if e then e.score.A else 0)
	set("ScoreB", if e then e.score.B else 0)
	set("Offense", if e then e.offense else "")
	set("AttackA", if e then e.attack.A else "East")
	set("AttackB", if e then e.attack.B else "West")
	set("Universe", if e then e.universe else false)
	set("CapReached", if e then e.capReached else false)
	set("Point", if e then e.pointNumber else 0)
end

local function setHolderAttr(id: number?)
	set("HolderId", id or 0)
end

local function applySkin(d: any, actorId: number)
	local actor = services.PlayerService.get(actorId)
	if actor and actor.player then
		services.DiscService.setSkin(d, services.ProgressionService.equipped(actor.player, "disc"))
	else
		services.DiscService.setSkin(d, "Classic")
	end
end

local function faceField(pos: Vector3): CFrame
	local target = Vector3.new(0, pos.Y, 0)
	if (target - pos).Magnitude < 1 then
		target = pos + Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(pos, target)
end

local function teleportToSide(actor: any, side: string, index: number, count: number)
	local f = services.ArenaService.field()
	local spots = FieldGeometry.lineup(f, side :: any, math.max(count, 1))
	local spot = spots[math.clamp(index, 1, #spots)]
	services.PlayerService.teleport(actor, faceField(spot + Vector3.new(0, 3.2, 0)))
end

local function startStallFor(id: number)
	services.DefenseService.startStall(id, S.mode.StallInterval, S.mode.StallMax)
end

---------------------------------------------------------------------------
-- disc handlers
---------------------------------------------------------------------------

local applyOutcomes: (outcomes: { any }, ctx: { [string]: any }?) -> ()

local matchHandler = {} :: any

function matchHandler.canClaim(d: any, actorId: number, team: string): boolean
	local e = S.engine
	if not e or e.phase ~= "Live" or (team ~= "A" and team ~= "B") then
		return false
	end
	local actor = services.PlayerService.get(actorId)
	if not actor or actor.role ~= "Match" then
		return false
	end
	if d.pull then
		return team == e.offense
	end
	return true
end

function matchHandler.canThrow(_d: any, actorId: number): boolean
	local e = S.engine
	if not e or e.holder ~= actorId then
		return false
	end
	if S.phase == "Pull" then
		return e.phase == "Pull"
	end
	return S.phase == "Live" and e.phase == "Live"
end

function matchHandler.onThrown(d: any, info: any)
	local e = S.engine
	if not e then
		return
	end
	local wasPull = S.phase == "Pull"
	d.meta.pullPending = false
	local caughtAt = S.lastCatchAt[info.id]
	local quick = caughtAt ~= nil and now() - caughtAt <= DiscConfig.Throw.QuickReleaseWindow
	if quick then
		S.flow += 1
	else
		S.flow = 1
	end
	S.lastPass = {
		thrower = info.id,
		team = info.team,
		throwType = info.params.throwType,
		quality = info.launch.quality,
		releasePos = info.launch.releasePos,
		releaseAt = now(),
		pull = wasPull,
		quick = quick,
		flow = S.flow,
		blocked = info.blocked,
	}
	services.DefenseService.stopStall()
	setHolderAttr(nil)
	if not wasPull then
		MatchService.stat(info.id, "throws")
		if info.launch.quality == "Perfect" then
			MatchService.stat(info.id, "perfectReleases")
		end
	end
	applyOutcomes(RulesEngine.throw(e, info.id, info.pos), { thrower = info.id })
end

function matchHandler.onCaught(d: any, info: any)
	local e = S.engine
	if not e then
		return
	end
	local outcomes = RulesEngine.catch(e, info.id, info.team, info.pos, info.grounded, info.jumpOrigin)
	if #outcomes == 0 then
		-- engine refused (should not happen); keep the world consistent
		services.DiscService.placeOnGround(d, info.pos)
		return
	end
	S.lastCatchAt[info.id] = now()
	if not info.grounded then
		services.MovementService.expectLanding(info.id)
	end
	applySkin(d, info.id)
	services.HighlightService.onCatch(info, S.lastPass, outcomes)
	applyOutcomes(outcomes, { catch = info })
end

function matchHandler.onTouched(_d: any, info: any)
	local e = S.engine
	if not e then
		return
	end
	local outcomes = RulesEngine.touch(e, info.id, info.team)
	services.HighlightService.onTouched(info, S.lastPass)
	applyOutcomes(outcomes, { touch = info })
end

local function exitPointFromSamples(samples: { any }, land: Vector3): Vector3?
	local f = services.ArenaService.field()
	local lastIn: Vector3? = nil
	for _, s in samples do
		local p = Vector3.new(s.x, f.groundY, s.z)
		if FieldGeometry.inBounds(f, p) then
			lastIn = p
		elseif lastIn then
			return FieldGeometry.exitPoint(f, lastIn, p)
		end
	end
	if lastIn and not FieldGeometry.inBounds(f, land) then
		return FieldGeometry.exitPoint(f, lastIn, land)
	end
	return nil
end

function matchHandler.onGrounded(d: any, land: Vector3, samples: { any })
	local e = S.engine
	if not e then
		services.DiscService.placeOnGround(d, land)
		return
	end
	local exitPos = exitPointFromSamples(samples, land)
	local outcomes = RulesEngine.ground(e, land, exitPos)
	if #outcomes == 0 then
		services.DiscService.placeOnGround(d, services.ArenaService.field().center)
	end
	applyOutcomes(outcomes, { land = land })
end

-- Warm-up free play: anyone can catch, throw and pick up.
local warmupHandler = {} :: any
function warmupHandler.canClaim(_d: any, actorId: number, _team: string): boolean
	local a = services.PlayerService.get(actorId)
	return a ~= nil and a.role ~= "Training"
end
function warmupHandler.canThrow(_d: any, _id: number): boolean
	return true
end
function warmupHandler.onThrown(_d: any, _info: any) end
function warmupHandler.onCaught(d: any, info: any)
	applySkin(d, info.id)
end
function warmupHandler.onTouched(_d: any, _info: any) end
function warmupHandler.onGrounded(d: any, land: Vector3, _samples: any)
	local f = services.ArenaService.field()
	services.DiscService.placeOnGround(d, FieldGeometry.clampInBounds(f, land, 2))
end

---------------------------------------------------------------------------
-- outcomes
---------------------------------------------------------------------------

local function goal(o: any)
	local e = S.engine :: RulesEngine.State
	publishScore()
	services.DefenseService.stopStall()
	setHolderAttr(nil)
	-- the point is over: the disc rests at the scorer's feet during the celebration
	local scorerRoot = services.Actors.rootOf(o.scorer)
	if S.disc then
		services.DiscService.placeOnGround(
			S.disc,
			if scorerRoot then scorerRoot.Position - Vector3.new(0, 3, 0) else Vector3.zero
		)
	end
	MatchService.stat(o.scorer, "goals")
	if o.callahan then
		MatchService.stat(o.scorer, "callahans")
	end
	if o.assist then
		MatchService.stat(o.assist, "assists")
		local lp = S.lastPass
		if lp and lp.throwType == "Hammer" then
			MatchService.stat(o.assist, "hammerGoals")
		end
	end
	if (o.passes or 0) >= 10 then
		for _, a in services.PlayerService.onTeam(o.team) do
			MatchService.stat(a.id, "flowGoals")
		end
	end
	local clutch = e.universe or e.capReached or (S.matchEnd - now() < 15)
	services.HighlightService.onGoal(o, S.lastPass, clutch)
	notifyAll("Goal", teamName(o.team) .. " SCORE", {
		team = o.team,
		scorer = o.scorer,
		assist = o.assist,
		callahan = o.callahan,
		score = o.score,
	})
	-- everyone may move and celebrate
	services.PlayerService.setAllFrozen(false)
	setPhase("PointOver", S.mode.CelebrationTime)
end

function applyOutcomes(outcomes: { any }, ctx: { [string]: any }?)
	local e = S.engine
	if not e then
		return
	end
	local d = S.disc
	local _ = ctx
	for _, o in outcomes do
		local kind = o.kind
		if kind == "Turnover" then
			services.DefenseService.stopStall()
			setHolderAttr(nil)
			services.DiscService.placeOnGround(d, o.spot)
			S.groundSince = now()
			S.flow = 0
			local lp = S.lastPass
			if lp and o.reason ~= "Stall" then
				MatchService.stat(lp.thrower, "turnovers")
			end
			notifyAll("Turnover", "TURNOVER", { reason = o.reason, team = o.team })
			publishScore()
		elseif kind == "Completion" or kind == "Interception" or kind == "PullCaught" or kind == "Pickup" then
			setHolderAttr(o.id)
			startStallFor(o.id)
			publishScore()
			if kind == "Completion" then
				MatchService.stat(o.id, "catches")
				if o.from then
					MatchService.stat(o.from, "completions")
				end
			elseif kind == "Interception" then
				MatchService.stat(o.id, "interceptions")
				MatchService.stat(o.id, "catches")
				notifyAll("Turnover", "INTERCEPTION", { reason = "Interception", team = o.team, id = o.id })
			end
		elseif kind == "Relocate" then
			local actor = services.PlayerService.get(o.id)
			if actor then
				services.PlayerService.teleport(actor, faceField(o.spot + Vector3.new(0, 3.2, 0)))
				services.MovementService.setPivot(o.id, o.spot + Vector3.new(0, 3, 0))
			end
		elseif kind == "PullReleased" then
			services.PlayerService.setAllFrozen(false)
			setPhase("Live")
			notifyAll("Banner", "PULL!", nil)
		elseif kind == "PullLanded" then
			services.DiscService.placeOnGround(d, o.spot)
			S.groundSince = now()
			if o.brick then
				notifyAll("Toast", "Pull out of bounds — brick", nil)
			end
		elseif kind == "DiscDropped" then
			services.DefenseService.stopStall()
			setHolderAttr(nil)
			services.DiscService.placeOnGround(d, o.spot)
		elseif kind == "Block" then
			MatchService.stat(o.id, "blocks")
		elseif kind == "Greatest" then
			MatchService.stat(o.id, "greatests")
			services.HighlightService.broadcast("GREATEST", o.id, 900, "The Greatest!")
		elseif kind == "Goal" then
			goal(o)
		elseif kind == "UniversePoint" then
			notifyAll("Banner", "UNIVERSE POINT", nil)
			publishScore()
		elseif kind == "CapReached" then
			notifyAll("Banner", "TIME CAP", { sub = "Finish the point" })
			publishScore()
		elseif kind == "MatchOver" then
			S.pendingMatchOver = true
		end
	end
end

---------------------------------------------------------------------------
-- phases
---------------------------------------------------------------------------

local function chooseRotating(team: string): any?
	local members = services.PlayerService.onTeam(team)
	if #members == 0 then
		return nil
	end
	S.rotation[team] = (S.rotation[team] % #members) + 1
	return members[S.rotation[team]]
end

local function setupPoint()
	local e = S.engine :: RulesEngine.State
	local setup = RulesEngine.setupPoint(e)
	S.pointStartedAt = now()
	S.lastPass = nil
	S.flow = 0
	recolorEndZones()
	publishScore()
	services.DefenseService.stopStall()
	services.DiscService.hide(S.disc)
	setHolderAttr(nil)

	local offense = services.PlayerService.onTeam(setup.offense)
	local defense = services.PlayerService.onTeam(setup.defense)
	for i, a in offense do
		teleportToSide(a, setup.offenseLine, i, #offense)
	end
	for i, a in defense do
		teleportToSide(a, setup.defenseLine, i, #defense)
	end
	services.PlayerService.setAllFrozen(true, function(a)
		return a.role == "Match"
	end)

	local f = services.ArenaService.field()
	if setup.pull then
		local puller = chooseRotating(setup.defense)
		S.puller = if puller then puller.id else nil
		if puller then
			local spot = FieldGeometry.goalLinePoint(f, Vector3.zero, setup.defenseLine)
			local inward = FieldGeometry.attackDirection(FieldGeometry.other(setup.defenseLine))
			services.PlayerService.teleport(puller, faceField(spot + inward * 2 + Vector3.new(0, 3.2, 0)))
			services.DiscService.giveTo(S.disc, puller.id)
			applySkin(S.disc, puller.id)
			S.disc.meta.pullPending = true
		end
	else
		local holder = chooseRotating(setup.offense)
		S.puller = nil
		if holder then
			local spot = FieldGeometry.goalLinePoint(f, Vector3.zero, setup.offenseLine)
			local inward = FieldGeometry.attackDirection(FieldGeometry.other(setup.offenseLine))
			services.PlayerService.teleport(holder, faceField(spot + inward * 2 + Vector3.new(0, 3.2, 0)))
			services.DiscService.giveTo(S.disc, holder.id)
			applySkin(S.disc, holder.id)
			S.disc.meta.pullHolder = holder.id
		end
	end
	notifyAll("Point", if setup.universe then "UNIVERSE POINT" else ("POINT " .. setup.point), {
		offense = setup.offense,
		pull = setup.pull,
	})
	setPhase("PointSetup", S.mode.PointSetupTime)
end

local function autoPull()
	local e = S.engine
	local pullerId = S.puller
	if not e or not pullerId then
		return false
	end
	local root = services.Actors.rootOf(pullerId)
	if not root then
		return false
	end
	local f = services.ArenaService.field()
	local target = FieldGeometry.endZoneCenter(f, RulesEngine.defends(e, e.offense))
	local d = target - root.Position
	local sol = Solver.solve({
		rootPos = root.Position,
		throwType = "Backhand",
		target = target + Vector3.new(0, 3, 0),
		groundY = f.groundY,
		wind = services.ArenaService.wind(),
		flightTimeWeight = -0.2, -- prefer hang time on a pull
		coarse = true,
	})
	local params = if sol
		then sol.params
		else {
			throwType = "Backhand",
			yaw = math.atan2(-d.X, -d.Z),
			pitch = math.rad(18),
			holdTime = 0.6,
			bank = 0,
			height = "Mid",
		}
	return services.ThrowService.throw(pullerId, params, true) ~= nil
end

function MatchService.pullNow(id: number)
	if S.phase == "Pull" and S.puller == id then
		autoPull()
	end
end

local function endPointSetup()
	local e = S.engine :: RulesEngine.State
	if S.mode.UsePull and S.puller then
		RulesEngine.beginPull(e, S.puller)
		setPhase("Pull", S.mode.PullTimeout)
		local puller = services.PlayerService.get(S.puller)
		if puller then
			services.PlayerService.setFrozen(puller, false)
			if puller.isBot then
				services.BotService.schedulePull(puller.id)
			else
				notify(puller.id, "Banner", "YOU'RE PULLING", { sub = "Throw it deep to the other team" })
			end
		end
	else
		local holder = S.disc.meta.pullHolder
		RulesEngine.beginLive(e, holder)
		services.PlayerService.setAllFrozen(false)
		setPhase("Live")
		if holder then
			setHolderAttr(holder)
			startStallFor(holder)
		end
		notifyAll("Banner", "GO!", nil)
	end
end

local function summary()
	local e = S.engine :: RulesEngine.State
	local rows = {}
	local mvp, mvpScore = nil, -1
	for _, a in services.PlayerService.all() do
		if a.team == "A" or a.team == "B" then
			local st: Stats = S.stats[a.id] or {}
			local score = (st.goals or 0) * 3
				+ (st.assists or 0) * 3
				+ (st.blocks or 0) * 2
				+ (st.interceptions or 0) * 2
				+ (st.catches or 0) * 0.5
				+ (st.highlights or 0)
			table.insert(rows, {
				id = a.id,
				name = a.name,
				team = a.team,
				bot = a.isBot,
				goals = st.goals or 0,
				assists = st.assists or 0,
				blocks = st.blocks or 0,
				catches = st.catches or 0,
				throws = st.throws or 0,
				completions = st.completions or 0,
				turnovers = st.turnovers or 0,
				highlights = st.highlights or 0,
			})
			if score > mvpScore then
				mvp, mvpScore = a.id, score
			end
		end
	end
	local result: { [string]: any } = {
		winner = e.winner,
		score = { A = e.score.A, B = e.score.B },
		rows = rows,
		mvp = mvp,
		mode = S.mode.Display,
	}
	return result
end

local function endMatch()
	local e = S.engine :: RulesEngine.State
	local sum = summary()
	local rankedValid = false
	if S.mode.Ranked and not S.botsUsed then
		local a, b = 0, 0
		for _, row in sum.rows do
			if not row.bot then
				if row.team == "A" then
					a += 1
				else
					b += 1
				end
			end
		end
		rankedValid = a >= 2 and b >= 2
	end
	local ratingChanges = services.ProgressionService.matchEnded(
		e.winner,
		S.stats,
		sum.rows,
		rankedValid,
		math.abs(e.score.A - e.score.B)
	)
	sum.ratingChanges = ratingChanges
	sum.ranked = rankedValid
	Net.event("Summary"):FireAllClients(sum)
	notifyAll(
		"Banner",
		(if e.winner then teamName(e.winner) else "") .. " WIN",
		{ sub = string.format("%d - %d", e.score.A, e.score.B) }
	)
	services.DefenseService.stopStall()
	services.PlayerService.setAllFrozen(false)
	setPhase("MatchOver", 12)
end

local function tally(votes: { [number]: string }, options: { string }, fallback: string): string
	local counts: { [string]: number } = {}
	for id, v in votes do
		if services.PlayerService.get(id) then
			counts[v] = (counts[v] or 0) + 1
		end
	end
	local best, bestN = fallback, 0
	for _, opt in options do
		if (counts[opt] or 0) > bestN then
			best, bestN = opt, counts[opt]
		end
	end
	return best
end

local function publishVotes()
	local counts = { mode = {}, arena = {} }
	for _, v in S.votes.mode do
		counts.mode[v] = (counts.mode[v] or 0) + 1
	end
	for _, v in S.votes.arena do
		counts.arena[v] = (counts.arena[v] or 0) + 1
	end
	set("VoteCounts", HttpService:JSONEncode(counts))
end

local function humansNotTraining(): number
	local n = 0
	for _, a in services.PlayerService.humans() do
		if a.role ~= "Training" then
			n += 1
		end
	end
	return n
end

local function startIntermission()
	S.engine = nil
	S.pendingMatchOver = false
	services.TeamService.clearMatch()
	services.DefenseService.stopStall()
	if S.disc then
		services.DiscService.hide(S.disc)
	end
	-- warm-up disc on the field
	if not S.warmupDisc then
		S.warmupDisc = services.DiscService.create("Warmup", nil, warmupHandler)
	end
	services.DiscService.placeOnGround(S.warmupDisc, Vector3.new(0, 0, -20))
	recolorEndZones()
	publishScore()
	setHolderAttr(nil)
	S.votes = { mode = {}, arena = {} }
	local humans = humansNotTraining()
	local modes = {}
	for _, id in ModesConfig.Order do
		local m = (ModesConfig.List :: any)[id]
		if m.Selectable and (not m.Ranked or humans >= 4) then
			table.insert(modes, id)
		end
	end
	local arenas = {}
	local order = ArenasConfig.Order
	for i = 0, 2 do
		table.insert(arenas, order[((S.matchCount + i) % #order) + 1])
	end
	S.voteModes = modes
	S.voteArenas = arenas
	set("VoteModes", table.concat(modes, ","))
	set("VoteArenas", table.concat(arenas, ","))
	publishVotes()
	services.PlayerService.setAllFrozen(false)
	setPhase("Intermission", if humans > 0 then 20 else nil)
end

local function startMatch()
	if S.warmupDisc then
		services.DiscService.hide(S.warmupDisc)
	end
	-- resolve votes (private server host overrides)
	local modeId = tally(S.votes.mode, S.voteModes, "Casual")
	local arenaId = tally(S.votes.arena, S.voteArenas, S.voteArenas[1] or ArenasConfig.Default)
	local host = S.hostId
	if host ~= 0 then
		modeId = S.votes.mode[host] or modeId
		arenaId = S.votes.arena[host] or arenaId
	end
	local mode = ModesConfig.copy(modeId)
	if mode.Ranked and humansNotTraining() < 4 then
		mode = ModesConfig.copy("Casual")
	end
	if host ~= 0 then
		for k, v in S.privateConfig do
			(mode :: any)[k] = v
		end
	end
	local arena = (ArenasConfig.List :: any)[arenaId] or ArenasConfig.List[ArenasConfig.Default]
	if (mode.Ranked and not arena.Competitive) or (not mode.SpecialArenas and arena.Rebound) then
		arena = ArenasConfig.List[ArenasConfig.Default]
	end
	S.mode = mode
	S.matchCount += 1
	if arena.id ~= S.arenaId or mode.Field ~= S.fieldName then
		S.arenaId = arena.id
		S.fieldName = mode.Field
		services.ArenaService.build(arena.id, mode.Field)
	end
	set("Mode", mode.id)
	set("ModeName", mode.Display)
	set("PointsToWin", mode.PointsToWin)
	set("StallMax", mode.StallMax)
	set("PreviewFraction", mode.PreviewFraction)
	set("LandingShadow", mode.LandingShadow)
	set("Ranked", mode.Ranked)

	services.TeamService.assignForMatch(mode)
	S.botsUsed = false
	for _, a in services.PlayerService.all() do
		if a.isBot then
			S.botsUsed = true
		end
	end

	S.stats = {}
	S.lastCatchAt = {}
	S.rotation = { A = 0, B = 0 }
	local engine =
		RulesEngine.new(services.ArenaService.field(), { pointsToWin = mode.PointsToWin, usePull = mode.UsePull })
	local first = if S.matchCount % 2 == 0 then "A" else "B"
	RulesEngine.startMatch(engine, first, "East")
	engine.universe = mode.StartUniverse
	S.engine = engine
	S.matchEnd = now() + mode.TimeCap
	set("MatchEnd", S.matchEnd)
	if not S.disc then
		S.disc = services.DiscService.create("Match", nil, matchHandler)
	end
	set("DiscId", S.disc.id)
	notifyAll("Banner", string.upper(mode.Display), { sub = arena.Display })
	setupPoint()
end

---------------------------------------------------------------------------
-- per-frame
---------------------------------------------------------------------------

local function pickupCheck(d: any, allowTeam: string?)
	if not d or d.mode ~= "Ground" then
		return
	end
	local spot = d.folder:GetAttribute("GroundPos") :: Vector3?
	if not spot then
		return
	end
	local best, bestDist = nil, DiscConfig.Catch.PickupRadius
	for _, a in services.PlayerService.all() do
		if a.role ~= "Training" and (allowTeam == nil or a.team == allowTeam) then
			local root = services.PlayerService.root(a)
			if root then
				local dist = Vector3.new(root.Position.X - spot.X, 0, root.Position.Z - spot.Z).Magnitude
				if dist < bestDist and math.abs(root.Position.Y - spot.Y) < 8 then
					best, bestDist = a, dist
				end
			end
		end
	end
	if not best then
		return
	end
	if allowTeam then
		local e = S.engine :: RulesEngine.State
		local outcomes = RulesEngine.pickup(e, best.id, best.team)
		if #outcomes == 0 then
			return
		end
		services.PlayerService.teleport(
			best,
			CFrame.new(Vector3.new(spot.X, spot.Y + 3, spot.Z))
				* (services.PlayerService.root(best) :: BasePart).CFrame.Rotation
		)
		services.DiscService.giveTo(d, best.id)
		services.MovementService.setPivot(best.id, Vector3.new(spot.X, spot.Y + 3, spot.Z))
		applySkin(d, best.id)
		applyOutcomes(outcomes)
	else
		services.DiscService.giveTo(d, best.id)
		applySkin(d, best.id)
	end
end

local function step()
	local t = now()
	local phase = S.phase
	if phase == "Intermission" then
		pickupCheck(S.warmupDisc, nil)
		if S.phaseEnd == math.huge and humansNotTraining() > 0 then
			S.phaseEnd = t + 20
			set("PhaseEnd", S.phaseEnd)
		elseif S.phaseEnd ~= math.huge and humansNotTraining() == 0 and #services.PlayerService.humans() == 0 then
			setPhase("Intermission", nil)
		end
		if t >= S.phaseEnd then
			-- startMatch yields (arena rebuild, bot spawning); mark the phase
			-- first so later Heartbeats cannot start a second match
			setPhase("Starting")
			task.spawn(function()
				local ok, err = pcall(function()
					startMatch()
				end)
				if not ok then
					warn("[MatchService] startMatch failed: " .. tostring(err))
					startIntermission()
				end
			end)
		end
		return
	end
	if phase == "Starting" then
		return
	end
	local e = S.engine
	if not e then
		return
	end
	if
		t >= S.matchEnd
		and not e.capReached
		and (phase == "Live" or phase == "Pull" or phase == "PointSetup" or phase == "PointOver")
	then
		applyOutcomes(RulesEngine.reachCap(e))
	end
	if phase == "PointSetup" then
		if t >= S.phaseEnd then
			endPointSetup()
		end
	elseif phase == "Pull" then
		if t >= S.phaseEnd then
			if not autoPull() then
				-- the puller vanished: give the receivers the disc at the brick
				RulesEngine.beginLive(e, nil)
				e.disc = "Ground"
				local f = services.ArenaService.field()
				local spot = FieldGeometry.brickPoint(f, RulesEngine.defends(e, e.offense))
				e.discSpot = spot
				services.DiscService.placeOnGround(S.disc, spot)
				services.PlayerService.setAllFrozen(false)
				setPhase("Live")
			end
		end
	elseif phase == "Live" then
		if e.disc == "Ground" then
			pickupCheck(S.disc, e.offense)
		end
		if e.phase == "MatchOver" and not S.pendingMatchOver then
			S.pendingMatchOver = true
		end
	elseif phase == "PointOver" then
		if t >= S.phaseEnd then
			if S.pendingMatchOver or e.phase == "MatchOver" then
				endMatch()
			else
				setupPoint()
			end
		end
	elseif phase == "MatchOver" then
		if t >= S.phaseEnd then
			startIntermission()
		end
	end
	-- time cap reached between points ends the match
	if e.phase == "MatchOver" and (S.phase == "PointSetup" or S.phase == "Pull") then
		endMatch()
	end
end

---------------------------------------------------------------------------
-- roster changes
---------------------------------------------------------------------------

local function placeIntoMatch(actor: any)
	if S.phase == "Intermission" or S.phase == "Boot" or S.phase == "MatchOver" then
		services.PlayerService.teleport(actor, services.ArenaService.spawnCFrame())
		return
	end
	services.TeamService.placeLateJoiner(actor)
	local e = S.engine
	if e and (actor.team == "A" or actor.team == "B") then
		local side = RulesEngine.defends(e, actor.team)
		teleportToSide(actor, side, math.random(1, 5), 5)
		services.PlayerService.setFrozen(actor, S.phase == "PointSetup" or (S.phase == "Pull" and actor.id ~= S.puller))
	end
end

local function onActorRemoving(actor: any)
	local e = S.engine
	if e and e.holder == actor.id then
		local root = services.PlayerService.root(actor)
		local pos = if root then root.Position else services.ArenaService.field().center
		if S.phase == "Pull" then
			S.puller = nil
		end
		applyOutcomes(RulesEngine.holderLeft(e, pos))
	end
	S.votes.mode[actor.id] = nil
	S.votes.arena[actor.id] = nil
	if not actor.isBot and S.engine then
		task.defer(function()
			services.TeamService.rebalance()
		end)
	end
end

---------------------------------------------------------------------------
-- actions
---------------------------------------------------------------------------

local function isHost(actorId: number): boolean
	return S.hostId ~= 0 and actorId == S.hostId
end

function MatchService.action(player: Player, kind: string, payload: any)
	local actor = services.PlayerService.fromPlayer(player)
	if not actor then
		return
	end
	if kind == "Vote" and S.phase == "Intermission" and type(payload) == "table" then
		if payload.mode and table.find(S.voteModes, payload.mode) then
			S.votes.mode[actor.id] = payload.mode
		end
		if payload.arena and table.find(S.voteArenas, payload.arena) then
			S.votes.arena[actor.id] = payload.arena
		end
		publishVotes()
	elseif kind == "StartNow" and isHost(actor.id) and S.phase == "Intermission" then
		S.phaseEnd = now()
	elseif kind == "PrivateConfig" and isHost(actor.id) and type(payload) == "table" then
		local spec = (ModesConfig.Editable :: any)[payload.key]
		if spec then
			local v = payload.value
			if
				(spec.bool and type(v) == "boolean")
				or (spec.options and type(v) == "string" and table.find(spec.options, v))
			then
				S.privateConfig[payload.key] = v
			elseif spec.min and type(v) == "number" and v == v then
				S.privateConfig[payload.key] = math.clamp(v, spec.min, spec.max)
			end
			set("PrivateConfig", HttpService:JSONEncode(S.privateConfig))
		end
	elseif kind == "Celebrate" and S.phase == "PointOver" or (kind == "Celebrate" and S.phase == "MatchOver") then
		if actor.character and actor.player then
			actor.character:SetAttribute("Celebrate", services.ProgressionService.equipped(actor.player, "celebration"))
			actor.character:SetAttribute("CelebrateT", now())
		end
	elseif kind == "JoinMatch" then
		if actor.role == "Training" then
			services.TrainingService.leave(actor)
		end
		if actor.role ~= "Match" then
			placeIntoMatch(actor)
		end
	end
end

function MatchService.onLeftTraining(actor: any)
	placeIntoMatch(actor)
end

function MatchService.Init(s: any)
	services = s
	stateFolder = Net.state()
end

function MatchService.Start()
	-- host for private servers (or the first player in Studio)
	if game.PrivateServerOwnerId ~= 0 then
		S.hostId = game.PrivateServerOwnerId
	end
	set("HostId", S.hostId)

	services.PlayerService.ActorAdded:Connect(function(actor)
		if actor.isBot then
			return
		end
		if S.hostId == 0 and RunService:IsStudio() then
			S.hostId = actor.id
			set("HostId", S.hostId)
		end
		task.defer(function()
			placeIntoMatch(actor)
		end)
	end)
	services.PlayerService.ActorRemoving:Connect(onActorRemoving)
	services.PlayerService.CharacterSpawned:Connect(function(actor, _model)
		if actor.isBot then
			return
		end
		task.defer(function()
			if actor.role == "Match" and S.engine and (actor.team == "A" or actor.team == "B") then
				local e = S.engine :: RulesEngine.State
				if e.holder == actor.id then
					applyOutcomes(RulesEngine.holderLeft(e, services.ArenaService.field().center))
				end
				teleportToSide(actor, RulesEngine.defends(e, actor.team), math.random(1, 5), 5)
				services.PlayerService.setFrozen(actor, S.phase == "PointSetup")
			elseif actor.role == "Training" then
				services.TrainingService.respawned(actor)
			else
				services.PlayerService.teleport(actor, services.ArenaService.spawnCFrame())
			end
		end)
	end)
	services.MovementService.Landed:Connect(function(id, pos)
		local e = S.engine
		if e and e.holder == id and e.pending then
			applyOutcomes(RulesEngine.land(e, id, pos))
		end
	end)
	services.MovementService.Travel:Connect(function(id)
		notify(id, "Toast", "Travel — reset to your pivot", nil)
	end)
	services.DefenseService.StallOut:Connect(function(holderId)
		local e = S.engine
		if e and e.holder == holderId and S.phase == "Live" then
			local root = services.Actors.rootOf(holderId)
			notifyAll("Turnover", "STALL", { reason = "Stall" })
			applyOutcomes(RulesEngine.stall(e, if root then root.Position else Vector3.zero))
		end
	end)
	Net.event("Action").OnServerEvent:Connect(function(player, kind, payload)
		if type(kind) ~= "string" then
			return
		end
		MatchService.action(player, kind, payload)
		services.ProgressionService.action(player, kind, payload)
		services.TrainingService.action(player, kind, payload)
	end)
	RunService.Heartbeat:Connect(step)
	startIntermission()
	local _ = Players
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MovementService (server) — authority over how actors are allowed to move.

	Movement is simulated on each client for responsiveness (the client owns
	its character's physics). The server never trusts that blindly:

	  * Kinematics: every actor's position/velocity is sampled; a ground
	    raycast gives an authoritative grounded flag, the last grounded point
	    (needed for "did they jump from in bounds?") and touchdown events.
	  * Techniques: clients report technique events; the server checks names,
	    rate, cooldowns (mirrored from Config/Movement) and an exertion budget,
	    then replicates accepted ones as character attributes so every client
	    can pose that character. Rejected events earn nothing (no combo, no
	    highlight) and are counted.
	  * Speed: displacement over 0.2 s windows must stay under the hard cap
	    plus latency slack; repeated violations snap the actor back.
	  * Travel: a disc holder must stay within the pivot radius once their
	    pivot is set; leaving it snaps them back to the pivot ("Travel").
	  * Fake Commit replicates as a generic "Lean" so opponents see a real
	    sell, not a label that says "this is a fake".
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MovementConfig = require(Shared.Config.Movement)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)

local MovementService = {}

MovementService.Landed = Signal.new() -- (actorId, position)
MovementService.TechAccepted = Signal.new() -- (actorId, tech, quality, info)
MovementService.Travel = Signal.new() -- (actorId)

local services: any

export type Track = {
	id: number,
	pos: Vector3,
	vel: Vector3,
	grounded: boolean,
	heightAboveGround: number,
	lastGroundedPos: Vector3,
	airborneSince: number?,
	lastSamplePos: Vector3,
	lastSampleAt: number,
	lastGoodPos: Vector3,
	strikes: number,
	strikeAt: number,
	graceUntil: number,
	ready: { [string]: number },
	exertion: number,
	techTimes: { number },
	rejected: number,
	combo: ComboEvaluator.Tracker,
	mode: string,
	lastTech: string?,
	lastTechAt: number,
	lastDiveAt: number,
	-- holding
	holding: boolean,
	holdStart: number,
	pivot: Vector3?,
	pendingLanding: boolean,
	wasGrounded: boolean,
}

local tracks: { [number]: Track } = {}

local KNOWN_TECHS = MovementConfig.TechCosts
local VALID_MODES = {
	Ground = true,
	Air = true,
	Slide = true,
	Dive = true,
	DiveSlide = true,
	Recover = true,
	Landing = true,
	Frozen = true,
}
local MAX_TECHS_PER_SECOND = 12
local SAMPLE = 0.2
local GROUND_PROBE = 4.2 -- root centre to ground when standing is ~3

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function now(): number
	return Net.now()
end

local function newTrack(id: number, pos: Vector3): Track
	return {
		id = id,
		pos = pos,
		vel = Vector3.zero,
		grounded = true,
		heightAboveGround = 0,
		lastGroundedPos = pos,
		airborneSince = nil,
		lastSamplePos = pos,
		lastSampleAt = os.clock(),
		lastGoodPos = pos,
		strikes = 0,
		strikeAt = 0,
		graceUntil = os.clock() + 1,
		ready = {},
		exertion = MovementConfig.ExertionMax,
		techTimes = {},
		rejected = 0,
		combo = ComboEvaluator.newTracker(),
		mode = "Ground",
		lastTech = nil,
		lastTechAt = -math.huge,
		lastDiveAt = -math.huge,
		holding = false,
		holdStart = 0,
		pivot = nil,
		pendingLanding = false,
		wasGrounded = true,
	}
end

function MovementService.track(id: number): Track?
	return tracks[id]
end

function MovementService.noteTeleport(id: number)
	local t = tracks[id]
	if t then
		t.graceUntil = os.clock() + 0.8
	end
end

local function exclusionList(): { Instance }
	local list: { Instance } = {}
	for _, c in Actors.characters() do
		table.insert(list, c)
	end
	return list
end

-- Updates kinematics for every actor (runs every Heartbeat; cheap).
local function updateKinematics()
	local exclude = exclusionList()
	rayParams.FilterDescendantsInstances = exclude
	local clock = os.clock()
	for _, actor in services.PlayerService.all() do
		local root = services.PlayerService.root(actor)
		if root then
			local t = tracks[actor.id]
			local pos = root.Position
			if not t then
				t = newTrack(actor.id, pos)
				tracks[actor.id] = t
			end
			local track = t :: Track
			track.pos = pos
			track.vel = root.AssemblyLinearVelocity
			local hit = workspace:Raycast(pos, Vector3.new(0, -GROUND_PROBE - 2, 0), rayParams)
			local h = if hit then pos.Y - hit.Position.Y else math.huge
			track.heightAboveGround = h
			local grounded = h <= GROUND_PROBE and track.vel.Y < 8
			track.grounded = grounded
			if grounded then
				track.lastGroundedPos = Vector3.new(pos.X, if hit then hit.Position.Y else pos.Y - 3, pos.Z)
				track.airborneSince = nil
			elseif track.airborneSince == nil then
				track.airborneSince = clock
			end
			if grounded and not track.wasGrounded then
				if track.pendingLanding then
					track.pendingLanding = false
					MovementService.Landed:Fire(actor.id, track.lastGroundedPos)
				end
			end
			track.wasGrounded = grounded

			-- speed validation on sample windows (humans only; bots are server-driven)
			if not actor.isBot and clock - track.lastSampleAt >= SAMPLE then
				local dt = clock - track.lastSampleAt
				local disp = Vector3.new(pos.X - track.lastSamplePos.X, 0, pos.Z - track.lastSamplePos.Z).Magnitude
				local speed = disp / dt
				local allowed = MovementConfig.HardCap * 1.25 + 6
				if clock < track.graceUntil then
					track.lastGoodPos = pos
				elseif speed > allowed then
					track.strikes += 1
					track.strikeAt = clock
					if track.strikes >= 3 then
						warn(string.format("[MovementService] %s moved %.1f studs/s; resetting", actor.name, speed))
						track.strikes = 0
						services.PlayerService.teleport(actor, CFrame.new(track.lastGoodPos + Vector3.new(0, 0.5, 0)))
					end
				else
					if clock - track.strikeAt > 4 then
						track.strikes = 0
					end
					track.lastGoodPos = pos
				end
				-- long hover with no ground below and no vertical motion
				if
					track.airborneSince
					and clock - (track.airborneSince :: number) > 4
					and math.abs(track.vel.Y) < 1
					and clock >= track.graceUntil
				then
					track.airborneSince = clock
					services.PlayerService.teleport(actor, CFrame.new(track.lastGroundedPos + Vector3.new(0, 3, 0)))
				end
				track.lastSamplePos = pos
				track.lastSampleAt = clock
			end

			-- travel enforcement
			if track.holding then
				if
					track.pivot == nil
					and grounded
					and now() - track.holdStart >= MovementConfig.Holding.DecelMaxTime + 0.15
				then
					track.pivot = Vector3.new(pos.X, pos.Y, pos.Z)
				end
				local pivot = track.pivot
				if pivot and grounded and not actor.isBot then
					local d = Vector3.new(pos.X - pivot.X, 0, pos.Z - pivot.Z).Magnitude
					if d > MovementConfig.Holding.PivotRadius + 2.5 and clock >= track.graceUntil then
						services.PlayerService.teleport(actor, CFrame.new(pivot) * root.CFrame.Rotation)
						MovementService.Travel:Fire(actor.id)
					end
				end
			end
		end
	end
end

-- Exertion mirror: regenerates while the actor is not sprinting.
local function regen(dt: number)
	for _, t in tracks do
		local flat = Vector3.new(t.vel.X, 0, t.vel.Z).Magnitude
		if flat > MovementConfig.JogSpeed + 1 then
			t.exertion = math.max(-40, t.exertion - MovementConfig.SprintDrain * dt)
		else
			t.exertion = math.min(MovementConfig.ExertionMax, t.exertion + MovementConfig.ExertionRegen * dt)
		end
	end
end

local function replicate(actorId: number, tech: string, quality: string, dir: Vector3, info: string?)
	local actor = services.PlayerService.get(actorId)
	local c = actor and actor.character
	if not c then
		return
	end
	local public = tech
	if tech == "FakeCommit" then
		public = "Lean"
	end
	c:SetAttribute("TechDir", dir)
	c:SetAttribute("TechQ", quality)
	c:SetAttribute("TechInfo", info or "")
	c:SetAttribute("Tech", public)
	c:SetAttribute("TechT", now())
end

-- Validates one reported technique. Returns true if accepted.
local function accept(t: Track, tech: string, quality: string): boolean
	local clock = os.clock()
	if KNOWN_TECHS[tech] == nil then
		return false
	end
	-- rate limit
	while #t.techTimes > 0 and clock - t.techTimes[1] > 1 do
		table.remove(t.techTimes, 1)
	end
	if #t.techTimes >= MAX_TECHS_PER_SECOND then
		return false
	end
	-- cooldown mirror (with latency slack)
	local cd = (MovementConfig.TechCooldowns :: any)[tech] or 0
	if cd > 0 and (t.ready[tech] or -math.huge) > clock + 0.12 then
		return false
	end
	local cost = (MovementConfig.TechCosts :: any)[tech] or 0
	if t.exertion < -30 and cost > 0 and quality ~= "Gassed" then
		-- client claims a full-strength technique it cannot have afforded
		return false
	end
	table.insert(t.techTimes, clock)
	t.ready[tech] = clock + cd
	t.exertion -= cost
	return true
end

local VALID_QUALITY = { Perfect = true, Clean = true, Sloppy = true, Gassed = true }

local function onTech(player: Player, events: any, mode: any)
	local actor = services.PlayerService.fromPlayer(player)
	if not actor then
		return
	end
	local t = tracks[actor.id]
	if not t then
		return
	end
	if type(mode) == "string" and VALID_MODES[mode] and mode ~= t.mode then
		t.mode = mode
		if actor.character then
			actor.character:SetAttribute("MS", mode)
		end
	end
	if type(events) ~= "table" then
		return
	end
	local n = 0
	for _, e in events do
		n += 1
		if n > 6 then
			break
		end
		if type(e) == "table" and type(e.tech) == "string" then
			local quality = if type(e.quality) == "string" and VALID_QUALITY[e.quality] then e.quality else "Clean"
			local dir = if typeof(e.dir) == "Vector3" then e.dir else Vector3.zero
			if dir.Magnitude > 1.01 or dir.Magnitude ~= dir.Magnitude then
				dir = Vector3.zero
			end
			local info = if type(e.info) == "string" and #e.info <= 24 then e.info else nil
			if accept(t, e.tech, quality) then
				t.lastTech = e.tech
				t.lastTechAt = now()
				if e.tech == "Dive" then
					t.lastDiveAt = now()
				end
				replicate(actor.id, e.tech, quality, dir, info)
				ComboEvaluator.add(t.combo, e.tech, quality, now())
				MovementService.TechAccepted:Fire(actor.id, e.tech, quality, info)
			else
				t.rejected += 1
			end
		end
	end
end

-- Server-driven technique for bots (no validation needed).
function MovementService.botTech(id: number, tech: string, dir: Vector3, mode: string?)
	local t = tracks[id]
	if t then
		t.lastTech = tech
		t.lastTechAt = now()
		if tech == "Dive" then
			t.lastDiveAt = now()
		end
		if mode then
			t.mode = mode
		end
	end
	replicate(id, tech, "Clean", dir, nil)
	local actor = services.PlayerService.get(id)
	if actor and actor.character and mode then
		actor.character:SetAttribute("MS", mode)
	end
end

function MovementService.setBotMode(id: number, mode: string)
	local t = tracks[id]
	if t then
		t.mode = mode
	end
	local actor = services.PlayerService.get(id)
	if actor and actor.character then
		actor.character:SetAttribute("MS", mode)
	end
end

-- Is the actor currently in a layout (dive) or its ground slide?
function MovementService.isDiving(id: number): boolean
	local t = tracks[id]
	if not t then
		return false
	end
	return t.mode == "Dive" or t.mode == "DiveSlide" or now() - t.lastDiveAt < 0.9
end

function MovementService.isSliding(id: number): boolean
	local t = tracks[id]
	return t ~= nil and t.mode == "Slide"
end

function MovementService.isOnGroundAfterLayout(id: number): boolean
	local t = tracks[id]
	return t ~= nil and (t.mode == "DiveSlide" or t.mode == "Recover") and now() - t.lastDiveAt < 2
end

function MovementService.setHolding(id: number, holding: boolean)
	local t = tracks[id]
	if not t then
		return
	end
	t.holding = holding
	t.holdStart = now()
	t.pivot = nil
	t.pendingLanding = holding and not t.grounded
end

function MovementService.setPivot(id: number, pos: Vector3)
	local t = tracks[id]
	if t then
		t.pivot = pos
	end
end

function MovementService.expectLanding(id: number)
	local t = tracks[id]
	if t then
		t.pendingLanding = true
	end
end

function MovementService.convertCombo(id: number, payoff: string): ComboEvaluator.Summary?
	local t = tracks[id]
	if not t then
		return nil
	end
	return ComboEvaluator.convert(t.combo, now(), payoff)
end

function MovementService.Init(s: any)
	services = s
end

function MovementService.Start()
	Net.event("Tech").OnServerEvent:Connect(onTech)
	RunService.Heartbeat:Connect(function(dt)
		updateKinematics()
		regen(dt)
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		tracks[actor.id] = nil
	end)
	services.PlayerService.CharacterSpawned:Connect(function(actor, model)
		local root = model:WaitForChild("HumanoidRootPart", 5) :: BasePart?
		if root then
			tracks[actor.id] = newTrack(actor.id, root.Position)
		end
	end)
	local _ = Players
end

return MovementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlayerService — the roster of actors (human players and bots).

	Owns team objects, character setup (collision group, attributes the rest
	of the game keys on), teleports and the per-actor "frozen" flag used during
	line-ups. Players never collide with each other (ultimate is a non-contact
	sport; body positioning is resolved by catch geometry instead).
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeamsService = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local TeamsConfig = require(Shared.Config.Teams)

local PlayerService = {}

export type Actor = {
	id: number,
	name: string,
	player: Player?,
	isBot: boolean,
	team: string, -- "A" | "B" | "N"
	role: string, -- "Match" | "Training" | "Spectate"
	character: Model?,
	teleportCount: number,
	joinedAt: number,
}

local actors: { [number]: Actor } = {}
local teamObjects: { [string]: Team } = {}
local services: any

PlayerService.ActorAdded = Signal.new()
PlayerService.ActorRemoving = Signal.new()
PlayerService.CharacterSpawned = Signal.new()
PlayerService.TeamChanged = Signal.new()

PlayerService.CollisionGroup = "UBPlayers"

-- Root parts collide with the world but not with each other. Limbs collide
-- with nothing: the procedural layout/slide poses must never snag the ground
-- (the Humanoid floats on its root part, so limbs need no collision).
PlayerService.LimbGroup = "UBLimbs"

local function setupCollisionGroups()
	for _, g in { PlayerService.CollisionGroup, PlayerService.LimbGroup } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(g)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable(PlayerService.CollisionGroup, PlayerService.CollisionGroup, false)
	PhysicsService:CollisionGroupSetCollidable(PlayerService.LimbGroup, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(PlayerService.LimbGroup, PlayerService.CollisionGroup, false)
	PhysicsService:CollisionGroupSetCollidable(PlayerService.LimbGroup, PlayerService.LimbGroup, false)
end

local function setupTeams()
	local list: { [string]: any } = { A = TeamsConfig.A, B = TeamsConfig.B, N = TeamsConfig.Neutral }
	for key, cfg in list do
		local t = TeamsService:FindFirstChild(cfg.Name) :: Team?
		if not t then
			local nt = Instance.new("Team")
			nt.Name = cfg.Name
			nt.TeamColor = cfg.BrickColor
			nt.AutoAssignable = false
			nt.Parent = TeamsService
			t = nt
		end
		teamObjects[key] = t :: Team
	end
end

local function groupFor(part: BasePart): string
	return if part.Name == "HumanoidRootPart" then PlayerService.CollisionGroup else PlayerService.LimbGroup
end

local function applyCollision(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = groupFor(d)
		end
	end
	model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = groupFor(d)
		end
	end)
end

local function stampCharacter(actor: Actor, model: Model)
	model:SetAttribute("UBId", actor.id)
	model:SetAttribute("UBTeam", actor.team)
	model:SetAttribute("UBName", actor.name)
	model:SetAttribute("UBRole", actor.role)
	model:SetAttribute("UBTeleport", actor.teleportCount)
end

function PlayerService.setupCharacter(actor: Actor, model: Model)
	actor.character = model
	applyCollision(model)
	stampCharacter(actor, model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.BreakJointsOnDeath = false
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 0
		humanoid.AutoRotate = false
		if not actor.isBot then
			humanoid.WalkSpeed = 0
		end
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	PlayerService.CharacterSpawned:Fire(actor, model)
end

local function onPlayerAdded(player: Player)
	local actor: Actor = {
		id = player.UserId,
		name = player.DisplayName,
		player = player,
		isBot = false,
		team = "N",
		role = "Spectate",
		character = nil,
		teleportCount = 0,
		joinedAt = os.clock(),
	}
	actors[actor.id] = actor
	player.Team = teamObjects.N
	player.CharacterAdded:Connect(function(model)
		PlayerService.setupCharacter(actor, model)
	end)
	PlayerService.ActorAdded:Fire(actor)
	if player.Character then
		PlayerService.setupCharacter(actor, player.Character)
	end
end

local function onPlayerRemoving(player: Player)
	local actor = actors[player.UserId]
	if actor then
		PlayerService.ActorRemoving:Fire(actor)
		actors[player.UserId] = nil
	end
end

function PlayerService.registerBot(id: number, name: string, team: string, model: Model): Actor
	local actor: Actor = {
		id = id,
		name = name,
		player = nil,
		isBot = true,
		team = team,
		role = "Match",
		character = model,
		teleportCount = 0,
		joinedAt = os.clock(),
	}
	actors[id] = actor
	PlayerService.setupCharacter(actor, model)
	PlayerService.ActorAdded:Fire(actor)
	return actor
end

function PlayerService.unregisterBot(id: number)
	local actor = actors[id]
	if actor and actor.isBot then
		PlayerService.ActorRemoving:Fire(actor)
		actors[id] = nil
		if actor.character then
			actor.character:Destroy()
		end
	end
end

function PlayerService.get(id: number): Actor?
	return actors[id]
end

function PlayerService.fromPlayer(player: Player): Actor?
	return actors[player.UserId]
end

function PlayerService.all(): { Actor }
	local list = {}
	for _, a in actors do
		table.insert(list, a)
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

function PlayerService.humans(): { Actor }
	local list = {}
	for _, a in PlayerService.all() do
		if not a.isBot then
			table.insert(list, a)
		end
	end
	return list
end

function PlayerService.onTeam(team: string, includeBots: boolean?): { Actor }
	local list = {}
	for _, a in PlayerService.all() do
		if a.team == team and a.role == "Match" and (includeBots ~= false or not a.isBot) then
			table.insert(list, a)
		end
	end
	return list
end

function PlayerService.setTeam(actor: Actor, team: string, role: string?)
	actor.team = team
	if role then
		actor.role = role
	end
	if actor.player then
		actor.player.Team = teamObjects[team] or teamObjects.N
	end
	if actor.character then
		stampCharacter(actor, actor.character)
	end
	PlayerService.TeamChanged:Fire(actor)
end

function PlayerService.root(actor: Actor): BasePart?
	local c = actor.character
	if c and c.Parent then
		return c:FindFirstChild("HumanoidRootPart") :: BasePart?
	end
	return nil
end

function PlayerService.humanoid(actor: Actor): Humanoid?
	local c = actor.character
	if c then
		return c:FindFirstChildOfClass("Humanoid")
	end
	return nil
end

-- Moves an actor and tells their client to drop its momentum.
function PlayerService.teleport(actor: Actor, cf: CFrame)
	local c = actor.character
	if not c or not c.Parent then
		return
	end
	local root = PlayerService.root(actor)
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	c:PivotTo(cf)
	actor.teleportCount += 1
	c:SetAttribute("UBTeleport", actor.teleportCount)
	if services and services.MovementService then
		services.MovementService.noteTeleport(actor.id)
	end
end

function PlayerService.setFrozen(actor: Actor, frozen: boolean)
	local c = actor.character
	if c then
		c:SetAttribute("UBFrozen", frozen)
	end
end

function PlayerService.setAllFrozen(frozen: boolean, filter: ((Actor) -> boolean)?)
	for _, a in PlayerService.all() do
		if filter == nil or filter(a) then
			PlayerService.setFrozen(a, frozen)
		end
	end
end

function PlayerService.Init(s: any)
	services = s
	setupCollisionGroups()
	setupTeams()
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProgressionService — XP, levels, stats, technique mastery, achievements,
	cosmetics and ranked rating. Everything it grants is cosmetic or a record;
	nothing affects movement, throwing or catching.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ProgressionConfig = require(Shared.Config.Progression)
local InputConfig = require(Shared.Config.Input)
local MovementConfig = require(Shared.Config.Movement)
local Rating = require(Shared.Rules.Rating)

local ProgressionService = {}

local services: any
local pushQueued: { [Player]: boolean } = {}

local XP = ProgressionConfig.XP

local function data(player: Player): { [string]: any }?
	return services.DataService.get(player)
end

local function levelOf(d: { [string]: any }): number
	local level = Rating.levelFromXp(d.xp)
	return level
end

local function unlockedList(d: { [string]: any }, list: { any }): { string }
	local level = levelOf(d)
	local out = {}
	for _, item in list do
		if (item.level and level >= item.level) or (item.achievement and d.achievements[item.achievement]) then
			table.insert(out, item.id)
		end
	end
	return out
end

local SLOTS: { [string]: { any } } = {
	disc = ProgressionConfig.DiscSkins,
	trail = ProgressionConfig.Trails,
	celebration = ProgressionConfig.Celebrations,
	banner = ProgressionConfig.Banners,
	title = ProgressionConfig.Titles,
}

local function isUnlocked(d: { [string]: any }, slot: string, id: string): boolean
	local list = (SLOTS :: any)[slot]
	if not list then
		return false
	end
	return table.find(unlockedList(d, list), id) ~= nil
end

function ProgressionService.equipped(player: Player, slot: string): string
	local d = data(player)
	local fallback = (
		{ disc = "Classic", trail = "None", celebration = "Point", banner = "Slate", title = "Rookie" } :: any
	)[slot] or ""
	if not d then
		return fallback
	end
	local id = d.cosmetics[slot]
	if type(id) == "string" and isUnlocked(d, slot, id) then
		return id
	end
	return fallback
end

local function stampCharacter(player: Player)
	local c = player.Character
	local d = data(player)
	if not c or not d then
		return
	end
	local titleId = ProgressionService.equipped(player, "title")
	local title = titleId
	for _, t in ProgressionConfig.Titles do
		if t.id == titleId then
			title = t.name
		end
	end
	c:SetAttribute("UBTitle", title)
	c:SetAttribute("UBBanner", ProgressionService.equipped(player, "banner"))
	c:SetAttribute("UBTrail", ProgressionService.equipped(player, "trail"))
	c:SetAttribute("UBLevel", levelOf(d))
	c:SetAttribute("LeftHanded", d.settings.values.LeftHanded == true)
	c:SetAttribute("UBDivision", ProgressionConfig.division(d.rating).name)
end

local function snapshot(player: Player): { [string]: any }?
	local d = data(player)
	if not d then
		return nil
	end
	local level, into, need = Rating.levelFromXp(d.xp)
	local achievements = {}
	for _, a in ProgressionConfig.Achievements do
		table.insert(achievements, {
			id = a.id,
			name = a.name,
			description = a.description,
			progress = math.min(d.stats[a.stat] or 0, a.goal),
			goal = a.goal,
			done = d.achievements[a.id] == true,
		})
	end
	local unlocked = {}
	for slot, list in SLOTS do
		unlocked[slot] = unlockedList(d, list)
	end
	local division = ProgressionConfig.division(d.rating)
	return {
		level = level,
		xpInto = into,
		xpNeed = need,
		xp = d.xp,
		rating = d.rating,
		peakRating = d.peakRating,
		division = division.name,
		ratedGames = d.ratedGames,
		stats = d.stats,
		techMastery = d.techMastery,
		achievements = achievements,
		unlocked = unlocked,
		equipped = d.cosmetics,
		personalBests = d.personalBests,
		drillsDone = d.drillsDone,
		settings = d.settings,
		persistent = services.DataService.isPersistent(player),
	}
end

ProgressionService.snapshot = snapshot

local function push(player: Player)
	if pushQueued[player] then
		return
	end
	pushQueued[player] = true
	task.delay(0.5, function()
		pushQueued[player] = nil
		if player.Parent then
			local snap = snapshot(player)
			if snap then
				Net.event("Profile"):FireClient(player, snap)
			end
		end
	end)
end

ProgressionService.push = push

local function checkAchievements(player: Player)
	local d = data(player)
	if not d then
		return
	end
	for _, a in ProgressionConfig.Achievements do
		if not d.achievements[a.id] and (d.stats[a.stat] or 0) >= a.goal then
			d.achievements[a.id] = true
			Net.event("Notify"):FireClient(player, "Achievement", a.name, { description = a.description })
			stampCharacter(player)
		end
	end
end

function ProgressionService.xp(player: Player, amount: number, reason: string?)
	local d = data(player)
	if not d or amount <= 0 then
		return
	end
	local before = levelOf(d)
	services.DataService.update(player, function(dd: { [string]: any })
		dd.xp += math.floor(amount)
	end)
	local after = levelOf(d)
	if after > before then
		local unlocks = {}
		for slot, list in SLOTS do
			for _, item in list do
				if item.level and item.level > before and item.level <= after then
					table.insert(unlocks, { slot = slot, name = item.name })
				end
			end
		end
		Net.event("Notify"):FireClient(player, "LevelUp", "LEVEL " .. after, { unlocks = unlocks })
		stampCharacter(player)
	end
	local _ = reason
	push(player)
end

function ProgressionService.stat(actor: any, key: string, n: number)
	local player = actor.player
	if not player then
		return
	end
	services.DataService.update(player, function(d: { [string]: any })
		d.stats[key] = (d.stats[key] or 0) + n
	end)
	local reward = (XP :: any)[({
		goals = "Goal",
		assists = "Assist",
		callahans = "Callahan",
		catches = "Catch",
		completions = "Completion",
		interceptions = "Interception",
		blocks = "Block",
		layouts = "Layout",
		greatests = "Greatest",
		highlights = "Highlight",
	} :: any)[key] or ""]
	if reward then
		ProgressionService.xp(player, reward * n, key)
	end
	checkAchievements(player)
	push(player)
end

function ProgressionService.combo(player: Player, summary: any)
	local amount = math.min(XP.ComboCap, math.floor(summary.score / 100) * XP.ComboPerHundred)
	if amount > 0 then
		ProgressionService.xp(player, amount, "combo")
	end
	services.DataService.update(player, function(d: { [string]: any })
		d.stats.combosConverted = (d.stats.combosConverted or 0) + 1
		if summary.tier == "BREAKPOINT" then
			d.stats.breakpointCombos = (d.stats.breakpointCombos or 0) + 1
		end
	end)
	checkAchievements(player)
end

local function onTech(actorId: number, tech: string, quality: string)
	local actor = services.PlayerService.get(actorId)
	if not actor or not actor.player then
		return
	end
	services.DataService.update(actor.player, function(d: { [string]: any })
		local m = d.techMastery[tech]
		if type(m) ~= "table" then
			m = { count = 0, perfect = 0 }
			d.techMastery[tech] = m
		end
		m.count += 1
		if quality == "Perfect" then
			m.perfect += 1
		end
		if (MovementConfig.ComboPoints :: any)[tech] and (MovementConfig.ComboPoints :: any)[tech] > 0 then
			d.stats.techs = (d.stats.techs or 0) + 1
		end
	end)
end

-- Called once per finished match. Returns rating changes for the summary.
function ProgressionService.matchEnded(
	winner: string?,
	stats: { [number]: any },
	rows: { any },
	ranked: boolean,
	margin: number
): { [string]: any }
	local changes = {}
	local teamRatings: { [string]: { number } } = { A = {}, B = {} }
	if ranked then
		for _, row in rows do
			local p = services.Actors.playerOf(row.id)
			local d = p and data(p)
			if d then
				table.insert(teamRatings[row.team], d.rating)
			end
		end
	end
	local avgA = Rating.teamRating(teamRatings.A)
	local avgB = Rating.teamRating(teamRatings.B)
	for _, row in rows do
		local player = services.Actors.playerOf(row.id)
		if player then
			local won = winner == row.team
			ProgressionService.stat({ player = player }, "matches", 1)
			if won then
				ProgressionService.stat({ player = player }, "wins", 1)
			end
			ProgressionService.xp(player, XP.MatchPlayed + (if won then XP.MatchWon else 0), "match")
			if ranked then
				local d = data(player)
				if d then
					local mine = if row.team == "A" then avgA else avgB
					local theirs = if row.team == "A" then avgB else avgA
					local old = d.rating
					local new = Rating.update(old, d.ratedGames, mine, theirs, won, margin)
					services.DataService.update(player, function(dd: { [string]: any })
						dd.rating = new
						dd.ratedGames += 1
						dd.peakRating = math.max(dd.peakRating, new)
					end)
					changes[tostring(row.id)] = { old = old, new = new }
					services.LeaderboardService.submit(player, new)
				end
			end
			stampCharacter(player)
			services.DataService.saveNow(player)
			push(player)
		end
	end
	local _ = stats
	return changes
end

function ProgressionService.recordPersonalBest(
	player: Player,
	drill: string,
	value: number,
	lowerIsBetter: boolean
): boolean
	local d = data(player)
	if not d then
		return false
	end
	local prev = d.personalBests[drill]
	local better = prev == nil or (if lowerIsBetter then value < prev else value > prev)
	services.DataService.update(player, function(dd: { [string]: any })
		if better then
			dd.personalBests[drill] = value
		end
		if not dd.drillsDone[drill] then
			dd.drillsDone[drill] = true
			local count = 0
			for _ in dd.drillsDone do
				count += 1
			end
			dd.stats.drillsCompleted = count
		end
	end)
	ProgressionService.xp(player, XP.TrainingDrill + (if better and prev ~= nil then XP.PersonalBest else 0), "drill")
	checkAchievements(player)
	push(player)
	return better
end

local function sanitizeSettings(raw: any): any
	if type(raw) ~= "table" then
		return nil
	end
	local out = { values = {}, keyboard = {}, gamepad = {} }
	if type(raw.values) == "table" then
		for k, default in InputConfig.DefaultSettings do
			local v = raw.values[k]
			if type(v) == type(default) then
				if type(v) == "number" then
					v = math.clamp(v, 0, 200)
				end
				out.values[k] = v
			else
				out.values[k] = default
			end
		end
	end
	for _, scheme in { "keyboard", "gamepad" } do
		local src = raw[scheme]
		if type(src) == "table" then
			for _, action in InputConfig.Actions do
				local keys = src[action]
				if type(keys) == "table" then
					local clean = {}
					for i, k in keys do
						if i <= 3 and type(k) == "string" and #k <= 32 then
							table.insert(clean, k)
						end
					end
					out[scheme][action] = clean
				end
			end
		end
	end
	return out
end

function ProgressionService.action(player: Player, kind: string, payload: any)
	if
		kind == "Equip"
		and type(payload) == "table"
		and type(payload.slot) == "string"
		and type(payload.id) == "string"
	then
		local d = data(player)
		if d and isUnlocked(d, payload.slot, payload.id) then
			services.DataService.update(player, function(dd: { [string]: any })
				dd.cosmetics[payload.slot] = payload.id
			end)
			stampCharacter(player)
			push(player)
		end
	elseif kind == "SaveSettings" then
		local clean = sanitizeSettings(payload)
		if clean then
			services.DataService.update(player, function(dd: { [string]: any })
				dd.settings = clean
			end)
			stampCharacter(player)
		end
	end
end

function ProgressionService.Init(s: any)
	services = s
end

function ProgressionService.Start()
	services.DataService.Loaded:Connect(function(player)
		stampCharacter(player)
		push(player)
	end)
	services.PlayerService.CharacterSpawned:Connect(function(actor)
		if actor.player then
			task.defer(stampCharacter, actor.player)
		end
	end)
	services.MovementService.TechAccepted:Connect(onTech)
	Net.func("GetProfile").OnServerInvoke = function(player)
		return snapshot(player)
	end
	Players.PlayerRemoving:Connect(function(p)
		pushQueued[p] = nil
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">TeamService</string>
            <string name="Source"><![CDATA[--!strict
-- TeamService — fair team assignment, late joiners, bot fill.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rating = require(Shared.Rules.Rating)
local ProgressionConfig = require(Shared.Config.Progression)

local TeamService = {}

local services: any
local currentMode: any = nil

local function humansAvailable(): { any }
	local list = {}
	for _, a in services.PlayerService.humans() do
		if a.role ~= "Training" then
			table.insert(list, a)
		end
	end
	return list
end

function TeamService.counts(): (number, number)
	return #services.PlayerService.onTeam("A"), #services.PlayerService.onTeam("B")
end

local filling = false
local refill = false

local function fillOnce()
	local mode = currentMode
	if not mode then
		return
	end
	local humans: { [string]: number } = { A = 0, B = 0 }
	local bots: { [string]: { any } } = { A = {}, B = {} }
	for _, team in { "A", "B" } do
		for _, a in services.PlayerService.onTeam(team) do
			if a.isBot then
				table.insert(bots[team], a)
			else
				humans[team] += 1
			end
		end
	end
	-- bots top both teams up to the same size (never beyond TeamSize)
	local target = 0
	if mode.BotsFillTo > 0 then
		target = math.min(mode.TeamSize, math.max(mode.BotsFillTo, humans.A, humans.B))
	end
	for _, team in { "A", "B" } do
		local want = math.max(0, target - humans[team])
		local have = #bots[team]
		if have > want then
			for i = 1, have - want do
				services.BotService.remove(bots[team][i].id)
			end
		elseif have < want then
			for _ = 1, want - have do
				services.BotService.spawn(team)
			end
		end
	end
end

-- Bot spawning yields, so fills are serialised: a request that arrives while
-- one is running simply schedules another pass with fresh counts.
local function fillBots()
	if filling then
		refill = true
		return
	end
	filling = true
	repeat
		refill = false
		local ok, err = pcall(function()
			fillOnce()
		end)
		if not ok then
			warn("[TeamService] " .. tostring(err))
		end
	until not refill
	filling = false
end

-- Splits every non-training human into teams for a new match.
function TeamService.assignForMatch(mode: any)
	currentMode = mode
	local humans = humansAvailable()
	if mode.Ranked then
		local entries = {}
		for _, a in humans do
			local data = a.player and services.DataService.get(a.player)
			table.insert(entries, { id = a.id, rating = if data then data.rating else ProgressionConfig.Rating.Start })
		end
		local teamA, teamB = Rating.balance(entries)
		for _, id in teamA do
			services.PlayerService.setTeam(services.PlayerService.get(id), "A", "Match")
		end
		for _, id in teamB do
			services.PlayerService.setTeam(services.PlayerService.get(id), "B", "Match")
		end
	else
		-- shuffle deterministically by a per-match seed, then alternate
		local seed = os.time() % 1000
		table.sort(humans, function(x, y)
			return ((x.id * 7919 + seed) % 1009) < ((y.id * 7919 + seed) % 1009)
		end)
		for i, a in humans do
			services.PlayerService.setTeam(a, if i % 2 == 1 then "A" else "B", "Match")
		end
	end
	fillBots()
end

-- A player arriving (or leaving training) during a match.
function TeamService.placeLateJoiner(actor: any)
	if not currentMode then
		services.PlayerService.setTeam(actor, "N", "Spectate")
		return
	end
	local a, b = TeamService.counts()
	local team = if a <= b then "A" else "B"
	-- replace a bot if that team has one
	for _, m in services.PlayerService.onTeam(team) do
		if m.isBot then
			services.BotService.remove(m.id)
			break
		end
	end
	services.PlayerService.setTeam(actor, team, "Match")
	fillBots()
end

function TeamService.rebalance()
	fillBots()
end

function TeamService.setTraining(actor: any, training: boolean)
	if training then
		services.PlayerService.setTeam(actor, "N", "Training")
		fillBots()
	elseif currentMode then
		TeamService.placeLateJoiner(actor)
	else
		services.PlayerService.setTeam(actor, "N", "Spectate")
	end
end

function TeamService.clearMatch()
	currentMode = nil
	for _, a in services.PlayerService.all() do
		if a.isBot then
			services.BotService.remove(a.id)
		elseif a.role ~= "Training" then
			services.PlayerService.setTeam(a, "N", "Spectate")
		end
	end
end

function TeamService.Init(s: any)
	services = s
end

function TeamService.Start() end

return TeamService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ThrowService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ThrowService — validates throws and launches discs.

	The client sends only its INPUTS (type, aim, hold time, bank, release
	height). The server recomputes the launch from its own view of the
	thrower's position and velocity with the same ThrowModel, so a modified
	client cannot fire a disc from somewhere else or faster than allowed.

	Hold time: the server measures the charge itself (ThrowCharge -> Throw)
	and only accepts the client's figure when the two agree within 0.2 s.
	Windups and fakes are replicated as character attributes so defenders see
	the same motion for a real throw and for a fake.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local ThrowModel = require(Shared.Disc.ThrowModel)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local Net = require(Shared.Net)

local T = DiscConfig.Throw
local C = DiscConfig.Catch

local ThrowService = {}

local services: any
local chargeStart: { [number]: number } = {}
local lastFake: { [number]: number } = {}
local lastThrow: { [number]: number } = {}

local function now(): number
	return Net.now()
end

local function setAttr(actorId: number, key: string, value: any)
	local actor = services.PlayerService.get(actorId)
	if actor and actor.character then
		actor.character:SetAttribute(key, value)
	end
end

function ThrowService.beginCharge(actorId: number, throwType: string)
	if not services.DiscService.heldBy(actorId) then
		return
	end
	chargeStart[actorId] = os.clock()
	setAttr(actorId, "WindupType", throwType)
	setAttr(actorId, "Windup", now())
end

function ThrowService.fake(actorId: number, throwType: string)
	local clock = os.clock()
	if (lastFake[actorId] or 0) > clock - T.FakeCooldown then
		return
	end
	if not services.DiscService.heldBy(actorId) then
		return
	end
	lastFake[actorId] = clock
	chargeStart[actorId] = nil
	setAttr(actorId, "WindupType", throwType)
	setAttr(actorId, "Fake", now())
end

export type Result = {
	launch: ThrowModel.Launch,
	blocked: number?,
}

-- Core throw path shared by humans, bots and pulls.
function ThrowService.throw(actorId: number, raw: any, isBot: boolean?): Result?
	local params = ThrowModel.sanitize(raw)
	if not params then
		return nil
	end
	local p = params :: ThrowModel.Params
	local clock = os.clock()
	if (lastThrow[actorId] or 0) > clock - 0.25 then
		return nil
	end
	local d = services.DiscService.heldBy(actorId)
	if not d then
		return nil
	end
	if not d.handler.canThrow(d, actorId) then
		return nil
	end
	local actor = services.PlayerService.get(actorId)
	local root = actor and services.PlayerService.root(actor)
	if not actor or not root then
		return nil
	end

	-- hold time: trust the server's measurement unless the two agree
	if not isBot then
		local started = chargeStart[actorId]
		local measured = if started then clock - started else 0
		if math.abs(measured - p.holdTime) > 0.2 then
			p.holdTime = measured
		end
	end
	chargeStart[actorId] = nil

	-- balance and release height must match what the server can see
	local track = services.MovementService.track(actorId)
	local grounded = if track then track.grounded else true
	if grounded and p.height == "High" then
		p.height = "Mid"
	end
	p.offBalance = not grounded and p.height ~= "High"
	p.groundThrow = services.MovementService.isOnGroundAfterLayout(actorId)
	if p.groundThrow then
		p.height = "Mid"
	end
	p.leftHanded = actor.character ~= nil and actor.character:GetAttribute("LeftHanded") == true

	local vel = root.AssemblyLinearVelocity
	local launch = ThrowModel.launch(p, root.Position, vel)
	lastThrow[actorId] = clock

	-- hand blocks (match play only)
	local blocker: number? = nil
	local blockT: number? = nil
	local blockPos: Vector3? = nil
	if d.context == "Match" and not d.pull then
		blocker, blockT, blockPos =
			services.DefenseService.checkHandBlock(launch.state, actorId, actor.team, d.groundY, d.wind)
	end

	local pull = d.meta.pullPending == true
	services.DiscService.launch(d, launch.releasePos, launch.velocity, launch.normal, launch.state.spin, {
		thrower = actorId,
		throwerTeam = actor.team,
		throwType = p.throwType,
		quality = launch.quality,
		pull = pull,
		noCatch = if blockT then (blockT :: number) + 0.02 else T.NoCatchTime,
	})
	setAttr(actorId, "ReleaseType", p.throwType)
	setAttr(actorId, "Release", now())

	d.handler.onThrown(d, {
		id = actorId,
		team = actor.team,
		params = p,
		launch = launch,
		pos = root.Position,
		blocked = blocker,
	})

	if actor.player then
		Net.event("Feedback"):FireClient(actor.player, "Release", {
			quality = launch.quality,
			power = launch.power,
			spin = launch.spinFactor,
			speed = launch.speed,
			pitch = launch.pitchDeg,
			bank = launch.bankDeg,
			throwType = p.throwType,
			offBalance = p.offBalance,
			groundThrow = p.groundThrow,
			blocked = blocker ~= nil,
		})
	end

	if blocker and blockT and blockPos then
		local flightId = d.flightId
		local bt = blockT :: number
		local bp = blockPos :: Vector3
		local blockerId = blocker :: number
		task.delay(bt, function()
			if d.mode ~= "Flight" or d.flightId ~= flightId then
				return
			end
			local discVel = services.DiscService.velocity(d)
			local away = Vector3.new(bp.X - root.Position.X, 0, bp.Z - root.Position.Z)
			local push = if away.Magnitude > 0.1 then away.Unit * 3 else Vector3.zero
			local newVel = discVel * C.BlockCarry + Vector3.new(0, C.BlockDown, 0) + push
			services.DiscService.deflect(d, bp, newVel)
			Net.event("Effect"):FireAllClients("HandBlock", bp, blockerId, "Clean", "Mark")
			local blockerActor = services.PlayerService.get(blockerId)
			d.handler.onTouched(d, {
				id = blockerId,
				team = if blockerActor then blockerActor.team else "",
				kind = "HandBlock",
				pos = bp,
				zone = "Mark",
			})
		end)
	end
	local _ = DiscPhysics
	return { launch = launch, blocked = blocker }
end

-- Launches a disc without a thrower (training launchers, scripted drills).
function ThrowService.launchFrom(d: any, params: ThrowModel.Params, origin: Vector3, meta: { [string]: any }?)
	local launch = ThrowModel.launch(params, origin, Vector3.zero)
	local m: { [string]: any } = meta or {}
	services.DiscService.launch(d, launch.releasePos, launch.velocity, launch.normal, launch.state.spin, {
		thrower = m.thrower,
		throwerTeam = m.throwerTeam,
		throwType = params.throwType,
		quality = launch.quality,
		noCatch = m.noCatch or 0.05,
	})
	return launch
end

function ThrowService.Init(s: any)
	services = s
end

function ThrowService.Start()
	Net.event("ThrowCharge").OnServerEvent:Connect(function(player, throwType)
		local actor = services.PlayerService.fromPlayer(player)
		if actor and type(throwType) == "string" and (DiscConfig.Types :: any)[throwType] then
			ThrowService.beginCharge(actor.id, throwType)
		end
	end)
	Net.event("Fake").OnServerEvent:Connect(function(player, throwType)
		local actor = services.PlayerService.fromPlayer(player)
		if actor and type(throwType) == "string" and (DiscConfig.Types :: any)[throwType] then
			ThrowService.fake(actor.id, throwType)
		end
	end)
	Net.event("Throw").OnServerEvent:Connect(function(player, raw)
		local actor = services.PlayerService.fromPlayer(player)
		if actor then
			ThrowService.throw(actor.id, raw, false)
		end
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		chargeStart[actor.id] = nil
		lastFake[actor.id] = nil
		lastThrow[actor.id] = nil
	end)
end

return ThrowService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">TrainingService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TrainingService — drills with actionable feedback.

	Every drill reports WHY something worked or failed in plain terms:
	gate splits and where speed was lost, reversal times with the technique
	that would shorten them, how far a missed catch was and in which
	direction, a throw's release quality, spin, bank and miss vector, and the
	defender's distance from the passing lane at release.

	Drills: Tutorial (Movement School), Cutting, Shuttle, Aerial, Range,
	Interception, Combo (lab challenges), Launcher (free, custom launches).
	Each session owns its own training disc; drills never touch the match.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ArenasConfig = require(Shared.Config.Arenas)
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local ThrowModel = require(Shared.Disc.ThrowModel)
local Solver = require(Shared.Disc.Solver)
local VecMath = require(Shared.Util.VecMath)
local TrainingBuilder = require(script.Parent.Parent.Arena.TrainingBuilder)

local TrainingService = {}

local services: any
local layout: TrainingBuilder.Layout

export type Session = {
	actor: any,
	player: Player?,
	drill: string,
	phase: string,
	t0: number,
	data: { [string]: any },
	disc: any?,
	bots: { number },
	ended: boolean,
}

local sessions: { [number]: Session } = {}
local stopDrill: (actor: any) -> ()

local function now(): number
	return Net.now()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function send(s: Session, kind: string, payload: any)
	if s.player then
		Net.event("Feedback"):FireClient(s.player, kind, payload)
	end
end

local function hud(s: Session, title: string, text: string, extra: { [string]: any }?)
	local payload: { [string]: any } = { drill = s.drill, title = title, text = text }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	send(s, "DrillHud", payload)
end

local function report(s: Session, title: string, lines: { string }, extra: { [string]: any }?)
	local payload: { [string]: any } = { drill = s.drill, title = title, lines = lines }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	send(s, "Drill", payload)
end

local function root(s: Session): BasePart?
	return services.PlayerService.root(s.actor)
end

local function teleport(s: Session, pos: Vector3, facing: Vector3?)
	local f = facing or Vector3.new(0, 0, 1)
	services.PlayerService.teleport(s.actor, CFrame.lookAt(pos, pos + f))
end

---------------------------------------------------------------------------
-- session disc
---------------------------------------------------------------------------

local DRILLS: { [string]: any } = {}

local function discFor(s: Session): any
	if s.disc then
		return s.disc
	end
	local handler = {} :: any
	function handler.canClaim(_d: any, id: number, _team: string): boolean
		return id == s.actor.id or table.find(s.bots, id) ~= nil
	end
	function handler.canThrow(_d: any, id: number): boolean
		return id == s.actor.id or table.find(s.bots, id) ~= nil
	end
	function handler.onCaught(d: any, info: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onCaught then
			drill.onCaught(s, d, info)
		end
	end
	function handler.onTouched(d: any, info: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onTouched then
			drill.onTouched(s, d, info)
		end
	end
	function handler.onThrown(d: any, info: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onThrown then
			drill.onThrown(s, d, info)
		end
	end
	function handler.onGrounded(d: any, land: Vector3, samples: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onGrounded then
			drill.onGrounded(s, d, land, samples)
		else
			services.DiscService.placeOnGround(d, land)
		end
	end
	local d = services.DiscService.create("Training", s.actor.id, handler)
	if s.player then
		services.DiscService.setSkin(d, services.ProgressionService.equipped(s.player, "disc"))
	end
	s.disc = d
	return d
end

local function launchAt(
	s: Session,
	origin: Vector3,
	target: Vector3,
	throwType: string,
	bank: number?,
	floaty: boolean?
): any
	local d = discFor(s)
	local sol = Solver.solve({
		rootPos = origin,
		throwType = throwType,
		bank = bank or 0,
		target = target,
		groundY = layout.origin.Y,
		flightTimeWeight = if floaty then 0.05 else 0.6,
		coarse = true,
	})
	if not sol then
		return nil
	end
	services.ThrowService.launchFrom(d, sol.params, origin, { noCatch = 0.1 })
	return sol
end

local function finish(
	s: Session,
	title: string,
	lines: { string },
	pbKey: string?,
	value: number?,
	lowerIsBetter: boolean?
)
	if s.ended then
		return
	end
	s.ended = true
	local isPB = false
	if pbKey and value and s.player then
		local prev = nil
		local data = services.DataService.get(s.player)
		if data then
			prev = data.personalBests[pbKey]
		end
		isPB = services.ProgressionService.recordPersonalBest(s.player, pbKey, value, lowerIsBetter == true)
		if prev ~= nil then
			table.insert(
				lines,
				if isPB then "NEW PERSONAL BEST!" else string.format("Personal best: %s", tostring(prev))
			)
		else
			table.insert(lines, "First completion recorded.")
		end
	end
	report(s, title, lines, { done = true, pb = isPB })
	stopDrill(s.actor)
end

---------------------------------------------------------------------------
-- Movement School
---------------------------------------------------------------------------

local TUTORIAL: { any } = {
	{ text = "Hold SHIFT and run (WASD) to sprint.", kind = "speed" },
	{ text = "SNAP CUT: while sprinting press Q and steer 45-90 degrees to the side.", tech = "SnapCut" },
	{ text = "MOMENTUM CANCEL: sprint, then press Q while steering BACKWARD to plant.", tech = "MomentumCancel" },
	{
		text = "RESTART: plant again, then press Q with a direction 0.1-0.3 s later.",
		tech = "SnapCut",
		info = "Restart",
	},
	{ text = "BURST STEP: press F to explode into space (it has a cooldown).", tech = "BurstStep" },
	{
		text = "FAKE COMMIT: press Q while running straight (jab), then Q again to cut away.",
		tech = "SnapCut",
		info = "Sold",
	},
	{ text = "SLIDE: sprint and press CTRL (or C).", tech = "Slide" },
	{ text = "SLIDE CUT: during a slide, press Q with a new direction.", tech = "SlideCut" },
	{ text = "AIR REDIRECT: jump (SPACE), then press Q with a direction in the air.", tech = "AirRedirect" },
	{ text = "PRECISION LANDING: press CTRL just before you touch down.", tech = "PrecisionLanding" },
	{ text = "LAYOUT: press E to dive.", tech = "Dive" },
	{ text = "RECOVERY CHAIN: as your dive slide stops, press Q, F or SPACE.", tech = "RecoveryChain" },
	{ text = "CATCH: run to the disc. Click (Reach) for ones outside your body.", kind = "catch" },
	{ text = "THROW: hold LEFT MOUSE and release at the peak of the meter (PERFECT).", kind = "throw" },
}

local function tutorialShow(s: Session)
	local step = TUTORIAL[s.data.step]
	hud(
		s,
		string.format("MOVEMENT SCHOOL  %d/%d", s.data.step, #TUTORIAL),
		step.text,
		{ progress = (s.data.step - 1) / #TUTORIAL }
	)
	if step.kind == "catch" then
		local r = root(s)
		if r then
			local origin = r.Position + VecMath.flatUnit(r.CFrame.LookVector) * 40 + Vector3.new(0, 0, 0)
			task.delay(1.0, function()
				if sessions[s.actor.id] == s and TUTORIAL[s.data.step].kind == "catch" then
					launchAt(s, origin, r.Position + Vector3.new(0, 1.5, 0), "Backhand", 0, true)
				end
			end)
		end
	elseif step.kind == "throw" then
		services.DiscService.giveTo(discFor(s), s.actor.id)
	end
end

local function tutorialAdvance(s: Session)
	s.data.step += 1
	send(s, "DrillTick", { text = "Nice!" })
	if s.data.step > #TUTORIAL then
		finish(s, "MOVEMENT SCHOOL COMPLETE", {
			"You know the whole vocabulary.",
			"Next: Combo Lab to chain them, Cutting Course to use them at speed.",
		}, "Tutorial", 1, false)
		return
	end
	tutorialShow(s)
end

DRILLS.Tutorial = {
	start = function(s: Session)
		s.data.step = 1
		tutorialShow(s)
	end,
	step = function(s: Session)
		local step = TUTORIAL[s.data.step]
		if step and step.kind == "speed" then
			local t = services.MovementService.track(s.actor.id)
			if t and flat(t.vel).Magnitude >= MovementConfig.SprintSpeed - 4 then
				tutorialAdvance(s)
			end
		end
	end,
	onTech = function(s: Session, tech: string, _quality: string, info: string?)
		local step = TUTORIAL[s.data.step]
		if step and step.tech == tech and (step.info == nil or step.info == info) then
			tutorialAdvance(s)
		end
	end,
	onCaught = function(s: Session, _d: any, _info: any)
		local step = TUTORIAL[s.data.step]
		if step and step.kind == "catch" then
			tutorialAdvance(s)
		end
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		local step = TUTORIAL[s.data.step]
		if step and step.kind == "catch" then
			send(s, "DrillTick", { text = "Missed — here comes another." })
			tutorialShow(s)
		elseif step and step.kind == "throw" then
			task.delay(0.8, function()
				if sessions[s.actor.id] == s then
					services.DiscService.giveTo(d, s.actor.id)
				end
			end)
		end
	end,
	onThrown = function(s: Session, d: any, info: any)
		local step = TUTORIAL[s.data.step]
		if step and step.kind == "throw" then
			if info.launch.quality == "Perfect" then
				tutorialAdvance(s)
			else
				send(s, "DrillTick", {
					text = if info.launch.quality == "Over"
						then "Held too long (spin lost). Release right as the meter peaks."
						else "Released early. Hold until the meter fills, then let go.",
				})
			end
		end
		local _ = d
	end,
}

---------------------------------------------------------------------------
-- Cutting course
---------------------------------------------------------------------------

DRILLS.Cutting = {
	start = function(s: Session)
		local st = layout.stations.Cutting
		teleport(s, st.start + Vector3.new(0, 3, 0), st.facing)
		s.data.gate = 1
		s.data.splits = {}
		s.data.minSpeed = {}
		s.data.penalty = 0
		s.data.techs = 0
		s.data.lastZ = nil
		hud(s, "CUTTING COURSE", "Cross the green gate to start. Weave through every gate.", { progress = 0 })
	end,
	step = function(s: Session)
		local r = root(s)
		if not r then
			return
		end
		local pos = r.Position
		local gates = layout.gates
		local g = gates[s.data.gate]
		if not g then
			return
		end
		local lastZ = s.data.lastZ or pos.Z
		s.data.lastZ = pos.Z
		if s.data.startAt then
			local sp = flat(r.AssemblyLinearVelocity).Magnitude
			local i = s.data.gate
			s.data.minSpeed[i] = math.min(s.data.minSpeed[i] or math.huge, sp)
			if now() - s.data.startAt > 60 then
				finish(s, "CUTTING COURSE", { "Timed out after 60 s." })
				return
			end
		end
		if lastZ < g.a.Z and pos.Z >= g.a.Z then
			local inside = pos.X >= g.a.X - 0.8 and pos.X <= g.b.X + 0.8
			if not inside then
				s.data.penalty += 2
				send(s, "DrillTick", { text = "Missed gate " .. s.data.gate .. " (+2 s)" })
			end
			if s.data.gate == 1 then
				s.data.startAt = now()
			else
				table.insert(
					s.data.splits,
					{ gate = s.data.gate, t = now() - s.data.startAt, speed = flat(r.AssemblyLinearVelocity).Magnitude }
				)
			end
			s.data.gate += 1
			hud(s, "CUTTING COURSE", string.format("Gate %d / %d", math.min(s.data.gate, #gates), #gates), {
				timerStart = s.data.startAt,
				progress = (s.data.gate - 1) / #gates,
			})
			if s.data.gate > #gates then
				local total = now() - s.data.startAt + s.data.penalty
				local lines = { string.format("Time: %.2f s (penalties %d s)", total, s.data.penalty) }
				local worst, worstGate = math.huge, 0
				for i = 2, #gates do
					local m = s.data.minSpeed[i]
					if m and m < worst then
						worst, worstGate = m, i
					end
				end
				if worstGate > 0 then
					table.insert(
						lines,
						string.format("Slowest section: before gate %d (dropped to %.0f studs/s).", worstGate, worst)
					)
					if worst < 12 then
						table.insert(
							lines,
							"Tip: cut earlier and cleaner — a committed line before a Snap Cut keeps up to 96% of your speed."
						)
					elseif worst < 18 then
						table.insert(
							lines,
							"Tip: chain Snap Cut -> Burst Step within 0.15 s for a Perfect burst out of the turn."
						)
					else
						table.insert(lines, "You held speed all the way. Try Slide Cuts on the tight gates.")
					end
				end
				table.insert(lines, string.format("Techniques used: %d", s.data.techs))
				finish(s, "CUTTING COURSE", lines, "Cutting", math.floor(total * 100) / 100, true)
			end
		end
	end,
	onTech = function(s: Session)
		if s.data.startAt then
			s.data.techs += 1
		end
	end,
}

---------------------------------------------------------------------------
-- Momentum shuttle
---------------------------------------------------------------------------

DRILLS.Shuttle = {
	start = function(s: Session)
		local st = layout.stations.Shuttle
		teleport(s, st.start + Vector3.new(0, 3, 0), st.facing)
		s.data.leg = 0
		s.data.reversals = {}
		s.data.lastZ = nil
		s.data.crossedAt = nil
		hud(s, "MOMENTUM SHUTTLE", "Run north across the green line to start: A -> B -> A -> B -> A", { progress = 0 })
	end,
	step = function(s: Session)
		local r = root(s)
		if not r then
			return
		end
		local z = r.Position.Z
		local lastZ = s.data.lastZ or z
		s.data.lastZ = z
		local A, B = layout.shuttleA, layout.shuttleB
		local leg = s.data.leg
		local function crossed(line: number, north: boolean): boolean
			if north then
				return lastZ < line and z >= line
			end
			return lastZ > line and z <= line
		end
		if leg == 0 and crossed(A, true) then
			s.data.startAt = now()
			s.data.leg = 1
		elseif leg == 1 and crossed(B, true) then
			s.data.turnAt = now()
			s.data.leg = 2
		elseif leg == 2 and crossed(B, false) then
			table.insert(s.data.reversals, { line = "B", t = now() - s.data.turnAt })
			s.data.leg = 3
		elseif leg == 3 and crossed(A, false) then
			s.data.turnAt = now()
			s.data.leg = 4
		elseif leg == 4 and crossed(A, true) then
			table.insert(s.data.reversals, { line = "A", t = now() - s.data.turnAt })
			s.data.leg = 5
		elseif leg == 5 and crossed(B, true) then
			s.data.turnAt = now()
			s.data.leg = 6
		elseif leg == 6 and crossed(B, false) then
			table.insert(s.data.reversals, { line = "B", t = now() - s.data.turnAt })
			s.data.leg = 7
		elseif leg == 7 and crossed(A, false) then
			local total = now() - s.data.startAt
			local lines = { string.format("Time: %.2f s", total) }
			local best = math.huge
			for i, rv in s.data.reversals do
				best = math.min(best, rv.t)
				local verdict = if rv.t < 0.3
					then "elite"
					elseif rv.t < 0.5 then "good"
					else "slow — plant with Momentum Cancel (Q backward) and restart 0.1-0.3 s later"
				table.insert(lines, string.format("Reversal %d at %s: %.2f s (%s)", i, rv.line, rv.t, verdict))
			end
			finish(s, "MOMENTUM SHUTTLE", lines, "Shuttle", math.floor(total * 100) / 100, true)
			return
		end
		if s.data.startAt then
			hud(s, "MOMENTUM SHUTTLE", string.format("Leg %d / 4", math.clamp(math.ceil(s.data.leg / 2), 1, 4)), {
				timerStart = s.data.startAt,
				progress = s.data.leg / 7,
			})
			if now() - s.data.startAt > 40 then
				finish(s, "MOMENTUM SHUTTLE", { "Timed out." })
			end
		end
	end,
}

---------------------------------------------------------------------------
-- Aerial catch
---------------------------------------------------------------------------

local AERIAL: { any } = {
	{ x = 0, z = 0, h = 4.5, type = "Backhand", label = "Chest-high floater", floaty = true },
	{ x = -10, z = 4, h = 8.5, type = "Backhand", label = "High floater: jump", floaty = true },
	{ x = 10, z = -4, h = 1.6, type = "Forehand", label = "Low skimmer: slide or dive" },
	{ x = 16, z = 2, h = 2.6, type = "Backhand", label = "Wide: lay out" },
	{ x = -6, z = -22, h = 4, type = "Hammer", label = "Hammer over the top: get back" },
	{ x = -14, z = 6, h = 3.5, type = "Forehand", bank = 0.8, label = "Curving away" },
	{ x = 12, z = 10, h = 2.2, type = "Blade", label = "Fast blade: read it early" },
	{ x = -12, z = -2, h = 8.0, type = "Backhand", bank = -0.6, label = "Jump + Air Redirect", floaty = true },
	{ x = 4, z = -34, h = 4, type = "Backhand", label = "Deep floater: sprint", floaty = true },
	{ x = -18, z = -8, h = 2.2, type = "Forehand", label = "Full layout" },
}

local function aerialNext(s: Session)
	s.data.index += 1
	local p = AERIAL[s.data.index]
	if not p then
		local lines = { string.format("Score: %d (%d / %d caught)", s.data.score, s.data.caught, #AERIAL) }
		for _, line in s.data.notes do
			table.insert(lines, line)
		end
		finish(s, "AERIAL CATCH", lines, "Aerial", s.data.score, false)
		return
	end
	s.data.closest = math.huge
	s.data.closestRel = Vector3.zero
	s.data.closestAt = 0
	s.data.inFlight = false
	hud(
		s,
		string.format("AERIAL CATCH  %d/%d", s.data.index, #AERIAL),
		p.label,
		{ progress = (s.data.index - 1) / #AERIAL }
	)
	task.delay(1.4, function()
		if sessions[s.actor.id] ~= s then
			return
		end
		local mark = layout.catchMark
		local target = mark + Vector3.new(p.x, p.h, p.z)
		launchAt(s, layout.launcher, target, p.type, p.bank, p.floaty)
		s.data.inFlight = true
	end)
end

local function aerialResult(s: Session, caught: boolean, info: any?)
	if not s.data.inFlight then
		return
	end
	s.data.inFlight = false
	local p = AERIAL[s.data.index]
	if caught then
		local pts = 100
		if info and info.quality == "Clean" then
			pts += 50
		end
		if info and info.zone == "Dive" then
			pts += 100
		end
		s.data.score += pts
		s.data.caught += 1
		send(s, "DrillTick", { text = string.format("Caught! +%d", pts) })
	else
		local rel: Vector3 = s.data.closestRel
		local lines = { string.format("%s — missed by %.1f studs.", p.label, s.data.closest) }
		if rel.Y > 2 then
			table.insert(lines, "It was above you: jump (SPACE) and Reach (CLICK).")
		elseif rel.Y < -1.5 then
			table.insert(lines, "It was low: slide (CTRL) or dive (E) to get under it.")
		end
		if flat(rel).Magnitude > 3 then
			table.insert(lines, "Too far away: move on the launch, or lay out (E) toward it.")
		end
		local reach = services.CatchingService.reachState(s.actor.id)
		if reach and math.abs(reach.at - s.data.closestAt) < 1.5 then
			local diff = reach.at - s.data.closestAt
			if diff < -0.3 then
				table.insert(lines, string.format("You reached %.2f s too early.", -diff))
			elseif diff > 0.05 then
				table.insert(lines, string.format("You reached %.2f s late.", diff))
			end
		end
		send(s, "DrillTick", { text = table.concat(lines, "  ") })
		table.insert(s.data.notes, lines[1])
	end
	task.delay(1.0, function()
		if sessions[s.actor.id] == s then
			if s.disc and s.disc.mode == "Held" then
				services.DiscService.hide(s.disc)
			end
			teleport(s, layout.catchMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
			aerialNext(s)
		end
	end)
end

DRILLS.Aerial = {
	start = function(s: Session)
		teleport(s, layout.catchMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
		s.data.index = 0
		s.data.score = 0
		s.data.caught = 0
		s.data.notes = {}
		aerialNext(s)
	end,
	step = function(s: Session)
		local d = s.disc
		if not d or not s.data.inFlight or d.mode ~= "Flight" then
			return
		end
		local r = root(s)
		local p = services.DiscService.currentPosition(d)
		if r and p then
			local chest = r.Position + Vector3.new(0, DiscConfig.Catch.ChestHeight, 0)
			local dist = (p - chest).Magnitude
			if dist < s.data.closest then
				s.data.closest = dist
				s.data.closestRel = p - chest
				s.data.closestAt = now()
			end
		end
	end,
	onCaught = function(s: Session, _d: any, info: any)
		aerialResult(s, true, info)
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		aerialResult(s, false, nil)
	end,
}

---------------------------------------------------------------------------
-- Free launcher
---------------------------------------------------------------------------

DRILLS.Launcher = {
	start = function(s: Session)
		teleport(s, layout.catchMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
		send(s, "OpenLauncher", {})
		hud(s, "FREE LAUNCHER", "Set type, power, angle and curve in the panel, then Launch.", {})
	end,
	launch = function(s: Session, payload: any)
		local r = root(s)
		if not r or type(payload) ~= "table" then
			return
		end
		local params = ThrowModel.sanitize({
			throwType = payload.throwType,
			yaw = 0,
			pitch = math.rad(if type(payload.pitch) == "number" then payload.pitch else 8),
			holdTime = (if type(payload.power) == "number" then math.clamp(payload.power, 0.05, 1) else 0.5)
				* DiscConfig.Throw.ChargeTime,
			bank = payload.bank,
			height = "Mid",
		})
		if not params then
			return
		end
		local p = params :: ThrowModel.Params
		local d = flat(r.Position - layout.launcher)
		p.yaw = math.atan2(-d.X, -d.Z)
			+ math.rad(if type(payload.offset) == "number" then math.clamp(payload.offset, -30, 30) else 0)
		services.ThrowService.launchFrom(discFor(s), p, layout.launcher, { noCatch = 0.1 })
	end,
	onCaught = function(s: Session, _d: any, info: any)
		send(s, "DrillTick", { text = string.format("Caught (%s, %s zone)", info.quality, info.zone) })
		task.delay(0.6, function()
			if s.disc and s.disc.mode == "Held" then
				services.DiscService.hide(s.disc)
			end
		end)
	end,
}

---------------------------------------------------------------------------
-- Throwing range
---------------------------------------------------------------------------

local RANGE_THROWS = 10

local function moverPos(t: number): Vector3
	local m = layout.mover
	return TrainingBuilder.moverPosition(m.center, m.amplitude, m.period, t)
end

local function rangeGive(s: Session)
	if sessions[s.actor.id] ~= s then
		return
	end
	teleport(s, layout.throwMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
	services.DiscService.giveTo(discFor(s), s.actor.id)
	hud(
		s,
		string.format("THROWING RANGE  %d/%d", s.data.throws + 1, RANGE_THROWS),
		"Hit the rings. The yellow one moves.",
		{
			progress = s.data.throws / RANGE_THROWS,
		}
	)
end

local function rangeResult(s: Session)
	if not s.data.inFlight then
		return
	end
	s.data.inFlight = false
	local info = s.data.throwInfo
	local launch = info.launch
	local lines = {}
	local hit = s.data.hit
	if hit then
		s.data.score += hit.points
		table.insert(lines, string.format("HIT %s! +%d", hit.name, hit.points))
	else
		local near = s.data.nearest
		if near then
			local forward = VecMath.flatUnit(near.target - launch.releasePos)
			local right = Vector3.new(-forward.Z, 0, forward.X)
			local miss = near.discPos - near.target
			local lateral = miss:Dot(right)
			local long = miss:Dot(forward)
			table.insert(lines, string.format("Missed %s by %.1f studs.", near.name, near.dist))
			if math.abs(lateral) > 2 then
				table.insert(
					lines,
					string.format(
						"%.0f studs %s: aim %s or bank %s.",
						math.abs(lateral),
						if lateral > 0 then "right" else "left",
						if lateral > 0 then "left" else "right",
						if lateral > 0 then "left (Q)" else "right (E)"
					)
				)
			end
			if miss.Y < -2.5 or long < -3 then
				table.insert(lines, "Short / low: hold longer or raise your aim.")
			elseif miss.Y > 2.5 or long > 3 then
				table.insert(lines, "Long / high: release earlier or lower your aim.")
			end
		end
	end
	table.insert(
		lines,
		string.format(
			"Release: %s  power %d%%  spin %d%%  bank %+d deg",
			launch.quality,
			math.floor(launch.power * 100),
			math.floor(launch.spinFactor * 100),
			math.floor(launch.bankDeg)
		)
	)
	if launch.quality == "Over" then
		table.insert(lines, "Overcharged: low spin makes the disc roll (turn/fade) more. Release at the peak.")
	end
	send(s, "DrillTick", { text = table.concat(lines, "  ") })
	s.data.throws += 1
	if s.data.throws >= RANGE_THROWS then
		task.delay(1.0, function()
			finish(s, "THROWING RANGE", {
				string.format("Score: %d", s.data.score),
				string.format("Rings hit: %d / %d", s.data.hits, RANGE_THROWS),
			}, "Range", s.data.score, false)
		end)
	else
		task.delay(1.2, function()
			rangeGive(s)
		end)
	end
end

DRILLS.Range = {
	start = function(s: Session)
		s.data.throws = 0
		s.data.score = 0
		s.data.hits = 0
		rangeGive(s)
	end,
	onThrown = function(s: Session, _d: any, info: any)
		s.data.inFlight = true
		s.data.throwInfo = info
		s.data.hit = nil
		s.data.nearest = nil
	end,
	step = function(s: Session)
		local d = s.disc
		if not d or not s.data.inFlight or d.mode ~= "Flight" then
			return
		end
		local p = services.DiscService.currentPosition(d)
		if not p then
			return
		end
		local t = now()
		local candidates = {}
		for _, tg in layout.targets do
			table.insert(candidates, { name = tg.name, pos = tg.pos, radius = tg.radius, points = tg.points })
		end
		table.insert(
			candidates,
			{ name = "MOVER", pos = moverPos(t), radius = layout.mover.radius, points = layout.mover.points }
		)
		for _, c in candidates do
			local dist = (p - c.pos).Magnitude
			if dist <= c.radius + 0.6 then
				s.data.hit = c
				s.data.hits += 1
				Net.event("Effect"):FireAllClients("TargetHit", p, s.actor.id, "Clean", c.name)
				services.DiscService.placeOnGround(d, Vector3.new(c.pos.X, layout.origin.Y, c.pos.Z))
				rangeResult(s)
				return
			end
			if s.data.nearest == nil or dist < s.data.nearest.dist then
				s.data.nearest = { name = c.name, dist = dist, target = c.pos, discPos = p }
			end
		end
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		rangeResult(s)
	end,
	onCaught = function(_s: Session) end,
}

---------------------------------------------------------------------------
-- Interception drill
---------------------------------------------------------------------------

local ROUTES = {
	{ Vector3.new(0, 0, 34) },
	{ Vector3.new(-14, 0, 10), Vector3.new(-30, 0, 30) },
	{ Vector3.new(0, 0, 18), Vector3.new(-24, 0, 4) },
	{ Vector3.new(-30, 0, 0) },
	{ Vector3.new(0, 0, 50) },
	{ Vector3.new(-10, 0, 30), Vector3.new(10, 0, 10) },
	{ Vector3.new(-26, 0, 24) },
	{ Vector3.new(6, 0, 40), Vector3.new(-20, 0, 50) },
}

local function interceptionRep(s: Session)
	if sessions[s.actor.id] ~= s then
		return
	end
	s.data.rep += 1
	if s.data.rep > #ROUTES then
		finish(s, "INTERCEPTION DRILL", {
			string.format("Score: %d", s.data.score),
			string.format(
				"Interceptions %d  Blocks %d  Completions allowed %d",
				s.data.ints,
				s.data.blocks,
				s.data.allowed
			),
		}, "Interception", s.data.score, false)
		return
	end
	local L = layout.interception
	local thrower = services.PlayerService.get(s.bots[1])
	local receiver = services.PlayerService.get(s.bots[2])
	if not thrower or not receiver then
		return
	end
	services.PlayerService.teleport(thrower, CFrame.lookAt(L.thrower, L.receiverStart))
	services.PlayerService.teleport(receiver, CFrame.lookAt(L.receiverStart, L.receiverStart + Vector3.new(0, 0, 1)))
	teleport(s, L.playerStart, Vector3.new(1, 0, 0))
	local d = discFor(s)
	services.DiscService.giveTo(d, thrower.id)
	s.data.route = ROUTES[s.data.rep]
	s.data.leg = 0
	s.data.resolved = false
	hud(
		s,
		string.format("INTERCEPTION  %d/%d", s.data.rep, #ROUTES),
		"The receiver cuts, the thrower leads them. Get the D.",
		{
			progress = (s.data.rep - 1) / #ROUTES,
		}
	)
	task.delay(1.2, function()
		if sessions[s.actor.id] == s then
			s.data.leg = 1
			s.data.routeStart = now()
		end
	end)
	task.delay(1.95, function()
		if sessions[s.actor.id] ~= s or d.mode ~= "Held" or d.holder ~= thrower.id then
			return
		end
		local rroot = services.PlayerService.root(receiver)
		local troot = services.PlayerService.root(thrower)
		if not rroot or not troot then
			return
		end
		local sol = Solver.solve({
			rootPos = troot.Position,
			throwType = "Backhand",
			target = rroot.Position + Vector3.new(0, 1, 0),
			targetVel = flat(rroot.AssemblyLinearVelocity),
			groundY = layout.origin.Y,
			coarse = true,
		})
		if sol then
			local pr = root(s)
			if pr then
				local lane = VecMath.closestOnSegment(flat(troot.Position), flat(sol.catchPoint), flat(pr.Position))
				s.data.laneDist = (lane - flat(pr.Position)).Magnitude
			end
			services.ThrowService.throw(thrower.id, sol.params, true)
		end
	end)
end

local function interceptionResolve(s: Session, text: string, pts: number)
	if s.data.resolved then
		return
	end
	s.data.resolved = true
	s.data.score += pts
	local extra = if s.data.laneDist
		then string.format("  (you were %.1f studs from the lane at release)", s.data.laneDist)
		else ""
	send(s, "DrillTick", { text = text .. extra })
	task.delay(1.6, function()
		interceptionRep(s)
	end)
end

DRILLS.Interception = {
	start = function(s: Session)
		s.data.rep = 0
		s.data.score = 0
		s.data.ints = 0
		s.data.blocks = 0
		s.data.allowed = 0
		local function receiverBrain(b: any, _dt: number)
			local route = s.data.route
			if not route or s.data.leg == 0 then
				b.target = nil
				return
			end
			local wp = route[s.data.leg]
			if not wp then
				b.target = nil
				return
			end
			local goal = layout.interception.receiverStart + wp
			b.target = goal
			b.speed = 23
			if flat(goal - b.root.Position).Magnitude < 2.5 then
				s.data.leg += 1
			end
		end
		local function throwerBrain(b: any, _dt: number)
			b.target = nil
		end
		local t = services.BotService.spawn("N", throwerBrain, "Training")
		local r = services.BotService.spawn("N", receiverBrain, "Training")
		s.bots = { t, r }
		task.delay(0.5, function()
			interceptionRep(s)
		end)
	end,
	onCaught = function(s: Session, d: any, info: any)
		if info.id == s.actor.id then
			s.data.ints += 1
			interceptionResolve(s, "INTERCEPTION! +200", 200)
		else
			s.data.allowed += 1
			interceptionResolve(s, "Completed.", 0)
		end
		task.delay(0.5, function()
			if d.mode == "Held" then
				services.DiscService.hide(d)
			end
		end)
	end,
	onTouched = function(s: Session, _d: any, info: any)
		if info.id == s.actor.id and info.kind ~= "Bobble" then
			s.data.blocks += 1
			interceptionResolve(s, "BLOCK! +150", 150)
		end
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		interceptionResolve(s, "Incomplete.", 50)
	end,
}

---------------------------------------------------------------------------
-- Combo lab
---------------------------------------------------------------------------

local CHALLENGES = {
	{
		name = "Sold!",
		hint = "Fake Commit, then Snap Cut away",
		seq = { { tech = "FakeCommit" }, { tech = "SnapCut", info = "Sold" } },
	},
	{
		name = "Plant and Go",
		hint = "Momentum Cancel, then a PERFECT restart",
		seq = { { tech = "MomentumCancel" }, { tech = "SnapCut", info = "Restart", quality = "Perfect" } },
	},
	{
		name = "Cut-Burst",
		hint = "Snap Cut, then Burst within 0.15 s (Perfect)",
		seq = { { tech = "SnapCut" }, { tech = "BurstStep", quality = "Perfect" } },
	},
	{
		name = "Stick the Landing",
		hint = "Jump, Air Redirect, Precision Landing",
		seq = { { tech = "Jump" }, { tech = "AirRedirect" }, { tech = "PrecisionLanding" } },
	},
	{ name = "Slide Cut", hint = "Slide, then cut out of it", seq = { { tech = "Slide" }, { tech = "SlideCut" } } },
	{ name = "Get Up!", hint = "Dive, then Recovery Chain", seq = { { tech = "Dive" }, { tech = "RecoveryChain" } } },
	{
		name = "Off the Wall",
		hint = "Wall Rebound (jump at a pink wall), then Air Redirect",
		seq = { { tech = "WallRebound" }, { tech = "AirRedirect" } },
	},
	{
		name = "Full Send",
		hint = "Snap Cut, Burst Step, Layout",
		seq = { { tech = "SnapCut" }, { tech = "BurstStep" }, { tech = "Dive" } },
	},
}

local function comboStatus(s: Session)
	local lines = {}
	local done = 0
	for i, c in CHALLENGES do
		local ok = s.data.done[i] == true
		if ok then
			done += 1
		end
		table.insert(lines, (if ok then "[x] " else "[ ] ") .. c.name .. " — " .. c.hint)
	end
	hud(
		s,
		string.format("COMBO LAB  %d/%d", done, #CHALLENGES),
		table.concat(lines, "\n"),
		{ progress = done / #CHALLENGES, list = true }
	)
	return done
end

local function matches(recent: { any }, seq: { any }): boolean
	local n = #seq
	if #recent < n then
		return false
	end
	-- the last n techniques must match in order, each within the chain window
	for k = 1, n do
		local e = recent[#recent - n + k]
		local want = seq[k]
		if e.tech ~= want.tech then
			return false
		end
		if want.info and e.info ~= want.info then
			return false
		end
		if want.quality and e.quality ~= want.quality then
			return false
		end
		if k > 1 and e.t - recent[#recent - n + k - 1].t > MovementConfig.ChainWindow + 0.2 then
			return false
		end
	end
	return true
end

DRILLS.Combo = {
	start = function(s: Session)
		local st = layout.stations.Combo
		teleport(s, st.start, st.facing)
		s.data.done = {}
		s.data.recent = {}
		comboStatus(s)
	end,
	onTech = function(s: Session, tech: string, quality: string, info: string?)
		table.insert(s.data.recent, { tech = tech, quality = quality, info = info, t = now() })
		while #s.data.recent > 8 do
			table.remove(s.data.recent, 1)
		end
		for i, c in CHALLENGES do
			if not s.data.done[i] and matches(s.data.recent, c.seq) then
				s.data.done[i] = true
				send(s, "DrillTick", { text = "Challenge complete: " .. c.name })
				if comboStatus(s) >= #CHALLENGES then
					finish(
						s,
						"COMBO LAB COMPLETE",
						{ "Every chain landed. Now do it with a disc in the air." },
						"Combo",
						1,
						false
					)
				end
			end
		end
	end,
}

---------------------------------------------------------------------------
-- session lifecycle
---------------------------------------------------------------------------

function stopDrill(actor: any)
	local s = sessions[actor.id]
	if not s then
		return
	end
	sessions[actor.id] = nil
	s.ended = true
	for _, id in s.bots do
		services.BotService.remove(id)
	end
	if s.disc then
		services.DiscService.destroy(s.disc)
		s.disc = nil
	end
	send(s, "DrillHud", { drill = "", title = "", text = "", clear = true })
end

TrainingService.stopDrill = stopDrill

function TrainingService.startDrill(actor: any, drill: string)
	if not DRILLS[drill] then
		return
	end
	TrainingService.stopDrill(actor)
	local s: Session = {
		actor = actor,
		player = actor.player,
		drill = drill,
		phase = "Running",
		t0 = now(),
		data = {},
		disc = nil,
		bots = {},
		ended = false,
	}
	sessions[actor.id] = s
	DRILLS[drill].start(s)
end

function TrainingService.enter(actor: any)
	if actor.role ~= "Training" then
		services.TeamService.setTraining(actor, true)
	end
	services.PlayerService.setFrozen(actor, false)
	services.PlayerService.teleport(actor, layout.entry)
end

function TrainingService.leave(actor: any)
	TrainingService.stopDrill(actor)
	if actor.role == "Training" then
		services.PlayerService.setTeam(actor, "N", "Spectate")
		services.MatchService.onLeftTraining(actor)
	end
end

function TrainingService.respawned(actor: any)
	TrainingService.stopDrill(actor)
	services.PlayerService.teleport(actor, layout.entry)
end

function TrainingService.action(player: Player, kind: string, payload: any)
	local actor = services.PlayerService.fromPlayer(player)
	if not actor then
		return
	end
	if kind == "EnterTraining" then
		TrainingService.enter(actor)
	elseif kind == "LeaveTraining" then
		TrainingService.leave(actor)
	elseif kind == "CancelDrill" then
		TrainingService.stopDrill(actor)
	elseif kind == "StartDrill" and type(payload) == "string" and DRILLS[payload] then
		if actor.role ~= "Training" then
			TrainingService.enter(actor)
		end
		TrainingService.startDrill(actor, payload)
	elseif kind == "LaunchCustom" then
		local s = sessions[actor.id]
		if s and s.drill == "Launcher" then
			DRILLS.Launcher.launch(s, payload)
		end
	end
end

function TrainingService.layout(): TrainingBuilder.Layout
	return layout
end

function TrainingService.Init(s: any)
	services = s
	layout = TrainingBuilder.build(ArenasConfig.TrainingOrigin, workspace)
end

function TrainingService.Start()
	for id, prompt in layout.prompts do
		prompt.Triggered:Connect(function(player)
			local actor = services.PlayerService.fromPlayer(player)
			if not actor then
				return
			end
			if actor.role ~= "Training" then
				services.TeamService.setTraining(actor, true)
			end
			TrainingService.startDrill(actor, id)
		end)
	end
	services.MovementService.TechAccepted:Connect(function(actorId, tech, quality, info)
		local s = sessions[actorId]
		if s then
			local drill = DRILLS[s.drill]
			if drill and drill.onTech then
				drill.onTech(s, tech, quality, info)
			end
		end
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		if sessions[actor.id] then
			TrainingService.stopDrill(actor)
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		for _, s in sessions do
			local drill = DRILLS[s.drill]
			if drill and drill.step and not s.ended then
				local ok, err = pcall(drill.step, s, dt)
				if not ok then
					warn("[TrainingService] " .. tostring(err))
				end
			end
		end
	end)
	Net.state():SetAttribute("TrainingOrigin", ArenasConfig.TrainingOrigin)
end

return TrainingService
]]></string>
