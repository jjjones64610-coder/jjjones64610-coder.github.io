      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="58">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">40</float>
      <float name="CameraMinZoomDistance">4</float>
      <float name="CharacterJumpPower">0</float>
      <float name="CharacterWalkSpeed">0</float>
      <token name="DevComputerMovementMode">3</token>
      <token name="DevTouchMovementMode">5</token>
      <bool name="EnableMouseLockOption">false</bool>
      <token name="GameSettingsAvatar">1</token>
    </Properties>
    <Item class="StarterCharacterScripts" referent="59">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="60">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[--!strict
-- Replaces Roblox's default "Animate" script (same name in
-- StarterCharacterScripts). Plays base locomotion (Shared/Animation/Locomotion)
-- from the character's real, lightly smoothed velocity, so animation always
-- matches the movement engine. The local MovementController publishes its
-- pose mode in the "UB_LocalMode" attribute: slides, dives, the dive recovery,
-- the disc holder's pivot ("Pivot") and the mark shuffle ("Mark") use the
-- pose layer (calm idle under PoseController), never the walk cycle.
-- Short airborne blips (a step down, a bump) do not switch to the fall
-- animation: only a real jump or more than AIR_GRACE seconds in the air does.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local character = script.Parent :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local root = character:WaitForChild("HumanoidRootPart") :: BasePart

local Locomotion =
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Animation"):WaitForChild("Locomotion"))

local controller = Locomotion.new(humanoid)

local POSE_MODES = {
	Slide = true,
	Dive = true,
	DiveSlide = true,
	Recover = true,
	Pivot = true,
	Mark = true,
}

local AIR_GRACE = 0.12
local SPEED_RATE = 20 -- smoothing of the measured speed (1/s)

local speed = 0
local airSince: number? = nil

local connection = RunService.Heartbeat:Connect(function(dt)
	if humanoid.Health <= 0 then
		return
	end
	local v = root.AssemblyLinearVelocity
	local raw = Vector3.new(v.X, 0, v.Z).Magnitude
	speed += (raw - speed) * (1 - math.exp(-SPEED_RATE * dt))

	local localMode = character:GetAttribute("UB_LocalMode")
	local state = humanoid:GetState()
	local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
	local clock = os.clock()
	if airborne then
		airSince = airSince or clock
	else
		airSince = nil
	end

	local mode: Locomotion.Mode = "Ground"
	if type(localMode) == "string" and POSE_MODES[localMode] then
		mode = "Pose"
	elseif airborne and (state == Enum.HumanoidStateType.Jumping or clock - (airSince :: number) > AIR_GRACE) then
		mode = if v.Y > 2 then "Rising" else "Falling"
	end
	Locomotion.update(controller, dt, speed, mode)
end)

humanoid.Died:Connect(function()
	connection:Disconnect()
	Locomotion.destroy(controller)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="61">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="62">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="63">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
-- AudioController — plays cues from Config/Audio, 2D or positioned in the world.
-- comboTick(link, perfect) is the combo chain's tick: the same short cue
-- climbing ComboTickStep semitones per link, so a chain is heard building.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AudioConfig = require(Shared.Config.Audio)

local AudioController = {}

local controllers: any
local templates: { [string]: Sound } = {}
local loops: { [string]: Sound } = {}

local function volumeFor(cue: string): number
	local settings = controllers.SettingsController
	local master = settings.get("MasterVolume") or 1
	local group = if string.find(cue, "Crowd") then settings.get("CrowdVolume") else settings.get("SfxVolume")
	return master * (group or 1)
end

local function template(cue: string): Sound?
	local cfg = (AudioConfig.Cues :: any)[cue]
	if not cfg or cfg.id == "" then
		return nil
	end
	local s = templates[cue]
	if not s then
		local snd = Instance.new("Sound")
		snd.Name = cue
		snd.SoundId = cfg.id
		snd.Volume = cfg.volume
		snd.PlaybackSpeed = cfg.pitch or 1
		snd.Looped = cfg.looped == true
		snd.Parent = SoundService
		templates[cue] = snd
		s = snd
	end
	return s
end

-- 2D cue (UI, your own actions). `pitchMult` scales the cue's pitch.
function AudioController.play(cue: string, pitchJitter: number?, pitchMult: number?)
	local t = template(cue)
	if not t then
		return
	end
	local s = t:Clone()
	local cfg = (AudioConfig.Cues :: any)[cue]
	s.Volume = cfg.volume * volumeFor(cue)
	local pitch = (cfg.pitch or 1) * (pitchMult or 1)
	if pitchJitter then
		pitch *= 1 + (math.random() - 0.5) * pitchJitter
	end
	s.PlaybackSpeed = pitch
	s.Parent = SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
	task.delay(6, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

-- The combo tick for the `link`-th technique of a chain (1 = first).
function AudioController.comboTick(link: number, perfect: boolean?)
	local steps = math.clamp(math.floor(link) - 1, 0, AudioConfig.ComboTickMaxSteps)
	local mult = 2 ^ (steps * AudioConfig.ComboTickStep / 12)
	if perfect then
		mult *= AudioConfig.ComboTickPerfect
	end
	AudioController.play("ComboTick", nil, mult)
end

-- Positional cue in the world.
function AudioController.playAt(cue: string, position: Vector3)
	local t = template(cue)
	if not t then
		return
	end
	local att = Instance.new("Attachment")
	att.WorldPosition = position
	att.Parent = workspace.Terrain
	local s = t:Clone()
	local cfg = (AudioConfig.Cues :: any)[cue]
	s.Volume = cfg.volume * volumeFor(cue)
	s.RollOffMaxDistance = 260
	s.RollOffMinDistance = 20
	s.Parent = att
	s:Play()
	task.delay(4, function()
		att:Destroy()
	end)
end

function AudioController.loop(cue: string, on: boolean)
	local t = template(cue)
	if not t then
		return
	end
	local s = loops[cue]
	if on and not s then
		local snd = t:Clone()
		snd.Looped = true
		snd.Volume = (AudioConfig.Cues :: any)[cue].volume * volumeFor(cue)
		snd.Parent = SoundService
		snd:Play()
		loops[cue] = snd
	elseif not on and s then
		s:Destroy()
		loops[cue] = nil
	end
end

function AudioController.Init(c: any)
	controllers = c
end

function AudioController.Start()
	AudioController.loop("CrowdLoop", true)
	controllers.SettingsController.Changed:Connect(function()
		for cue, s in loops do
			s.Volume = (AudioConfig.Cues :: any)[cue].volume * volumeFor(cue)
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CameraController — over-the-shoulder orbit camera that doubles as the aim.

	Yaw/pitch come from the mouse (locked to the centre during play), the right
	gamepad stick or a touch drag. The mouse is never locked while a TextBox
	(chat) has focus, the game menu or the Roblox menu is open, or the player
	freed it (CameraLock key).

	Rig: the focus follows the root directly in X/Z and smooths only its height
	(absorbs landing bob). Looking up raises the orbit pivot (2.3 -> 4.5 studs)
	and pulls the camera in (to 7.5 studs) so a huck aim never scrapes the
	ground; the camera also never goes below the floor + 1.2. Walls are found
	with a sphere cast: the camera pulls in at once and eases back out. The
	field of view widens by at most 2.5 degrees at top speed (ramp tied to
	Config/Movement SprintSpeed, rising and falling slowly so cuts do not make
	it breathe); kicks are capped at 2 degrees. Mouse-wheel zoom 7..30 studs
	while not holding the disc. It never takes control away (no cinematics).
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local MovementConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Movement"))

local CameraController = {}

local controllers: any
local camera: Camera
local yaw = 0
local pitch = math.rad(-12)
local distance = 12 -- smoothed zoom
local targetDistance = 12 -- zoom the wheel asks for
local collisionDistance = math.huge -- wall-limited distance (in at once, out slowly)
local focusY: number? = nil
local speedFov = 0
local kick = 0 -- requested punch (decays)
local kickShown = 0 -- what the FOV shows (eases toward kick)
local shakeAmp = 0
local shakeUntil = 0
local locked = true
local gamepadLook = Vector2.zero
local touchDelta = Vector2.zero

local MIN_PITCH = math.rad(-70)
local MAX_PITCH = math.rad(55)
local SHOULDER = 1.7
local PIVOT_HEIGHT = 2.3 -- orbit pivot above the root, level aim ...
local PIVOT_RAISE = 2.2 -- ... plus this much when looking fully up
local NEAR_DISTANCE = 7.5 -- distance when looking fully up
local MIN_ZOOM = 7
local MAX_ZOOM = 30
local FLOOR_CLEARANCE = 1.2
local WALL_RADIUS = 0.5
local WALL_OUT_RATE = 6
local FOCUS_Y_RATE = 12
local SPEED_FOV = 2.5 -- extra degrees at top speed
local SPEED_FOV_FROM = MovementConfig.SprintSpeed - 6 -- 22 with the current tuning
local SPEED_FOV_TO = MovementConfig.SprintSpeed + 4 -- 32
local MAX_KICK = 2

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

function CameraController.getYaw(): number
	return yaw
end

function CameraController.getPitch(): number
	return pitch
end

function CameraController.setYaw(y: number)
	yaw = y
end

function CameraController.getAimDirection(): Vector3
	return camera.CFrame.LookVector
end

function CameraController.getCFrame(): CFrame
	return camera.CFrame
end

-- Horizontal forward of the camera.
function CameraController.forward(): Vector3
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

-- A brief FOV punch (degrees, capped at MAX_KICK).
function CameraController.kick(amount: number)
	kick = math.max(kick, math.min(amount, MAX_KICK))
end

function CameraController.shake(amplitude: number, duration: number)
	if not controllers.SettingsController.get("CameraShake") then
		return
	end
	shakeAmp = math.max(shakeAmp, amplitude)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

function CameraController.setLocked(l: boolean)
	locked = l
end

-- Mouse captured for aiming: not while typing, in a menu or freed by the player.
function CameraController.isLocked(): boolean
	return locked
		and not controllers.InputController.menuOpen()
		and not GuiService.MenuIsOpen
		and UserInputService:GetFocusedTextBox() == nil
end

function CameraController.addTouchDelta(d: Vector2)
	touchDelta += d
end

local function update(dt: number)
	local player = Players.LocalPlayer
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	camera.CameraType = Enum.CameraType.Scriptable
	local settings = controllers.SettingsController
	local active = CameraController.isLocked()

	UserInputService.MouseBehavior = if active then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = not active

	local invert = if settings.get("InvertY") then -1 else 1
	if active then
		local md = UserInputService:GetMouseDelta()
		local sens = 0.0042 * settings.get("MouseSensitivity")
		yaw -= md.X * sens
		pitch -= md.Y * sens * invert
	end
	if not controllers.InputController.menuOpen() then
		local gs = gamepadLook
		if gs.Magnitude > 0.12 then
			local sens = 3.4 * settings.get("GamepadSensitivity") * dt
			yaw -= gs.X * math.abs(gs.X) * sens
			pitch += gs.Y * math.abs(gs.Y) * sens * 0.7 * invert
		end
		if touchDelta.Magnitude > 0 then
			local sens = 0.006 * settings.get("TouchSensitivity")
			yaw -= touchDelta.X * sens
			pitch -= touchDelta.Y * sens * invert
		end
	end
	touchDelta = Vector2.zero
	pitch = math.clamp(pitch, MIN_PITCH, MAX_PITCH)

	if not root then
		return
	end
	local rp = root.Position
	-- focus: X/Z follow directly, height is smoothed (landing bob)
	local fy = focusY
	if fy == nil or math.abs(fy - rp.Y) > 20 then
		fy = rp.Y
	else
		fy += (rp.Y - fy) * (1 - math.exp(-FOCUS_Y_RATE * dt))
	end
	focusY = fy
	local up = math.max(pitch, 0) / MAX_PITCH -- 0 level .. 1 looking fully up
	local f = Vector3.new(rp.X, (fy :: number) + PIVOT_HEIGHT + PIVOT_RAISE * up, rp.Z)

	local rot = CFrame.fromOrientation(pitch, yaw, 0)
	local look = rot.LookVector
	local right = rot.RightVector
	distance += (targetDistance - distance) * (1 - math.exp(-10 * dt))
	local near = math.min(distance, NEAR_DISTANCE)
	local want = distance + (near - distance) * up
	local pivot = f + right * SHOULDER

	local exclude: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	for _, name in { "UBBots", "UBVisuals" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	rayParams.FilterDescendantsInstances = exclude

	-- walls pull the camera in at once and release it gently; the floor never
	-- pulls in (the height clamp below handles it)
	local allowed = want
	local hit = workspace:Spherecast(pivot, WALL_RADIUS, -look * want, rayParams)
	if hit and hit.Normal.Y <= 0.7 then
		allowed = math.max(0.5, hit.Distance)
	end
	if allowed < collisionDistance then
		collisionDistance = allowed
	else
		collisionDistance += (allowed - collisionDistance) * (1 - math.exp(-WALL_OUT_RATE * dt))
	end
	collisionDistance = math.min(collisionDistance, want)
	local camPos = pivot - look * collisionDistance
	local floor = workspace:Raycast(pivot, Vector3.new(0, -80, 0), rayParams)
	if floor then
		local minY = floor.Position.Y + FLOOR_CLEARANCE
		if camPos.Y < minY then
			camPos = Vector3.new(camPos.X, minY, camPos.Z)
		end
	end

	-- feel: speed FOV (slow to rise, slower to fall), small kicks, shake
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local speedTarget = math.clamp((speed - SPEED_FOV_FROM) / (SPEED_FOV_TO - SPEED_FOV_FROM), 0, 1) * SPEED_FOV
	local fovRate = if speedTarget > speedFov then 3 else 1.5
	speedFov += (speedTarget - speedFov) * (1 - math.exp(-fovRate * dt))
	kick = math.max(0, kick - 12 * dt)
	kickShown += (kick - kickShown) * (1 - math.exp(-25 * dt))
	camera.FieldOfView = settings.get("FieldOfView") + speedFov + kickShown

	local cf = CFrame.lookAt(camPos, camPos + look)
	local clock = os.clock()
	if clock < shakeUntil then
		local a = shakeAmp * (shakeUntil - clock) / 0.3
		cf *= CFrame.new(math.noise(clock * 30, 1) * a, math.noise(clock * 30, 2) * a, 0)
	else
		shakeAmp = 0
	end
	camera.CFrame = cf
	camera.Focus = CFrame.new(f)
end

function CameraController.Init(c: any)
	controllers = c
	camera = workspace.CurrentCamera
end

function CameraController.Start()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		camera = workspace.CurrentCamera
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject, gameProcessed: boolean)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not gameProcessed then
			-- wheel zooms only while not holding a disc (then it cycles throw type)
			if not controllers.ThrowController.isHolding() then
				targetDistance = math.clamp(targetDistance - input.Position.Z * 1.5, MIN_ZOOM, MAX_ZOOM)
			end
		end
	end)
	controllers.InputController.ActionBegan:Connect(function(action)
		if action == "CameraLock" then
			locked = not locked
		end
	end)
	-- initial yaw: face the way the character faces
	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(function(character)
		local root = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
		if root then
			local lv = root.CFrame.LookVector
			yaw = math.atan2(-lv.X, -lv.Z)
			focusY = nil
			collisionDistance = math.huge
		end
	end)
	RunService:BindToRenderStep("UBCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">CatchController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CatchController — catching, reaching and marking for the local player.

	Catching. Contact is detected here, where your body is exactly where you
	see it and the disc is at the shared server time. Every frame the disc's
	path since the last frame (keyed by FlightId, so a new segment never
	sweeps from the old one's last point) is swept against your catch zones
	(CatchGeometry, the module the server validates with). On first contact
	the controller keeps tracking for up to ClaimTrackTime, or until the disc
	starts moving away from your zone core (its closest approach), then
	claims: Catch(discId, tFirst, zoneKind, reachDir, rootPos, rootVel) with
	your body as it was at first contact. On the claim:
	  * Claimed(discId, zoneKind) fires (MovementController starts the catch
	    slow-down) and the disc eases into your hand (DiscRenderer)
	  * the catch sound and a small burst play at once for a confident claim
	    (depth < LOCAL_FX_DEPTH), once per flight segment; recentLocalCatch()
	    lets the effects skip the server's copy of your own catch
	The server always answers (CatchResult). Denied, or the disc going to
	someone else, fires Denied(discId): MovementController cancels the
	slow-down, the disc eases back onto its flight, and the throttle is
	cleared so a disc still inside your zones is claimed again at once. A
	claim with no answer yet is never repeated sooner than ClaimThrottle.

	Reach (Primary while not holding): opens a 0.28 s window where your hand
	extends toward your aim. A light assist bends the reach toward a disc that
	is close and roughly where you are looking. Primary next to a disc lying
	on the ground asks the server to pick it up instead (Action "Pickup").

	Marking: hold Secondary within Marking.Range of an opposing holder (their
	pivot) for the mark shuffle (MovementController.setMarking) with your
	hands up, replicated as MarkStance(on, stance). The Slide key toggles High
	/ Low while marking. A Cut / Dive / Burst ends the mark inside the sim;
	press Secondary again to re-mark. Moving well out of range drops the
	mark until you come back in.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local Actors = require(Shared.Actors)
local VecMath = require(Shared.Util.VecMath)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local C = DiscConfig.Catch
local MK = MovementConfig.Marking

local CatchController = {}

CatchController.Reached = Signal.new() -- (dir)
CatchController.Claimed = Signal.new() -- (discId, zoneKind)
CatchController.Denied = Signal.new() -- (discId)

local LOCAL_FX_DEPTH = 0.85 -- claims this deep play the catch feedback at once
local LOCAL_FX_RECENT = 1.2 -- recentLocalCatch(): feedback played this recently
local RECEDE = 0.01 -- depth growth per frame that means the disc is moving away
local SUB_STEP = 0.6 -- studs between swept sub-samples
local MAX_SUB = 8
local ANSWER_TIMEOUT = 0.6 -- (+ 2 x ping) a claim with no answer may be repeated
local MARK_DROP = 2 -- the mark ends this far beyond Marking.Range
local PICKUP_REACH = 1.5 -- Primary picks up a grounded disc within PickupRadius + this

local controllers: any
local player = Players.LocalPlayer

local reachAt = -math.huge
local reachDir = Vector3.new(0, 0, -1)

-- marking
local markHeld = false -- Secondary is held (and armed: a technique disarms it)
local marking = false
local markStance = "Low"

type Contact = {
	flightId: number,
	lastPos: Vector3, -- disc position last frame
	lastT: number,
	tFirst: number?, -- first contact of the current episode
	kind: string,
	bestDepth: number,
	lastDepth: number,
	body: Vector3, -- your root at first contact
	bodyVel: Vector3,
	retry: boolean, -- after a Denied: claim at the next contact without tracking
	awaiting: boolean, -- a claim is out, no answer yet
	sentAt: number, -- os.clock() of the last claim
	fxDone: boolean, -- local catch feedback already played for this segment
	settled: boolean, -- the server decided this segment (caught / lost): no more claims
}
local contacts: { [string]: Contact } = {}
local lastLocalFx = -math.huge -- os.clock() of the last local catch feedback

local function now(): number
	return Net.now()
end

local function myPing(): number
	local ok, value = pcall(function()
		return player:GetNetworkPing()
	end)
	if ok and type(value) == "number" and value == value then
		return math.clamp(value, 0, 0.35)
	end
	return 0.1
end

function CatchController.reachActive(): boolean
	return now() - reachAt <= C.ReachWindow
end

function CatchController.isMarking(): boolean
	return marking
end

function CatchController.markStance(): string
	return markStance
end

function CatchController.reachState(): (number, Vector3)
	return reachAt, reachDir
end

-- Did your own catch feedback (sound + burst) just play on a claim? The
-- server's "Catch" effect for you can then be skipped (no double sound).
function CatchController.recentLocalCatch(): boolean
	return os.clock() - lastLocalFx <= LOCAL_FX_RECENT
end

local function myTeam(): string?
	local c = player.Character
	return if c then c:GetAttribute("UBTeam") :: string? else nil
end

local function canClaim(folder: Configuration): boolean
	local context = folder:GetAttribute("Context")
	local c = player.Character
	if not c or c:GetAttribute("UBFrozen") == true then
		return false
	end
	local role = c:GetAttribute("UBRole")
	if role == "Bench" or role == "Spectate" then
		return false
	end
	if context == "Training" then
		return folder:GetAttribute("Owner") == player.UserId
	elseif context == "Warmup" then
		return true
	end
	local team = myTeam()
	if team ~= "A" and team ~= "B" then
		return false
	end
	if folder:GetAttribute("Pull") == true then
		return Net.state():GetAttribute("Offense") == team
	end
	return Net.state():GetAttribute("Phase") == "Live"
end

local function nearestFlyingDisc(maxDist: number): (Vector3?, string?)
	local root = controllers.MovementController.root()
	if not root then
		return nil, nil
	end
	local best, bestId, bestD = nil, nil, maxDist
	for _, f in controllers.DiscRenderer.folders() do
		if f:GetAttribute("Mode") == "Flight" then
			local id = f:GetAttribute("Id") :: string
			local p = controllers.DiscRenderer.positionOf(id)
			if p then
				local d = (p - root.Position).Magnitude
				if d < bestD then
					best, bestId, bestD = p, id, d
				end
			end
		end
	end
	return best, bestId
end

-- Primary next to a disc on the ground: ask for it (no teleport; the server
-- plants your pivot on it and your body glides there).
local function requestPickup(): boolean
	local root = controllers.MovementController.root()
	if not root then
		return false
	end
	for _, f in controllers.DiscRenderer.folders() do
		if f:GetAttribute("Mode") == "Ground" then
			local gp = f:GetAttribute("GroundPos")
			if typeof(gp) == "Vector3" then
				local d = VecMath.flat(gp - root.Position).Magnitude
				if d <= C.PickupRadius + PICKUP_REACH and math.abs(gp.Y - root.Position.Y) < 8 then
					Net.event("Action"):FireServer("Pickup", nil)
					return true
				end
			end
		end
	end
	return false
end

function CatchController.reach()
	local t = now()
	if t - reachAt < C.ReachWindow + C.ReachCooldown then
		return
	end
	local root = controllers.MovementController.root()
	if not root then
		return
	end
	local aim = controllers.CameraController.getAimDirection()
	local discPos = nearestFlyingDisc(8)
	if discPos then
		local toDisc = (discPos - (root.Position + Vector3.new(0, C.ShoulderHeight, 0))).Unit
		if aim:Dot(toDisc) > math.cos(math.rad(55)) then
			aim = aim:Lerp(toDisc, 0.6).Unit
		end
	end
	reachAt = t
	reachDir = aim
	Net.event("Reach"):FireServer(aim)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalReach", t)
		c:SetAttribute("UB_LocalReachDir", aim)
	end
	controllers.MovementController.noteAerialReach(aim)
	CatchController.Reached:Fire(aim)
end

---------------------------------------------------------------------------
-- marking
---------------------------------------------------------------------------

local function sendStance()
	Net.event("MarkStance"):FireServer(marking, markStance)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalMark", if marking then markStance else "")
	end
end

local function setMarking(on: boolean)
	if marking == on then
		return
	end
	marking = on
	controllers.MovementController.setMarking(on)
	sendStance()
end

-- Flat distance from you to the nearest opposing holder's pivot (or root).
local function holderDistance(): number?
	local c = player.Character
	local root = controllers.MovementController.root()
	if not c or not root then
		return nil
	end
	local team = c:GetAttribute("UBTeam")
	local best: number? = nil
	for _, folder in controllers.DiscRenderer.folders() do
		local hid = folder:GetAttribute("HolderId")
		if folder:GetAttribute("Mode") == "Held" and type(hid) == "number" and hid ~= 0 and hid ~= player.UserId then
			local model = Actors.characterOf(hid)
			if model and (model:GetAttribute("UBTeam") ~= team or folder:GetAttribute("Context") ~= "Match") then
				local pv = model:GetAttribute("UBPivot")
				local hroot = model:FindFirstChild("HumanoidRootPart") :: BasePart?
				local p = if typeof(pv) == "Vector3" then pv elseif hroot then hroot.Position else nil
				if p then
					local d = VecMath.flat(p - root.Position).Magnitude
					if best == nil or d < (best :: number) then
						best = d
					end
				end
			end
		end
	end
	return best
end

local function updateMarking()
	if marking and not controllers.MovementController.isMarking() then
		-- a technique ended the mark inside the sim: press Secondary again
		markHeld = false
		setMarking(false)
		return
	end
	if not markHeld or controllers.ThrowController.isHolding() then
		setMarking(false)
		return
	end
	local d = holderDistance()
	if marking then
		if d == nil or d > MK.Range + MARK_DROP then
			setMarking(false)
		end
	elseif d ~= nil and d <= MK.Range then
		setMarking(true)
	end
end

local function toggleStance()
	markStance = if markStance == "High" then "Low" else "High"
	sendStance()
end

---------------------------------------------------------------------------
-- catching
---------------------------------------------------------------------------

local function bodyState(root: BasePart): CatchGeometry.BodyState
	local sim = controllers.MovementController.sim()
	local diving = sim.mode == "Dive" or sim.mode == "DiveSlide"
	return {
		root = root.Position,
		facing = VecMath.flatUnit(root.CFrame.LookVector),
		reaching = CatchController.reachActive(),
		reachDir = reachDir,
		diving = diving,
		diveDir = sim.diveDir,
		sliding = sim.mode == "Slide",
	}
end

-- Deepest evaluation along this frame's disc path, and the time of the
-- first sub-sample inside a zone.
local function sweep(
	zones: { CatchGeometry.Zone },
	from: Vector3,
	to: Vector3,
	tFrom: number,
	tTo: number
): (CatchGeometry.Evaluation?, number)
	local n = math.clamp(math.ceil((to - from).Magnitude / SUB_STEP), 1, MAX_SUB)
	local best: CatchGeometry.Evaluation? = nil
	local firstT = tTo
	for k = 1, n do
		local a = k / n
		local ev = CatchGeometry.evaluate(zones, from:Lerp(to, a))
		if ev then
			if best == nil then
				firstT = tFrom + (tTo - tFrom) * a
			end
			if best == nil or ev.depth < (best :: CatchGeometry.Evaluation).depth then
				best = ev
			end
		end
	end
	return best, firstT
end

local function localFeedback(c: Contact, pos: Vector3)
	if c.fxDone or c.bestDepth >= LOCAL_FX_DEPTH then
		return
	end
	c.fxDone = true
	lastLocalFx = os.clock()
	local clean = c.bestDepth <= C.CleanFraction
	controllers.AudioController.playAt(if clean then "CleanCatch" else "Catch", pos)
	local color = if clean then Color3.fromRGB(210, 240, 255) else Color3.fromRGB(255, 205, 70)
	controllers.EffectsController.burst(pos, color, 6, 8)
end

local function sendClaim(id: string, c: Contact, discPos: Vector3)
	local tFirst = c.tFirst :: number
	c.sentAt = os.clock()
	c.awaiting = true
	c.retry = false
	Net.event("Catch"):FireServer(id, tFirst, c.kind, reachDir, c.body, c.bodyVel)
	controllers.DiscRenderer.predictCatch(id)
	localFeedback(c, discPos)
	CatchController.Claimed:Fire(id, c.kind)
end

local function stepDisc(folder: Configuration, root: BasePart, zones: { CatchGeometry.Zone }, tNow: number)
	local id = folder:GetAttribute("Id") :: string
	local sim, launchTime, _, _, landed, flightId = controllers.DiscRenderer.flight(id)
	if
		not sim
		or landed
		or not canClaim(folder)
		or folder:GetAttribute("ThrowerId") == player.UserId
		or tNow < launchTime + DiscConfig.Throw.NoCatchTime
	then
		contacts[id] = nil
		return
	end
	local x, y, z = DiscPhysics.positionAt(sim, tNow - launchTime)
	local p = Vector3.new(x, y, z)
	local c = contacts[id]
	if not c or c.flightId ~= flightId then
		-- a new segment: start sweeping from here, never from the old one
		contacts[id] = {
			flightId = flightId,
			lastPos = p,
			lastT = tNow,
			tFirst = nil,
			kind = "Secure",
			bestDepth = 1,
			lastDepth = 1,
			body = root.Position,
			bodyVel = root.AssemblyLinearVelocity,
			retry = false,
			awaiting = false,
			sentAt = -math.huge,
			fxDone = false,
			settled = false,
		}
		return
	end
	if c.settled then
		return
	end
	local ev, firstT = sweep(zones, c.lastPos, p, c.lastT, tNow)
	c.lastPos, c.lastT = p, tNow
	if ev then
		if c.tFirst == nil then
			-- the body as it was at the (sub-frame) moment of first contact
			local vel = root.AssemblyLinearVelocity
			c.tFirst = firstT
			c.kind = ev.zone.kind
			c.bestDepth = ev.depth
			c.lastDepth = ev.depth
			c.body = root.Position - vel * (tNow - firstT)
			c.bodyVel = vel
		elseif ev.depth < c.bestDepth then
			c.bestDepth = ev.depth
			c.kind = ev.zone.kind
		end
	end
	local tFirst = c.tFirst
	if tFirst == nil then
		return
	end
	local clock = os.clock()
	if c.awaiting and clock - c.sentAt < ANSWER_TIMEOUT + 2 * myPing() then
		return
	end
	-- claim at the closest approach (or after tracking long enough)
	local receding = ev == nil or ev.depth > c.lastDepth + RECEDE
	local tracked = tNow - tFirst >= C.ClaimTrackTime
	c.lastDepth = if ev then ev.depth else 1
	if (c.retry or receding or tracked) and clock - c.sentAt >= C.ClaimThrottle then
		sendClaim(id, c, p)
		if ev == nil then
			c.tFirst = nil -- the disc has left the zones; a new touch is a new episode
		end
	end
end

local function step()
	local root = controllers.MovementController.root()
	if not root then
		return
	end
	updateMarking()
	if controllers.ThrowController.isHolding() then
		table.clear(contacts)
		return
	end
	local zones = CatchGeometry.zones(bodyState(root))
	local tNow = now()
	for _, folder in controllers.DiscRenderer.folders() do
		stepDisc(folder, root, zones, tNow)
	end
end

-- The server's answer to a claim (always sent, Denied included).
local function onResult(discId: any, accepted: any, result: any, flightId: any)
	if type(discId) ~= "string" then
		return
	end
	local c = contacts[discId]
	local current = c == nil or type(flightId) ~= "number" or flightId == c.flightId
	if not current then
		-- an answer about an older segment (e.g. the block that started this
		-- one): it ends that claim, but a claim already out on the current
		-- segment will get its own answer
		if accepted ~= true and not (c :: Contact).awaiting then
			controllers.DiscRenderer.cancelCatchPrediction(discId)
			CatchController.Denied:Fire(discId)
		end
		return
	end
	if c then
		c.awaiting = false
		c.tFirst = nil
		c.bestDepth = 1
		c.lastDepth = 1
		if result == "Denied" then
			-- retry at once if the disc is still in reach
			c.sentAt = -math.huge
			c.retry = true
		else
			c.settled = true -- caught, or someone else won it
		end
	end
	if accepted ~= true then
		controllers.DiscRenderer.cancelCatchPrediction(discId)
		CatchController.Denied:Fire(discId)
	end
end

function CatchController.Init(c: any)
	controllers = c
end

function CatchController.Start()
	controllers.InputController.ActionBegan:Connect(function(action)
		if controllers.ThrowController.isHolding() then
			return
		end
		if action == "Primary" then
			if not requestPickup() then
				CatchController.reach()
			end
		elseif action == "Secondary" then
			markHeld = true
			updateMarking()
		elseif action == "Slide" and marking then
			toggleStance()
		end
	end)
	controllers.InputController.ActionEnded:Connect(function(action)
		if action == "Secondary" then
			markHeld = false
			setMarking(false)
		end
	end)
	Net.event("CatchResult").OnClientEvent:Connect(onResult)
	player.CharacterAdded:Connect(function()
		if marking then
			marking = false
			sendStance()
		end
		markHeld = false
		markStance = "Low"
		reachAt = -math.huge
		table.clear(contacts)
	end)
	-- after DiscRenderer (Character + 2) has advanced this frame's flights
	RunService:BindToRenderStep("UBCatch", Enum.RenderPriority.Character.Value + 3, step)
end

return CatchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">DiscRenderer</string>
              <string name="Source"><![CDATA[--!strict
--[[
	DiscRenderer — draws every disc from its replicated state.

	Flight segments are re-simulated locally from the replicated launch values
	with the same fixed-step DiscPhysics the server runs, synchronised to the
	shared server clock (Net.now): smooth motion, zero per-frame network
	traffic, exactly the server's trajectory. A landing stops at the same
	interpolated contact point the server uses, then slides a little
	(cosmetic skid, SKID_TIME at SKID_DECEL, at most SKID_MAX) instead of
	sticking into the turf.

	Continuity — the disc never pops:
	  * every change of segment (FlightId), holder or mode starts a visual
	    blend: the disc is drawn at its new place plus the old offset, which
	    eases out over BLEND_TIME (0.12 s); the trail is cleared on any real
	    jump so it never streaks across it. Jumps larger than BLEND_MAX (a
	    disc placed somewhere else entirely) are a clean cut instead
	  * your own throw flies the instant you release (prediction); the
	    authoritative flight starts at your release time, so the blend onto
	    it is tiny
	  * a hand block: the segment carries StopAt, so every client holds the
	    disc at the marker's hands until the deflection segment (which starts
	    there, at that moment) arrives; your own prediction does the same
	    when your preview expects the block
	  * your own catch: on the claim the disc eases into your hand
	    (CATCH_EASE, cubic ease-out) and stays until the server answers;
	    Denied (or no answer in time) eases it back onto its flight
	    (DENY_EASE)
	  * someone else's catch: when a flying disc enters a remote player's
	    catch zones as they are displayed here (depth < OBSERVER_DEPTH, the
	    same rule that makes a defender's touch an interception) it is
	    magnetised to their hand (OBSERVER_EASE) and held up to OBSERVER_HOLD
	    waiting for Mode = Held; if the flight continues instead it blends
	    back
	Rendering runs at RenderPriority.Character + 2, after PoseController has
	posed the hands (Character + 1), so a held disc never trails the hand.

	Visuals: spinning disc with a stripe so spin is readable, a team-coloured
	trail (brighter on a Perfect release) and an optional ground shadow that
	helps judge height.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local ProgressionConfig = require(Shared.Config.Progression)
local TeamsConfig = require(Shared.Config.Teams)
local Actors = require(Shared.Actors)
local VecMath = require(Shared.Util.VecMath)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local DiscRenderer = {}

DiscRenderer.FlightStarted = Signal.new() -- (discId, folder)
DiscRenderer.Landed = Signal.new() -- (discId, position)

local controllers: any
local player = Players.LocalPlayer
local visualsFolder: Folder

local BLEND_TIME = 0.12 -- every discontinuity eases out over this long
local BLEND_MAX = 12 -- larger jumps are cut instead of slid
local TRAIL_CLEAR = 0.5 -- a correction larger than this clears the trail
local CATCH_EASE = 0.07 -- own claim: flight -> hand
local DENY_EASE = 0.1 -- own claim denied: hand -> flight
local CATCH_HOLD = 0.5 -- own claim: hold in the hand this long (+ 2 x ping)
local OBSERVER_DEPTH = 0.9
local OBSERVER_EASE = 0.08
local OBSERVER_HOLD = 0.35 -- (+ ping)
local OBSERVER_RANGE = 12 -- only characters this close to the disc are swept
local PREDICT_TIMEOUT = 0.8 -- own throw the server never launched: back to the hand
local LAND_HEIGHT = 0.15 -- resting disc centre above the ground (= server GroundPos)
local SKID_TIME = 0.25
local SKID_DECEL = 120
local SKID_MAX = 1.2
local SAME_SPOT = 0.6 -- GroundPos this close to our landing = the same landing
local MAX_DRAW_SPEED = 160 -- faster apparent motion is a cut, not movement
local UP = Vector3.new(0, 1, 0)

type Observer = { id: number, start: number, untilT: number, flightId: number }

type Visual = {
	id: string,
	folder: Configuration,
	body: BasePart,
	cap: BasePart,
	stripe: BasePart,
	shadow: BasePart,
	trail: Trail,
	trailOn: boolean,
	sim: DiscPhysics.State?,
	simFlight: number, -- FlightId the sim was read from
	flightId: number, -- last FlightId seen
	lastMode: string,
	lastHolder: number,
	launchTime: number,
	stopAt: number, -- flight time where a hand block stops this segment (math.huge = none)
	wind: DiscPhysics.Wind,
	groundY: number,
	landed: boolean,
	landT: number,
	landPos: Vector3,
	landNormal: Vector3,
	restUp: Vector3, -- the face it rests on (an inverted hammer stays inverted)
	skidDir: Vector3,
	skidSpeed: number,
	restOffset: Vector3, -- cosmetic skid kept while resting at the same spot
	spinAngle: number,
	spin: number,
	predicted: DiscPhysics.State?,
	predictedT0: number,
	predictedStop: number,
	predictedFlightId: number,
	catchStart: number,
	catchUntil: number,
	catchFlight: number,
	catching: boolean, -- the hand magnet was active last frame
	observer: Observer?,
	lastFlightPos: Vector3?, -- flight position last frame (observer sweep)
	blendOffset: Vector3,
	blendStart: number,
	blendDur: number,
	pendingBlend: number, -- > 0: blend the next frame's jump over this long
	pos: Vector3,
	drawVel: Vector3, -- how fast the drawn disc moved last frame
	normal: Vector3,
	skin: string,
	visible: boolean,
}

local visuals: { [string]: Visual } = {}

local SKINS: { [string]: any } = {}
for _, s in ProgressionConfig.DiscSkins do
	SKINS[s.id] = s
end

local function now(): number
	return Net.now()
end

local function myPing(): number
	local ok, value = pcall(function()
		return player:GetNetworkPing()
	end)
	if ok and type(value) == "number" and value == value then
		return math.clamp(value, 0, 0.35)
	end
	return 0.1
end

local function easeOut(u: number): number
	local x = math.clamp(u, 0, 1)
	local inv = 1 - x
	return 1 - inv * inv * inv
end

local function part(name: string, shape: Enum.PartType, size: Vector3, color: Color3): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = visualsFolder
	return p
end

local function applySkin(v: Visual, skinId: string)
	local s = SKINS[skinId] or SKINS.Classic
	v.skin = skinId
	v.body.Color = s.color
	v.cap.Color = s.rim
	v.stripe.Color = s.stripe
	v.body.Material = if s.neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
end

local function create(folder: Configuration): Visual
	local r = DiscConfig.Physics.Radius
	local body = part("Disc", Enum.PartType.Cylinder, Vector3.new(0.24, r * 2, r * 2), Color3.new(1, 1, 1))
	local cap = part("DiscCap", Enum.PartType.Cylinder, Vector3.new(0.27, r * 1.1, r * 1.1), Color3.new(0.8, 0.8, 0.8))
	local stripe = part("DiscStripe", Enum.PartType.Block, Vector3.new(0.28, 0.28, r * 1.7), Color3.new(0, 0.5, 1))
	local shadow = part("DiscShadow", Enum.PartType.Cylinder, Vector3.new(0.04, r * 2, r * 2), Color3.new(0, 0, 0))
	shadow.Transparency = 1
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0, r * 0.9)
	a0.Parent = body
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 0, -r * 0.9)
	a1.Parent = body
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
	trail.Enabled = false
	trail.Parent = body
	local v: Visual = {
		id = folder:GetAttribute("Id") :: string,
		folder = folder,
		body = body,
		cap = cap,
		stripe = stripe,
		shadow = shadow,
		trail = trail,
		trailOn = false,
		sim = nil,
		simFlight = -1,
		flightId = (folder:GetAttribute("FlightId") :: number?) or 0,
		lastMode = "",
		lastHolder = 0,
		launchTime = 0,
		stopAt = math.huge,
		wind = { x = 0, y = 0, z = 0 },
		groundY = 0,
		landed = false,
		landT = 0,
		landPos = Vector3.zero,
		landNormal = UP,
		restUp = UP,
		skidDir = Vector3.zero,
		skidSpeed = 0,
		restOffset = Vector3.zero,
		spinAngle = 0,
		spin = 0,
		predicted = nil,
		predictedT0 = 0,
		predictedStop = math.huge,
		predictedFlightId = -1,
		catchStart = 0,
		catchUntil = 0,
		catchFlight = -1,
		catching = false,
		observer = nil,
		lastFlightPos = nil,
		blendOffset = Vector3.zero,
		blendStart = 0,
		blendDur = BLEND_TIME,
		pendingBlend = 0,
		pos = Vector3.zero,
		drawVel = Vector3.zero,
		normal = UP,
		skin = "",
		visible = false,
	}
	body.Transparency = 1
	cap.Transparency = 1
	stripe.Transparency = 1
	applySkin(v, (folder:GetAttribute("Skin") or "Classic") :: string)
	return v
end

local function destroy(v: Visual)
	v.body:Destroy()
	v.cap:Destroy()
	v.stripe:Destroy()
	v.shadow:Destroy()
end

local function setVisible(v: Visual, on: boolean)
	if v.visible == on then
		return
	end
	v.visible = on
	local t = if on then 0 else 1
	v.body.Transparency = t
	v.cap.Transparency = t
	v.stripe.Transparency = t
	if not on then
		v.shadow.Transparency = 1
		v.trail.Enabled = false
		v.trailOn = false
	end
end

local function setTrail(v: Visual, on: boolean)
	if on == v.trailOn then
		return
	end
	v.trailOn = on
	if on then
		v.trail:Clear() -- start fresh where the disc is now
	end
	v.trail.Enabled = on
end

local function readFlight(v: Visual, flightId: number): boolean
	local f = v.folder
	local pos = f:GetAttribute("LaunchPos")
	local vel = f:GetAttribute("LaunchVel")
	local n = f:GetAttribute("LaunchNormal")
	local spin = f:GetAttribute("Spin")
	local t0 = f:GetAttribute("LaunchTime")
	local wind = f:GetAttribute("Wind")
	if
		typeof(pos) ~= "Vector3"
		or typeof(vel) ~= "Vector3"
		or typeof(n) ~= "Vector3"
		or type(spin) ~= "number"
		or type(t0) ~= "number"
	then
		return false
	end
	local w = if typeof(wind) == "Vector3" then wind else Vector3.zero
	v.sim = DiscPhysics.fromVectors(pos, vel, n, spin)
	v.simFlight = flightId
	v.launchTime = t0
	local stop = f:GetAttribute("StopAt")
	v.stopAt = if type(stop) == "number" and stop > 0 then stop else math.huge
	v.wind = { x = w.X, y = w.Y, z = w.Z }
	v.groundY = (f:GetAttribute("GroundY") :: number?) or 0
	v.landed = false
	v.spin = spin
	v.restOffset = Vector3.zero
	v.lastFlightPos = nil
	-- trail colour: thrower team, brighter for a Perfect release
	local team = f:GetAttribute("ThrowerTeam")
	local color = if team == "A"
		then TeamsConfig.A.Color
		elseif team == "B" then TeamsConfig.B.Color
		else Color3.new(1, 1, 1)
	v.trail.Color = ColorSequence.new(color)
	local perfect = f:GetAttribute("Quality") == "Perfect"
	v.trail.Lifetime = if perfect then 0.55 else 0.35
	v.trail.LightEmission = if perfect then 1 else 0.5
	return true
end

local function handCFrameOf(c: Model?): CFrame?
	if not c then
		return nil
	end
	local leftHanded = c:GetAttribute("LeftHanded") == true
	local hand = c:FindFirstChild(if leftHanded then "LeftHand" else "RightHand") :: BasePart?
	if not hand then
		hand = c:FindFirstChild(if leftHanded then "Left Arm" else "Right Arm") :: BasePart?
	end
	if not hand then
		return nil
	end
	return hand.CFrame * CFrame.new(0, -0.35, -0.75) * CFrame.Angles(0, 0, math.rad(90))
end

local function handCFrame(holderId: number): CFrame?
	if holderId == player.UserId then
		return handCFrameOf(player.Character)
	end
	return handCFrameOf(Actors.characterOf(holderId))
end

local function orient(pos: Vector3, n: Vector3, angle: number): CFrame
	local axis = if n.Magnitude > 0.1 then n.Unit else UP
	local ref = if math.abs(axis.Y) < 0.95 then UP else Vector3.new(1, 0, 0)
	local perp = axis:Cross(ref).Unit
	return CFrame.fromMatrix(pos, axis, perp) * CFrame.Angles(angle, 0, 0)
end

local function place(v: Visual, cf: CFrame, dt: number)
	local r = DiscConfig.Physics.Radius
	local parts = { v.body, v.cap, v.stripe }
	local cfs = { cf, cf, cf * CFrame.new(0, r * 0.35, 0) }
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	local moved = (cf.Position - v.pos) / math.max(dt, 1 / 240)
	v.drawVel = if v.visible and moved.Magnitude < MAX_DRAW_SPEED then moved else Vector3.zero
	v.pos = cf.Position
end

local function updateShadow(v: Visual, height: number, show: boolean)
	if not show or height < 0.4 then
		v.shadow.Transparency = 1
		return
	end
	local h = math.clamp(height, 0, 40)
	local scale = 1 + h * 0.03
	local r = DiscConfig.Physics.Radius
	v.shadow.Size = Vector3.new(0.04, r * 2 * scale, r * 2 * scale)
	v.shadow.Transparency = math.clamp(0.55 + h * 0.012, 0.55, 0.9)
	v.shadow.CFrame = CFrame.new(v.pos.X, v.groundY + 0.07, v.pos.Z) * CFrame.Angles(0, 0, math.rad(90))
end

local function shadowsEnabled(v: Visual): boolean
	if v.folder:GetAttribute("Context") ~= "Match" then
		return true
	end
	return Net.state():GetAttribute("LandingShadow") ~= false
end

-- Where the authoritative flight is now (advances the sim; handles landing
-- and the cosmetic skid). Returns (cframe, landed).
local function flightCFrame(v: Visual, s: DiscPhysics.State, t: number, dt: number): (CFrame, boolean)
	-- a hand block holds the disc at the hands until its deflection arrives
	local target = math.min(t - v.launchTime, v.stopAt)
	if not v.landed then
		local alive = DiscPhysics.advanceTo(s, target, v.wind, v.groundY)
		if not alive then
			-- s is at the interpolated contact point and time (as on the server)
			v.landed = true
			v.landT = v.launchTime + s.t
			v.landPos = Vector3.new(s.px, v.groundY + LAND_HEIGHT, s.pz)
			v.landNormal = DiscPhysics.normal(s)
			v.restUp = if v.landNormal.Y < 0 then -UP else UP
			local hv = Vector3.new(s.vx, 0, s.vz)
			v.skidSpeed = hv.Magnitude
			v.skidDir = if v.skidSpeed > 0.1 then hv / v.skidSpeed else Vector3.zero
			DiscRenderer.Landed:Fire(v.id, Vector3.new(s.px, v.groundY, s.pz))
		end
	end
	if v.landed then
		local stopT = math.min(SKID_TIME, v.skidSpeed / SKID_DECEL)
		local tau = math.clamp(t - v.landT, 0, stopT)
		local dist = math.min(v.skidSpeed * tau - 0.5 * SKID_DECEL * tau * tau, SKID_MAX)
		v.restOffset = v.skidDir * dist
		local slowing = if stopT > 0 then 1 - tau / stopT else 0
		v.spinAngle += v.spin * 0.25 * slowing * dt
		-- settle flat over the skid instead of snapping level at touchdown
		local settle = easeOut(math.clamp((t - v.landT) / SKID_TIME, 0, 1))
		return orient(v.landPos + v.restOffset, v.landNormal:Lerp(v.restUp, settle), v.spinAngle), true
	end
	local x, y, z = DiscPhysics.positionAt(s, target)
	v.spinAngle += s.spin * dt
	return orient(Vector3.new(x, y, z), DiscPhysics.normal(s), v.spinAngle), false
end

-- Catch zones of another character as displayed on this client.
local function displayedZones(model: Model, root: BasePart, t: number): { CatchGeometry.Zone }
	local reachT = model:GetAttribute("Reach")
	local reachDir = model:GetAttribute("ReachDir")
	local ms = model:GetAttribute("MS")
	local techDir = model:GetAttribute("TechDir")
	local facing = VecMath.flatUnit(root.CFrame.LookVector)
	local diving = ms == "Dive" or ms == "DiveSlide"
	return CatchGeometry.zones({
		root = root.Position,
		facing = facing,
		reaching = type(reachT) == "number" and t - reachT <= DiscConfig.Catch.ReachWindow + 0.1,
		reachDir = if typeof(reachDir) == "Vector3" then reachDir else nil,
		diving = diving,
		diveDir = if diving and typeof(techDir) == "Vector3" and techDir.Magnitude > 0.5 then techDir else facing,
		sliding = ms == "Slide",
	})
end

local function mayCatch(model: Model, folder: Configuration): boolean
	local role = model:GetAttribute("UBRole")
	if role == "Bench" or role == "Spectate" or model:GetAttribute("UBFrozen") == true then
		return false
	end
	local id = Actors.idOf(model)
	if id == nil or id == folder:GetAttribute("ThrowerId") then
		return false
	end
	if folder:GetAttribute("Context") == "Training" then
		return id == folder:GetAttribute("Owner")
	end
	if folder:GetAttribute("Pull") == true then
		return model:GetAttribute("UBTeam") == Net.state():GetAttribute("Offense")
	end
	return true
end

-- Someone else is about to catch this disc: find them along this frame's path.
local function findObserverCatch(v: Visual, from: Vector3, to: Vector3, t: number): number?
	local mine = player.Character
	for _, model in Actors.characters() do
		if model ~= mine then
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (root.Position - to).Magnitude < OBSERVER_RANGE and mayCatch(model, v.folder) then
				local zones = displayedZones(model, root, t)
				for k = 1, 3 do
					local ev = CatchGeometry.evaluate(zones, from:Lerp(to, k / 3))
					if ev and ev.depth < OBSERVER_DEPTH then
						return Actors.idOf(model)
					end
				end
			end
		end
	end
	return nil
end

-- The predicted flight of your own throw, before the server launches it.
local function predictedCFrame(v: Visual, pred: DiscPhysics.State, t: number, dt: number): CFrame
	local ft = math.min(t - v.predictedT0, v.predictedStop)
	if not DiscPhysics.advanceTo(pred, ft, v.wind, v.groundY) then
		-- landed before the server's flight arrived: rest at the contact
		return orient(Vector3.new(pred.px, v.groundY + LAND_HEIGHT, pred.pz), UP, v.spinAngle)
	end
	local x, y, z = DiscPhysics.positionAt(pred, math.max(ft, pred.t))
	v.spinAngle += pred.spin * dt
	return orient(Vector3.new(x, y, z), DiscPhysics.normal(pred), v.spinAngle)
end

type Frame = { cf: CFrame?, trail: boolean, shadow: boolean }

local function target(v: Visual, mode: string, holder: number, t: number, dt: number): Frame
	local f = v.folder
	if mode == "Flight" then
		local s = v.sim
		if not s then
			return { cf = nil, trail = false, shadow = false }
		end
		local cf, landed = flightCFrame(v, s, t, dt)
		local flightPos = cf.Position
		local stopped = t - v.launchTime >= v.stopAt

		-- own claim: ease into the hand while the server decides
		local catching = t < v.catchUntil and v.catchFlight == v.flightId
		if catching then
			local hand = handCFrame(player.UserId)
			if hand then
				v.catching = true
				v.lastFlightPos = flightPos
				return { cf = cf:Lerp(hand, easeOut((t - v.catchStart) / CATCH_EASE)), trail = false, shadow = false }
			end
		end
		if v.catching then
			v.catching = false
			v.pendingBlend = DENY_EASE -- denied / no answer: back onto the flight
		end

		-- someone else's catch, as this client displays them
		local ob = v.observer
		if ob and (ob.flightId ~= v.flightId or t >= ob.untilT) then
			v.observer = nil
			ob = nil
			v.pendingBlend = BLEND_TIME
		end
		local catchable = t >= v.launchTime + DiscConfig.Throw.NoCatchTime
		if not ob and not landed and not stopped and catchable and v.lastFlightPos then
			local id = findObserverCatch(v, v.lastFlightPos :: Vector3, flightPos, t)
			if id then
				ob = { id = id, start = t, untilT = t + OBSERVER_HOLD + myPing(), flightId = v.flightId }
				v.observer = ob
			end
		end
		v.lastFlightPos = flightPos
		if ob then
			local hand = handCFrame(ob.id)
			if hand then
				return { cf = cf:Lerp(hand, easeOut((t - ob.start) / OBSERVER_EASE)), trail = false, shadow = false }
			end
		end
		return { cf = cf, trail = not landed, shadow = not landed }
	end

	v.observer = nil
	v.catching = false
	v.lastFlightPos = nil
	if mode == "Held" then
		local pred = v.predicted
		if pred and holder == player.UserId and t - v.predictedT0 <= PREDICT_TIMEOUT then
			return { cf = predictedCFrame(v, pred, t, dt), trail = true, shadow = true }
		end
		if pred then
			v.predicted = nil -- the server never launched it: back to the hand
		end
		v.spinAngle += dt * 0.5
		return { cf = if holder ~= 0 then handCFrame(holder) else nil, trail = false, shadow = false }
	elseif mode == "Ground" then
		local gp = f:GetAttribute("GroundPos")
		if typeof(gp) ~= "Vector3" then
			return { cf = nil, trail = false, shadow = false }
		end
		-- keep the cosmetic skid (and the face it landed on) when the server
		-- rests it where we landed it
		local offset = Vector3.zero
		local up = UP
		if v.landed and (VecMath.flat(gp - v.landPos)).Magnitude <= SAME_SPOT then
			offset = v.restOffset
			up = v.restUp
		end
		return { cf = orient(gp + offset, up, v.spinAngle), trail = false, shadow = false }
	end
	return { cf = nil, trail = false, shadow = false }
end

local function render(v: Visual, dt: number)
	local f = v.folder
	local t = now()
	local modeAttr = f:GetAttribute("Mode")
	local mode = if type(modeAttr) == "string" then modeAttr else "None"
	local holderAttr = f:GetAttribute("HolderId")
	local holder = if type(holderAttr) == "number" then holderAttr else 0
	local skin = f:GetAttribute("Skin")
	if type(skin) == "string" and skin ~= v.skin then
		applySkin(v, skin)
	end

	-- state changes (each one is blended below)
	local changed = false
	local flightId = (f:GetAttribute("FlightId") :: number?) or 0
	if flightId ~= v.flightId then
		v.flightId = flightId
		v.observer = nil
		changed = true
	end
	-- a new segment: FlightId, or LaunchTime should FlightId arrive a frame late
	local launchT = f:GetAttribute("LaunchTime")
	if mode == "Flight" and (v.simFlight ~= flightId or (type(launchT) == "number" and launchT ~= v.launchTime)) then
		if readFlight(v, flightId) then
			DiscRenderer.FlightStarted:Fire(v.id, f)
			changed = true
		else
			v.sim = nil
		end
	end
	if v.predicted and (mode ~= "Held" or v.predictedFlightId ~= flightId) then
		v.predicted = nil -- the authoritative flight (or another state) took over
	end
	if mode ~= v.lastMode or holder ~= v.lastHolder then
		changed = true
		v.lastMode = mode
		v.lastHolder = holder
	end

	local fr = target(v, mode, holder, t, dt)
	local cf = fr.cf
	if not cf then
		setVisible(v, false)
		return
	end

	-- blend every discontinuity (or cut a big one)
	local blendFor = if changed then BLEND_TIME else 0
	if v.pendingBlend > 0 then
		blendFor = v.pendingBlend
		v.pendingBlend = 0
	end
	if blendFor > 0 then
		-- the jump between where the old state would have drawn the disc this
		-- frame and where the new one does (not the disc's own motion)
		local jump = if v.visible then v.pos + v.drawVel * dt - cf.Position else Vector3.zero
		local size = jump.Magnitude
		if size > TRAIL_CLEAR then
			v.trail:Clear()
		end
		if size > 1e-3 and size <= BLEND_MAX then
			-- continue from wherever the disc is drawn now (including a running blend)
			v.blendOffset = jump
			v.blendStart = t
			v.blendDur = blendFor
		else
			v.blendOffset = Vector3.zero
			v.blendDur = 0
		end
	end
	if v.blendDur > 0 then
		local k = 1 - (t - v.blendStart) / v.blendDur
		if k <= 0 then
			v.blendDur = 0
			v.blendOffset = Vector3.zero
		else
			local w = k * k * (3 - 2 * k)
			cf = cf + v.blendOffset * w
		end
	end

	place(v, cf, dt)
	setVisible(v, true)
	setTrail(v, fr.trail)
	updateShadow(v, v.pos.Y - v.groundY, fr.shadow and shadowsEnabled(v))
end

---------------------------------------------------------------------------
-- public API
---------------------------------------------------------------------------

function DiscRenderer.folders(): { Configuration }
	local list = {}
	for _, v in visuals do
		table.insert(list, v.folder)
	end
	return list
end

-- Where the disc is drawn this frame.
function DiscRenderer.positionOf(id: string): Vector3?
	local v = visuals[id]
	return if v and v.visible then v.pos else nil
end

-- Flight info for catch detection (nil sim unless flying). The last value is
-- the FlightId the sim belongs to.
function DiscRenderer.flight(id: string): (DiscPhysics.State?, number, DiscPhysics.Wind, number, boolean, number)
	local v = visuals[id]
	if not v or v.folder:GetAttribute("Mode") ~= "Flight" or v.simFlight ~= v.flightId then
		return nil, 0, { x = 0, y = 0, z = 0 }, 0, true, -1
	end
	-- a disc held up by a marker's hands is not catchable either
	local over = v.landed or now() - v.launchTime >= v.stopAt
	return v.sim, v.launchTime, v.wind, v.groundY, over, v.simFlight
end

function DiscRenderer.folderOf(id: string): Configuration?
	local v = visuals[id]
	return if v then v.folder else nil
end

function DiscRenderer.heldByMe(): Configuration?
	for _, v in visuals do
		if v.folder:GetAttribute("Mode") == "Held" and v.folder:GetAttribute("HolderId") == player.UserId then
			return v.folder
		end
	end
	return nil
end

-- Your own throw: fly `state` from server time `t0` (default now) until the
-- server's flight arrives; `stopAt` (flight time) holds it at a marker's
-- hands when the release is expected to be hand-blocked.
function DiscRenderer.predictThrow(id: string, state: DiscPhysics.State, t0: number?, stopAt: number?)
	local v = visuals[id]
	if not v then
		return
	end
	v.predicted = DiscPhysics.copy(state)
	v.predictedT0 = t0 or now()
	v.predictedStop = if stopAt and stopAt > 0 then stopAt else math.huge
	v.predictedFlightId = v.flightId
	local w = Net.state():GetAttribute("Wind")
	if typeof(w) == "Vector3" then
		v.wind = { x = w.X, y = w.Y, z = w.Z }
	end
end

-- Your own claim: ease the disc into your hand until the server answers.
function DiscRenderer.predictCatch(id: string)
	local v = visuals[id]
	if not v or v.folder:GetAttribute("Mode") ~= "Flight" then
		return
	end
	local t = now()
	if not (t < v.catchUntil and v.catchFlight == v.flightId) then
		v.catchStart = t
	end
	v.catchUntil = t + CATCH_HOLD + 2 * myPing()
	v.catchFlight = v.flightId
	v.observer = nil
end

-- The claim was denied (or went to someone else): ease back onto the flight.
function DiscRenderer.cancelCatchPrediction(id: string)
	local v = visuals[id]
	if v then
		v.catchUntil = 0
	end
end

function DiscRenderer.Init(c: any)
	controllers = c
	local f = workspace:FindFirstChild("UBVisuals")
	if not f then
		local nf = Instance.new("Folder")
		nf.Name = "UBVisuals"
		nf.Parent = workspace
		f = nf
	end
	visualsFolder = f :: Folder
end

function DiscRenderer.Start()
	local discs = Net.discs()
	local function add(child: Instance)
		if child:IsA("Configuration") then
			-- attributes may arrive a frame after the instance
			task.defer(function()
				local id = child:GetAttribute("Id")
				if type(id) == "string" and not visuals[id] and child.Parent then
					visuals[id] = create(child)
				end
			end)
		end
	end
	discs.ChildAdded:Connect(add)
	discs.ChildRemoved:Connect(function(child)
		for id, v in visuals do
			if v.folder == child then
				destroy(v)
				visuals[id] = nil
			end
		end
	end)
	for _, c in discs:GetChildren() do
		add(c)
	end
	-- after PoseController (Character + 1) has posed the hands this frame
	RunService:BindToRenderStep("UBDiscs", Enum.RenderPriority.Character.Value + 2, function(dt)
		for _, v in visuals do
			local ok, err = pcall(function()
				render(v, dt)
			end)
			if not ok then
				warn("[DiscRenderer] " .. tostring(err))
			end
		end
	end)
	local _ = controllers
end

return DiscRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	EffectsController — feedback you can read at a glance.

	Every technique has its own colour and shape (Theme.TechColors) so
	experienced players recognise what an opponent just did; nothing hides the
	disc or the players. To keep the screen calm, only Clean and Perfect
	techniques get particles, and your own techniques make a sound only when
	it says something (Burst / Layout body sounds, Perfect stingers; the combo
	tick in the Hud covers the rest). There is no FOV pulse per technique: a
	Burst asks the camera for at most a 2 degree kick (CameraController caps
	kicks there anyway).

	Pivot readability. While you hold the disc: a team-coloured disc under your
	planted pivot foot (MovementController.pivot(), which follows the server's
	UBPivot), the step range around it (radius StepRadius over the front 270
	degrees, flattened where the lunge limit ForwardMax cuts it, turned with
	your aim) and a ghost of your free foot at P + step. Opponents who hold the
	disc show a small pivot dot (their UBPivot) so a marker can read the foot.

	Also: catch / block / bobble bursts (your own catch already played its
	sound and burst on the claim in CatchController, so the server's copy is
	skipped), goal confetti, crowd idle and cheering, wind flags, the moving
	training target, stadium scoreboards, cosmetic movement trails and
	end-zone glow.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local MovementConfig = require(Shared.Config.Movement)
local ProgressionConfig = require(Shared.Config.Progression)
local TeamsConfig = require(Shared.Config.Teams)
local Theme = require(script.Parent.Parent.UI.Theme)

local EffectsController = {}

local controllers: any
local player = Players.LocalPlayer
local fx: Folder

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function now(): number
	return Net.now()
end

local function anchorAt(pos: Vector3): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(pos)
	p.Parent = fx
	return p
end

function EffectsController.burst(
	pos: Vector3,
	color: Color3,
	count: number,
	speed: number,
	texture: string?,
	gravity: number?
)
	local holder = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture or SPARK
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.7
	e.Lifetime = NumberRange.new(0.25, 0.6)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Acceleration = Vector3.new(0, -(gravity or 0), 0)
	e.Rate = 0
	e.Parent = holder
	e:Emit(count)
	task.delay(1.5, function()
		holder:Destroy()
	end)
end

function EffectsController.dust(pos: Vector3, count: number)
	local holder = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SMOKE
	e.Color = ColorSequence.new(Color3.fromRGB(200, 190, 170))
	e.Lifetime = NumberRange.new(0.4, 0.8)
	e.Speed = NumberRange.new(3, 7)
	e.SpreadAngle = Vector2.new(70, 70)
	e.EmissionDirection = Enum.NormalId.Top
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.4) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	e.Rate = 0
	e.Parent = holder
	e:Emit(count)
	task.delay(1.5, function()
		holder:Destroy()
	end)
end

function EffectsController.ring(pos: Vector3, color: Color3, radius: number, duration: number, vertical: Vector3?)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.2
	p.Size = Vector3.new(0.12, 1, 1)
	local axis = vertical or Vector3.new(0, 1, 0)
	local ref = if math.abs(axis.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)
	p.CFrame = CFrame.fromMatrix(pos, axis.Unit, axis.Unit:Cross(ref).Unit)
	p.Parent = fx
	local tween = TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, radius * 2, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	task.delay(duration + 0.1, function()
		p:Destroy()
	end)
end

local function skid(pos: Vector3, dir: Vector3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Color = Color3.fromRGB(40, 32, 26)
	p.Transparency = 0.45
	p.Size = Vector3.new(0.9, 0.04, 3.2)
	p.CFrame = CFrame.lookAt(pos, pos + dir) + Vector3.new(0, 0.06, 0)
	p.Parent = fx
	TweenService:Create(p, TweenInfo.new(1.4), { Transparency = 1 }):Play()
	task.delay(1.5, function()
		p:Destroy()
	end)
end

-- short coloured streak on a character's root (per-technique colour)
local function streak(model: Model, color: Color3, duration: number)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local trail = root:FindFirstChild("UBTechTrail") :: Trail?
	if not trail then
		local a0 = Instance.new("Attachment")
		a0.Name = "UBTechA0"
		a0.Position = Vector3.new(0, 0.9, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "UBTechA1"
		a1.Position = Vector3.new(0, -1.4, 0)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Name = "UBTechTrail"
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.22
		t.LightEmission = 0.8
		t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		t.Enabled = false
		t.Parent = root
		trail = t
	end
	local tr = trail :: Trail
	tr.Color = ColorSequence.new(color)
	tr.Enabled = true
	local token = os.clock()
	tr:SetAttribute("Token", token)
	task.delay(duration, function()
		if tr.Parent and tr:GetAttribute("Token") == token then
			tr.Enabled = false
		end
	end)
end

-- Visual for a technique performed by `model` (local or remote). Sloppy and
-- Gassed techniques get none: the movement itself and the combo widget
-- already show them, and the effects stay meaningful.
function EffectsController.tech(model: Model, tech: string, quality: string, dir: Vector3)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	if quality ~= "Perfect" and quality ~= "Clean" then
		return
	end
	local color = (Theme.TechColors :: any)[tech] or Color3.new(1, 1, 1)
	local feet = root.Position - Vector3.new(0, 2.9, 0)
	local isLocal = model == player.Character
	local perfect = quality == "Perfect"
	if tech == "SnapCut" or tech == "SlideCut" then
		EffectsController.dust(feet, 6)
		streak(model, color, 0.25)
		if perfect then
			EffectsController.ring(feet + Vector3.new(0, 0.1, 0), color, 3, 0.25)
		end
	elseif tech == "MomentumCancel" then
		EffectsController.dust(feet, 12)
		skid(feet, dir)
	elseif tech == "BurstStep" then
		EffectsController.ring(feet + Vector3.new(0, 0.1, 0), color, 4.5, 0.3)
		streak(model, color, 0.35)
		if isLocal then
			controllers.CameraController.kick(2)
		end
	elseif tech == "Slide" then
		EffectsController.dust(feet, 12)
	elseif tech == "Dive" then
		streak(model, color, 0.45)
	elseif tech == "AirRedirect" then
		EffectsController.ring(root.Position, color, 3.2, 0.3, dir)
	elseif tech == "PrecisionLanding" then
		EffectsController.ring(feet + Vector3.new(0, 0.1, 0), if perfect then Theme.Colors.Perfect else color, 5, 0.35)
		EffectsController.dust(feet, 6)
	elseif tech == "WallRebound" then
		EffectsController.burst(root.Position - dir * 1.5, color, 16, 14)
	elseif tech == "RecoveryChain" then
		EffectsController.burst(feet + Vector3.new(0, 1, 0), color, 10, 8)
	elseif tech == "PivotSwing" then
		EffectsController.dust(feet + dir * 1.5, 3)
		if perfect then
			EffectsController.ring(feet + Vector3.new(0, 0.1, 0), color, 2.4, 0.2)
		end
	elseif tech == "Break" then
		EffectsController.burst(root.Position + Vector3.new(0, 1, 0), color, 14, 10)
	end
	-- (FakeCommit / "Lean" deliberately has no visual: a fake must look real)
	if isLocal then
		if tech == "BurstStep" or tech == "Dive" then
			controllers.AudioController.play("Burst", 0.1)
		elseif perfect and tech ~= "Jump" and tech ~= "FakeCommit" then
			controllers.AudioController.play("TechPerfect", 0.15)
		end
	end
end

---------------------------------------------------------------------------
-- remote technique watcher
---------------------------------------------------------------------------

local watched: { [Model]: RBXScriptConnection } = {}

local function watch(model: Model)
	if watched[model] or model == player.Character then
		return
	end
	watched[model] = model:GetAttributeChangedSignal("TechT"):Connect(function()
		local tech = model:GetAttribute("Tech")
		local q = model:GetAttribute("TechQ")
		local dir = model:GetAttribute("TechDir")
		if type(tech) == "string" and tech ~= "Lean" then
			EffectsController.tech(
				model,
				tech,
				if type(q) == "string" then q else "Clean",
				if typeof(dir) == "Vector3" then dir else Vector3.zero
			)
		end
	end)
end

---------------------------------------------------------------------------
-- crowd, flags, mover, trails, scoreboards
---------------------------------------------------------------------------

type Fan = { model: Model, parts: { BasePart }, base: { CFrame }, phase: number }
local fans: { Fan } = {}
local cheerUntil = 0
local flags: { { part: BasePart, base: CFrame, strength: number } } = {}

local function collectFans()
	fans = {}
	for _, m in CollectionService:GetTagged("UBCrowd") do
		if m:IsA("Model") then
			local parts: { BasePart } = {}
			local base: { CFrame } = {}
			for _, p in m:GetChildren() do
				if p:IsA("BasePart") then
					table.insert(parts, p)
					table.insert(base, p.CFrame)
				end
			end
			local ph = m:GetAttribute("Phase")
			table.insert(
				fans,
				{ model = m, parts = parts, base = base, phase = if type(ph) == "number" then ph else 0 }
			)
		end
	end
	flags = {}
	for _, f in CollectionService:GetTagged("UBFlag") do
		if f:IsA("BasePart") then
			local s = f:GetAttribute("Strength")
			table.insert(flags, { part = f, base = f.CFrame, strength = if type(s) == "number" then s else 2 })
		end
	end
end

function EffectsController.cheer(duration: number)
	cheerUntil = math.max(cheerUntil, os.clock() + duration)
	controllers.AudioController.play("CrowdCheer")
end

local lastCrowd = 0
local function animateCrowd()
	local clock = os.clock()
	if clock - lastCrowd < 0.05 then
		return
	end
	lastCrowd = clock
	local cheering = clock < cheerUntil
	local parts: { BasePart } = {}
	local cfs: { CFrame } = {}
	for _, fan in fans do
		if fan.model.Parent then
			local amp = if cheering then 0.9 else 0.12
			local freq = if cheering then 9 else 1.6
			local y = math.max(0, math.sin(clock * freq + fan.phase)) * amp
			for i, p in fan.parts do
				table.insert(parts, p)
				table.insert(cfs, fan.base[i] + Vector3.new(0, y, 0))
			end
		end
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for _, f in flags do
		if f.part.Parent then
			local wobble = math.sin(clock * (4 + f.strength) + f.base.Position.X) * 0.12 * math.min(f.strength, 6) / 3
			f.part.CFrame = f.base * CFrame.Angles(0, wobble, 0)
		end
	end
end

local function animateMovers()
	local t = now()
	for _, m in CollectionService:GetTagged("UBMover") do
		if m:IsA("BasePart") then
			local center = m:GetAttribute("Center")
			local amp = m:GetAttribute("Amplitude")
			local period = m:GetAttribute("Period")
			if typeof(center) == "Vector3" and type(amp) == "number" and type(period) == "number" then
				local pos = center + Vector3.new(math.sin(t * 2 * math.pi / period) * amp, 0, 0)
				m.CFrame = m.CFrame.Rotation + pos
			end
		end
	end
end

local TRAILS: { [string]: any } = {}
for _, t in ProgressionConfig.Trails do
	TRAILS[t.id] = t
end

local function cosmeticTrail(model: Model)
	local id = model:GetAttribute("UBTrail")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local trail = root:FindFirstChild("UBCosmeticTrail") :: Trail?
	local def = if type(id) == "string" then TRAILS[id] else nil
	if not def or not def.a then
		if trail then
			trail.Enabled = false
		end
		return
	end
	if not trail then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, -0.6, 0.4)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1.6, 0.4)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Name = "UBCosmeticTrail"
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.3
		t.LightEmission = 0.4
		t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
		t.Parent = root
		trail = t
	end
	local tr = trail :: Trail
	tr.Color = ColorSequence.new(def.a, def.b)
	local v = root.AssemblyLinearVelocity
	tr.Enabled = Vector3.new(v.X, 0, v.Z).Magnitude > 18
end

local lastBoard = 0
local function updateScoreboards()
	local clock = os.clock()
	if clock - lastBoard < 0.25 then
		return
	end
	lastBoard = clock
	local state = Net.state()
	local phase: string = (state:GetAttribute("Phase") or "") :: string
	local matchEnd = state:GetAttribute("MatchEnd")
	local remaining = if type(matchEnd) == "number" then matchEnd - now() else 0
	local phaseEnd = state:GetAttribute("PhaseEnd")
	local clockText = if phase == "Intermission"
			and type(phaseEnd) == "number"
			and phaseEnd > 0
		then Theme.formatTime(phaseEnd - now())
		else Theme.formatTime(remaining)
	for _, board in CollectionService:GetTagged("UBScoreboard") do
		local gui = board:FindFirstChild("Display")
		if gui then
			local function set(name: string, text: string)
				local l = gui:FindFirstChild(name)
				if l and l:IsA("TextLabel") then
					l.Text = text
				end
			end
			set("ScoreA", tostring(state:GetAttribute("ScoreA") or 0))
			set("ScoreB", tostring(state:GetAttribute("ScoreB") or 0))
			set("Clock", clockText)
			set(
				"Phase",
				string.upper(
					if phase == "PointOver" then "GOAL" elseif phase == "Intermission" then "WARMUP" else phase
				)
			)
			set(
				"Info",
				if state:GetAttribute("Universe")
					then "UNIVERSE POINT"
					else (state:GetAttribute("ModeName") or "") :: string
			)
		end
	end
	-- the end zone being attacked by your team pulses
	local myTeam = if player.Character then player.Character:GetAttribute("UBTeam") else nil
	for _, ez in CollectionService:GetTagged("UBEndZone") do
		if ez:IsA("BasePart") then
			local side = ez:GetAttribute("Side")
			local attacking = (myTeam == "A" and state:GetAttribute("AttackA") == side)
				or (myTeam == "B" and state:GetAttribute("AttackB") == side)
			ez.Transparency = if attacking and phase == "Live" then 0.78 + math.sin(clock * 3) * 0.05 else 0.86
		end
	end
end

---------------------------------------------------------------------------
-- pivot: your planted foot, step range and free foot; opponents' pivot dots
---------------------------------------------------------------------------

local HD = MovementConfig.Holding
local FLAT = CFrame.Angles(0, 0, math.pi / 2) -- a Cylinder part's axis is X: lay it on the ground
local GROUND_LIFT = 0.06
local ARC_SEGMENTS = 20
local ARC_HALF = math.rad(135) -- the step range is drawn over the front 270 degrees
local GHOST_MIN_STEP = 0.35 -- the free-foot ghost shows once the step is this long
local DOT_EVERY = 0.1

type PivotFx = {
	foot: BasePart,
	ghost: BasePart,
	arc: { BasePart },
	shown: boolean,
	color: Color3?,
}

local pivotFx: PivotFx? = nil
local arcLocal: { CFrame } = {}
local remoteDots: { [Model]: BasePart } = {}

local function flatDisc(name: string, diameter: number, color: Color3, transparency: number): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = transparency
	p.Size = Vector3.new(0.06, diameter, diameter)
	p.Parent = fx
	return p
end

-- Edge of the reachable step region at angle `a` from the aim (0 = forward,
-- + = right): the StepRadius circle cut by the lunge / drop-step limits.
local function stepEdge(a: number): Vector3
	local R = HD.StepRadius
	local fwd = math.cos(a)
	local d = R
	if fwd > 1e-3 then
		d = math.min(d, HD.ForwardMax * R / fwd)
	elseif fwd < -1e-3 then
		d = math.min(d, HD.BackMax * R / -fwd)
	end
	-- local frame: +X right, -Z forward (CFrame.Angles(0, yaw, 0) convention)
	return Vector3.new(math.sin(a) * d, 0, -fwd * d)
end

local function buildPivotFx(): PivotFx
	local arc: { BasePart } = {}
	table.clear(arcLocal)
	for i = 0, ARC_SEGMENTS - 1 do
		local a0 = -ARC_HALF + 2 * ARC_HALF * i / ARC_SEGMENTS
		local a1 = -ARC_HALF + 2 * ARC_HALF * (i + 1) / ARC_SEGMENTS
		local p0, p1 = stepEdge(a0), stepEdge(a1)
		local seg = Instance.new("Part")
		seg.Name = "UBStepArc"
		seg.Anchored = true
		seg.CanCollide = false
		seg.CanQuery = false
		seg.CanTouch = false
		seg.CastShadow = false
		seg.Material = Enum.Material.Neon
		seg.Transparency = 1
		seg.Size = Vector3.new(0.12, 0.04, (p1 - p0).Magnitude + 0.04)
		seg.Parent = fx
		table.insert(arc, seg)
		table.insert(arcLocal, CFrame.lookAt((p0 + p1) / 2, p1))
	end
	return {
		foot = flatDisc("UBPivotFoot", 1.1, Theme.Colors.Accent, 1),
		ghost = flatDisc("UBFreeFoot", 0.9, Color3.new(1, 1, 1), 1),
		arc = arc,
		shown = false,
		color = nil,
	}
end

local function setPivotShown(p: PivotFx, shown: boolean, ghost: boolean)
	p.ghost.Transparency = if shown and ghost then 0.5 else 1
	if p.shown == shown then
		return
	end
	p.shown = shown
	p.foot.Transparency = if shown then 0.15 else 1
	for _, seg in p.arc do
		seg.Transparency = if shown then 0.55 else 1
	end
end

local function standHeightOf(model: Model): number
	local h = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if h and root and h.RigType == Enum.HumanoidRigType.R15 then
		return h.HipHeight + root.Size.Y / 2
	end
	return 3
end

-- Every frame after the camera: your pivot foot, step range and free foot.
local function updateLocalPivot()
	local p = pivotFx
	if not p then
		return
	end
	local mc = controllers.MovementController
	local pivot: Vector3? = if mc.holdingDisc() then mc.pivot() else nil
	local character = player.Character
	if not pivot or not character or not mc.root() then
		setPivotShown(p, false, false)
		return
	end
	local team = character:GetAttribute("UBTeam")
	local color = Theme.teamColor(if type(team) == "string" then team else nil)
	if team ~= "A" and team ~= "B" then
		color = Theme.Colors.Accent
	end
	if p.color ~= color then
		p.color = color
		p.foot.Color = color
		local edge = color:Lerp(Color3.new(1, 1, 1), 0.35)
		for _, seg in p.arc do
			seg.Color = edge
		end
	end
	local base = Vector3.new(pivot.X, pivot.Y - mc.standHeight() + GROUND_LIFT, pivot.Z)
	local step: Vector3 = mc.step()
	local flatStep = Vector3.new(step.X, 0, step.Z)
	local showGhost = flatStep.Magnitude >= GHOST_MIN_STEP
	setPivotShown(p, true, showGhost)
	local parts: { BasePart } = { p.foot, p.ghost }
	local cfs: { CFrame } = {
		CFrame.new(base) * FLAT,
		CFrame.new(base + flatStep + Vector3.new(0, 0.01, 0)) * FLAT,
	}
	local frame = CFrame.new(base) * CFrame.Angles(0, controllers.CameraController.getYaw(), 0)
	for i, seg in p.arc do
		table.insert(parts, seg)
		table.insert(cfs, frame * arcLocal[i])
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

-- A small pivot dot under every opponent who holds the disc (their UBPivot).
local function updateRemoteDots()
	local mine = player.Character
	local myTeam = if mine then mine:GetAttribute("UBTeam") else nil
	local onTeam = myTeam == "A" or myTeam == "B"
	local seen: { [Model]: boolean } = {}
	for _, m in Actors.characters() do
		if m ~= mine then
			local pv = m:GetAttribute("UBPivot")
			local team = m:GetAttribute("UBTeam")
			if typeof(pv) == "Vector3" and (not onTeam or team ~= myTeam) then
				seen[m] = true
				local color = Theme.teamColor(if type(team) == "string" then team else nil)
				local dot = remoteDots[m]
				if not dot then
					dot = flatDisc("UBPivotDot", 0.8, color, 0.3)
					remoteDots[m] = dot
				end
				local d = dot :: BasePart
				d.Color = color
				d.CFrame = CFrame.new(pv.X, pv.Y - standHeightOf(m) + GROUND_LIFT, pv.Z) * FLAT
			end
		end
	end
	for m, dot in remoteDots do
		if not seen[m] then
			dot:Destroy()
			remoteDots[m] = nil
		end
	end
end

---------------------------------------------------------------------------

function EffectsController.Init(c: any)
	controllers = c
	local f = Instance.new("Folder")
	f.Name = "UBFx"
	f.Parent = workspace:WaitForChild("UBVisuals")
	fx = f
end

function EffectsController.Start()
	controllers.MovementController.Tech:Connect(function(e)
		local c = player.Character
		if c then
			EffectsController.tech(c, e.tech, e.quality, e.dir)
		end
	end)
	controllers.MovementController.Landed:Connect(function(fromDive, speed)
		local root = controllers.MovementController.root()
		if root then
			local feet = root.Position - Vector3.new(0, 2.9, 0)
			if fromDive then
				EffectsController.dust(feet, 22)
				controllers.CameraController.shake(0.12, 0.2)
				controllers.AudioController.play("Layout", 0.1)
			elseif speed > 8 then
				EffectsController.dust(feet, 5)
				controllers.AudioController.play("Land", 0.2)
			end
		end
	end)
	controllers.ThrowController.Released:Connect(function(launch)
		controllers.AudioController.play(if launch.quality == "Perfect" then "PerfectRelease" else "Throw", 0.08)
		if launch.quality == "Perfect" then
			EffectsController.burst(launch.releasePos, Theme.Colors.Perfect, 10, 10)
		end
	end)

	Net.event("Effect").OnClientEvent:Connect(function(kind, pos, actorId, quality, zone)
		if typeof(pos) ~= "Vector3" then
			return
		end
		local mine = actorId == player.UserId
		if kind == "Catch" then
			-- your own claim already played the sound and a burst (CatchController)
			if not (mine and controllers.CatchController.recentLocalCatch()) then
				local color = if quality == "Clean" then Theme.Colors.Clean else Theme.Colors.Gold
				EffectsController.burst(pos, color, if zone == "Dive" then 26 else 12, 10)
				controllers.AudioController.playAt(if quality == "Clean" then "CleanCatch" else "Catch", pos)
			end
			if mine and zone == "Dive" then
				controllers.CameraController.shake(0.15, 0.25)
			end
		elseif kind == "Block" or kind == "HandBlock" then
			EffectsController.burst(pos, Theme.Colors.Bad, 22, 16)
			controllers.AudioController.playAt("Block", pos)
			EffectsController.cheer(1.2)
		elseif kind == "Bobble" then
			EffectsController.burst(pos, Theme.Colors.Gold, 14, 9)
			controllers.AudioController.playAt("Bobble", pos)
		elseif kind == "TargetHit" then
			EffectsController.burst(pos, Theme.Colors.Good, 40, 18, nil, 20)
			EffectsController.ring(pos, Theme.Colors.Good, 6, 0.4, Vector3.new(0, 0, 1))
			controllers.AudioController.play("Highlight")
		end
	end)

	Net.event("Notify").OnClientEvent:Connect(function(kind, _text, data)
		if kind == "Goal" and type(data) == "table" then
			local team = data.team
			local color = if team == "A" then TeamsConfig.A.Color else TeamsConfig.B.Color
			local scorer = if type(data.scorer) == "number" then Actors.rootOf(data.scorer) else nil
			local pos = if scorer then scorer.Position else Vector3.zero
			for _ = 1, 3 do
				EffectsController.burst(
					pos + Vector3.new(math.random(-6, 6), 6, math.random(-6, 6)),
					color,
					40,
					22,
					nil,
					25
				)
			end
			EffectsController.cheer(3)
			controllers.AudioController.play("Goal")
		elseif kind == "Turnover" then
			controllers.AudioController.play("Turnover")
		end
	end)
	Net.event("Highlight").OnClientEvent:Connect(function(h)
		if type(h) ~= "table" then
			return
		end
		EffectsController.cheer(if (h.score or 0) > 700 then 2.5 else 1.4)
	end)

	local collectQueued = false
	local function queueCollect()
		if not collectQueued then
			collectQueued = true
			task.delay(0.5, function()
				collectQueued = false
				collectFans()
			end)
		end
	end
	CollectionService:GetInstanceAddedSignal("UBCrowd"):Connect(queueCollect)
	CollectionService:GetInstanceAddedSignal("UBFlag"):Connect(queueCollect)
	collectFans()

	pivotFx = buildPivotFx()
	-- after the camera (its yaw turns the step range) and the movement step
	RunService:BindToRenderStep("UBPivotFx", Enum.RenderPriority.Camera.Value + 6, updateLocalPivot)

	local lastScan = 0
	local lastDots = 0
	RunService.Heartbeat:Connect(function()
		animateCrowd()
		animateMovers()
		updateScoreboards()
		local clock = os.clock()
		if clock - lastDots >= DOT_EVERY then
			lastDots = clock
			updateRemoteDots()
		end
		if clock - lastScan > 0.5 then
			lastScan = clock
			for _, m in Actors.characters() do
				watch(m)
				cosmeticTrail(m)
			end
			for model, conn in watched do
				if not model.Parent then
					conn:Disconnect()
					watched[model] = nil
				end
			end
		end
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	InputController — one input vocabulary for keyboard/mouse, gamepad and
	touch. Raw inputs become named actions (Config/Input) that the movement,
	throw and catch controllers interpret in context. The same physical key
	may map to several actions; consumers decide which applies (while holding
	the disc MovementController turns Cut / Dive into the Quick Swing).

	Movement:
	  * WASD / arrows count only when they were pressed while no TextBox (chat
	    included) had focus, so typing never walks the character.
	  * Gamepad and touch sticks are reshaped (Config/Input Stick): below the
	    dead zone they read 0, from Full they read 1, linear in between, so small
	    tilts start at a crawl and pads that never report 1.0 still reach top
	    speed.
	Sprint (sprinting()):
	  * Shift (hold) sprints at once; ToggleSprint turns it into a toggle.
	  * AutoSprint (setting, default on): once the move input has stayed at
	    least 0.9 for 0.3 s inside a 35 degree cone, you sprint until the input
	    drops (dips shorter than Config/Input AutoSprint.Grace are forgiven).
	  * Touch keeps its SPRINT toggle and AutoSprintTouch (stick pushed fully).

	Roblox's default character controls are off: StarterPlayer uses the
	Scriptable movement modes and the ControlModule is disabled again on every
	input-type change (switching device would otherwise re-enable it and it
	would call Humanoid:Move against MovementController).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local InputConfig = require(Shared.Config.Input)

local InputController = {}

InputController.ActionBegan = Signal.new() -- (action, scheme)
InputController.ActionEnded = Signal.new() -- (action)
InputController.Wheel = Signal.new() -- (delta)
InputController.SchemeChanged = Signal.new() -- (scheme)

local controllers: any
local held: { [string]: boolean } = {}
local keyMap: { [string]: { string } } = {}
local menuOpen = false
local gamepadStick = Vector2.zero
local touchStick = Vector2.zero
local sprintToggle = false
local scheme = "KBM"
local controls: any = nil

-- movement keys pressed while not typing (cleared on release / focus loss)
local moveKeys: { [Enum.KeyCode]: boolean } = {}

local auto = {
	since = nil :: number?, -- the strong input started (charging)
	dir = Vector2.zero, -- direction the charge started in
	weakSince = nil :: number?, -- the input dropped below MinMagnitude
	active = false,
}

local MOVE_KEYS: { [Enum.KeyCode]: Vector2 } = {
	[Enum.KeyCode.W] = Vector2.new(0, 1),
	[Enum.KeyCode.Up] = Vector2.new(0, 1),
	[Enum.KeyCode.S] = Vector2.new(0, -1),
	[Enum.KeyCode.Down] = Vector2.new(0, -1),
	[Enum.KeyCode.A] = Vector2.new(-1, 0),
	[Enum.KeyCode.Left] = Vector2.new(-1, 0),
	[Enum.KeyCode.D] = Vector2.new(1, 0),
	[Enum.KeyCode.Right] = Vector2.new(1, 0),
}

local AUTO = InputConfig.AutoSprint
local AUTO_CONE = math.cos(math.rad(AUTO.MaxAngle))

local function rebuild()
	keyMap = {}
	for _, s in { "keyboard", "gamepad" } do
		local b = controllers.SettingsController.bindings(s)
		for action, keys in b do
			for _, k in keys do
				local list = keyMap[k]
				if not list then
					list = {}
					keyMap[k] = list
				end
				if not table.find(list, action) then
					table.insert(list, action)
				end
			end
		end
	end
end

local function inputName(input: InputObject): string
	local t = input.UserInputType
	if
		t == Enum.UserInputType.MouseButton1
		or t == Enum.UserInputType.MouseButton2
		or t == Enum.UserInputType.MouseButton3
	then
		return t.Name
	end
	return input.KeyCode.Name
end

local function setScheme(s: string)
	if s ~= scheme then
		scheme = s
		InputController.SchemeChanged:Fire(s)
	end
end

-- Dead zone + full-push rescale (keeps the direction).
local function shape(v: Vector2, dead: number, full: number): Vector2
	local m = v.Magnitude
	if m < dead or m < 1e-4 then
		return Vector2.zero
	end
	local r = if m >= full then 1 else (m - dead) / (full - dead)
	return v * (r / m)
end

function InputController.scheme(): string
	return scheme
end

-- Short label of the key bound to `action` for the current scheme ("Q",
-- "SHIFT", "X"); "" on touch or when nothing is bound. Follows rebinds.
function InputController.keyLabel(action: string): string
	if scheme == "Touch" then
		return ""
	end
	return controllers.SettingsController.keyLabel(action, if scheme == "Gamepad" then "gamepad" else "keyboard")
end

function InputController.fire(action: string, began: boolean)
	if began then
		if held[action] then
			return
		end
		held[action] = true
		if action == "Sprint" and controllers.SettingsController.get("ToggleSprint") then
			sprintToggle = not sprintToggle
		end
		InputController.ActionBegan:Fire(action, scheme)
	else
		if not held[action] then
			return
		end
		held[action] = nil
		InputController.ActionEnded:Fire(action)
	end
end

function InputController.isHeld(action: string): boolean
	return held[action] == true
end

-- Ends every held action; `forgetKeys` also drops the movement keys (typing,
-- focus loss). A menu keeps them: rawMove is zero while it is open and a key
-- released meanwhile is noticed by IsKeyDown.
local function releaseAll(forgetKeys: boolean)
	for action in table.clone(held) do
		InputController.fire(action, false)
	end
	if forgetKeys then
		table.clear(moveKeys)
	end
end

function InputController.setMenuOpen(open: boolean)
	menuOpen = open
	if open then
		releaseAll(false)
	end
end

function InputController.menuOpen(): boolean
	return menuOpen
end

-- Raw touch stick (x = right, y = forward, magnitude 0..1); shaped here.
function InputController.setTouchStick(v: Vector2)
	touchStick = shape(v, InputConfig.Stick.TouchDead, InputConfig.Stick.TouchFull)
end

function InputController.toggleTouchSprint()
	sprintToggle = not sprintToggle
end

local function typing(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

-- Raw 2D stick: x = right, y = forward. Magnitude 0..1.
function InputController.rawMove(): Vector2
	if menuOpen or typing() then
		return Vector2.zero
	end
	local kb = Vector2.zero
	for key, dir in MOVE_KEYS do
		if moveKeys[key] then
			if UserInputService:IsKeyDown(key) then
				kb += dir
			else
				moveKeys[key] = nil -- a release we never saw (focus loss)
			end
		end
	end
	if kb.Magnitude > 1 then
		kb = kb.Unit
	end
	local best = kb
	if gamepadStick.Magnitude > best.Magnitude then
		best = gamepadStick
	end
	if touchStick.Magnitude > best.Magnitude then
		best = touchStick
	end
	return best
end

-- Camera-relative horizontal world direction (magnitude 0..1).
function InputController.moveVector(): Vector3
	local raw = InputController.rawMove()
	if raw.Magnitude < 0.01 then
		return Vector3.zero
	end
	local yaw = controllers.CameraController.getYaw()
	local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	return forward * raw.Y + right * raw.X
end

-- AutoSprint state machine (time based, so calling it several times per
-- frame is harmless).
local function autoSprinting(): boolean
	local t = os.clock()
	local raw = InputController.rawMove()
	local m = raw.Magnitude
	if m >= AUTO.MinMagnitude then
		auto.weakSince = nil
		local d = raw / m
		local since = auto.since
		if auto.active then
			return true
		elseif since == nil or d:Dot(auto.dir) < AUTO_CONE then
			auto.since = t
			auto.dir = d
		elseif t - since >= AUTO.ChargeTime then
			auto.active = true
		end
	else
		local weak = auto.weakSince
		if weak == nil then
			auto.weakSince = t
		elseif t - weak > AUTO.Grace then
			auto.active = false
			auto.since = nil
		end
	end
	return auto.active
end

function InputController.sprinting(): boolean
	if menuOpen then
		return false
	end
	local settings = controllers.SettingsController
	local autoOn = autoSprinting() and settings.get("AutoSprint") == true
	if scheme == "Touch" then
		if settings.get("AutoSprintTouch") and touchStick.Magnitude > 0.85 then
			return true
		end
		return sprintToggle or autoOn
	end
	if settings.get("ToggleSprint") then
		return sprintToggle or autoOn
	end
	return held.Sprint == true or autoOn
end

local function disableDefaultControls()
	if controls then
		pcall(function()
			controls:Disable()
		end)
	end
end

function InputController.Init(c: any)
	controllers = c
end

function InputController.Start()
	-- take over character controls (Scriptable movement modes are set in the
	-- project; this is the backup, repeated whenever the input type changes)
	local player = Players.LocalPlayer
	task.spawn(function()
		local ok, PlayerModule = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		end)
		if ok and PlayerModule then
			local okControls, c = pcall(function()
				return PlayerModule:GetControls()
			end)
			if okControls then
				controls = c
				disableDefaultControls()
			end
		end
	end)
	UserInputService.LastInputTypeChanged:Connect(function()
		disableDefaultControls()
	end)
	GuiService.AutoSelectGuiEnabled = false

	rebuild()
	controllers.SettingsController.Changed:Connect(function(key)
		if key == "Bindings" or key == "All" then
			rebuild()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		local t = input.UserInputType
		if t == Enum.UserInputType.Gamepad1 then
			setScheme("Gamepad")
		elseif
			t == Enum.UserInputType.Keyboard
			or t == Enum.UserInputType.MouseButton1
			or t == Enum.UserInputType.MouseButton2
		then
			setScheme("KBM")
		elseif t == Enum.UserInputType.Touch then
			setScheme("Touch")
		end
		if gameProcessed or typing() then
			return
		end
		if t == Enum.UserInputType.Keyboard and MOVE_KEYS[input.KeyCode] then
			moveKeys[input.KeyCode] = true
		end
		local name = inputName(input)
		local actions = keyMap[name]
		if not actions then
			return
		end
		for _, action in actions do
			if action == "Menu" or action == "CameraLock" or not menuOpen then
				InputController.fire(action, true)
			end
		end
	end)

	-- releases are honoured even when the engine processed them (no stuck keys)
	UserInputService.InputEnded:Connect(function(input, _gameProcessed)
		if input.UserInputType == Enum.UserInputType.Keyboard then
			moveKeys[input.KeyCode] = nil
		end
		local actions = keyMap[inputName(input)]
		if actions then
			for _, action in actions do
				InputController.fire(action, false)
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			gamepadStick = shape(p, InputConfig.Stick.GamepadDead, InputConfig.Stick.GamepadFull)
			if gamepadStick.Magnitude > 0 then
				setScheme("Gamepad")
			end
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not gameProcessed and not menuOpen then
			InputController.Wheel:Fire(input.Position.Z)
		end
	end)

	-- typing (chat, menus) or leaving the window never leaves keys held
	UserInputService.TextBoxFocused:Connect(function()
		releaseAll(true)
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		releaseAll(true)
		gamepadStick = Vector2.zero
		touchStick = Vector2.zero
	end)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		setScheme("Touch")
	end
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MovementController — runs MovementSim for the local character.

	THE SIM DECIDES, THE HUMANOID MOVES. Each frame it builds an environment
	snapshot (grounded from Humanoid.FloorMaterial plus a ray sized from the
	current HipHeight, time-to-land, Rebound walls along / beside you, a short
	"blocked" ray along the sim velocity, root position and camera yaw), steps
	the sim and drives the body with the Humanoid's own controller:
	  * Humanoid.WalkSpeed = |v| and Humanoid:Move(v.Unit) every frame, so the
	    engine never brakes against us and steps, seams and slopes just work
	  * on impulse frames (technique starts, plant restarts, jumps ...) it also
	    writes AssemblyLinearVelocity so the change lands on the frame pressed
	  * jumps set JumpPower = vy + ChangeState(Jumping) + a direct Y write;
	    JumpPower goes back to 0 the next frame (no engine jumps otherwise)
	  * facing via AlignOrientation (AutoRotate off): camera forward while
	    holding / aiming / marking (snappy), travel direction otherwise
	    (smoother), the reach direction while reaching for the disc

	Holding the disc: the slow-down starts as soon as CatchController claims a
	catch (predicted; cancelled on Denied or when the server never confirms).
	While holding, Cut swings to the screen-left side, Dive to the right
	(gamepad X: the mirror of the current step), Jump hops. The sim plants the
	pivot foot and Output.pivotPos goes to the server (Pivot remote; proposed
	once more after the server confirms a predicted catch); the server's
	authoritative UBPivot attribute is adopted every frame.

	Server protocols handled here: teleports (UBTeleport counter with
	UBTeleportPos / Yaw / Face: the root is placed if it is still > 1 stud
	away, momentum reset but frozen / holding / exertion / pivot kept, camera
	yaw only when Face), lineups (UBLineX / UBLineSide: the body never crosses
	its own goal line, and eases back if it is beyond), UBFrozen.

	Technique events go to the server in one small batch per frame (only when
	something happened, each with its timestamp) and to the local effects /
	combo UI immediately. The replicated pose mode (UB_LocalMode locally, MS on
	the server) is MovementSim.poseMode: the sim mode, or Pivot / Mark.

	If the per-frame step ever errors, the body is stopped (no runaway
	character) and the error is reported once.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MovementSim = require(Shared.Movement.MovementSim)
local MovementConfig = require(Shared.Config.Movement)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local VecMath = require(Shared.Util.VecMath)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local MovementController = {}

MovementController.Tech = Signal.new() -- (event)
MovementController.Feedback = Signal.new() -- ({ kind, value?, text? })
MovementController.Landed = Signal.new() -- (fromDive: boolean, speed: number)
MovementController.ComboChanged = Signal.new() -- (chain total, last points, event)
MovementController.ChainEnded = Signal.new() -- (ComboEvaluator.Summary)

local controllers: any
local player = Players.LocalPlayer

local sim: MovementSim.State = MovementSim.new(0)
local character: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local ao: AlignOrientation? = nil
local aoAiming: boolean? = nil
local standHeight = 3
local holding = false
local confirmedHold = false -- the server has given us the disc (not just predicted)
local pivotResent = false -- re-proposed our pivot after the confirmation
local predicted: { disc: any, untilT: number }? = nil
local lastMode = ""
local modeDirty = false
local lastTeleport: any = nil
local pending: { any } = {}
local combo = ComboEvaluator.newTracker()
local lastFacing = Vector3.new(0, 0, -1)
local lastStep = Vector3.zero
local lastEnv: MovementSim.Env? = nil
local jumpPowerArmed = false
local errorReported = false
local filterAt = -math.huge

local techRemote: RemoteEvent? = nil
local pivotRemote: RemoteEvent? = nil

local MOVEMENT_ACTIONS = { Jump = true, Cut = true, Slide = true, Dive = true, Burst = true }
local WALL_RAY = MovementConfig.WallRebound.DetectDistance
local BLOCK_RAY = 2.5
local FILTER_REFRESH = 0.25

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function now(): number
	return Net.now()
end

---------------------------------------------------------------------------
-- public API
---------------------------------------------------------------------------

function MovementController.sim(): MovementSim.State
	return sim
end

-- The planted pivot foot P (nil when not holding / not yet planted).
function MovementController.pivot(): Vector3?
	return MovementSim.getPivot(sim)
end

-- The world flat step vector s of the free foot (zero when not holding).
function MovementController.step(): Vector3
	return lastStep
end

-- True while the movement side treats you as holding the disc (includes the
-- predicted catch before the server confirms it).
function MovementController.holdingDisc(): boolean
	return sim.holding
end

function MovementController.root(): BasePart?
	return root
end

function MovementController.standHeight(): number
	return standHeight
end

function MovementController.combo(): ComboEvaluator.Tracker
	return combo
end

function MovementController.isGrounded(): boolean
	return not MovementSim.isAirborne(sim)
end

function MovementController.isMarking(): boolean
	return MovementSim.isMarking(sim)
end

-- Mark shuffle on/off (CatchController). A Cut / Dive / Burst ends it inside
-- the sim; poll isMarking() for the live state.
function MovementController.setMarking(on: boolean)
	MovementSim.setMarking(sim, on)
end

local function refreshFilter(force: boolean?)
	local t = os.clock()
	if not force and t - filterAt < FILTER_REFRESH then
		return
	end
	filterAt = t
	local list: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	for _, name in { "UBBots", "UBVisuals" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

local function computeStandHeight(h: Humanoid, r: BasePart): number
	if h.RigType == Enum.HumanoidRigType.R15 then
		return h.HipHeight + r.Size.Y / 2
	end
	return 3
end

local function hitsSolid(origin: Vector3, dir: Vector3): boolean
	return workspace:Raycast(origin, dir, rayParams) ~= nil
end

local function buildEnv(): MovementSim.Env
	local r = root :: BasePart
	local h = humanoid :: Humanoid
	standHeight = computeStandHeight(h, r)
	local pos = r.Position
	local vel = r.AssemblyLinearVelocity

	-- grounded: the Humanoid's own floor detection, or a ray just past the feet
	local state = h:GetState()
	local humGrounded = h.FloorMaterial ~= Enum.Material.Air
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
	local grounded = humGrounded
	if not grounded and vel.Y <= 6 then
		grounded = workspace:Raycast(pos, Vector3.new(0, -(standHeight + 1.2), 0), rayParams) ~= nil
	end

	local ttl: number? = nil
	if not grounded then
		local far = workspace:Raycast(pos, Vector3.new(0, -120, 0), rayParams)
		if far then
			local height = math.max(0, pos.Y - standHeight - far.Position.Y)
			local g = workspace.Gravity
			ttl = (vel.Y + math.sqrt(math.max(vel.Y * vel.Y + 2 * g * height, 0))) / g
		end
	end

	-- Rebound walls: along travel, along the look, and to both sides
	local wallNormal: Vector3? = nil
	local wallDistance: number? = nil
	local wallId: string? = nil
	if not grounded then
		local travel = VecMath.flatUnit(vel)
		local side = Vector3.new(-travel.Z, 0, travel.X)
		for _, d in { travel, VecMath.flatUnit(r.CFrame.LookVector), side, -side } do
			if d.Magnitude > 0.5 then
				local w = workspace:Raycast(pos, d * WALL_RAY, rayParams)
				if w and CollectionService:HasTag(w.Instance, "Rebound") then
					wallNormal = VecMath.flatUnit(w.Normal)
					wallDistance = w.Distance
					wallId = w.Instance:GetFullName()
					break
				end
			end
		end
	end

	-- blocked: something solid right ahead along where the sim wants to go
	-- (root height and knee height, so low walls count too)
	local blocked = false
	local simVel = VecMath.flat(sim.vel)
	if simVel.Magnitude > 6 then
		local ahead = simVel.Unit * BLOCK_RAY
		blocked = hitsSolid(pos, ahead) or hitsSolid(pos - Vector3.new(0, standHeight * 0.6, 0), ahead)
	end

	local env: MovementSim.Env = {
		grounded = grounded,
		actualVel = vel,
		timeToLand = ttl,
		wallNormal = wallNormal,
		wallDistance = wallDistance,
		wallId = wallId,
		facing = r.CFrame.LookVector,
		pos = pos,
		aimYaw = controllers.CameraController.getYaw(),
		blocked = blocked,
	}
	lastEnv = env
	return env
end

local function currentInput(): MovementSim.Input
	return {
		move = controllers.InputController.moveVector(),
		sprint = controllers.InputController.sprinting(),
	}
end

local function queueEvent(e: MovementSim.TechEvent)
	table.insert(pending, { tech = e.tech, quality = e.quality, dir = e.dir, t = e.t, info = e.info })
	-- close a timed-out chain first so its end card is never swallowed
	local ended = ComboEvaluator.expire(combo, e.t)
	if ended then
		MovementController.ChainEnded:Fire(ended)
	end
	local points, total = ComboEvaluator.add(combo, e.tech, e.quality, e.t)
	MovementController.Tech:Fire(e)
	MovementController.ComboChanged:Fire(total, points, e)
end

-- Queues a technique that another controller detected (ThrowController's
-- "Break") through the normal pipeline: local combo + Tech remote.
function MovementController.addTech(tech: string, quality: string, dir: Vector3, info: string?)
	local t = now()
	queueEvent({
		tech = tech,
		quality = quality,
		t = t,
		dir = dir,
		chain = ComboEvaluator.active(combo, t) ~= nil,
		info = info,
	})
end

function MovementController.noteAerialReach(dir: Vector3)
	MovementSim.noteAerialReach(sim, dir)
end

local function freshEnv(): MovementSim.Env?
	if not root or not humanoid or not root.Parent then
		return nil
	end
	refreshFilter()
	return buildEnv()
end

-- Quick Swing while holding: -1 screen-left, +1 screen-right, 0 = mirror of
-- the current step. Returns MovementSim.swing's (ok, reason).
function MovementController.swing(side: number): (boolean, string?)
	local env = freshEnv()
	if not env then
		return false, "Context"
	end
	return MovementSim.swing(sim, side, env)
end

-- The fake's lunge toward `side` (-1 / 0 / +1); also opens the Sold window.
function MovementController.fakeStep(side: number)
	MovementSim.fakeStep(sim, side)
end

-- What each movement action would do right now ({ Cut = "SNAP CUT", ... }).
function MovementController.contextHint(): { [string]: string }
	local env = lastEnv
	if not env or not root then
		return {}
	end
	return MovementSim.contextHint(sim, currentInput(), env)
end

---------------------------------------------------------------------------
-- character setup
---------------------------------------------------------------------------

local function setupCharacter(c: Model)
	character = c
	humanoid = nil
	root = nil
	ao = nil
	local h = c:WaitForChild("Humanoid", 10) :: Humanoid?
	local r = c:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not h or not r or character ~= c then
		return
	end
	h.AutoRotate = false
	h.WalkSpeed = 0
	h.UseJumpPower = true
	h.JumpPower = 0
	-- states that would fight the movement engine
	for _, st in
		{
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.Seated,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.FallingDown,
		}
	do
		h:SetStateEnabled(st, false)
	end
	standHeight = computeStandHeight(h, r)

	local att = Instance.new("Attachment")
	att.Name = "UBMoveAttachment"
	att.Parent = r

	local align = Instance.new("AlignOrientation")
	align.Name = "UBFace"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.Responsiveness = 30
	align.MaxTorque = 1e7
	align.MaxAngularVelocity = 20
	align.CFrame = r.CFrame.Rotation
	align.Parent = r
	ao = align
	aoAiming = nil
	local look = VecMath.flatUnit(r.CFrame.LookVector)
	lastFacing = if look.Magnitude > 0.5 then look else Vector3.new(0, 0, -1)

	sim = MovementSim.new(now())
	holding = false
	confirmedHold = false
	pivotResent = false
	predicted = nil
	lastMode = ""
	lastStep = Vector3.zero
	lastEnv = nil
	jumpPowerArmed = false
	errorReported = false
	lastTeleport = c:GetAttribute("UBTeleport")
	refreshFilter(true)
	humanoid = h
	root = r
	h.Died:Connect(function()
		h:Move(Vector3.zero, false)
		h.WalkSpeed = 0
		align.Enabled = false
	end)
end

---------------------------------------------------------------------------
-- per-frame
---------------------------------------------------------------------------

-- Server teleport: UBTeleportPos / Yaw / Face are written before the counter.
local function handleTeleport(c: Model, r: BasePart)
	local pos = c:GetAttribute("UBTeleportPos")
	local yaw = c:GetAttribute("UBTeleportYaw")
	local face = c:GetAttribute("UBTeleportFace") == true
	if typeof(pos) == "Vector3" and (r.Position - pos).Magnitude > 1 then
		-- a facing teleport turns you; any other keeps the way you face now
		local rot = if face and type(yaw) == "number"
			then CFrame.Angles(0, yaw, 0)
			else CFrame.lookAt(Vector3.zero, lastFacing).Rotation
		r.CFrame = CFrame.new(pos) * rot
	end
	r.AssemblyLinearVelocity = Vector3.zero
	r.AssemblyAngularVelocity = Vector3.zero
	MovementSim.reset(sim) -- keeps frozen, holding, exertion, cooldowns and the pivot
	sim.pos = r.Position
	if face and type(yaw) == "number" then
		controllers.CameraController.setYaw(yaw)
		lastFacing = VecMath.fromYaw(yaw)
		local align = ao
		if align then
			align.CFrame = CFrame.lookAt(Vector3.zero, lastFacing)
		end
	end
end

-- Predicted catch (CatchController.Claimed) until the server confirms it;
-- Denied, or no confirmation in time, cancels it.
local function updateHolding(grounded: boolean)
	local confirmed = controllers.ThrowController.isHolding()
	local p = predicted
	if confirmed or (p and os.clock() > p.untilT) then
		predicted = nil
	end
	local want = confirmed or predicted ~= nil
	if want ~= holding then
		holding = want
		MovementSim.setHolding(sim, want, grounded)
		pivotResent = false
	end
	if confirmed ~= confirmedHold then
		confirmedHold = confirmed
		pivotResent = false
	end
end

-- The authoritative pivot: adopt UBPivot every frame; if the sim planted its
-- own foot while the catch was still only predicted (the server may have
-- ignored that proposal), propose it once more now that the disc is ours.
local function syncPivot(c: Model)
	local pv = c:GetAttribute("UBPivot")
	local server = if typeof(pv) == "Vector3" then pv else nil
	MovementSim.setPivot(sim, server)
	if server == nil and confirmedHold and not pivotResent then
		local own = MovementSim.getPivot(sim)
		local remote = pivotRemote
		if own and remote then
			pivotResent = true
			remote:FireServer(own)
		end
	end
end

-- Lineup restriction: (x - UBLineX) * UBLineSide >= 0. The approach slows
-- smoothly to the line; a body already beyond it eases back.
local function applyLine(c: Model, pos: Vector3, v: Vector3): Vector3
	local lx = c:GetAttribute("UBLineX")
	local ls = c:GetAttribute("UBLineSide")
	if type(lx) ~= "number" or type(ls) ~= "number" or ls == 0 then
		return v
	end
	local side = if ls > 0 then 1 else -1
	local inside = (pos.X - lx) * side -- studs on the allowed side
	local along = v.X * side -- + = away from the line
	if inside < 0 then
		local back = math.clamp(-inside * 6, 3, 14)
		return Vector3.new(side * math.max(back, along), 0, v.Z)
	end
	if along < 0 then
		local allowed = math.min(-along, inside * 10)
		return Vector3.new(-side * allowed, 0, v.Z)
	end
	return v
end

local function faceTarget(v: Vector3): (Vector3?, boolean)
	local catch = controllers.CatchController
	local aiming = sim.holding
		or controllers.ThrowController.isCharging()
		or MovementSim.isMarking(sim)
		or catch.isMarking()
	if aiming then
		return controllers.CameraController.forward(), true
	end
	if sim.mode == "Dive" or sim.mode == "DiveSlide" then
		return sim.diveDir, false
	end
	local travel = if v.Magnitude > 2 then VecMath.flatUnit(v) else nil
	if catch.reachActive() then
		local _, reachDir = catch.reachState()
		local r = VecMath.flatUnit(reachDir)
		if r.Magnitude > 0.5 then
			local blend = if travel then VecMath.flatUnit(r + travel) else r
			return if blend.Magnitude > 0.5 then blend else r, true
		end
	end
	return travel, false
end

local function drive(h: Humanoid, r: BasePart, out: MovementSim.Output, v: Vector3)
	local sp = v.Magnitude
	h.WalkSpeed = sp
	h:Move(if sp > 0.05 then v / sp else Vector3.zero, false)
	local vy = out.setVertical
	if out.jump and vy then
		h.JumpPower = vy
		h:ChangeState(Enum.HumanoidStateType.Jumping)
		jumpPowerArmed = true
	end
	if out.impulse or vy then
		local cur = r.AssemblyLinearVelocity
		r.AssemblyLinearVelocity = Vector3.new(v.X, vy or cur.Y, v.Z)
	end
end

local function flushTech(mode: string)
	local remote = techRemote
	if remote and (#pending > 0 or modeDirty) then
		remote:FireServer(pending, mode)
		pending = {}
		modeDirty = false
	elseif #pending > 64 then
		table.remove(pending, 1) -- remote not ready yet: keep the newest
	end
end

local function frame(dtRaw: number)
	local c, h, r = character, humanoid, root
	if not c or not h or not r or not r.Parent or h.Health <= 0 then
		return
	end
	local dt = math.min(dtRaw, 1 / 15)
	sim.now = now() - dt -- keep the sim clock on server time

	if jumpPowerArmed then
		jumpPowerArmed = false
		h.JumpPower = 0
	end

	local tp = c:GetAttribute("UBTeleport")
	if tp ~= lastTeleport then
		lastTeleport = tp
		handleTeleport(c, r)
	end
	local frozen = c:GetAttribute("UBFrozen") == true
	if frozen ~= sim.frozen then
		MovementSim.setFrozen(sim, frozen)
	end

	refreshFilter()
	local env = buildEnv()
	updateHolding(env.grounded)
	if sim.holding then
		syncPivot(c)
	end

	local out = MovementSim.step(sim, currentInput(), env, dt)
	lastStep = out.step

	local v = applyLine(c, r.Position, VecMath.flat(out.vel))
	if v ~= out.vel then
		sim.vel = v
		sim.lastOutVel = v
	end
	drive(h, r, out, v)

	-- facing
	local face, aiming = faceTarget(v)
	if face and face.Magnitude > 0.5 then
		lastFacing = face
	end
	local align = ao
	if align then
		if aiming ~= aoAiming then
			aoAiming = aiming
			align.Responsiveness = if aiming then 45 else 30
			align.MaxAngularVelocity = if aiming then 40 else 20
		end
		align.CFrame = CFrame.lookAt(Vector3.zero, lastFacing)
	end

	for _, e in out.events do
		queueEvent(e)
	end
	for _, fb in out.feedback do
		MovementController.Feedback:Fire(fb)
	end
	local pp = out.pivotPos
	local remote = pivotRemote
	if pp and remote then
		remote:FireServer(pp)
		pivotResent = confirmedHold
	end
	if out.landed then
		MovementController.Landed:Fire(sim.landedFromDive, sim.landingVel.Magnitude)
	end

	local mode = MovementSim.poseMode(sim)
	if mode ~= lastMode then
		lastMode = mode
		modeDirty = true
		c:SetAttribute("UB_LocalMode", mode)
	end
	flushTech(mode)

	local ended = ComboEvaluator.expire(combo, now())
	if ended then
		MovementController.ChainEnded:Fire(ended)
	end
end

-- Never leave the body running on an error: stop it and say so once.
local function guardedFrame(dt: number)
	local failure: string? = nil
	local ok = xpcall(function()
		frame(dt)
	end, function(e: any)
		failure = debug.traceback(tostring(e), 2)
	end)
	if ok then
		return
	end
	local h = humanoid
	if h then
		pcall(function()
			h:Move(Vector3.zero, false)
			h.WalkSpeed = 0
			h.JumpPower = 0
		end)
	end
	if not errorReported then
		errorReported = true
		warn("[MovementController] frame failed, movement stopped: " .. tostring(failure))
		MovementController.Feedback:Fire({ kind = "Error", text = "MOVEMENT ERROR — see the F9 console" })
	end
end

---------------------------------------------------------------------------
-- presses
---------------------------------------------------------------------------

local function onAction(action: string, scheme: string?)
	if not MOVEMENT_ACTIONS[action] or not root or not character then
		return
	end
	if controllers.InputController.menuOpen() then
		return
	end
	if sim.holding then
		-- with the disc: Q / E swing, Space hops, C is the low release (ThrowController)
		if action == "Cut" then
			local pad = (scheme or controllers.InputController.scheme()) == "Gamepad"
			MovementController.swing(if pad then 0 else -1)
		elseif action == "Dive" then
			MovementController.swing(1)
		elseif action == "Jump" then
			local env = freshEnv()
			if env then
				MovementSim.press(sim, "Jump", currentInput(), env)
			end
		end
		return
	end
	local env = freshEnv()
	if env then
		MovementSim.press(sim, action :: any, currentInput(), env)
	end
end

---------------------------------------------------------------------------
-- lifecycle
---------------------------------------------------------------------------

function MovementController.Init(c: any)
	controllers = c
end

function MovementController.Start()
	task.spawn(function()
		techRemote = Net.event("Tech")
	end)
	task.spawn(function()
		pivotRemote = Net.event("Pivot")
	end)

	controllers.InputController.ActionBegan:Connect(function(action, scheme)
		local ok, err = pcall(function()
			onAction(action, scheme)
		end)
		if not ok then
			warn("[MovementController] press failed: " .. tostring(err))
		end
	end)

	-- predicted hold: the slow-down starts with the claim, not a round trip later
	local catch = controllers.CatchController
	catch.Claimed:Connect(function(discId)
		if controllers.ThrowController.isHolding() then
			return
		end
		local okPing, ping = pcall(function()
			return player:GetNetworkPing()
		end)
		local rtt = if okPing and type(ping) == "number" then math.clamp(ping, 0, 0.5) else 0.2
		predicted = { disc = discId, untilT = os.clock() + 0.5 + 2 * rtt }
	end)
	local denied = catch.Denied
	if denied then
		denied:Connect(function(discId)
			local p = predicted
			if p and (discId == nil or p.disc == discId) then
				predicted = nil
			end
		end)
	else
		warn("[MovementController] CatchController.Denied missing; predicted holds expire on a timer")
	end

	player.CharacterAdded:Connect(setupCharacter)
	if player.Character then
		task.spawn(setupCharacter, player.Character)
	end
	RunService:BindToRenderStep("UBMovement", Enum.RenderPriority.Input.Value + 1, guardedFrame)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">PoseController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PoseController — procedural body language for every character.

	Base locomotion comes from animations (src/character/Animate, BotService).
	On top, each client offsets Motor6D.C0 of the root, waist, neck, shoulders
	and (R15) hips, knees and ankles so that what you see matches what the
	movement engine is doing: leaning into acceleration and turns, the dip of a
	Snap Cut, the sit-back of a Momentum Cancel, the forward sell of a Fake
	Commit or Burst, the feet-first Slide, the horizontal Layout, the pivot
	lunge while holding the disc, mark stances (wide-low or high hands) with a
	side-shuffle, the reach toward the disc, the throw windup / follow-through
	(identical for real throws and fakes) and celebrations. Heads track the
	disc.

	Feet stay on the ground: whenever the body is lowered the legs bend to
	absorb the drop. Running poses (animation owns the legs) bend hips, knees
	and ankles symmetrically by the angle that shortens the leg by exactly the
	drop; standing poses (pivot lunge, mark stance) solve a two-bone IK per leg
	to a foot target on the ground (for the holder the pivot foot toward P and
	the stepping foot toward P + step, as far as the leg reaches; the stepping
	leg is the one on the step's side so legs never cross). R6 rigs, which have
	no knees, are not lowered.

	Leans come from clean signals: the local character's sim acceleration, and
	for everyone else a velocity measured from replicated positions over
	~0.1 s, low-passed before it is differentiated (roll clamped to 0.18 rad),
	so network jitter never shakes a torso. Speed scales come from
	Config/Movement.

	The rest pose of every joint is cached per Motor6D the first time it is
	seen and only re-read when something other than this controller rewrites
	C0 (avatar scaling), so a rebuilt rig never bakes in an old offset; on an
	error the joints are restored before the rig is dropped.

	C0 edits are local to each client and never replicate, so every client
	poses every character from replicated attributes (the local character from
	its own controllers, with zero latency).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Actors = require(Shared.Actors)
local Net = require(Shared.Net)
local MovementConfig = require(Shared.Config.Movement)

local PoseController = {}

local controllers: any
local player = Players.LocalPlayer

local HD = MovementConfig.Holding
local SPRINT = MovementConfig.SprintSpeed

type Joint = { motor: Motor6D, current: CFrame }

type Leg = {
	hip: Joint,
	knee: Joint,
	ankle: Joint?,
	side: number, -- -1 left, +1 right
	thigh: number, -- hip -> knee length
	shin: number, -- knee -> ankle length
	ankleHeight: number, -- ankle joint above the sole
	hipPos: Vector3, -- hip joint in LowerTorso space
	thighRest: Vector3, -- thigh direction in LowerTorso space at rest
	shinRest: Vector3, -- shin direction in UpperLeg space at rest
	hipRestRot: CFrame, -- UpperLeg rotation relative to LowerTorso at rest
	kneeRestRot: CFrame, -- LowerLeg rotation relative to UpperLeg at rest
	restFoot: Vector3, -- sole under the ankle at rest, HRP space
	foot: Vector3?, -- smoothed foot target (stance poses), HRP space
}

type Rig = {
	model: Model,
	root: BasePart,
	humanoid: Humanoid,
	joints: { [string]: Joint }, -- Root, Waist, Neck, RShoulder, LShoulder
	legs: { Leg }, -- empty for R6
	rootC1: CFrame,
	isLocal: boolean,
	r15: boolean,
	-- smoothed body parameters
	drop: number,
	pitch: number,
	roll: number,
	-- lean signal
	lastVel: Vector3,
	accel: Vector3,
	history: { { t: number, p: Vector3 } },
	smoothVel: Vector3,
	shufflePhase: number,
	freeSide: number, -- the leg that steps out in the pivot lunge (-1 left, +1 right)
	legMode: string, -- last Pose.legs (a change blends the legs briefly)
	legSwitchAt: number,
	seenAt: number,
}

local rigs: { [Model]: Rig } = {}
local firstSeen: { [Model]: number } = {}
local warned: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local localTech = { name = "", t = -math.huge, dir = Vector3.zero }

-- Rest C0 per motor, and what we last wrote (to tell our offsets from a
-- genuine new rest pose written by avatar scaling).
type BaseEntry = { base: CFrame, written: CFrame? }
local bases: { [Motor6D]: BaseEntry } = setmetatable({}, { __mode = "k" }) :: any

local R15_UPPER = {
	Root = { "LowerTorso", "Root" },
	Waist = { "UpperTorso", "Waist" },
	Neck = { "Head", "Neck" },
	RShoulder = { "RightUpperArm", "RightShoulder" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" },
}

local R15_LEGS = {
	{ side = -1, prefix = "Left" },
	{ side = 1, prefix = "Right" },
}

local R6_JOINTS = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	RShoulder = { "Torso", "Right Shoulder" },
	LShoulder = { "Torso", "Left Shoulder" },
}

local IDENTITY = CFrame.identity
local DOWN = Vector3.new(0, -1, 0)
local LEG_RATE = 26 -- blend speed when the legs switch between pose kinds
local LEG_BLEND_TIME = 0.2
local SHUFFLE_AMPLITUDE = 0.45
local SHUFFLE_LIFT = 0.3

local function now(): number
	return Net.now()
end

local function near(a: CFrame, b: CFrame): boolean
	return (a.Position - b.Position).Magnitude < 1e-3
		and a.LookVector:Dot(b.LookVector) > 0.9999
		and a.UpVector:Dot(b.UpVector) > 0.9999
end

-- The rest C0 of a motor. Re-captured only when C0 is not what we wrote.
local function baseOf(motor: Motor6D): CFrame
	local e = bases[motor]
	local c0 = motor.C0
	if e == nil then
		e = { base = c0, written = nil }
		bases[motor] = e
	elseif e.written == nil or not near(c0, e.written :: CFrame) then
		e.base = c0
		e.written = nil
	end
	return (e :: BaseEntry).base
end

-- true when someone else rewrote this joint since our last write
local function externallyChanged(motor: Motor6D): boolean
	local e = bases[motor]
	return e ~= nil and e.written ~= nil and not near(motor.C0, e.written :: CFrame)
end

local function write(joint: Joint)
	local e = bases[joint.motor]
	if not e then
		return
	end
	local base = e.base
	local c0 = CFrame.new(base.Position) * joint.current * base.Rotation
	joint.motor.C0 = c0
	e.written = c0
end

local function restoreRig(rig: Rig)
	local all: { Joint } = {}
	for _, j in rig.joints do
		table.insert(all, j)
	end
	for _, leg in rig.legs do
		table.insert(all, leg.hip)
		table.insert(all, leg.knee)
		if leg.ankle then
			table.insert(all, leg.ankle)
		end
	end
	for _, j in all do
		local e = bases[j.motor]
		if e and j.motor.Parent then
			j.motor.C0 = e.base
			e.written = e.base
		end
	end
end

local function motorAt(model: Model, part: string, name: string): Motor6D?
	local p = model:FindFirstChild(part)
	local m = p and p:FindFirstChild(name)
	if m and m:IsA("Motor6D") then
		return m
	end
	return nil
end

local function buildLeg(model: Model, side: number, prefix: string, ltRest: CFrame): Leg?
	local hip = motorAt(model, prefix .. "UpperLeg", prefix .. "Hip")
	local knee = motorAt(model, prefix .. "LowerLeg", prefix .. "Knee")
	if not hip or not knee then
		return nil
	end
	local ankle = motorAt(model, prefix .. "Foot", prefix .. "Ankle")
	local hipBase, kneeBase = baseOf(hip), baseOf(knee)
	local thighVec = kneeBase.Position - hip.C1.Position -- UpperLeg space
	local shinVec: Vector3
	local ankleHeight = 0.2
	if ankle then
		local ankleBase = baseOf(ankle)
		shinVec = ankleBase.Position - knee.C1.Position -- LowerLeg space
		local foot = model:FindFirstChild(prefix .. "Foot")
		if foot and foot:IsA("BasePart") then
			ankleHeight = math.max(0.05, ankle.C1.Position.Y + foot.Size.Y / 2)
		end
	else
		local lower = model:FindFirstChild(prefix .. "LowerLeg")
		local h = if lower and lower:IsA("BasePart") then lower.Size.Y else 1.2
		shinVec = Vector3.new(0, -h, 0)
	end
	local a, b = thighVec.Magnitude, shinVec.Magnitude
	if a < 0.1 or b < 0.1 then
		return nil
	end
	local hipRestRot = (hipBase * hip.C1:Inverse()).Rotation
	local kneeRestRot = (kneeBase * knee.C1:Inverse()).Rotation
	local thighRest = hipRestRot:VectorToWorldSpace(thighVec.Unit)
	local shinRest = kneeRestRot:VectorToWorldSpace(shinVec.Unit)
	-- rest foot (sole under the ankle) in HRP space
	local hipHrp = ltRest:PointToWorldSpace(hipBase.Position)
	local kneeHrp = hipHrp + ltRest:VectorToWorldSpace(thighRest) * a
	local shinHrp = (ltRest.Rotation * hipRestRot):VectorToWorldSpace(shinRest)
	local ankleHrp = kneeHrp + shinHrp * b
	return {
		hip = { motor = hip, current = IDENTITY },
		knee = { motor = knee, current = IDENTITY },
		ankle = if ankle then { motor = ankle, current = IDENTITY } else nil,
		side = side,
		thigh = a,
		shin = b,
		ankleHeight = ankleHeight,
		hipPos = hipBase.Position,
		thighRest = thighRest,
		shinRest = shinRest,
		hipRestRot = hipRestRot,
		kneeRestRot = kneeRestRot,
		restFoot = ankleHrp - Vector3.new(0, ankleHeight, 0),
		foot = nil,
	}
end

local function buildRig(model: Model): Rig?
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return nil
	end
	local r15 = humanoid.RigType == Enum.HumanoidRigType.R15
	local map: { [string]: { string } } = if r15 then R15_UPPER else R6_JOINTS
	local joints: { [string]: Joint } = {}
	for key, path in map do
		local motor = motorAt(model, path[1], path[2])
		if motor then
			baseOf(motor)
			joints[key] = { motor = motor, current = IDENTITY }
		end
	end
	local rootJoint = joints.Root
	if not rootJoint then
		return nil
	end
	local legs: { Leg } = {}
	local rootC1 = rootJoint.motor.C1
	if r15 then
		local ltRest = baseOf(rootJoint.motor) * rootC1:Inverse()
		for _, def in R15_LEGS do
			local leg = buildLeg(model, def.side, def.prefix, ltRest)
			if leg then
				table.insert(legs, leg)
			end
		end
		if #legs ~= 2 then
			legs = {}
		end
	end
	local vel = root.AssemblyLinearVelocity
	return {
		model = model,
		root = root,
		humanoid = humanoid,
		joints = joints,
		legs = legs,
		rootC1 = rootC1,
		isLocal = model == player.Character,
		r15 = r15,
		drop = 0,
		pitch = 0,
		roll = 0,
		lastVel = vel,
		accel = Vector3.zero,
		history = {},
		smoothVel = Vector3.new(vel.X, 0, vel.Z),
		shufflePhase = 0,
		freeSide = 1,
		legMode = "free",
		legSwitchAt = -math.huge,
		seenAt = os.clock(),
	}
end

-- rotation taking unit vector a onto unit vector b
local function arc(a: Vector3, b: Vector3): CFrame
	local d = math.clamp(a:Dot(b), -1, 1)
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-6 then
		if d > 0 then
			return IDENTITY
		end
		local perp = if math.abs(a.X) < 0.9 then Vector3.xAxis:Cross(a) else Vector3.yAxis:Cross(a)
		return CFrame.fromAxisAngle(perp.Unit, math.pi)
	end
	return CFrame.fromAxisAngle(axis.Unit, math.acos(d))
end

-- rotation taking the hanging arm (0,-1,0) to point along local direction d
local function aimArm(d: Vector3): CFrame
	local dir = if d.Magnitude > 0.01 then d.Unit else DOWN
	return arc(DOWN, dir)
end

local function attrNumber(model: Model, key: string): number
	local v = model:GetAttribute(key)
	return if type(v) == "number" then v else -math.huge
end

type Ctx = {
	mode: string,
	grounded: boolean,
	speed: number,
	fwdAccel: number,
	latAccel: number,
	rollLimit: number,
	leanLimit: number,
	localVel: Vector3, -- body-space horizontal velocity
	tech: string,
	techAge: number,
	techDir: Vector3, -- local space
	reachAge: number,
	reachDir: Vector3, -- local space
	windup: boolean,
	windupType: string,
	fakeAge: number,
	releaseAge: number,
	releaseType: string,
	mark: string,
	holding: boolean,
	step: Vector3, -- body-space step of the free foot (zero unless pivoting)
	celebrate: string,
	celebrateAge: number,
	leftHanded: boolean,
	lookAt: Vector3?, -- local space
}

local GROUNDED_MODES: { [string]: boolean } = {
	Ground = true,
	Landing = true,
	Pivot = true,
	Mark = true,
	Recover = true,
	Frozen = true,
}

local function toLocal(root: BasePart, v: Vector3): Vector3
	return root.CFrame:VectorToObjectSpace(v)
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Remote characters: velocity from replicated positions over ~0.1 s, low-passed.
local function remoteVelocity(rig: Rig, dt: number): Vector3
	local t = os.clock()
	local h = rig.history
	table.insert(h, { t = t, p = rig.root.Position })
	while #h > 2 and t - h[2].t >= 0.1 do
		table.remove(h, 1)
	end
	local oldest = h[1]
	local span = t - oldest.t
	local raw = if span > 1e-3 then flat(rig.root.Position - oldest.p) / span else rig.smoothVel
	if raw.Magnitude > MovementConfig.HardCap * 1.5 then
		raw = rig.smoothVel -- a teleport, not running
	end
	rig.smoothVel = rig.smoothVel:Lerp(raw, 1 - math.exp(-8 * dt))
	return rig.smoothVel
end

local function gather(rig: Rig, dt: number): Ctx
	local m = rig.model
	local root = rig.root
	local t = now()

	local ctx: Ctx = {
		mode = "Ground",
		grounded = true,
		speed = 0,
		fwdAccel = 0,
		latAccel = 0,
		rollLimit = 0.32,
		leanLimit = 0.22,
		localVel = Vector3.zero,
		tech = "",
		techAge = math.huge,
		techDir = Vector3.zero,
		reachAge = math.huge,
		reachDir = Vector3.new(0, 0, -1),
		windup = false,
		windupType = "Backhand",
		fakeAge = math.huge,
		releaseAge = math.huge,
		releaseType = "Backhand",
		mark = "",
		holding = m:GetAttribute("HasDisc") == true,
		step = Vector3.zero,
		celebrate = "",
		celebrateAge = math.huge,
		leftHanded = m:GetAttribute("LeftHanded") == true,
		lookAt = nil,
	}

	local vel: Vector3
	if rig.isLocal then
		local mc = controllers.MovementController
		local sim = mc.sim()
		vel = flat(sim.vel)
		local raw = (vel - rig.lastVel) / math.max(dt, 1 / 240)
		rig.lastVel = vel
		if raw.Magnitude > 400 then
			raw = raw.Unit * 400
		end
		rig.accel = rig.accel:Lerp(raw, 1 - math.exp(-10 * dt))
		local lm = m:GetAttribute("UB_LocalMode")
		ctx.mode = if type(lm) == "string" and lm ~= "" then lm else sim.mode
		ctx.tech = localTech.name
		ctx.techAge = t - localTech.t
		ctx.techDir = toLocal(root, localTech.dir)
		local reachAt, reachDir = controllers.CatchController.reachState()
		ctx.reachAge = t - reachAt
		ctx.reachDir = toLocal(root, reachDir)
		ctx.windup = controllers.ThrowController.isCharging()
		ctx.windupType = controllers.ThrowController.hud().throwType
		ctx.fakeAge = t - attrNumber(m, "UB_LocalFake")
		ctx.releaseAge = t - attrNumber(m, "UB_LocalRelease")
		ctx.releaseType = ctx.windupType
		ctx.mark = if controllers.CatchController.isMarking() then controllers.CatchController.markStance() else ""
		ctx.holding = controllers.ThrowController.isHolding() or mc.holdingDisc()
		if ctx.mode == "Pivot" then
			ctx.step = toLocal(root, mc.step())
		end
	else
		vel = remoteVelocity(rig, dt)
		local raw = (vel - rig.lastVel) / math.max(dt, 1 / 240)
		rig.lastVel = vel
		if raw.Magnitude > 150 then
			raw = raw.Unit * 150
		end
		rig.accel = rig.accel:Lerp(raw, 1 - math.exp(-4 * dt))
		ctx.rollLimit = 0.18
		ctx.leanLimit = 0.12
		local ms = m:GetAttribute("MS")
		ctx.mode = if type(ms) == "string" then ms else "Ground"
		local tech = m:GetAttribute("Tech")
		ctx.tech = if type(tech) == "string" then tech else ""
		ctx.techAge = t - attrNumber(m, "TechT")
		local td = m:GetAttribute("TechDir")
		ctx.techDir = if typeof(td) == "Vector3" then toLocal(root, td) else Vector3.zero
		ctx.reachAge = t - attrNumber(m, "Reach")
		local rd = m:GetAttribute("ReachDir")
		ctx.reachDir = if typeof(rd) == "Vector3" then toLocal(root, rd) else Vector3.new(0, 0, -1)
		local windupT = attrNumber(m, "Windup")
		local releaseT = attrNumber(m, "Release")
		local fakeT = attrNumber(m, "Fake")
		ctx.windup = ctx.holding and windupT > releaseT and windupT > fakeT and t - windupT < 3
		local wt = m:GetAttribute("WindupType")
		ctx.windupType = if type(wt) == "string" then wt else "Backhand"
		ctx.fakeAge = t - fakeT
		ctx.releaseAge = t - releaseT
		local rt = m:GetAttribute("ReleaseType")
		ctx.releaseType = if type(rt) == "string" then rt else "Backhand"
		local mark = m:GetAttribute("Mark")
		ctx.mark = if type(mark) == "string" then mark else ""
		local pv = m:GetAttribute("UBPivot")
		if ctx.mode == "Pivot" and typeof(pv) == "Vector3" then
			local s = flat(root.Position - pv) / HD.BodyShare
			if s.Magnitude > HD.StepRadius then
				s = s.Unit * HD.StepRadius
			end
			ctx.step = toLocal(root, s)
		end
	end
	ctx.grounded = GROUNDED_MODES[ctx.mode] == true
	ctx.speed = vel.Magnitude
	local localVel = toLocal(root, vel)
	ctx.localVel = Vector3.new(localVel.X, 0, localVel.Z)
	local localAccel = toLocal(root, rig.accel)
	ctx.fwdAccel = -localAccel.Z
	ctx.latAccel = localAccel.X

	local cel = m:GetAttribute("Celebrate")
	ctx.celebrate = if type(cel) == "string" then cel else ""
	ctx.celebrateAge = t - attrNumber(m, "CelebrateT")

	-- heads follow the nearest flying disc
	local head = root.Position + Vector3.new(0, 2.5, 0)
	local best, bestD = nil, 120
	for _, f in controllers.DiscRenderer.folders() do
		if f:GetAttribute("Mode") == "Flight" then
			local p = controllers.DiscRenderer.positionOf(f:GetAttribute("Id"))
			if p then
				local d = (p - head).Magnitude
				if d < bestD then
					best, bestD = p, d
				end
			end
		end
	end
	if best then
		ctx.lookAt = toLocal(root, (best :: Vector3) - head)
	end
	return ctx
end

-- legs: "free" = animation owns the legs, bend to absorb the drop;
-- "stance" = IK feet on the ground; "slide" = feet-first slide; "none".
type Pose = {
	drop: number,
	pitch: number,
	roll: number,
	yaw: number, -- applied unsmoothed (spins)
	legs: string,
	stance: string, -- "lunge" | "wide" | "high" (with legs == "stance")
	step: Vector3, -- body-space step for the lunge
	Waist: CFrame,
	Neck: CFrame,
	RShoulder: CFrame,
	LShoulder: CFrame,
	rate: number,
}

local function windupArm(kind: string): CFrame
	if kind == "Forehand" then
		return CFrame.Angles(0.35, 0, 1.25)
	elseif kind == "Hammer" or kind == "Scoober" then
		return CFrame.Angles(2.9, 0, 0.25)
	end
	return CFrame.Angles(1.3, 0, -1.0) -- backhand: arm across the body
end

local function windupWaist(kind: string): CFrame
	if kind == "Forehand" then
		return CFrame.Angles(0, -0.55, 0)
	elseif kind == "Hammer" or kind == "Scoober" then
		return CFrame.Angles(0.3, 0, 0)
	end
	return CFrame.Angles(0, 0.75, 0)
end

local function compute(ctx: Ctx): Pose
	local pose: Pose = {
		drop = 0,
		pitch = 0,
		roll = 0,
		yaw = 0,
		legs = "free",
		stance = "",
		step = Vector3.zero,
		Waist = IDENTITY,
		Neck = IDENTITY,
		RShoulder = IDENTITY,
		LShoulder = IDENTITY,
		rate = 12,
	}
	-- base lean from speed, acceleration and turning
	pose.pitch = -math.clamp(ctx.speed / SPRINT, 0, 1) * 0.12
		- math.clamp(ctx.fwdAccel / 90, -ctx.leanLimit * 0.7, ctx.leanLimit)
	pose.roll = -math.clamp(ctx.latAccel / 130, -ctx.rollLimit, ctx.rollLimit)

	local age = ctx.techAge
	local tech = ctx.tech
	local dx = ctx.techDir.X
	if tech == "SnapCut" and age < 0.22 then
		pose.drop, pose.pitch, pose.roll = 0.3, pose.pitch - 0.1, -math.sign(dx) * 0.45
		pose.rate = 26
	elseif tech == "SlideCut" and age < 0.22 then
		pose.drop, pose.pitch, pose.roll = 0.5, -0.2, -math.sign(dx) * 0.5
		pose.rate = 26
	elseif tech == "MomentumCancel" and age < 0.3 then
		pose.drop, pose.pitch, pose.roll = 0.6, 0.38, 0
		pose.rate = 26
	elseif (tech == "Lean" or tech == "FakeCommit" or tech == "BurstStep") and age < 0.25 then
		pose.drop, pose.pitch, pose.roll = 0.2, -0.45, -math.clamp(dx, -1, 1) * 0.3
		pose.rate = 28
	elseif tech == "AirRedirect" and age < 0.3 then
		pose.pitch, pose.roll = -0.2, -math.sign(dx) * 0.4
		pose.rate = 22
	elseif tech == "PrecisionLanding" and age < 0.16 then
		pose.drop, pose.pitch = 0.8, -0.15
		pose.rate = 30
	elseif tech == "WallRebound" and age < 0.3 then
		pose.pitch, pose.roll = 0.2, -math.sign(dx) * 0.5
		pose.rate = 24
	end

	local mode = ctx.mode
	local airUp = false
	if mode == "Slide" then
		pose.drop, pose.pitch, pose.roll = 1.7, 0.95, 0
		pose.legs = "slide"
		pose.LShoulder = CFrame.Angles(0.9, 0, -0.7)
		pose.rate = 20
	elseif mode == "Dive" then
		pose.drop, pose.pitch, pose.roll = 0.5, -1.35, 0
		pose.legs = "none"
		pose.RShoulder = CFrame.Angles(2.95, 0, 0.12)
		pose.LShoulder = CFrame.Angles(2.95, 0, -0.12)
		pose.rate = 18
	elseif mode == "DiveSlide" then
		pose.drop, pose.pitch, pose.roll = 2.1, -1.47, 0
		pose.legs = "none"
		pose.RShoulder = CFrame.Angles(2.95, 0, 0.12)
		pose.LShoulder = CFrame.Angles(2.95, 0, -0.12)
		pose.rate = 22
	elseif mode == "Recover" then
		pose.drop, pose.pitch, pose.roll = 1.2, -0.6, 0
		pose.rate = 16
	elseif mode == "Air" then
		airUp = true
	elseif mode == "Pivot" then
		-- the lunge: lower and lean into the step, feet at P and P + step
		local s = ctx.step
		local R = HD.StepRadius
		local reach = math.clamp(s.Magnitude / R, 0, 1)
		pose.drop = 0.2 + 0.5 * reach
		pose.pitch = -0.18 * math.clamp(-s.Z / R, 0, 1) + 0.08 * math.clamp(s.Z / R, 0, 1)
		pose.roll = -math.clamp(s.X / R, -1, 1) * 0.3
		pose.legs = "stance"
		pose.stance = "lunge"
		pose.step = s
		pose.rate = 22
	end

	-- mark stance (on the ground)
	if ctx.mark == "Low" and ctx.grounded then
		pose.drop, pose.pitch = 0.55, -0.25
		pose.legs = "stance"
		pose.stance = "wide"
		pose.RShoulder = CFrame.Angles(0.1, 0, 1.4)
		pose.LShoulder = CFrame.Angles(0.1, 0, -1.4)
		pose.rate = 18
	elseif ctx.mark == "High" then
		if ctx.grounded then
			pose.drop, pose.pitch = 0.2, -0.05
			pose.legs = "stance"
			pose.stance = "high"
		end
		pose.RShoulder = CFrame.Angles(2.85, 0, 0.25)
		pose.LShoulder = CFrame.Angles(2.85, 0, -0.25)
		pose.rate = 18
	elseif mode == "Mark" then
		-- shuffling without a stance yet: athletic stance, the feet still step
		pose.drop, pose.pitch = 0.25, -0.1
		pose.legs = "stance"
		pose.stance = "high"
	elseif airUp then
		pose.RShoulder = CFrame.Angles(0.7, 0, 0.35)
		pose.LShoulder = CFrame.Angles(0.7, 0, -0.35)
	end

	-- the disc arm
	local throwArm = IDENTITY
	local throwSet = false
	if ctx.holding then
		throwArm = CFrame.Angles(0.55, 0, 0.1)
		throwSet = true
	end
	if ctx.windup or ctx.fakeAge < 0.22 then
		throwArm = windupArm(ctx.windupType)
		pose.Waist = windupWaist(ctx.windupType)
		throwSet = true
		pose.rate = math.max(pose.rate, 22)
	elseif ctx.releaseAge < 0.25 then
		throwArm = if ctx.releaseType == "Hammer" or ctx.releaseType == "Scoober"
			then CFrame.Angles(2.2, 0, 0.1)
			else CFrame.Angles(1.6, 0, 0.25)
		pose.Waist = if ctx.releaseType == "Forehand" then CFrame.Angles(0, 0.35, 0) else CFrame.Angles(0, -0.45, 0)
		throwSet = true
		pose.rate = 30
	end
	if throwSet then
		if ctx.leftHanded then
			local rx, ry, rz = throwArm:ToEulerAnglesXYZ()
			pose.LShoulder = CFrame.Angles(rx, -ry, -rz)
		else
			pose.RShoulder = throwArm
		end
	end

	-- reach: turn the chest toward the disc and point the near arm at it
	if ctx.reachAge < 0.35 and not ctx.holding then
		local d = ctx.reachDir
		local arm = aimArm(d)
		local flatD = Vector3.new(d.X, 0, d.Z)
		if flatD.Magnitude > 0.05 then
			pose.Waist = CFrame.Angles(0, math.clamp(math.atan2(-flatD.X, -flatD.Z), -0.6, 0.6), 0)
		end
		if d.X >= 0 then
			pose.RShoulder = arm
		else
			pose.LShoulder = arm
		end
		pose.rate = 30
	end

	-- celebrations
	if ctx.celebrate ~= "" and ctx.celebrateAge < 3 then
		local a = ctx.celebrateAge
		if ctx.celebrate == "Point" then
			pose.RShoulder = CFrame.Angles(2.9, 0, 0.3)
		elseif ctx.celebrate == "Flex" then
			pose.RShoulder = CFrame.Angles(0, 0, 1.6)
			pose.LShoulder = CFrame.Angles(0, 0, -1.6)
		elseif ctx.celebrate == "Bow" then
			pose.drop, pose.pitch, pose.roll = 0, -0.8, 0
			pose.RShoulder = CFrame.Angles(0.4, 0, 0)
		elseif ctx.celebrate == "Spin" then
			pose.drop, pose.pitch, pose.roll = 0, 0, 0
			pose.yaw = a * 12
			pose.RShoulder = CFrame.Angles(2.9, 0, 0.2)
		elseif ctx.celebrate == "Slide" then
			pose.drop, pose.pitch, pose.roll = 1.5, 0.5, 0
			pose.legs = "slide"
			pose.RShoulder = CFrame.Angles(2.6, 0, 0.6)
			pose.LShoulder = CFrame.Angles(2.6, 0, -0.6)
		end
		pose.rate = 14
	end

	-- head tracks the disc
	local look = ctx.lookAt
	if look and look.Magnitude > 0.1 then
		local yaw = math.clamp(math.atan2(-look.X, -look.Z), -1.1, 1.1)
		local pitch = math.clamp(math.atan2(look.Y, Vector3.new(look.X, 0, look.Z).Magnitude), -0.6, 0.7)
		pose.Neck = CFrame.Angles(pitch, yaw, 0)
	end
	return pose
end

---------------------------------------------------------------------------
-- legs
---------------------------------------------------------------------------

-- Symmetric bend that shortens a straight leg by `drop` while countering the
-- pelvis pitch (and half its roll: the legs still lean into a cut), so the
-- animated legs keep their feet on the ground under the body. Without a drop
-- (a plain running lean) the whole body tilts instead, which only lifts the
-- feet a little; the counter fades in over the first 0.2 studs of drop.
local function freeLeg(leg: Leg, drop: number, pitch: number, roll: number): (CFrame, CFrame, CFrame)
	local reach = leg.thigh + leg.shin
	local d = math.max(drop, 0)
	local theta = math.acos(math.clamp(1 - d / reach, -1, 1))
	local counter = math.clamp(d / 0.2, 0, 1)
	local hip = CFrame.Angles(pitch * counter, 0, roll * 0.5 * counter):Inverse() * CFrame.Angles(theta, 0, 0)
	return hip, CFrame.Angles(-2 * theta, 0, 0), CFrame.Angles(theta, 0, 0)
end

-- Two-bone IK: hip / knee / ankle rotations that put the sole at `foot`
-- (HRP space) with the knee bending forward and the foot kept flat.
local function solveLeg(leg: Leg, lt: CFrame, ltRest: CFrame, foot: Vector3): (CFrame, CFrame, CFrame)
	local a, b = leg.thigh, leg.shin
	local hipP = lt:PointToWorldSpace(leg.hipPos)
	local ankleP = foot + Vector3.new(0, leg.ankleHeight, 0)
	local toAnkle = ankleP - hipP
	local dist = math.clamp(toAnkle.Magnitude, math.abs(a - b) + 0.01, a + b - 0.001)
	local dir = if toAnkle.Magnitude > 1e-4 then toAnkle.Unit else DOWN
	local pole = Vector3.new(0, 0, -1)
	local perp = pole - dir * pole:Dot(dir)
	perp = if perp.Magnitude > 1e-3 then perp.Unit else Vector3.new(0, 0, -1)
	local cosA = math.clamp((a * a + dist * dist - b * b) / (2 * a * dist), -1, 1)
	local alpha = math.acos(cosA)
	local thighDir = dir * math.cos(alpha) + perp * math.sin(alpha)
	local kneeP = hipP + thighDir * a
	local shinDir = (hipP + dir * dist) - kneeP
	shinDir = if shinDir.Magnitude > 1e-4 then shinDir.Unit else thighDir

	local ltRot = lt.Rotation
	local hipRot = arc(leg.thighRest, ltRot:VectorToObjectSpace(thighDir))
	local ulRot = ltRot * hipRot * leg.hipRestRot
	local kneeRot = arc(leg.shinRest, ulRot:VectorToObjectSpace(shinDir))
	local llRot = ulRot * kneeRot * leg.kneeRestRot
	local llRest = ltRest.Rotation * leg.hipRestRot * leg.kneeRestRot
	return hipRot, kneeRot, llRot:Inverse() * llRest
end

-- Foot target (HRP space) for the standing poses, plus the side-shuffle
-- offset (applied after smoothing so it is not damped away).
local function stanceFoot(rig: Rig, leg: Leg, pose: Pose, ctx: Ctx, groundY: number): (Vector3, Vector3)
	local base = Vector3.new(leg.restFoot.X, groundY, leg.restFoot.Z)
	if pose.stance == "lunge" then
		-- the pivot foot stays at P, the stepping foot goes to P + step (the
		-- root sits BodyShare of the way). The stepping leg is the one on the
		-- step's side so the legs never cross; squared up it is the throwing
		-- side's leg.
		local share = if leg.side == rig.freeSide then 1 - HD.BodyShare else -HD.BodyShare
		return base + Vector3.new(pose.step.X, 0, pose.step.Z) * share, Vector3.zero
	end
	local wide = if pose.stance == "wide" then 0.8 else 0.35
	local target = base + Vector3.new(leg.side * wide, 0, 0)
	-- side-shuffle: each foot swings with the travel and lifts while it does
	local v = ctx.localVel
	local speed = v.Magnitude
	if speed <= 1 then
		return target, Vector3.zero
	end
	local k = math.clamp(speed / 4, 0, 1)
	local phase = rig.shufflePhase + (if leg.side > 0 then 0 else math.pi)
	local swing = v.Unit * (SHUFFLE_AMPLITUDE * k * math.sin(phase))
	return target, Vector3.new(swing.X, SHUFFLE_LIFT * k * math.max(0, math.cos(phase)), swing.Z)
end

-- Keeps a foot target inside what the leg can reach from its hip at the
-- current drop, so the IK always plants it (a wide step shortens the visual
-- stance a little instead of leaving a foot hovering).
local function withinReach(leg: Leg, lt: CFrame, foot: Vector3, groundY: number): Vector3
	local hip = lt:PointToWorldSpace(leg.hipPos)
	local vertical = hip.Y - (groundY + leg.ankleHeight)
	local reach = leg.thigh + leg.shin
	local maxFlat = math.sqrt(math.max(0, reach * reach - vertical * vertical)) * 0.96
	local rel = Vector3.new(foot.X - hip.X, 0, foot.Z - hip.Z)
	if rel.Magnitude <= maxFlat then
		return foot
	end
	local clamped = if rel.Magnitude > 1e-4 then rel.Unit * maxFlat else Vector3.zero
	return Vector3.new(hip.X + clamped.X, foot.Y, hip.Z + clamped.Z)
end

local function poseLegs(rig: Rig, pose: Pose, ctx: Ctx, rootCur: CFrame, dt: number)
	if #rig.legs == 0 then
		return
	end
	local rootBase = (bases[rig.joints.Root.motor] :: BaseEntry).base
	local c1Inv = rig.rootC1:Inverse()
	local lt = CFrame.new(rootBase.Position) * rootCur * rootBase.Rotation * c1Inv
	local ltRest = rootBase * c1Inv
	local groundY = -(rig.humanoid.HipHeight + rig.root.Size.Y / 2)
	-- the inputs (drop, pitch, foot targets) are already smoothed, so legs are
	-- exact in a steady pose and only blend right after switching pose kind
	local clock = os.clock()
	if pose.legs ~= rig.legMode then
		rig.legMode = pose.legs
		rig.legSwitchAt = clock
	end
	local alpha = if clock - rig.legSwitchAt < LEG_BLEND_TIME then 1 - math.exp(-LEG_RATE * dt) else 1
	local footAlpha = 1 - math.exp(-pose.rate * dt)
	if pose.stance == "wide" or pose.stance == "high" then
		local speed = ctx.localVel.Magnitude
		rig.shufflePhase = (rig.shufflePhase + speed / SHUFFLE_AMPLITUDE * dt) % (2 * math.pi)
	elseif pose.stance == "lunge" then
		-- which leg steps out, with hysteresis around the front
		local sx = pose.step.X
		if pose.step.Magnitude < 0.25 * HD.StepRadius then
			rig.freeSide = if ctx.leftHanded then -1 else 1
		elseif sx > 0.3 then
			rig.freeSide = 1
		elseif sx < -0.3 then
			rig.freeSide = -1
		end
	end
	for _, leg in rig.legs do
		local hip, knee, ankle = IDENTITY, IDENTITY, IDENTITY
		if pose.legs == "stance" then
			local target, shuffle = stanceFoot(rig, leg, pose, ctx, groundY)
			local prev = leg.foot
			local foot = if prev then prev:Lerp(target, footAlpha) else target
			leg.foot = foot
			hip, knee, ankle = solveLeg(leg, lt, ltRest, withinReach(leg, lt, foot + shuffle, groundY))
		else
			leg.foot = nil
			if pose.legs == "free" then
				hip, knee, ankle = freeLeg(leg, rig.drop, rig.pitch, rig.roll)
			elseif pose.legs == "slide" then
				hip = CFrame.Angles(1.35 - rig.pitch, 0, 0)
				knee = CFrame.Angles(-0.25, 0, 0)
			end
		end
		leg.hip.current = leg.hip.current:Lerp(hip, alpha)
		leg.knee.current = leg.knee.current:Lerp(knee, alpha)
		write(leg.hip)
		write(leg.knee)
		local aj = leg.ankle
		if aj then
			aj.current = aj.current:Lerp(ankle, alpha)
			write(aj)
		end
	end
end

local function apply(rig: Rig, pose: Pose, ctx: Ctx, dt: number)
	local alpha = 1 - math.exp(-pose.rate * dt)
	-- R6 has no knees: never lower it while it stands
	local drop = pose.drop
	if (not rig.r15 or #rig.legs == 0) and (pose.legs == "free" or pose.legs == "stance") then
		drop = 0
	end
	rig.drop += (drop - rig.drop) * alpha
	rig.pitch += (pose.pitch - rig.pitch) * alpha
	rig.roll += (pose.roll - rig.roll) * alpha
	local rootCur = CFrame.new(0, -rig.drop, 0) * CFrame.Angles(rig.pitch, pose.yaw, rig.roll)

	for key, joint in rig.joints do
		if key == "Root" then
			joint.current = rootCur
		else
			local target: CFrame = (pose :: any)[key] or IDENTITY
			joint.current = joint.current:Lerp(target, alpha)
		end
		write(joint)
	end
	poseLegs(rig, pose, ctx, rootCur, dt)
end

local function changed(rig: Rig): boolean
	for _, j in rig.joints do
		if externallyChanged(j.motor) then
			return true
		end
	end
	for _, leg in rig.legs do
		if externallyChanged(leg.hip.motor) or externallyChanged(leg.knee.motor) then
			return true
		end
	end
	return false
end

local function step(dt: number)
	local camPos = workspace.CurrentCamera.CFrame.Position
	local seen: { [Model]: boolean } = {}
	for _, model in Actors.characters() do
		seen[model] = true
		local rig: Rig? = rigs[model]
		if rig and (rig.root.Parent ~= model or changed(rig)) then
			-- avatar rescaled / rebuilt: the new C0s are the rest pose now
			rigs[model] = nil
			rig = nil
		end
		if not rig then
			-- wait for avatars to finish loading (scaling rewrites joint C0s)
			local seenAt = firstSeen[model]
			if not seenAt then
				firstSeen[model] = os.clock()
				continue
			end
			local owner = Players:GetPlayerFromCharacter(model)
			if os.clock() - seenAt < 1.0 or (owner and not owner:HasAppearanceLoaded() and os.clock() - seenAt < 6) then
				continue
			end
			local built = buildRig(model)
			if not built then
				continue
			end
			rigs[model] = built
			rig = built
		end
		local r = rig :: Rig
		r.seenAt = os.clock()
		if (r.root.Position - camPos).Magnitude > 300 then
			continue
		end
		local ok, err = pcall(function()
			local ctx = gather(r, dt)
			apply(r, compute(ctx), ctx, dt)
		end)
		if not ok then
			if not warned[model] then
				warned[model] = true
				warn("[PoseController] " .. tostring(err))
			end
			pcall(restoreRig, r)
			rigs[model] = nil
			firstSeen[model] = os.clock() -- retry after the usual short wait
		end
	end
	-- a model missing for a moment keeps its rig; gone for good, it is restored
	local clock = os.clock()
	for model, rig in rigs do
		if not seen[model] and (model.Parent == nil or clock - rig.seenAt > 1) then
			pcall(restoreRig, rig)
			rigs[model] = nil
		end
	end
	for model in firstSeen do
		if not seen[model] and rigs[model] == nil then
			firstSeen[model] = nil
		end
	end
end

function PoseController.Init(c: any)
	controllers = c
end

function PoseController.Start()
	controllers.MovementController.Tech:Connect(function(e)
		local name = if e.tech == "FakeCommit" then "Lean" else e.tech
		localTech = { name = name, t = now(), dir = e.dir }
	end)
	player.CharacterAdded:Connect(function()
		localTech = { name = "", t = -math.huge, dir = Vector3.zero }
	end)
	RunService:BindToRenderStep("UBPose", Enum.RenderPriority.Character.Value + 1, step)
end

return PoseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SettingsController — local settings and key bindings, synced to the
	player's saved profile (Settings > Controls rebinding writes here).

	Every key in Config/Input DefaultSettings is persisted (AutoSprint, on by
	default, included); profiles saved before a key existed simply get its
	default. When a default changes on purpose (Input.SettingsVersion /
	Input.Migrations) the listed keys are reset once for older profiles.

	keyLabel(action, scheme) gives the short label of the first key bound to
	an action ("Q", "SHIFT", "LMB", "X"), so HUD pips and hints follow rebinds.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local InputConfig = require(Shared.Config.Input)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local SettingsController = {}

SettingsController.Changed = Signal.new() -- (key)

local values: { [string]: any } = table.clone(InputConfig.DefaultSettings)
local overrides: { keyboard: { [string]: { string } }, gamepad: { [string]: { string } } } =
	{ keyboard = {}, gamepad = {} }
local applied = false
local saveQueued = false

function SettingsController.get(key: string): any
	return values[key]
end

function SettingsController.set(key: string, value: any)
	if values[key] == value then
		return
	end
	values[key] = value
	SettingsController.Changed:Fire(key)
	SettingsController.save()
end

function SettingsController.bindings(scheme: string): { [string]: { string } }
	local base: { [string]: { string } } = if scheme == "gamepad" then InputConfig.Gamepad else InputConfig.Keyboard
	local result: { [string]: { string } } = table.clone(base)
	local o = (overrides :: any)[scheme]
	if o then
		for action, keys in o do
			result[action] = keys
		end
	end
	return result
end

-- Short label of the first key bound to `action` in `scheme` ("keyboard" or
-- "gamepad"); "" when nothing is bound.
function SettingsController.keyLabel(action: string, scheme: string?): string
	local keys = SettingsController.bindings(scheme or "keyboard")[action]
	return InputConfig.keyLabel(if keys then keys[1] else nil)
end

function SettingsController.setBinding(scheme: string, action: string, keys: { string })
	local o = (overrides :: any)[scheme]
	if not o then
		return
	end
	o[action] = keys
	SettingsController.Changed:Fire("Bindings")
	SettingsController.save()
end

function SettingsController.resetBindings()
	overrides = { keyboard = {}, gamepad = {} }
	SettingsController.Changed:Fire("Bindings")
	SettingsController.save()
end

function SettingsController.save()
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(1.5, function()
		saveQueued = false
		Net.event("Action"):FireServer("SaveSettings", {
			values = values,
			keyboard = overrides.keyboard,
			gamepad = overrides.gamepad,
		})
	end)
end

-- Keys whose default changed after the profile was saved.
local function migratedKeys(savedVersion: any): { [string]: boolean }
	local skip: { [string]: boolean } = {}
	local from = if type(savedVersion) == "number" then savedVersion else 1
	for version, keys in InputConfig.Migrations do
		if version > from then
			for _, k in keys do
				skip[k] = true
			end
		end
	end
	return skip
end

local function applyProfile(profile: any)
	if applied or type(profile) ~= "table" or type(profile.settings) ~= "table" then
		return
	end
	applied = true
	local s = profile.settings
	if type(s.values) == "table" then
		local skip = migratedKeys(s.values.SettingsVersion)
		for k: string, default: any in InputConfig.DefaultSettings :: any do
			if not skip[k] and k ~= "SettingsVersion" and type(s.values[k]) == type(default) then
				values[k] = s.values[k]
			end
		end
		values.SettingsVersion = InputConfig.SettingsVersion
	end
	for _, scheme in { "keyboard", "gamepad" } do
		if type(s[scheme]) == "table" then
			for action, keys in s[scheme] do
				if type(keys) == "table" and #keys > 0 then
					(overrides :: any)[scheme][action] = keys
				end
			end
		end
	end
	SettingsController.Changed:Fire("All")
end

function SettingsController.Init(_c: any) end

function SettingsController.Start()
	Net.event("Profile").OnClientEvent:Connect(applyProfile)
	task.spawn(function()
		local ok, profile = pcall(function()
			return Net.func("GetProfile"):InvokeServer()
		end)
		if ok then
			applyProfile(profile)
		end
	end)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">ThrowController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ThrowController — everything you do with the disc in your hand.

	  hold Primary      charge (power rises to full at ChargeTime; release in
	                    the Perfect window for +speed/+spin; holding longer
	                    bleeds spin = a wobblier line)
	  WASD              step the free foot around your planted pivot
	  Q / E             quick swing to the screen-left / right side (the Cut /
	                    Dive keys; MovementController routes them while
	                    holding, gamepad X swings to the other side)
	  Secondary         pump fake: the same windup defenders see on a real
	                    throw, plus a fake step toward the side you hold (A/D)
	  Z / X             bank the disc left / right (curves the flight)
	  wheel, 1-5, T     throw type
	  hold Slide key    low release (step out under the mark)
	  Jump              hop (one per possession): a high release over the
	                    mark; release before you land or the charge is lost
	  R                 Lead Pass assist: aims at the teammate nearest your
	                    crosshair using their CURRENT velocity and marks the
	                    ideal power on the meter; timing the release is still on you

	Release: the disc leaves from your pivot foot P (the server's UBPivot, or
	the foot your sim just planted) plus your step (ThrowModel). The Throw remote carries the inputs plus
	step, pivot, rootPos and releaseT, so ThrowService validates and launches
	from the same place at the same moment; the flight is predicted locally at
	once from the same parameters. Fake -> Sold Pivot Swing -> release inside
	ComboEvaluator's break window scores a "Break"
	(MovementController.addTech).

	The preview arc shows the first part of the flight (how much depends on
	the mode: full in training, half in Mini, about a third in Normal, a
	fifth in ranked). When the mode shows at least MARK_PREVIEW of it, the arc
	turns red from where it would cross a visible marker's hands (the same
	CatchGeometry box the server tests).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local ThrowModel = require(Shared.Disc.ThrowModel)
local Solver = require(Shared.Disc.Solver)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local Actors = require(Shared.Actors)
local VecMath = require(Shared.Util.VecMath)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local T = DiscConfig.Throw
local HD = MovementConfig.Holding

local ThrowController = {}

ThrowController.Released = Signal.new() -- (launch, params)
ThrowController.Faked = Signal.new()
ThrowController.Changed = Signal.new()

local controllers: any
local player = Players.LocalPlayer

local AIM_OFFSET = math.rad(7) -- the camera looks slightly down over the shoulder
local BANK_STEPS = 3
local MARK_PREVIEW = 0.35 -- modes showing at least this much of the arc show the mark
local MARKER_RANGE = 14 -- markers this close to P are drawn / tested
local FAKE_SIDE_INPUT = 0.3 -- lateral input needed for the fake to step to a side

local state = {
	throwType = "Backhand",
	bankStep = 0,
	low = false,
	charging = false,
	chargeStart = 0,
	releasedAt = -math.huge,
	releasedFlight = -1,
	leadLock = false,
	leadTarget = nil :: number?,
	leadSolution = nil :: Solver.Solution?,
	lastSolve = 0,
	lastFake = -math.huge,
	heldFolder = nil :: Configuration?,
	holds = 0, -- possessions this session (key hints show for the first few)
	previewBlocked = false,
}

local dots: { BasePart } = {}
local DOT_COUNT = 40
local BLOCK_COLOR = Color3.fromRGB(255, 70, 80)

local function now(): number
	return Net.now()
end

function ThrowController.heldFolder(): Configuration?
	local f = controllers.DiscRenderer.heldByMe()
	if not f then
		return nil
	end
	-- a just-released disc is no longer ours unless the server rejected it
	if os.clock() - state.releasedAt < 0.8 and (f:GetAttribute("FlightId") :: number? or 0) == state.releasedFlight then
		return nil
	end
	return f
end

function ThrowController.isHolding(): boolean
	return ThrowController.heldFolder() ~= nil
end

function ThrowController.isCharging(): boolean
	return state.charging
end

function ThrowController.chargeFraction(): (number, string)
	if not state.charging then
		return 0, "Idle"
	end
	local hold = os.clock() - state.chargeStart
	local power, quality = ThrowModel.charge(hold, state.throwType)
	local info = ThrowModel.typeInfo(state.throwType)
	local t = hold * (info.ChargeMult or 1)
	return math.min(t / T.ChargeTime, 1.6), if quality == "Clean" and power < 1 then "Charging" else quality
end

local function airborne(): boolean
	return not controllers.MovementController.isGrounded()
end

local function releaseHeight(): string
	if state.low then
		return "Low"
	end
	if airborne() then
		return "High"
	end
	return "Mid"
end

local function leftHanded(): boolean
	return controllers.SettingsController.get("LeftHanded") == true
end

-- The pivot the server will release from: its UBPivot, or the foot our sim
-- just planted (its Pivot proposal reaches the server before any throw
-- does). nil = released from the root (still slowing down).
local function serverPivot(): Vector3?
	local c = player.Character
	local pv = c and c:GetAttribute("UBPivot")
	if typeof(pv) == "Vector3" then
		return pv
	end
	return controllers.MovementController.pivot()
end

local function currentParams(holdTime: number): ThrowModel.Params
	local yaw = controllers.CameraController.getYaw()
	local pitch = controllers.CameraController.getPitch() + AIM_OFFSET
	local sol = state.leadSolution
	if state.leadLock and sol then
		yaw = sol.params.yaw
		pitch = sol.params.pitch
	end
	local mc = controllers.MovementController
	local sim = mc.sim()
	local height = releaseHeight()
	local pivot = serverPivot()
	return {
		throwType = state.throwType,
		yaw = yaw,
		pitch = pitch,
		holdTime = holdTime,
		bank = state.bankStep / BANK_STEPS,
		height = height,
		offBalance = airborne() and height ~= "High",
		groundThrow = sim.mode == "DiveSlide" or sim.mode == "Recover",
		leftHanded = leftHanded(),
		pivot = pivot,
		step = if pivot then mc.step() else nil,
		swinging = pivot ~= nil and sim.swingUntil > sim.now,
	}
end

-- Opposing markers near P as this client displays them.
type Marker = { pos: Vector3, facing: Vector3, stance: CatchGeometry.MarkStance, jump: number }

local function standOf(model: Model, root: BasePart): number
	local h = model:FindFirstChildOfClass("Humanoid")
	if h and h.RigType == Enum.HumanoidRigType.R15 then
		return h.HipHeight + root.Size.Y / 2
	end
	return 3
end

local function markersNear(origin: Vector3, groundY: number): { Marker }
	local list: { Marker } = {}
	local me = player.Character
	local myTeam = me and me:GetAttribute("UBTeam")
	for _, model in Actors.characters() do
		if model ~= me then
			local team = model:GetAttribute("UBTeam")
			local mark = model:GetAttribute("Mark")
			local opponent = (team ~= myTeam and team ~= "N") or mark == "Low" or mark == "High"
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if opponent and root and VecMath.flat(root.Position - origin).Magnitude < MARKER_RANGE then
				local rise = root.Position.Y - groundY - standOf(model, root)
				table.insert(list, {
					pos = root.Position,
					facing = VecMath.flatUnit(root.CFrame.LookVector),
					stance = if mark == "Low" or mark == "High" then mark else "Relaxed",
					jump = if rise > 0.3 then rise else 0,
				})
			end
		end
	end
	return list
end

local function groundYOf(folder: Configuration?): number
	local g = folder and folder:GetAttribute("GroundY")
	return if type(g) == "number" then g else 0
end

-- The open side for the thrower (-1 screen-left, +1 right, 0 unknown): the
-- side the marking team forces (UBState ForceA/B), else read from the
-- marker's shade (a marker stands on the side they take away).
local function openSide(marker: { x: number, y: number }?): (number, string?)
	local c = player.Character
	local team = c and c:GetAttribute("UBTeam")
	local markers = if team == "A" then "B" elseif team == "B" then "A" else nil
	local force = if markers then Net.state():GetAttribute("Force" .. markers) else nil
	if force == "FH" or force == "BH" then
		local fhSide = if leftHanded() then -1 else 1
		return if force == "FH" then fhSide else -fhSide, force
	end
	if marker and math.abs(marker.x) > 0.4 then
		return if marker.x < 0 then 1 else -1, nil
	end
	return 0, nil
end

function ThrowController.hud(): { [string]: any }
	local fraction, phase = ThrowController.chargeFraction()
	local idealPower: number? = nil
	local sol = state.leadSolution
	if state.leadLock and sol then
		idealPower = math.clamp(
			sol.params.holdTime / T.ChargeTime * (ThrowModel.typeInfo(state.throwType).ChargeMult or 1),
			0,
			1
		)
	end
	local holding = ThrowController.isHolding()
	-- the step gauge, in the throw frame (x = right, y = forward, studs)
	local stepX, stepY = 0, 0
	local marker: { [string]: any }? = nil
	local pivot = serverPivot()
	local root = controllers.MovementController.root()
	if holding and root then
		local forward, right = ThrowModel.basis(controllers.CameraController.getYaw())
		local s = controllers.MovementController.step()
		stepX, stepY = s:Dot(right), s:Dot(forward)
		local origin = pivot or root.Position
		local best, bestD = nil, MARKER_RANGE
		for _, m in markersNear(origin, groundYOf(state.heldFolder)) do
			local d = VecMath.flat(m.pos - origin).Magnitude
			if d < bestD then
				best, bestD = m, d
			end
		end
		if best then
			local rel = best.pos - origin
			local fwd = CatchGeometry.markForward(best.pos, best.facing, origin)
			marker = {
				x = rel:Dot(right),
				y = rel:Dot(forward),
				fx = fwd:Dot(right),
				fy = fwd:Dot(forward),
				stance = best.stance,
				halfWidth = if best.stance == "High"
					then DiscConfig.Mark.HighHalfWidth
					else DiscConfig.Mark.LowHalfWidth,
			}
		end
	end
	local open, force = openSide(marker :: any)
	return {
		holding = holding,
		throwType = state.throwType,
		bank = state.bankStep,
		bankSteps = BANK_STEPS,
		height = releaseHeight(),
		charge = fraction,
		phase = phase,
		leadLock = state.leadLock,
		leadName = if state.leadTarget then Actors.nameOf(state.leadTarget) else nil,
		idealPower = idealPower,
		holds = state.holds,
		pivoted = pivot ~= nil,
		stepX = stepX,
		stepY = stepY,
		stepRadius = HD.StepRadius,
		marker = marker,
		openSide = open,
		force = force,
		leftHanded = leftHanded(),
		blocked = state.previewBlocked,
	}
end

local function setType(t: string)
	if (DiscConfig.Types :: any)[t] and t ~= state.throwType then
		state.throwType = t
		if state.charging then
			-- switching mid-charge restarts the windup (no type-switch exploits)
			state.chargeStart = os.clock()
			Net.event("ThrowCharge"):FireServer(t)
		end
		ThrowController.Changed:Fire()
	end
end

local function cycleType(delta: number)
	local order = DiscConfig.TypeOrder
	local i = table.find(order, state.throwType) or 1
	i = ((i - 1 + delta) % #order) + 1
	setType(order[i])
end

local function cancelCharge()
	if state.charging then
		state.charging = false
		ThrowController.Changed:Fire()
	end
end

-- First time (into the flight) the release crosses a visible marker's hands.
local function previewBlockTime(
	launch: ThrowModel.Launch,
	wind: DiscPhysics.Wind?,
	groundY: number,
	origin: Vector3
): number?
	local markers = markersNear(origin, groundY)
	if #markers == 0 then
		return nil
	end
	local boxes = {}
	for _, m in markers do
		table.insert(boxes, CatchGeometry.markBox(m.pos, m.facing, origin, m.stance, groundY, m.jump))
	end
	local early = DiscPhysics.simulate(launch.state, T.HandBlockCheckTime, wind, groundY, 1)
	for _, s in early.samples do
		local p = Vector3.new(s.x, s.y, s.z)
		for _, box in boxes do
			if CatchGeometry.inMarkBox(box, p) then
				return s.t
			end
		end
	end
	return nil
end

local function release()
	if not state.charging then
		return
	end
	state.charging = false
	local folder = ThrowController.heldFolder()
	local root = controllers.MovementController.root()
	if not folder or not root then
		return
	end
	local hold = os.clock() - state.chargeStart
	local params = currentParams(hold)
	local releaseT = now()
	Net.event("Throw"):FireServer({
		throwType = params.throwType,
		yaw = params.yaw,
		pitch = params.pitch,
		holdTime = params.holdTime,
		bank = params.bank,
		height = params.height,
		offBalance = params.offBalance,
		groundThrow = params.groundThrow,
		step = params.step,
		pivot = params.pivot,
		swinging = params.swinging,
		releaseT = releaseT,
		rootPos = root.Position,
	})
	local launch = ThrowModel.launch(params, root.Position, root.AssemblyLinearVelocity)
	local id = folder:GetAttribute("Id") :: string
	-- if your own view says the mark gets it, the predicted disc stops at the hands
	local w = Net.state():GetAttribute("Wind")
	local wind = if typeof(w) == "Vector3" then { x = w.X, y = w.Y, z = w.Z } else nil
	local blockT = if folder:GetAttribute("Context") == "Match"
		then previewBlockTime(launch, wind, groundYOf(folder), serverPivot() or root.Position)
		else nil
	controllers.DiscRenderer.predictThrow(id, launch.state, releaseT, blockT)
	state.releasedAt = os.clock()
	state.releasedFlight = (folder:GetAttribute("FlightId") :: number?) or 0

	-- fake -> Sold swing -> release: the Break link
	local mc = controllers.MovementController
	local breakQ = ComboEvaluator.breakQuality(mc.combo(), releaseT)
	if breakQ then
		local forward = ThrowModel.basis(params.yaw)
		mc.addTech("Break", breakQ, forward, nil)
	end

	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalRelease", now())
		c:SetAttribute("UB_LocalWindup", 0)
	end
	ThrowController.Released:Fire(launch, params)
	ThrowController.Changed:Fire()
end

-- The fake steps toward the side you hold (-1 screen-left, +1 right, 0 none).
local function fakeSide(): number
	local move = controllers.InputController.moveVector()
	local _, right = ThrowModel.basis(controllers.CameraController.getYaw())
	local lateral = move:Dot(right)
	if lateral > FAKE_SIDE_INPUT then
		return 1
	elseif lateral < -FAKE_SIDE_INPUT then
		return -1
	end
	return 0
end

local function fake()
	if os.clock() - state.lastFake < T.FakeCooldown then
		return
	end
	state.lastFake = os.clock()
	state.charging = false
	local side = fakeSide()
	controllers.MovementController.fakeStep(side)
	Net.event("Fake"):FireServer(state.throwType, side)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalFake", now())
		c:SetAttribute("UB_LocalWindupType", state.throwType)
	end
	ThrowController.Faked:Fire()
end

-- picks the teammate closest to the crosshair and solves a lead pass
local function updateLead()
	if not state.leadLock then
		return
	end
	local root = controllers.MovementController.root()
	local c = player.Character
	if not root or not c then
		return
	end
	local myTeam = c:GetAttribute("UBTeam")
	local aim = controllers.CameraController.getAimDirection()
	local best, bestDot = nil, math.cos(math.rad(35))
	for _, model in Actors.characters() do
		if model ~= c and (model:GetAttribute("UBTeam") == myTeam or myTeam == "N") then
			local r = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				local dir = (r.Position - root.Position)
				if dir.Magnitude > 6 then
					local d = aim:Dot(dir.Unit)
					if d > bestDot then
						best, bestDot = model, d
					end
				end
			end
		end
	end
	local id = if best then Actors.idOf(best) else nil
	state.leadTarget = id
	if not best or os.clock() - state.lastSolve < 0.2 then
		if not best then
			state.leadSolution = nil
		end
		return
	end
	state.lastSolve = os.clock()
	local r = (best :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
	local w = Net.state():GetAttribute("Wind")
	local wind = if typeof(w) == "Vector3" then { x = w.X, y = w.Y, z = w.Z } else nil
	local pivot = serverPivot()
	local sol = Solver.solve({
		rootPos = root.Position,
		throwerVel = root.AssemblyLinearVelocity,
		throwType = state.throwType,
		bank = state.bankStep / BANK_STEPS,
		height = releaseHeight(),
		target = r.Position + Vector3.new(0, 1, 0),
		targetVel = VecMath.flat(r.AssemblyLinearVelocity),
		wind = wind,
		groundY = groundYOf(state.heldFolder),
		coarse = true,
		leftHanded = leftHanded(),
		pivot = pivot,
		step = if pivot then controllers.MovementController.step() else nil,
	})
	-- only offer a lead when a catchable pass exists
	state.leadSolution = if sol and sol.miss <= 4 then sol else nil
end

local function previewFraction(folder: Configuration): number
	local context = folder:GetAttribute("Context")
	if context ~= "Match" then
		return 1
	end
	local f = Net.state():GetAttribute("PreviewFraction")
	return if type(f) == "number" then f else 0.5
end

local function hideDots()
	for _, d in dots do
		d.Transparency = 1
	end
	state.previewBlocked = false
end

local function drawPreview(folder: Configuration)
	if not controllers.SettingsController.get("TrajectoryPreview") then
		hideDots()
		return
	end
	local root = controllers.MovementController.root()
	if not root then
		hideDots()
		return
	end
	local hold: number
	if state.charging then
		hold = os.clock() - state.chargeStart
	elseif state.leadLock and state.leadSolution then
		hold = (state.leadSolution :: Solver.Solution).params.holdTime
	else
		hold = T.ChargeTime * 0.6 / (ThrowModel.typeInfo(state.throwType).ChargeMult or 1)
	end
	local params = currentParams(hold)
	local launch = ThrowModel.launch(params, root.Position, root.AssemblyLinearVelocity)
	local w = Net.state():GetAttribute("Wind")
	local wind = if typeof(w) == "Vector3" then { x = w.X, y = w.Y, z = w.Z } else nil
	local groundY = groundYOf(folder)
	local result = DiscPhysics.simulate(launch.state, 8, wind, groundY, 6)
	local total = result.landT
	local fraction = previewFraction(folder)
	local limit = total * fraction
	local origin = serverPivot() or root.Position
	local blockT = if fraction >= MARK_PREVIEW then previewBlockTime(launch, wind, groundY, origin) else nil
	state.previewBlocked = blockT ~= nil
	local _, phase = ThrowController.chargeFraction()
	local color = if phase == "Perfect"
		then Color3.fromRGB(255, 215, 80)
		elseif phase == "Over" then Color3.fromRGB(255, 90, 100)
		else Color3.fromRGB(230, 245, 255)
	local idx = 0
	local nextT = 0
	for _, s in result.samples do
		if s.t > limit or idx >= DOT_COUNT then
			break
		end
		if s.t >= nextT then
			idx += 1
			local d = dots[idx]
			d.Position = Vector3.new(s.x, s.y, s.z)
			d.Color = if blockT and s.t >= blockT then BLOCK_COLOR else color
			d.Transparency = 0.15 + 0.6 * (s.t / math.max(limit, 0.01))
			nextT = s.t + 0.07
		end
	end
	for i = idx + 1, DOT_COUNT do
		dots[i].Transparency = 1
	end
end

local function step()
	local folder = ThrowController.heldFolder()
	if folder ~= state.heldFolder then
		state.heldFolder = folder
		if folder then
			state.holds += 1
		else
			state.charging = false
			state.leadSolution = nil
			state.low = false
		end
		ThrowController.Changed:Fire()
	end
	if not folder then
		hideDots()
		return
	end
	updateLead()
	drawPreview(folder)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalWindup", if state.charging then state.chargeStart else 0)
		c:SetAttribute("UB_LocalWindupType", state.throwType)
	end
end

function ThrowController.Init(c: any)
	controllers = c
end

function ThrowController.Start()
	local visuals = workspace:WaitForChild("UBVisuals")
	for i = 1, DOT_COUNT do
		local d = Instance.new("Part")
		d.Name = "PreviewDot"
		d.Shape = Enum.PartType.Ball
		d.Size = Vector3.new(0.35, 0.35, 0.35)
		d.Anchored = true
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.CastShadow = false
		d.Material = Enum.Material.Neon
		d.Transparency = 1
		d.Parent = visuals
		dots[i] = d
	end

	local input = controllers.InputController
	input.ActionBegan:Connect(function(action)
		if not ThrowController.isHolding() then
			if action == "Celebrate" then
				Net.event("Action"):FireServer("Celebrate", nil)
			end
			return
		end
		-- Cut / Dive / Jump while holding are swings and the hop (MovementController)
		if action == "Primary" then
			state.charging = true
			state.chargeStart = os.clock()
			Net.event("ThrowCharge"):FireServer(state.throwType)
		elseif action == "Secondary" then
			fake()
		elseif action == "BankLeft" then
			state.bankStep = math.max(-BANK_STEPS, state.bankStep - 1)
			ThrowController.Changed:Fire()
		elseif action == "BankRight" then
			state.bankStep = math.min(BANK_STEPS, state.bankStep + 1)
			ThrowController.Changed:Fire()
		elseif action == "TypeNext" then
			cycleType(1)
		elseif action == "TypePrev" then
			cycleType(-1)
		elseif string.sub(action, 1, 4) == "Type" then
			local n = tonumber(string.sub(action, 5))
			if n and DiscConfig.TypeOrder[n] then
				setType(DiscConfig.TypeOrder[n])
			end
		elseif action == "Slide" then
			state.low = true
			ThrowController.Changed:Fire()
		elseif action == "LeadLock" then
			state.leadLock = not state.leadLock
			state.leadSolution = nil
			ThrowController.Changed:Fire()
		end
	end)
	input.ActionEnded:Connect(function(action)
		if action == "Primary" then
			release()
		elseif action == "Slide" then
			state.low = false
			ThrowController.Changed:Fire()
		end
	end)
	input.Wheel:Connect(function(delta)
		if ThrowController.isHolding() then
			cycleType(if delta > 0 then -1 else 1)
		end
	end)
	controllers.MovementController.Feedback:Connect(function(fb)
		-- landing from the hop (or a travel reset) loses the charge
		if fb.kind == "HopLanded" or fb.kind == "Travel" then
			cancelCharge()
		end
	end)
	RunService:BindToRenderStep("UBThrow", Enum.RenderPriority.Camera.Value + 4, step)
end

return ThrowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	UIController — builds the interface and routes everything to it.

	  Movement feedback (MovementController.Feedback): the sim's ready-made
	  texts ("NEED SPEED", "ONE PER JUMP", "PRECISION LANDING -40 ms", ...)
	  become chips above the crosshair for 0.6 s. A press refused for a
	  cooldown flashes that technique's pip instead (no cooldown text).
	  Combos: ComboChanged / ChainEnded drive the Hud chain widget and end
	  card. The server's Combo event (a chain converted by a catch, block or
	  interception) shows the x2 card and converts the same chain in the local
	  tracker, so it is never also shown as unconverted.
	  Techniques: optional labels; a Sold Pivot Swing says "release now" and a
	  Break says so.
	  Catching: a claim the server denies, and that is neither claimed again
	  nor turned into a catch shortly after, gets a subtle "NO CATCH" chip.
	  Throws (server Release feedback): text only when it says something —
	  Perfect, over-held, hand-blocked, a High release the server saw as Mid
	  (the hop was not seen in the air), off balance, from the ground.
	  Travel: the server's travel reset is a chip, not a toast.
	  Hint line (bottom left): the bound keys while playing, plus the bench,
	  warm-up and training lines.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local TeamsConfig = require(Shared.Config.Teams)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local ThrowHud = require(UI.ThrowHud)
local Menu = require(UI.Menu)
local Panels = require(UI.Panels)
local Mobile = require(UI.Mobile)

local C = Theme.Colors

local UIController = {}

local controllers: any
local player = Players.LocalPlayer
local lastLevel: number? = nil
local hintedVote = false

local DENIED_DELAY = 0.3 -- a denied claim must stay unanswered this long before it is shown ...
local DENIED_GAP = 1.5 -- ... and at most once per this long
local TRAVEL_TEXT = "TRAVEL — RESET TO YOUR PIVOT"

-- First word of a Cooldown feedback text ("BURST READY IN 0.8s") -> its pip.
local COOLDOWN_PIP: { [string]: string } = {
	BURST = "BurstStep",
	LAYOUT = "Dive",
	PLANT = "MomentumCancel",
	SLIDE = "Slide",
}

local REASONS: { [string]: string } = {
	Incomplete = "Incomplete pass",
	Drop = "Dropped",
	Block = "Blocked",
	OutOfBounds = "Out of bounds",
	Stall = "Stalled out",
	Interception = "Intercepted",
}

function UIController.toggleMenu()
	Menu.toggle()
end

local function teamName(t: string?): string
	return if t == "A" then TeamsConfig.A.Name elseif t == "B" then TeamsConfig.B.Name else ""
end

local function key(action: string, label: string): string
	return Theme.keyText(controllers.InputController.keyLabel(action), label)
end

local function onNotify(kind: string, text: string, data: any)
	local d = if type(data) == "table" then data else {}
	if kind == "Banner" then
		Hud.banner(text, d.sub, nil, 1.8)
	elseif kind == "Goal" then
		local scorer = if type(d.scorer) == "number" then (require(Shared.Actors) :: any).nameOf(d.scorer) else ""
		local sub = if d.callahan
			then ("CALLAHAN by " .. scorer)
			else scorer .. (if d.assist
				then "  ·  assist " .. (require(Shared.Actors) :: any).nameOf(d.assist)
				else "")
		Hud.banner(text, sub, Theme.teamColor(d.team), 3)
	elseif kind == "Turnover" then
		local sub = REASONS[d.reason or ""] or ""
		Hud.banner(text, sub .. (if d.team then ("  ·  " .. teamName(d.team) .. " ball") else ""), C.Bad, 1.6)
	elseif kind == "Point" then
		local myTeam = if player.Character then player.Character:GetAttribute("UBTeam") else nil
		local sub = if d.offense == myTeam then "You receive" else "You pull and defend"
		if d.pull == false then
			sub = if d.offense == myTeam then "Your disc" else "Defend"
		end
		Hud.banner(text, sub, nil, 2.2)
	elseif kind == "Travel" then
		Hud.chip(if type(text) == "string" and text ~= "" then string.upper(text) else TRAVEL_TEXT, C.Bad, 1.4)
	elseif kind == "Toast" then
		if type(text) == "string" and string.sub(string.lower(text), 1, 6) == "travel" then
			-- (the travel reset, until it arrives as its own "Travel" kind)
			Hud.chip(TRAVEL_TEXT, C.Bad, 1.4)
		else
			Hud.toast(text, nil, 3.5)
		end
	elseif kind == "Achievement" then
		Hud.toast("ACHIEVEMENT: " .. text .. " — " .. tostring(d.description or ""), C.Gold, 6)
		controllers.AudioController.play("Highlight")
	elseif kind == "LevelUp" then
		Hud.banner(text, "Level up!", C.Gold, 2.5)
		for _, u in d.unlocks or {} do
			Hud.toast("Unlocked " .. u.slot .. ": " .. u.name, C.Accent, 6)
		end
	end
end

-- Release text only when it matters (Clean releases speak for themselves).
local function onRelease(payload: any)
	if payload.blocked then
		Hud.feedback("HAND BLOCKED — fake, step out or change your release height", C.Bad, 2.2)
		return
	end
	local parts: { string } = {}
	local color = C.Clean
	if payload.quality == "Perfect" then
		table.insert(parts, "PERFECT RELEASE")
		color = C.Perfect
	elseif payload.quality == "Over" then
		table.insert(
			parts,
			string.format("OVER-HELD — let go sooner  ·  spin %d%%", math.floor((tonumber(payload.spin) or 0) * 100))
		)
		color = C.Sloppy
	end
	if payload.heightAsked == "High" and payload.heightUsed ~= "High" and not payload.groundThrow then
		table.insert(parts, "RELEASED MID (HOP NOT SEEN) — release while still in the air")
		color = C.Sloppy
	end
	if payload.groundThrow then
		table.insert(parts, "FROM THE GROUND")
	elseif payload.offBalance then
		table.insert(parts, "OFF BALANCE")
	end
	if #parts > 0 then
		Hud.feedback(table.concat(parts, "  ·  "), color, 2)
	end
end

local function onFeedback(kind: string, payload: any)
	if kind == "Release" and type(payload) == "table" then
		onRelease(payload)
	elseif kind == "DrillHud" then
		Panels.drillHud(payload)
	elseif kind == "Drill" then
		Panels.drillReport(payload)
		controllers.AudioController.play("Highlight")
	elseif kind == "DrillTick" and type(payload) == "table" then
		Hud.feedback(payload.text or "", C.Text, 4)
	elseif kind == "OpenLauncher" then
		Hud.toast("Free launcher: press M > Training to set up and fire launches.", C.Accent, 6)
	end
end

local function onMovementFeedback(fb: any)
	if type(fb) ~= "table" then
		return
	end
	local kind = fb.kind
	local text: string? = if type(fb.text) == "string" and fb.text ~= "" then fb.text else nil
	if kind == "Cooldown" then
		-- the pips show readiness: flash the one that refused instead of printing it
		local first = if text then string.match(text, "^(%u+)") else nil
		local pip = if first then COOLDOWN_PIP[first] else nil
		if pip then
			Hud.flashPip(pip)
		end
		return
	elseif kind == "Error" then
		Hud.feedback(text or "MOVEMENT ERROR", C.Bad, 5)
		return
	end
	if not text then
		return
	end
	if kind == "LandingOffset" then
		Hud.chip(text, if string.find(text, "^PRECISION") then C.Perfect else C.Sloppy, 0.8)
	elseif kind == "HopLanded" or kind == "Travel" then
		Hud.chip(text, C.Bad, 1.2)
	elseif kind == "Context" then
		Hud.chip(text, C.Text)
	else
		Hud.chip(text, C.Sloppy)
	end
end

local function onTech(e: any)
	Hud.techLabel(e.tech, e.quality, e.info)
	if e.tech == "PivotSwing" and e.quality == "Perfect" then
		Hud.chip("SOLD SWING — RELEASE NOW", C.Perfect, 0.5)
	elseif e.tech == "Break" then
		Hud.chip(if e.quality == "Perfect" then "BREAK  ·  PERFECT" else "BREAK", C.Perfect, 1)
	end
end

-- A denied claim gets a subtle chip, unless it was claimed again (or caught)
-- right after: the server retries are normal and should stay invisible. A
-- claim that became your block or bobble is not "denied" either (the server
-- answers those with accepted = false too).
local lastClaim: { [string]: number } = {}
local lastResult: { [string]: string } = {}
local lastNoCatch = -math.huge
local NOT_A_MISS: { [string]: boolean } = { Catch = true, Block = true, Bobble = true }
local function onDenied(discId: any)
	local at = os.clock()
	task.delay(DENIED_DELAY, function()
		if controllers.ThrowController.isHolding() then
			return
		end
		if type(discId) == "string" then
			if (lastClaim[discId] or -math.huge) > at or NOT_A_MISS[lastResult[discId] or ""] then
				return
			end
		end
		local clock = os.clock()
		if clock - lastNoCatch < DENIED_GAP then
			return
		end
		lastNoCatch = clock
		Hud.chip("NO CATCH", C.Muted, 0.5)
	end)
end

local function movementKeys(): string
	if controllers.InputController.scheme() == "Touch" then
		return ""
	end
	return table.concat({
		key("Cut", "cut"),
		key("Burst", "burst"),
		key("Slide", "slide"),
		key("Dive", "dive"),
		key("Jump", "jump"),
		key("Menu", "menu"),
	}, "  ·  ")
end

local function updateHint()
	local c = player.Character
	local role = if c then c:GetAttribute("UBRole") else nil
	local phase = Net.state():GetAttribute("Phase")
	if controllers.ThrowController.isHolding() then
		Hud.setHint("")
	elseif role == "Training" then
		Hud.setHint("Walk to a terminal and press G to start a drill  ·  " .. key("Menu", "menu"))
	elseif phase == "Intermission" then
		Hud.setHint("Warm-up: grab the disc and throw it around  ·  " .. key("Menu", "vote / train / settings"))
		if not hintedVote then
			hintedVote = true
			Hud.toast("Press M to vote for the next mode and arena, or to train.", C.Accent, 6)
		end
	elseif role == "Bench" then
		Hud.setHint("On the bench: you play next point  ·  " .. key("Menu", "menu"))
	elseif phase == "PointOver" or phase == "MatchOver" then
		Hud.setHint(key("Celebrate", "celebrate") .. "  ·  " .. key("Menu", "menu"))
	else
		Hud.setHint(movementKeys())
	end
end

function UIController.Init(c: any)
	controllers = c
end

function UIController.Start()
	task.spawn(function()
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
				StarterGui:SetCore("ResetButtonCallback", false)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "UBInterface"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	Hud.build(gui, controllers)
	ThrowHud.build(gui, controllers)
	Panels.build(gui, controllers)
	Mobile.build(gui, controllers)
	Menu.build(gui, controllers)

	controllers.InputController.ActionBegan:Connect(function(action)
		if action == "Menu" then
			Menu.toggle()
		end
	end)
	local movement = controllers.MovementController
	movement.Tech:Connect(onTech)
	movement.Feedback:Connect(onMovementFeedback)
	movement.ComboChanged:Connect(Hud.comboChanged)
	movement.ChainEnded:Connect(Hud.chainEnded)

	controllers.CatchController.Claimed:Connect(function(discId)
		if type(discId) == "string" then
			lastClaim[discId] = os.clock()
		end
	end)
	controllers.CatchController.Denied:Connect(onDenied)
	Net.event("CatchResult").OnClientEvent:Connect(function(discId, _accepted, result)
		if type(discId) == "string" and type(result) == "string" then
			lastResult[discId] = result
		end
	end)

	Net.event("Notify").OnClientEvent:Connect(onNotify)
	Net.event("Feedback").OnClientEvent:Connect(onFeedback)
	Net.event("Highlight").OnClientEvent:Connect(function(h)
		if type(h) == "table" then
			Hud.highlight(h.name or "", h.text or "", h.team)
		end
	end)
	Net.event("Combo").OnClientEvent:Connect(function(summary)
		if type(summary) == "table" and summary.converted then
			-- the same chain in the local tracker is converted too (no
			-- "unconverted" end card for it later)
			ComboEvaluator.convert(
				controllers.MovementController.combo(),
				Net.now(),
				tostring(summary.payoff or "Play")
			)
			Hud.comboConverted(summary)
		end
	end)
	Net.event("Summary").OnClientEvent:Connect(function(sum)
		if type(sum) == "table" then
			Panels.showSummary(sum)
		end
	end)
	Net.event("Profile").OnClientEvent:Connect(function(p)
		if type(p) ~= "table" then
			return
		end
		Menu.setProfile(p)
		lastLevel = p.level
	end)
	task.spawn(function()
		local ok, p = pcall(function()
			return Net.func("GetProfile"):InvokeServer()
		end)
		if ok and type(p) == "table" then
			Menu.setProfile(p)
			lastLevel = p.level
			if not p.persistent then
				Hud.toast("Progress is not being saved this session (DataStores unavailable).", C.Sloppy, 8)
			end
		end
	end)

	local lastHint = 0
	RunService.RenderStepped:Connect(function(dt)
		Hud.update(dt)
		ThrowHud.update()
		Panels.update()
		Mobile.update()
		local clock = os.clock()
		if clock - lastHint > 0.5 then
			lastHint = clock
			updateHint()
		end
	end)
	local _ = lastLevel
end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="75">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- ULTIMATE: BREAKPOINT — client bootstrap. Controllers are initialised and
-- started in dependency order with a shared registry (no circular requires).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Shared")
ReplicatedStorage:WaitForChild("UBRemotes")

local Controllers = script.Parent:WaitForChild("Controllers")

local ORDER = {
	"SettingsController",
	"InputController",
	"CameraController",
	"DiscRenderer",
	"MovementController",
	"CatchController",
	"ThrowController",
	"PoseController",
	"AudioController",
	"EffectsController",
	"UIController",
}

local controllers: { [string]: any } = {}
for _, name in ORDER do
	controllers[name] = require(Controllers:WaitForChild(name)) :: any
end

for _, name in ORDER do
	local ok, err = pcall(controllers[name].Init, controllers)
	if not ok then
		warn(string.format("[Breakpoint] %s.Init failed: %s", name, tostring(err)))
	end
end

for _, name in ORDER do
	local ok, err = pcall(controllers[name].Start)
	if not ok then
		warn(string.format("[Breakpoint] %s.Start failed: %s", name, tostring(err)))
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="76">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Hud — only what helps a decision, plus short-lived feedback that says what
	just happened (and never more than one thing in one place).

	  Top     scoreboard (score, clock, phase) with the mode chip under it:
	          "MINI 3v3 · 2 PLAYERS + 4 BOTS", "RANKED · NORMAL 7v7", or the
	          lobby line during warm-up; the attack direction; the bench line
	          ("ON THE BENCH — you're in next point"); wind.
	  Centre  the crosshair. Just above it, feedback chips: the ready-made
	          MovementController.Feedback texts ("NEED SPEED", "ONE PER JUMP",
	          "PRECISION LANDING -40 ms", 0.6 s; UIController routes them).
	          Just below it, the context line: what the movement keys do right
	          now, from MovementController.contextHint() with the bound keys
	          ("Q SNAP CUT · F BURST", "Q SWING LEFT · SPACE HOP · E SWING
	          RIGHT"); everyday meanings (Space jump, C slide, E layout) are
	          left out so the line stays short.
	  Left    the combo chain, visible from the first technique (a lone jump
	          does not count): count, points and tier word with a pop and a
	          rising tick (AudioController.comboTick) per technique, over a bar
	          that drains through the 1.5 s chain window. A chain of two or more
	          becomes a 1.2 s card when it ends ("catch or block within 2 s for
	          x2"); a conversion the server confirms shows the x2 card. The
	          optional technique labels sit under it (setting, off by default;
	          at most 3, 1.2 s each).
	  Bottom  cooldown pips labelled with the bound key ("F BURST"); a press
	          refused for cooldown flashes its pip instead of printing text.
	          The exertion bar (pulses under 25, with "release SHIFT to
	          recover"), the mark chip while you mark (hand stance + the side
	          your team forces), the stall count, and one feedback line for
	          releases and drills.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local MovementConfig = require(Shared.Config.Movement)
local ModesConfig = require(Shared.Config.Modes)
local TeamsConfig = require(Shared.Config.Teams)
local MovementSim = require(Shared.Movement.MovementSim)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Hud = {}

local controllers: any
local player = Players.LocalPlayer

local CHIP_TIME = 0.6
local CARD_TIME = 1.2
local CONVERT_CARD_TIME = 2.2
local CHAIN_ORPHAN = 0.25 -- a live chain whose window ran out without an end card fades after this
local FEED_MAX = 3
local FEED_LIFE = 1.2
local FEED_FADE = 0.3
local LOW_EXERTION = 25
local PIP_FLASH = 0.35
local CONTEXT_MAX = 3
local CONTEXT_EVERY = 0.06

-- Cooldown pips: sim readiness key, the action whose key is shown, label.
local PIPS = {
	{ key = "BurstStep", action = "Burst", label = "BURST" },
	{ key = "Dive", action = "Dive", label = "DIVE" },
	{ key = "MomentumCancel", action = "Cut", label = "PLANT" },
	{ key = "Slide", action = "Slide", label = "SLIDE" },
	{ key = "Air", action = "Cut", label = "AIR" },
}

-- Context line: actions in display order, and the labels that are just the
-- action's everyday meaning (left out).
local CONTEXT_ORDER = { "Cut", "Slide", "Burst", "Jump", "Dive" }
local PLAIN: { [string]: string } = { Jump = "JUMP", Slide = "SLIDE", Dive = "LAYOUT" }

type FeedEntry = { label: TextLabel, born: number }
type PipRef = { fill: Frame, label: TextLabel, stroke: UIStroke?, action: string, text: string }

local refs: { [string]: any } = {}
local pips: { [string]: PipRef } = {}
local pipFlashAt: { [string]: number } = {}
local feedEntries: { FeedEntry } = {}
local tweens: { [Instance]: Tween } = {}

local chainMode = "hidden" -- "hidden" | "live" | "card"
local cardUntil = 0
local chainZeroSince: number? = nil
local lastConverted: { startT: number, endT: number }? = nil
local contextText = ""
local lastContext = 0

local function now(): number
	return Net.now()
end

-- Plays a tween on `inst`, cancelling the one still running on it (so a fade
-- that started earlier can never hide a message shown after it).
local function tweenTo(inst: Instance, info: TweenInfo, goal: { [string]: any })
	local old = tweens[inst]
	if old then
		old:Cancel()
	end
	local tw = TweenService:Create(inst, info, goal)
	tweens[inst] = tw
	tw:Play()
end

local function stopTween(inst: Instance)
	local old = tweens[inst]
	if old then
		old:Cancel()
		tweens[inst] = nil
	end
end

local function pill(parent: Instance, name: string, pos: UDim2, size: UDim2, anchor: Vector2?): Frame
	local f = Theme.panel({
		Name = name,
		Position = pos,
		Size = size,
		AnchorPoint = anchor or Vector2.new(0.5, 0),
		Parent = parent,
	})
	return f
end

local function keyOf(action: string): string
	return controllers.InputController.keyLabel(action)
end

-- "Snap Cut" / "Sold Cut" / "Roll-out" ... for a technique event.
local function techName(tech: string, info: string?): string
	local name = (MovementConfig.TechNames :: any)[tech] or tech
	if tech == "PivotSwing" and info == "Sold" then
		return "Sold Swing"
	elseif info == "Restart" then
		return "Restart Cut"
	elseif info == "Sold" then
		return "Sold Cut"
	elseif info == "RollOut" then
		return "Roll-out"
	elseif info == "Explosive" then
		return "Explosive Burst"
	elseif info == "SlideHop" then
		return "Slide Hop"
	elseif info == "PlantJump" then
		return "Plant Jump"
	end
	return name
end

local function points(tech: string): number
	return (MovementConfig.ComboPoints :: any)[tech] or 0
end

function Hud.build(parent: ScreenGui, c: any)
	controllers = c

	-- scoreboard + mode chip ---------------------------------------------------
	local board = pill(parent, "Scoreboard", UDim2.new(0.5, 0, 0, 10), UDim2.fromOffset(420, 80))
	refs.teamA = Theme.label(TeamsConfig.A.Name, 18, {
		Parent = board,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.fromOffset(110, 22),
		TextColor3 = C.TeamA,
		Font = Theme.Fonts.Heavy,
	})
	refs.scoreA = Theme.label("0", 34, {
		Parent = board,
		Position = UDim2.fromOffset(14, 26),
		Size = UDim2.fromOffset(110, 34),
		Font = Theme.Fonts.Heavy,
	})
	refs.teamB = Theme.label(TeamsConfig.B.Name, 18, {
		Parent = board,
		Position = UDim2.new(1, -124, 0, 8),
		Size = UDim2.fromOffset(110, 22),
		TextColor3 = C.TeamB,
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	refs.scoreB = Theme.label("0", 34, {
		Parent = board,
		Position = UDim2.new(1, -124, 0, 26),
		Size = UDim2.fromOffset(110, 34),
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	refs.clock = Theme.label("0:00", 26, {
		Parent = board,
		Position = UDim2.new(0.5, -70, 0, 4),
		Size = UDim2.fromOffset(140, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Gold,
		Font = Theme.Fonts.Heavy,
	})
	refs.phase = Theme.label("WARMUP", 13, {
		Parent = board,
		Position = UDim2.new(0.5, -90, 0, 36),
		Size = UDim2.fromOffset(180, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})
	refs.modeChip = Theme.label("", 12, {
		Name = "ModeChip",
		Parent = board,
		Position = UDim2.new(0, 12, 0, 58),
		Size = UDim2.new(1, -24, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Accent,
	})

	-- attack direction arrow + bench line -----------------------------------------
	local arrowHolder = make("Frame", {
		Name = "Attack",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.fromOffset(260, 30),
		Parent = parent,
	})
	refs.attackArrow = Theme.label(">", 26, {
		Parent = arrowHolder,
		Size = UDim2.fromOffset(30, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	refs.attackText = Theme.label("", 14, {
		Parent = arrowHolder,
		Position = UDim2.fromOffset(34, 6),
		Size = UDim2.fromOffset(230, 18),
		TextColor3 = C.Text,
	})
	refs.bench = Theme.label("ON THE BENCH — you're in next point", 16, {
		Name = "Bench",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.fromOffset(520, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Gold,
		Font = Theme.Fonts.Heavy,
		TextStrokeTransparency = 0.6,
		Visible = false,
	})

	-- wind ----------------------------------------------------------------
	local wind = pill(parent, "Wind", UDim2.new(1, -16, 0, 10), UDim2.fromOffset(110, 44), Vector2.new(1, 0))
	refs.windArrow = Theme.label(">", 26, {
		Parent = wind,
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(28, 28),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Accent,
	})
	refs.windText = Theme.label("CALM", 14, {
		Parent = wind,
		Position = UDim2.fromOffset(40, 13),
		Size = UDim2.fromOffset(66, 18),
	})
	refs.wind = wind

	-- exertion + cooldown pips ---------------------------------------------
	local bottom = make("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(410, 46),
		Parent = parent,
	})
	local barBack = make("Frame", {
		Name = "ExertionBack",
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -8),
		Size = UDim2.new(1, 0, 0, 8),
		Parent = bottom,
		Theme.corner(4),
	})
	refs.exertion = make("Frame", {
		Name = "Exertion",
		BackgroundColor3 = C.Good,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = barBack,
		Theme.corner(4),
	})
	refs.exertionHint = Theme.label("", 13, {
		Name = "ExertionHint",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -68),
		Size = UDim2.fromOffset(410, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Sloppy,
		TextStrokeTransparency = 0.6,
		Visible = false,
	})
	local pipRow = make("Frame", {
		Name = "Pips",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = bottom,
		Theme.list(8, true),
	});
	(pipRow:FindFirstChildOfClass("UIListLayout") :: UIListLayout).HorizontalAlignment = Enum.HorizontalAlignment.Center
	for i, def in PIPS do
		local p = Theme.panel({ Name = def.key, Size = UDim2.fromOffset(74, 26), LayoutOrder = i, Parent = pipRow })
		local fill = make("Frame", {
			Name = "Fill",
			BackgroundColor3 = (Theme.TechColors :: any)[def.key] or C.Accent,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Parent = p,
			Theme.corner(10),
		}) :: Frame
		local label = Theme.label(def.label, 12, {
			Parent = p,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			RichText = true,
		})
		pips[def.key] = {
			fill = fill,
			label = label,
			stroke = p:FindFirstChildOfClass("UIStroke"),
			action = def.action,
			text = def.label,
		}
	end

	-- combo chain widget + technique feed ---------------------------------------------
	local chain = make("CanvasGroup", {
		Name = "Chain",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 18, 0.5, 0),
		Size = UDim2.fromOffset(300, 92),
		Visible = false,
		Parent = parent,
	}) :: CanvasGroup
	refs.chain = chain
	local scale = Instance.new("UIScale")
	scale.Parent = chain
	refs.chainScale = scale
	refs.chainHead = Theme.label("", 26, {
		Name = "Head",
		Parent = chain,
		Size = UDim2.fromOffset(300, 38),
		Font = Theme.Fonts.Heavy,
		RichText = true,
		TextColor3 = C.Text,
		TextStrokeTransparency = 0.6,
	})
	refs.chainLast = Theme.label("", 13, {
		Name = "Last",
		Parent = chain,
		Position = UDim2.fromOffset(2, 40),
		Size = UDim2.fromOffset(298, 18),
		TextColor3 = C.Muted,
		TextStrokeTransparency = 0.7,
	})
	local barBg = make("Frame", {
		Name = "WindowBack",
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(2, 62),
		Size = UDim2.fromOffset(200, 5),
		Parent = chain,
		Theme.corner(3),
	})
	refs.chainBarBack = barBg
	refs.chainBar = make("Frame", {
		Name = "Window",
		BackgroundColor3 = C.Gold,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = barBg,
		Theme.corner(3),
	})
	refs.chainSub = Theme.label("", 13, {
		Name = "Sub",
		Parent = chain,
		Position = UDim2.fromOffset(2, 70),
		Size = UDim2.fromOffset(298, 18),
		TextColor3 = C.Muted,
		TextStrokeTransparency = 0.7,
	})
	refs.feedList = make("Frame", {
		Name = "TechFeed",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 18, 0.5, 54),
		Size = UDim2.fromOffset(300, 80),
		Parent = parent,
		Theme.list(2),
	})

	-- feedback line (releases, drills) -----------------------------------------------
	refs.feedback = Theme.label("", 20, {
		Name = "Feedback",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(700, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		TextTransparency = 1,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	})

	-- big banner + highlight -------------------------------------------------------
	refs.banner = Theme.label("", 56, {
		Name = "Banner",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(900, 64),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextStrokeTransparency = 0.4,
		TextTransparency = 1,
	})
	refs.bannerSub = Theme.label("", 20, {
		Name = "BannerSub",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.32, 44),
		Size = UDim2.fromOffset(900, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		TextTransparency = 1,
	})
	local hl = pill(parent, "Highlight", UDim2.new(0.5, 0, 0, 156), UDim2.fromOffset(560, 54))
	hl.Visible = false
	refs.hlName = Theme.label("", 14, {
		Parent = hl,
		Position = UDim2.fromOffset(14, 4),
		Size = UDim2.new(1, -28, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})
	refs.hlText = Theme.label("", 24, {
		Parent = hl,
		Position = UDim2.fromOffset(14, 20),
		Size = UDim2.new(1, -28, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
	})
	refs.highlight = hl

	-- toasts ---------------------------------------------------------------------
	refs.toasts = make("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 66),
		Size = UDim2.fromOffset(300, 300),
		Parent = parent,
		Theme.list(6),
	})

	-- stall + mark chip ------------------------------------------------------------
	local stall = pill(parent, "Stall", UDim2.new(0.5, 0, 1, -150), UDim2.fromOffset(180, 46), Vector2.new(0.5, 1))
	stall.Visible = false
	refs.stallText = Theme.label("STALL 0", 26, {
		Parent = stall,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
	})
	refs.stall = stall
	local mark = pill(parent, "Mark", UDim2.new(0.5, 0, 1, -204), UDim2.fromOffset(360, 28), Vector2.new(0.5, 1))
	mark.Visible = false
	refs.markText = Theme.label("", 14, {
		Parent = mark,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		RichText = true,
	})
	refs.mark = mark

	-- crosshair, chips above it, context line below it ---------------------------------
	refs.crosshair = make("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Parent = parent,
		Theme.corner(3),
	})
	refs.chip = Theme.label("", 18, {
		Name = "Chip",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.5, -24),
		Size = UDim2.fromOffset(640, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	})
	refs.context = Theme.label("", 13, {
		Name = "Context",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 22),
		Size = UDim2.fromOffset(640, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Text,
		TextTransparency = 0.2,
		TextStrokeTransparency = 0.7,
		RichText = true,
	})
	refs.hint = Theme.label("", 14, {
		Name = "Hint",
		Parent = parent,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(440, 18),
		TextColor3 = C.Muted,
		RichText = true,
	})

	-- pip and context labels follow rebinds and the input scheme
	local function refreshKeys()
		for _, pip in pips do
			pip.label.Text = Theme.keyText(keyOf(pip.action), pip.text)
		end
		contextText = "\0" -- forces the context line to rebuild
	end
	controllers.SettingsController.Changed:Connect(refreshKeys)
	controllers.InputController.SchemeChanged:Connect(refreshKeys)
	refreshKeys()
end

---------------------------------------------------------------------------
-- transient messages
---------------------------------------------------------------------------

local bannerToken = 0
function Hud.banner(text: string, sub: string?, color: Color3?, duration: number?)
	bannerToken += 1
	local token = bannerToken
	local b = refs.banner :: TextLabel
	local s = refs.bannerSub :: TextLabel
	stopTween(s)
	b.Text = text
	b.TextColor3 = color or C.Text
	s.Text = sub or ""
	b.TextTransparency = 0
	s.TextTransparency = if sub then 0 else 1
	b.TextSize = 70
	tweenTo(b, TweenInfo.new(0.25, Enum.EasingStyle.Back), { TextSize = 56 })
	task.delay(duration or 1.8, function()
		if token == bannerToken then
			tweenTo(b, TweenInfo.new(0.4), { TextTransparency = 1 })
			tweenTo(s, TweenInfo.new(0.4), { TextTransparency = 1 })
		end
	end)
end

local feedbackToken = 0
function Hud.feedback(text: string, color: Color3?, duration: number?)
	feedbackToken += 1
	local token = feedbackToken
	local f = refs.feedback :: TextLabel
	stopTween(f)
	f.Text = text
	f.TextColor3 = color or C.Text
	f.TextTransparency = 0
	task.delay(duration or 1.6, function()
		if token == feedbackToken then
			tweenTo(f, TweenInfo.new(0.35), { TextTransparency = 1 })
		end
	end)
end

-- A short chip just above the crosshair (0.6 s by default); the newest
-- replaces the previous one.
local chipToken = 0
function Hud.chip(text: string, color: Color3?, duration: number?)
	chipToken += 1
	local token = chipToken
	local l = refs.chip :: TextLabel
	stopTween(l)
	l.Text = text
	l.TextColor3 = color or C.Text
	l.TextTransparency = 0
	l.TextStrokeTransparency = 0.5
	l.TextSize = 22
	tweenTo(l, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextSize = 18 })
	task.delay(duration or CHIP_TIME, function()
		if token == chipToken then
			tweenTo(l, TweenInfo.new(0.2), { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

-- Flashes a cooldown pip ("BurstStep", "Dive", "MomentumCancel", "Slide"):
-- the press was refused because that technique is still recharging.
function Hud.flashPip(key: string)
	if pips[key] then
		pipFlashAt[key] = os.clock()
	end
end

function Hud.toast(text: string, color: Color3?, duration: number?)
	local t = Theme.panel({ Size = UDim2.fromOffset(300, 40), Parent = refs.toasts })
	Theme.label(text, 15, {
		Parent = t,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		TextColor3 = color or C.Text,
		TextWrapped = true,
	})
	task.delay(duration or 4, function()
		t:Destroy()
	end)
end

local hlToken = 0
function Hud.highlight(name: string, text: string, team: string?)
	hlToken += 1
	local token = hlToken
	local hl = refs.highlight :: Frame
	refs.hlName.Text = string.upper(name)
	refs.hlText.Text = text
	local stroke = hl:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = Theme.teamColor(team)
		stroke.Transparency = 0
	end
	hl.Visible = true
	hl.Size = UDim2.fromOffset(600, 60)
	tweenTo(hl, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(560, 54) })
	task.delay(2.6, function()
		if token == hlToken then
			hl.Visible = false
		end
	end)
end

-- Optional technique label (Settings > Technique labels; off by default).
function Hud.techLabel(tech: string, quality: string, info: string?)
	if not controllers.SettingsController.get("ShowTechLabels") then
		return
	end
	if tech == "Jump" then
		return
	end
	local name = techName(tech, info)
	local label =
		Theme.label(string.upper(name) .. (if quality ~= "Clean" then "  " .. string.upper(quality) else ""), 16, {
			Parent = refs.feedList,
			Size = UDim2.new(1, 0, 0, 22),
			TextColor3 = if quality == "Clean"
				then ((Theme.TechColors :: any)[tech] or C.Text)
				else Theme.qualityColor(quality),
			Font = Theme.Fonts.Heavy,
			TextStrokeTransparency = 0.6,
		})
	table.insert(feedEntries, { label = label, born = os.clock() })
	while #feedEntries > FEED_MAX do
		local e = table.remove(feedEntries, 1)
		if e then
			e.label:Destroy()
		end
	end
end

function Hud.setHint(text: string)
	refs.hint.Text = text
end

---------------------------------------------------------------------------
-- combo chain
---------------------------------------------------------------------------

local function headText(count: number, score: number, tier: string?): string
	local tierText = ""
	if tier then
		tierText = string.format('  <font color="#%s">%s</font>', Theme.tierColor(tier):ToHex(), tier)
	end
	return string.format('<font size="34" color="#%s">x%d</font>  %d%s', C.Gold:ToHex(), count, score, tierText)
end

local function pop(strength: number)
	local sc = refs.chainScale :: UIScale
	sc.Scale = strength
	tweenTo(sc, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
end

local function showChain()
	local g = refs.chain :: CanvasGroup
	stopTween(g)
	g.GroupTransparency = 0
	g.Visible = controllers.SettingsController.get("ShowComboFeed") ~= false
end

local function hideChain()
	if chainMode == "hidden" then
		return
	end
	chainMode = "hidden"
	chainZeroSince = nil
	tweenTo(refs.chain, TweenInfo.new(0.25), { GroupTransparency = 1 })
end

-- Does a chain hold anything but jumps? (A lone jump is not worth a widget.)
local function hasKeyTech(techs: { string }): boolean
	for _, tech in techs do
		if tech ~= "Jump" and points(tech) > 0 then
			return true
		end
	end
	return false
end

-- MovementController.ComboChanged: a technique joined the local chain.
function Hud.comboChanged(total: number, gained: number, e: any)
	if gained <= 0 or type(e) ~= "table" then
		return
	end
	local c = ComboEvaluator.active(controllers.MovementController.combo(), now())
	if not c then
		return
	end
	local techs: { string } = {}
	for _, entry in c.entries do
		table.insert(techs, entry.tech)
	end
	if not hasKeyTech(techs) then
		return
	end
	chainMode = "live"
	chainZeroSince = nil
	refs.chainHead.Text = headText(c.scoring, total, ComboEvaluator.tier(total))
	refs.chainLast.Text = string.upper(techName(e.tech, e.info))
		.. (if e.quality ~= "Clean" then "  ·  " .. string.upper(e.quality) else "")
	refs.chainLast.TextColor3 = if e.quality == "Clean"
		then ((Theme.TechColors :: any)[e.tech] or C.Muted)
		else Theme.qualityColor(e.quality)
	refs.chainSub.Text = ""
	refs.chainBarBack.Visible = true
	showChain()
	pop(if e.quality == "Perfect" then 1.3 else 1.16)
	if e.tech ~= "Jump" then
		controllers.AudioController.comboTick(c.scoring, e.quality == "Perfect")
	end
end

-- MovementController.ChainEnded: the local chain timed out (unconverted).
function Hud.chainEnded(summary: any)
	if type(summary) ~= "table" then
		return
	end
	local conv = lastConverted
	if conv and summary.startT <= conv.endT + 0.05 and summary.endT >= conv.startT - 0.05 then
		return -- the server already converted this chain; its card is showing
	end
	if (summary.count or 0) < 2 or not hasKeyTech(summary.techs or {}) then
		if chainMode == "live" then
			hideChain()
		end
		return
	end
	chainMode = "card"
	cardUntil = os.clock() + CARD_TIME
	refs.chainHead.Text = headText(summary.count, summary.total, summary.tier)
	refs.chainLast.Text = "CHAIN COMPLETE"
	refs.chainLast.TextColor3 = C.Text
	refs.chainSub.Text = "catch or block within 2 s for x2"
	refs.chainBarBack.Visible = false
	showChain()
	pop(1.08)
	if summary.tier then
		controllers.AudioController.play("ComboEnd")
	end
end

-- The server's Combo event: a chain was converted by a catch / block / D.
function Hud.comboConverted(summary: any)
	if type(summary) ~= "table" or not summary.converted then
		return
	end
	lastConverted = {
		startT = if type(summary.startT) == "number" then summary.startT else now(),
		endT = if type(summary.endT) == "number" then summary.endT else now(),
	}
	chainMode = "card"
	cardUntil = os.clock() + CONVERT_CARD_TIME
	refs.chainHead.Text = headText(summary.count or 0, summary.score or 0, summary.tier)
	refs.chainLast.Text = string.upper(tostring(summary.payoff or "PLAY")) .. "  ·  CHAIN CONVERTED  x2"
	refs.chainLast.TextColor3 = C.Gold
	refs.chainSub.Text = ""
	refs.chainBarBack.Visible = false
	showChain()
	pop(1.35)
	controllers.AudioController.play("ComboConvert")
end

local function updateChain(t: number, clock: number)
	if chainMode == "live" then
		local left = ComboEvaluator.windowLeft(controllers.MovementController.combo(), t)
		refs.chainBar.Size = UDim2.fromScale(left, 1)
		refs.chainBar.BackgroundColor3 = if left > 0.35 then C.Gold else C.Sloppy
		if left <= 0 then
			-- the end card normally follows at once; fade if it never comes
			local since = chainZeroSince or clock
			chainZeroSince = since
			if clock - since > CHAIN_ORPHAN then
				hideChain()
			end
		end
	elseif chainMode == "card" and clock > cardUntil then
		hideChain()
	end
	if chainMode ~= "hidden" then
		refs.chain.Visible = controllers.SettingsController.get("ShowComboFeed") ~= false
	end
end

---------------------------------------------------------------------------
-- per-frame
---------------------------------------------------------------------------

local function screenArrowRotation(worldDir: Vector3): number
	local yaw = controllers.CameraController.getYaw()
	local camForward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local camRight = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	local x = worldDir:Dot(camRight)
	local y = worldDir:Dot(camForward)
	-- the glyph points right (+x screen) at 0 degrees; up the screen = -90
	return math.deg(math.atan2(-y, x))
end

local function attrNumber(inst: Instance, name: string): number
	local v = inst:GetAttribute(name)
	return if type(v) == "number" then v else 0
end

-- "MINI 3v3 · 2 PLAYERS + 4 BOTS" / "RANKED · NORMAL 7v7 · 14 PLAYERS" /
-- the lobby line during warm-up.
local function modeChipText(state: Instance, phase: string): string
	if phase == "Intermission" or phase == "Boot" then
		local lobby = state:GetAttribute("Lobby")
		if type(lobby) == "string" and lobby ~= "" then
			return string.upper(lobby)
		end
		return if state:GetAttribute("RankedNext") == true then "NEXT MATCH IS RANKED" else ""
	end
	local modeId = state:GetAttribute("Mode")
	local rules = if type(modeId) == "string" then ModesConfig.List[modeId] else nil
	local name = if rules then string.upper(rules.id) .. " " .. rules.Short else string.upper(tostring(modeId or ""))
	local humans = attrNumber(state, "HumansA") + attrNumber(state, "HumansB")
	local bots = attrNumber(state, "BotsA") + attrNumber(state, "BotsB")
	local count = string.format("%d PLAYER%s", humans, if humans == 1 then "" else "S")
	if bots > 0 then
		count ..= string.format(" + %d BOT%s", bots, if bots == 1 then "" else "S")
	end
	local text = name .. "  ·  " .. count
	if state:GetAttribute("Ranked") == true then
		text = "RANKED  ·  " .. text
	end
	return text
end

-- The context line: the non-obvious things the movement keys do right now.
local function buildContext(): string
	local hint = controllers.MovementController.contextHint()
	local entries: { { label: string, keys: { string } } } = {}
	for _, action in CONTEXT_ORDER do
		local label = hint[action]
		if label and label ~= PLAIN[action] then
			local key = keyOf(action)
			local merged = false
			for _, entry in entries do
				if entry.label == label then
					if key ~= "" then
						table.insert(entry.keys, key)
					end
					merged = true
					break
				end
			end
			if not merged and #entries < CONTEXT_MAX then
				table.insert(entries, { label = label, keys = if key ~= "" then { key } else {} })
			end
		end
	end
	local parts: { string } = {}
	for _, entry in entries do
		table.insert(parts, Theme.keyText(table.concat(entry.keys, "/"), entry.label))
	end
	return table.concat(parts, "  ·  ")
end

local function exertionHint(): string
	local key = keyOf("Sprint")
	if key ~= "" and not controllers.SettingsController.get("AutoSprint") then
		return string.format("LOW ENERGY — release %s to recover", key)
	end
	return "LOW ENERGY — ease off to a jog to recover"
end

function Hud.update(_dt: number)
	local state = Net.state()
	local t = now()
	local clock = os.clock()
	local phase: string = (state:GetAttribute("Phase") or "Boot") :: string
	refs.scoreA.Text = tostring(state:GetAttribute("ScoreA") or 0)
	refs.scoreB.Text = tostring(state:GetAttribute("ScoreB") or 0)
	local matchEnd = state:GetAttribute("MatchEnd")
	local phaseEnd = state:GetAttribute("PhaseEnd")
	if phase == "Intermission" then
		refs.clock.Text = if type(phaseEnd) == "number" and phaseEnd > 0
			then Theme.formatTime(phaseEnd - t)
			else "--:--"
		refs.phase.Text = "WARMUP · press M to vote"
	else
		refs.clock.Text = if type(matchEnd) == "number" then Theme.formatTime(matchEnd - t) else "0:00"
		local label = string.upper(phase)
		if phase == "PointSetup" and type(phaseEnd) == "number" then
			label = "LINE UP  " .. math.max(0, math.ceil(phaseEnd - t))
		elseif phase == "PointOver" then
			label = "GOAL"
		elseif state:GetAttribute("Universe") then
			label = "UNIVERSE POINT"
		elseif state:GetAttribute("CapReached") then
			label = "CAP · FINISH THE POINT"
		end
		refs.phase.Text = label
	end
	local chipText = modeChipText(state, phase)
	refs.modeChip.Text = chipText
	refs.modeChip.TextColor3 = if state:GetAttribute("Ranked") == true then C.Gold else C.Accent

	-- attack direction + bench
	local character = player.Character
	local myTeam = if character then character:GetAttribute("UBTeam") else nil
	local role = if character then character:GetAttribute("UBRole") else nil
	if (myTeam == "A" or myTeam == "B") and phase ~= "Intermission" then
		local side = state:GetAttribute(if myTeam == "A" then "AttackA" else "AttackB")
		local dir = if side == "East" then Vector3.new(1, 0, 0) else Vector3.new(-1, 0, 0)
		refs.attackArrow.Rotation = screenArrowRotation(dir)
		refs.attackArrow.TextColor3 = Theme.teamColor(myTeam)
		local offense = state:GetAttribute("Offense")
		refs.attackText.Text = if offense == myTeam
			then "YOUR DISC · ATTACK THIS WAY"
			else "DEFENSE · STOP THEM SCORING"
		refs.attackArrow.Visible = true
	else
		refs.attackArrow.Visible = false
		refs.attackText.Text = ""
	end
	refs.bench.Visible = role == "Bench" and phase ~= "Intermission"

	-- wind
	local w = state:GetAttribute("Wind")
	if typeof(w) == "Vector3" and w.Magnitude > 0.1 then
		refs.wind.Visible = true
		refs.windArrow.Rotation = screenArrowRotation(Vector3.new(w.X, 0, w.Z).Unit)
		refs.windText.Text = string.format("WIND %.0f", w.Magnitude)
	else
		refs.wind.Visible = false
	end

	-- exertion and cooldown pips
	local sim = controllers.MovementController.sim()
	local ex = sim.exertion / MovementConfig.ExertionMax
	local bar = refs.exertion :: Frame
	bar.Size = UDim2.fromScale(math.clamp(ex, 0, 1), 1)
	bar.BackgroundColor3 = if ex > 0.5 then C.Good elseif ex > 0.2 then C.Gold else C.Bad
	local low = sim.exertion < LOW_EXERTION
	bar.BackgroundTransparency = if low then 0.3 + 0.3 * math.sin(clock * 9) else 0
	refs.exertionHint.Visible = low
	if low then
		refs.exertionHint.Text = exertionHint()
	end
	for key, pip in pips do
		local ready: number
		if key == "Air" then
			ready = if sim.airRedirectUsed then 0 else 1
		else
			ready = MovementSim.readiness(sim, key)
		end
		pip.fill.Size = UDim2.fromScale(ready, 1)
		pip.fill.BackgroundTransparency = if ready >= 1 then 0.45 else 0.75
		local stroke = pip.stroke
		if stroke then
			local flashing = clock - (pipFlashAt[key] or -math.huge) < PIP_FLASH
			stroke.Color = if flashing then C.Bad else C.Stroke
			stroke.Thickness = if flashing then 2 else 1
			stroke.Transparency = if flashing then 0 else 0.3
		end
	end

	-- combo chain + technique feed
	updateChain(t, clock)
	for i = #feedEntries, 1, -1 do
		local e = feedEntries[i]
		local age = clock - e.born
		if age > FEED_LIFE then
			e.label:Destroy()
			table.remove(feedEntries, i)
		elseif age > FEED_LIFE - FEED_FADE then
			e.label.TextTransparency = (age - (FEED_LIFE - FEED_FADE)) / FEED_FADE
		end
	end

	-- stall
	local holderId = state:GetAttribute("HolderId")
	local stall: number = (state:GetAttribute("Stall") or 0) :: number
	local stallMax: number = (state:GetAttribute("StallMax") or 10) :: number
	local stallState = state:GetAttribute("StallState") or "None"
	local inPlay = phase == "Live" and type(holderId) == "number" and holderId ~= 0
	local involved = holderId == player.UserId or state:GetAttribute("MarkerId") == player.UserId
	refs.stall.Visible = inPlay and involved
	if inPlay then
		local text = "STALL " .. tostring(stall)
		if stallState == "DoubleTeam" then
			text = "DOUBLE TEAM"
		elseif stallState == "DiscSpace" then
			text = "DISC SPACE"
		elseif stallState == "Unmarked" then
			text = "NO MARK"
		end
		refs.stallText.Text = text
		refs.stallText.TextColor3 = if stall >= stallMax - 3
			then C.Bad
			elseif stall >= stallMax - 5 then C.Gold
			else C.Text
	end

	-- mark chip: your hands and the side your team forces
	local marking = controllers.CatchController.isMarking()
	refs.mark.Visible = marking
	if marking then
		local stance = string.upper(controllers.CatchController.markStance())
		local force = state:GetAttribute(if myTeam == "B" then "ForceB" else "ForceA")
		local parts = { stance .. " HANDS" }
		if (myTeam == "A" or myTeam == "B") and (force == "FH" or force == "BH") then
			table.insert(parts, "FORCE " .. force)
		end
		table.insert(parts, Theme.keyText(keyOf("Slide"), "SWITCH"))
		refs.markText.Text = table.concat(parts, "  ·  ")
	end

	-- crosshair + context line
	local locked = controllers.CameraController.isLocked()
	refs.crosshair.Visible = locked
	refs.context.Visible = locked
	if locked and clock - lastContext >= CONTEXT_EVERY then
		lastContext = clock
		local text = buildContext()
		if text ~= contextText then
			contextText = text
			refs.context.Text = text
		end
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Menu — Play, Training, Profile, Locker, Leaderboard, Settings, Controls.

	Play: join / training, then during warm-up the mode choice. On a public
	server only the modes the head count allows are offered (UBState
	VoteModes; Mini up to 9 players, Normal from 7), each other mode says how
	many players it needs, and a single eligible mode is shown as decided
	rather than as a vote. The ranked line comes from RankedNext /
	RankedStatus / RankedReady ("4/6"). In a private server or Studio the
	host picks the mode (PrivateConfig Mode), edits the rules in
	Modes.EditableOrder (labels from Modes.Editable, values from the chosen
	mode's preset) and can START MATCH NOW; ranked is always off there. The
	page refreshes itself while open when the vote state changes.

	Controls: rebinding, sprint options (AutoSprint, ToggleSprint) and a
	technique guide written with the keys you have bound.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ModesConfig = require(Shared.Config.Modes)
local ArenasConfig = require(Shared.Config.Arenas)
local InputConfig = require(Shared.Config.Input)
local MovementConfig = require(Shared.Config.Movement)
local DiscConfig = require(Shared.Config.Disc)
local ProgressionConfig = require(Shared.Config.Progression)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Menu = {}

local controllers: any
local player = Players.LocalPlayer
local refs: { [string]: any } = {}
local isOpen = false
local currentTab = "Play"
local profile: any = nil
local rebinding: { action: string, button: TextButton }? = nil
local launcher = { throwType = "Backhand", power = 0.5, pitch = 10, bank = 0, offset = 0 }

local TABS = { "Play", "Training", "Profile", "Locker", "Leaderboard", "Settings", "Controls" }

-- UBState attributes the Play tab shows (it refreshes when they change).
local PLAY_STATE = {
	"Phase",
	"VoteModes",
	"VoteCounts",
	"VoteDefault",
	"VoteArenas",
	"RankedReady",
	"RankedStatus",
	"RankedNext",
	"PrivateConfig",
	"HostId",
	"Ranked",
	"ModeName",
}

local DRILLS: { any } = {
	{ id = "Tutorial", name = "Movement School", desc = "Every technique, step by step.", pb = nil },
	{
		id = "Cutting",
		name = "Cutting Course",
		desc = "Slalom time trial. Keep your speed through the gates.",
		pb = "time",
	},
	{
		id = "Shuttle",
		name = "Momentum Shuttle",
		desc = "A-B-A-B-A. Reverse direction without losing it.",
		pb = "time",
	},
	{ id = "Aerial", name = "Aerial Catch", desc = "10 launches: floaters, skimmers, layouts.", pb = "score" },
	{ id = "Range", name = "Throwing Range", desc = "10 throws at static and moving rings.", pb = "score" },
	{ id = "Interception", name = "Interception Drill", desc = "Read the thrower. Get the D.", pb = "score" },
	{ id = "Combo", name = "Combo Lab", desc = "Land eight technique chains. Rebound walls inside.", pb = nil },
	{
		id = "BreakMark",
		name = "Break the Mark",
		desc = "Beat a bot marker from your pivot: step out, fake, swing, release.",
		pb = "score",
	},
}

-- The technique guide, written with the keys currently bound (keyboard).
local function techGuide(): { string }
	local function k(action: string): string
		local label = controllers.SettingsController.keyLabel(action, "keyboard")
		return if label ~= "" then label else "(unbound)"
	end
	local cut, burst, slide, dive, jump = k("Cut"), k("Burst"), k("Slide"), k("Dive"), k("Jump")
	return {
		string.format(
			"RUN — move to run; sprint starts by itself when you push one way (AutoSprint), or hold %s.",
			k("Sprint")
		),
		string.format(
			"SNAP CUT — while running, steer to the new direction and tap %s (hold A or D, then %s). A longer straight line before it = Perfect.",
			cut,
			cut
		),
		string.format(
			"PLANT — tap %s with S held (or no direction) at speed: you stop dead. Hold a direction to restart; %s, %s or %s just after = a faster restart.",
			cut,
			cut,
			burst,
			jump
		),
		string.format(
			"FAKE COMMIT — %s along your line without steering: a jab. Cut away within 0.6 s for a Sold cut (always Perfect).",
			cut
		),
		string.format(
			"BURST — %s. A short explosive push (1.2 s cooldown). Perfect right after a cut, slide cut or pop-up; free out of a plant.",
			burst
		),
		string.format(
			"SLIDE / SLIDE CUT — %s while running. %s mid-slide leaves at a new angle; %s bursts out.",
			slide,
			cut,
			burst
		),
		string.format(
			"AIR REDIRECT — %s in the air with a direction held: bend your path once per jump. Near the apex = Perfect.",
			cut
		),
		string.format(
			"PRECISION LANDING — %s just before touchdown keeps your speed. After a dive it is a Roll-out.",
			slide
		),
		string.format(
			"LAYOUT — %s. A huge reach. Pop up with %s, %s or %s as the slide stops.",
			dive,
			jump,
			cut,
			burst
		),
		string.format(
			"WALL REBOUND — %s beside a glowing Rebound wall while airborne (special arenas and the Combo Lab).",
			jump
		),
		"CHAINS — techniques within 1.5 s of each other chain. A catch, block or interception within 2 s converts the chain: x2 points and a highlight.",
		string.format(
			"WITH THE DISC — WASD steps your free foot around the pivot (the coloured disc under you). %s / %s swing left / right, RMB fakes, %s hops for a high release, hold %s to release low. Fake, swing, release fast = BREAK.",
			cut,
			dive,
			jump,
			slide
		),
		string.format(
			"MARK — hold RMB near the thrower: shuffle and keep your hands in the lane. %s switches Low / High hands; jump to block a hop.",
			slide
		),
		"REACH — LMB without the disc: extend toward your aim for a moment. Airborne reaches are Aerial Catch Adjustments.",
	}
end

local function clear(frame: Instance)
	for _, ch in frame:GetChildren() do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
			ch:Destroy()
		end
	end
end

local function section(parent: Instance, title: string, order: number)
	Theme.label(title, 20, {
		Parent = parent,
		LayoutOrder = order,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Accent,
	})
end

local function row(parent: Instance, order: number, height: number?): Frame
	local f = make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, height or 40),
		LayoutOrder = order,
		Parent = parent,
		Theme.list(8, true),
	}) :: Frame;
	(f:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
	return f
end

local function action(kind: string, payload: any)
	Net.event("Action"):FireServer(kind, payload)
	controllers.AudioController.play("UiClick")
end

local function stepper(
	parent: Instance,
	order: number,
	label: string,
	value: string,
	onMinus: () -> (),
	onPlus: () -> ()
)
	local r = row(parent, order, 36)
	Theme.label(label, 15, { Parent = r, Size = UDim2.fromOffset(250, 30), LayoutOrder = 1 })
	local minus = Theme.button("-", { Parent = r, Size = UDim2.fromOffset(36, 30), LayoutOrder = 2 })
	Theme.label(
		value,
		15,
		{ Parent = r, Size = UDim2.fromOffset(90, 30), LayoutOrder = 3, TextXAlignment = Enum.TextXAlignment.Center }
	)
	local plus = Theme.button("+", { Parent = r, Size = UDim2.fromOffset(36, 30), LayoutOrder = 4 })
	minus.Activated:Connect(onMinus)
	plus.Activated:Connect(onPlus)
end

local function toggleRow(parent: Instance, order: number, label: string, value: boolean, onToggle: () -> ())
	local r = row(parent, order, 36)
	Theme.label(label, 15, { Parent = r, Size = UDim2.fromOffset(250, 30), LayoutOrder = 1 })
	local b = Theme.button(if value then "ON" else "OFF", {
		Parent = r,
		Size = UDim2.fromOffset(80, 30),
		LayoutOrder = 2,
		BackgroundColor3 = if value then C.Good else C.PanelLight,
		TextColor3 = if value then Color3.new(0, 0, 0) else C.Text,
	})
	b.Activated:Connect(onToggle)
end

---------------------------------------------------------------------------
-- tabs
---------------------------------------------------------------------------

local render: { [string]: (Instance) -> () } = {}

local function attrString(inst: Instance, name: string): string
	local v = inst:GetAttribute(name)
	return if type(v) == "string" then v else ""
end

local function decodeJson(text: string): { [string]: any }
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(if text ~= "" then text else "{}")
	end)
	return if ok and type(decoded) == "table" then decoded else {}
end

local function modeName(id: string?): string
	local m = if id then ModesConfig.List[id] else nil
	return if m then m.Display else tostring(id or "")
end

-- Head counts each mode is offered for (from Modes.eligible), for the
-- "needs N players" hints.
local ELIGIBLE: { [string]: { min: number, max: number } } = {}
for n = 1, 32 do
	local options = ModesConfig.eligible(n)
	for _, id in options do
		local r = ELIGIBLE[id]
		if r then
			r.max = n
		else
			ELIGIBLE[id] = { min = n, max = n }
		end
	end
end

local function needsText(id: string): string
	local r = ELIGIBLE[id]
	if not r then
		return "not available"
	elseif r.min > 1 then
		return string.format("needs %d+ players", r.min)
	elseif r.max < 32 then
		return string.format("up to %d players", r.max)
	end
	return ""
end

local function formatRule(key: string, value: any): string
	if type(value) ~= "number" then
		return tostring(value)
	elseif key == "TimeCap" then
		return Theme.formatTime(value)
	elseif key == "PreviewFraction" then
		return string.format("%d%%", math.floor(value * 100 + 0.5))
	elseif key == "StallInterval" then
		return string.format("%.1f s", value)
	end
	return tostring(value)
end

local myVote: string? = nil

local function modeButton(parent: Instance, order: number, text: string, selected: boolean, onPick: () -> ())
	local b = Theme.button(text, {
		Parent = parent,
		LayoutOrder = order,
		Size = UDim2.fromOffset(190, 38),
		BackgroundColor3 = if selected then C.Accent else C.PanelLight,
		TextColor3 = if selected then Color3.new(0, 0, 0) else C.Text,
	})
	b.Activated:Connect(onPick)
end

function render.Play(content: Instance)
	local state = Net.state()
	local phase = attrString(state, "Phase")
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	local function note(text: string, color: Color3?)
		Theme.label(text, 14, {
			Parent = content,
			LayoutOrder = nextOrder(),
			TextColor3 = color or C.Muted,
			TextWrapped = true,
			Size = UDim2.new(1, -10, 0, 20),
		})
	end
	section(content, "PLAY", nextOrder())
	note(
		string.format(
			"%s  ·  %s  ·  %s",
			if phase ~= "" then phase else "Warmup",
			if attrString(state, "ModeName") ~= "" then attrString(state, "ModeName") else "Warm-up",
			attrString(state, "ArenaName")
		)
	)
	local role = if player.Character then player.Character:GetAttribute("UBRole") else nil
	local r = row(content, nextOrder(), 44)
	if role == "Bench" then
		Theme.label("ON THE BENCH — you play next point", 15, {
			Parent = r,
			LayoutOrder = 1,
			Size = UDim2.fromOffset(330, 30),
			TextColor3 = C.Gold,
			Font = Theme.Fonts.Heavy,
		})
	elseif role ~= "Match" then
		local join = Theme.button(
			"JOIN MATCH",
			{ Parent = r, LayoutOrder = 1, BackgroundColor3 = C.Accent, TextColor3 = Color3.new(0, 0, 0) }
		)
		join.Activated:Connect(function()
			action("JoinMatch", nil)
			Menu.toggle(false)
		end)
	end
	local train = Theme.button("TRAINING GROUNDS", { Parent = r, LayoutOrder = 2, Size = UDim2.fromOffset(200, 38) })
	train.Activated:Connect(function()
		action("EnterTraining", nil)
		Menu.toggle(false)
	end)

	local hostId = state:GetAttribute("HostId")
	local hosted = type(hostId) == "number" and hostId ~= 0
	local isHost = hosted and hostId == player.UserId
	local private = decodeJson(attrString(state, "PrivateConfig"))
	local default = attrString(state, "VoteDefault")
	if not ModesConfig.has(default) then
		default = ModesConfig.Default
	end
	local nextMode: string = if ModesConfig.has(private.Mode) then private.Mode else default

	if phase == "Intermission" then
		local counts = decodeJson(attrString(state, "VoteCounts"))
		local modeCounts = if type(counts.mode) == "table" then counts.mode else {}
		local options: { string } = {}
		for _, id in string.split(attrString(state, "VoteModes"), ",") do
			if ModesConfig.has(id) then
				table.insert(options, id)
			end
		end
		section(content, "NEXT MATCH: MODE", nextOrder())
		if isHost then
			local mr = row(content, nextOrder(), 44)
			for i, id in ModesConfig.Order do
				modeButton(mr, i, modeName(id), id == nextMode, function()
					action("PrivateConfig", { key = "Mode", value = id })
					task.delay(0.3, Menu.refresh, true)
				end)
			end
			note(
				"You are the host: you pick the mode and the rules below. Ranked is off in private servers and Studio."
			)
		elseif hosted and ModesConfig.has(private.Mode) then
			note("The host picked " .. modeName(nextMode) .. ".", C.Text)
		else
			if #options > 1 then
				note(
					if hosted
						then "Vote for a mode (the host has the final say)."
						else "This many players can play either mode: vote."
				)
				local mr = row(content, nextOrder(), 44)
				for i, id in options do
					local n = tonumber(modeCounts[id]) or 0
					modeButton(mr, i, string.format("%s (%d)", modeName(id), n), id == myVote, function()
						myVote = id
						action("Vote", { mode = id })
						task.delay(0.3, Menu.refresh, true)
					end)
				end
			else
				note(modeName(options[1] or default) .. " — set by the number of players", C.Text)
			end
			for _, id in ModesConfig.Order do
				if not table.find(options, id) then
					note(modeName(id) .. " — " .. needsText(id))
				end
			end
		end
		if not hosted then
			local ready = attrString(state, "RankedReady")
			if state:GetAttribute("RankedNext") == true then
				note("RANKED — every spot is a player" .. (if ready ~= "" then " (" .. ready .. ")" else ""), C.Gold)
			else
				local status = attrString(state, "RankedStatus")
				note("UNRANKED — " .. (if status ~= "" then status else "ranked needs every spot filled by a player"))
			end
		end

		section(content, "NEXT MATCH: ARENA", nextOrder())
		local arenaCounts = if type(counts.arena) == "table" then counts.arena else {}
		local ar = row(content, nextOrder(), 44)
		for i, id in string.split(attrString(state, "VoteArenas"), ",") do
			local a = (ArenasConfig.List :: any)[id]
			if a then
				local n = tonumber(arenaCounts[id]) or 0
				local b = Theme.button(
					string.format("%s (%d)", a.Display, n),
					{ Parent = ar, LayoutOrder = i, Size = UDim2.fromOffset(200, 38), TextSize = 13 }
				)
				b.Activated:Connect(function()
					action("Vote", { arena = id })
					task.delay(0.3, Menu.refresh, true)
				end)
			end
		end
	elseif state:GetAttribute("Ranked") == true then
		note("This match is RANKED. Leaving counts as a loss.", C.Gold)
	end

	if isHost then
		section(content, "HOST RULES (private server / Studio)", nextOrder())
		if phase ~= "Intermission" then
			note("Changes apply from the next match.")
		end
		local base = ModesConfig.editableDefaults(nextMode)
		for _, key in ModesConfig.EditableOrder do
			local spec = ModesConfig.Editable[key]
			if key ~= "Mode" and spec then
				local value = if private[key] ~= nil then private[key] else base[key]
				local function send(v: any)
					action("PrivateConfig", { key = key, value = v })
					task.delay(0.3, Menu.refresh, true)
				end
				local options = spec.options
				if spec.bool then
					toggleRow(content, nextOrder(), spec.label, value == true, function()
						send(not (value == true))
					end)
				elseif options then
					local idx = table.find(options, value) or 1
					stepper(content, nextOrder(), spec.label, tostring(value), function()
						send(options[((idx - 2) % #options) + 1])
					end, function()
						send(options[(idx % #options) + 1])
					end)
				else
					local v = tonumber(value) or 0
					local step = spec.step or 1
					stepper(content, nextOrder(), spec.label, formatRule(key, v), function()
						send(v - step)
					end, function()
						send(v + step)
					end)
				end
			end
		end
		if phase == "Intermission" then
			local sr = row(content, nextOrder(), 44)
			local start = Theme.button("START MATCH NOW", {
				Parent = sr,
				Size = UDim2.fromOffset(200, 38),
				BackgroundColor3 = C.Good,
				TextColor3 = Color3.new(0, 0, 0),
			})
			start.Activated:Connect(function()
				action("StartNow", nil)
				Menu.toggle(false)
			end)
		end
	end

	section(content, "QUICK CONTROLS", nextOrder())
	local function k(a: string): string
		return controllers.SettingsController.keyLabel(a, "keyboard")
	end
	Theme.label(
		string.format(
			"WASD move · %s sprint (or automatic) · %s jump · %s cut · %s burst · %s slide · %s dive · LMB reach / throw · RMB mark / fake · with the disc: WASD step, %s / %s swing, %s hop · %s celebrate",
			k("Sprint"),
			k("Jump"),
			k("Cut"),
			k("Burst"),
			k("Slide"),
			k("Dive"),
			k("Cut"),
			k("Dive"),
			k("Jump"),
			k("Celebrate")
		),
		14,
		{
			Parent = content,
			LayoutOrder = nextOrder(),
			TextWrapped = true,
			Size = UDim2.new(1, -10, 0, 40),
			TextColor3 = C.Muted,
		}
	)
end

function render.Training(content: Instance)
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	section(content, "TRAINING GROUNDS", nextOrder())
	local r = row(content, nextOrder(), 44)
	local enter = Theme.button("GO TO TRAINING", {
		Parent = r,
		LayoutOrder = 1,
		Size = UDim2.fromOffset(180, 38),
		BackgroundColor3 = C.Accent,
		TextColor3 = Color3.new(0, 0, 0),
	})
	enter.Activated:Connect(function()
		action("EnterTraining", nil)
		Menu.toggle(false)
	end)
	local leave = Theme.button("BACK TO MATCH", { Parent = r, LayoutOrder = 2, Size = UDim2.fromOffset(180, 38) })
	leave.Activated:Connect(function()
		action("LeaveTraining", nil)
		Menu.toggle(false)
	end)
	local cancel = Theme.button("CANCEL DRILL", { Parent = r, LayoutOrder = 3, Size = UDim2.fromOffset(160, 38) })
	cancel.Activated:Connect(function()
		action("CancelDrill", nil)
	end)
	for _, d in DRILLS do
		local dr = row(content, nextOrder(), 46)
		local pbs = if profile then profile.personalBests else nil
		local pbValue = pbs and pbs[d.id]
		local pbText = if pbValue
			then (if d.pb == "time" then string.format("PB %.2f s", pbValue) else string.format("PB %d", pbValue))
			else ""
		local done = profile and profile.drillsDone and profile.drillsDone[d.id]
		Theme.label(
			(if done then "[x] " else "") .. d.name,
			16,
			{ Parent = dr, LayoutOrder = 1, Size = UDim2.fromOffset(200, 30), Font = Theme.Fonts.Heavy }
		)
		Theme.label(
			d.desc,
			13,
			{ Parent = dr, LayoutOrder = 2, Size = UDim2.fromOffset(330, 30), TextColor3 = C.Muted, TextWrapped = true }
		)
		Theme.label(pbText, 13, { Parent = dr, LayoutOrder = 3, Size = UDim2.fromOffset(90, 30), TextColor3 = C.Gold })
		local go = Theme.button("START", { Parent = dr, LayoutOrder = 4, Size = UDim2.fromOffset(80, 32) })
		go.Activated:Connect(function()
			action("StartDrill", d.id)
			Menu.toggle(false)
		end)
	end

	section(content, "FREE LAUNCHER (advanced practice)", nextOrder())
	stepper(content, nextOrder(), "Throw type", launcher.throwType, function()
		local i = table.find(DiscConfig.TypeOrder, launcher.throwType) or 1
		launcher.throwType = DiscConfig.TypeOrder[((i - 2) % #DiscConfig.TypeOrder) + 1]
		Menu.refresh(true)
	end, function()
		local i = table.find(DiscConfig.TypeOrder, launcher.throwType) or 1
		launcher.throwType = DiscConfig.TypeOrder[(i % #DiscConfig.TypeOrder) + 1]
		Menu.refresh(true)
	end)
	stepper(content, nextOrder(), "Power", string.format("%d%%", launcher.power * 100), function()
		launcher.power = math.clamp(launcher.power - 0.1, 0.1, 1)
		Menu.refresh(true)
	end, function()
		launcher.power = math.clamp(launcher.power + 0.1, 0.1, 1)
		Menu.refresh(true)
	end)
	stepper(content, nextOrder(), "Launch angle", launcher.pitch .. " deg", function()
		launcher.pitch = math.clamp(launcher.pitch - 4, -10, 40)
		Menu.refresh(true)
	end, function()
		launcher.pitch = math.clamp(launcher.pitch + 4, -10, 40)
		Menu.refresh(true)
	end)
	stepper(content, nextOrder(), "Curve (bank)", string.format("%+.1f", launcher.bank), function()
		launcher.bank = math.clamp(launcher.bank - 0.25, -1, 1)
		Menu.refresh(true)
	end, function()
		launcher.bank = math.clamp(launcher.bank + 0.25, -1, 1)
		Menu.refresh(true)
	end)
	stepper(content, nextOrder(), "Aim offset", launcher.offset .. " deg", function()
		launcher.offset = math.clamp(launcher.offset - 5, -30, 30)
		Menu.refresh(true)
	end, function()
		launcher.offset = math.clamp(launcher.offset + 5, -30, 30)
		Menu.refresh(true)
	end)
	local lr = row(content, nextOrder(), 44)
	local launch = Theme.button(
		"LAUNCH",
		{ Parent = lr, Size = UDim2.fromOffset(160, 38), BackgroundColor3 = C.Gold, TextColor3 = Color3.new(0, 0, 0) }
	)
	launch.Activated:Connect(function()
		local role = if player.Character then player.Character:GetAttribute("UBRole") else nil
		if role ~= "Training" then
			action("StartDrill", "Launcher")
			task.wait(0.4)
		end
		action("LaunchCustom", launcher)
		Menu.toggle(false)
	end)
	local setup = Theme.button("GO TO LAUNCHER", { Parent = lr, Size = UDim2.fromOffset(180, 38) })
	setup.Activated:Connect(function()
		action("StartDrill", "Launcher")
	end)
end

function render.Profile(content: Instance)
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	if not profile then
		Theme.label("Loading profile...", 16, { Parent = content, LayoutOrder = 1 })
		return
	end
	section(content, string.format("LEVEL %d", profile.level), nextOrder())
	local bar = make("Frame", {
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -10, 0, 10),
		LayoutOrder = nextOrder(),
		Parent = content,
		Theme.corner(5),
	})
	make("Frame", {
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(math.clamp(profile.xpInto / math.max(profile.xpNeed, 1), 0, 1), 1),
		Parent = bar,
		Theme.corner(5),
	})
	Theme.label(
		string.format(
			"%d / %d XP to next level%s",
			profile.xpInto,
			profile.xpNeed,
			if profile.persistent then "" else "  (not saved this session)"
		),
		13,
		{
			Parent = content,
			LayoutOrder = nextOrder(),
			TextColor3 = C.Muted,
		}
	)
	section(
		content,
		string.format(
			"RANKED: %s  %d  (peak %d, %d games)",
			profile.division,
			profile.rating,
			profile.peakRating,
			profile.ratedGames
		),
		nextOrder()
	)
	section(content, "CAREER", nextOrder())
	local keys = {
		"matches",
		"wins",
		"goals",
		"assists",
		"catches",
		"completions",
		"blocks",
		"interceptions",
		"layouts",
		"hucks",
		"callahans",
		"greatests",
		"perfectReleases",
		"techs",
	}
	local grid = make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 130),
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(150, 26)
	layout.CellPadding = UDim2.fromOffset(6, 4)
	layout.Parent = grid
	for _, k in keys do
		Theme.label(string.format("%s: %d", k, profile.stats[k] or 0), 14, { Parent = grid })
	end
	section(content, "TECHNIQUE MASTERY", nextOrder())
	for tech, name in MovementConfig.TechNames :: any do
		local m = profile.techMastery and profile.techMastery[tech]
		if m and m.count > 0 then
			Theme.label(
				string.format(
					"%s  ·  %d performed  ·  %d%% Perfect",
					name,
					m.count,
					math.floor(m.perfect / m.count * 100)
				),
				14,
				{
					Parent = content,
					LayoutOrder = nextOrder(),
					TextColor3 = (Theme.TechColors :: any)[tech] or C.Text,
				}
			)
		end
	end
	section(content, "ACHIEVEMENTS", nextOrder())
	for _, a in profile.achievements do
		Theme.label(
			string.format(
				"%s %s — %s (%d/%d)",
				if a.done then "[x]" else "[ ]",
				a.name,
				a.description,
				a.progress,
				a.goal
			),
			14,
			{
				Parent = content,
				LayoutOrder = nextOrder(),
				TextColor3 = if a.done then C.Gold else C.Muted,
				TextWrapped = true,
				Size = UDim2.new(1, -10, 0, 34),
			}
		)
	end
end

function render.Locker(content: Instance)
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	if not profile then
		Theme.label("Loading profile...", 16, { Parent = content, LayoutOrder = 1 })
		return
	end
	Theme.label("Everything here is cosmetic. Nothing changes how you move, throw or catch.", 14, {
		Parent = content,
		LayoutOrder = nextOrder(),
		TextColor3 = C.Muted,
	})
	local slots = {
		{ key = "disc", title = "DISC SKINS", list = ProgressionConfig.DiscSkins },
		{ key = "trail", title = "TRAILS", list = ProgressionConfig.Trails },
		{ key = "celebration", title = "CELEBRATIONS", list = ProgressionConfig.Celebrations },
		{ key = "banner", title = "BANNERS", list = ProgressionConfig.Banners },
		{ key = "title", title = "TITLES", list = ProgressionConfig.Titles },
	}
	for _, slot in slots do
		section(content, slot.title, nextOrder())
		local r = make("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = nextOrder(),
			Parent = content,
		})
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.fromOffset(150, 34)
		grid.CellPadding = UDim2.fromOffset(6, 6)
		grid.Parent = r
		local unlocked = profile.unlocked[slot.key] or {}
		local equipped = profile.equipped[slot.key]
		for _, item in slot.list do
			local has = table.find(unlocked, item.id) ~= nil
			local label = item.name
			if not has then
				label = if item.level then (item.name .. " · Lv " .. item.level) else (item.name .. " · achievement")
			end
			local b = Theme.button(label, {
				Parent = r,
				TextSize = 12,
				BackgroundColor3 = if item.id == equipped then C.Accent elseif has then C.PanelLight else C.Panel,
				TextColor3 = if item.id == equipped then Color3.new(0, 0, 0) elseif has then C.Text else C.Muted,
			})
			if item.color then
				make("Frame", {
					BackgroundColor3 = item.color,
					BorderSizePixel = 0,
					Size = UDim2.new(0, 6, 1, -8),
					Position = UDim2.fromOffset(4, 4),
					Parent = b,
				})
			end
			if has then
				b.Activated:Connect(function()
					action("Equip", { slot = slot.key, id = item.id })
				end)
			end
		end
	end
end

function render.Leaderboard(content: Instance)
	section(content, "SEASON LEADERBOARD", 1)
	local status = Theme.label("Loading...", 14, { Parent = content, LayoutOrder = 2, TextColor3 = C.Muted })
	task.spawn(function()
		local ok, data = pcall(function()
			return Net.func("GetLeaderboard"):InvokeServer()
		end)
		if not ok or type(data) ~= "table" then
			status.Text = "Leaderboard unavailable."
			return
		end
		status.Text = "Season " .. tostring(data.season)
		if #data.entries == 0 then
			status.Text ..= " — no ranked results yet (or DataStores are unavailable in Studio)."
		end
		for i, e in data.entries do
			Theme.label(string.format("#%d  %s  ·  %d  ·  %s", e.rank, e.name, e.rating, e.division), 15, {
				Parent = content,
				LayoutOrder = 2 + i,
				TextColor3 = if e.userId == player.UserId then C.Gold else C.Text,
			})
		end
	end)
end

function render.Settings(content: Instance)
	local s = controllers.SettingsController
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	section(content, "SETTINGS", nextOrder())
	local numeric = {
		{ key = "MouseSensitivity", label = "Mouse sensitivity", step = 0.1, min = 0.2, max = 3 },
		{ key = "GamepadSensitivity", label = "Gamepad sensitivity", step = 0.1, min = 0.2, max = 3 },
		{ key = "TouchSensitivity", label = "Touch sensitivity", step = 0.1, min = 0.2, max = 3 },
		{ key = "FieldOfView", label = "Field of view", step = 2, min = 60, max = 90 },
		{ key = "TouchButtonScale", label = "Touch button size", step = 0.1, min = 0.7, max = 1.5 },
		{ key = "MasterVolume", label = "Master volume", step = 0.1, min = 0, max = 1 },
		{ key = "SfxVolume", label = "Effects volume", step = 0.1, min = 0, max = 1 },
		{ key = "CrowdVolume", label = "Crowd volume", step = 0.1, min = 0, max = 1 },
	}
	for _, n in numeric do
		local v = s.get(n.key)
		stepper(content, nextOrder(), n.label, string.format(if n.step < 1 then "%.1f" else "%d", v), function()
			s.set(n.key, math.clamp(math.floor((v - n.step) * 10 + 0.5) / 10, n.min, n.max))
			Menu.refresh(true)
		end, function()
			s.set(n.key, math.clamp(math.floor((v + n.step) * 10 + 0.5) / 10, n.min, n.max))
			Menu.refresh(true)
		end)
	end
	local toggles = {
		{ key = "InvertY", label = "Invert camera Y" },
		{ key = "CameraShake", label = "Camera shake (subtle)" },
		{ key = "ShowComboFeed", label = "Combo chain (counter and end card)" },
		{ key = "ShowTechLabels", label = "Technique labels" },
		{ key = "TrajectoryPreview", label = "Throw preview arc" },
		{ key = "LeftHanded", label = "Left-handed thrower" },
	}
	for _, t in toggles do
		toggleRow(content, nextOrder(), t.label, s.get(t.key) == true, function()
			s.set(t.key, not s.get(t.key))
			Menu.refresh(true)
		end)
	end
	Theme.label("Sprint options are under Controls.", 13, {
		Parent = content,
		LayoutOrder = nextOrder(),
		TextColor3 = C.Muted,
	})
end

local function keyNames(keys: { string }?): string
	local out: { string } = {}
	if keys then
		for _, k in keys do
			table.insert(out, InputConfig.keyLabel(k))
		end
	end
	return table.concat(out, " / ")
end

function render.Controls(content: Instance)
	local s = controllers.SettingsController
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	section(content, "SPRINT", nextOrder())
	for _, t in
		{
			{ key = "AutoSprint", label = "Auto-sprint (push one way to sprint)" },
			{ key = "ToggleSprint", label = "Sprint key toggles (instead of hold)" },
			{ key = "AutoSprintTouch", label = "Auto-sprint on touch (push the stick fully)" },
		}
	do
		toggleRow(content, nextOrder(), t.label, s.get(t.key) == true, function()
			s.set(t.key, not s.get(t.key))
			Menu.refresh(true)
		end)
	end
	section(content, "CONTROLS (click a binding, then press the new key/button)", nextOrder())
	local kb = s.bindings("keyboard")
	local gp = s.bindings("gamepad")
	for _, act in InputConfig.Actions do
		local r = row(content, nextOrder(), 34)
		Theme.label((InputConfig.Display :: any)[act] or act, 13, {
			Parent = r,
			LayoutOrder = 1,
			Size = UDim2.fromOffset(300, 32),
			TextWrapped = true,
		})
		local kbText = keyNames(kb[act])
		local b1 = Theme.button(
			if kbText ~= "" then kbText else "—",
			{ Parent = r, LayoutOrder = 2, Size = UDim2.fromOffset(170, 28), TextSize = 13 }
		)
		b1.Activated:Connect(function()
			rebinding = { action = act, button = b1 }
			b1.Text = "press a key..."
		end)
		Theme.label(
			keyNames(gp[act]),
			13,
			{ Parent = r, LayoutOrder = 3, Size = UDim2.fromOffset(150, 28), TextColor3 = C.Muted }
		)
	end
	local rr = row(content, nextOrder(), 44)
	local reset = Theme.button("RESET TO DEFAULTS", { Parent = rr, Size = UDim2.fromOffset(200, 36) })
	reset.Activated:Connect(function()
		s.resetBindings()
		Menu.refresh(true)
	end)
	section(content, "TECHNIQUE GUIDE", nextOrder())
	for _, line in techGuide() do
		Theme.label(line, 13, {
			Parent = content,
			LayoutOrder = nextOrder(),
			TextWrapped = true,
			Size = UDim2.new(1, -10, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextColor3 = C.Muted,
			Font = Theme.Fonts.Medium,
		})
	end
end

---------------------------------------------------------------------------

-- Rebuilds the open tab. keepScroll: a refresh of the same tab after a change
-- (keeps where you were scrolled to); otherwise the tab opens at the top.
function Menu.refresh(keepScroll: boolean?)
	if not isOpen then
		return
	end
	local content = refs.content :: ScrollingFrame
	local scroll = content.CanvasPosition
	local selected = GuiService.SelectedObject
	local hadSelection = selected ~= nil and selected:IsDescendantOf(content)
	clear(content)
	local fn = render[currentTab]
	if fn then
		fn(content)
	end
	content.CanvasPosition = if keepScroll then scroll else Vector2.zero
	if hadSelection then
		-- the selected button was rebuilt: keep gamepad navigation alive
		GuiService.SelectedObject = refs.tabButtons[currentTab]
	end
	for name, b in refs.tabButtons do
		b.BackgroundColor3 = if name == currentTab then C.Accent else C.PanelLight
		b.TextColor3 = if name == currentTab then Color3.new(0, 0, 0) else C.Text
	end
end

function Menu.toggle(open: boolean?)
	local target = if open == nil then not isOpen else open
	isOpen = target
	refs.dim.Visible = target
	controllers.InputController.setMenuOpen(target)
	rebinding = nil
	if target then
		Menu.refresh()
		if controllers.InputController.scheme() == "Gamepad" then
			GuiService.SelectedObject = refs.tabButtons[currentTab]
		end
	else
		GuiService.SelectedObject = nil
	end
end

function Menu.isOpen(): boolean
	return isOpen
end

function Menu.setProfile(p: any)
	profile = p
	if isOpen and (currentTab == "Profile" or currentTab == "Locker" or currentTab == "Training") then
		Menu.refresh(true)
	end
end

function Menu.build(parent: ScreenGui, c: any)
	controllers = c
	local dim = make("Frame", {
		Name = "MenuDim",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	refs.dim = dim
	local window = Theme.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.8, 0, 0.82, 0),
		ZIndex = 21,
		Parent = dim,
	})
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(980, 640)
	constraint.Parent = window
	Theme.label("ULTIMATE: BREAKPOINT", 24, {
		Parent = window,
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.fromOffset(400, 30),
		Font = Theme.Fonts.Heavy,
		ZIndex = 22,
	})
	local close = Theme.button("CLOSE (M)", {
		Parent = window,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(120, 32),
		ZIndex = 22,
	})
	close.Activated:Connect(function()
		Menu.toggle(false)
	end)
	local tabs = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 54),
		Size = UDim2.new(0, 160, 1, -68),
		Parent = window,
		Theme.list(6),
	})
	refs.tabButtons = {}
	for i, name in TABS do
		local b = Theme.button(string.upper(name), {
			Parent = tabs,
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 40),
			ZIndex = 22,
		})
		b.Activated:Connect(function()
			currentTab = name
			Menu.refresh()
		end)
		refs.tabButtons[name] = b
	end
	local content = make("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(190, 54),
		Size = UDim2.new(1, -204, 1, -68),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 22,
		Parent = window,
		Theme.list(8),
	})
	refs.content = content

	-- the Play tab follows the vote / ranked / host state while it is open
	local refreshQueued = false
	local function queuePlayRefresh()
		if refreshQueued or not isOpen or currentTab ~= "Play" then
			return
		end
		refreshQueued = true
		task.delay(0.15, function()
			refreshQueued = false
			if isOpen and currentTab == "Play" then
				Menu.refresh(true)
			end
		end)
	end
	local state = Net.state()
	for _, name in PLAY_STATE do
		state:GetAttributeChangedSignal(name):Connect(queuePlayRefresh)
	end
	state:GetAttributeChangedSignal("Phase"):Connect(function()
		if state:GetAttribute("Phase") == "Intermission" then
			myVote = nil
		end
	end)

	-- capture the next key press while rebinding
	UserInputService.InputBegan:Connect(function(input)
		local rb = rebinding
		if not rb or not isOpen then
			return
		end
		local t = input.UserInputType
		local name: string? = nil
		local scheme = "keyboard"
		if t == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				rebinding = nil
				Menu.refresh(true)
				return
			end
			name = input.KeyCode.Name
		elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			return -- clicks are for the UI itself
		elseif t == Enum.UserInputType.Gamepad1 then
			name = input.KeyCode.Name
			scheme = "gamepad"
		end
		if name then
			rebinding = nil
			controllers.SettingsController.setBinding(scheme, rb.action, { name })
			task.defer(Menu.refresh, true)
		end
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Mobile</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Mobile — touch controls with the full technique set.

	Left half: floating thumbstick (InputController shapes it: a small dead
	zone, full speed a little before the rim; push it fully to auto-sprint, or
	use the SPRINT toggle). Right side: THROW/REACH (hold to charge), JUMP,
	CUT, SLIDE, DIVE, BURST, MARK. Dragging on empty screen space turns the
	camera.

	While you hold the disc the same buttons change meaning (and label) the
	way the keyboard does: CUT = SWING LEFT, DIVE = SWING RIGHT (MovementController
	routes them to the Quick Swing), JUMP = HOP, SLIDE = LOW (hold for a low
	release), MARK = FAKE, BURST hides. A disc row adds < BANK / BANK > (the
	Z / X keys), TYPE and LEAD.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Mobile = {}

local controllers: any
local refs: { [string]: any } = {}
local stickTouch: InputObject? = nil
local stickOrigin = Vector2.zero
local cameraTouches: { [InputObject]: Vector2 } = {}
local buttonTouches: { [InputObject]: boolean } = {}

local STICK_RADIUS = 64

local function circleButton(
	parent: Instance,
	name: string,
	text: string,
	pos: UDim2,
	size: number,
	color: Color3?
): TextButton
	local b = make("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or C.Panel,
		BackgroundTransparency = 0.25,
		Text = text,
		TextSize = if size > 80 then 16 else 12,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Text,
		AutoButtonColor = false,
		Parent = parent,
		Theme.corner(size) :: Instance,
		Theme.stroke(C.Stroke, 2, 0.2) :: Instance,
	}) :: TextButton
	return b
end

local function bindHold(button: TextButton, actionName: string)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			buttonTouches[input] = true
			button.BackgroundTransparency = 0.05
			controllers.InputController.fire(actionName, true)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			buttonTouches[input] = nil
			button.BackgroundTransparency = 0.25
			controllers.InputController.fire(actionName, false)
		end
	end)
end

function Mobile.build(parent: ScreenGui, c: any)
	controllers = c
	local layer = make("Frame", {
		Name = "Touch",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = parent,
	}) :: Frame
	refs.layer = layer

	local stickBase = make("Frame", {
		Name = "StickBase",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(STICK_RADIUS * 2, STICK_RADIUS * 2),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.6,
		Visible = false,
		Parent = layer,
		Theme.corner(STICK_RADIUS),
	}) :: Frame
	local knob = make("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = C.Text,
		BackgroundTransparency = 0.4,
		Parent = stickBase,
		Theme.corner(26),
	}) :: Frame
	refs.stickBase = stickBase
	refs.knob = knob

	local right = make("Frame", {
		Name = "Buttons",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(330, 300),
		BackgroundTransparency = 1,
		Parent = layer,
	})
	refs.buttons = right
	-- { name / action, position, size, label without disc, label with disc }
	local defs: { { any } } = {
		{ "Primary", UDim2.fromOffset(250, 220), 104, "THROW\nREACH", "THROW" },
		{ "Jump", UDim2.fromOffset(150, 250), 70, "JUMP", "HOP" },
		{ "Cut", UDim2.fromOffset(160, 160), 66, "CUT", "SWING\nLEFT" },
		{ "Slide", UDim2.fromOffset(60, 260), 60, "SLIDE", "LOW" },
		{ "Dive", UDim2.fromOffset(240, 110), 66, "DIVE", "SWING\nRIGHT" },
		{ "Burst", UDim2.fromOffset(80, 175), 60, "BURST", "" },
		{ "Secondary", UDim2.fromOffset(310, 120), 58, "MARK", "FAKE" },
	}
	local labelled: { { any } } = {}
	for _, def in defs do
		local name = def[1] :: string
		local b = circleButton(right, name, def[4], def[2], def[3], if name == "Primary" then C.Accent else nil)
		bindHold(b, name)
		table.insert(labelled, { b :: any, def[4], def[5], name })
	end
	refs.labelled = labelled
	local sprint = circleButton(right, "Sprint", "SPRINT", UDim2.fromOffset(40, 90), 54)
	sprint.Activated:Connect(function()
		controllers.InputController.toggleTouchSprint()
	end)

	local discRow = make("Frame", {
		Name = "DiscButtons",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -360, 1, -30),
		Size = UDim2.fromOffset(250, 60),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = layer,
		Theme.list(8, true),
	})
	refs.discRow = discRow
	local discDefs = {
		{ "BankLeft", "< BANK" },
		{ "BankRight", "BANK >" },
		{ "TypeNext", "TYPE" },
		{ "LeadLock", "LEAD" },
	}
	refs.discActions = {}
	for i, def in discDefs do
		table.insert(refs.discActions, def[1])
		local b =
			Theme.button(def[2], { Parent = discRow, LayoutOrder = i, Size = UDim2.fromOffset(56, 52), TextSize = 12 })
		bindHold(b, def[1])
	end
	local menu = Theme.button("MENU", {
		Parent = layer,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(16, 66),
		Size = UDim2.fromOffset(70, 34),
		TextSize = 13,
	})
	menu.Activated:Connect(function()
		controllers.UIController.toggleMenu()
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if input.UserInputType ~= Enum.UserInputType.Touch or not layer.Visible or gameProcessed then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local screen = workspace.CurrentCamera.ViewportSize
		if pos.X < screen.X * 0.42 and stickTouch == nil then
			stickTouch = input
			stickOrigin = pos
			stickBase.Position = UDim2.fromOffset(pos.X, pos.Y)
			stickBase.Visible = true
		else
			cameraTouches[input] = pos
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if input == stickTouch then
			local delta = pos - stickOrigin
			if delta.Magnitude > STICK_RADIUS then
				delta = delta.Unit * STICK_RADIUS
			end
			knob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
			local v = delta / STICK_RADIUS
			controllers.InputController.setTouchStick(Vector2.new(v.X, -v.Y))
		elseif cameraTouches[input] then
			local last = cameraTouches[input]
			controllers.CameraController.addTouchDelta(pos - last)
			cameraTouches[input] = pos
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input == stickTouch then
			stickTouch = nil
			stickBase.Visible = false
			knob.Position = UDim2.fromScale(0.5, 0.5)
			controllers.InputController.setTouchStick(Vector2.zero)
		end
		cameraTouches[input] = nil
	end)
	local _ = Players
end

function Mobile.update()
	local touch = controllers.InputController.scheme() == "Touch"
	local layer = refs.layer :: Frame
	layer.Visible = touch and not controllers.InputController.menuOpen()
	if not touch then
		return
	end
	local scale = controllers.SettingsController.get("TouchButtonScale") or 1
	local uiScale = refs.buttons:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Parent = refs.buttons
	end
	(uiScale :: UIScale).Scale = scale
	refs.discRow.Visible = controllers.ThrowController.isHolding()
	-- labels follow the movement routing (which starts with the predicted catch)
	local holding = controllers.MovementController.holdingDisc()
	if holding ~= refs.holding then
		refs.holding = holding
		local input = controllers.InputController
		for _, entry in refs.labelled do
			local b = entry[1] :: TextButton
			local text = if holding then entry[3] else entry[2]
			b.Text = text
			if text == "" and b.Visible then
				-- a hidden button never sees its touch end: release it now
				input.fire(entry[4], false)
				b.BackgroundTransparency = 0.25
			end
			b.Visible = text ~= ""
		end
	end
	if not refs.discRow.Visible and refs.discHeld ~= false then
		refs.discHeld = false
		for _, action in refs.discActions do
			controllers.InputController.fire(action, false)
		end
	elseif refs.discRow.Visible then
		refs.discHeld = true
	end
end

return Mobile
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
-- Panels — end-of-match summary (sized for a full 7v7 plus subs: 14 rows show
-- without scrolling; bots and subs are tagged, ranked / void / PvP noted),
-- drill HUD and drill reports, nameplates (readable to 360 studs, the length
-- of the Normal field).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local ProgressionConfig = require(Shared.Config.Progression)
local TeamsConfig = require(Shared.Config.Teams)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Panels = {}

local controllers: any
local player = Players.LocalPlayer
local refs: { [string]: any } = {}

local BANNERS: { [string]: Color3 } = {}
for _, b in ProgressionConfig.Banners do
	BANNERS[b.id] = b.color
end

local function now(): number
	return Net.now()
end

---------------------------------------------------------------------------
-- match summary
---------------------------------------------------------------------------

function Panels.showSummary(sum: any)
	local old = refs.summary
	if old then
		old:Destroy()
	end
	local panel = Theme.panel({
		Name = "Summary",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(760, 486),
		Parent = refs.root,
	})
	refs.summary = panel
	local winnerName = if sum.winner == "A"
		then TeamsConfig.A.Name
		elseif sum.winner == "B" then TeamsConfig.B.Name
		else "DRAW"
	Theme.label(winnerName .. " WIN", 34, {
		Parent = panel,
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextColor3 = Theme.teamColor(sum.winner),
	})
	local tag = if sum.ranked
		then "  ·  RANKED"
		elseif sum.rankedVoid then "  ·  RANKED (VOID: a player left)"
		elseif sum.pvp then "  ·  PvP"
		else ""
	Theme.label(string.format("%d  -  %d   ·   %s%s", sum.score.A, sum.score.B, sum.mode or "", tag), 16, {
		Parent = panel,
		Position = UDim2.fromOffset(20, 54),
		Size = UDim2.new(1, -40, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})
	local list = make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(20, 86),
		Size = UDim2.new(1, -40, 1, -130),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		Parent = panel,
		Theme.list(3),
	})
	Theme.label("PLAYER                          G    A    BLK  CAT  CMP  TO   HL", 12, {
		Parent = list,
		LayoutOrder = 0,
		TextColor3 = C.Muted,
		Font = Enum.Font.Code,
	})
	table.sort(sum.rows, function(a, b)
		if a.team ~= b.team then
			return a.team < b.team
		end
		return (a.goals + a.assists) > (b.goals + b.assists)
	end)
	for i, r in sum.rows do
		local suffix = if r.bot then " (bot)" elseif r.bench then " (sub)" else ""
		local name = string.sub(string.sub(tostring(r.name), 1, 30 - #suffix) .. suffix .. string.rep(" ", 30), 1, 30)
		local mvp = if r.id == sum.mvp then " MVP" else ""
		local change = sum.ratingChanges and sum.ratingChanges[tostring(r.id)]
		local rating = if change then string.format("  %d (%+d)", change.new, change.new - change.old) else ""
		Theme.label(
			string.format(
				"%s  %-4d %-4d %-4d %-4d %-4d %-4d %-3d%s%s",
				name,
				r.goals,
				r.assists,
				r.blocks,
				r.catches,
				r.completions,
				r.turnovers,
				r.highlights,
				mvp,
				rating
			),
			12,
			{
				Parent = list,
				LayoutOrder = i,
				Size = UDim2.new(1, -6, 0, 18),
				Font = Enum.Font.Code,
				TextColor3 = if r.id == player.UserId then C.Gold else Theme.teamColor(r.team),
			}
		)
	end
	Theme.label("Next match starts shortly · press M to vote", 13, {
		Parent = panel,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -12),
		Size = UDim2.new(1, -40, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})
	task.delay(12, function()
		if refs.summary == panel then
			panel:Destroy()
			refs.summary = nil
		end
	end)
end

---------------------------------------------------------------------------
-- drills
---------------------------------------------------------------------------

function Panels.drillHud(payload: any)
	local hud = refs.drillHud :: Frame
	if payload.clear then
		hud.Visible = false
		refs.drillTimer = nil
		return
	end
	hud.Visible = true
	refs.drillTitle.Text = payload.title or ""
	refs.drillText.Text = payload.text or ""
	refs.drillProgress.Size = UDim2.fromScale(math.clamp(payload.progress or 0, 0, 1), 1)
	refs.drillTimer = payload.timerStart
	local lines = 1
	for _ in string.gmatch(payload.text or "", "\n") do
		lines += 1
	end
	hud.Size = UDim2.fromOffset(420, 70 + lines * 18)
end

function Panels.drillReport(payload: any)
	local old = refs.report
	if old then
		old:Destroy()
	end
	local lines: { string } = payload.lines or {}
	local panel = Theme.panel({
		Name = "DrillReport",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 190),
		Size = UDim2.fromOffset(560, 70 + #lines * 22),
		Parent = refs.root,
	})
	refs.report = panel
	Theme.label(payload.title or "DRILL", 22, {
		Parent = panel,
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 28),
		Font = Theme.Fonts.Heavy,
		TextColor3 = if payload.pb then C.Gold else C.Text,
	})
	for i, line in lines do
		Theme.label(line, 15, {
			Parent = panel,
			Position = UDim2.fromOffset(16, 40 + (i - 1) * 22),
			Size = UDim2.new(1, -32, 0, 20),
			TextWrapped = true,
			TextColor3 = if string.find(line, "BEST") then C.Gold else C.Text,
		})
	end
	task.delay(10, function()
		if refs.report == panel then
			panel:Destroy()
			refs.report = nil
		end
	end)
end

---------------------------------------------------------------------------
-- nameplates
---------------------------------------------------------------------------

local plates: { [Model]: BillboardGui } = {}

local function plateFor(model: Model): BillboardGui?
	local existing = plates[model]
	if existing and existing.Parent then
		return existing
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local gui = make("BillboardGui", {
		Name = "UBPlate",
		Size = UDim2.fromOffset(180, 54),
		StudsOffset = Vector3.new(0, 2.6, 0),
		AlwaysOnTop = false,
		MaxDistance = 360,
		LightInfluence = 0,
		Adornee = head,
		Parent = refs.root,
	}) :: BillboardGui
	Theme.label("", 15, {
		Name = "Name",
		Parent = gui,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextStrokeTransparency = 0.4,
	})
	Theme.label("", 11, {
		Name = "Title",
		Parent = gui,
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 36),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		TextStrokeTransparency = 0.6,
	})
	Theme.label("", 18, {
		Name = "Stall",
		Parent = gui,
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		TextStrokeTransparency = 0.3,
	})
	plates[model] = gui
	return gui
end

local lastPlates = 0
function Panels.updateNameplates()
	local clock = os.clock()
	if clock - lastPlates < 0.2 then
		return
	end
	lastPlates = clock
	local state = Net.state()
	local holder = state:GetAttribute("HolderId")
	local stall = state:GetAttribute("Stall") or 0
	local live = state:GetAttribute("Phase") == "Live"
	local seen: { [Model]: boolean } = {}
	for _, model in Actors.characters() do
		if model ~= player.Character then
			seen[model] = true
			local gui = plateFor(model)
			if gui then
				local team = model:GetAttribute("UBTeam")
				local nameLabel = gui:FindFirstChild("Name") :: TextLabel
				local titleLabel = gui:FindFirstChild("Title") :: TextLabel
				local stallLabel = gui:FindFirstChild("Stall") :: TextLabel
				nameLabel.Text = tostring(model:GetAttribute("UBName") or model.Name)
				nameLabel.TextColor3 = Theme.teamColor(if type(team) == "string" then team else nil)
				local title = model:GetAttribute("UBTitle")
				local level = model:GetAttribute("UBLevel")
				titleLabel.Text = string.format(
					"%s%s",
					if type(title) == "string" then title else "",
					if type(level) == "number" then ("  ·  Lv " .. level) else ""
				)
				local banner = model:GetAttribute("UBBanner")
				titleLabel.TextColor3 = if type(banner) == "string" and BANNERS[banner]
					then BANNERS[banner]:Lerp(Color3.new(1, 1, 1), 0.5)
					else C.Muted
				local id = model:GetAttribute("UBId")
				stallLabel.Text = if live and id == holder then ("STALL " .. tostring(stall)) else ""
			end
		end
	end
	for model, gui in plates do
		if not seen[model] then
			gui:Destroy()
			plates[model] = nil
		end
	end
end

function Panels.update()
	local timer = refs.drillTimer
	if type(timer) == "number" then
		refs.drillClock.Text = string.format("%.2f s", now() - timer)
	else
		refs.drillClock.Text = ""
	end
	Panels.updateNameplates()
end

function Panels.build(parent: ScreenGui, c: any)
	controllers = c
	refs.root = parent
	local hud = Theme.panel({
		Name = "DrillHud",
		Position = UDim2.fromOffset(16, 66),
		Size = UDim2.fromOffset(420, 90),
		Parent = parent,
	})
	hud.Visible = false
	refs.drillHud = hud
	refs.drillTitle = Theme.label("", 18, {
		Parent = hud,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -120, 0, 22),
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Accent,
	})
	refs.drillClock = Theme.label("", 18, {
		Parent = hud,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 8),
		Size = UDim2.fromOffset(100, 22),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.Gold,
		Font = Theme.Fonts.Heavy,
	})
	refs.drillText = Theme.label("", 14, {
		Parent = hud,
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 1, -50),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Theme.Fonts.Medium,
	})
	local bar = make("Frame", {
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -8),
		Size = UDim2.new(1, -28, 0, 5),
		Parent = hud,
		Theme.corner(3),
	})
	refs.drillProgress = make("Frame", {
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
		Theme.corner(3),
	})
	local _ = controllers
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Visual language for every screen: dark translucent panels, bold condensed
-- type, team colours as accents. `make` builds instance trees declaratively.
-- Technique colours (one per technique, shared by HUD and world effects) and
-- combo tier colours live here too, plus `keyText` for "Q SNAP CUT" style
-- key prompts.

local Theme = {}

Theme.Colors = {
	Panel = Color3.fromRGB(14, 16, 24),
	PanelLight = Color3.fromRGB(28, 32, 44),
	Stroke = Color3.fromRGB(70, 80, 104),
	Text = Color3.fromRGB(240, 244, 250),
	Muted = Color3.fromRGB(150, 160, 180),
	Accent = Color3.fromRGB(90, 230, 255),
	Gold = Color3.fromRGB(255, 205, 70),
	Good = Color3.fromRGB(90, 240, 150),
	Bad = Color3.fromRGB(255, 90, 100),
	Perfect = Color3.fromRGB(255, 215, 80),
	Clean = Color3.fromRGB(210, 240, 255),
	Sloppy = Color3.fromRGB(255, 150, 90),
	Gassed = Color3.fromRGB(170, 170, 180),
	TeamA = Color3.fromRGB(32, 140, 255),
	TeamB = Color3.fromRGB(255, 120, 30),
}

Theme.Fonts = {
	Heavy = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
	Body = Enum.Font.Gotham,
}

-- Technique colours: each technique has a distinct, readable colour.
Theme.TechColors = {
	SnapCut = Color3.fromRGB(90, 230, 255),
	MomentumCancel = Color3.fromRGB(255, 120, 200),
	FakeCommit = Color3.fromRGB(200, 160, 255),
	BurstStep = Color3.fromRGB(255, 150, 40),
	Slide = Color3.fromRGB(230, 210, 150),
	SlideCut = Color3.fromRGB(250, 230, 120),
	Dive = Color3.fromRGB(255, 255, 255),
	RecoveryChain = Color3.fromRGB(120, 255, 170),
	AirRedirect = Color3.fromRGB(140, 180, 255),
	PrecisionLanding = Color3.fromRGB(255, 215, 80),
	WallRebound = Color3.fromRGB(255, 90, 200),
	AerialReach = Color3.fromRGB(180, 255, 255),
	Jump = Color3.fromRGB(200, 210, 230),
	PivotSwing = Color3.fromRGB(120, 220, 255),
	Break = Color3.fromRGB(255, 215, 80),
}

-- Combo tier words (ComboEvaluator.Tiers) and their colours.
Theme.TierColors = {
	NICE = Color3.fromRGB(210, 240, 255),
	SLICK = Color3.fromRGB(90, 230, 255),
	FILTHY = Color3.fromRGB(255, 150, 90),
	BREAKPOINT = Color3.fromRGB(255, 215, 80),
} :: { [string]: Color3 }

function Theme.tierColor(tier: string?): Color3
	return if tier then Theme.TierColors[tier] or Theme.Colors.Gold else Theme.Colors.Text
end

function Theme.qualityColor(q: string): Color3
	return (Theme.Colors :: any)[q] or Theme.Colors.Text
end

function Theme.teamColor(team: string?): Color3
	if team == "A" then
		return Theme.Colors.TeamA
	elseif team == "B" then
		return Theme.Colors.TeamB
	end
	return Theme.Colors.Muted
end

export type Props = { [any]: any }

-- make("Frame", { Size = ..., [1] = child, [2] = child })
function Theme.make(className: string, props: Props?): Instance
	local inst = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = inst
			elseif k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	return c
end

function Theme.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.Stroke
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

function Theme.padding(px: number): UIPadding
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	return p
end

function Theme.panel(props: Props?): Frame
	local f = Theme.make("Frame", {
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Theme.corner(12) :: Instance,
		Theme.stroke() :: Instance,
	}) :: Frame
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = f
			else
				(f :: any)[k] = v
			end
		end
	end
	return f
end

function Theme.label(text: string, size: number, props: Props?): TextLabel
	local l = Theme.make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, size + 6),
	}) :: TextLabel
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = l
			else
				(l :: any)[k] = v
			end
		end
	end
	return l
end

function Theme.button(text: string, props: Props?): TextButton
	local b = Theme.make("TextButton", {
		BackgroundColor3 = Theme.Colors.PanelLight,
		BackgroundTransparency = 0.05,
		AutoButtonColor = true,
		Text = text,
		TextSize = 16,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.Text,
		Size = UDim2.fromOffset(160, 38),
		Theme.corner(8) :: Instance,
		Theme.stroke(Theme.Colors.Stroke, 1, 0.4) :: Instance,
	}) :: TextButton
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = b
			else
				(b :: any)[k] = v
			end
		end
	end
	return b
end

function Theme.list(padding: number?, horizontal: boolean?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	return l
end

-- Rich-text prompt "<key> LABEL" with the key in the accent colour; just the
-- label when no key is bound (touch). Labels must not contain markup.
function Theme.keyText(key: string, label: string): string
	if key == "" then
		return label
	end
	return string.format('<font color="#5AE6FF">%s</font> %s', key, label)
end

function Theme.formatTime(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">ThrowHud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ThrowHud — the thrower's panel, kept small so the field stays readable:
	  * throw type, release height chip and bank
	  * type chips (1-5) and the power meter with its Perfect band (and the
	    Lead assist's ideal-power mark)
	  * the step gauge: a top-down view around your pivot foot (up = where
	    you aim): the step range, your free foot, the nearest marker's hand
	    box (red when the preview says the throw would be blocked) and which
	    side is OPEN and which is the BREAK
	  * key hints and the throw description only for your first HINT_HOLDS
	    possessions of the session
	Release text appears only when it matters: a Perfect release, an
	overcharge, a hand block, or a hop the server did not see (released Mid).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local Net = require(Shared.Net)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local ThrowHud = {}

local HINT_HOLDS = 3
local GAUGE = 104 -- px
local GAUGE_STUDS = 6.2 -- studs from the pivot to the gauge edge
local RELEASE_TEXT_TIME = 1.6
local MARK = DiscConfig.Mark

local controllers: any
local refs: { [string]: any } = {}
local releaseText = { at = -math.huge, text = "", color = C.Text }

local function scale(): number
	return (GAUGE / 2) / GAUGE_STUDS
end

local function dot(parent: Instance, size: number, color: Color3, z: number): Frame
	return make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
		Theme.corner(size),
	}) :: Frame
end

local function buildGauge(panel: Frame)
	local gauge = make("Frame", {
		Name = "StepGauge",
		BackgroundColor3 = C.PanelLight,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(46, 76),
		Size = UDim2.fromOffset(GAUGE, GAUGE),
		Parent = panel,
		Theme.corner(GAUGE),
	}) :: Frame
	refs.gauge = gauge
	-- the step range (radius R)
	local r = math.floor(MovementConfig.Holding.StepRadius * scale() + 0.5)
	refs.ring = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(r * 2, r * 2),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = gauge,
		Theme.corner(r * 2) :: Instance,
		Theme.stroke(C.Muted, 1, 0.45) :: Instance,
	})
	-- aim direction tick
	make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 3),
		Size = UDim2.fromOffset(2, 9),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = gauge,
	})
	refs.markBox = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.TeamB,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
		Parent = gauge,
		Theme.corner(3),
	})
	refs.markDot = dot(gauge, 9, C.Bad, 4)
	refs.markDot.Visible = false
	refs.pivotDot = dot(gauge, 10, C.Text, 5)
	refs.pivotDot.Position = UDim2.fromScale(0.5, 0.5)
	refs.footDot = dot(gauge, 12, C.Accent, 6)
	refs.leftSide = Theme.label("", 11, {
		Parent = panel,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(42, 76 + GAUGE / 2),
		Size = UDim2.fromOffset(40, 14),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Theme.Fonts.Heavy,
	})
	refs.rightSide = Theme.label("", 11, {
		Parent = panel,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(50 + GAUGE, 76 + GAUGE / 2),
		Size = UDim2.fromOffset(46, 14),
		Font = Theme.Fonts.Heavy,
	})
end

local function onFeedback(kind: any, payload: any)
	if kind ~= "Release" or type(payload) ~= "table" then
		return
	end
	local text, color = nil, C.Text
	if payload.blocked then
		text, color = "HAND BLOCKED — step out, fake or change height", C.Bad
	elseif payload.heightAsked == "High" and payload.heightUsed ~= "High" then
		text, color = "RELEASED MID — the hop was not seen", C.Sloppy
	elseif payload.quality == "Perfect" then
		text, color = "PERFECT RELEASE", C.Perfect
	elseif payload.quality == "Over" then
		text, color = "OVERCHARGED — less spin", C.Sloppy
	end
	if text then
		releaseText.at = os.clock()
		releaseText.text = text
		releaseText.color = color
	end
end

function ThrowHud.build(parent: ScreenGui, c: any)
	controllers = c
	local panel = Theme.panel({
		Name = "ThrowHud",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.fromOffset(250, 214),
		Parent = parent,
	})
	panel.Visible = false
	refs.panel = panel

	refs.type = Theme.label("BACKHAND", 22, {
		Parent = panel,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.fromOffset(150, 26),
		Font = Theme.Fonts.Heavy,
	})
	refs.height = make("TextLabel", {
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(150, 12),
		Size = UDim2.fromOffset(44, 18),
		Text = "MID",
		TextSize = 11,
		Font = Theme.Fonts.Bold,
		TextColor3 = C.Accent,
		Parent = panel,
		Theme.corner(5),
	})

	local types = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 40),
		Size = UDim2.fromOffset(196, 20),
		Parent = panel,
		Theme.list(3, true),
	})
	refs.typeChips = {}
	for i, id in DiscConfig.TypeOrder do
		local info = (DiscConfig.Types :: any)[id]
		local chip = make("TextLabel", {
			BackgroundColor3 = C.PanelLight,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(37, 20),
			Text = i .. " " .. info.Short,
			TextSize = 10,
			Font = Theme.Fonts.Bold,
			TextColor3 = C.Muted,
			LayoutOrder = i,
			Parent = types,
			Theme.corner(5),
		})
		refs.typeChips[id] = chip
	end

	-- bank indicator: a tilting disc
	refs.bankDisc = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(28, 196),
		Size = UDim2.fromOffset(34, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = panel,
		Theme.corner(3),
	})
	refs.bankText = Theme.label("FLAT", 11, {
		Parent = panel,
		Position = UDim2.fromOffset(50, 188),
		Size = UDim2.fromOffset(60, 16),
		TextColor3 = C.Muted,
	})
	refs.lead = Theme.label("", 11, {
		Parent = panel,
		Position = UDim2.fromOffset(104, 188),
		Size = UDim2.fromOffset(110, 16),
		TextColor3 = C.Good,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	buildGauge(panel)

	-- power meter (vertical, right edge). Full = 100%; the gold band is the
	-- Perfect window; red above it is overcharge.
	local meter = make("Frame", {
		Name = "Meter",
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -30, 0, 12),
		Size = UDim2.fromOffset(16, 190),
		Parent = panel,
		Theme.corner(6),
	})
	local meterScale = 1.4 -- meter shows up to 140% of the charge time
	local fullY = 1 - 1 / meterScale
	local perfectH = (DiscConfig.Throw.PerfectWindow / DiscConfig.Throw.ChargeTime) / meterScale
	make("Frame", {
		Name = "Perfect",
		BackgroundColor3 = C.Perfect,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, fullY - perfectH, 0),
		Size = UDim2.new(1, 0, perfectH, 0),
		ZIndex = 2,
		Parent = meter,
	})
	make("Frame", {
		Name = "Over",
		BackgroundColor3 = C.Bad,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, fullY - perfectH, 0),
		ZIndex = 2,
		Parent = meter,
	})
	refs.fill = make("Frame", {
		Name = "Fill",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 0),
		ZIndex = 3,
		Parent = meter,
		Theme.corner(6),
	})
	refs.ideal = make("Frame", {
		Name = "Ideal",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.Good,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 8, 0, 3),
		Position = UDim2.new(0, -4, 0.5, 0),
		ZIndex = 4,
		Visible = false,
		Parent = meter,
	})
	refs.meterScale = meterScale

	-- first possessions only: what the throw does and the keys
	refs.hints = Theme.panel({
		Name = "ThrowHints",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -238),
		Size = UDim2.fromOffset(250, 52),
		Parent = parent,
	})
	refs.hints.Visible = false
	refs.desc = Theme.label("", 11, {
		Parent = refs.hints,
		Position = UDim2.fromOffset(10, 5),
		Size = UDim2.fromOffset(230, 16),
		TextColor3 = C.Text,
		Font = Theme.Fonts.Medium,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	refs.keys = Theme.label("", 10, {
		Parent = refs.hints,
		Position = UDim2.fromOffset(10, 22),
		Size = UDim2.fromOffset(230, 26),
		TextColor3 = C.Muted,
		TextWrapped = true,
		Font = Theme.Fonts.Medium,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	-- release text (shown briefly after the disc has left the hand)
	refs.release = Theme.label("", 15, {
		Parent = parent,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.fromOffset(360, 22),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Theme.Fonts.Heavy,
		TextStrokeTransparency = 0.6,
		Visible = false,
	})

	Net.event("Feedback").OnClientEvent:Connect(onFeedback)
end

local function key(action: string, fallback: string): string
	local label = controllers.InputController.keyLabel(action)
	return if label ~= "" then label else fallback
end

local function hintText(scheme: string): string
	if scheme == "Gamepad" then
		return "LS step · X swing · LT fake · B low · A hop · RT throw · D-pad bank / type · R3 lead"
	elseif scheme == "Touch" then
		return "Stick: step around your pivot · hold THROW · FAKE · bank and type buttons"
	end
	return string.format(
		"WASD step · %s/%s swing · %s fake · %s low · %s hop · %s/%s bank · wheel type · %s lead",
		key("Cut", "Q"),
		key("Dive", "E"),
		key("Secondary", "RMB"),
		key("Slide", "C"),
		key("Jump", "SPACE"),
		key("BankLeft", "Z"),
		key("BankRight", "X"),
		key("LeadLock", "R")
	)
end

local function sideLabel(label: TextLabel, side: number, open: number)
	if open == 0 then
		label.Text = ""
	elseif side == open then
		label.Text = "OPEN"
		label.TextColor3 = C.Good
	else
		label.Text = "BREAK"
		label.TextColor3 = C.Gold
	end
end

local function updateGauge(h: { [string]: any })
	local k = scale()
	local half = GAUGE / 2
	local lim = half - 6
	local function at(x: number, y: number): UDim2
		local px = math.clamp(x * k, -lim, lim)
		local py = math.clamp(-y * k, -lim, lim)
		return UDim2.fromOffset(half + px, half + py)
	end
	refs.pivotDot.BackgroundColor3 = if h.pivoted then C.Text else C.Muted
	refs.footDot.Position = at(h.stepX, h.stepY)
	refs.footDot.Visible = h.pivoted

	local m = h.marker
	if m then
		local depthLen = MARK.DepthMax - MARK.DepthMin
		local mid = (MARK.DepthMax + MARK.DepthMin) / 2
		local cx, cy = m.x + m.fx * mid, m.y + m.fy * mid
		refs.markBox.Visible = m.stance ~= "Relaxed"
		refs.markBox.Size = UDim2.fromOffset(m.halfWidth * 2 * k, depthLen * k)
		refs.markBox.Position = at(cx, cy)
		refs.markBox.Rotation = math.deg(math.atan2(m.fx, m.fy))
		refs.markBox.BackgroundColor3 = if h.blocked then C.Bad elseif m.stance == "High" then C.Gold else C.TeamB
		refs.markDot.Visible = true
		refs.markDot.Position = at(m.x, m.y)
	else
		refs.markBox.Visible = false
		refs.markDot.Visible = false
	end
	sideLabel(refs.leftSide, -1, h.openSide)
	sideLabel(refs.rightSide, 1, h.openSide)
end

local function updateRelease()
	local label = refs.release :: TextLabel
	local age = os.clock() - releaseText.at
	if age > RELEASE_TEXT_TIME then
		label.Visible = false
		return
	end
	label.Visible = true
	label.Text = releaseText.text
	label.TextColor3 = releaseText.color
	label.TextTransparency = math.clamp((age - (RELEASE_TEXT_TIME - 0.4)) / 0.4, 0, 1)
end

function ThrowHud.update()
	updateRelease()
	local h = controllers.ThrowController.hud()
	local panel = refs.panel :: Frame
	panel.Visible = h.holding
	local showHints = h.holding and h.holds <= HINT_HOLDS
	refs.hints.Visible = showHints
	if not h.holding then
		return
	end
	-- while holding the panel covers the release text's spot
	refs.release.Visible = false
	local info = (DiscConfig.Types :: any)[h.throwType]
	refs.type.Text = string.upper(info.Display)
	for id, chip in refs.typeChips do
		local selected = id == h.throwType
		chip.BackgroundColor3 = if selected then C.Accent else C.PanelLight
		chip.TextColor3 = if selected then Color3.new(0, 0, 0) else C.Muted
	end
	refs.height.Text = string.upper(h.height)
	refs.height.TextColor3 = if h.height == "High" then C.Gold elseif h.height == "Low" then C.Good else C.Accent
	local bankDeg = h.bank / h.bankSteps * DiscConfig.Throw.BankRange
	refs.bankDisc.Rotation = bankDeg
	refs.bankText.Text = if h.bank == 0
		then "FLAT"
		elseif h.bank > 0 then ("BANK R" .. h.bank)
		else ("BANK L" .. -h.bank)
	refs.lead.Text = if h.leadLock then ("LEAD: " .. (h.leadName or "aim at a teammate")) else ""
	if showHints then
		refs.desc.Text = info.Description
		refs.keys.Text = hintText(controllers.InputController.scheme())
	end
	updateGauge(h)

	local frac = math.clamp(h.charge / refs.meterScale, 0, 1)
	refs.fill.Size = UDim2.fromScale(1, frac)
	refs.fill.BackgroundColor3 = if h.phase == "Perfect"
		then C.Perfect
		elseif h.phase == "Over" then C.Bad
		else Color3.new(1, 1, 1)
	if h.idealPower then
		refs.ideal.Visible = true
		refs.ideal.Position = UDim2.new(0, -4, 1 - h.idealPower / refs.meterScale, 0)
	else
		refs.ideal.Visible = false
	end
end

return ThrowHud
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Teams" referent="83">
    <Properties>
      <string name="Name">Teams</string>
    </Properties>
  </Item>
  <Item class="Workspace" referent="84">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">160</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>