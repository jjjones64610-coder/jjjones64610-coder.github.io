      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Disc</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DiscPhysics</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DiscPhysics — deterministic flying-disc simulation.

	State is stored as plain numbers (doubles), not Vector3 (float32), so the
	server and every client step the exact same arithmetic from the same launch
	values. Launch values are themselves read back from replicated attributes,
	so all machines start from bit-identical inputs.

	Forces (per unit mass):
	  gravity      (0, -g, 0)
	  lift         K |v|^2 CL(alpha) along the disc normal's component
	               perpendicular to the airflow  -> banking curves the flight
	  drag         K |v|^2 CD(alpha) against the airflow
	Orientation:
	  The spin axis is gyroscopically stable; the aerodynamic pitching moment
	  CM(alpha) makes it precess (roll) at a rate proportional to |v|^2 / spin.
	  CM < 0 at low alpha (fast, flat flight) rolls the disc one way ("turn"),
	  CM > 0 at high alpha (slow, descending) the other ("fade"). Spin sign
	  decides which way is which, so a right-handed backhand turns right early
	  and fades left late, and a forehand mirrors it. More spin = less roll =
	  a more stable line, which is why a clean release matters.
	  Wind enters through the airflow vector (velocity relative to the air).
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)

local P = DiscConfig.Physics

local DiscPhysics = {}

export type State = {
	px: number,
	py: number,
	pz: number,
	vx: number,
	vy: number,
	vz: number,
	nx: number,
	ny: number,
	nz: number,
	spin: number,
	t: number,
}

export type Wind = { x: number, y: number, z: number }

local NO_WIND: Wind = { x = 0, y = 0, z = 0 }

local sqrt = math.sqrt
local asin = math.asin
local clamp = math.clamp
local abs = math.abs

function DiscPhysics.new(
	px: number,
	py: number,
	pz: number,
	vx: number,
	vy: number,
	vz: number,
	nx: number,
	ny: number,
	nz: number,
	spin: number
): State
	local nm = sqrt(nx * nx + ny * ny + nz * nz)
	if nm < 1e-9 then
		nx, ny, nz, nm = 0, 1, 0, 1
	end
	return {
		px = px,
		py = py,
		pz = pz,
		vx = vx,
		vy = vy,
		vz = vz,
		nx = nx / nm,
		ny = ny / nm,
		nz = nz / nm,
		spin = spin,
		t = 0,
	}
end

function DiscPhysics.fromVectors(pos: Vector3, vel: Vector3, normal: Vector3, spin: number): State
	return DiscPhysics.new(pos.X, pos.Y, pos.Z, vel.X, vel.Y, vel.Z, normal.X, normal.Y, normal.Z, spin)
end

function DiscPhysics.copy(s: State): State
	return {
		px = s.px,
		py = s.py,
		pz = s.pz,
		vx = s.vx,
		vy = s.vy,
		vz = s.vz,
		nx = s.nx,
		ny = s.ny,
		nz = s.nz,
		spin = s.spin,
		t = s.t,
	}
end

function DiscPhysics.position(s: State): Vector3
	return Vector3.new(s.px, s.py, s.pz)
end

function DiscPhysics.velocity(s: State): Vector3
	return Vector3.new(s.vx, s.vy, s.vz)
end

function DiscPhysics.normal(s: State): Vector3
	return Vector3.new(s.nx, s.ny, s.nz)
end

function DiscPhysics.speed(s: State): number
	return sqrt(s.vx * s.vx + s.vy * s.vy + s.vz * s.vz)
end

local function liftCoefficient(alpha: number): number
	local a = abs(alpha)
	if a <= P.StallAlpha then
		return P.CL0 + P.CLa * alpha
	end
	local edge = P.CL0 + P.CLa * P.StallAlpha * (if alpha >= 0 then 1 else -1)
	local fall = 1 - (a - P.StallAlpha) / (math.pi / 2 - P.StallAlpha)
	return edge * clamp(fall, 0, 1)
end

-- Angle of attack (radians) of the disc for a given airflow direction.
function DiscPhysics.alpha(s: State, wind: Wind?): number
	local w = wind or NO_WIND
	local ax, ay, az = s.vx - w.x, s.vy - w.y, s.vz - w.z
	local sp = sqrt(ax * ax + ay * ay + az * az)
	if sp < 1e-6 then
		return 0
	end
	local d = (s.nx * ax + s.ny * ay + s.nz * az) / sp
	return -asin(clamp(d, -1, 1))
end

-- Advances the state in place by dt seconds.
function DiscPhysics.step(s: State, dt: number, wind: Wind?)
	local w = wind or NO_WIND
	local ax, ay, az = s.vx - w.x, s.vy - w.y, s.vz - w.z
	local speed2 = ax * ax + ay * ay + az * az
	local fx, fy, fz = 0, -P.Gravity, 0

	if speed2 > 1e-4 then
		local speed = sqrt(speed2)
		local ux, uy, uz = ax / speed, ay / speed, az / speed
		local nx, ny, nz = s.nx, s.ny, s.nz
		local nDotU = nx * ux + ny * uy + nz * uz
		local alpha = -asin(clamp(nDotU, -1, 1))
		local q = P.AirK * speed2

		-- lift: along n with the airflow component removed
		local lx, ly, lz = nx - nDotU * ux, ny - nDotU * uy, nz - nDotU * uz
		local lm = sqrt(lx * lx + ly * ly + lz * lz)
		if lm > 1e-6 then
			local lift = q * liftCoefficient(alpha) / lm
			fx += lift * lx
			fy += lift * ly
			fz += lift * lz
		end

		-- drag
		local da = alpha - P.Alpha0
		local cd = math.min(P.CD0 + P.CDa * da * da, P.CDMax)
		local drag = q * cd
		fx -= drag * ux
		fy -= drag * uy
		fz -= drag * uz

		-- gyroscopic precession of the spin axis
		local spin = s.spin
		if abs(spin) < P.MinSpin then
			spin = if spin >= 0 then P.MinSpin else -P.MinSpin
		end
		local fpx, fpy, fpz = ux - nDotU * nx, uy - nDotU * ny, uz - nDotU * nz
		local fm = sqrt(fpx * fpx + fpy * fpy + fpz * fpz)
		if fm > 1e-6 then
			fpx, fpy, fpz = fpx / fm, fpy / fm, fpz / fm
			-- f x n : the direction the normal moves for a nose-up moment
			local cx = fpy * nz - fpz * ny
			local cy = fpz * nx - fpx * nz
			local cz = fpx * ny - fpy * nx
			local cm = P.CM0 + P.CMa * clamp(alpha, -P.StallAlpha, P.StallAlpha)
			local rate = P.RollK * speed2 * cm / spin
			nx += cx * rate * dt
			ny += cy * rate * dt
			nz += cz * rate * dt
			local nm = sqrt(nx * nx + ny * ny + nz * nz)
			s.nx, s.ny, s.nz = nx / nm, ny / nm, nz / nm
		end
	end

	-- semi-implicit Euler
	s.vx += fx * dt
	s.vy += fy * dt
	s.vz += fz * dt
	s.px += s.vx * dt
	s.py += s.vy * dt
	s.pz += s.vz * dt
	s.spin *= (1 - P.SpinDecay * dt)
	s.t += dt
end

export type Sample = { t: number, x: number, y: number, z: number }

export type Result = {
	samples: { Sample },
	landed: boolean,
	landT: number,
	landX: number,
	landY: number,
	landZ: number,
	maxHeight: number,
	final: State,
}

-- Simulates from `start` (not modified) until ground contact or maxTime,
-- recording a sample every `sampleEvery` steps.
function DiscPhysics.simulate(
	start: State,
	maxTime: number?,
	wind: Wind?,
	groundY: number?,
	sampleEvery: number?
): Result
	local s = DiscPhysics.copy(start)
	local dt = P.Dt
	local limit = maxTime or P.MaxFlightTime
	local ground = (groundY or 0) + P.GroundContact
	local every = sampleEvery or 1
	local samples: { Sample } = { { t = s.t, x = s.px, y = s.py, z = s.pz } }
	local steps = 0
	local maxH = s.py
	local landed = false
	while s.t < limit do
		local ox, oy, oz = s.px, s.py, s.pz
		DiscPhysics.step(s, dt, wind)
		steps += 1
		if s.py > maxH then
			maxH = s.py
		end
		if s.py <= ground then
			-- interpolate the exact contact point inside this step
			local f = if oy - s.py > 1e-9 then (oy - ground) / (oy - s.py) else 1
			f = clamp(f, 0, 1)
			s.px = ox + (s.px - ox) * f
			s.pz = oz + (s.pz - oz) * f
			s.py = ground
			s.t = s.t - dt + dt * f
			landed = true
			table.insert(samples, { t = s.t, x = s.px, y = s.py, z = s.pz })
			break
		end
		if steps % every == 0 then
			table.insert(samples, { t = s.t, x = s.px, y = s.py, z = s.pz })
		end
	end
	return {
		samples = samples,
		landed = landed,
		landT = s.t,
		landX = s.px,
		landY = s.py,
		landZ = s.pz,
		maxHeight = maxH,
		final = s,
	}
end

-- Advances a state forward to absolute flight time `t` using fixed steps.
-- Returns false if the disc reached the ground first; the state is then left
-- at the interpolated contact point and time, exactly like simulate() and the
-- server's flight stepping, so every machine shows the same landing spot.
function DiscPhysics.advanceTo(s: State, t: number, wind: Wind?, groundY: number?): boolean
	local dt = P.Dt
	local ground = (groundY or 0) + P.GroundContact
	while s.t + dt <= t + 1e-9 do
		local ox, oy, oz = s.px, s.py, s.pz
		DiscPhysics.step(s, dt, wind)
		if s.py <= ground then
			local f = if oy - s.py > 1e-9 then clamp((oy - ground) / (oy - s.py), 0, 1) else 1
			s.px = ox + (s.px - ox) * f
			s.pz = oz + (s.pz - oz) * f
			s.py = ground
			s.t = s.t - dt + dt * f
			return false
		end
	end
	return true
end

-- Position at fractional time `t` between fixed steps (for smooth rendering):
-- linearly extrapolates from the current state, which must be at s.t <= t.
function DiscPhysics.positionAt(s: State, t: number): (number, number, number)
	local f = t - s.t
	return s.px + s.vx * f, s.py + s.vy * f, s.pz + s.vz * f
end

return DiscPhysics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Solver</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Solver — finds throw inputs that deliver the disc to a (possibly moving)
	receiver. Used by bots, by the training launcher, and by the optional
	Lead Pass assist (which only extrapolates the receiver's CURRENT velocity —
	it cannot predict a cut, so reading your receiver is still the skill).

	Strategy: coarse grid over (power, aim pitch) with a cheap low-rate sim,
	refine around the best cell, and correct yaw twice for the curve.

	A holder who has planted a pivot passes `pivot` (and optionally the
	`step` they will release from): the candidates are then launched from the
	pivot release point exactly as ThrowModel will launch the real throw, and
	the returned params carry both. The power grid spans the whole MinSpeed..
	MaxSpeed range, so short touch passes and full hucks are both found.
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(script.Parent.DiscPhysics)
local ThrowModel = require(script.Parent.ThrowModel)

local Solver = {}

export type Options = {
	rootPos: Vector3,
	throwerVel: Vector3?,
	throwType: string,
	bank: number?,
	height: string?,
	target: Vector3,
	targetVel: Vector3?,
	wind: DiscPhysics.Wind?,
	groundY: number?,
	leftHanded: boolean?,
	maxPower: number?,
	coarse: boolean?, -- smaller search for client-side assist
	flightTimeWeight: number?,
	pivot: Vector3?, -- planted pivot foot P: launch from P + step (see ThrowModel)
	step: Vector3?, -- flat step from P (ignored without a pivot)
}

export type Solution = {
	params: ThrowModel.Params,
	miss: number,
	flightTime: number,
	catchPoint: Vector3,
}

local function paramsFor(o: Options, yaw: number, pitch: number, holdTime: number): ThrowModel.Params
	return {
		throwType = o.throwType,
		yaw = yaw,
		pitch = pitch,
		holdTime = holdTime,
		bank = o.bank or 0,
		height = o.height or "Mid",
		leftHanded = o.leftHanded,
		pivot = o.pivot,
		step = if o.pivot then ThrowModel.clampStep(o.step, yaw) else nil,
	}
end

local function holdForPower(power: number, throwType: string): number
	local info = ThrowModel.typeInfo(throwType)
	local mult = info.ChargeMult or 1
	if power >= 0.999 then
		-- land inside the Perfect window
		return (DiscConfig.Throw.ChargeTime + DiscConfig.Throw.PerfectWindow * 0.5) / mult
	end
	return power * DiscConfig.Throw.ChargeTime / mult
end

-- Simulates one candidate; returns closest catchable approach to the moving
-- target: distance, time, lateral error (signed, relative to aim right).
local function evaluate(
	o: Options,
	yaw: number,
	pitch: number,
	power: number,
	dt: number
): (number, number, number, Vector3)
	local params = paramsFor(o, yaw, pitch, holdForPower(power, o.throwType))
	local launch = ThrowModel.launch(params, o.rootPos, o.throwerVel or Vector3.zero)
	local s = launch.state
	local ground = (o.groundY or 0)
	local tv = o.targetVel or Vector3.zero
	local tx, ty, tz = o.target.X, o.target.Y, o.target.Z
	local best, bestT = math.huge, 0
	local bx, by, bz = s.px, s.py, s.pz
	local limit = 6
	while s.t < limit do
		DiscPhysics.step(s, dt, o.wind)
		local h = s.py - ground
		if h <= DiscConfig.Physics.GroundContact then
			break
		end
		if h > 0.8 and h < 9.5 then
			local cx = tx + tv.X * s.t
			local cz = tz + tv.Z * s.t
			local dx, dy, dz = s.px - cx, s.py - ty, s.pz - cz
			local d = math.sqrt(dx * dx + dy * dy * 0.6 + dz * dz)
			if d < best then
				best, bestT = d, s.t
				bx, by, bz = s.px, s.py, s.pz
			end
		end
	end
	local _, right = ThrowModel.basis(yaw)
	local cxb = tx + tv.X * bestT
	local czb = tz + tv.Z * bestT
	local lateral = (bx - cxb) * right.X + (bz - czb) * right.Z
	return best, bestT, lateral, Vector3.new(bx, by, bz)
end

function Solver.solve(o: Options): Solution?
	local maxPower = o.maxPower or 1
	local flightW = o.flightTimeWeight or 0.6
	local tv = o.targetVel or Vector3.zero
	local origin = o.pivot or o.rootPos

	-- initial yaw toward a lead point
	local tGuess = (o.target - origin).Magnitude / 55
	local aim = o.target + Vector3.new(tv.X, 0, tv.Z) * tGuess
	local d = aim - origin
	local yaw = math.atan2(-d.X, -d.Z)

	local powers: { number } = {}
	local pitches: { number } = {}
	local dtCoarse: number
	if o.coarse then
		for p = 0.1, 1.0001, 0.15 do
			table.insert(powers, math.min(p, maxPower))
		end
		for a = -12, 30, 7 do
			table.insert(pitches, math.rad(a))
		end
		dtCoarse = 1 / 30
	else
		for p = 0.05, 1.0001, 0.095 do
			table.insert(powers, math.min(p, maxPower))
		end
		table.insert(powers, maxPower)
		for a = -14, 34, 4 do
			table.insert(pitches, math.rad(a))
		end
		dtCoarse = 1 / 40
	end

	local bestScore, bestMiss, bestT = math.huge, math.huge, 0
	local bestPower, bestPitch = 0.5, 0
	local bestPoint = o.target

	for iteration = 1, 3 do
		bestScore = math.huge
		for _, power in powers do
			for _, pitch in pitches do
				local miss, t, _, point = evaluate(o, yaw, pitch, power, dtCoarse)
				local score = miss + flightW * t
				if score < bestScore then
					bestScore, bestMiss, bestT = score, miss, t
					bestPower, bestPitch, bestPoint = power, pitch, point
				end
			end
		end
		-- refine around the best cell at the real step size
		local dt = DiscConfig.Physics.Dt
		local refinedScore = math.huge
		local rp, ra = bestPower, bestPitch
		for dp = -0.04, 0.0401, 0.02 do
			for da = -2, 2.001, 1 do
				local power = math.clamp(bestPower + dp, 0, maxPower)
				local pitch = bestPitch + math.rad(da)
				local miss, t, _, point = evaluate(o, yaw, pitch, power, dt)
				local score = miss + flightW * t
				if score < refinedScore then
					refinedScore, bestMiss, bestT = score, miss, t
					rp, ra, bestPoint = power, pitch, point
				end
			end
		end
		bestPower, bestPitch = rp, ra
		-- correct yaw for curve / lead
		local _, _, lateral = evaluate(o, yaw, bestPitch, bestPower, dt)
		local horiz = Vector3.new(bestPoint.X - origin.X, 0, bestPoint.Z - origin.Z).Magnitude
		if horiz < 1 or math.abs(lateral) < 0.4 or iteration == 3 then
			break
		end
		yaw += math.atan2(lateral, horiz)
		-- narrow the grid around the current solution for the next pass
		powers = {}
		pitches = {}
		for p = bestPower - 0.15, bestPower + 0.1501, 0.05 do
			if p >= 0 and p <= maxPower then
				table.insert(powers, p)
			end
		end
		for a = -6, 6.001, 2 do
			table.insert(pitches, bestPitch + math.rad(a))
		end
	end

	if bestMiss == math.huge then
		return nil
	end

	return {
		params = paramsFor(o, yaw, bestPitch, holdForPower(bestPower, o.throwType)),
		miss = bestMiss,
		flightTime = bestT,
		catchPoint = bestPoint,
	}
end

Solver.holdForPower = holdForPower

return Solver
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ThrowModel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ThrowModel — turns a player's throw inputs into a disc launch state.

	Inputs that matter (all deterministic, no hidden accuracy roll):
	  throw type      Backhand / Forehand / Hammer / Scoober / Blade
	  aim yaw/pitch   from the camera
	  hold time       charge -> power; releasing in the Perfect window at full
	                  charge gives +speed and +spin; holding too long (Over)
	                  bleeds spin, which makes the disc roll more (turn/fade)
	  bank            -1..1, tilts the disc so lift curves the flight
	  release height  High (hop / over the mark), Mid, Low (step-out under the mark)
	  pivot + step    where the disc leaves the hand (see below)
	  balance         throwing airborne / from the ground / on the run costs
	                  power cap and spin; releasing mid Quick Swing costs spin

	Release point. With a planted pivot foot P (params.pivot) the disc leaves
	from P + step + side/height offsets, where step is the flat free-foot vector
	(|step| <= StepRadius, forward part <= ForwardMax * R, back <= BackMax * R,
	all from Config/Movement.Holding). Lateral = Side * PivotSideScale, plus
	LowReach to the throw's side for a Low release; height = the release
	height (or OverheadHeight) plus the hop: how far the root is above P.
	Lag on the thrower's body therefore never moves the release; only P and
	the step do. A planted pivot has no run-up, so thrower velocity carry and
	the moving-spin penalty only apply without a pivot (a release on the run
	or during the slow-down), which still uses root-relative offsets.
	Left-handed throwers mirror every side offset; the step is a world vector
	and is never mirrored (the foot is where it is).
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local DiscPhysics = require(script.Parent.DiscPhysics)

local T = DiscConfig.Throw
local HD = MovementConfig.Holding

local ThrowModel = {}

export type Params = {
	throwType: string,
	yaw: number, -- radians, 0 = -Z
	pitch: number, -- radians, aim elevation (type offset is added here)
	holdTime: number, -- seconds the throw was charged
	bank: number, -- -1..1
	height: string, -- "High" | "Mid" | "Low"
	offBalance: boolean?,
	groundThrow: boolean?,
	leftHanded: boolean?,
	pivot: Vector3?, -- planted pivot foot P (root height); nil = release from the root
	step: Vector3?, -- flat free-foot step from P (world); ignored without a pivot
	swinging: boolean?, -- released while a Quick Swing is still moving the step
	-- Carried through sanitize for ThrowService; the model itself ignores them.
	releaseT: number?, -- client Net.now() at release
	rootPos: Vector3?, -- client root position at release
}

export type Launch = {
	state: DiscPhysics.State,
	releasePos: Vector3,
	velocity: Vector3,
	normal: Vector3,
	quality: string, -- "Perfect" | "Clean" | "Over"
	power: number,
	spinFactor: number,
	speed: number,
	pitchDeg: number,
	bankDeg: number,
}

local VALID_HEIGHTS = { High = true, Mid = true, Low = true }
local UP = Vector3.new(0, 1, 0)

local function finite(v: number): boolean
	return v == v and v ~= math.huge and v ~= -math.huge
end

local function finiteVector(v: any): Vector3?
	if typeof(v) ~= "Vector3" then
		return nil
	end
	local p = v :: Vector3
	if finite(p.X) and finite(p.Y) and finite(p.Z) then
		return p
	end
	return nil
end

function ThrowModel.typeInfo(throwType: string): any
	return (DiscConfig.Types :: any)[throwType] or DiscConfig.Types.Backhand
end

function ThrowModel.basis(yaw: number): (Vector3, Vector3)
	local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	return forward, right
end

-- Charge time -> (power, quality, spinFactor). Power rises linearly to full at
-- ChargeTime (scaled by the throw's ChargeMult). Releasing inside the Perfect
-- window at full charge is a Perfect release.
function ThrowModel.charge(holdTime: number, throwType: string): (number, string, number)
	local info = ThrowModel.typeInfo(throwType)
	local t = math.max(0, holdTime) * (info.ChargeMult or 1)
	if t < T.ChargeTime then
		return math.clamp(t / T.ChargeTime, 0, 1), "Clean", 1
	end
	local over = t - T.ChargeTime
	if over <= T.PerfectWindow then
		return 1, "Perfect", T.PerfectSpinMult
	end
	local spin = math.max(T.MinOverSpin, 1 - (over - T.PerfectWindow) * T.OverchargeDecay)
	return 1, "Over", spin
end

-- Clamps any value into a legal step for aim `yaw`: a flat Vector3 with
-- |step| <= StepRadius and its forward part in [-BackMax, ForwardMax] * R
-- (the same limits MovementSim uses). Junk, NaN or infinity -> zero.
function ThrowModel.clampStep(step: any, yaw: number): Vector3
	local v = finiteVector(step)
	if not v then
		return Vector3.zero
	end
	local R = HD.StepRadius
	local forward, right = ThrowModel.basis(if finite(yaw) then yaw else 0)
	local f = v.X * forward.X + v.Z * forward.Z
	local l = v.X * right.X + v.Z * right.Z
	local len = math.sqrt(f * f + l * l)
	if len > R then
		f, l = f * R / len, l * R / len
	end
	f = math.clamp(f, -HD.BackMax * R, HD.ForwardMax * R)
	return forward * f + right * l
end

-- The step implied by where the root actually is: the root sits at
-- P + BodyShare * step, so step = (root - P) / BodyShare (clamped).
function ThrowModel.stepFromRoot(rootPos: Vector3, pivot: Vector3, yaw: number): Vector3
	local d = rootPos - pivot
	return ThrowModel.clampStep(Vector3.new(d.X, 0, d.Z) / HD.BodyShare, yaw)
end

-- Server check of a client's step. Accepts the (clamped) claimed step when the
-- server's view of the root is within StepCheckBase + StepCheckPing *
-- min(ping, StepCheckMaxPing) of P + BodyShare * step (flat distance);
-- otherwise falls back to the step implied by the server root.
-- Returns (step to use, accepted).
function ThrowModel.resolveStep(
	claimed: any,
	pivot: Vector3,
	serverRoot: Vector3,
	ping: number,
	yaw: number
): (Vector3, boolean)
	local s = ThrowModel.clampStep(claimed, yaw)
	local expected = pivot + s * HD.BodyShare
	local lag = if finite(ping) then math.clamp(ping, 0, T.StepCheckMaxPing) else 0
	local tolerance = T.StepCheckBase + T.StepCheckPing * lag
	local off = serverRoot - expected
	if Vector3.new(off.X, 0, off.Z).Magnitude <= tolerance then
		return s, true
	end
	return ThrowModel.stepFromRoot(serverRoot, pivot, yaw), false
end

-- Clamps untrusted client parameters into the legal range.
function ThrowModel.sanitize(raw: any): Params?
	if type(raw) ~= "table" then
		return nil
	end
	local throwType = if type(raw.throwType) == "string" and (DiscConfig.Types :: any)[raw.throwType]
		then raw.throwType
		else nil
	if not throwType then
		return nil
	end
	local function num(v: any, lo: number, hi: number, default: number): number
		if type(v) ~= "number" or not finite(v) then
			return default
		end
		return math.clamp(v, lo, hi)
	end
	local yaw = num(raw.yaw, -1000, 1000, 0)
	local releaseT = raw.releaseT
	return {
		throwType = throwType,
		yaw = yaw,
		pitch = num(raw.pitch, math.rad(-80), math.rad(80), 0),
		holdTime = num(raw.holdTime, 0, 5, 0),
		bank = num(raw.bank, -1, 1, 0),
		height = if type(raw.height) == "string" and VALID_HEIGHTS[raw.height] then raw.height else "Mid",
		offBalance = raw.offBalance == true,
		groundThrow = raw.groundThrow == true,
		leftHanded = raw.leftHanded == true,
		pivot = finiteVector(raw.pivot),
		step = ThrowModel.clampStep(raw.step, yaw),
		swinging = raw.swinging == true,
		releaseT = if type(releaseT) == "number" and finite(releaseT) then releaseT else nil,
		rootPos = finiteVector(raw.rootPos),
	}
end

-- Where the disc leaves the hand. With p.pivot: from the pivot plus the step
-- (see the header); `rootPos` then only supplies the hop height. Without a
-- pivot (or for a throw from the ground after a layout): relative to the
-- root part, as on the run.
function ThrowModel.releasePosition(p: Params, rootPos: Vector3): Vector3
	local info = ThrowModel.typeInfo(p.throwType)
	local forward, right = ThrowModel.basis(p.yaw)
	local mirror = if p.leftHanded then -1 else 1
	local heightUp = (DiscConfig.Heights :: any)[p.height] or DiscConfig.Heights.Mid

	local pivot = p.pivot
	if pivot and not p.groundThrow then
		local step = ThrowModel.clampStep(p.step, p.yaw)
		local hop = math.clamp(rootPos.Y - pivot.Y, 0, T.MaxHopLift)
		if hop ~= hop then
			hop = 0
		end
		local lateral = info.Side * T.PivotSideScale
		local up: number
		if info.Overhead then
			up = DiscConfig.OverheadHeight
		else
			up = heightUp
			if p.height == "Low" then
				lateral += T.LowReach * (if info.Side >= 0 then 1 else -1)
			end
		end
		return pivot + step + right * (lateral * mirror) + UP * (up + hop) + forward * T.ReleaseForward
	end

	local side: number
	local up: number
	if info.Overhead then
		side = info.Side
		up = DiscConfig.OverheadHeight + (if p.height == "High" then 0.6 else 0)
	elseif p.height == "Low" then
		side = info.LowSide
		up = DiscConfig.Heights.Low
	else
		side = info.Side
		up = heightUp
	end
	if p.groundThrow then
		up = -1.9
	end
	return rootPos + right * (side * mirror) + UP * up + forward * T.ReleaseForward
end

function ThrowModel.launch(p: Params, rootPos: Vector3, throwerVel: Vector3): Launch
	local info = ThrowModel.typeInfo(p.throwType)
	local mirror = if p.leftHanded then -1 else 1
	local pivoting = p.pivot ~= nil and not p.groundThrow

	local power, quality, spinFactor = ThrowModel.charge(p.holdTime, p.throwType)
	if p.offBalance then
		power = math.min(power, T.OffBalancePowerCap)
		spinFactor *= T.OffBalanceSpin
		if quality == "Perfect" then
			quality = "Clean"
		end
	end
	if p.groundThrow then
		power = math.min(power, T.GroundThrowPowerCap)
		spinFactor *= T.OffBalanceSpin
		if quality == "Perfect" then
			quality = "Clean"
		end
	end
	-- On the run: spin cost above a jog plus some of the run-up carried. From
	-- a pivot the root only shuffles around P, so neither applies; a release
	-- mid swing costs SwingSpinPenalty instead (power is never capped).
	local carry = Vector3.zero
	if not pivoting then
		local flat = Vector3.new(throwerVel.X, 0, throwerVel.Z)
		if flat.Magnitude ~= flat.Magnitude then
			flat = Vector3.zero
		end
		if flat.Magnitude > T.MovingSpinPenaltySpeed then
			spinFactor *= T.MovingSpinPenalty
		end
		carry = flat * T.ThrowerVelocityCarry
	end
	if p.swinging then
		spinFactor *= T.SwingSpinPenalty
	end

	local minPitch = if info.Overhead then 10 else T.MinPitch
	local maxPitch = if info.Overhead then 72 else T.MaxPitch
	local pitchDeg = math.clamp(math.deg(p.pitch) + info.PitchOffset, minPitch, maxPitch)
	local pitch = math.rad(pitchDeg)

	local speed = (T.MinSpeed + (T.MaxSpeed - T.MinSpeed) * (power ^ T.PowerCurve)) * info.SpeedMult
	if quality == "Perfect" then
		speed *= T.PerfectSpeedMult
	end

	local forward, right = ThrowModel.basis(p.yaw)
	local dir = forward * math.cos(pitch) + UP * math.sin(pitch)

	-- Orientation: start flat relative to the flight path, bank about the
	-- flight direction, then tilt the nose by the throw's release angle.
	local bankDeg = (info.Bank + p.bank * T.BankRange) * mirror
	local beta = math.rad(bankDeg)
	local alpha = math.rad(info.Alpha)
	local n0 = UP * math.cos(pitch) - forward * math.sin(pitch)
	local nRot = n0 * math.cos(beta) + right * math.sin(beta)
	local normal = (nRot * math.cos(alpha) - dir * math.sin(alpha)).Unit

	local velocity = dir * speed + carry
	local releasePos = ThrowModel.releasePosition(p, rootPos)
	local spin = T.SpinBase * spinFactor * info.Spin * mirror

	return {
		state = DiscPhysics.fromVectors(releasePos, velocity, normal, spin),
		releasePos = releasePos,
		velocity = velocity,
		normal = normal,
		quality = quality,
		power = power,
		spinFactor = spinFactor,
		speed = speed,
		pitchDeg = pitchDeg,
		bankDeg = bankDeg,
	}
end

return ThrowModel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Movement</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MovementSim</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MovementSim — the movement-tech engine.

	Pure simulation of one player's horizontal momentum, technique timing,
	exertion, cooldowns, the disc holder's pivot and the marker's shuffle. It
	knows nothing about Instances: a driver (the client MovementController for
	the local player, BotService for bots) feeds it input + an environment
	snapshot and applies the returned velocity. The Humanoid moves the body:
	the driver sets WalkSpeed = |vel| and Move(vel.Unit), and on frames where
	Output.impulse is true it also writes AssemblyLinearVelocity directly so
	technique starts land on the frame they are pressed. Because it is pure, the
	same code is fuzz-tested offline (tests/movement_spec.luau) to prove that no
	input sequence can exceed the speed caps.

	PRESS CONTRACT. press(s, action, input, env) returns (ok, reason). Every
	press does something visible or gives a reason ("Cooldown", "Speed",
	"Used", "Context"; "Exertion" is reserved and never produced, because a
	tired technique still fires as Gassed). Refusals that deserve explaining
	also queue a Feedback { kind = reason, value?, text } with ready-to-show
	text ("NEED SPEED", "ONE PER JUMP", ...). Presses that are slightly early,
	in a short cooldown or about to become valid are BUFFERED for
	InputBuffer (0.15 s) and retried every step(); a buffered press returns
	true. Pressing the same action again while it waits changes nothing (this
	replaces the old anti-mash lockouts). Timing changes only the bonus.

	Inputs map to five actions plus the holder's swing:

	  Cut   ground, input 25-120 deg off the running line -> Snap Cut
	        ground, input along the line                -> 0.1 s look-ahead:
	              steer away inside it = Snap Cut, else Fake Commit (jab)
	        ground, no input / input >120 deg, fast       -> Momentum Cancel (plant)
	        ground, slower than SnapCut.MinSpeed          -> quick side step
	        during a plant's restart window               -> restart (Perfect/Clean)
	        in the air                                    -> Air Redirect
	        mid-slide                                     -> Slide Cut
	        dive recovery (DiveSlide/Recover)             -> Recovery Chain
	  Burst ground or slide                               -> Burst Step
	        during a plant window                         -> Explosive restart (free)
	        just before touchdown                         -> buffered, fires on landing
	  Slide ground, fast                                  -> Slide
	        airborne, <=0.35 s before touchdown           -> Precision Landing / Roll-out
	  Dive  ground, slide or once in the air              -> Layout dive
	  Jump  ground / slide                                -> Jump / slide hop / plant jump
	        airborne beside a Rebound wall                -> Wall Rebound
	        dive recovery                                 -> Recovery Chain pop-up
	        holding the disc                              -> hop (one per possession)

	A Cut is judged against the RUNNING LINE: the direction you had been
	committed to (CommitAngle), remembered for LineMemory after it breaks, so the
	direction key a keyboard player must press before Q (the pre-steer) never
	spoils the cut. A plant ends with an automatic restart if a direction is
	held; pressing Q/F/Space inside its window upgrades it.

	HOLDING THE DISC (positional step model). After the (predicted) catch the
	holder slows down (Decel) and plants a pivot foot P once slower than
	PlantSpeed or after DecelMaxTime; the plant is reported once in
	Output.pivotPos so the driver can propose it to the server, and
	setPivot() adopts the server's authoritative P (UBPivot). The free foot is
	a step vector s in the throw frame (forward = env.aimYaw, so camera-relative
	WASD == aim-relative): target R * input, forward <= 0.75R, back <= 0.9R,
	length on a critically damped spring, direction turning through the front.
	The root is driven toward P + BodyShare * s (velocity proportional to the
	distance, capped, never overshooting). swing(side) is the Quick Swing,
	fakeStep(side) the fake's lunge, Jump the one hop (horizontal zeroed, step
	frozen). Output.step is the world step vector.

	MARKING. setMarking(true) overlays the mark shuffle on the ground: tight
	acceleration, no turn radius, no sprint drain. Cut/Dive/Burst fire their
	technique and end the mark; Jump keeps it; Slide is left to the stance
	toggle (refused here).
]]

local Shared = script.Parent.Parent
local Config = require(Shared.Config.Movement)
local VecMath = require(Shared.Util.VecMath)

local MovementSim = {}

export type Mode = "Ground" | "Air" | "Slide" | "Dive" | "DiveSlide" | "Recover" | "Landing" | "Frozen"
export type HoldPhase = "None" | "Air" | "Decel" | "Pivot"
export type Action = "Jump" | "Cut" | "Slide" | "Dive" | "Burst"
-- Why a press did nothing. "Exertion" is part of the contract but never produced.
export type Reason = "Cooldown" | "Speed" | "Used" | "Context" | "Exertion"

export type TechEvent = {
	tech: string,
	quality: string,
	t: number,
	dir: Vector3,
	chain: boolean,
	info: string?,
}

export type Feedback = { kind: string, value: number?, text: string? }

export type Input = { move: Vector3, sprint: boolean }

export type Env = {
	grounded: boolean,
	actualVel: Vector3,
	timeToLand: number?,
	wallNormal: Vector3?,
	wallDistance: number?,
	wallId: string?,
	facing: Vector3?,
	pos: Vector3?, -- root position (needed while holding; estimated from velocity otherwise)
	aimYaw: number?, -- camera / throw yaw (radians, CameraController.getYaw convention)
	blocked: boolean?, -- a short horizontal ray along the sim velocity hit something solid
	pivotOffset: Vector3?, -- deprecated and ignored: the pivot lives in the sim (setPivot)
}

export type Output = {
	vel: Vector3,
	setVertical: number?,
	jump: boolean,
	events: { TechEvent },
	feedback: { Feedback },
	pivotEstablished: boolean,
	landed: boolean,
	tookOff: boolean,
	impulse: boolean, -- write AssemblyLinearVelocity this frame (technique start / velocity jump)
	step: Vector3, -- world flat step vector s (zero when not holding)
	pivotPos: Vector3?, -- set on the frame the sim plants its own pivot foot
}

type Buffered = { action: string, expires: number, side: number }

export type State = {
	mode: Mode,
	now: number,
	modeStart: number,
	vel: Vector3,
	pos: Vector3,
	lastOutVel: Vector3,
	lastMove: Vector3,
	impulse: boolean,
	exertion: number,
	regenAt: number,
	ready: { [string]: number },
	lastTech: string?,
	lastTechAt: number,
	lastKeyTech: string?, -- last technique other than Jump (Perfect chain checks)
	lastKeyAt: number,
	lastCutAt: number,
	blockedSince: number?,

	-- running line
	committed: boolean,
	commitDir: Vector3,
	commitSince: number,
	lineSpeed: number,
	prevLineDir: Vector3,
	prevLineSince: number,
	prevLineSpeed: number,
	lineResetAt: number,

	-- input buffer / Cut look-ahead
	buffer: Buffered?,
	retrying: boolean,
	retryDeferred: boolean,
	retryReason: string?,
	retryText: string?,
	retryValue: number?,
	lookAheadUntil: number,
	lookLine: Vector3,
	lookSince: number,
	lookSpeed: number,

	plantAt: number,
	plantEnd: number,
	plantDecel: number,
	plantGassed: boolean,
	plantResolved: boolean,

	jabUntil: number,
	sideStepUntil: number,
	sideStepDir: Vector3,
	sideStepSpeed: number,
	soldUntil: number,
	soldDir: Vector3,

	burstUntil: number,
	burstDir: Vector3,
	burstSpeed: number,

	airStart: number,
	groundLostAt: number?,
	takeoffSpeed: number,
	airRedirectUsed: boolean,
	airDiveUsed: boolean,
	aerialReachUsed: boolean,
	rebounds: number,
	lastWall: string?,

	landingUntil: number,
	landedAt: number,
	landedFromDive: boolean,
	landingVel: Vector3,
	precisionArmedAt: number?,
	lateLandingUntil: number,

	recoverUntil: number,
	popStart: number,

	diveDir: Vector3,

	holding: boolean,
	holdPhase: HoldPhase,
	holdStart: number,
	holdHopped: boolean,
	pivot: Vector3?,
	pivotAdopted: boolean,
	stalePivot: Vector3?, -- an adopted pivot we had to abandon (far away); ignored if passed again
	step: Vector3,
	stepLenVel: number,
	swingUntil: number,
	lastSwingSide: number,
	fakeUntil: number,
	fakeSide: number,
	lastFakeAt: number,
	restActive: boolean,
	restX: number,
	restY: number,
	restInputDir: Vector3,
	restInputMag: number,

	marking: boolean,

	frozen: boolean,

	pendingVertical: number?,
	pendingJump: boolean,
	pendingEvents: { TechEvent },
	pendingFeedback: { Feedback },
	pendingPivot: boolean,
	pendingPivotPos: Vector3?,
}

local Q = Config.Quality
local SC = Config.SnapCut
local MC = Config.MomentumCancel
local FC = Config.FakeCommit
local BS = Config.BurstStep
local SL = Config.Slide
local SLC = Config.SlideCut
local DV = Config.Dive
local DS = Config.DiveSlide
local RC = Config.Recover
local RO = Config.RollOut
local AR = Config.AirRedirect
local PL = Config.PrecisionLanding
local WR = Config.WallRebound
local HD = Config.Holding
local MK = Config.Marking

local FORWARD = Vector3.new(0, 0, -1)
local BUFFER = Config.InputBuffer
local NO_INPUT: Input = { move = Vector3.zero, sprint = false }

-- Short names for cooldown feedback.
local SHORT: { [string]: string } = {
	BurstStep = "BURST",
	Dive = "LAYOUT",
	MomentumCancel = "PLANT",
	Slide = "SLIDE",
	FakeCommit = "FAKE",
	PivotSwing = "SWING",
}

-- Techniques whose follow-up Burst / Layout counts as a Perfect chain.
local BURST_CHAIN: { [string]: boolean } = {
	SnapCut = true,
	SlideCut = true,
	RecoveryChain = true,
	MomentumCancel = true,
}
local DIVE_CHAIN: { [string]: boolean } = {
	SnapCut = true,
	BurstStep = true,
	SlideCut = true,
	AirRedirect = true,
	RecoveryChain = true,
	MomentumCancel = true,
	PrecisionLanding = true,
	Slide = true,
}

---------------------------------------------------------------------------
-- construction
---------------------------------------------------------------------------

function MovementSim.new(now: number?): State
	local t = now or 0
	return {
		mode = "Ground",
		now = t,
		modeStart = t,
		vel = Vector3.zero,
		pos = Vector3.zero,
		lastOutVel = Vector3.zero,
		lastMove = Vector3.zero,
		impulse = false,
		exertion = Config.ExertionMax,
		regenAt = t,
		ready = {},
		lastTech = nil,
		lastTechAt = -math.huge,
		lastKeyTech = nil,
		lastKeyAt = -math.huge,
		lastCutAt = -math.huge,
		blockedSince = nil,

		committed = false,
		commitDir = FORWARD,
		commitSince = t,
		lineSpeed = 0,
		prevLineDir = FORWARD,
		prevLineSince = t,
		prevLineSpeed = 0,
		lineResetAt = -math.huge,

		buffer = nil,
		retrying = false,
		retryDeferred = false,
		retryReason = nil,
		retryText = nil,
		retryValue = nil,
		lookAheadUntil = 0,
		lookLine = FORWARD,
		lookSince = t,
		lookSpeed = 0,

		plantAt = 0,
		plantEnd = 0,
		plantDecel = MC.BrakeDecel,
		plantGassed = false,
		plantResolved = true,

		jabUntil = 0,
		sideStepUntil = 0,
		sideStepDir = FORWARD,
		sideStepSpeed = 0,
		soldUntil = 0,
		soldDir = FORWARD,

		burstUntil = 0,
		burstDir = FORWARD,
		burstSpeed = 0,

		airStart = t,
		groundLostAt = nil,
		takeoffSpeed = 0,
		airRedirectUsed = false,
		airDiveUsed = false,
		aerialReachUsed = false,
		rebounds = 0,
		lastWall = nil,

		landingUntil = 0,
		landedAt = -math.huge,
		landedFromDive = false,
		landingVel = Vector3.zero,
		precisionArmedAt = nil,
		lateLandingUntil = 0,

		recoverUntil = 0,
		popStart = 0,

		diveDir = FORWARD,

		holding = false,
		holdPhase = "None",
		holdStart = 0,
		holdHopped = false,
		pivot = nil,
		pivotAdopted = false,
		stalePivot = nil,
		step = Vector3.zero,
		stepLenVel = 0,
		swingUntil = 0,
		lastSwingSide = -1,
		fakeUntil = -math.huge,
		fakeSide = 0,
		lastFakeAt = -math.huge,
		restActive = false,
		restX = 0,
		restY = 0,
		restInputDir = Vector3.zero,
		restInputMag = 0,

		marking = false,

		frozen = false,

		pendingVertical = nil,
		pendingJump = false,
		pendingEvents = {},
		pendingFeedback = {},
		pendingPivot = false,
		pendingPivotPos = nil,
	}
end

-- Clears momentum and transient technique state (respawn / teleport). Keeps
-- exertion, cooldowns, frozen, the possession (holding, hold phase, the one
-- hop) and the pivot foot; the step restarts squared up.
function MovementSim.reset(s: State)
	local keep = {
		now = s.now,
		pos = s.pos,
		exertion = s.exertion,
		ready = s.ready,
		frozen = s.frozen,
		holding = s.holding,
		holdPhase = s.holdPhase,
		holdStart = s.holdStart,
		holdHopped = s.holdHopped,
		pivot = s.pivot,
		pivotAdopted = s.pivotAdopted,
		stalePivot = s.stalePivot,
		lastSwingSide = s.lastSwingSide,
	}
	local fresh = MovementSim.new(s.now)
	for k, v in fresh :: any do
		(s :: any)[k] = v
	end
	for k, v in keep :: any do
		(s :: any)[k] = v
	end
	if s.frozen then
		s.mode = "Frozen"
	end
end

---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------

local function setMode(s: State, m: Mode)
	s.mode = m
	s.modeStart = s.now
end

local function cooldownLeft(s: State, tech: string): number
	return math.max(0, (s.ready[tech] or -math.huge) - s.now)
end

local function setCooldown(s: State, tech: string)
	local cd = (Config.TechCooldowns :: any)[tech] or 0
	s.ready[tech] = s.now + cd
end

local function spend(s: State, cost: number)
	s.exertion = math.max(0, s.exertion - cost)
	s.regenAt = s.now + Config.ExertionRegenDelay
end

local function isGassed(s: State, cost: number): boolean
	return s.exertion < cost * Config.GassedFraction
end

local function emit(s: State, tech: string, quality: string, dir: Vector3, info: string?)
	local chain = s.lastTech ~= nil and (s.now - s.lastTechAt) <= Config.ChainWindow
	table.insert(s.pendingEvents, {
		tech = tech,
		quality = quality,
		t = s.now,
		dir = dir,
		chain = chain,
		info = info,
	})
	s.lastTech = tech
	s.lastTechAt = s.now
	if tech ~= "Jump" then
		s.lastKeyTech = tech
		s.lastKeyAt = s.now
	end
	if tech ~= "AerialReach" then
		s.impulse = true
	end
end

local function feedback(s: State, kind: string, value: number?, text: string?)
	table.insert(s.pendingFeedback, { kind = kind, value = value, text = text })
end

-- A press that cannot fire. Shows `text` (if any) and returns the reason.
local function refuse(s: State, reason: string, text: string?, value: number?): (boolean, string?)
	if text then
		feedback(s, reason, value, text)
	end
	return false, reason
end

-- A press that will (probably) become valid within the buffer time: keep it and
-- retry every step. While retrying, only record why it is still waiting.
local function defer(
	s: State,
	action: string,
	side: number,
	reason: string,
	text: string?,
	value: number?
): (boolean, string?)
	if s.retrying then
		s.retryDeferred = true
		s.retryReason = reason
		s.retryText = text
		s.retryValue = value
		return false, reason
	end
	s.buffer = { action = action, expires = s.now + BUFFER, side = side }
	return true, nil
end

local function cooldownText(tech: string, left: number): string
	return string.format("%s READY IN %.1fs", SHORT[tech] or string.upper(tech), left)
end

local function queueJump(s: State, vy: number)
	s.pendingVertical = vy
	s.pendingJump = true
end

local function queueVertical(s: State, vy: number)
	s.pendingVertical = vy
end

local function clearPlant(s: State)
	s.plantAt = 0
	s.plantEnd = 0
	s.plantResolved = true
end

local function cancelTransients(s: State)
	s.burstUntil = 0
	s.jabUntil = 0
	s.sideStepUntil = 0
	s.lookAheadUntil = 0
	clearPlant(s)
end

local function enterAir(s: State)
	setMode(s, "Air")
	s.airStart = s.now
	s.takeoffSpeed = s.vel.Magnitude
	s.jabUntil = 0
	s.sideStepUntil = 0
	s.lookAheadUntil = 0
	clearPlant(s)
	s.groundLostAt = nil
end

local function enterRecover(s: State, duration: number)
	setMode(s, "Recover")
	s.recoverUntil = s.now + duration
	s.popStart = s.now
end

local function velDirOr(s: State, fallback: Vector3): Vector3
	local speed = s.vel.Magnitude
	if speed > 1e-3 then
		return s.vel / speed
	end
	return fallback
end

local function facingOr(env: Env): Vector3
	if env.facing then
		local f = VecMath.flatUnit(env.facing)
		if f.Magnitude > 0.5 then
			return f
		end
	end
	return FORWARD
end

-- Throw frame: forward from the aim yaw (falls back to facing), right = forward x up.
local function aimBasis(env: Env): (Vector3, Vector3)
	local fwd = if env.aimYaw ~= nil then VecMath.fromYaw(env.aimYaw) else facingOr(env)
	return fwd, Vector3.new(-fwd.Z, 0, fwd.X)
end

local function isGrounded(s: State): boolean
	return s.mode == "Ground" or s.mode == "Landing"
end

local function topSpeed(s: State, sprint: boolean): number
	if not sprint then
		return Config.JogSpeed
	end
	if s.exertion >= Config.ExhaustedBelow then
		return Config.SprintSpeed
	end
	local t = s.exertion / Config.ExhaustedBelow
	return Config.ExhaustedSprintSpeed + (Config.SprintSpeed - Config.ExhaustedSprintSpeed) * t
end

local function inPlantWindow(s: State): boolean
	if s.plantAt <= 0 then
		return false
	end
	local since = s.now - s.plantAt
	return since >= MC.WindowOpen and since <= MC.WindowClose
end

local function plantTooEarly(s: State): boolean
	if s.plantAt <= 0 then
		return false
	end
	local since = s.now - s.plantAt
	return since >= 0 and since < MC.WindowOpen
end

local function plantQuality(s: State): string
	return if (s.now - s.plantAt) <= MC.PerfectUntil and not s.plantGassed then Q.Perfect else Q.Clean
end

---------------------------------------------------------------------------
-- running line (what Snap Cuts and Plants are judged against)
---------------------------------------------------------------------------

-- Commits to a new line (after a technique sets a direction).
local function setLine(s: State, dir: Vector3, speed: number)
	s.committed = true
	s.commitDir = dir
	s.commitSince = s.now
	s.lineSpeed = speed
	s.lineResetAt = -math.huge
end

-- The line broke (turn or slow-down). Remember the established line, but only
-- on the first break of a turn: a pre-steer breaks it several times.
local function breakLine(s: State)
	if s.committed and s.now - s.lineResetAt > Config.LineMemory then
		s.prevLineDir = s.commitDir
		s.prevLineSince = s.commitSince
		s.prevLineSpeed = s.lineSpeed
		s.lineResetAt = s.now
	end
end

local function trackLine(s: State, dt: number)
	local speed = s.vel.Magnitude
	if speed > Config.CommitMinSpeed then
		local d = s.vel / speed
		if not s.committed or s.commitDir:Dot(d) < math.cos(math.rad(Config.CommitAngle)) then
			breakLine(s)
			s.committed = true
			s.commitDir = d
			s.commitSince = s.now
			s.lineSpeed = speed
		else
			s.lineSpeed = math.max(speed, s.lineSpeed - Config.LineSpeedDecay * dt)
		end
	else
		breakLine(s)
		s.committed = false
		s.commitSince = s.now
	end
end

-- Returns the line direction, when it was established, and the speed to grade
-- against (never below the current speed).
local function runningLine(s: State, env: Env): (Vector3, number, number)
	local speed = s.vel.Magnitude
	if s.now - s.lineResetAt <= Config.LineMemory then
		return s.prevLineDir, s.prevLineSince, math.max(speed, s.prevLineSpeed)
	end
	if s.committed then
		return s.commitDir, s.commitSince, math.max(speed, s.lineSpeed)
	end
	return velDirOr(s, facingOr(env)), s.now, speed
end

---------------------------------------------------------------------------
-- steering models
---------------------------------------------------------------------------

-- Ground steering: acceleration split into along-velocity (accelerate/brake)
-- and perpendicular (turning) components with separate limits. Sideways
-- acceleration falls from LateralAccelLow at jog to LateralAccel at sprint, so
-- jogging is nimble and full sprint is a commitment (turn radius ~6 studs)
-- that sharp changes of direction need a technique to beat.
function MovementSim.steerGround(v: Vector3, wish: Vector3, top: number, dt: number, lateralMult: number): Vector3
	local wishMag = math.min(wish.Magnitude, 1)
	local target = if wishMag > 0.05 then VecMath.flatUnit(wish) * (top * wishMag) else Vector3.zero
	local speed = v.Magnitude
	if speed < Config.RestSpeed then
		return VecMath.moveToward(v, target, Config.AccelFromRest * dt * math.max(lateralMult, 0.5))
	end
	local fwd = v / speed
	local tPar = target:Dot(fwd)
	local tPerp = target - fwd * tPar
	local newPar: number
	if tPar > speed then
		newPar = math.min(tPar, speed + Config.Accel * dt * math.max(lateralMult, 0.5))
	else
		local decel = if wishMag <= 0.05 then Config.Coast else Config.Brake
		if tPar >= 0 and speed > top + 0.5 and tPar >= top - 0.5 then
			decel = Config.OverspeedDecay
		end
		newPar = math.max(tPar, speed - decel * dt)
	end
	local k = math.clamp((speed - Config.JogSpeed) / (Config.SprintSpeed - Config.JogSpeed), 0, 1)
	local lateral = Config.LateralAccelLow + (Config.LateralAccel - Config.LateralAccelLow) * k
	local perpMag = tPerp.Magnitude
	local maxPerp = lateral * lateralMult * dt
	local newPerp = if perpMag > maxPerp then tPerp * (maxPerp / perpMag) else tPerp
	return fwd * newPar + newPerp
end

local function steerAir(s: State, wish: Vector3, dt: number): Vector3
	local wishMag = math.min(wish.Magnitude, 1)
	if wishMag <= 0.05 then
		return s.vel
	end
	local base = math.max(s.takeoffSpeed, Config.AirMinControlSpeed)
	local limit = base + Config.AirGainAllowance
	local target = VecMath.flatUnit(wish) * (base * wishMag)
	local nv = VecMath.moveToward(s.vel, target, Config.AirAccel * dt)
	local ceiling = math.max(limit, s.vel.Magnitude)
	return VecMath.clampMagnitude(nv, ceiling)
end

-- Mark shuffle: tight, no turn radius (velocity moves straight to the target).
local function steerShuffle(v: Vector3, wish: Vector3, dt: number): Vector3
	local wishMag = math.min(wish.Magnitude, 1)
	local target = if wishMag > 0.05 then VecMath.flatUnit(wish) * (MK.ShuffleSpeed * wishMag) else Vector3.zero
	local dv = target - v
	local rate = if dv:Dot(v) < 0 then MK.Brake else MK.Accel
	return VecMath.moveToward(v, target, rate * dt)
end

---------------------------------------------------------------------------
-- holding the disc: pivot foot + step
---------------------------------------------------------------------------

local function plantPivot(s: State)
	s.pivot = s.pos
	s.pivotAdopted = false
	s.holdPhase = "Pivot"
	s.step = Vector3.zero
	s.stepLenVel = 0
	s.vel = Vector3.zero
	s.pendingPivot = true
	s.pendingPivotPos = s.pos
end

-- Advances the step vector toward its target: length on a critically damped
-- spring, direction rotating at a capped rate through the front arc (through
-- the back only while the input points backward).
local function updateStep(s: State, input: Input, env: Env, dt: number)
	local now = s.now
	local R = HD.StepRadius
	local fwd, right = aimBasis(env)
	local fast = now < s.swingUntil or now < s.fakeUntil + HD.FakeStepBack

	local m = VecMath.flat(input.move)
	local mag = m.Magnitude
	if mag > 1 then
		m /= mag
		mag = 1
	end
	local hasDir = mag > 0.2
	local mDir = if hasDir then m / mag else Vector3.zero

	-- A swing's end position holds until a NEW direction is pressed (keeping
	-- the key you already held does not pull you back).
	if s.restActive then
		if hasDir and (s.restInputMag <= 0.2 or VecMath.flatAngle(s.restInputDir, mDir) > 30) then
			s.restActive = false
		elseif not hasDir then
			s.restInputMag = 0
		end
	end

	local tx, ty = 0, 0
	if s.restActive then
		tx, ty = s.restX, s.restY
	elseif hasDir then
		tx, ty = m:Dot(right) * R, m:Dot(fwd) * R
	end
	if now < s.fakeUntil then
		-- the fake lunges the free foot further toward its side
		tx = math.clamp(tx + s.fakeSide * HD.FakeStep * R, -R, R)
	end
	ty = math.clamp(ty, -HD.BackMax * R, HD.ForwardMax * R)

	local cx, cy = s.step:Dot(right), s.step:Dot(fwd)
	local len = math.sqrt(cx * cx + cy * cy)
	local lenT = math.sqrt(tx * tx + ty * ty)

	-- length: exact critically damped spring step (stable for any dt)
	local omega = if fast then HD.SwingSpring else HD.StepSpring
	local x0 = len - lenT
	local v0 = s.stepLenVel
	local e = math.exp(-omega * dt)
	local newLen = lenT + (x0 + (v0 + omega * x0) * dt) * e
	s.stepLenVel = (v0 - omega * (v0 + omega * x0) * dt) * e
	if newLen <= 0 then
		newLen = 0
		s.stepLenVel = 0
	elseif newLen > R then
		newLen = R
		s.stepLenVel = 0
	end

	-- direction: angle from the aim forward, positive to the right
	local phi = if len > 1e-3 then math.atan2(cx, cy) else math.atan2(tx, ty)
	if lenT > 1e-3 then
		local phiT = math.atan2(tx, ty)
		if len < 0.05 * R then
			phi = phiT
		else
			local diff = phiT - phi -- unwrapped: never crosses straight back
			if m:Dot(fwd) < -0.2 then
				diff = (diff + math.pi) % (2 * math.pi) - math.pi
			end
			local maxTurn = math.rad(if fast then HD.SwingAngular else HD.StepAngular) * dt
			phi += math.clamp(diff, -maxTurn, maxTurn)
		end
	end
	local nx = newLen * math.sin(phi)
	local ny = math.clamp(newLen * math.cos(phi), -HD.BackMax * R, HD.ForwardMax * R)
	s.step = right * nx + fwd * ny
end

local function updateHolding(s: State, input: Input, env: Env, dt: number)
	if s.holdPhase == "Air" then
		s.holdPhase = "Decel"
		s.holdStart = s.now
	end
	if s.holdPhase == "Decel" then
		local speed = s.vel.Magnitude
		local newSpeed = math.max(0, speed - HD.DecelRate * dt)
		s.vel = if speed > 1e-3 then s.vel * (newSpeed / speed) else Vector3.zero
		if newSpeed < HD.PlantSpeed or s.now - s.holdStart >= HD.DecelMaxTime then
			plantPivot(s)
		end
		return
	end
	if s.holdPhase ~= "Pivot" then
		return
	end
	local p = s.pivot
	-- No pivot (cleared) or the body is far away from it (teleported without a
	-- new UBPivot): plant a fresh one where we stand.
	if p == nil then
		plantPivot(s)
	elseif VecMath.flat(s.pos - p).Magnitude > HD.StepRadius * HD.BodyShare + 4 then
		if s.pivotAdopted then
			s.stalePivot = p
		end
		plantPivot(s)
	end
	updateStep(s, input, env, dt)
	local target = (s.pivot :: Vector3) + s.step * HD.BodyShare
	local d = VecMath.flat(target - s.pos)
	local dist = d.Magnitude
	if dist < 1e-3 then
		s.vel = Vector3.zero
	else
		local sp = math.min(dist * HD.DriveGain, HD.DriveMax, dist / math.max(dt, 1e-3))
		s.vel = d * (sp / dist)
	end
end

---------------------------------------------------------------------------
-- landing
---------------------------------------------------------------------------

local function landingText(offset: number): string
	return string.format(
		"PRECISION LANDING  %s%d ms",
		if offset >= 0 then "-" else "+",
		math.floor(math.abs(offset) * 1000 + 0.5)
	)
end

local function land(s: State)
	local now = s.now
	local fromDive = s.mode == "Dive"
	s.airRedirectUsed = false
	s.airDiveUsed = false
	s.aerialReachUsed = false
	s.rebounds = 0
	s.lastWall = nil
	s.landedAt = now
	s.landedFromDive = fromDive
	s.landingVel = s.vel
	s.groundLostAt = nil

	if s.holding and s.holdHopped then
		feedback(s, "HopLanded", nil, "TRAVEL — RELEASE BEFORE YOU LAND")
	end

	local armed = s.precisionArmedAt
	s.precisionArmedAt = nil
	if armed ~= nil then
		local offset = now - armed
		if offset <= PL.CleanWindow + 1e-6 then
			local q = if offset <= PL.PerfectWindow + 1e-6 then Q.Perfect else Q.Clean
			if fromDive then
				s.vel = s.vel * (RO.Retention :: any)[q]
				enterRecover(s, RO.RecoverTime)
				emit(s, "PrecisionLanding", q, velDirOr(s, s.diveDir), "RollOut")
			else
				s.vel = s.vel * (PL.Retention :: any)[q]
				setMode(s, "Ground")
				emit(s, "PrecisionLanding", q, velDirOr(s, FORWARD), nil)
			end
			feedback(s, "LandingOffset", offset, landingText(offset))
			return
		elseif offset <= PL.ArmWindow + 0.1 and not fromDive then
			-- armed early: an unlabelled soft landing (no steering penalty)
			s.lateLandingUntil = 0
			s.vel = s.vel * PL.Retention.Soft
			setMode(s, "Ground")
			feedback(s, "LandingOffset", offset, "SOFT LANDING — PRESS CLOSER TO TOUCHDOWN")
			return
		end
	end

	s.lateLandingUntil = now + PL.LateWindow
	if fromDive then
		setMode(s, "DiveSlide")
	else
		setMode(s, "Landing")
		s.landingUntil = now + Config.LandingRecovery
		s.vel = s.vel * Config.LandingRetention
	end
end

---------------------------------------------------------------------------
-- techniques
---------------------------------------------------------------------------

local function pressSnapCut(
	s: State,
	dir: Vector3,
	angle: number,
	since: number,
	gradeSpeed: number,
	sold: boolean
): (boolean, string?)
	local now = s.now
	local sinceCut = now - s.lastCutAt
	if sinceCut < SC.MinInterval then
		return defer(s, "Cut", 0, "Cooldown")
	end
	local q: string
	if isGassed(s, SC.Cost) then
		q = Q.Gassed
	elseif sold then
		q = Q.Perfect
	elseif sinceCut < SC.SpamWindow then
		q = Q.Sloppy
	else
		local commit = now - since
		if commit >= SC.CommitPerfect and gradeSpeed >= Config.SprintSpeed * SC.PerfectSpeedFraction then
			q = Q.Perfect
		elseif commit >= SC.CommitClean then
			q = Q.Clean
		else
			q = Q.Sloppy
		end
	end
	local over = math.clamp((angle - 45) / (SC.MaxAngle - 45), 0, 1)
	local retention = (SC.Retention :: any)[q] * (1 - SC.AnglePenalty * over)
	local newSpeed = gradeSpeed * retention
	if q == Q.Perfect then
		newSpeed = math.min(newSpeed + SC.PerfectBoost, math.max(Config.SprintSpeed, gradeSpeed))
	end
	if q ~= Q.Gassed then
		-- a cut is never worse than plain steering
		newSpeed =
			math.max(newSpeed, math.min(Config.SprintSpeed * SC.ExitFloor, math.max(gradeSpeed, Config.JogSpeed)))
	end
	if sold then
		newSpeed = math.max(newSpeed, Config.SprintSpeed * SC.SoldMinSpeedFraction)
	end
	spend(s, SC.Cost)
	s.vel = dir * newSpeed
	s.lastCutAt = now
	setLine(s, dir, newSpeed)
	s.soldUntil = 0
	s.burstUntil = 0
	s.jabUntil = 0
	s.sideStepUntil = 0
	emit(s, "SnapCut", q, dir, if sold then "Sold" else nil)
	return true, nil
end

local function pressPlant(s: State, lineDir: Vector3, gradeSpeed: number): (boolean, string?)
	local left = cooldownLeft(s, "MomentumCancel")
	if left > 0 then
		if left <= BUFFER then
			return defer(s, "Cut", 0, "Cooldown", cooldownText("MomentumCancel", left), left)
		end
		return refuse(s, "Cooldown", cooldownText("MomentumCancel", left), left)
	end
	local q: string
	if isGassed(s, MC.Cost) then
		q = Q.Gassed
	elseif gradeSpeed >= Config.JogSpeed then
		q = Q.Clean
	else
		q = Q.Sloppy
	end
	spend(s, MC.Cost)
	setCooldown(s, "MomentumCancel")
	s.burstUntil = 0
	s.jabUntil = 0
	s.sideStepUntil = 0
	s.plantAt = s.now
	s.plantEnd = s.now + MC.PlantTime
	s.plantGassed = q == Q.Gassed
	s.plantDecel = if q == Q.Gassed then MC.BrakeDecel * 0.5 else MC.BrakeDecel
	s.plantResolved = false
	emit(s, "MomentumCancel", q, lineDir, nil)
	return true, nil
end

-- Fake Commit: a jab along the line (sells a cut) or, when slow, a quick side
-- step toward the input. Either opens the "sold" window for a Perfect cut away.
local function pressFakeCommit(s: State, dir: Vector3, lineDir: Vector3, sideStep: boolean): (boolean, string?)
	local left = cooldownLeft(s, "FakeCommit")
	if left > 0 then
		if left <= BUFFER then
			return defer(s, "Cut", 0, "Cooldown", cooldownText("FakeCommit", left), left)
		end
		return refuse(s, "Cooldown", cooldownText("FakeCommit", left), left)
	end
	local q = if isGassed(s, FC.Cost) then Q.Gassed else Q.Clean
	spend(s, FC.Cost)
	setCooldown(s, "FakeCommit")
	local info: string? = nil
	local busy: number
	if sideStep then
		s.sideStepDir = dir
		s.sideStepSpeed = FC.SideStepSpeed * (if q == Q.Gassed then 0.7 else 1)
		s.sideStepUntil = s.now + FC.SideStepTime
		s.vel = dir * s.sideStepSpeed
		s.soldDir = dir
		busy = FC.SideStepTime
		info = "SideStep"
	else
		s.vel = s.vel * FC.JabSlow
		s.soldDir = lineDir
		s.jabUntil = s.now + FC.JabTime
		busy = FC.JabTime
	end
	s.soldUntil = s.now + busy + FC.SoldWindow
	emit(s, "FakeCommit", q, s.soldDir, info)
	return true, nil
end

-- Judges a directional Cut against the running line: Sold cut, Snap Cut, or
-- Plant when it points backward.
local function cutAgainstLine(
	s: State,
	dir: Vector3,
	angle: number,
	lineDir: Vector3,
	since: number,
	gradeSpeed: number
): (boolean, string?)
	if s.now < s.soldUntil and VecMath.flatAngle(s.soldDir, dir) >= FC.SoldMinAngle then
		return pressSnapCut(s, dir, angle, since, math.max(gradeSpeed, SC.MinSpeed), true)
	end
	if angle <= SC.MaxAngle then
		return pressSnapCut(s, dir, angle, since, gradeSpeed, false)
	end
	if gradeSpeed >= MC.MinSpeed then
		return pressPlant(s, lineDir, gradeSpeed)
	end
	return pressSnapCut(s, dir, angle, since, gradeSpeed, false)
end

local function restartFromPlant(s: State, dir: Vector3): (boolean, string?)
	local q = plantQuality(s)
	local out = Config.SprintSpeed * (MC.RestartRetention :: any)[q]
	s.vel = dir * math.max(out, s.vel:Dot(dir))
	clearPlant(s)
	s.lastCutAt = s.now
	setLine(s, dir, s.vel.Magnitude)
	emit(s, "SnapCut", q, dir, "Restart")
	return true, nil
end

local function doBurst(s: State, dir: Vector3, free: boolean, forcedQuality: string?): (boolean, string?)
	local now = s.now
	local speed = s.vel.Magnitude
	local q: string
	if forcedQuality then
		q = forcedQuality
	elseif isGassed(s, BS.Cost) then
		q = Q.Gassed
	elseif s.lastKeyTech ~= nil and BURST_CHAIN[s.lastKeyTech :: string] and now - s.lastKeyAt <= BS.CutChainWindow then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	local base = math.max(speed, Config.SprintSpeed)
	local bs: number
	if q == Q.Gassed then
		bs = math.min(base * BS.GassedMult, BS.MaxSpeed)
	else
		bs = math.clamp(base * BS.SpeedMult, BS.MinSpeed, BS.MaxSpeed)
	end
	if not free then
		spend(s, BS.Cost)
	end
	setCooldown(s, "BurstStep")
	s.burstDir = dir
	s.burstSpeed = bs
	s.burstUntil = now + BS.Duration
	s.vel = dir * bs
	clearPlant(s)
	s.jabUntil = 0
	s.sideStepUntil = 0
	setLine(s, dir, bs)
	emit(s, "BurstStep", q, dir, if free then "Explosive" else nil)
	return true, nil
end

-- Recovery Chain: Jump / Cut / Burst during the dive recovery.
local function tryPop(s: State, action: Action, dir: Vector3, hasDir: boolean, env: Env): (boolean, string?)
	local now = s.now
	if s.mode == "DiveSlide" and now - s.landedAt < RC.PopFrom then
		if RC.PopFrom - (now - s.landedAt) <= BUFFER then
			return defer(s, action, 0, "Context", "TOO EARLY")
		end
		return refuse(s, "Context", "TOO EARLY")
	end
	local q = if s.mode == "Recover" and now - s.popStart <= RC.PopPerfect then Q.Perfect else Q.Clean
	local d = if hasDir then dir else velDirOr(s, facingOr(env))
	local out = math.max(Config.SprintSpeed * (RC.Retention :: any)[q], s.vel.Magnitude)
	setMode(s, "Ground")
	s.recoverUntil = 0
	emit(s, "RecoveryChain", q, d, action)
	if action == "Jump" then
		s.vel = if hasDir then d * out else Vector3.zero
		enterAir(s)
		queueJump(s, Config.JumpVelocity * RC.PopJumpFraction)
	elseif action == "Cut" then
		s.vel = d * out
		s.lastCutAt = now
		setLine(s, d, out)
	elseif action == "Burst" then
		s.vel = d * out
		if cooldownLeft(s, "BurstStep") <= 0 then
			doBurst(s, d, false, nil)
		end
	end
	return true, nil
end

-- One hop per possession: straight up, step frozen.
local function pressHop(s: State): (boolean, string?)
	if s.holdHopped then
		return refuse(s, "Used", "ONE HOP PER POSSESSION")
	end
	if not isGrounded(s) then
		return refuse(s, "Context")
	end
	if s.holdPhase ~= "Pivot" then
		plantPivot(s)
	end
	s.holdHopped = true
	s.vel = Vector3.zero
	enterAir(s)
	queueJump(s, HD.HopVertical)
	s.impulse = true
	return true, nil
end

local function pressJump(s: State, dir: Vector3, hasDir: boolean, env: Env): (boolean, string?)
	if s.holding then
		return pressHop(s)
	end
	if s.mode == "Recover" or s.mode == "DiveSlide" then
		return tryPop(s, "Jump", dir, hasDir, env)
	end
	if isGrounded(s) or s.mode == "Slide" then
		if plantTooEarly(s) then
			return defer(s, "Jump", 0, "Context")
		end
		local fromSlide = s.mode == "Slide"
		local info: string? = nil
		local q = Q.Clean
		if inPlantWindow(s) then
			-- jumping out of a plant keeps the restart speed
			info = "PlantJump"
			q = plantQuality(s)
			if hasDir then
				s.vel = dir * math.max(Config.SprintSpeed * (MC.RestartRetention :: any)[q], s.vel:Dot(dir))
			end
		elseif fromSlide then
			info = "SlideHop"
		end
		local speed = s.vel.Magnitude
		local vy = Config.JumpVelocity + Config.JumpSpeedBonus * math.clamp(speed / Config.SprintSpeed, 0, 1)
		enterAir(s)
		queueJump(s, vy)
		emit(s, "Jump", q, velDirOr(s, facingOr(env)), info)
		return true, nil
	end
	if s.mode == "Air" or s.mode == "Dive" then
		local wall = env.wallNormal
		if wall then
			local n = VecMath.flatUnit(wall)
			if n.Magnitude < 0.5 then
				return refuse(s, "Context")
			end
			if s.rebounds >= WR.MaxPerAir then
				return refuse(s, "Used", "TWO REBOUNDS PER JUMP")
			end
			if env.wallId ~= nil and env.wallId == s.lastWall then
				return refuse(s, "Used", "FIND ANOTHER WALL")
			end
			local v = s.vel
			local into = v:Dot(n)
			local reflected = if into < 0 then VecMath.reflect(v, n) else v
			local q: string
			if isGassed(s, WR.Cost) then
				q = Q.Gassed
			elseif (env.wallDistance or math.huge) <= WR.PerfectDistance then
				q = Q.Perfect
			else
				q = Q.Clean
			end
			local retention = if q == Q.Gassed then WR.Retention * 0.7 else WR.Retention
			local nv = VecMath.clampMagnitude((reflected + n * WR.PushOff) * retention, Config.HardCap)
			spend(s, WR.Cost)
			s.vel = nv
			s.rebounds += 1
			s.lastWall = env.wallId
			s.airRedirectUsed = false
			enterAir(s)
			queueJump(s, WR.Vertical)
			emit(s, "WallRebound", q, velDirOr(s, n), nil)
			return true, nil
		end
		-- jump pressed just before touchdown: jump on landing
		local ttl = env.timeToLand
		if s.mode == "Air" and ttl ~= nil and ttl <= BUFFER then
			return defer(s, "Jump", 0, "Context")
		end
		return refuse(s, "Context")
	end
	return refuse(s, "Context")
end

local function pressAirRedirect(s: State, dir: Vector3, hasDir: boolean, env: Env): (boolean, string?)
	if s.airRedirectUsed then
		return refuse(s, "Used", "ONE PER JUMP")
	end
	if not hasDir then
		return refuse(s, "Context", "STEER TO REDIRECT")
	end
	local speed = s.vel.Magnitude
	if speed >= AR.MinSpeed and VecMath.flatAngle(s.vel / speed, dir) < AR.MinAngle then
		-- already going that way: nothing to redirect, keep it for later
		return refuse(s, "Context", "STEER TO REDIRECT")
	end
	local vy = env.actualVel.Y
	local q: string
	if isGassed(s, AR.Cost) then
		q = Q.Gassed
	elseif math.abs(vy) < AR.ApexWindow then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	local newVel: Vector3
	if speed < AR.MinSpeed then
		newVel = dir * AR.StillSpeed
	else
		local nd = VecMath.rotateToward(s.vel / speed, dir, AR.MaxAngle)
		newVel = nd * (speed * (AR.Retention :: any)[q])
	end
	spend(s, AR.Cost)
	s.airRedirectUsed = true
	s.vel = newVel
	if s.mode == "Dive" then
		s.diveDir = velDirOr(s, s.diveDir)
	end
	if vy < AR.MinVertical then
		queueVertical(s, AR.MinVertical)
	end
	emit(s, "AirRedirect", q, velDirOr(s, dir), nil)
	return true, nil
end

local function pressSlideCut(s: State, dir: Vector3, hasDir: boolean): (boolean, string?)
	if not hasDir then
		return refuse(s, "Context", "HOLD A DIRECTION")
	end
	local t = s.now - s.modeStart
	if t < SLC.MinSlideTime then
		return defer(s, "Cut", 0, "Context")
	end
	local speed = s.vel.Magnitude
	local velDir = velDirOr(s, dir)
	if VecMath.flatAngle(velDir, dir) > SLC.MaxAngle then
		return refuse(s, "Context", "TOO SHARP")
	end
	local q: string
	if isGassed(s, SLC.Cost) then
		q = Q.Gassed
	elseif t >= SLC.PerfectFrom and t <= SLC.PerfectTo then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	spend(s, SLC.Cost)
	local newSpeed = speed * (SLC.Retention :: any)[q]
	s.vel = dir * newSpeed
	setMode(s, "Ground")
	s.lastCutAt = s.now
	setLine(s, dir, newSpeed)
	emit(s, "SlideCut", q, dir, nil)
	return true, nil
end

local function pressCut(s: State, dir: Vector3, hasDir: boolean, env: Env): (boolean, string?)
	if s.holding then
		return refuse(s, "Context")
	end
	local now = s.now
	if s.mode == "Air" or s.mode == "Dive" then
		return pressAirRedirect(s, dir, hasDir, env)
	end
	if s.mode == "Slide" then
		return pressSlideCut(s, dir, hasDir)
	end
	if s.mode == "Recover" or s.mode == "DiveSlide" then
		return tryPop(s, "Cut", dir, hasDir, env)
	end
	if not isGrounded(s) then
		return refuse(s, "Context")
	end

	-- Restart out of a Momentum Cancel plant.
	if s.plantAt > 0 and now - s.plantAt <= MC.WindowClose then
		if plantTooEarly(s) then
			return defer(s, "Cut", 0, "Context")
		end
		if not hasDir then
			return refuse(s, "Context", "HOLD A DIRECTION")
		end
		return restartFromPlant(s, dir)
	end

	-- A look-ahead already pending is this same intent.
	if s.lookAheadUntil > 0 then
		return true, nil
	end

	local lineDir, since, gradeSpeed = runningLine(s, env)
	if not hasDir then
		if gradeSpeed >= MC.MinSpeed then
			return pressPlant(s, lineDir, gradeSpeed)
		end
		return refuse(s, "Speed", "NEED SPEED", MC.MinSpeed)
	end
	local angle = VecMath.flatAngle(lineDir, dir)
	-- A cut out of a Fake Commit's sold window is always allowed.
	if now < s.soldUntil and VecMath.flatAngle(s.soldDir, dir) >= FC.SoldMinAngle then
		return pressSnapCut(s, dir, angle, since, math.max(gradeSpeed, SC.MinSpeed), true)
	end
	if gradeSpeed < SC.MinSpeed then
		return pressFakeCommit(s, dir, lineDir, true)
	end
	if angle < FC.MaxAngle then
		-- Along the line: wait a moment for the steer that makes it a cut.
		s.lookAheadUntil = now + FC.LookAhead
		s.lookLine = lineDir
		s.lookSince = since
		s.lookSpeed = gradeSpeed
		return true, nil
	end
	return cutAgainstLine(s, dir, angle, lineDir, since, gradeSpeed)
end

local function pressBurst(s: State, dir: Vector3, hasDir: boolean, env: Env): (boolean, string?)
	if s.holding then
		return refuse(s, "Context")
	end
	if s.mode == "Recover" or s.mode == "DiveSlide" then
		return tryPop(s, "Burst", dir, hasDir, env)
	end
	if s.mode == "Air" then
		local ttl = env.timeToLand
		if ttl ~= nil and ttl <= BUFFER then
			return defer(s, "Burst", 0, "Context", "LAND FIRST")
		end
		return refuse(s, "Context", "LAND FIRST")
	end
	if not isGrounded(s) and s.mode ~= "Slide" then
		return refuse(s, "Context")
	end
	if plantTooEarly(s) then
		return defer(s, "Burst", 0, "Context")
	end
	local left = cooldownLeft(s, "BurstStep")
	if left > 0 then
		if left <= BUFFER then
			return defer(s, "Burst", 0, "Cooldown", cooldownText("BurstStep", left), left)
		end
		return refuse(s, "Cooldown", cooldownText("BurstStep", left), left)
	end
	local d = if hasDir then dir else velDirOr(s, facingOr(env))
	if s.mode == "Slide" then
		setMode(s, "Ground")
	end
	if inPlantWindow(s) then
		return doBurst(s, d, true, plantQuality(s))
	end
	return doBurst(s, d, false, nil)
end

local function armPrecision(s: State, env: Env): (boolean, string?)
	if s.precisionArmedAt ~= nil then
		return refuse(s, "Used", "LANDING ARMED")
	end
	local ttl = env.timeToLand
	if ttl ~= nil and ttl <= PL.ArmWindow then
		s.precisionArmedAt = s.now
		return true, nil
	end
	if ttl ~= nil and ttl <= PL.ArmWindow + BUFFER then
		return defer(s, "Slide", 0, "Context", "TOO EARLY")
	end
	return refuse(s, "Context", "TOO EARLY")
end

local function pressSlide(s: State, env: Env): (boolean, string?)
	if s.holding then
		return refuse(s, "Context")
	end
	local now = s.now
	if s.mode == "Air" or s.mode == "Dive" then
		return armPrecision(s, env)
	end
	-- Late Precision Landing (pressed just after touchdown).
	if now < s.lateLandingUntil then
		if isGrounded(s) and not s.landedFromDive then
			s.vel = s.landingVel * PL.Retention.Clean
			setMode(s, "Ground")
			s.lateLandingUntil = 0
			emit(s, "PrecisionLanding", Q.Clean, velDirOr(s, FORWARD), "Late")
			feedback(s, "LandingOffset", -(now - s.landedAt), landingText(-(now - s.landedAt)))
			return true, nil
		elseif s.mode == "DiveSlide" and s.landedFromDive then
			s.vel = s.landingVel * RO.Retention.Clean
			s.lateLandingUntil = 0
			enterRecover(s, RO.RecoverTime)
			emit(s, "PrecisionLanding", Q.Clean, velDirOr(s, s.diveDir), "RollOut")
			feedback(s, "LandingOffset", -(now - s.landedAt), landingText(-(now - s.landedAt)))
			return true, nil
		end
	end
	if not isGrounded(s) then
		return refuse(s, "Context")
	end
	local left = cooldownLeft(s, "Slide")
	if left > 0 then
		if left <= BUFFER then
			return defer(s, "Slide", 0, "Cooldown", cooldownText("Slide", left), left)
		end
		return refuse(s, "Cooldown", cooldownText("Slide", left), left)
	end
	local speed = s.vel.Magnitude
	if speed < SL.MinSpeed then
		return refuse(s, "Speed", "NEED SPEED", SL.MinSpeed)
	end
	local q = if isGassed(s, SL.Cost) then Q.Gassed else Q.Clean
	local newSpeed = speed
	if q ~= Q.Gassed and speed < SL.BoostCeiling then
		newSpeed = math.min(speed + SL.Boost, SL.BoostCeiling)
	end
	spend(s, SL.Cost)
	setCooldown(s, "Slide")
	s.vel = (s.vel / speed) * newSpeed
	cancelTransients(s)
	setMode(s, "Slide")
	emit(s, "Slide", q, s.vel / newSpeed, nil)
	return true, nil
end

local function pressDive(s: State, dir: Vector3, hasDir: boolean, env: Env): (boolean, string?)
	if s.holding then
		return refuse(s, "Context")
	end
	local now = s.now
	if s.mode == "Recover" then
		if s.recoverUntil - now <= BUFFER then
			return defer(s, "Dive", 0, "Context", "GET UP FIRST")
		end
		return refuse(s, "Context", "GET UP FIRST")
	end
	if s.mode == "DiveSlide" then
		return refuse(s, "Context", "GET UP FIRST")
	end
	if s.mode == "Dive" or (s.mode == "Air" and s.airDiveUsed) then
		return refuse(s, "Used", "ONE PER JUMP")
	end
	local groundish = isGrounded(s) or s.mode == "Slide"
	local air = s.mode == "Air"
	if not groundish and not air then
		return refuse(s, "Context")
	end
	local left = cooldownLeft(s, "Dive")
	if left > 0 then
		if left <= BUFFER then
			return defer(s, "Dive", 0, "Cooldown", cooldownText("Dive", left), left)
		end
		return refuse(s, "Cooldown", cooldownText("Dive", left), left)
	end
	local speed = s.vel.Magnitude
	local d = if hasDir then dir else velDirOr(s, facingOr(env))
	local key = s.lastKeyTech
	local chained = key ~= nil and DIVE_CHAIN[key :: string] == true and now - s.lastKeyAt <= DV.ChainWindow
	local q: string
	if isGassed(s, DV.Cost) then
		q = Q.Gassed
	elseif chained then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	spend(s, DV.Cost)
	setCooldown(s, "Dive")
	if groundish then
		local hs: number
		if q == Q.Gassed then
			hs = math.clamp(speed, DV.GassedMin, DV.GassedMax)
		else
			hs = math.clamp(math.max(speed + DV.GroundBonus, DV.GroundMin), DV.GroundMin, DV.GroundMax)
		end
		s.vel = d * hs
		cancelTransients(s)
		setMode(s, "Dive")
		s.airStart = now
		s.groundLostAt = nil
		queueJump(s, DV.GroundVertical)
	else
		local nv = VecMath.clampMagnitude(s.vel + d * DV.AirBoost, math.max(DV.AirMax, speed))
		s.vel = nv
		s.airDiveUsed = true
		setMode(s, "Dive")
		queueVertical(s, math.min(env.actualVel.Y + DV.AirVertical, DV.MaxVertical))
	end
	s.takeoffSpeed = s.vel.Magnitude
	s.diveDir = velDirOr(s, d)
	emit(s, "Dive", q, s.diveDir, if air then "Air" else nil)
	return true, nil
end

-- Quick Swing while holding: the step swings through the front to the given
-- side (-1 screen-left, +1 screen-right, 0 = mirror of the current step).
local function doSwing(s: State, side: number, env: Env): (boolean, string?)
	if not s.holding then
		return refuse(s, "Context")
	end
	if not isGrounded(s) then
		local ttl = env.timeToLand
		if s.mode == "Air" and not s.holdHopped and ttl ~= nil and ttl <= BUFFER then
			return defer(s, "Swing", side, "Context")
		end
		return refuse(s, "Context")
	end
	local left = cooldownLeft(s, "PivotSwing")
	if left > 0 then
		if left <= BUFFER then
			return defer(s, "Swing", side, "Cooldown", cooldownText("PivotSwing", left), left)
		end
		return refuse(s, "Cooldown", cooldownText("PivotSwing", left), left)
	end
	if s.holdPhase ~= "Pivot" then
		plantPivot(s)
	end
	local now = s.now
	local fwd, right = aimBasis(env)
	if side == 0 then
		local lateral = s.step:Dot(right)
		side = if lateral > 0.1 then -1 elseif lateral < -0.1 then 1 else -s.lastSwingSide
	end
	side = if side < 0 then -1 else 1
	local q: string
	if isGassed(s, HD.SwingCost) then
		q = Q.Gassed
	elseif now - s.lastFakeAt <= HD.SwingSoldWindow then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	spend(s, HD.SwingCost)
	setCooldown(s, "PivotSwing")
	local R = HD.StepRadius
	s.swingUntil = now + HD.SwingTime
	s.fakeUntil = -math.huge
	s.lastSwingSide = side
	s.restActive = true
	s.restX = side * HD.SwingLateral * R
	s.restY = HD.SwingForward * R
	local held = VecMath.flat(s.lastMove)
	s.restInputMag = math.min(held.Magnitude, 1)
	s.restInputDir = VecMath.flatUnit(held)
	local dir = VecMath.flatUnit(right * s.restX + fwd * s.restY)
	emit(s, "PivotSwing", q, dir, if q == Q.Perfect then "Sold" else nil)
	return true, nil
end

local function runAction(s: State, action: string, input: Input, env: Env, side: number): (boolean, string?)
	if action == "Swing" then
		return doSwing(s, side, env)
	end
	local wishMag = input.move.Magnitude
	local hasDir = wishMag > 0.2
	local dir = if hasDir then VecMath.flatUnit(input.move) else Vector3.zero
	if action == "Jump" then
		return pressJump(s, dir, hasDir, env)
	elseif action == "Cut" then
		return pressCut(s, dir, hasDir, env)
	elseif action == "Burst" then
		return pressBurst(s, dir, hasDir, env)
	elseif action == "Slide" then
		return pressSlide(s, env)
	elseif action == "Dive" then
		return pressDive(s, dir, hasDir, env)
	end
	return false, "Context"
end

local function dispatch(s: State, action: string, input: Input, env: Env, side: number): (boolean, string?)
	if s.frozen or s.mode == "Frozen" then
		return false, "Context"
	end
	if s.marking and not s.holding then
		if action == "Slide" then
			-- C toggles the mark stance; the driver handles it.
			return false, "Context"
		end
		if action == "Cut" or action == "Dive" or action == "Burst" then
			local ok, reason = runAction(s, action, input, env, side)
			if ok then
				s.marking = false
			end
			return ok, reason
		end
	end
	return runAction(s, action, input, env, side)
end

-- Retries the buffered press; keeps it while it is still worth waiting for.
local function retryBuffer(s: State, input: Input, env: Env)
	local b = s.buffer
	if b == nil then
		return
	end
	s.buffer = nil
	s.retrying = true
	s.retryDeferred = false
	s.retryReason = nil
	s.retryText = nil
	s.retryValue = nil
	local ok = dispatch(s, b.action, input, env, b.side)
	s.retrying = false
	if ok or not s.retryDeferred then
		return -- fired, or a final refusal (which queued its own feedback)
	end
	if s.now < b.expires then
		s.buffer = b
	elseif s.retryText then
		feedback(s, s.retryReason or "Context", s.retryValue, s.retryText)
	end
end

-- Resolves a pending Cut look-ahead: a steer away from the line inside it
-- makes the press a Snap Cut (or a Plant if backward); otherwise a Fake Commit.
local function resolveLookAhead(s: State, input: Input)
	if s.lookAheadUntil <= 0 then
		return
	end
	if s.holding or s.frozen or not isGrounded(s) then
		s.lookAheadUntil = 0
		return
	end
	local m = input.move
	local hasDir = m.Magnitude > 0.2
	if hasDir then
		local dir = VecMath.flatUnit(m)
		local angle = VecMath.flatAngle(s.lookLine, dir)
		if angle >= FC.MaxAngle then
			s.lookAheadUntil = 0
			cutAgainstLine(s, dir, angle, s.lookLine, s.lookSince, s.lookSpeed)
			return
		end
	end
	if s.now >= s.lookAheadUntil then
		s.lookAheadUntil = 0
		local dir = if hasDir then VecMath.flatUnit(m) else s.lookLine
		pressFakeCommit(s, dir, s.lookLine, false)
	end
end

---------------------------------------------------------------------------
-- public API
---------------------------------------------------------------------------

-- Presses a movement action. Returns true when it fired or was buffered
-- (and will fire within InputBuffer if it becomes valid), else false + reason.
function MovementSim.press(s: State, action: Action, input: Input, env: Env): (boolean, string?)
	if s.frozen or s.mode == "Frozen" then
		return false, "Context"
	end
	local b = s.buffer
	if b and b.action == action then
		return true, nil
	end
	s.buffer = nil
	return dispatch(s, action, input, env, 0)
end

-- Quick Swing while holding. side: -1 screen-left, +1 screen-right,
-- 0 = mirror of the current step (gamepad). Same contract as press().
function MovementSim.swing(s: State, side: number, env: Env): (boolean, string?)
	if s.frozen or s.mode == "Frozen" then
		return false, "Context"
	end
	local b = s.buffer
	if b and b.action == "Swing" then
		return true, nil
	end
	s.buffer = nil
	return dispatch(s, "Swing", NO_INPUT, env, side)
end

-- The fake's lunge while holding: the free foot reaches 0.6R further toward
-- `side` (-1/+1, clamped to R) for FakeStepOut, then springs back. side 0 = no
-- lunge. Always starts the window in which a swing counts as Sold.
function MovementSim.fakeStep(s: State, side: number)
	if not s.holding then
		return
	end
	s.lastFakeAt = s.now
	if side ~= 0 and s.holdPhase == "Pivot" and isGrounded(s) then
		s.fakeSide = if side < 0 then -1 else 1
		s.fakeUntil = s.now + HD.FakeStepOut
	end
end

-- Mark shuffle overlay (ignored while holding).
function MovementSim.setMarking(s: State, on: boolean)
	s.marking = on and not s.holding
end

function MovementSim.isMarking(s: State): boolean
	return s.marking
end

-- Called by the catch controller when the player reaches while airborne.
function MovementSim.noteAerialReach(s: State, dir: Vector3): boolean
	if (s.mode == "Air" or s.mode == "Dive") and not s.aerialReachUsed then
		s.aerialReachUsed = true
		emit(s, "AerialReach", Q.Clean, VecMath.flatUnit(dir), nil)
		return true
	end
	return false
end

function MovementSim.setFrozen(s: State, frozen: boolean)
	s.frozen = frozen
	if frozen then
		s.vel = Vector3.zero
		cancelTransients(s)
		s.buffer = nil
		setMode(s, "Frozen")
	elseif s.mode == "Frozen" then
		setMode(s, "Ground")
	end
end

-- Starts (or ends) a possession. Starting begins the slow-down (or waits for
-- the landing when caught in the air); calling it again while already holding
-- changes nothing, so a predicted catch confirmed by the server is seamless.
function MovementSim.setHolding(s: State, holding: boolean, grounded: boolean)
	if holding then
		if s.holding then
			return
		end
		s.holding = true
		s.holdHopped = false
		s.holdStart = s.now
		s.holdPhase = if grounded and s.mode ~= "Air" and s.mode ~= "Dive" then "Decel" else "Air"
		s.pivot = nil
		s.pivotAdopted = false
		s.stalePivot = nil
		s.step = Vector3.zero
		s.stepLenVel = 0
		s.swingUntil = 0
		s.fakeUntil = -math.huge
		s.lastFakeAt = -math.huge
		s.restActive = false
		s.marking = false
		s.buffer = nil
		s.soldUntil = 0
		cancelTransients(s)
	else
		if not s.holding then
			return
		end
		s.holding = false
		s.holdPhase = "None"
		s.holdHopped = false
		s.pivot = nil
		s.pivotAdopted = false
		s.stalePivot = nil
		s.step = Vector3.zero
		s.stepLenVel = 0
		s.swingUntil = 0
		s.fakeUntil = -math.huge
		s.restActive = false
		s.buffer = nil
	end
end

-- Adopts the authoritative pivot foot (UBPivot). nil clears a previously
-- adopted pivot (the sim then plants its own where it stands); it never clears
-- the sim's own plant, so passing the attribute every frame is harmless.
function MovementSim.setPivot(s: State, p: Vector3?)
	if p == nil then
		if s.pivotAdopted then
			s.pivot = nil
			s.pivotAdopted = false
		end
		return
	end
	if s.stalePivot ~= nil and p == s.stalePivot then
		return -- the same far-away pivot we already abandoned
	end
	s.stalePivot = nil
	s.pivot = p
	s.pivotAdopted = true
	if s.holding and s.holdPhase ~= "Pivot" then
		s.holdPhase = "Pivot"
		s.step = Vector3.zero
		s.stepLenVel = 0
	end
end

-- The planted pivot foot P (nil before it is planted / when not holding).
function MovementSim.getPivot(s: State): Vector3?
	if s.holding then
		return s.pivot
	end
	return nil
end

-- Where the root is being driven while pivoting: P + BodyShare * step.
function MovementSim.rootTarget(s: State): Vector3?
	local p = s.pivot
	if s.holding and s.holdPhase == "Pivot" and p ~= nil then
		return p + s.step * HD.BodyShare
	end
	return nil
end

-- The mode to replicate for poses (character attribute MS): the sim mode, or
-- "Pivot" while the holder pivots on the ground, "Mark" while mark-shuffling.
function MovementSim.poseMode(s: State): string
	if s.mode == "Ground" or s.mode == "Landing" then
		if s.holding and s.holdPhase == "Pivot" then
			return "Pivot"
		end
		if s.marking then
			return "Mark"
		end
	end
	return s.mode
end

function MovementSim.isAirborne(s: State): boolean
	return s.mode == "Air" or s.mode == "Dive"
end

-- 0 = just used, 1 = ready.
function MovementSim.readiness(s: State, tech: string): number
	local cd = (Config.TechCooldowns :: any)[tech] or 0
	if cd <= 0 then
		return 1
	end
	local readyAt = s.ready[tech] or -math.huge
	return math.clamp(1 - (readyAt - s.now) / cd, 0, 1)
end

local function cutHint(s: State, input: Input, env: Env): string?
	local m = input.move
	local hasDir = m.Magnitude > 0.2
	local dir = if hasDir then VecMath.flatUnit(m) else Vector3.zero
	if s.plantAt > 0 and s.now - s.plantAt <= MC.WindowClose then
		return if hasDir then "RESTART" else nil
	end
	local lineDir, _, gradeSpeed = runningLine(s, env)
	if not hasDir then
		return if gradeSpeed >= MC.MinSpeed then "PLANT" else nil
	end
	if s.now < s.soldUntil and VecMath.flatAngle(s.soldDir, dir) >= FC.SoldMinAngle then
		return "SOLD CUT"
	end
	if gradeSpeed < SC.MinSpeed then
		return "SIDE STEP"
	end
	local angle = VecMath.flatAngle(lineDir, dir)
	if angle < FC.MaxAngle then
		return "FAKE COMMIT"
	end
	if angle > SC.MaxAngle and gradeSpeed >= MC.MinSpeed then
		return "PLANT"
	end
	return "SNAP CUT"
end

-- What each action would do right now, for the HUD context line, e.g.
-- { Cut = "SNAP CUT", Jump = "POP UP", Slide = "PRECISION LANDING" }.
-- Actions that would do nothing are left out. Pure: changes no state.
function MovementSim.contextHint(s: State, input: Input, env: Env): { [string]: string }
	local hint: { [string]: string } = {}
	if s.frozen or s.mode == "Frozen" then
		return hint
	end
	local mode = s.mode
	local ttl = env.timeToLand
	if s.holding then
		if isGrounded(s) then
			hint.Cut = "SWING LEFT"
			hint.Dive = "SWING RIGHT"
			if not s.holdHopped then
				hint.Jump = "HOP"
			end
		end
		return hint
	end
	if mode == "Air" or mode == "Dive" then
		if not s.airRedirectUsed then
			hint.Cut = "AIR REDIRECT"
		end
		if env.wallNormal and s.rebounds < WR.MaxPerAir and (env.wallId == nil or env.wallId ~= s.lastWall) then
			hint.Jump = "WALL REBOUND"
		end
		if ttl ~= nil and ttl <= PL.ArmWindow and s.precisionArmedAt == nil then
			hint.Slide = if mode == "Dive" then "ROLL OUT" else "PRECISION LANDING"
		end
		if mode == "Air" and not s.airDiveUsed then
			hint.Dive = "AIR LAYOUT"
		end
		return hint
	end
	if mode == "Slide" then
		hint.Cut = "SLIDE CUT"
		hint.Jump = "SLIDE HOP"
		hint.Dive = "LAYOUT"
		if cooldownLeft(s, "BurstStep") <= 0 then
			hint.Burst = "BURST"
		end
		return hint
	end
	if mode == "DiveSlide" or mode == "Recover" then
		hint.Jump = "POP UP"
		hint.Cut = "POP UP"
		hint.Burst = "POP UP"
		if mode == "DiveSlide" and s.now < s.lateLandingUntil then
			hint.Slide = "ROLL OUT"
		end
		return hint
	end
	-- Ground / Landing
	local plantWindow = s.plantAt > 0 and s.now - s.plantAt <= MC.WindowClose
	local cut = cutHint(s, input, env)
	if cut then
		hint.Cut = cut
	end
	hint.Jump = if plantWindow then "PLANT JUMP" else "JUMP"
	if plantWindow then
		hint.Burst = "EXPLOSIVE RESTART"
	elseif cooldownLeft(s, "BurstStep") <= 0 then
		hint.Burst = "BURST"
	end
	if cooldownLeft(s, "Dive") <= 0 then
		hint.Dive = "LAYOUT"
	end
	if s.marking then
		hint.Slide = "STANCE"
	elseif s.now < s.lateLandingUntil and not s.landedFromDive then
		hint.Slide = "PRECISION LANDING"
	elseif s.vel.Magnitude >= SL.MinSpeed then
		hint.Slide = "SLIDE"
	end
	return hint
end

function MovementSim.step(s: State, input: Input, env: Env, dt: number): Output
	s.now += dt
	local now = s.now
	local landed, tookOff = false, false
	-- body position: the real root when the driver gives it, else our estimate
	if env.pos then
		s.pos = env.pos
	else
		s.pos += s.lastOutVel * dt
	end
	s.lastMove = input.move

	-- 1. ground / air transitions -------------------------------------------
	if s.mode == "Air" or s.mode == "Dive" then
		if env.grounded and now - s.airStart > 0.08 then
			land(s)
			landed = true
		end
	elseif s.mode ~= "Frozen" then
		if not env.grounded then
			if s.groundLostAt == nil then
				s.groundLostAt = now
			end
			if now - (s.groundLostAt :: number) > Config.CoyoteTime then
				enterAir(s)
				tookOff = true
			end
		else
			s.groundLostAt = nil
		end
	end

	-- 2. collision reconciliation: only when something solid really holds us
	-- back (the driver's ray says blocked) for a moment, stop accumulating
	-- phantom speed against it. Otherwise the sim is trusted.
	local simSpeed = s.vel.Magnitude
	local pivoting = s.holding and s.holdPhase == "Pivot"
	if simSpeed > 6 and s.mode ~= "Frozen" and env.blocked == true and not pivoting then
		local along = VecMath.flat(env.actualVel):Dot(s.vel / simSpeed)
		if along < simSpeed * Config.ReconcileFraction then
			if s.blockedSince == nil then
				s.blockedSince = now
			elseif now - (s.blockedSince :: number) > Config.ReconcileTime then
				s.vel = VecMath.flat(env.actualVel)
				s.blockedSince = nil
				s.burstUntil = 0
				s.sideStepUntil = 0
			end
		else
			s.blockedSince = nil
		end
	else
		s.blockedSince = nil
	end

	-- 3. buffered press and Cut look-ahead ----------------------------------
	retryBuffer(s, input, env)
	resolveLookAhead(s, input)

	-- 4. per-mode velocity ------------------------------------------------------
	local wish = VecMath.flat(input.move)
	local wishMag = math.min(wish.Magnitude, 1)
	local top = topSpeed(s, input.sprint)
	local mode = s.mode

	if s.frozen or mode == "Frozen" then
		s.vel = Vector3.zero
	elseif s.holding and (mode == "Ground" or mode == "Landing") then
		updateHolding(s, input, env, dt)
		if mode == "Landing" and now >= s.landingUntil then
			setMode(s, "Ground")
		end
	elseif mode == "Ground" or mode == "Landing" then
		if s.marking then
			s.vel = steerShuffle(s.vel, wish, dt)
		elseif now < s.burstUntil then
			s.vel = s.burstDir * s.burstSpeed
		elseif now < s.sideStepUntil then
			s.vel = s.sideStepDir * s.sideStepSpeed
		elseif now < s.plantEnd then
			s.vel = VecMath.moveToward(s.vel, Vector3.zero, s.plantDecel * dt)
		elseif s.plantAt > 0 and not s.plantResolved then
			-- the plant ends: holding a direction restarts automatically
			s.plantResolved = true
			if wishMag > 0.2 then
				local d = VecMath.flatUnit(wish)
				local out = Config.SprintSpeed * MC.AutoRestart
				s.vel = d * math.max(out, s.vel:Dot(d))
				setLine(s, d, s.vel.Magnitude)
				s.impulse = true
			else
				s.vel = MovementSim.steerGround(s.vel, wish, top, dt, 1)
			end
		else
			local lat = if mode == "Landing" then Config.LandingSteer else 1
			if now < s.jabUntil then
				lat = math.min(lat, FC.JabSteer)
			end
			s.vel = MovementSim.steerGround(s.vel, wish, top, dt, lat)
		end
		if mode == "Landing" and now >= s.landingUntil then
			setMode(s, "Ground")
		end
		if s.plantAt > 0 and now - s.plantAt > MC.WindowClose then
			clearPlant(s)
		end
	elseif mode == "Air" then
		if not s.holding then
			s.vel = steerAir(s, wish, dt)
		end
	-- (Dive: a commitment, no steering; Air Redirect is the only adjustment)
	elseif mode == "Slide" then
		local speed = s.vel.Magnitude
		local friction = if s.holding then math.max(SL.Friction, HD.DecelRate) else SL.Friction
		local newSpeed = math.max(0, speed - friction * dt)
		local d = velDirOr(s, s.diveDir)
		if not s.holding and wishMag > 0.05 then
			d = VecMath.rotateToward(d, VecMath.flatUnit(wish), SL.SteerRate * dt)
		end
		s.vel = d * newSpeed
		if newSpeed < SL.ExitSpeed or now - s.modeStart > SL.MaxTime then
			setMode(s, "Ground")
		end
	elseif mode == "DiveSlide" then
		local speed = s.vel.Magnitude
		local friction = if s.holding then math.max(DS.Friction, HD.DecelRate) else DS.Friction
		local newSpeed = math.max(0, speed - friction * dt)
		s.vel = velDirOr(s, s.diveDir) * newSpeed
		if newSpeed < DS.StopSpeed or now - s.modeStart > DS.MaxTime then
			enterRecover(s, RC.Time)
		end
	elseif mode == "Recover" then
		if s.holding then
			s.vel = VecMath.moveToward(s.vel, Vector3.zero, HD.DecelRate * dt)
		else
			s.vel = MovementSim.steerGround(s.vel, wish, top, dt, RC.Steer)
		end
		if now >= s.recoverUntil then
			setMode(s, "Ground")
		end
	end

	-- 5. exertion ---------------------------------------------------------------
	local speedNow = s.vel.Magnitude
	local sprinting = input.sprint
		and wishMag > 0.05
		and speedNow > Config.JogSpeed + 0.5
		and isGrounded(s)
		and not s.marking
		and not s.holding
	local regenOk = now >= s.regenAt
	if sprinting then
		s.exertion -= Config.SprintDrain * dt
		if regenOk then
			s.exertion += Config.SprintRegen * dt
		end
	elseif regenOk then
		s.exertion += Config.ExertionRegen * dt
	end
	s.exertion = math.clamp(s.exertion, 0, Config.ExertionMax)

	-- 6. running line (grades Snap Cuts and Plants) ---------------------------
	if isGrounded(s) and not s.holding then
		trackLine(s, dt)
	end

	-- 7. hard safety cap ----------------------------------------------------------
	s.vel = VecMath.clampMagnitude(VecMath.flat(s.vel), Config.HardCap)

	local impulse = s.impulse or s.pendingJump or (s.vel - s.lastOutVel).Magnitude > Config.ImpulseThreshold
	local out: Output = {
		vel = s.vel,
		setVertical = s.pendingVertical,
		jump = s.pendingJump,
		events = s.pendingEvents,
		feedback = s.pendingFeedback,
		pivotEstablished = s.pendingPivot,
		landed = landed,
		tookOff = tookOff,
		impulse = impulse,
		step = if s.holding then s.step else Vector3.zero,
		pivotPos = s.pendingPivotPos,
	}
	s.lastOutVel = s.vel
	s.impulse = false
	s.pendingVertical = nil
	s.pendingJump = false
	s.pendingEvents = {}
	s.pendingFeedback = {}
	s.pendingPivot = false
	s.pendingPivotPos = nil
	return out
end

return MovementSim
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Net — one place that names every remote and replicated-state folder.

	The server creates everything in Net.init(); clients wait for it. Remotes
	are coarse and event-driven (a technique, a pivot plant, a throw, a catch
	claim): there is no per-frame client->server traffic. Every technique
	event carries its own timestamp `t` (the client's Net.now() when it
	happened), so the server judges cooldowns, chains and conversions on when
	things happened rather than when the packet arrived.

	Client -> server
	  Tech        (events: {{tech, quality, dir, t, info}}, mode)   validated on t, replicated as pose attributes
	  Pivot       (pos: Vector3)                                 proposed pivot foot P; server validates, writes UBPivot
	  ThrowCharge (throwType)                                    windup pose for everyone
	  Throw       (params)                                       params incl. step, pivot, releaseT, rootPos; the
	                                                             server computes the launch itself
	  Fake        (throwType, side)
	  Catch       (discId, tFirst, zoneKind, reachDir, rootPos, rootVel)  claim, lag-compensated; always answered
	  Reach       (dir)                                          opens the reach window server-side
	  MarkStance  (on, stance)
	  Action      (kind, payload)                                votes, pickup, training, settings, cosmetics
	Server -> client
	  Notify, Highlight, CatchResult (also Denied), Profile, Summary, Feedback, Effect, Combo
	Replicated state (attributes, late-join safe)
	  ReplicatedStorage.UBState   match phase, mode, score, clock, possession, stall, team counts
	  ReplicatedStorage.UBDiscs   one Configuration per disc (flight launch params)
	  character models            UBPivot, UBTeleport(+Pos/Yaw/Face), UBLineX/UBLineSide, UBRole, pose attributes
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.FolderName = "UBRemotes"
Net.StateName = "UBState"
Net.DiscsName = "UBDiscs"

Net.Events = {
	"Tech",
	"Pivot",
	"ThrowCharge",
	"Throw",
	"Fake",
	"Catch",
	"Reach",
	"MarkStance",
	"Action",
	"Notify",
	"Highlight",
	"CatchResult",
	"Profile",
	"Summary",
	"Feedback",
	"Effect",
	"Combo",
}

-- Unreliable streams (none at the moment; the old MarkAim pitch stream is gone).
Net.Unreliable = {} :: { string }

Net.Functions = { "GetProfile", "GetLeaderboard" }

local folder: Folder? = nil

local function ensureChild(parent: Instance, className: string, name: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

function Net.init()
	assert(RunService:IsServer(), "Net.init is server-only")
	local f = ensureChild(ReplicatedStorage, "Folder", Net.FolderName) :: Folder
	for _, name in Net.Events do
		ensureChild(f, "RemoteEvent", name)
	end
	for _, name in Net.Unreliable do
		ensureChild(f, "UnreliableRemoteEvent", name)
	end
	for _, name in Net.Functions do
		ensureChild(f, "RemoteFunction", name)
	end
	ensureChild(ReplicatedStorage, "Folder", Net.StateName)
	ensureChild(ReplicatedStorage, "Folder", Net.DiscsName)
	folder = f
end

local function getFolder(): Folder
	if folder then
		return folder :: Folder
	end
	local f = ReplicatedStorage:WaitForChild(Net.FolderName, 60) :: Folder
	assert(f, "UBRemotes folder missing (is the server running?)")
	folder = f
	return f
end

function Net.event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.unreliable(name: string): UnreliableRemoteEvent
	return getFolder():WaitForChild(name) :: UnreliableRemoteEvent
end

function Net.func(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

function Net.state(): Folder
	return ReplicatedStorage:WaitForChild(Net.StateName) :: Folder
end

function Net.discs(): Folder
	return ReplicatedStorage:WaitForChild(Net.DiscsName) :: Folder
end

-- Server time shared by every machine (used for disc flights and windows).
function Net.now(): number
	return workspace:GetServerTimeNow()
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Rules</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CatchGeometry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CatchGeometry — readable, deterministic catch and block volumes.

	A player's catch envelope is a small set of capsules derived from their
	root position, facing and movement state:
	  Secure   sphere at the chest (always on; drops low while sliding)
	  Reach    capsule from the shoulder along the aim direction, active for a
	           short window after pressing Reach (also used airborne for the
	           Aerial Catch Adjustment). The shoulder offset slides smoothly
	           with the reach direction (clamp(dot * 3, -1, 1)), so a
	           straight-ahead reach never flips sides between client and server.
	  Dive     long capsule from the chest along the dive direction (Layout)

	Catch quality is judged at the disc's closest approach: the minimum depth
	over a short window after first contact (bestOverPath), not at the rim
	where the first touch happens. Inside CleanFraction of a zone is a Clean
	catch; beyond it a Fingertip catch. Fingertip catches of fast (disc speed)
	or contested discs bobble, and a defender's touch is a Block only right at
	the rim (depth > BlockDepth), otherwise an interception (outcome). An
	explainable rule, not a dice roll.

	Server tolerance: slack(ping, speed) widens zones for latency and body
	speed; claimRoot decides whether the zones are built from the body
	position the client sent or from the server's (led) view.

	Mark: a box of hands in front of the marker, oriented by the marker's
	facing blended toward the thrower's pivot P (markForward), with Low/High
	bands and a Relaxed chest sphere. Jumping lifts it. Disc space and stall
	range are measured from P (markDistance), so only the marker can cause a
	disc-space call.
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)
local VecMath = require(Shared.Util.VecMath)

local C = DiscConfig.Catch
local M = DiscConfig.Mark

local CatchGeometry = {}

export type Zone = {
	kind: string, -- "Secure" | "Reach" | "Dive"
	a: Vector3,
	b: Vector3,
	radius: number,
}

export type BodyState = {
	root: Vector3,
	facing: Vector3, -- horizontal unit
	reaching: boolean,
	reachDir: Vector3?,
	diving: boolean,
	diveDir: Vector3?,
	sliding: boolean,
}

local UP = Vector3.new(0, 1, 0)

local function finite(v: number): boolean
	return v == v and v ~= math.huge and v ~= -math.huge
end

function CatchGeometry.zones(body: BodyState): { Zone }
	local zones: { Zone } = {}
	local facing = VecMath.flatUnit(body.facing)
	if facing.Magnitude < 0.5 then
		facing = Vector3.new(0, 0, -1)
	end
	local chest = body.root + UP * C.ChestHeight + facing * 0.4
	if body.sliding then
		chest -= UP * C.SlideDrop
	end
	table.insert(zones, { kind = "Secure", a = chest, b = chest, radius = C.SecureRadius })

	if body.reaching and body.reachDir then
		local dir = VecMath.safeUnit(body.reachDir, facing)
		local right = Vector3.new(-facing.Z, 0, facing.X)
		local side = math.clamp(dir:Dot(right) * 3, -1, 1)
		local shoulder = body.root + UP * C.ShoulderHeight + right * (C.ShoulderWidth * side)
		table.insert(zones, {
			kind = "Reach",
			a = shoulder,
			b = shoulder + dir * C.ReachLength,
			radius = C.ReachRadius,
		})
	end

	if body.diving and body.diveDir then
		local dir = VecMath.safeUnit(body.diveDir, facing)
		local start = body.root + UP * 0.2
		table.insert(zones, {
			kind = "Dive",
			a = start,
			b = start + dir * C.DiveLength,
			radius = C.DiveRadius,
		})
	end
	return zones
end

function CatchGeometry.coreDistance(zone: Zone, p: Vector3): (number, Vector3)
	local core = VecMath.closestOnSegment(zone.a, zone.b, p)
	return (p - core).Magnitude, core
end

export type Evaluation = {
	zone: Zone,
	distance: number, -- distance from disc to the zone core
	depth: number, -- 0 = core, 1 = rim
	quality: string, -- "Clean" | "Fingertip"
	hand: Vector3,
	t: number?, -- sample time (bestOverPath only)
}

-- Clean / Fingertip for a depth (0 = core, 1 = rim).
function CatchGeometry.qualityFor(depth: number): string
	return if depth <= C.CleanFraction then "Clean" else "Fingertip"
end

-- Best zone containing point p (disc centre), or nil. `slack` widens every
-- zone (server-side latency tolerance) without changing the depth scale.
function CatchGeometry.evaluate(zones: { Zone }, p: Vector3, slack: number?): Evaluation?
	local extra = slack or 0
	local best: Evaluation? = nil
	for _, z in zones do
		local d, core = CatchGeometry.coreDistance(z, p)
		local r = z.radius + DiscConfig.Physics.Radius * 0.5
		if d <= r + extra then
			local depth = math.clamp(d / r, 0, 1)
			if best == nil or depth < (best :: Evaluation).depth then
				best = {
					zone = z,
					distance = d,
					depth = depth,
					quality = CatchGeometry.qualityFor(depth),
					hand = core,
				}
			end
		end
	end
	return best
end

export type PathSample = { t: number, pos: Vector3 }

-- Closest approach: the evaluation with the minimum depth over a stretch of
-- the disc's path (e.g. QualitySamples steps of 1/120 s from first contact).
-- The zones are the body at time t0; with `bodyVel` each sample is moved into
-- the body's moving frame (pos - bodyVel * (t - t0)), so a receiver running
-- through the disc is judged by where the disc passes relative to the body.
-- The returned evaluation carries the sample time in `t`. nil = never inside.
function CatchGeometry.bestOverPath(
	zones: { Zone },
	samples: { PathSample },
	t0: number,
	bodyVel: Vector3?,
	slack: number?
): Evaluation?
	local vel = bodyVel or Vector3.zero
	local best: Evaluation? = nil
	for _, sample in samples do
		local p = sample.pos - vel * (sample.t - t0)
		local ev = CatchGeometry.evaluate(zones, p, slack)
		if ev and (best == nil or ev.depth < (best :: Evaluation).depth) then
			ev.t = sample.t
			best = ev
		end
	end
	return best
end

-- Positional tolerance for a claim: BaseSlack + ping * PingSlackPerSecond +
-- body speed * SpeedSlack, capped at MaxSlack. Junk input counts as zero.
function CatchGeometry.slack(ping: number, speed: number): number
	local pg = if finite(ping) then math.max(ping, 0) else 0
	local sp = if finite(speed) then math.max(speed, 0) else 0
	return math.min(C.BaseSlack + pg * C.PingSlackPerSecond + sp * C.SpeedSlack, C.MaxSlack)
end

-- Which body position the server builds a claim's zones from. The client's
-- reported root (untrusted, any type) is used when it is within
-- ClientRootBase + speed * ClientRootSpeedTime + ping * speed of the server
-- root (cap ClientRootMax); otherwise the server root led by its velocity *
-- ClientRootLead. Returns (root, acceptedClientRoot).
function CatchGeometry.claimRoot(
	clientPos: any,
	serverPos: Vector3,
	serverVel: Vector3,
	ping: number
): (Vector3, boolean)
	local speed = serverVel.Magnitude
	if not finite(speed) then
		speed = 0
	end
	if typeof(clientPos) == "Vector3" then
		local p = clientPos :: Vector3
		if finite(p.X) and finite(p.Y) and finite(p.Z) then
			local pg = if finite(ping) then math.max(ping, 0) else 0
			local tolerance = math.min(C.ClientRootBase + speed * C.ClientRootSpeedTime + pg * speed, C.ClientRootMax)
			if (p - serverPos).Magnitude <= tolerance then
				return p, true
			end
		end
	end
	local lead = if speed > 0 then serverVel * C.ClientRootLead else Vector3.zero
	return serverPos + lead, false
end

export type Claim = {
	id: number,
	team: string,
	t: number, -- first contact (orders claims)
	depth: number, -- closest approach (bestOverPath)
	quality: string,
	relativeSpeed: number, -- disc speed at the claim (running at a disc never makes it harder)
}

export type Resolution = {
	winner: Claim,
	contested: boolean,
	bobble: boolean,
	reason: string,
}

-- Picks the winning claim. Earliest touch wins; touches within ContestWindow
-- of each other are a contest won by the cleaner hand position. A fingertip
-- winner in a contest, or a fingertip catch of a very fast disc, bobbles.
function CatchGeometry.resolve(claims: { Claim }): Resolution?
	if #claims == 0 then
		return nil
	end
	local sorted = table.clone(claims)
	table.sort(sorted, function(x, y)
		if x.t ~= y.t then
			return x.t < y.t
		end
		return x.depth < y.depth
	end)
	local first = sorted[1]
	local contenders = {}
	for _, c in sorted do
		if c.t - first.t <= C.ContestWindow then
			table.insert(contenders, c)
		end
	end
	local winner = contenders[1]
	for _, c in contenders do
		if c.depth < winner.depth - 1e-6 then
			winner = c
		end
	end
	local contested = false
	for _, c in contenders do
		if c ~= winner and c.team ~= winner.team then
			contested = true
		end
	end
	local bobble = false
	local reason = winner.quality
	if winner.quality == "Fingertip" then
		if contested then
			bobble = true
			reason = "Fingertip under pressure"
		elseif winner.relativeSpeed > C.BobbleSpeed then
			bobble = true
			reason = "Fingertip on a fast disc"
		end
	end
	return { winner = winner, contested = contested, bobble = bobble, reason = reason }
end

-- What a resolution means: "Block" (a defender only got the rim:
-- depth > BlockDepth), "Bobble", or "Catch" (an interception when
-- `winnerIsDefender`).
function CatchGeometry.outcome(resolution: Resolution, winnerIsDefender: boolean): string
	if winnerIsDefender and resolution.winner.depth > C.BlockDepth then
		return "Block"
	elseif resolution.bobble then
		return "Bobble"
	end
	return "Catch"
end

export type MarkStance = "Relaxed" | "Low" | "High"

-- Flat distance from a marker to the thrower's pivot P (stall range, disc space).
function CatchGeometry.markDistance(markerPos: Vector3, pivot: Vector3): number
	return Vector3.new(markerPos.X - pivot.X, 0, markerPos.Z - pivot.Z).Magnitude
end

-- Disc space: a marker standing closer than DiscSpace to P.
function CatchGeometry.isDiscSpace(markerPos: Vector3, pivot: Vector3): boolean
	return CatchGeometry.markDistance(markerPos, pivot) < M.DiscSpace
end

-- Seconds to rewind markers for a hand-block test against a thrower with
-- this ping (favours the thrower, capped).
function CatchGeometry.markerRewind(ping: number): number
	local pg = if finite(ping) then math.max(ping, 0) else 0
	return math.min(pg * 0.5 + M.RewindBase, M.RewindMax)
end

-- Forward axis of a marker's hand box: the marker's facing blended
-- FacingBlend toward the direction to P (angle-wise), at most MaxFacingOff
-- degrees off P. Falls back to the facing when the marker stands on P, and
-- to the direction to P when the facing is degenerate. Zero if both are.
function CatchGeometry.markForward(markerPos: Vector3, markerFacing: Vector3, pivot: Vector3): Vector3
	local toP = VecMath.flatUnit(pivot - markerPos)
	local facing = VecMath.flatUnit(markerFacing)
	if toP.Magnitude < 0.5 then
		return facing
	end
	if facing.Magnitude < 0.5 then
		return toP
	end
	local a = VecMath.yaw(toP)
	local diff = (VecMath.yaw(facing) - a + math.pi) % (2 * math.pi) - math.pi
	local cap = math.rad(M.MaxFacingOff)
	return VecMath.fromYaw(a + math.clamp(diff * M.FacingBlend, -cap, cap))
end

export type MarkBox = {
	stance: MarkStance,
	origin: Vector3, -- marker root
	forward: Vector3, -- flat unit (zero = no box)
	right: Vector3,
	floor: number, -- ground height + jump lift
	chest: Vector3, -- Relaxed sphere centre
}

-- Precomputes a marker's hand box (cheap to test many disc samples against).
-- The Low/High bands are heights above `groundY`; `jumpHeight` is how far the
-- marker has risen above standing, and the bands rise by that plus up to
-- JumpBonus as the arms stretch. The Relaxed sphere rides on the root.
function CatchGeometry.markBox(
	markerPos: Vector3,
	markerFacing: Vector3,
	pivot: Vector3,
	stance: MarkStance,
	groundY: number,
	jumpHeight: number?
): MarkBox
	local jh = jumpHeight or 0
	if not finite(jh) or jh < 0 then
		jh = 0
	end
	local lift = jh + math.min(jh, M.JumpBonus)
	local forward = CatchGeometry.markForward(markerPos, markerFacing, pivot)
	return {
		stance = stance,
		origin = markerPos,
		forward = forward,
		right = Vector3.new(-forward.Z, 0, forward.X),
		floor = groundY + lift,
		chest = markerPos + UP * C.ChestHeight, -- the root already rises with a jump
	}
end

function CatchGeometry.inMarkBox(box: MarkBox, p: Vector3): boolean
	if box.stance == "Relaxed" then
		return (p - box.chest).Magnitude <= M.RelaxedRadius
	end
	if box.forward.Magnitude < 0.5 then
		return false
	end
	local rel = p - box.origin
	local depth = rel:Dot(box.forward)
	if depth < M.DepthMin or depth > M.DepthMax then
		return false
	end
	local high = box.stance == "High"
	if math.abs(rel:Dot(box.right)) > (if high then M.HighHalfWidth else M.LowHalfWidth) then
		return false
	end
	local band = if high then M.HighY else M.LowY
	local height = p.Y - box.floor
	return height >= band[1] and height <= band[2]
end

-- Is point p (e.g. a disc sample just after release) inside a marker's hand
-- zone? Low stance = wide hands knees to chest; High = narrower, shoulders to
-- above the head; Relaxed = a small sphere at the chest. See markBox.
function CatchGeometry.inMarkZone(
	markerPos: Vector3,
	markerFacing: Vector3,
	pivot: Vector3,
	stance: MarkStance,
	p: Vector3,
	groundY: number,
	jumpHeight: number?
): boolean
	return CatchGeometry.inMarkBox(
		CatchGeometry.markBox(markerPos, markerFacing, pivot, stance, groundY, jumpHeight),
		p
	)
end

return CatchGeometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ComboEvaluator</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ComboEvaluator — scores movement chains so that difficulty, variety and
	timing matter and spam does not.

	  event score  = base(tech) * quality * variety
	                 quality: Perfect 1.5, Clean 1.0, Sloppy 0.5, Gassed 0.3
	                 variety: same as previous 0.25, in last three 0.6, new 1.0
	  chain score  = sum(event scores) * length bonus * unique bonus
	                 length bonus  1 + 0.2 per extra scoring tech (max x3)
	                 unique bonus  1 + 0.08 per distinct tech beyond the first (max x1.4)

	A chain is visible from its first technique and ends after ChainWindow
	(1.5 s) without one; expire() then returns its end-of-chain summary
	{ count, total, tier, techs, ... } for the HUD card. Payout:
	  * CONVERTED into a play (catch, interception, block) during the chain or
	    within ConvertWindow (2.0 s) after it: x2 score, XP and highlights.
	  * Not converted: 25 % of its score as XP. settle() hands each such chain
	    to the server exactly once, after it can no longer be converted.
	Summary.xpScore is the score XP should be computed from in either case.

	The thrower's "Break" link (fake -> swing -> release) is scored by the throw
	path: release() adds it when the chain's last technique is a Sold
	PivotSwing that finished within BreakWindow of the release.
]]

local Shared = script.Parent.Parent
local MovementConfig = require(Shared.Config.Movement)

local ComboEvaluator = {}

ComboEvaluator.ChainWindow = MovementConfig.ChainWindow
ComboEvaluator.ConvertWindow = 2.0
ComboEvaluator.UnconvertedShare = 0.25 -- an unconverted chain pays this share of its score as XP
ComboEvaluator.ConvertedMult = 2
-- Break: release within this long after a Sold swing finishes (Perfect if
-- within half of it).
ComboEvaluator.BreakWindow = 0.3

local MAX_UNSETTLED = 16

local QUALITY_MULT: { [string]: number } = {
	Perfect = 1.5,
	Clean = 1.0,
	Sloppy = 0.5,
	Gassed = 0.3,
}

ComboEvaluator.Tiers = {
	{ min = 2600, name = "BREAKPOINT" },
	{ min = 1600, name = "FILTHY" },
	{ min = 900, name = "SLICK" },
	{ min = 400, name = "NICE" },
}

export type Entry = {
	tech: string,
	quality: string,
	t: number,
	score: number,
}

export type Chain = {
	entries: { Entry },
	raw: number,
	scoring: number,
	unique: { [string]: boolean },
	uniqueCount: number,
	startT: number,
	lastT: number,
}

export type Summary = {
	-- end-of-chain card
	count: number, -- scoring techniques in the chain
	total: number, -- chain score before any conversion bonus
	tier: string?, -- tier of `score`
	techs: { string },
	-- payout
	score: number, -- total, x2 once converted
	xpScore: number, -- score XP is computed from (converted: score; else 25 % of total)
	converted: boolean,
	payoff: string?,
	-- detail
	length: number, -- (same as count; kept for older readers)
	uniqueCount: number,
	perfects: number,
	startT: number,
	endT: number,
}

export type Tracker = {
	chain: Chain?,
	lastFinished: Summary?,
	lastFinishedAt: number,
	settled: { [Summary]: boolean },
	unsettled: { Summary },
}

local function points(tech: string): number
	return (MovementConfig.ComboPoints :: any)[tech] or 0
end

function ComboEvaluator.newTracker(): Tracker
	return { chain = nil, lastFinished = nil, lastFinishedAt = -math.huge, settled = {}, unsettled = {} }
end

local function newChain(t: number): Chain
	return { entries = {}, raw = 0, scoring = 0, unique = {}, uniqueCount = 0, startT = t, lastT = t }
end

function ComboEvaluator.total(c: Chain): number
	local lengthBonus = math.min(3, 1 + 0.2 * math.max(0, c.scoring - 1))
	local uniqueBonus = math.min(1.4, 1 + 0.08 * math.max(0, c.uniqueCount - 1))
	return math.floor(c.raw * lengthBonus * uniqueBonus + 0.5)
end

function ComboEvaluator.tier(score: number): string?
	for _, t in ComboEvaluator.Tiers do
		if score >= t.min then
			return t.name
		end
	end
	return nil
end

local function applyPayout(s: Summary)
	s.score = if s.converted then s.total * ComboEvaluator.ConvertedMult else s.total
	s.xpScore = if s.converted then s.score else math.floor(s.total * ComboEvaluator.UnconvertedShare)
	s.tier = ComboEvaluator.tier(s.score)
end

local function summarize(c: Chain, converted: boolean, payoff: string?): Summary
	local techs = {}
	local perfects = 0
	for _, e in c.entries do
		table.insert(techs, e.tech)
		if e.quality == "Perfect" then
			perfects += 1
		end
	end
	local s: Summary = {
		count = c.scoring,
		total = ComboEvaluator.total(c),
		tier = nil,
		techs = techs,
		score = 0,
		xpScore = 0,
		converted = converted,
		payoff = payoff,
		length = c.scoring,
		uniqueCount = c.uniqueCount,
		perfects = perfects,
		startT = c.startT,
		endT = c.lastT,
	}
	applyPayout(s)
	return s
end

-- Remembers a finished, unconverted chain so settle() can pay its share once.
local function remember(tr: Tracker, s: Summary, at: number)
	local prev = tr.lastFinished
	if prev and not prev.converted and not tr.settled[prev] then
		-- a newer chain replaces it: it can no longer be converted
		table.insert(tr.unsettled, prev)
		if #tr.unsettled > MAX_UNSETTLED then
			-- (a tracker nobody settles, e.g. the client's, stays small)
			table.remove(tr.unsettled, 1)
		end
	end
	tr.lastFinished = s
	tr.lastFinishedAt = at
end

-- Closes the active chain if it has timed out. Returns its end-of-chain
-- summary (unconverted) once, on the call that ends it.
function ComboEvaluator.expire(tr: Tracker, now: number): Summary?
	local c = tr.chain
	if c and now - c.lastT > ComboEvaluator.ChainWindow then
		tr.chain = nil
		if c.scoring <= 0 then
			return nil
		end
		local s = summarize(c, false, nil)
		remember(tr, s, c.lastT)
		return s
	end
	return nil
end

-- Unconverted chains that can no longer be converted, each returned exactly
-- once (the server pays their UnconvertedShare XP from Summary.xpScore).
function ComboEvaluator.settle(tr: Tracker, now: number): { Summary }
	ComboEvaluator.expire(tr, now)
	local out = tr.unsettled
	tr.unsettled = {}
	local last = tr.lastFinished
	if
		last
		and not last.converted
		and not tr.settled[last]
		and (tr.chain ~= nil or now - tr.lastFinishedAt > ComboEvaluator.ConvertWindow)
	then
		table.insert(out, last)
	end
	for _, s in out do
		tr.settled[s] = true
	end
	if last and tr.settled[last] then
		-- keep the set small: only the latest summary can still be looked up
		tr.settled = { [last] = true }
	else
		tr.settled = {}
	end
	return out
end

-- Adds a technique; returns the points it added (before chain bonuses) and
-- the chain's running total.
function ComboEvaluator.add(tr: Tracker, tech: string, quality: string, t: number): (number, number)
	ComboEvaluator.expire(tr, t)
	local c = tr.chain
	if c == nil then
		c = newChain(t)
		tr.chain = c
	end
	local chain = c :: Chain
	local base = points(tech)
	local variety = 1.0
	local n = #chain.entries
	if base > 0 then
		local lastScoring: Entry? = nil
		local recent = 0
		for i = n, 1, -1 do
			local e = chain.entries[i]
			if points(e.tech) > 0 then
				if lastScoring == nil then
					lastScoring = e
				end
				recent += 1
				if e.tech == tech and recent <= 3 and variety > 0.6 then
					variety = 0.6
				end
				if recent >= 3 then
					break
				end
			end
		end
		if lastScoring and lastScoring.tech == tech then
			variety = 0.25
		end
	end
	local score = base * (QUALITY_MULT[quality] or 1) * variety
	table.insert(chain.entries, { tech = tech, quality = quality, t = t, score = score })
	if base > 0 then
		chain.scoring += 1
		if not chain.unique[tech] then
			chain.unique[tech] = true
			chain.uniqueCount += 1
		end
	end
	chain.raw += score
	chain.lastT = t
	return score, ComboEvaluator.total(chain)
end

-- The Break link quality for a release at time t, or nil: the chain's last
-- technique must be a Sold (Perfect) PivotSwing that finished at most
-- BreakWindow before the release.
function ComboEvaluator.breakQuality(tr: Tracker, t: number): string?
	local c = ComboEvaluator.active(tr, t)
	if c == nil then
		return nil
	end
	local last = c.entries[#c.entries]
	if last == nil or last.tech ~= "PivotSwing" or last.quality ~= "Perfect" then
		return nil
	end
	local after = t - (last.t + MovementConfig.Holding.SwingTime)
	if after > ComboEvaluator.BreakWindow then
		return nil
	end
	return if after <= ComboEvaluator.BreakWindow * 0.5 then "Perfect" else "Clean"
end

-- Called by the throw path at release. Adds the "Break" link when the release
-- follows a Sold swing (fake -> swing -> release); returns its points and the
-- chain total, or nil. (The throw path may also add "Break" itself.)
function ComboEvaluator.release(tr: Tracker, t: number): (number?, number?)
	local q = ComboEvaluator.breakQuality(tr, t)
	if q == nil then
		return nil, nil
	end
	return ComboEvaluator.add(tr, "Break", q, t)
end

-- A meaningful play happened (catch, interception, block). Converts the active
-- chain, or one that ended within ConvertWindow. Returns the summary or nil.
function ComboEvaluator.convert(tr: Tracker, now: number, payoff: string): Summary?
	local c = tr.chain
	if c and now - c.lastT <= ComboEvaluator.ConvertWindow and c.scoring > 0 then
		tr.chain = nil
		local s = summarize(c, true, payoff)
		remember(tr, s, now)
		return s
	end
	local last = tr.lastFinished
	if
		c == nil
		and last
		and not last.converted
		and not tr.settled[last]
		and now - tr.lastFinishedAt <= ComboEvaluator.ConvertWindow
	then
		last.converted = true
		last.payoff = payoff
		applyPayout(last)
		return last
	end
	return nil
end

function ComboEvaluator.active(tr: Tracker, now: number): Chain?
	local c = tr.chain
	if c and now - c.lastT <= ComboEvaluator.ChainWindow then
		return c
	end
	return nil
end

-- Fraction of the chain window left (1 = a technique just landed, 0 = no
-- chain), for the HUD's draining bar.
function ComboEvaluator.windowLeft(tr: Tracker, now: number): number
	local c = ComboEvaluator.active(tr, now)
	if c == nil then
		return 0
	end
	return math.clamp(1 - (now - c.lastT) / ComboEvaluator.ChainWindow, 0, 1)
end

return ComboEvaluator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">FieldGeometry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	FieldGeometry — boundaries, end zones and spots on an axis-aligned field.

	Layout (top view, +X = East):

	   West end zone |        playing field proper        | East end zone
	  x: -half-ez .. -half   -half .. +half             +half .. +half+ez
	  z: -width/2 .. +width/2

	Lines are part of out-of-bounds in real ultimate; here the line itself is
	treated as in-bounds for readability on a Roblox field (documented).

	Line-ups: before the pull each team stands in the end zone it defends, on
	evenly spaced spots 2 studs behind its goal line. The line spans 12 studs
	per player (at most the width minus 8 studs at each sideline): 7 players
	stand 14 studs apart on the Normal field, 3 players 18 apart on Mini.
	Until the pull is released a player must stay behind that goal line:
	lineRestriction gives the (UBLineX, UBLineSide) half-plane the client
	clamps to, and offsideBy / behindLine let the server pull stragglers back.

	Benches: substitutes wait on the -Z sideline, team A's bench on the West
	half and team B's on the East half (benchCenter / benchSpots).
]]

local FieldGeometry = {}

export type Side = "East" | "West"

export type Field = {
	center: Vector3,
	groundY: number,
	width: number,
	length: number, -- playing field proper
	endZone: number,
	brick: number, -- distance of the brick mark from the goal line
	halfLength: number,
	halfWidth: number,
}

export type Spec = {
	center: Vector3,
	width: number,
	length: number,
	endZone: number,
	brick: number?,
}

function FieldGeometry.new(spec: Spec): Field
	return {
		center = spec.center,
		groundY = spec.center.Y,
		width = spec.width,
		length = spec.length,
		endZone = spec.endZone,
		brick = spec.brick or math.floor(spec.length * 0.2),
		halfLength = spec.length / 2,
		halfWidth = spec.width / 2,
	}
end

local function localXZ(f: Field, pos: Vector3): (number, number)
	return pos.X - f.center.X, pos.Z - f.center.Z
end

function FieldGeometry.other(side: Side): Side
	return if side == "East" then "West" else "East"
end

function FieldGeometry.inBounds(f: Field, pos: Vector3): boolean
	local x, z = localXZ(f, pos)
	return math.abs(x) <= f.halfLength + f.endZone and math.abs(z) <= f.halfWidth
end

function FieldGeometry.inEndZone(f: Field, pos: Vector3, side: Side): boolean
	if not FieldGeometry.inBounds(f, pos) then
		return false
	end
	local x = pos.X - f.center.X
	if side == "East" then
		return x > f.halfLength
	end
	return x < -f.halfLength
end

-- "East" | "West" | "Field" | "Out"
function FieldGeometry.region(f: Field, pos: Vector3): string
	if not FieldGeometry.inBounds(f, pos) then
		return "Out"
	end
	if FieldGeometry.inEndZone(f, pos, "East") then
		return "East"
	elseif FieldGeometry.inEndZone(f, pos, "West") then
		return "West"
	end
	return "Field"
end

function FieldGeometry.toWorld(f: Field, x: number, z: number): Vector3
	return Vector3.new(f.center.X + x, f.groundY, f.center.Z + z)
end

-- Nearest in-bounds ground point.
function FieldGeometry.clampInBounds(f: Field, pos: Vector3, inset: number?): Vector3
	local i = inset or 1
	local x, z = localXZ(f, pos)
	local maxX = f.halfLength + f.endZone - i
	local maxZ = f.halfWidth - i
	return FieldGeometry.toWorld(f, math.clamp(x, -maxX, maxX), math.clamp(z, -maxZ, maxZ))
end

-- Point on the goal line of `side` closest to pos (in bounds).
function FieldGeometry.goalLinePoint(f: Field, pos: Vector3, side: Side): Vector3
	local _, z = localXZ(f, pos)
	local x = if side == "East" then f.halfLength else -f.halfLength
	return FieldGeometry.toWorld(f, x, math.clamp(z, -f.halfWidth + 1, f.halfWidth - 1))
end

-- Brick mark in front of the end zone on `side` (the end zone a team defends).
function FieldGeometry.brickPoint(f: Field, side: Side): Vector3
	local x = if side == "East" then f.halfLength - f.brick else -f.halfLength + f.brick
	return FieldGeometry.toWorld(f, x, 0)
end

function FieldGeometry.endZoneCenter(f: Field, side: Side): Vector3
	local x = (f.halfLength + f.endZone / 2) * (if side == "East" then 1 else -1)
	return FieldGeometry.toWorld(f, x, 0)
end

-- Where a turnover is put into play: in bounds, and pulled out of an end zone
-- onto its goal line.
function FieldGeometry.turnoverSpot(f: Field, pos: Vector3): Vector3
	local p = FieldGeometry.clampInBounds(f, pos, 1)
	local region = FieldGeometry.region(f, p)
	if region == "East" or region == "West" then
		return FieldGeometry.goalLinePoint(f, p, region :: Side)
	end
	return p
end

-- Point where the segment from -> to first leaves the field (for discs that
-- fly out of bounds). Falls back to clamping `to`.
function FieldGeometry.exitPoint(f: Field, from: Vector3, to: Vector3): Vector3
	if not FieldGeometry.inBounds(f, from) then
		return FieldGeometry.clampInBounds(f, to)
	end
	local lo, hi = 0, 1
	for _ = 1, 20 do
		local mid = (lo + hi) / 2
		local p = from:Lerp(to, mid)
		if FieldGeometry.inBounds(f, p) then
			lo = mid
		else
			hi = mid
		end
	end
	return FieldGeometry.clampInBounds(f, from:Lerp(to, lo), 1)
end

-- Line-up span per player (studs), and the room kept free at each sideline.
FieldGeometry.LineupPitch = 12
FieldGeometry.LineupSidelineGap = 8

-- World X of the goal line in front of the end zone on `side`.
function FieldGeometry.goalLineX(f: Field, side: Side): number
	return f.center.X + (if side == "East" then f.halfLength else -f.halfLength)
end

-- +1 for East, -1 for West: the X direction that points from the field into
-- that end zone.
function FieldGeometry.sideSign(side: Side): number
	return if side == "East" then 1 else -1
end

-- The pre-pull restriction for a team lining up in the end zone on `side`, as
-- the character attributes (UBLineX, UBLineSide): the player must keep
-- (pos.X - lineX) * lineSide >= 0, i.e. stay on or behind the goal line.
function FieldGeometry.lineRestriction(f: Field, side: Side): (number, number)
	return FieldGeometry.goalLineX(f, side), FieldGeometry.sideSign(side)
end

-- How far (studs, >= 0) pos is past the goal line of `side` into the field.
function FieldGeometry.offsideBy(f: Field, pos: Vector3, side: Side): number
	return math.max(0, -(pos.X - FieldGeometry.goalLineX(f, side)) * FieldGeometry.sideSign(side))
end

-- pos moved straight back so it is `inset` studs behind the goal line of
-- `side` (unchanged when it already is), kept inside the end zone and the
-- sidelines. Height is kept.
function FieldGeometry.behindLine(f: Field, pos: Vector3, side: Side, inset: number?): Vector3
	local i = inset or 1
	local sign = FieldGeometry.sideSign(side)
	local lineX = FieldGeometry.goalLineX(f, side)
	local depth = (pos.X - lineX) * sign
	local x = pos.X
	if depth < i then
		x = lineX + sign * math.min(i, f.endZone)
	end
	local backX = lineX + sign * f.endZone
	if (x - backX) * sign > 0 then
		x = backX
	end
	local z = math.clamp(pos.Z, f.center.Z - f.halfWidth + 1, f.center.Z + f.halfWidth - 1)
	return Vector3.new(x, pos.Y, z)
end

-- Distance (studs) between the outermost spots of a line-up of `count`.
function FieldGeometry.lineupSpan(f: Field, count: number): number
	if count <= 1 then
		return 0
	end
	local room = math.max(0, f.width - 2 * FieldGeometry.LineupSidelineGap)
	return math.min(room, count * FieldGeometry.LineupPitch)
end

-- Evenly spaced line-up spots 2 studs behind a team's goal line, centred
-- across the field (index 1 is the -Z end).
function FieldGeometry.lineup(f: Field, side: Side, count: number): { Vector3 }
	local spots = {}
	local x = if side == "East" then f.halfLength + 2 else -f.halfLength - 2
	local span = FieldGeometry.lineupSpan(f, count)
	for i = 1, count do
		local t = if count == 1 then 0.5 else (i - 1) / (count - 1)
		local z = -span / 2 + span * t
		table.insert(spots, FieldGeometry.toWorld(f, x, z))
	end
	return spots
end

-- Spot `index` (clamped to 1..count) of a line-up of `count` on `side`.
function FieldGeometry.lineupSpot(f: Field, side: Side, index: number, count: number): Vector3
	local n = math.max(1, count)
	return FieldGeometry.lineup(f, side, n)[math.clamp(index, 1, n)]
end

-- Benches sit 14 studs outside the -Z sideline, centred at 18 % of the
-- playing length from midfield; `sign` -1 = West half (team A), +1 = East
-- half (team B).
FieldGeometry.BenchOffset = 14
FieldGeometry.BenchFraction = 0.18

function FieldGeometry.benchCenter(f: Field, sign: number): Vector3
	local s = if sign < 0 then -1 else 1
	return FieldGeometry.toWorld(
		f,
		s * FieldGeometry.BenchFraction * f.length,
		-(f.halfWidth + FieldGeometry.BenchOffset)
	)
end

-- `count` spots along a bench, 4 studs apart, centred on benchCenter.
function FieldGeometry.benchSpots(f: Field, sign: number, count: number): { Vector3 }
	local c = FieldGeometry.benchCenter(f, sign)
	local spots = {}
	for i = 1, count do
		local dx = (i - (count + 1) / 2) * 4
		table.insert(spots, c + Vector3.new(dx, 0, 0))
	end
	return spots
end

-- Unit direction (+X or -X) a team attacking `side` runs toward.
function FieldGeometry.attackDirection(side: Side): Vector3
	return if side == "East" then Vector3.new(1, 0, 0) else Vector3.new(-1, 0, 0)
end

return FieldGeometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">MatchPlan</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MatchPlan — who plays for which team, and who is on the field each point.

	Pure bookkeeping over actor ids (numbers), so the team rules can be unit
	tested (tests/modes_spec.luau). TeamService owns the actual actors: it
	calls these functions, then makes the world match the plan (sets each
	human's team and role, spawns or removes bots, teleports the lines).

	Rules:
	  - Teams: every human is split with Rating.balance (rating as a skill
	    proxy, unrated players count as the starting rating), so the human
	    counts differ by at most one and the strengths are close. The counts
	    stay within one for the whole match: when a leaver breaks that, a
	    benched player switches team at once, otherwise someone switches at
	    the next point.
	  - The line: at most TeamSize humans per team are on the field (role
	    "Match"); the rest are role "Bench". At each point setup the humans who
	    have sat out the most points in a row go first, then those who have
	    sat out the most points in total, then the earliest arrivals, so
	    everyone plays an equal share. With FillWithBots the empty spots go to
	    bots, so the field is always exactly TeamSize v TeamSize; with an odd
	    number of humans the side with fewer humans gets the extra bot.
	  - Late joiner: goes to the team with fewer humans (tie: the weaker team,
	    then A) as Bench, and is picked at the next point setup ahead of anyone
	    who has just played, taking a bot's spot when the team has one. From
	    then on they rotate as if they had been there all along.
	  - Leaver: removed at once; when they were on the field a bot takes their
	    spot straight away (FillWithBots), so the point is not played short.
	  - Ranked: the mode must be RankedEligible, the server public (not a
	    private server, not Studio) and both lines all human at the start: at
	    least 2 x TeamSize humans, no bots (substitutes allowed while
	    MatchPlan.RankedBench is true). The ranked roster is recorded at the
	    start; a roster player who leaves takes a loss and the result is void
	    for everyone else (rankedResult).

	Bots are tracked by id once TeamService has spawned them (addBot /
	removeBot); botWork says how many to spawn and which to remove.

	Typical use (TeamService):
	  match start  plan = MatchPlan.new(mode, entries, { ranked = ranked }); apply
	  point setup  MatchPlan.line(plan, engine.pointNumber); apply; line up
	               MatchPlan.lineFor(plan, team), seat MatchPlan.benchFor(plan, team)
	  join / leave MatchPlan.join(plan, entry) / MatchPlan.leave(plan, id); apply
	  apply        set every MatchPlan.members(plan) entry's team and role, then
	               do MatchPlan.botWork(plan) (removeBot / addBot as it goes)
]]

local Rating = require(script.Parent.Rating)

local MatchPlan = {}

-- Ranked may have substitutes (more than TeamSize humans on a team) as long
-- as both lines are all human. Set false to require exactly TeamSize each.
MatchPlan.RankedBench = true

-- Which half of the -Z sideline each team's bench is on (FieldGeometry.benchSpots).
MatchPlan.BenchSign = { A = -1, B = 1 }

export type Team = string -- "A" | "B"
export type Role = string -- "Match" | "Bench"

-- Any ModeRules satisfies this.
export type Rules = {
	TeamSize: number,
	FillWithBots: boolean,
}

export type Entry = { id: number, rating: number? }

export type Member = {
	id: number,
	team: Team,
	rating: number,
	seq: number, -- arrival order, lower = earlier
	played: number, -- points picked for the line
	sat: number, -- points sat out on the bench
	lastOn: number, -- last point on the line (0 = none yet)
	onLine: boolean, -- on the field for the current point
}

export type TeamPlan = {
	humans: { number }, -- roster in arrival order (line and bench)
	line: { number }, -- humans on the field this point, in line-up order
	bots: { number }, -- bots on this team, in the order they were added
}

export type Plan = {
	teamSize: number,
	fillWithBots: boolean,
	point: number, -- the point the current line was picked for
	seq: number,
	members: { [number]: Member },
	teams: { [string]: TeamPlan },
	botTeam: { [number]: Team },
	ranked: boolean,
	roster: { [number]: Team }, -- ranked roster at the start (empty when unranked)
	leavers: { number }, -- ranked roster players who left
}

export type Options = {
	ranked: boolean?,
}

export type BotWork = {
	spawn: { [string]: number }, -- bots to spawn per team ("A"/"B")
	remove: { number }, -- bot ids to remove
}

export type TeamCounts = {
	humans: number, -- on the roster (line + bench)
	line: number, -- humans on the field this point
	bench: number,
	bots: number, -- bots registered with addBot
	botsWanted: number, -- bots the line needs (FillWithBots)
}

export type LeaveResult = {
	team: Team,
	wasOnLine: boolean,
	rankedLoss: boolean, -- a ranked roster player left: rate them as a loss
}

export type RankedEnv = {
	privateServer: boolean,
	studio: boolean,
}

export type RankedResult = {
	ranked: boolean, -- the match started as ranked
	valid: boolean, -- ranked and nobody on the roster left
	roster: { [number]: Team },
	leavers: { number },
}

local TEAMS = { "A", "B" }

function MatchPlan.other(team: Team): Team
	return if team == "A" then "B" else "A"
end

local function insertBySeq(plan: Plan, list: { number }, id: number)
	local seq = plan.members[id].seq
	for i, other in list do
		if plan.members[other].seq > seq then
			table.insert(list, i, id)
			return
		end
	end
	table.insert(list, id)
end

local function removeValue(list: { number }, id: number): boolean
	local i = table.find(list, id)
	if i then
		table.remove(list, i)
		return true
	end
	return false
end

local function ratingSum(plan: Plan, team: Team): number
	local sum = 0
	for _, id in plan.teams[team].humans do
		sum += plan.members[id].rating
	end
	return sum
end

local function addMember(plan: Plan, entry: Entry, team: Team, lastOn: number, sat: number): Member
	plan.seq += 1
	local m: Member = {
		id = entry.id,
		team = team,
		rating = Rating.ratingOf(entry),
		seq = plan.seq,
		played = 0,
		sat = sat,
		lastOn = lastOn,
		onLine = false,
	}
	plan.members[entry.id] = m
	insertBySeq(plan, plan.teams[team].humans, entry.id)
	return m
end

-- Moves one human from `from` to the other team. Prefers players who are not
-- on the field right now (`benchOnly` allows nobody else); among those, the
-- one that leaves the rating totals closest, then the latest arrival.
local function moveOne(plan: Plan, from: Team, benchOnly: boolean): boolean
	local to = MatchPlan.other(from)
	local target = (ratingSum(plan, from) - ratingSum(plan, to)) / 2
	local best: Member? = nil
	local bestScore = math.huge
	for _, id in plan.teams[from].humans do
		local m = plan.members[id]
		if not (benchOnly and m.onLine) then
			local score = math.abs(m.rating - target) + (if m.onLine then 1e6 else 0)
			if best == nil or score < bestScore or (score == bestScore and m.seq > best.seq) then
				best, bestScore = m, score
			end
		end
	end
	if best == nil then
		return false
	end
	local m = best :: Member
	removeValue(plan.teams[from].humans, m.id)
	removeValue(plan.teams[from].line, m.id)
	m.onLine = false
	m.team = to
	insertBySeq(plan, plan.teams[to].humans, m.id)
	return true
end

-- Keeps the human counts within one of each other.
local function rebalance(plan: Plan, benchOnly: boolean)
	for _ = 1, 32 do
		local a, b = #plan.teams.A.humans, #plan.teams.B.humans
		if math.abs(a - b) <= 1 then
			return
		end
		if not moveOne(plan, if a > b then "A" else "B", benchOnly) then
			return
		end
	end
end

local function pick(plan: Plan, point: number)
	rebalance(plan, false)
	plan.point = point
	for _, team in TEAMS do
		local tp = plan.teams[team]
		local order = table.clone(tp.humans)
		table.sort(order, function(x, y)
			local mx, my = plan.members[x], plan.members[y]
			-- points sat out in a row, then points sat out in total
			local sx, sy = point - 1 - mx.lastOn, point - 1 - my.lastOn
			if sx ~= sy then
				return sx > sy
			end
			if mx.sat ~= my.sat then
				return mx.sat > my.sat
			end
			return mx.seq < my.seq
		end)
		local line = {}
		for i, id in order do
			local m = plan.members[id]
			m.onLine = i <= plan.teamSize
			if m.onLine then
				m.lastOn = point
				m.played += 1
				insertBySeq(plan, line, id)
			else
				m.sat += 1
			end
		end
		tp.line = line
	end
end

-- A new plan for a match. `humans` are every non-training human; the line for
-- point 1 is picked straight away (MatchPlan.line(plan, 1) returns it).
function MatchPlan.new(rules: Rules, humans: { Entry }, opts: Options?): Plan
	local plan: Plan = {
		teamSize = math.max(1, math.floor(rules.TeamSize)),
		fillWithBots = rules.FillWithBots,
		point = 0,
		seq = 0,
		members = {},
		teams = {
			A = { humans = {}, line = {}, bots = {} },
			B = { humans = {}, line = {}, bots = {} },
		},
		botTeam = {},
		ranked = (opts and opts.ranked) == true,
		roster = {},
		leavers = {},
	}
	local byId: { [number]: Entry } = {}
	local unique: { Entry } = {}
	for _, e in humans do
		if byId[e.id] == nil then
			byId[e.id] = e
			table.insert(unique, e)
		end
	end
	local a, b = Rating.balance(unique)
	-- arrival order alternates A, B so neither team's newest player is
	-- always the strongest
	for i = 1, math.max(#a, #b) do
		if a[i] then
			addMember(plan, byId[a[i]], "A", 0, 0)
		end
		if b[i] then
			addMember(plan, byId[b[i]], "B", 0, 0)
		end
	end
	if plan.ranked then
		for id, m in plan.members do
			plan.roster[id] = m.team
		end
	end
	pick(plan, 1)
	return plan
end

-- The line for `point` (RulesEngine pointNumber, 1 = first point). Picks a
-- new line the first time a point number is asked for and returns the same
-- one after that, so calling it twice for one point is harmless. Returns the
-- humans on the field per team, in line-up order.
function MatchPlan.line(plan: Plan, point: number): { [string]: { number } }
	if point > plan.point then
		pick(plan, point)
	end
	return { A = table.clone(plan.teams.A.line), B = table.clone(plan.teams.B.line) }
end

-- A human arriving mid-match. Returns (team, role): always "Bench" until the
-- next point is picked. Someone already in the plan keeps their slot.
function MatchPlan.join(plan: Plan, entry: Entry): (Team, Role)
	local existing = plan.members[entry.id]
	if existing then
		return existing.team, if existing.onLine then "Match" else "Bench"
	end
	local a, b = #plan.teams.A.humans, #plan.teams.B.humans
	local team: Team
	if a ~= b then
		team = if a < b then "A" else "B"
	else
		team = if ratingSum(plan, "B") < ratingSum(plan, "A") then "B" else "A"
	end
	-- counted as a teammate who has sat out as little as anyone, plus the
	-- current point: picked first at the next point, then rotated like the rest
	local fewest = math.huge
	for _, id in plan.teams[team].humans do
		fewest = math.min(fewest, plan.members[id].sat)
	end
	local sat = if fewest == math.huge then 1 else fewest + 1
	addMember(plan, entry, team, math.max(0, plan.point - 1), sat)
	return team, "Bench"
end

-- A human leaving the match (left the game, or went to training). Returns
-- nil when they were not in the plan.
function MatchPlan.leave(plan: Plan, id: number): LeaveResult?
	local m = plan.members[id]
	if not m then
		return nil
	end
	local tp = plan.teams[m.team]
	removeValue(tp.humans, id)
	removeValue(tp.line, id)
	plan.members[id] = nil
	local rankedLoss = plan.ranked and plan.roster[id] ~= nil
	if rankedLoss and not table.find(plan.leavers, id) then
		table.insert(plan.leavers, id)
	end
	-- only benched players switch mid-point; anyone else waits for the next pick
	rebalance(plan, true)
	return { team = m.team, wasOnLine = m.onLine, rankedLoss = rankedLoss }
end

-- (team, role) of an actor in the plan (bots are always "Match"), or nil.
function MatchPlan.slot(plan: Plan, id: number): (Team?, Role?)
	local m = plan.members[id]
	if m then
		return m.team, if m.onLine then "Match" else "Bench"
	end
	local bt = plan.botTeam[id]
	if bt then
		return bt, "Match"
	end
	return nil, nil
end

-- Every human in the plan with their team and role, in arrival order.
function MatchPlan.members(plan: Plan): { { id: number, team: Team, role: Role } }
	local list = {}
	for _, m in plan.members do
		table.insert(list, m)
	end
	table.sort(list, function(x, y)
		return x.seq < y.seq
	end)
	local out = {}
	for _, m in list do
		table.insert(out, { id = m.id, team = m.team, role = if m.onLine then "Match" else "Bench" })
	end
	return out
end

-- Everyone on the field for `team` right now: line humans first (line-up
-- order), then the team's bots, at most TeamSize.
function MatchPlan.lineFor(plan: Plan, team: Team): { number }
	local tp = plan.teams[team]
	local out = table.clone(tp.line)
	for _, id in tp.bots do
		if #out >= plan.teamSize then
			break
		end
		table.insert(out, id)
	end
	return out
end

-- Benched humans of `team`, in arrival order.
function MatchPlan.benchFor(plan: Plan, team: Team): { number }
	local out = {}
	for _, id in plan.teams[team].humans do
		if not plan.members[id].onLine then
			table.insert(out, id)
		end
	end
	return out
end

-- (index, count) of an actor's spot in its team's line-up (lineFor order),
-- or nil when it is not on the field.
function MatchPlan.lineIndex(plan: Plan, id: number): (number?, number)
	local team = MatchPlan.slot(plan, id)
	if team == nil then
		return nil, 0
	end
	local line = MatchPlan.lineFor(plan, team)
	return table.find(line, id), #line
end

function MatchPlan.botsWanted(plan: Plan, team: Team): number
	if not plan.fillWithBots then
		return 0
	end
	return math.max(0, plan.teamSize - #plan.teams[team].line)
end

-- Record a bot TeamService spawned for `team`.
function MatchPlan.addBot(plan: Plan, team: Team, id: number)
	local old = plan.botTeam[id]
	if old then
		removeValue(plan.teams[old].bots, id)
	end
	plan.botTeam[id] = team
	table.insert(plan.teams[team].bots, id)
end

-- Forget a bot (removed by TeamService, or it vanished).
function MatchPlan.removeBot(plan: Plan, id: number)
	local team = plan.botTeam[id]
	if team then
		removeValue(plan.teams[team].bots, id)
		plan.botTeam[id] = nil
	end
end

-- What TeamService must do so the registered bots match the line: spawn
-- `spawn[team]` new bots (then addBot each) and remove the listed ids (newest
-- bots go first; then removeBot each).
function MatchPlan.botWork(plan: Plan): BotWork
	local work: BotWork = { spawn = { A = 0, B = 0 }, remove = {} }
	for _, team in TEAMS do
		local bots = plan.teams[team].bots
		local want = MatchPlan.botsWanted(plan, team)
		if #bots > want then
			for i = #bots, want + 1, -1 do
				table.insert(work.remove, bots[i])
			end
		else
			work.spawn[team] = want - #bots
		end
	end
	return work
end

function MatchPlan.counts(plan: Plan): { [string]: TeamCounts }
	local out: { [string]: TeamCounts } = {}
	for _, team in TEAMS do
		local tp = plan.teams[team]
		out[team] = {
			humans = #tp.humans,
			line = #tp.line,
			bench = #tp.humans - #tp.line,
			bots = #tp.bots,
			botsWanted = MatchPlan.botsWanted(plan, team),
		}
	end
	return out
end

-- Humans a ranked match of these rules needs (both lines all human).
function MatchPlan.rankedNeed(rules: { TeamSize: number }): number
	return 2 * math.max(1, math.floor(rules.TeamSize))
end

-- "4/6" style progress towards a ranked match, for the menu.
function MatchPlan.rankedReady(rules: { TeamSize: number }, humans: number): string
	local need = MatchPlan.rankedNeed(rules)
	return string.format("%d/%d", math.clamp(humans, 0, need), need)
end

-- Would a match of `rules` with `humans` non-training humans be ranked?
-- Returns (ranked, reason); reason is a short UI string when it is not.
function MatchPlan.rankedEligible(
	rules: { TeamSize: number, RankedEligible: boolean },
	humans: number,
	env: RankedEnv
): (boolean, string)
	if not rules.RankedEligible then
		return false, "Unranked mode"
	elseif env.studio then
		return false, "Unranked in Studio"
	elseif env.privateServer then
		return false, "Unranked in private servers"
	end
	-- the split is within one, so both lines are all human once the smaller
	-- team (floor(humans / 2)) reaches TeamSize
	local need = MatchPlan.rankedNeed(rules)
	if humans < need then
		return false, string.format("Ranked needs %d players (%d/%d)", need, humans, need)
	end
	if not MatchPlan.RankedBench and humans ~= need then
		return false, string.format("Ranked needs exactly %d players", need)
	end
	return true, "Ranked"
end

-- Ranked bookkeeping for the end of the match.
function MatchPlan.rankedResult(plan: Plan): RankedResult
	return {
		ranked = plan.ranked,
		valid = plan.ranked and #plan.leavers == 0,
		roster = table.clone(plan.roster),
		leavers = table.clone(plan.leavers),
	}
end

return MatchPlan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Rating</string>
            <string name="Source"><![CDATA[--!strict
-- Team Elo for ranked matches, level math for progression and rating-balanced
-- team splits (used by Rules/MatchPlan for every match, ranked or not). Pure.

local Shared = script.Parent.Parent
local Progression = require(Shared.Config.Progression)

local Rating = {}

function Rating.expected(ra: number, rb: number): number
	return 1 / (1 + 10 ^ ((rb - ra) / 400))
end

function Rating.teamRating(ratings: { number }): number
	if #ratings == 0 then
		return Progression.Rating.Start
	end
	local sum = 0
	for _, r in ratings do
		sum += r
	end
	return sum / #ratings
end

-- New rating for one player after a match. `won` is true/false.
-- A modest margin factor (1.0 .. 1.25) rewards decisive wins without making
-- blowouts the only way to climb.
function Rating.update(
	rating: number,
	gamesPlayed: number,
	myTeam: number,
	theirTeam: number,
	won: boolean,
	margin: number
): number
	local k = if gamesPlayed < Progression.Rating.PlacementGames then Progression.Rating.KNew else Progression.Rating.K
	local e = Rating.expected(myTeam, theirTeam)
	local s = if won then 1 else 0
	local marginFactor = 1 + math.clamp(margin, 0, 5) * 0.05
	return math.floor(rating + k * marginFactor * (s - e) + 0.5)
end

-- (level, xpIntoLevel, xpForThisLevel) from total XP.
function Rating.levelFromXp(totalXp: number): (number, number, number)
	local level = 1
	local remaining = math.max(0, totalXp)
	while level < Progression.MaxLevel do
		local need = Progression.xpForLevel(level)
		if remaining < need then
			return level, remaining, need
		end
		remaining -= need
		level += 1
	end
	return Progression.MaxLevel, 0, Progression.xpForLevel(Progression.MaxLevel)
end

export type Entry = { id: number, rating: number? }

-- An entry's rating; unrated players count as the starting rating.
function Rating.ratingOf(e: Entry): number
	return e.rating or Progression.Rating.Start
end

local ratingOf = Rating.ratingOf

-- Lobbies up to this many players are split by trying every split (a
-- Gray-code walk: one add or remove per step, 65k steps at 16 players);
-- bigger lobbies use refined greedy / alternating splits.
Rating.ExactBalanceLimit = 16

-- Single swaps across the teams while any swap narrows the gap. `r` is
-- sorted strongest first; `inA` is changed in place.
local function refine(r: { number }, inA: { boolean }, gap: (number, number) -> number): number
	local sumA, sumB = 0, 0
	for i, v in r do
		if inA[i] then
			sumA += v
		else
			sumB += v
		end
	end
	for _ = 1, #r * #r do
		local best = gap(sumA, sumB)
		local bi, bj = 0, 0
		for i, x in r do
			if inA[i] then
				for j, y in r do
					if not inA[j] then
						local g = gap(sumA + y - x, sumB - y + x)
						if g < best - 1e-9 then
							best, bi, bj = g, i, j
						end
					end
				end
			end
		end
		if bi == 0 then
			break
		end
		inA[bi], inA[bj] = false, true
		local d = r[bj] - r[bi]
		sumA += d
		sumB -= d
	end
	return gap(sumA, sumB)
end

-- Two starting splits, each refined by swaps; the closer one wins. Start 1:
-- strongest first, each to the team with the lower total that still has
-- room. Start 2: strongest first, alternating. The first team always gets
-- the extra player when the count is odd.
local function approximateSplit(r: { number }, cap: number, gap: (number, number) -> number): { boolean }
	local greedy: { boolean } = {}
	local countA, countB, sumA, sumB = 0, 0, 0, 0
	for i, v in r do
		local toA = if countA >= cap then false elseif countB >= cap then true else sumA <= sumB
		greedy[i] = toA
		if toA then
			countA += 1
			sumA += v
		else
			countB += 1
			sumB += v
		end
	end
	if countB > countA then
		for i in greedy do
			greedy[i] = not greedy[i]
		end
	end
	local alternate: { boolean } = {}
	for i in r do
		alternate[i] = i % 2 == 1
	end
	local g1 = refine(r, greedy, gap)
	local g2 = refine(r, alternate, gap)
	return if g2 < g1 - 1e-9 then alternate else greedy
end

-- Splits players into two teams whose sizes differ by at most one, with the
-- closest strength. Unrated entries count as Progression.Rating.Start.
--
-- Strength is the rating total plus `filler` for each spot the smaller team
-- is short (the bot or empty spot it plays with instead); `filler` defaults to
-- the average rating, so an odd player out is weighed as an average player.
--
-- Exact (the best possible split) up to ExactBalanceLimit players, close
-- beyond that. Deterministic: entries are ordered by rating, then id. The
-- first team returned is never the smaller one.
function Rating.balance(entries: { Entry }, filler: number?): ({ number }, { number })
	local sorted = table.clone(entries)
	table.sort(sorted, function(x, y)
		local rx, ry = ratingOf(x), ratingOf(y)
		if rx ~= ry then
			return rx > ry
		end
		return x.id < y.id
	end)
	local n = #sorted
	local cap = math.ceil(n / 2)
	local r: { number } = {}
	local total = 0
	for i, e in sorted do
		r[i] = ratingOf(e)
		total += r[i]
	end
	local fill = filler or (if n > 0 then total / n else Progression.Rating.Start)
	local short = cap - (n - cap) -- spots the second team is short: 0 or 1
	local function gap(sa: number, sb: number): number
		return math.abs(sa - (sb + short * fill))
	end

	local inA: { boolean }
	if n <= Rating.ExactBalanceLimit then
		local bestGap, bestMask = math.huge, 0
		local mask, countA, sumA = 0, 0, 0
		for step = 1, bit32.lshift(1, n) - 1 do
			local bit = bit32.countrz(step)
			local flag = bit32.lshift(1, bit)
			if bit32.btest(mask, flag) then
				mask -= flag
				countA -= 1
				sumA -= r[bit + 1]
			else
				mask += flag
				countA += 1
				sumA += r[bit + 1]
			end
			if countA == cap then
				local g = gap(sumA, total - sumA)
				if g < bestGap - 1e-9 then
					bestGap, bestMask = g, mask
				end
			end
		end
		inA = {}
		for i = 1, n do
			inA[i] = bit32.btest(bestMask, bit32.lshift(1, i - 1))
		end
	else
		inA = approximateSplit(r, cap, gap)
	end

	local idsA, idsB = {}, {}
	for i, e in sorted do
		table.insert(if inA[i] then idsA else idsB, e.id)
	end
	return idsA, idsB
end

return Rating
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">RulesEngine</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RulesEngine — the sport of ultimate as a pure state machine.

	Server services report what physically happened (a throw, a catch, a
	landing, the disc touching the ground, a stall-out) and the engine decides
	what it means: completion, interception, turnover, goal, Callahan, the
	Greatest, match point, universe point. MatchService applies the outcomes to
	the world. Keeping this pure lets the whole rulebook be unit tested
	(tests/rules_spec.luau).

	Rules implemented (beginner-readable defaults, see docs/DESIGN.md):
	  - no running with the disc (enforced by movement + server pivot check)
	  - incomplete, blocked, dropped or out-of-bounds passes are turnovers
	  - a catch counts where the receiver first touches the ground; airborne
	    receivers must have left the ground in bounds
	  - catch in the end zone you attack = goal; defender intercepting in the
	    end zone they defend = Callahan (goal)
	  - airborne receiver may release before landing (the Greatest)
	  - stall-out = turnover at the thrower's feet
	  - turnovers inside an end zone are brought to its goal line
	  - teams switch direction after every goal; scored-on team receives
	  - pulls: receiving team takes it where it stops, or at the brick if it
	    lands out; touching then dropping the pull is a turnover
	  - time cap: finish the point; leader wins, tie -> universe point
]]

local Shared = script.Parent.Parent
local FieldGeometry = require(script.Parent.FieldGeometry)
local _ = Shared

local RulesEngine = {}

export type Team = string -- "A" | "B"
export type Side = FieldGeometry.Side
export type Phase = "Idle" | "Setup" | "Pull" | "Live" | "PointOver" | "MatchOver"
export type DiscMode = "None" | "Held" | "Flight" | "Ground"

export type Config = {
	pointsToWin: number,
	usePull: boolean,
}

export type Outcome = { [string]: any }

export type Pending = {
	id: number,
	team: Team,
	interception: boolean,
	assist: number?,
	pull: boolean,
}

export type State = {
	field: FieldGeometry.Field,
	config: Config,
	phase: Phase,
	score: { [string]: number },
	attack: { [string]: Side },
	offense: Team,
	holder: number?,
	holderTeam: Team?,
	disc: DiscMode,
	discSpot: Vector3?,
	flightIsPull: boolean,
	pullTouched: boolean,
	thrower: number?,
	throwerTeam: Team?,
	lastToucherTeam: Team?,
	pending: Pending?,
	passes: number,
	pointNumber: number,
	capReached: boolean,
	universe: boolean,
	winner: Team?,
}

function RulesEngine.other(t: Team): Team
	return if t == "A" then "B" else "A"
end

function RulesEngine.new(field: FieldGeometry.Field, config: Config): State
	return {
		field = field,
		config = config,
		phase = "Idle",
		score = { A = 0, B = 0 },
		attack = { A = "East", B = "West" },
		offense = "A",
		holder = nil,
		holderTeam = nil,
		disc = "None",
		discSpot = nil,
		flightIsPull = false,
		pullTouched = false,
		thrower = nil,
		throwerTeam = nil,
		lastToucherTeam = nil,
		pending = nil,
		passes = 0,
		pointNumber = 0,
		capReached = false,
		universe = false,
		winner = nil,
	}
end

function RulesEngine.defense(e: State): Team
	return RulesEngine.other(e.offense)
end

-- The end zone a team defends (the one it lines up in).
function RulesEngine.defends(e: State, team: Team): Side
	return FieldGeometry.other(e.attack[team])
end

local function setHolder(e: State, id: number, team: Team)
	e.holder = id
	e.holderTeam = team
	e.disc = "Held"
	e.discSpot = nil
end

local function clearHolder(e: State)
	e.holder = nil
	e.holderTeam = nil
end

function RulesEngine.startMatch(e: State, firstOffense: Team, offenseAttacks: Side?)
	e.score = { A = 0, B = 0 }
	local side: Side = offenseAttacks or "East"
	e.attack[firstOffense] = side
	e.attack[RulesEngine.other(firstOffense)] = FieldGeometry.other(side)
	e.offense = firstOffense
	e.pointNumber = 0
	e.capReached = false
	e.universe = false
	e.winner = nil
	e.phase = "Idle"
end

function RulesEngine.setupPoint(e: State): Outcome
	e.phase = "Setup"
	e.pointNumber += 1
	clearHolder(e)
	e.disc = "None"
	e.discSpot = nil
	e.flightIsPull = false
	e.pullTouched = false
	e.thrower = nil
	e.throwerTeam = nil
	e.lastToucherTeam = nil
	e.pending = nil
	e.passes = 0
	local defense = RulesEngine.defense(e)
	return {
		kind = "Setup",
		offense = e.offense,
		defense = defense,
		offenseLine = RulesEngine.defends(e, e.offense),
		defenseLine = RulesEngine.defends(e, defense),
		pull = e.config.usePull,
		point = e.pointNumber,
		universe = e.universe,
	}
end

function RulesEngine.beginPull(e: State, pullerId: number)
	e.phase = "Pull"
	setHolder(e, pullerId, RulesEngine.defense(e))
end

function RulesEngine.beginLive(e: State, holderId: number?)
	e.phase = "Live"
	if holderId then
		setHolder(e, holderId, e.offense)
	end
end

local function turnover(e: State, reason: string, spot: Vector3): { Outcome }
	local newOffense = if e.throwerTeam then RulesEngine.other(e.throwerTeam :: Team) else RulesEngine.other(e.offense)
	if reason == "Stall" and e.holderTeam then
		newOffense = RulesEngine.other(e.holderTeam :: Team)
	end
	e.offense = newOffense
	clearHolder(e)
	e.disc = "Ground"
	e.discSpot = FieldGeometry.turnoverSpot(e.field, spot)
	e.pending = nil
	e.passes = 0
	e.flightIsPull = false
	return { { kind = "Turnover", reason = reason, team = newOffense, spot = e.discSpot } }
end

local function scoreGoal(e: State, team: Team, scorer: number, assist: number?, callahan: boolean): { Outcome }
	local outcomes: { Outcome } = {}
	e.score[team] += 1
	e.phase = "PointOver"
	clearHolder(e)
	e.disc = "None"
	e.pending = nil
	table.insert(outcomes, {
		kind = "Goal",
		team = team,
		scorer = scorer,
		assist = if callahan then nil else assist,
		callahan = callahan,
		passes = e.passes,
		score = { A = e.score.A, B = e.score.B },
		universe = e.universe,
	})
	-- next point: scored-on team receives, both teams switch direction
	e.offense = RulesEngine.other(team)
	e.attack.A, e.attack.B = e.attack.B, e.attack.A

	local other = RulesEngine.other(team)
	local over = false
	if e.score[team] >= e.config.pointsToWin or e.universe then
		over = true
	elseif e.capReached then
		if e.score[team] ~= e.score[other] then
			over = true
		else
			e.universe = true
			table.insert(outcomes, { kind = "UniversePoint" })
		end
	elseif e.score[team] == e.config.pointsToWin - 1 and e.score[other] == e.config.pointsToWin - 1 then
		e.universe = true
		table.insert(outcomes, { kind = "UniversePoint" })
	end
	if over then
		local winner: Team = if e.score.A > e.score.B then "A" else "B"
		e.winner = winner
		e.phase = "MatchOver"
		table.insert(outcomes, { kind = "MatchOver", winner = winner, score = { A = e.score.A, B = e.score.B } })
	end
	return outcomes
end

local function checkGoal(
	e: State,
	id: number,
	team: Team,
	pos: Vector3,
	interception: boolean,
	assist: number?
): { Outcome }
	local f = e.field
	if interception and e.throwerTeam and FieldGeometry.inEndZone(f, pos, e.attack[e.throwerTeam :: Team]) then
		return scoreGoal(e, team, id, nil, true)
	end
	if FieldGeometry.inEndZone(f, pos, e.attack[team]) then
		return scoreGoal(e, team, id, assist, false)
	end
	return {}
end

-- The holder released the disc. `pos` is the thrower's position at release.
function RulesEngine.throw(e: State, id: number, pos: Vector3): { Outcome }
	if e.holder ~= id or e.disc ~= "Held" then
		return {}
	end
	local outcomes: { Outcome } = {}
	local team = e.holderTeam :: Team
	if e.phase == "Pull" then
		e.flightIsPull = true
		e.pullTouched = false
		e.phase = "Live"
		e.offense = RulesEngine.other(team)
		table.insert(outcomes, { kind = "PullReleased", id = id })
	elseif e.phase ~= "Live" then
		return {}
	end
	local pending = e.pending
	if pending and pending.id == id then
		if not FieldGeometry.inBounds(e.field, pos) then
			table.insert(outcomes, { kind = "Greatest", id = id })
		end
		e.pending = nil
	end
	clearHolder(e)
	e.disc = "Flight"
	e.thrower = id
	e.throwerTeam = team
	e.lastToucherTeam = nil
	table.insert(outcomes, { kind = "Thrown", id = id, team = team, pull = e.flightIsPull })
	return outcomes
end

-- A player touched the disc without securing it (block, tip, bobble).
function RulesEngine.touch(e: State, id: number, team: Team): { Outcome }
	if e.disc ~= "Flight" then
		return {}
	end
	e.lastToucherTeam = team
	if e.flightIsPull then
		if team == e.offense then
			e.pullTouched = true
		end
		return {}
	end
	if team ~= e.throwerTeam then
		return { { kind = "Block", id = id, team = team, thrower = e.thrower } }
	end
	return { { kind = "Tip", id = id, team = team } }
end

-- A player secured the disc. `grounded` = feet on the ground at the catch;
-- `jumpOrigin` = where an airborne catcher last left the ground.
function RulesEngine.catch(
	e: State,
	id: number,
	team: Team,
	pos: Vector3,
	grounded: boolean,
	jumpOrigin: Vector3?
): { Outcome }
	if e.disc ~= "Flight" or e.phase ~= "Live" then
		return {}
	end
	local f = e.field
	local outcomes: { Outcome } = {}

	if e.flightIsPull then
		if team ~= e.offense then
			return {}
		end
		e.flightIsPull = false
		setHolder(e, id, team)
		table.insert(outcomes, { kind = "PullCaught", id = id, team = team })
		if not grounded then
			e.pending = { id = id, team = team, interception = false, assist = nil, pull = true }
		elseif not FieldGeometry.inBounds(f, pos) then
			e.discSpot = FieldGeometry.turnoverSpot(f, pos)
			table.insert(outcomes, { kind = "Relocate", id = id, spot = e.discSpot })
		end
		return outcomes
	end

	-- an airborne catcher who jumped from out of bounds is out of bounds
	if not grounded and jumpOrigin and not FieldGeometry.inBounds(f, jumpOrigin) then
		return turnover(e, "OutOfBounds", pos)
	end
	if grounded and not FieldGeometry.inBounds(f, pos) then
		return turnover(e, "OutOfBounds", pos)
	end

	local interception = team ~= e.throwerTeam
	local assist = e.thrower
	setHolder(e, id, team)
	if interception then
		e.offense = team
		e.passes = 0
		table.insert(outcomes, { kind = "Interception", id = id, team = team, thrower = assist })
	else
		e.passes += 1
		table.insert(outcomes, { kind = "Completion", id = id, team = team, from = assist, passes = e.passes })
	end

	if grounded then
		for _, o in checkGoal(e, id, team, pos, interception, assist) do
			table.insert(outcomes, o)
		end
	else
		e.pending = { id = id, team = team, interception = interception, assist = assist, pull = false }
	end
	return outcomes
end

-- An airborne catcher touched down.
function RulesEngine.land(e: State, id: number, pos: Vector3): { Outcome }
	local p = e.pending
	if p == nil or p.id ~= id or e.holder ~= id then
		return {}
	end
	e.pending = nil
	local f = e.field
	if not FieldGeometry.inBounds(f, pos) then
		if p.pull then
			e.discSpot = FieldGeometry.turnoverSpot(f, pos)
			return { { kind = "Relocate", id = id, spot = e.discSpot } }
		end
		return turnover(e, "OutOfBounds", pos)
	end
	if p.pull then
		return {}
	end
	return checkGoal(e, id, p.team, pos, p.interception, p.assist)
end

-- The disc touched the ground (or left the playable area) without a catch.
function RulesEngine.ground(e: State, landPos: Vector3, exitPos: Vector3?): { Outcome }
	if e.disc ~= "Flight" then
		return {}
	end
	local f = e.field
	local out = not FieldGeometry.inBounds(f, landPos)
	if e.flightIsPull then
		e.flightIsPull = false
		if e.pullTouched then
			e.throwerTeam = e.offense -- the receiving team touched it last; it changes hands
			return turnover(e, "Drop", landPos)
		end
		clearHolder(e)
		e.disc = "Ground"
		local brick = false
		if out then
			e.discSpot = FieldGeometry.brickPoint(f, RulesEngine.defends(e, e.offense))
			brick = true
		else
			e.discSpot = FieldGeometry.turnoverSpot(f, landPos)
		end
		return { { kind = "PullLanded", spot = e.discSpot, brick = brick } }
	end
	local reason: string
	if out then
		reason = "OutOfBounds"
	elseif e.lastToucherTeam ~= nil and e.lastToucherTeam == e.throwerTeam then
		reason = "Drop"
	elseif e.lastToucherTeam ~= nil then
		reason = "Block"
	else
		reason = "Incomplete"
	end
	local spot = if out then (exitPos or landPos) else landPos
	return turnover(e, reason, spot)
end

function RulesEngine.pickup(e: State, id: number, team: Team): { Outcome }
	if e.disc ~= "Ground" or team ~= e.offense or e.phase ~= "Live" then
		return {}
	end
	local spot = e.discSpot
	setHolder(e, id, team)
	e.thrower = nil
	return { { kind = "Pickup", id = id, team = team, spot = spot } }
end

function RulesEngine.stall(e: State, pos: Vector3): { Outcome }
	if e.disc ~= "Held" or e.phase ~= "Live" or e.holder == nil then
		return {}
	end
	return turnover(e, "Stall", pos)
end

-- The holder vanished (left the game). Their team keeps possession at the spot.
function RulesEngine.holderLeft(e: State, pos: Vector3): { Outcome }
	if e.disc ~= "Held" then
		return {}
	end
	clearHolder(e)
	e.pending = nil
	e.disc = "Ground"
	e.discSpot = FieldGeometry.turnoverSpot(e.field, pos)
	return { { kind = "DiscDropped", spot = e.discSpot } }
end

function RulesEngine.reachCap(e: State): { Outcome }
	if e.capReached then
		return {}
	end
	e.capReached = true
	local outcomes: { Outcome } = { { kind = "CapReached" } }
	if e.phase == "PointOver" or e.phase == "Setup" or e.phase == "Idle" then
		if e.score.A ~= e.score.B then
			local winner: Team = if e.score.A > e.score.B then "A" else "B"
			e.winner = winner
			e.phase = "MatchOver"
			table.insert(outcomes, { kind = "MatchOver", winner = winner, score = { A = e.score.A, B = e.score.B } })
		else
			e.universe = true
			table.insert(outcomes, { kind = "UniversePoint" })
		end
	end
	return outcomes
end

return RulesEngine
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic xorshift32 generator. Used wherever a sequence must be
-- reproducible (training drills, bot personalities, fuzz tests). Gameplay
-- outcomes never use randomness.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { state: number }, Rng))

function Rng.new(seed: number): Rng
	local s = bit32.band(math.floor(math.abs(seed)), 0xFFFFFFFF)
	if s == 0 then
		s = 0x9E3779B9
	end
	return setmetatable({ state = s }, Rng)
end

function Rng.nextInt32(self: Rng): number
	local x = self.state
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self.state = x
	return x
end

-- Uniform in [0, 1).
function Rng.next(self: Rng): number
	return self:nextInt32() / 4294967296
end

function Rng.range(self: Rng, a: number, b: number): number
	return a + (b - a) * self:next()
end

function Rng.int(self: Rng, a: number, b: number): number
	return math.min(b, a + math.floor(self:next() * (b - a + 1)))
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal synchronous signal for communication between services/controllers.

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> (), connected: boolean }
export type Signal = typeof(setmetatable({} :: { handlers: { (...any) -> () } }, Signal))

function Signal.new(): Signal
	return setmetatable({ handlers = {} }, Signal)
end

function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
	table.insert(self.handlers, fn)
	local conn = { connected = true } :: any
	function conn.Disconnect(c)
		if not c.connected then
			return
		end
		c.connected = false
		local i = table.find(self.handlers, fn)
		if i then
			table.remove(self.handlers, i)
		end
	end
	return conn
end

function Signal.Fire(self: Signal, ...: any)
	for _, fn in table.clone(self.handlers) do
		local args = table.pack(...)
		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[Signal] handler error: " .. tostring(err))
		end
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">VecMath</string>
            <string name="Source"><![CDATA[--!strict
-- Small, allocation-light vector helpers shared by movement, catching and AI.
-- Everything here is pure math so it runs identically on client, server and in
-- the offline Lune test harness.

local VecMath = {}

local EPS = 1e-6

function VecMath.flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function VecMath.flatUnit(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	local m = f.Magnitude
	if m < EPS then
		return Vector3.zero
	end
	return f / m
end

function VecMath.safeUnit(v: Vector3, fallback: Vector3?): Vector3
	local m = v.Magnitude
	if m < EPS then
		return fallback or Vector3.zero
	end
	return v / m
end

function VecMath.clampMagnitude(v: Vector3, maxLen: number): Vector3
	local m = v.Magnitude
	if m > maxLen and m > EPS then
		return v * (maxLen / m)
	end
	return v
end

-- Moves vector `from` toward `to` by at most `maxDelta` (length of change).
function VecMath.moveToward(from: Vector3, to: Vector3, maxDelta: number): Vector3
	local d = to - from
	local m = d.Magnitude
	if m <= maxDelta or m < EPS then
		return to
	end
	return from + d * (maxDelta / m)
end

-- Unsigned angle between two horizontal directions, in degrees (0..180).
function VecMath.flatAngle(a: Vector3, b: Vector3): number
	local ax, az = a.X, a.Z
	local bx, bz = b.X, b.Z
	local dot = ax * bx + az * bz
	local cross = ax * bz - az * bx
	return math.deg(math.abs(math.atan2(cross, dot)))
end

-- Signed yaw (radians) of a horizontal direction; 0 = -Z (Roblox forward).
function VecMath.yaw(v: Vector3): number
	return math.atan2(-v.X, -v.Z)
end

function VecMath.fromYaw(yaw: number): Vector3
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

-- Rotates horizontal unit vector `dir` toward horizontal unit vector `target`
-- by at most `maxDeg` degrees. Returns a horizontal unit vector.
function VecMath.rotateToward(dir: Vector3, target: Vector3, maxDeg: number): Vector3
	local a = VecMath.yaw(dir)
	local b = VecMath.yaw(target)
	local diff = (b - a + math.pi) % (2 * math.pi) - math.pi
	local maxRad = math.rad(maxDeg)
	if math.abs(diff) <= maxRad then
		return VecMath.fromYaw(b)
	end
	return VecMath.fromYaw(a + math.sign(diff) * maxRad)
end

-- Reflects horizontal velocity off a (horizontal) wall normal.
function VecMath.reflect(v: Vector3, normal: Vector3): Vector3
	return v - normal * (2 * v:Dot(normal))
end

-- Closest point on segment [a, b] to point p.
function VecMath.closestOnSegment(a: Vector3, b: Vector3, p: Vector3): Vector3
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < EPS then
		return a
	end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return a + ab * t
end

function VecMath.lerpNumber(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Frame-rate independent exponential smoothing factor.
function VecMath.smoothAlpha(rate: number, dt: number): number
	return 1 - math.exp(-rate * dt)
end

return VecMath
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="34">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="35">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Arena</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ArenaBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ArenaBuilder — procedurally builds the field and its surroundings.

	The playing surface follows the mode (Config/Modes.Fields: Mini 3v3 or
	Normal 7v7) and is the same in every arena, so spacing and muscle memory
	carry over; only the theme, lighting, wind and optional rebound walls
	change. Theme dressing (stands, lights, trees, skyline, crowd) is laid out
	relative to the field size, the big Normal field gets a scoreboard at each
	end, and every theme has a team bench on each half of the -Z sideline
	(FieldGeometry.benchCenter, team A west / B east as MatchPlan.BenchSign),
	returned in Built.benches for the substitutes' teleports.
	Everything is generated from code, so the place file needs no hand-built
	geometry and every arena can be rebuilt between matches.

	Decorations are CanQuery = false so client ground/wall raycasts only ever
	see the field, the out-of-bounds surround and tagged Rebound walls.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rng = require(Shared.Util.Rng)
local FieldGeometry = require(Shared.Rules.FieldGeometry)
local MatchPlan = require(Shared.Rules.MatchPlan)
local TeamsConfig = require(Shared.Config.Teams)
local Build = require(script.Parent.Build)

local ArenaBuilder = {}

export type FieldSpec = { width: number, length: number, endZone: number, brick: number }

export type Built = {
	model: Model,
	endZones: { [string]: BasePart },
	spawn: SpawnLocation,
	margin: number,
	benches: { [string]: CFrame }, -- team -> centre of its bench spots, facing the field
}

local MARGIN = 34
-- Dressing that used to be laid out for a 270-stud field scales from here.
local BASE_HALF_TOTAL = 135
local WHITE = Color3.fromRGB(250, 250, 250)
local CONE = Color3.fromRGB(255, 110, 20)

local SKIN = {
	Color3.fromRGB(255, 220, 190),
	Color3.fromRGB(234, 184, 146),
	Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(141, 92, 62),
	Color3.fromRGB(96, 62, 42),
}

local SHIRTS = {
	Color3.fromRGB(32, 140, 255),
	Color3.fromRGB(255, 120, 30),
	Color3.fromRGB(240, 240, 240),
	Color3.fromRGB(40, 40, 50),
	Color3.fromRGB(220, 60, 70),
	Color3.fromRGB(60, 190, 120),
	Color3.fromRGB(250, 210, 60),
	Color3.fromRGB(120, 90, 220),
}

local function pick<T>(rng: Rng.Rng, list: { T }): T
	return list[rng:int(1, #list)]
end

-- Half the total length (playing field + both end zones).
local function halfTotal(f: FieldSpec): number
	return f.length / 2 + f.endZone
end

-- How much bigger than the original field this one is (never below 1).
local function dressScale(f: FieldSpec): number
	return math.max(1, halfTotal(f) / BASE_HALF_TOTAL)
end

-- The big (Normal) field gets a scoreboard at each end.
local function bigField(f: FieldSpec): boolean
	return 2 * halfTotal(f) >= 300
end

---------------------------------------------------------------------------
-- lighting
---------------------------------------------------------------------------

local function applyLighting(arena: any)
	for k, v in arena.Lighting do
		pcall(function()
			(Lighting :: any)[k] = v
		end)
	end
	local function effect(className: string, name: string, props: { [string]: any })
		local e = Lighting:FindFirstChild(name)
		if not e then
			e = Instance.new(className)
			e.Name = name
			e.Parent = Lighting
		end
		for k, v in props do
			pcall(function()
				(e :: any)[k] = v
			end)
		end
	end
	effect("Atmosphere", "UBAtmosphere", arena.Atmosphere)
	effect("ColorCorrectionEffect", "UBColor", arena.ColorCorrection)
	effect("BloomEffect", "UBBloom", arena.Bloom)
	effect("SunRaysEffect", "UBSunRays", { Intensity = if arena.Theme == "Coastal" then 0.12 else 0.04, Spread = 0.6 })
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	local s = sky :: Sky
	s.StarCount = if arena.Theme == "Rooftop" or arena.Theme == "Stadium" then 3000 else 600
	s.CelestialBodiesShown = arena.Theme ~= "Indoor"
end

---------------------------------------------------------------------------
-- the field itself
---------------------------------------------------------------------------

local function buildField(model: Model, arena: any, f: FieldSpec): { [string]: BasePart }
	local L = f.length / 2
	local E = f.endZone
	local W = f.width / 2
	local HL = L + E
	local fieldFolder = Build.folder(model, "Field")

	-- out-of-bounds surround (walkable)
	Build.part(fieldFolder, {
		Name = "Surround",
		Size = Vector3.new(2 * HL + 2 * MARGIN + 220, 1, 2 * W + 2 * MARGIN + 200),
		CFrame = CFrame.new(0, -0.5, 0),
		Material = arena.Surround.Material,
		Color = arena.Surround.Color,
		solid = true,
	})

	-- mowed stripes
	local stripeW = 20
	local count = math.ceil((2 * HL + 24) / stripeW)
	local startX = -count * stripeW / 2
	for i = 0, count - 1 do
		Build.part(fieldFolder, {
			Name = "Turf",
			Size = Vector3.new(stripeW, 0.2, 2 * W + 16),
			CFrame = CFrame.new(startX + stripeW * (i + 0.5), -0.08, 0),
			Material = arena.Ground.Material,
			Color = if i % 2 == 0 then arena.Ground.A else arena.Ground.B,
			solid = true,
		})
	end

	local lineMat = if arena.Theme == "Rooftop" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local lineColor = arena.LineColor or WHITE
	local function line(name: string, size: Vector3, cf: CFrame)
		Build.part(fieldFolder, {
			Name = name,
			Size = size,
			CFrame = cf,
			Color = lineColor,
			Material = lineMat,
		})
	end
	local y = 0.035
	line("Sideline", Vector3.new(2 * HL, 0.05, 0.6), CFrame.new(0, y, W))
	line("Sideline", Vector3.new(2 * HL, 0.05, 0.6), CFrame.new(0, y, -W))
	line("EndLine", Vector3.new(0.6, 0.05, 2 * W), CFrame.new(HL, y, 0))
	line("EndLine", Vector3.new(0.6, 0.05, 2 * W), CFrame.new(-HL, y, 0))
	line("GoalLine", Vector3.new(0.8, 0.05, 2 * W), CFrame.new(L, y, 0))
	line("GoalLine", Vector3.new(0.8, 0.05, 2 * W), CFrame.new(-L, y, 0))
	for x = -L + 20, L - 20, 20 do
		line("Hash", Vector3.new(0.4, 0.05, 2.5), CFrame.new(x, y, W - 4))
		line("Hash", Vector3.new(0.4, 0.05, 2.5), CFrame.new(x, y, -(W - 4)))
	end
	for _, sx in { 1, -1 } do
		local bx = sx * (L - f.brick)
		line("Brick", Vector3.new(3.4, 0.05, 0.5), CFrame.new(bx, y, 0) * CFrame.Angles(0, math.rad(45), 0))
		line("Brick", Vector3.new(3.4, 0.05, 0.5), CFrame.new(bx, y, 0) * CFrame.Angles(0, math.rad(-45), 0))
	end

	-- centre logo
	local logo = Build.part(fieldFolder, {
		Name = "Logo",
		Size = Vector3.new(46, 0.02, 12),
		CFrame = CFrame.new(0, 0.045, 0),
		Transparency = 1,
	})
	Build.topText(logo, "BREAKPOINT", lineColor, 0.55)

	-- end zone overlays (recoloured each point by MatchService)
	local endZones: { [string]: BasePart } = {}
	for _, side in { "East", "West" } do
		local sx = if side == "East" then 1 else -1
		local ez = Build.part(fieldFolder, {
			Name = "EndZone" .. side,
			Size = Vector3.new(E - 0.8, 0.04, 2 * W - 0.6),
			CFrame = CFrame.new(sx * (L + E / 2), 0.03, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(200, 200, 210),
			Transparency = 0.86,
		})
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Label"
		gui.Face = Enum.NormalId.Top
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 12
		gui.LightInfluence = 0.4
		gui.Parent = ez
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.BackgroundTransparency = 1
		text.Size = UDim2.fromScale(1, 0.5)
		text.Position = UDim2.fromScale(0, 0.25)
		text.Rotation = if side == "East" then -90 else 90
		text.Font = Enum.Font.GothamBlack
		text.TextScaled = true
		text.TextTransparency = 0.45
		text.TextColor3 = Color3.new(1, 1, 1)
		text.Text = ""
		text.Parent = gui
		CollectionService:AddTag(ez, "UBEndZone")
		ez:SetAttribute("Side", side)
		endZones[side] = ez
	end

	-- pylons
	for _, cx in { L, -L, HL, -HL } do
		for _, cz in { W, -W } do
			Build.part(fieldFolder, {
				Name = "Cone",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.8, 1.3, 1.3),
				CFrame = CFrame.new(cx, 0.9, cz) * CFrame.Angles(0, 0, math.rad(90)),
				Color = CONE,
				Material = Enum.Material.Neon,
			})
		end
	end

	-- invisible boundary
	local wallH = 60
	local walls = Build.folder(model, "Bounds")
	for _, sx in { 1, -1 } do
		Build.part(walls, {
			Name = "BoundX",
			Size = Vector3.new(2, wallH, 2 * W + 2 * MARGIN + 4),
			CFrame = CFrame.new(sx * (HL + MARGIN), wallH / 2, 0),
			Transparency = 1,
			solid = true,
		})
		Build.part(walls, {
			Name = "BoundZ",
			Size = Vector3.new(2 * HL + 2 * MARGIN + 4, wallH, 2),
			CFrame = CFrame.new(0, wallH / 2, sx * (W + MARGIN)),
			Transparency = 1,
			solid = true,
		})
	end
	Build.part(walls, {
		Name = "Ceiling",
		Size = Vector3.new(2 * HL + 2 * MARGIN + 4, 2, 2 * W + 2 * MARGIN + 4),
		CFrame = CFrame.new(0, wallH + 1, 0),
		Transparency = 1,
		solid = true,
	})

	if arena.Rebound then
		for i, sz in { 1, -1 } do
			local wall = Build.part(walls, {
				Name = "Rebound" .. i,
				Size = Vector3.new(2 * L, 18, 1),
				CFrame = CFrame.new(0, 9, sz * (W + 7)),
				Material = Enum.Material.Neon,
				Color = arena.LineColor,
				Transparency = 0.55,
				solid = true,
			})
			CollectionService:AddTag(wall, "Rebound")
		end
	end
	return endZones
end

---------------------------------------------------------------------------
-- surroundings
---------------------------------------------------------------------------

local function crowdFigure(parent: Instance, rng: Rng.Rng, pos: Vector3, facing: Vector3)
	local fan = Instance.new("Model")
	fan.Name = "Fan"
	local cf = CFrame.lookAt(pos, pos + facing)
	local torso = Build.part(fan, {
		Name = "Torso",
		Size = Vector3.new(1.5, 1.8, 0.9),
		CFrame = cf * CFrame.new(0, 0.9, 0),
		Color = pick(rng, SHIRTS),
	})
	Build.part(fan, {
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = cf * CFrame.new(0, 2.35, 0),
		Color = pick(rng, SKIN),
	})
	fan.PrimaryPart = torso
	fan:SetAttribute("Phase", rng:next() * 6.28)
	CollectionService:AddTag(fan, "UBCrowd")
	fan.Parent = parent
end

-- Stepped stand along one side. axis = "Z" (sideline) or "X" (end).
local function stand(
	parent: Instance,
	rng: Rng.Rng,
	center: Vector3,
	length: number,
	outward: Vector3,
	rows: number,
	crowd: number,
	color: Color3,
	fanBudget: { n: number }
)
	local m = Build.model(parent, "Stand")
	local along = Vector3.new(-outward.Z, 0, outward.X)
	local rowDepth, rowRise = 3, 2
	for r = 0, rows - 1 do
		local h = rowRise * (r + 1)
		local c = center + outward * (r * rowDepth + rowDepth / 2) + Vector3.new(0, h / 2, 0)
		Build.part(m, {
			Name = "Tier",
			Size = Vector3.new(length, h, rowDepth),
			CFrame = CFrame.lookAt(c, c + outward),
			Color = if r % 2 == 0 then color else color:Lerp(Color3.new(0, 0, 0), 0.15),
			Material = Enum.Material.Concrete,
			CastShadow = true,
		})
		local seatTop = center + outward * (r * rowDepth + rowDepth / 2) + Vector3.new(0, h, 0)
		for s = -length / 2 + 2, length / 2 - 2, 3 do
			if fanBudget.n > 0 and rng:next() < crowd then
				fanBudget.n -= 1
				crowdFigure(m, rng, seatTop + along * (s + rng:range(-0.4, 0.4)), -outward)
			end
		end
	end
	-- back wall and roof edge
	local back = center + outward * (rows * rowDepth + 1) + Vector3.new(0, rows * rowRise / 2 + 3, 0)
	Build.part(m, {
		Name = "BackWall",
		Size = Vector3.new(length, rows * rowRise + 6, 2),
		CFrame = CFrame.lookAt(back, back + outward),
		Color = color:Lerp(Color3.new(0, 0, 0), 0.35),
		Material = Enum.Material.Concrete,
	})
	return m
end

local function floodlights(parent: Instance, f: FieldSpec, brightness: number, color: Color3)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local rig = Build.folder(parent, "Floodlights")
	for x = -L + 20, L - 20, 55 do
		for _, z in { -W * 0.5, W * 0.5 } do
			local p = Build.part(rig, {
				Name = "Lamp",
				Size = Vector3.new(1, 1, 1),
				CFrame = CFrame.new(x, 52, z),
				Transparency = 1,
			})
			Build.light(p, "SpotLight", {
				Face = Enum.NormalId.Bottom,
				Range = 60,
				Angle = 130,
				Brightness = brightness,
				Color = color,
				Shadows = false,
			})
		end
	end
	-- towers (visual) at the corners
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			local base = Vector3.new(sx * (L + MARGIN + 18), 0, sz * (W + MARGIN + 24))
			Build.part(rig, {
				Name = "Pole",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(80, 2.4, 2.4),
				CFrame = CFrame.new(base + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(150, 155, 165),
				Material = Enum.Material.Metal,
			})
			local headPos = base + Vector3.new(0, 82, 0)
			local head = Build.part(rig, {
				Name = "LampHead",
				Size = Vector3.new(18, 8, 2),
				CFrame = CFrame.lookAt(headPos, Vector3.new(0, 0, 0)),
				Color = Color3.fromRGB(255, 250, 235),
				Material = Enum.Material.Neon,
			})
			Build.light(head, "SpotLight", {
				Face = Enum.NormalId.Front,
				Range = 60,
				Angle = 70,
				Brightness = 3,
				Color = color,
				Shadows = false,
			})
		end
	end
end

local function scoreboard(parent: Instance, pos: Vector3, facing: Vector3)
	local board = Build.part(parent, {
		Name = "Scoreboard",
		Size = Vector3.new(56, 20, 2),
		CFrame = CFrame.lookAt(pos, pos + facing),
		Color = Color3.fromRGB(14, 16, 22),
	})
	Build.part(parent, {
		Name = "ScoreboardFrame",
		Size = Vector3.new(58, 22, 1),
		CFrame = CFrame.lookAt(pos - facing * 0.8, pos + facing),
		Color = Color3.fromRGB(90, 230, 255),
		Material = Enum.Material.Neon,
	})
	Build.part(parent, {
		Name = "ScoreboardLeg",
		Size = Vector3.new(3, pos.Y, 3),
		CFrame = CFrame.new(pos.X - facing.X * 2, pos.Y / 2, pos.Z - facing.Z * 2),
		Color = Color3.fromRGB(60, 62, 70),
		Material = Enum.Material.Metal,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.Parent = board
	local function label(name: string, x: number, w: number, y: number, h: number, text: string, color: Color3)
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(x, y)
		t.Size = UDim2.fromScale(w, h)
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.TextColor3 = color
		t.Text = text
		t.Parent = gui
	end
	label("TeamA", 0.02, 0.3, 0.06, 0.25, "TIDE", Color3.fromRGB(32, 140, 255))
	label("TeamB", 0.68, 0.3, 0.06, 0.25, "BLAZE", Color3.fromRGB(255, 120, 30))
	label("ScoreA", 0.02, 0.3, 0.32, 0.55, "0", Color3.new(1, 1, 1))
	label("ScoreB", 0.68, 0.3, 0.32, 0.55, "0", Color3.new(1, 1, 1))
	label("Clock", 0.34, 0.32, 0.12, 0.3, "8:00", Color3.fromRGB(255, 220, 90))
	label("Phase", 0.34, 0.32, 0.48, 0.18, "WARMUP", Color3.fromRGB(190, 200, 215))
	label("Info", 0.34, 0.32, 0.7, 0.16, "", Color3.fromRGB(150, 160, 175))
	CollectionService:AddTag(board, "UBScoreboard")
end

local function palm(parent: Instance, rng: Rng.Rng, pos: Vector3)
	local m = Build.model(parent, "Palm")
	local height = rng:range(16, 26)
	local lean = rng:range(-0.25, 0.25)
	local segments = 6
	local top = pos
	for i = 1, segments do
		local a = pos + Vector3.new(lean * (i - 1) * height / segments, (i - 1) * height / segments, 0)
		local b = pos + Vector3.new(lean * i * height / segments, i * height / segments, 0)
		local mid = (a + b) / 2
		Build.part(m, {
			Name = "Trunk",
			Size = Vector3.new(1.2 - i * 0.08, (b - a).Magnitude + 0.2, 1.2 - i * 0.08),
			CFrame = CFrame.lookAt(mid, b) * CFrame.Angles(math.rad(90), 0, 0),
			Color = Color3.fromRGB(130, 96, 60),
			Material = Enum.Material.Wood,
		})
		top = b
	end
	for k = 0, 6 do
		local ang = k / 7 * math.pi * 2
		local dir = Vector3.new(math.cos(ang), -0.35, math.sin(ang)).Unit
		local c = top + dir * 4
		Build.part(m, {
			Name = "Frond",
			Size = Vector3.new(1.6, 0.2, 8),
			CFrame = CFrame.lookAt(c, c + dir),
			Color = Color3.fromRGB(60, 150, 70),
			Material = Enum.Material.Grass,
		})
	end
end

local function tree(parent: Instance, rng: Rng.Rng, pos: Vector3)
	local m = Build.model(parent, "Tree")
	local h = rng:range(10, 16)
	Build.part(m, {
		Name = "Trunk",
		Size = Vector3.new(1.6, h, 1.6),
		CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)),
		Color = Color3.fromRGB(110, 80, 52),
		Material = Enum.Material.Wood,
	})
	for _ = 1, 3 do
		local s = rng:range(7, 11)
		Build.part(m, {
			Name = "Canopy",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s, s),
			CFrame = CFrame.new(pos + Vector3.new(rng:range(-2.5, 2.5), h + rng:range(-1, 2.5), rng:range(-2.5, 2.5))),
			Color = Color3.fromRGB(70 + rng:int(0, 30), 130 + rng:int(0, 40), 60),
			Material = Enum.Material.Grass,
		})
	end
end

local function windFlags(parent: Instance, f: FieldSpec, wind: Vector3)
	if wind.Magnitude < 0.1 then
		return
	end
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local dir = Vector3.new(wind.X, 0, wind.Z).Unit
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			local base = Vector3.new(sx * (L + 6), 0, sz * (W + 6))
			Build.part(parent, {
				Name = "FlagPole",
				Size = Vector3.new(0.4, 14, 0.4),
				CFrame = CFrame.new(base + Vector3.new(0, 7, 0)),
				Color = Color3.fromRGB(220, 220, 225),
				Material = Enum.Material.Metal,
			})
			local fc = base + Vector3.new(0, 12.6, 0) + dir * 2.2
			local flag = Build.part(parent, {
				Name = "Flag",
				Size = Vector3.new(0.1, 2.4, 4.2),
				CFrame = CFrame.lookAt(fc, fc + dir) * CFrame.Angles(0, math.rad(90), 0),
				Color = Color3.fromRGB(255, 90, 60),
			})
			flag:SetAttribute("Strength", wind.Magnitude)
			CollectionService:AddTag(flag, "UBFlag")
		end
	end
end

local function themeStadium(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	local budget = { n = math.floor(320 * arena.Crowd * dressScale(f)) }
	local color = Color3.fromRGB(58, 62, 74)
	stand(
		props,
		rng,
		Vector3.new(0, 0, W + MARGIN + 2),
		2 * L,
		Vector3.new(0, 0, 1),
		9,
		0.75 * arena.Crowd,
		color,
		budget
	)
	stand(
		props,
		rng,
		Vector3.new(0, 0, -(W + MARGIN + 2)),
		2 * L,
		Vector3.new(0, 0, -1),
		9,
		0.75 * arena.Crowd,
		color,
		budget
	)
	stand(
		props,
		rng,
		Vector3.new(L + MARGIN + 2, 0, 0),
		2 * W + 20,
		Vector3.new(1, 0, 0),
		6,
		0.6 * arena.Crowd,
		color,
		budget
	)
	floodlights(props, f, 1.4, Color3.fromRGB(255, 248, 230))
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 26, 0), Vector3.new(1, 0, 0))
	if bigField(f) then
		-- above and behind the +X end stand
		scoreboard(props, Vector3.new(L + MARGIN + 30, 34, 0), Vector3.new(-1, 0, 0))
	end
end

local function themeCoastal(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	local budget = { n = math.floor(200 * arena.Crowd) }
	stand(
		props,
		rng,
		Vector3.new(0, 0, -(W + MARGIN + 2)),
		2 * L * 0.7,
		Vector3.new(0, 0, -1),
		5,
		0.7,
		Color3.fromRGB(220, 220, 225),
		budget
	)
	-- the sea beyond the far sideline
	workspace.Terrain:FillBlock(
		CFrame.new(0, -6, W + MARGIN + 160),
		Vector3.new(2 * L + 900, 12, 260),
		Enum.Material.Water
	)
	workspace.Terrain:FillBlock(CFrame.new(0, -9, W + MARGIN + 30), Vector3.new(2 * L + 900, 6, 60), Enum.Material.Sand)
	for x = -L - 40, L + 40, 26 do
		palm(props, rng, Vector3.new(x + rng:range(-6, 6), 0, W + MARGIN + rng:range(8, 20)))
	end
	-- lifeguard tower
	local base = Vector3.new(L + MARGIN + 30, 0, W + MARGIN + 10)
	for _, o in { Vector3.new(-2, 0, -2), Vector3.new(2, 0, -2), Vector3.new(-2, 0, 2), Vector3.new(2, 0, 2) } do
		Build.part(props, {
			Name = "Leg",
			Size = Vector3.new(0.6, 10, 0.6),
			CFrame = CFrame.new(base + o + Vector3.new(0, 5, 0)),
			Color = Color3.fromRGB(240, 240, 240),
		})
	end
	Build.part(props, {
		Name = "Hut",
		Size = Vector3.new(6, 4, 6),
		CFrame = CFrame.new(base + Vector3.new(0, 12, 0)),
		Color = Color3.fromRGB(230, 70, 60),
	})
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 20, 0), Vector3.new(1, 0, 0))
	if bigField(f) then
		scoreboard(props, Vector3.new(L + MARGIN + 14, 20, 0), Vector3.new(-1, 0, 0))
	end
end

local function themeRooftop(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	-- rooftop edge railing
	for _, sz in { 1, -1 } do
		Build.part(props, {
			Name = "Rail",
			Size = Vector3.new(2 * L + 2 * MARGIN, 0.4, 0.4),
			CFrame = CFrame.new(0, 3.6, sz * (W + MARGIN - 1)),
			Color = arena.LineColor,
			Material = Enum.Material.Neon,
		})
	end
	-- skyline ring
	local neon = {
		Color3.fromRGB(255, 80, 200),
		Color3.fromRGB(90, 230, 255),
		Color3.fromRGB(255, 200, 80),
		Color3.fromRGB(140, 120, 255),
	}
	local ring = dressScale(f)
	for i = 0, 46 do
		local ang = i / 47 * math.pi * 2
		local radius = rng:range(330, 470) * ring
		local pos = Vector3.new(math.cos(ang) * radius * 1.2, 0, math.sin(ang) * radius)
		local h = rng:range(80, 260)
		local w = rng:range(30, 60)
		Build.part(props, {
			Name = "Tower",
			Size = Vector3.new(w, h, w),
			CFrame = CFrame.new(pos + Vector3.new(0, h / 2 - 60, 0)),
			Color = Color3.fromRGB(22, 24, 36),
			Material = Enum.Material.Glass,
		})
		local strip = pick(rng, neon)
		for k = 1, 3 do
			Build.part(props, {
				Name = "Window",
				Size = Vector3.new(w + 0.4, 1.2, w + 0.4),
				CFrame = CFrame.new(pos + Vector3.new(0, -60 + h * (k / 4), 0)),
				Color = strip,
				Material = Enum.Material.Neon,
				Transparency = 0.2,
			})
		end
	end
	-- billboards
	for _, sx in { 1, -1 } do
		local p = Vector3.new(sx * (L + MARGIN + 10), 18, 0)
		local b = Build.part(props, {
			Name = "Billboard",
			Size = Vector3.new(2, 14, 44),
			CFrame = CFrame.new(p),
			Color = Color3.fromRGB(16, 16, 24),
		})
		local gui = Instance.new("SurfaceGui")
		gui.Face = if sx > 0 then Enum.NormalId.Left else Enum.NormalId.Right
		gui.LightInfluence = 0
		gui.Brightness = 3
		gui.Parent = b
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.TextColor3 = pick(rng, neon)
		t.Text = "BREAKPOINT"
		t.Parent = gui
	end
	scoreboard(props, Vector3.new(0, 30, -(W + MARGIN + 20)), Vector3.new(0, 0, 1))
	if bigField(f) then
		scoreboard(props, Vector3.new(0, 30, W + MARGIN + 20), Vector3.new(0, 0, -1))
	end
end

local function themeBeach(model: Model, _arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	workspace.Terrain:FillBlock(
		CFrame.new(L + MARGIN + 150, -6, 0),
		Vector3.new(260, 12, 2 * W + 900),
		Enum.Material.Water
	)
	for _ = 1, math.floor(14 * L / BASE_HALF_TOTAL + 0.5) do
		local pos =
			Vector3.new(rng:range(-L, L), 0, (if rng:next() < 0.5 then 1 else -1) * (W + rng:range(22, MARGIN - 4)))
		Build.part(props, {
			Name = "Pole",
			Size = Vector3.new(0.3, 7, 0.3),
			CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0)),
			Color = Color3.new(1, 1, 1),
		})
		Build.part(props, {
			Name = "Umbrella",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 8, 8),
			CFrame = CFrame.new(pos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = pick(rng, SHIRTS),
		})
	end
	for x = -L, L, 40 do
		palm(props, rng, Vector3.new(x, 0, -(W + MARGIN + 16)))
	end
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 18, 0), Vector3.new(1, 0, 0))
	if bigField(f) then
		scoreboard(props, Vector3.new(L + MARGIN + 14, 18, 0), Vector3.new(-1, 0, 0))
	end
end

local function themeIndoor(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	local hx, hz, h = L + MARGIN + 30, W + MARGIN + 30, 70
	local wallColor = Color3.fromRGB(30, 34, 42)
	for _, sx in { 1, -1 } do
		Build.part(props, {
			Name = "Wall",
			Size = Vector3.new(2, h, 2 * hz),
			CFrame = CFrame.new(sx * hx, h / 2, 0),
			Color = wallColor,
		})
		Build.part(props, {
			Name = "Wall",
			Size = Vector3.new(2 * hx, h, 2),
			CFrame = CFrame.new(0, h / 2, sx * hz),
			Color = wallColor,
		})
		for k = 1, 4 do
			Build.part(props, {
				Name = "Strip",
				Size = Vector3.new(2 * hx, 0.6, 2.2),
				CFrame = CFrame.new(0, k * 14, sx * (hz - 0.2)),
				Color = Color3.fromRGB(90, 230, 255),
				Material = Enum.Material.Neon,
			})
		end
	end
	Build.part(props, {
		Name = "Roof",
		Size = Vector3.new(2 * hx, 2, 2 * hz),
		CFrame = CFrame.new(0, h, 0),
		Color = wallColor,
		CastShadow = true,
	})
	for x = -L, L, 45 do
		for _, z in { -W * 0.5, W * 0.5 } do
			local panel = Build.part(props, {
				Name = "LightPanel",
				Size = Vector3.new(24, 0.4, 10),
				CFrame = CFrame.new(x, h - 1.4, z),
				Color = Color3.fromRGB(240, 250, 255),
				Material = Enum.Material.Neon,
			})
			Build.light(
				panel,
				"SurfaceLight",
				{ Face = Enum.NormalId.Bottom, Range = 60, Angle = 120, Brightness = 2.2, Shadows = false }
			)
		end
	end
	local budget = { n = math.floor(220 * arena.Crowd * dressScale(f)) }
	stand(
		props,
		rng,
		Vector3.new(0, 0, W + MARGIN + 2),
		2 * L,
		Vector3.new(0, 0, 1),
		6,
		0.6,
		Color3.fromRGB(44, 48, 60),
		budget
	)
	stand(
		props,
		rng,
		Vector3.new(0, 0, -(W + MARGIN + 2)),
		2 * L,
		Vector3.new(0, 0, -1),
		6,
		0.6,
		Color3.fromRGB(44, 48, 60),
		budget
	)
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 30, 0), Vector3.new(1, 0, 0))
	if bigField(f) then
		scoreboard(props, Vector3.new(L + MARGIN + 14, 30, 0), Vector3.new(-1, 0, 0))
	end
end

local function themePark(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	for _ = 1, math.floor(34 * L / BASE_HALF_TOTAL + 0.5) do
		local side = if rng:next() < 0.5 then 1 else -1
		local pos = Vector3.new(rng:range(-L - 60, L + 60), 0, side * (W + MARGIN + rng:range(8, 70)))
		tree(props, rng, pos)
	end
	-- playground
	local pg = Vector3.new(L + MARGIN + 40, 0, -20)
	local red, yellow, blue = Color3.fromRGB(230, 60, 60), Color3.fromRGB(250, 210, 60), Color3.fromRGB(40, 120, 230)
	Build.part(
		props,
		{ Name = "Tower", Size = Vector3.new(8, 8, 8), CFrame = CFrame.new(pg + Vector3.new(0, 4, 0)), Color = blue }
	)
	Build.part(
		props,
		{ Name = "Roof", Size = Vector3.new(9, 1, 9), CFrame = CFrame.new(pg + Vector3.new(0, 11, 0)), Color = red }
	)
	Build.part(props, {
		Name = "Slide",
		Size = Vector3.new(3, 0.6, 14),
		CFrame = CFrame.new(pg + Vector3.new(0, 4, 10)) * CFrame.Angles(math.rad(-30), 0, 0),
		Color = yellow,
	})
	local swing = pg + Vector3.new(0, 0, -20)
	for _, o in { -6, 6 } do
		Build.part(props, {
			Name = "SwingLeg",
			Size = Vector3.new(0.6, 12, 0.6),
			CFrame = CFrame.new(swing + Vector3.new(o, 6, 0)),
			Color = red,
		})
	end
	Build.part(props, {
		Name = "SwingBar",
		Size = Vector3.new(13, 0.6, 0.6),
		CFrame = CFrame.new(swing + Vector3.new(0, 12, 0)),
		Color = red,
	})
	for _, o in { -2.5, 2.5 } do
		Build.part(props, {
			Name = "Seat",
			Size = Vector3.new(2, 0.3, 1),
			CFrame = CFrame.new(swing + Vector3.new(o, 3, 0)),
			Color = Color3.fromRGB(40, 40, 40),
		})
	end
	-- park benches and a couple of spectators, behind the team benches
	local budget = { n = math.floor(60 * arena.Crowd * dressScale(f)) + 12 }
	local z = -(W + FieldGeometry.BenchOffset + 12)
	for x = -L + 10, L - 10, 30 do
		Build.part(props, {
			Name = "ParkBench",
			Size = Vector3.new(8, 1.2, 2),
			CFrame = CFrame.new(x, 0.6, z),
			Color = Color3.fromRGB(120, 86, 56),
			Material = Enum.Material.Wood,
		})
		if budget.n > 0 then
			budget.n -= 1
			crowdFigure(props, rng, Vector3.new(x, 1.2, z), Vector3.new(0, 0, 1))
		end
	end
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 14, 0), Vector3.new(1, 0, 0))
	if bigField(f) then
		scoreboard(props, Vector3.new(L + MARGIN + 14, 14, 0), Vector3.new(-1, 0, 0))
	end
end

-- Team benches on the -Z sideline (every theme). Substitutes stand on the
-- coloured mat in front of the seat (FieldGeometry.benchSpots); returns the
-- centre of each team's spots facing the field.
local function teamBenches(model: Model, f: FieldSpec): { [string]: CFrame }
	local folder = Build.folder(model, "Benches")
	local geo = FieldGeometry.new({
		center = Vector3.zero,
		width = f.width,
		length = f.length,
		endZone = f.endZone,
		brick = f.brick,
	})
	local len = math.max(16, 0.12 * f.length)
	local out: { [string]: CFrame } = {}
	for _, team in { "A", "B" } do
		local sign = if team == "A" then MatchPlan.BenchSign.A else MatchPlan.BenchSign.B
		local cfg = if team == "A" then TeamsConfig.A else TeamsConfig.B
		local c = FieldGeometry.benchCenter(geo, sign)
		local seat = c + Vector3.new(0, 0, -2.6)
		Build.part(folder, {
			Name = "Mat",
			Size = Vector3.new(len, 0.05, 4),
			CFrame = CFrame.new(c.X, 0.03, c.Z),
			Color = cfg.Color,
			Transparency = 0.55,
		})
		Build.part(folder, {
			Name = "Seat",
			Size = Vector3.new(len, 1.2, 1.6),
			CFrame = CFrame.new(seat.X, 0.6, seat.Z),
			Color = cfg.Color,
			solid = true,
		})
		Build.part(folder, {
			Name = "Backrest",
			Size = Vector3.new(len, 2.4, 0.4),
			CFrame = CFrame.new(seat.X, 1.8, seat.Z - 0.9),
			Color = cfg.Dark,
		})
		local sign2 = Build.part(folder, {
			Name = "BenchLabel",
			Size = Vector3.new(math.min(len, 18), 0.05, 2.4),
			CFrame = CFrame.new(c.X, 0.04, c.Z - 0.2),
			Transparency = 1,
		})
		Build.topText(sign2, cfg.Name .. " BENCH", Color3.new(1, 1, 1), 0.35)
		out[team] = CFrame.lookAt(c, c + Vector3.new(0, 0, 1))
	end
	return out
end

local THEMES = {
	Stadium = themeStadium,
	Coastal = themeCoastal,
	Rooftop = themeRooftop,
	Beach = themeBeach,
	Indoor = themeIndoor,
	Park = themePark,
}

---------------------------------------------------------------------------
-- public
---------------------------------------------------------------------------

function ArenaBuilder.build(arena: any, f: FieldSpec, parent: Instance): Built
	local old = parent:FindFirstChild("Arena")
	if old then
		old:Destroy()
	end
	workspace.Terrain:Clear()
	applyLighting(arena)

	local model = Instance.new("Model")
	model.Name = "Arena"
	model:SetAttribute("ArenaId", arena.id)
	local rng = Rng.new(#arena.id * 7919 + 17)
	local endZones = buildField(model, arena, f)
	local theme = (THEMES :: any)[arena.Theme] or themeStadium
	theme(model, arena, f, rng)
	windFlags(model, f, arena.Wind)
	local benches = teamBenches(model, f)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Sideline"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, -(f.width / 2 + 16))
	spawn.Transparency = 0.6
	spawn.Material = Enum.Material.Neon
	spawn.Color = Color3.fromRGB(90, 230, 255)
	spawn.CanCollide = true
	spawn.Parent = model

	model.Parent = parent
	return { model = model, endZones = endZones, spawn = spawn, margin = MARGIN, benches = benches }
end

ArenaBuilder.Margin = MARGIN

return ArenaBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny construction helpers shared by the arena and training builders.

local Build = {}

export type Props = { [string]: any }

-- Creates an anchored, non-interactive decorative part. Pass `solid = true`
-- for geometry players stand on or collide with.
function Build.part(parent: Instance, props: Props): BasePart
	local className = props.ClassName or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local solid = props.solid == true
	p.CanCollide = solid
	p.CanTouch = false
	p.CanQuery = solid
	p.CastShadow = props.CastShadow == true
	for k, v in props do
		if k ~= "ClassName" and k ~= "solid" and k ~= "Parent" and k ~= "CastShadow" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

function Build.model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Build.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- A text label painted on the top face of a flat part.
function Build.topText(p: BasePart, text: string, color: Color3, transparency: number?, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.6
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBlack
	label.TextColor3 = color
	label.TextTransparency = transparency or 0
	label.Parent = gui
end

-- Billboard sign floating above a part.
function Build.sign(adornee: BasePart, title: string, subtitle: string?, color: Color3?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 74)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.Parent = adornee
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(16, 18, 26)
	frame.BackgroundTransparency = 0.15
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Color3.fromRGB(90, 230, 255)
	stroke.Thickness = 2
	stroke.Parent = frame
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(1, -16, 0, 34)
	t.Position = UDim2.fromOffset(8, 6)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Text = title
	t.Parent = frame
	if subtitle then
		local s = Instance.new("TextLabel")
		s.BackgroundTransparency = 1
		s.Size = UDim2.new(1, -16, 0, 22)
		s.Position = UDim2.fromOffset(8, 42)
		s.Font = Enum.Font.GothamMedium
		s.TextScaled = true
		s.TextColor3 = Color3.fromRGB(190, 200, 215)
		s.Text = subtitle
		s.Parent = frame
	end
	return gui
end

function Build.light(parent: BasePart, className: string, props: Props): Light
	local l = Instance.new(className) :: Light
	for k, v in props do
		(l :: any)[k] = v
	end
	l.Parent = parent
	return l
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TrainingBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TrainingBuilder — the Training Grounds hall (built once at startup).

	All positions are relative to Arenas.TrainingOrigin. Layout (top view,
	+Z = north):

	  z 150..230  Interception    | Break the Mark | Throwing Range
	              Drill (W)       | lane (C)       | targets (E)
	  z 100..150  Aerial Catch    | Break the Mark | Throwing Range
	              launcher (W)    | pivot mark (C) | lane (E)
	  z   0..100  Aerial Catch (W) | Combo Lab     | Throwing Range lane (E)
	  z -130..-10 Movement School  | Cutting       | Momentum Shuttle
	              (W)              | Course (C)    | (E)

	Break the Mark: the thrower's pivot mark at (-5, 120) facing north, a
	scripted bot marker in front of it and two receiver pads 28 studs
	downfield, one either side of the lane.
]]

local CollectionService = game:GetService("CollectionService")

local Build = require(script.Parent.Build)

local TrainingBuilder = {}

export type Station = {
	id: string,
	title: string,
	subtitle: string,
	terminal: Vector3,
	start: Vector3,
	facing: Vector3,
}

export type Layout = {
	model: Model,
	origin: Vector3,
	entry: CFrame,
	stations: { [string]: Station },
	gates: { { a: Vector3, b: Vector3 } },
	shuttleA: number, -- world z of shuttle line A
	shuttleB: number,
	shuttleX: { number },
	launcher: Vector3,
	catchMark: Vector3,
	throwMark: Vector3,
	targets: { { pos: Vector3, radius: number, points: number, name: string } },
	mover: { center: Vector3, amplitude: number, period: number, radius: number, points: number },
	interception: { thrower: Vector3, receiverStart: Vector3, playerStart: Vector3 },
	-- Break the Mark: `mark` is the pivot spot (ground), `facing` points down
	-- the lane, `receivers` are the two receiver pads (ground).
	breakMark: { mark: Vector3, facing: Vector3, receivers: { Vector3 } },
	prompts: { [string]: ProximityPrompt },
}

local FLOOR = Color3.fromRGB(40, 46, 58)
local LINE = Color3.fromRGB(90, 230, 255)
local CONE = Color3.fromRGB(255, 110, 20)

local function cone(parent: Instance, pos: Vector3, color: Color3?)
	Build.part(parent, {
		Name = "Cone",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 1.4, 1.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color or CONE,
		Material = Enum.Material.Neon,
	})
end

local function terminal(parent: Instance, pos: Vector3, title: string, subtitle: string, id: string): ProximityPrompt
	local base = Build.part(parent, {
		Name = "Terminal_" .. id,
		Size = Vector3.new(4, 4, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)),
		Color = Color3.fromRGB(24, 28, 36),
		solid = true,
	})
	Build.part(parent, {
		Name = "TerminalGlow",
		Size = Vector3.new(4.2, 0.3, 2.2),
		CFrame = CFrame.new(pos + Vector3.new(0, 4.1, 0)),
		Color = LINE,
		Material = Enum.Material.Neon,
	})
	Build.sign(base, title, subtitle, LINE)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Start"
	prompt.ObjectText = title
	prompt.KeyboardKeyCode = Enum.KeyCode.G
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Drill", id)
	prompt.Parent = base
	return prompt
end

function TrainingBuilder.build(origin: Vector3, parent: Instance): Layout
	local old = parent:FindFirstChild("TrainingGrounds")
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "TrainingGrounds"
	local function at(x: number, z: number, y: number?): Vector3
		return origin + Vector3.new(x, y or 0, z)
	end

	-- hall
	local W, Z0, Z1, H = 170, -140, 240, 64
	Build.part(model, {
		Name = "Floor",
		Size = Vector3.new(2 * W, 1, Z1 - Z0),
		CFrame = CFrame.new(at(0, (Z0 + Z1) / 2, -0.5)),
		Color = FLOOR,
		Material = Enum.Material.SmoothPlastic,
		solid = true,
	})
	-- floor grid
	for x = -W + 20, W - 20, 20 do
		Build.part(model, {
			Name = "Grid",
			Size = Vector3.new(0.2, 0.04, Z1 - Z0),
			CFrame = CFrame.new(at(x, (Z0 + Z1) / 2, 0.02)),
			Color = Color3.fromRGB(60, 70, 88),
		})
	end
	for z = Z0 + 20, Z1 - 20, 20 do
		Build.part(model, {
			Name = "Grid",
			Size = Vector3.new(2 * W, 0.04, 0.2),
			CFrame = CFrame.new(at(0, z, 0.02)),
			Color = Color3.fromRGB(60, 70, 88),
		})
	end
	local wallColor = Color3.fromRGB(28, 32, 42)
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2, H, Z1 - Z0),
		CFrame = CFrame.new(at(-W, (Z0 + Z1) / 2, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2, H, Z1 - Z0),
		CFrame = CFrame.new(at(W, (Z0 + Z1) / 2, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2 * W, H, 2),
		CFrame = CFrame.new(at(0, Z0, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2 * W, H, 2),
		CFrame = CFrame.new(at(0, Z1, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Roof",
		Size = Vector3.new(2 * W, 2, Z1 - Z0),
		CFrame = CFrame.new(at(0, (Z0 + Z1) / 2, H + 1)),
		Color = wallColor,
		solid = true,
	})
	for x = -W + 40, W - 40, 60 do
		for z = Z0 + 40, Z1 - 40, 60 do
			local panel = Build.part(model, {
				Name = "LightPanel",
				Size = Vector3.new(26, 0.4, 12),
				CFrame = CFrame.new(at(x, z, H - 1)),
				Color = Color3.fromRGB(235, 245, 255),
				Material = Enum.Material.Neon,
			})
			Build.light(
				panel,
				"SurfaceLight",
				{ Face = Enum.NormalId.Bottom, Range = 60, Angle = 120, Brightness = 2.5, Shadows = false }
			)
		end
	end
	for _, z in { Z0 + 0.8, Z1 - 0.8 } do
		Build.part(model, {
			Name = "Strip",
			Size = Vector3.new(2 * W, 0.8, 0.4),
			CFrame = CFrame.new(at(0, z, 10)),
			Color = LINE,
			Material = Enum.Material.Neon,
		})
	end

	local entry = CFrame.lookAt(at(0, -125, 3.5), at(0, 0, 3.5))
	local entryPad = Build.part(model, {
		Name = "EntryPad",
		Size = Vector3.new(14, 0.4, 10),
		CFrame = CFrame.new(at(0, -125, 0.2)),
		Color = LINE,
		Material = Enum.Material.Neon,
		Transparency = 0.5,
	})
	Build.sign(entryPad, "TRAINING GROUNDS", "Walk up to a terminal and press G to start a drill", LINE)

	local stations: { [string]: Station } = {}
	local prompts: { [string]: ProximityPrompt } = {}
	local function station(id: string, title: string, subtitle: string, term: Vector3, start: Vector3, facing: Vector3)
		stations[id] = { id = id, title = title, subtitle = subtitle, terminal = term, start = start, facing = facing }
		prompts[id] = terminal(model, term, title, subtitle, id)
	end

	-- Movement School
	station(
		"Tutorial",
		"MOVEMENT SCHOOL",
		"Learn every technique, step by step",
		at(-120, -118),
		at(-110, -90),
		Vector3.new(0, 0, 1)
	)
	-- Cutting course: zig-zag gates
	local gates = {}
	local courseFolder = Build.folder(model, "CuttingCourse")
	local gx = { 0, -18, 14, -10, 20, -20, 8, 0 }
	for i, x in gx do
		local z = -112 + (i - 1) * 13
		local a, b = at(x - 3.2, z), at(x + 3.2, z)
		cone(courseFolder, a, if i == 1 or i == #gx then Color3.fromRGB(80, 255, 140) else nil)
		cone(courseFolder, b, if i == 1 or i == #gx then Color3.fromRGB(80, 255, 140) else nil)
		table.insert(gates, { a = a, b = b })
	end
	station(
		"Cutting",
		"CUTTING COURSE",
		"Slalom through every gate. Keep your speed.",
		at(-30, -126),
		at(0, -124),
		Vector3.new(0, 0, 1)
	)

	-- Momentum shuttle
	local shuttleFolder = Build.folder(model, "Shuttle")
	local zA, zB = -118, -82
	for _, z in { zA, zB } do
		Build.part(shuttleFolder, {
			Name = "ShuttleLine",
			Size = Vector3.new(56, 0.06, 0.8),
			CFrame = CFrame.new(at(110, z, 0.04)),
			Color = if z == zA then Color3.fromRGB(80, 255, 140) else Color3.fromRGB(255, 200, 60),
			Material = Enum.Material.Neon,
		})
	end
	station(
		"Shuttle",
		"MOMENTUM SHUTTLE",
		"A-B-A-B-A. Reverse fast without losing it.",
		at(146, -126),
		at(110, -126),
		Vector3.new(0, 0, 1)
	)

	-- Aerial catch: launcher at the north end of the west side
	local launcher = at(-100, 128, 4)
	Build.part(model, {
		Name = "LauncherBase",
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(launcher - Vector3.new(0, 1, 0)),
		Color = Color3.fromRGB(50, 56, 70),
		solid = true,
	})
	Build.part(model, {
		Name = "LauncherBarrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, 2.4, 2.4),
		CFrame = CFrame.lookAt(launcher + Vector3.new(0, 2, 0), at(-100, 40, 4)) * CFrame.Angles(0, math.rad(90), 0),
		Color = LINE,
		Material = Enum.Material.Neon,
	})
	local catchMark = at(-100, 40)
	Build.part(model, {
		Name = "CatchMark",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 6, 6),
		CFrame = CFrame.new(catchMark + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 200, 60),
		Material = Enum.Material.Neon,
	})
	station(
		"Aerial",
		"AERIAL CATCH",
		"10 launches: floaters, skimmers, layouts",
		at(-150, 20),
		catchMark + Vector3.new(0, 3, 0),
		Vector3.new(0, 0, 1)
	)
	station(
		"Launcher",
		"FREE LAUNCHER",
		"Custom launches (opens the launcher panel)",
		at(-150, 60),
		catchMark + Vector3.new(0, 3, 0),
		Vector3.new(0, 0, 1)
	)

	-- Throwing range (east): throw north from the mark
	local throwMark = at(70, 20)
	Build.part(model, {
		Name = "ThrowMark",
		Size = Vector3.new(6, 0.08, 6),
		CFrame = CFrame.new(throwMark + Vector3.new(0, 0.05, 0)),
		Color = Color3.fromRGB(80, 255, 140),
		Material = Enum.Material.Neon,
		Transparency = 0.3,
	})
	local targets = {}
	local function target(name: string, x: number, z: number, y: number, radius: number, points: number)
		local pos = at(x, z, y)
		local ring = Build.part(model, {
			Name = "Target_" .. name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, radius * 2, radius * 2),
			CFrame = CFrame.lookAt(pos, throwMark + Vector3.new(0, y, 0)) * CFrame.Angles(0, math.rad(90), 0),
			Color = Color3.fromRGB(255, 80, 120),
			Material = Enum.Material.Neon,
			Transparency = 0.55,
		})
		Build.part(model, {
			Name = "TargetPole",
			Size = Vector3.new(0.4, y - radius, 0.4),
			CFrame = CFrame.new(at(x, z, (y - radius) / 2)),
			Color = Color3.fromRGB(200, 200, 210),
		})
		Build.sign(ring, name, points .. " pts", Color3.fromRGB(255, 80, 120))
		CollectionService:AddTag(ring, "UBTarget")
		table.insert(targets, { pos = pos, radius = radius, points = points, name = name })
	end
	target("40", 62, 60, 5, 4.5, 100)
	target("70", 88, 90, 6, 4, 150)
	target("100", 52, 120, 7, 4, 200)
	target("140", 80, 160, 8, 4.5, 300)
	local moverCenter = at(70, 200, 6)
	local mover = { center = moverCenter, amplitude = 38, period = 7, radius = 4.5, points = 250 }
	local moverPart = Build.part(model, {
		Name = "MovingTarget",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 9, 9),
		CFrame = CFrame.lookAt(moverCenter, throwMark + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(255, 200, 60),
		Material = Enum.Material.Neon,
		Transparency = 0.45,
	})
	moverPart:SetAttribute("Amplitude", mover.amplitude)
	moverPart:SetAttribute("Period", mover.period)
	moverPart:SetAttribute("Center", moverCenter)
	CollectionService:AddTag(moverPart, "UBMover")
	Build.part(model, {
		Name = "Rail",
		Size = Vector3.new(mover.amplitude * 2 + 10, 0.4, 0.6),
		CFrame = CFrame.new(moverCenter - Vector3.new(0, 5, 0)),
		Color = Color3.fromRGB(90, 96, 110),
	})
	station(
		"Range",
		"THROWING RANGE",
		"10 throws at the rings (and the mover)",
		at(100, 8),
		throwMark + Vector3.new(0, 3, 0),
		Vector3.new(0, 0, 1)
	)

	-- Interception drill (north-west)
	local interception = {
		thrower = at(-140, 160, 3),
		receiverStart = at(-70, 160, 3),
		playerStart = at(-100, 175, 3),
	}
	Build.part(model, {
		Name = "DrillZone",
		Size = Vector3.new(110, 0.05, 80),
		CFrame = CFrame.new(at(-100, 190, 0.03)),
		Color = Color3.fromRGB(255, 120, 30),
		Material = Enum.Material.Neon,
		Transparency = 0.9,
	})
	station(
		"Interception",
		"INTERCEPTION DRILL",
		"Read the throw. Get the D.",
		at(-150, 145),
		interception.playerStart,
		Vector3.new(0, 0, 1)
	)

	-- Combo lab with rebound walls
	local lab = Build.folder(model, "ComboLab")
	for i, x in { -26, -6 } do
		local wall = Build.part(lab, {
			Name = "LabRebound" .. i,
			Size = Vector3.new(1, 16, 40),
			CFrame = CFrame.new(at(x, 70, 8)),
			Color = Color3.fromRGB(255, 90, 200),
			Material = Enum.Material.Neon,
			Transparency = 0.5,
			solid = true,
		})
		CollectionService:AddTag(wall, "Rebound")
	end
	station(
		"Combo",
		"COMBO LAB",
		"Chain challenges. Rebound walls inside.",
		at(-16, 10),
		at(-16, 30, 3),
		Vector3.new(0, 0, 1)
	)

	-- Break the Mark (north centre): pivot mark, lane and two receiver pads
	local breakFolder = Build.folder(model, "BreakTheMark")
	local markSpot = at(-5, 120)
	local breakFacing = Vector3.new(0, 0, 1)
	Build.part(breakFolder, {
		Name = "BreakLane",
		Size = Vector3.new(44, 0.04, 56),
		CFrame = CFrame.new(at(-5, 146, 0.03)),
		Color = Color3.fromRGB(255, 120, 200),
		Material = Enum.Material.Neon,
		Transparency = 0.92,
	})
	Build.part(breakFolder, {
		Name = "PivotMark",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 3, 3),
		CFrame = CFrame.new(markSpot + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(80, 255, 140),
		Material = Enum.Material.Neon,
	})
	local receivers = { at(-17, 148), at(7, 148) }
	for i, pos in receivers do
		Build.part(breakFolder, {
			Name = "ReceiverPad" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 7, 7),
			CFrame = CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(255, 200, 60),
			Material = Enum.Material.Neon,
			Transparency = 0.4,
		})
	end
	station(
		"BreakMark",
		"BREAK THE MARK",
		"Pivot past a live marker. Find the open side.",
		at(-30, 112),
		markSpot + Vector3.new(0, 3, 0),
		breakFacing
	)

	model.Parent = parent
	return {
		model = model,
		origin = origin,
		entry = entry,
		stations = stations,
		gates = gates,
		shuttleA = origin.Z + zA,
		shuttleB = origin.Z + zB,
		shuttleX = { origin.X + 82, origin.X + 138 },
		launcher = launcher + Vector3.new(0, 2, 0),
		catchMark = catchMark,
		throwMark = throwMark,
		targets = targets,
		mover = mover,
		interception = interception,
		breakMark = { mark = markSpot, facing = breakFacing, receivers = receivers },
		prompts = prompts,
	}
end

-- Moving target position at server time t (clients use the same formula).
function TrainingBuilder.moverPosition(center: Vector3, amplitude: number, period: number, t: number): Vector3
	return center + Vector3.new(math.sin(t * 2 * math.pi / period) * amplitude, 0, 0)
end

return TrainingBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="40">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- ULTIMATE: BREAKPOINT — server bootstrap.
-- Services are initialised in dependency order, then started. Each service
-- receives the shared `services` table in Init so modules never need
-- circular requires.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local MovementConfig = require(Shared.Config.Movement)

Net.init()
workspace.Gravity = MovementConfig.Gravity
Players.CharacterAutoLoads = true

local Services = script.Parent.Services

local ORDER = {
	"PlayerService",
	"DataService",
	"ArenaService",
	"MovementService",
	"DiscService",
	"CatchingService",
	"DefenseService",
	"ThrowService",
	"LeaderboardService",
	"ProgressionService",
	"HighlightService",
	"TeamService",
	"BotService",
	"TrainingService",
	"MatchService",
}

local services: { [string]: any } = { Actors = Actors }
for _, name in ORDER do
	services[name] = require(Services:WaitForChild(name)) :: any
end

for _, name in ORDER do
	local ok, err = pcall(services[name].Init, services)
	if not ok then
		warn(string.format("[Breakpoint] %s.Init failed: %s", name, tostring(err)))
	end
end

for _, name in ORDER do
	local ok, err = pcall(services[name].Start)
	if not ok then
		warn(string.format("[Breakpoint] %s.Start failed: %s", name, tostring(err)))
	end
end

print("[Breakpoint] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ArenaService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ArenaService — current arena, field geometry and wind. Rebuilds the world
	between matches.

	The field follows the mode: Config/Modes.Fields.Mini (240 x 90 including
	end zones) for 3v3 and .Normal (360 x 136) for 7v7. The server boots on
	the Normal field; MatchService rebuilds when a match needs the other one.
	Field size is published on UBState (Field, FieldWidth, FieldLength,
	FieldEndZone, FieldBrick) for clients.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArenasConfig = require(Shared.Config.Arenas)
local ModesConfig = require(Shared.Config.Modes)
local FieldGeometry = require(Shared.Rules.FieldGeometry)
local Net = require(Shared.Net)
local ArenaBuilder = require(script.Parent.Parent.Arena.ArenaBuilder)

local ArenaService = {}

ArenaService.DefaultField = "Normal"

local current: any = nil
local built: ArenaBuilder.Built? = nil
local field: FieldGeometry.Field? = nil
local fieldSpec: ModesConfig.FieldSpec? = nil
local currentFieldName = ArenaService.DefaultField

function ArenaService.build(arenaId: string, fieldName: string)
	local arena = (ArenasConfig.List :: any)[arenaId] or ArenasConfig.List[ArenasConfig.Default]
	local name = if ModesConfig.Fields[fieldName] then fieldName else ArenaService.DefaultField
	local spec = ModesConfig.Fields[name]
	current = arena
	fieldSpec = spec
	currentFieldName = name
	built = ArenaBuilder.build(arena, spec, workspace)
	field = FieldGeometry.new({
		center = Vector3.new(0, 0, 0),
		width = spec.width,
		length = spec.length,
		endZone = spec.endZone,
		brick = spec.brick,
	})
	local state = Net.state()
	state:SetAttribute("Arena", arena.id)
	state:SetAttribute("ArenaName", arena.Display)
	state:SetAttribute("Wind", arena.Wind)
	state:SetAttribute("Field", name)
	state:SetAttribute("FieldWidth", spec.width)
	state:SetAttribute("FieldLength", spec.length)
	state:SetAttribute("FieldEndZone", spec.endZone)
	state:SetAttribute("FieldBrick", spec.brick)
end

function ArenaService.field(): FieldGeometry.Field
	assert(field, "arena not built")
	return field :: FieldGeometry.Field
end

function ArenaService.fieldSpec(): ModesConfig.FieldSpec?
	return fieldSpec
end

-- Key into Config/Modes.Fields of the field that is built ("Mini" / "Normal").
function ArenaService.fieldName(): string
	return currentFieldName
end

function ArenaService.arena(): any
	return current
end

function ArenaService.wind(): { x: number, y: number, z: number }
	local w = if current then current.Wind else Vector3.zero
	return { x = w.X, y = w.Y, z = w.Z }
end

function ArenaService.windVector(): Vector3
	return if current then current.Wind else Vector3.zero
end

function ArenaService.endZone(side: string): BasePart?
	if built then
		return built.endZones[side]
	end
	return nil
end

-- Centre of a team's sideline bench (where FieldGeometry.benchSpots stand),
-- facing the field.
function ArenaService.benchCFrame(team: string): CFrame?
	if built then
		return built.benches[team]
	end
	return nil
end

function ArenaService.spawnCFrame(): CFrame
	if built then
		return built.spawn.CFrame + Vector3.new(0, 3, 0)
	end
	local width = if fieldSpec then fieldSpec.width else ModesConfig.Fields[ArenaService.DefaultField].width
	return CFrame.new(0, 5, -(width / 2 + 16))
end

function ArenaService.margin(): number
	return ArenaBuilder.Margin
end

function ArenaService.Init(_s: any)
	ArenaService.build(ArenasConfig.Default, ArenaService.DefaultField)
end

function ArenaService.Start() end

return ArenaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BotService — server-driven teammates and opponents, so every match is a
	full 3v3 / 7v7 (TeamService adds bots to empty line slots when the mode
	has FillWithBots) and Studio solo testing works.

	BODY. Every bot runs the same MovementSim a player runs, on the server,
	and drives its Humanoid exactly the way the client MovementController
	drives a player's: each Heartbeat WalkSpeed = |v| and Move(v.Unit) from
	the sim's velocity; on impulse frames (technique starts, jumps) it also
	writes AssemblyLinearVelocity; a jump sets JumpPower + ChangeState(Jumping)
	for one frame. Facing is an AlignOrientation (AutoRotate off; the root
	CFrame is never written), so bots turn smoothly and never snap. Bots
	therefore accelerate, turn, plant, cut, burst, slide, lay out, slide out
	of the dive and pop up with a player's momentum. Their technique events
	go to MovementService.botTech with their timestamps (pose attributes,
	combos) and the sim's pose mode is their MS attribute. A server teleport
	(UBTeleport) resets the sim like a client's (keeping the possession and
	the pivot), the pre-pull line (UBLineX / UBLineSide) clamps them like a
	player, UBFrozen freezes the sim.

	BRAIN. Brains think ~10 times a second and only output intent: a target
	and speed (the motor turns it into sim input with a smooth arrival and a
	stop radius with hysteresis, so bots never jitter on a spot; a moving
	target such as a guard's man also gives its velocity, which is matched
	so a guard never stop-starts behind him), a facing, the holder's aim and
	step, the mark-shuffle flag, and presses (Cut / Burst / Dive / Jump /
	Slide / Swing / Fake, optionally a few frames later). Techniques are
	used the way players use them, at most every ~0.6-1.2 s per bot: a Snap
	Cut (sometimes with a Perfect Burst out of it) when a cutter changes
	direction at speed, a plant plus an explosive restart to reverse, a jab
	(Fake Commit) before a cut when a defender is tight, a layout for a disc
	just out of reach, a pop-up out of the dive slide, Air Redirects toward
	a moving catch point and Precision Landings out of jumps.

	Positioning is field-relative (FieldGeometry; speeds from Config):
	  offense 7v7     a vertical stack ~18 studs downfield of the disc in a
	                  central lane, two handlers (a dump behind on the break
	                  side, one wide on the open side); stack cutters take
	                  turns cutting under or deep to the open side (set-up
	                  step away, cut, burst), then clear to the back
	  offense 3v3     one handler (the dump) and lane cutters who pick open
	                  space 10-38 % of the field ahead of the disc
	  defense         the defender closest to the holder marks; everyone
	                  else guards one attacker per possession, goal side,
	                  from a reaction-lagged read of their position
	  disc in flight  the best-placed bot of each team chases the earliest
	                  reachable point (one shared prediction per flight;
	                  a human teammate who gets there as fast has priority)
	                  and jumps, reaches or lays out; the rest keep shape
	  pull            the pulling team runs down onto its marks, the
	                  receivers spread around the landing spot
	  ground          the nearest attacker picks the disc up
	The open / break side comes from the defenders' force (UBState ForceA/B,
	FH or BH relative to the thrower).

	MARKER (diag 3 §5). Stands MarkDistance upfield of the pivot P, shaded
	toward the break side, and mirrors the thrower's step from a reaction-
	lagged position (MovementService.positionAt, lag 0.30 - 0.15 x skill)
	with gain 0.55 + 0.35 x skill, clamped to MirrorMax; it shuffles with the
	sim's mark overlay, facing P. Low stance by default, High only while an
	overhead windup is really live (after the reaction delay). Bites on
	fakes (FakeT / FakeSide; 0.6 - 0.4 x skill, never twice in 1.2 s) and
	jump-blocks hops (0.35 x skill).

	THROWER (diag 3 §6). Lets the sim plant the pivot, reads the receivers,
	then picks the release side away from the marker's shade in the throw
	frame and steps out (0.6 + 0.4 x skill) R (Low against a High mark, a
	hammer over a closed lane). With probability 0.35 x skill it fakes toward
	the mark and Quick Swings away (a Sold swing; the release right after is
	a Break). Before releasing it solves the pass from its real pivot + step
	and tests 2-4 candidate releases with ThrowService.previewBlock (weaker
	bots sometimes skip the test); when every release would be blocked it
	swings to the other side and looks again.

	Bots only play while they are on their team's line (TeamService.lineFor);
	a bot that is not (about to be replaced) stands still. Training drills
	drive bots with custom brains (spawn(team, brain, role), run every frame)
	and the helpers at the end (setGoal, mark, unmark, chase, press, setSkill,
	stand). At most one pass solve (Solver) runs per frame across all bots.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local Rng = require(Shared.Util.Rng)
local VecMath = require(Shared.Util.VecMath)
local TeamsConfig = require(Shared.Config.Teams)
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local Solver = require(Shared.Disc.Solver)
local FieldGeometry = require(Shared.Rules.FieldGeometry)
local RulesEngine = require(Shared.Rules.RulesEngine)
local MovementSim = require(Shared.Movement.MovementSim)
local Locomotion = require(Shared.Animation.Locomotion)

local BotService = {}

local services: any
local folder: Folder

local MC = MovementConfig
local HD = MC.Holding
local MK = MC.Marking
local DM = DiscConfig.Mark
local R = HD.StepRadius
local JOG = MC.JogSpeed
local SPRINT = MC.SprintSpeed

local THINK_EVERY = 0.1
local ARRIVE_DECEL = 45 -- studs/s^2: the approach to a spot ramps speed down like this
local ARRIVE_RADIUS = 0.8 -- stop inside this ...
local RESUME_RADIUS = 1.6 -- ... and only move again beyond this (no jitter on a spot)
local MARK_GAIN = 7 -- mark shuffle: studs/s of velocity per stud from the mark spot
local FOLLOW_GAIN = 2.5 -- moving target: studs/s of correction per stud of error
local BLOCK_RAY = 2.5
local AIR_GRACE = 0.12
local SPEED_SMOOTH = 20
local FLIGHT_DT = 1 / 60
local CATCH_HEIGHT = 9 -- disc centre height (above the ground) a jumping bot can reach
local HAND_CHECK_SKIP = 0.3 -- weaker bots skip the hand-block test this often
local OVERHEAD = { Hammer = true, Scoober = true }
local POSE_MODES = { Slide = true, Dive = true, DiveSlide = true, Recover = true, Pivot = true, Mark = true }

export type Press = { action: string, dir: Vector3?, side: number, at: number }

-- A cutter's run: a set-up step away, optionally a jab, then the cut.
type CutPlan = {
	kind: string, -- "Under" | "Deep" | "Spot" | "Dump"
	phase: string, -- "Set" | "Jab" | "Go"
	target: Vector3,
	setFrom: Vector3,
	setDir: Vector3,
	setLen: number,
	phaseAt: number,
	untilT: number,
	juke: boolean,
}

type MarkState = {
	holder: number,
	lastFakeT: number,
	lastBite: number,
	biteStart: number,
	biteUntil: number,
	biteLateral: number,
	biteHigh: boolean,
	hopKey: number,
}

type HoldPlan = {
	phase: string, -- "Settle" | "Look" | "Setup" | "Swing"
	at: number,
	since: number,
	waitUntil: number,
	receiver: number?,
	throwType: string,
	height: string,
	side: number, -- release side in the throw frame (-1 left, +1 right)
	charged: number,
	swingEnd: number,
	attempts: number,
}

export type Bot = {
	id: number,
	name: string,
	team: string,
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	align: AlignOrientation,
	loco: Locomotion.Controller?,
	rng: Rng.Rng,
	skill: number,
	reaction: number,
	sim: MovementSim.State,
	-- intent (brain output)
	target: Vector3?,
	targetVel: Vector3?, -- the target moves (a guard's man): match it, no stop radius
	speed: number,
	face: Vector3?,
	aim: Vector3?,
	step: Vector3?,
	marking: boolean,
	presses: { Press },
	custom: ((Bot, number) -> ())?,
	nextThink: number,
	-- motor
	arrived: boolean,
	holding: boolean,
	lastTeleport: any,
	jumpArmed: boolean,
	speedSmooth: number,
	facing: Vector3,
	alignFacing: Vector3,
	aiming: boolean,
	poseMode: string,
	airSince: number?,
	precisionArmed: boolean,
	armedAt: number,
	popPending: boolean,
	diveRoll: string,
	nextTechAt: number, -- brain-initiated cuts at most this often (no spam)
	squared: boolean, -- a guard on his man faces the play (with hysteresis)
	-- brain memory
	cut: CutPlan?,
	mark: MarkState?,
	hold: HoldPlan?,
	nextSpotAt: number,
	stanceOn: boolean,
	stanceName: string,
}

type Body = { id: number, team: string, isBot: boolean, pos: Vector3, vel: Vector3 }

type FlightSample = { t: number, pos: Vector3 }

type Flight = {
	key: string,
	samples: { FlightSample },
	land: Vector3,
	landT: number,
}

type World = {
	frame: number,
	t: number,
	e: RulesEngine.State,
	phase: string,
	d: any,
	f: FieldGeometry.Field,
	bodies: { [number]: Body },
	team: { [string]: { Body } },
	lines: { [string]: { number } },
	flight: Flight?,
	chasers: { [string]: number },
	markerChecked: { [string]: boolean },
	teamSize: number,
	stall: number,
	stallMax: number,
}

type TeamPlan = {
	point: number,
	offense: boolean,
	holder: number?,
	roles: { [number]: string }, -- "Handler" | "Cutter"
	handlers: { number },
	cutters: { number }, -- stack order, front first
	nextCutAt: number,
	guards: { [number]: number }, -- defending bot -> attacker
	marker: number?,
	markerAwaySince: number?,
}

local brains: { [number]: Bot } = {}
local plans: { [string]: TeamPlan } = {}
local flights: { [string]: Flight } = {}
local nextId = Actors.BotIdBase
local seedCounter = 0
local frameNo = 0
local world: World? = nil
local lastSolveFrame = -1
local planRng = Random.new()
local lastWarn: { [number]: number } = {}

local NAMES = {
	"Huck Norris",
	"Flick Jagger",
	"Layla Out",
	"Hammer Time",
	"Scoober Doo",
	"Stall Ten",
	"Pivot Pete",
	"Blade Runner",
	"Callahan Kid",
	"Greatest Gwen",
	"Bricky",
	"Swing Lowe",
	"Dump Truck",
	"Deep Dana",
	"Break Mark",
	"Zone Defense",
	"Spin Doctor",
	"Pancake",
	"Hospital Hal",
	"Sky Walker",
}

local SKIN = {
	Color3.fromRGB(255, 220, 190),
	Color3.fromRGB(234, 184, 146),
	Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(141, 92, 62),
	Color3.fromRGB(96, 62, 42),
}

local NO_INPUT: MovementSim.Input = { move = Vector3.zero, sprint = false }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function now(): number
	return Net.now()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function rightOf(forward: Vector3): Vector3
	return Vector3.new(-forward.Z, 0, forward.X)
end

local function teamColor(team: string): (Color3, Color3)
	if team == "A" then
		return TeamsConfig.A.Color, TeamsConfig.A.Dark
	elseif team == "B" then
		return TeamsConfig.B.Color, TeamsConfig.B.Dark
	end
	return TeamsConfig.Neutral.Color, Color3.fromRGB(80, 80, 90)
end

---------------------------------------------------------------------------
-- spawning
---------------------------------------------------------------------------

function BotService.spawn(team: string, custom: ((any, number) -> ())?, role: string?): number
	nextId -= 1
	seedCounter += 1
	local id = nextId
	local rng = Rng.new(seedCounter * 2654435761 + 97)
	local name = NAMES[((seedCounter - 1) % #NAMES) + 1]
	local shirt, shorts = teamColor(team)
	local desc = Instance.new("HumanoidDescription")
	local skin = SKIN[rng:int(1, #SKIN)]
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = shirt
	desc.LeftLegColor = shorts
	desc.RightLegColor = shorts

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] could not create bot model: " .. tostring(model))
		return id
	end
	local m = model :: Model
	m.Name = "Bot_" .. name
	local humanoid = m:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = m:FindFirstChild("HumanoidRootPart") :: BasePart
	if not humanoid or not root then
		m:Destroy()
		return id
	end
	m:PivotTo(services.ArenaService.spawnCFrame() + Vector3.new(rng:range(-6, 6), 0, rng:range(-3, 3)))
	m.Parent = folder
	root:SetNetworkOwner(nil)
	local actor = services.PlayerService.registerBot(id, name .. " [BOT]", team, m)
	if role then
		services.PlayerService.setTeam(actor, team, role)
	end

	-- the sim drives the body: no engine walking, jumping or turning
	humanoid.AutoRotate = false
	humanoid.WalkSpeed = 0
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	for _, st in
		{
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.Seated,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.FallingDown,
		}
	do
		humanoid:SetStateEnabled(st, false)
	end
	local att = Instance.new("Attachment")
	att.Name = "UBMoveAttachment"
	att.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Name = "UBFace"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.Responsiveness = 30
	align.MaxTorque = 1e7
	align.MaxAngularVelocity = 20
	align.CFrame = root.CFrame.Rotation
	align.Parent = root

	local look = VecMath.flatUnit(root.CFrame.LookVector)
	if look.Magnitude < 0.5 then
		look = Vector3.new(0, 0, -1)
	end
	local brain: Bot = {
		id = id,
		name = name,
		team = team,
		model = m,
		humanoid = humanoid,
		root = root,
		align = align,
		loco = nil,
		rng = rng,
		skill = rng:range(0.6, 0.85),
		reaction = rng:range(0.18, 0.32),
		sim = MovementSim.new(now()),
		target = nil,
		targetVel = nil,
		speed = JOG,
		face = nil,
		aim = nil,
		step = nil,
		marking = false,
		presses = {},
		custom = custom,
		nextThink = now() + rng:range(0, THINK_EVERY),
		arrived = true,
		holding = false,
		lastTeleport = m:GetAttribute("UBTeleport"),
		jumpArmed = false,
		speedSmooth = 0,
		facing = look,
		alignFacing = look,
		aiming = false,
		poseMode = "Ground",
		airSince = nil,
		precisionArmed = false,
		armedAt = 0,
		popPending = false,
		diveRoll = "",
		nextTechAt = 0,
		squared = false,
		cut = nil,
		mark = nil,
		hold = nil,
		nextSpotAt = 0,
		stanceOn = false,
		stanceName = "",
	}
	brain.sim.pos = root.Position
	brains[id] = brain
	task.spawn(function()
		local okLoco, loco = pcall(Locomotion.new, humanoid)
		if okLoco and brains[id] == brain then
			brain.loco = loco
		end
	end)
	return id
end

function BotService.remove(id: number)
	local b = brains[id]
	brains[id] = nil
	lastWarn[id] = nil
	if b and b.loco then
		Locomotion.destroy(b.loco)
	end
	services.PlayerService.unregisterBot(id)
end

function BotService.brain(id: number): Bot?
	return brains[id]
end

---------------------------------------------------------------------------
-- intent helpers
---------------------------------------------------------------------------

-- Queues a press for the motor (`delay` seconds from now).
local function press(b: Bot, action: string, dir: Vector3?, delay: number?, side: number?)
	table.insert(b.presses, { action = action, dir = dir, side = side or 0, at = now() + (delay or 0) })
end

local function canSpend(b: Bot, cost: number): boolean
	return b.sim.exertion >= cost + 15
end

local function ready(b: Bot, tech: string): boolean
	return MovementSim.readiness(b.sim, tech) >= 1
end

local function setStance(b: Bot, on: boolean, stance: string)
	if b.stanceOn ~= on or (on and b.stanceName ~= stance) then
		b.stanceOn = on
		b.stanceName = stance
		services.DefenseService.setStance(b.id, on, stance)
	end
end

local function clearMark(b: Bot)
	b.marking = false
	b.mark = nil
	if b.stanceOn then
		setStance(b, false, "Low")
	end
end

local function stand(b: Bot)
	b.target = nil
	b.targetVel = nil
	b.cut = nil
	b.face = nil
end

-- Sets where to go. With `tech`, a big change of direction at speed uses
-- the technique a player would: a Snap Cut (25-115 deg, sometimes chained
-- into a Perfect Burst) or a plant with an explosive restart (a reversal).
-- `force` presses the Cut whatever the angle (a cut out of a jab).
local function steerTo(b: Bot, target: Vector3, speed: number, tech: boolean?, force: boolean?)
	b.target = target
	b.targetVel = nil
	b.speed = speed
	if not tech then
		return
	end
	local sim = b.sim
	local t = now()
	if sim.mode ~= "Ground" or sim.holding or #b.presses > 0 or (t < b.nextTechAt and not force) then
		return
	end
	local pos = b.root.Position
	local toT = flat(target - pos)
	local dist = toT.Magnitude
	local sp = sim.vel.Magnitude
	if dist < 7 or sp < 8 then
		return
	end
	local d = toT / dist
	local angle = VecMath.flatAngle(sim.vel, d)
	if force or (angle >= 35 and angle <= 115) then
		if not canSpend(b, MC.SnapCut.Cost) then
			return
		end
		b.nextTechAt = t + b.rng:range(0.6, 1.2)
		press(b, "Cut", d)
		if
			dist > 16
			and ready(b, "BurstStep")
			and canSpend(b, MC.SnapCut.Cost + MC.BurstStep.Cost)
			and b.rng:next() < b.skill * 0.6
		then
			press(b, "Burst", d, 0.1)
		end
	elseif angle > 125 and sp >= 12 and ready(b, "MomentumCancel") and canSpend(b, MC.MomentumCancel.Cost) then
		-- plant; the sim restarts toward the held direction, a Burst in the
		-- window makes it explosive
		b.nextTechAt = t + b.rng:range(0.8, 1.4)
		press(b, "Cut", d)
		if b.rng:next() < b.skill * 0.7 then
			press(b, "Burst", d, 0.12)
		end
	end
end

---------------------------------------------------------------------------
-- motor (every Heartbeat)
---------------------------------------------------------------------------

local function refreshFilter()
	local list: { Instance } = {}
	for _, c in Actors.characters() do
		table.insert(list, c)
	end
	if folder then
		table.insert(list, folder)
	end
	local visuals = workspace:FindFirstChild("UBVisuals")
	if visuals then
		table.insert(list, visuals)
	end
	rayParams.FilterDescendantsInstances = list
end

local function standHeight(b: Bot): number
	if b.humanoid.RigType == Enum.HumanoidRigType.R15 then
		return b.humanoid.HipHeight + b.root.Size.Y / 2
	end
	return 3
end

local function buildEnv(b: Bot): MovementSim.Env
	local h, r = b.humanoid, b.root
	local pos = r.Position
	local vel = r.AssemblyLinearVelocity
	local stand = standHeight(b)
	local state = h:GetState()
	local grounded = h.FloorMaterial ~= Enum.Material.Air
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
	if not grounded and vel.Y <= 6 then
		grounded = workspace:Raycast(pos, Vector3.new(0, -(stand + 1.2), 0), rayParams) ~= nil
	end
	local ttl: number? = nil
	if not grounded then
		local far = workspace:Raycast(pos, Vector3.new(0, -120, 0), rayParams)
		if far then
			local height = math.max(0, pos.Y - stand - far.Position.Y)
			local g = workspace.Gravity
			ttl = (vel.Y + math.sqrt(math.max(vel.Y * vel.Y + 2 * g * height, 0))) / g
		end
	end
	local blocked = false
	local sv = flat(b.sim.vel)
	if sv.Magnitude > 6 then
		blocked = workspace:Raycast(pos, sv.Unit * BLOCK_RAY, rayParams) ~= nil
	end
	local aim = b.aim
	return {
		grounded = grounded,
		actualVel = vel,
		timeToLand = ttl,
		facing = r.CFrame.LookVector,
		pos = pos,
		aimYaw = if b.sim.holding and aim then VecMath.yaw(aim) else nil,
		blocked = blocked,
	}
end

-- Pre-pull line: (x - UBLineX) * UBLineSide >= 0 (the client's rule).
local function lineOf(c: Model): (number?, number)
	local lx = c:GetAttribute("UBLineX")
	local ls = c:GetAttribute("UBLineSide")
	if type(lx) ~= "number" or type(ls) ~= "number" or ls == 0 then
		return nil, 0
	end
	return lx, if ls > 0 then 1 else -1
end

local function applyLine(c: Model, pos: Vector3, v: Vector3): Vector3
	local lx, side = lineOf(c)
	if lx == nil then
		return v
	end
	local inside = (pos.X - lx) * side
	local along = v.X * side
	if inside < 0 then
		local back = math.clamp(-inside * 6, 3, 14)
		return Vector3.new(side * math.max(back, along), 0, v.Z)
	end
	if along < 0 then
		local allowed = math.min(-along, inside * 10)
		return Vector3.new(-side * allowed, 0, v.Z)
	end
	return v
end

local function lineClamp(b: Bot, target: Vector3): Vector3
	local lx, side = lineOf(b.model)
	if lx == nil or (target.X - lx) * side >= 1 then
		return target
	end
	return Vector3.new(lx + side, target.Y, target.Z)
end

-- Turns the brain's intent into sim input.
local function inputFor(b: Bot): MovementSim.Input
	local sim = b.sim
	if sim.holding then
		local s = b.step
		if s then
			local m = flat(s) / R
			if m.Magnitude > 1 then
				m = m.Unit
			end
			if m.Magnitude > 0.05 then
				return { move = m, sprint = false }
			end
		end
		return NO_INPUT
	end
	local goal = b.target
	if not goal then
		b.arrived = true
		return NO_INPUT
	end
	local target = lineClamp(b, goal)
	local d = flat(target - b.root.Position)
	local dist = d.Magnitude
	if b.marking then
		if dist < 0.2 then
			return NO_INPUT
		end
		local want = math.min(MK.ShuffleSpeed, dist * MARK_GAIN)
		return { move = (d / dist) * (want / MK.ShuffleSpeed), sprint = false }
	end
	local tv = b.targetVel
	if tv then
		-- a moving spot: match its velocity and close the gap smoothly (no
		-- stop radius, so no stop-start stutter behind a moving man)
		local corr = if dist > 0.05 then (d / dist) * math.min(dist * FOLLOW_GAIN, b.speed) else Vector3.zero
		local want = flat(tv) + corr
		local sp = math.min(want.Magnitude, b.speed)
		if sp < 0.6 then
			b.arrived = true
			return NO_INPUT
		end
		b.arrived = false
		local sprint = sp > JOG + 0.5
		local top = if sprint then SPRINT else JOG
		return { move = want.Unit * math.clamp(sp / top, 0.1, 1), sprint = sprint }
	end
	if dist < (if b.arrived then RESUME_RADIUS else ARRIVE_RADIUS) then
		b.arrived = true
		return NO_INPUT
	end
	b.arrived = false
	local want = math.min(b.speed, math.sqrt(2 * ARRIVE_DECEL * math.max(dist - 0.5, 0)))
	local sprint = want > JOG + 0.5
	local top = if sprint then SPRINT else JOG
	return { move = (d / dist) * math.clamp(want / top, 0.15, 1), sprint = sprint }
end

-- Fires the presses that are due. A directional press also steers this frame.
local function runPresses(b: Bot, input: MovementSim.Input, env: MovementSim.Env): MovementSim.Input
	local sim = b.sim
	local t = now()
	local out = input
	local i = 1
	while i <= #b.presses do
		local p = b.presses[i]
		if t < p.at then
			i += 1
			continue
		end
		table.remove(b.presses, i)
		if t - p.at > 0.5 then
			continue -- stale (frozen, teleported, ...)
		end
		if p.action == "Swing" then
			MovementSim.swing(sim, p.side, env)
		elseif p.action == "Fake" then
			MovementSim.fakeStep(sim, p.side)
		else
			local inp = out
			local dir = p.dir
			if dir and dir.Magnitude > 0.1 and not sim.holding then
				inp = { move = VecMath.flatUnit(dir), sprint = true }
			end
			local ok = MovementSim.press(sim, p.action :: any, inp, env)
			if ok then
				if dir then
					out = inp
				end
				if p.action == "Jump" and not sim.holding then
					b.precisionArmed = b.rng:next() < 0.35 + 0.5 * b.skill
					b.armedAt = t
				elseif p.action == "Dive" then
					b.popPending = b.rng:next() < 0.5 + 0.5 * b.skill
				end
			end
		end
	end
	return out
end

-- Player habits the brain's 10 Hz can't time: a Precision Landing just
-- before touchdown and a pop-up the moment the dive slide stops.
local function reflexes(b: Bot, env: MovementSim.Env)
	local sim = b.sim
	if b.precisionArmed then
		local ttl = env.timeToLand
		if sim.landedAt > b.armedAt + 0.05 then
			b.precisionArmed = false
		elseif sim.mode == "Air" and ttl ~= nil and ttl <= 0.07 then
			b.precisionArmed = false
			MovementSim.press(sim, "Slide", NO_INPUT, env)
		end
	end
	if b.popPending then
		if sim.mode == "Recover" then
			b.popPending = false
			local goal = b.target
			if goal then
				local d = flat(goal - b.root.Position)
				if d.Magnitude > 4 then
					MovementSim.press(sim, "Cut", { move = d.Unit, sprint = true }, env)
				end
			end
		elseif sim.mode == "Ground" or sim.mode == "Landing" or sim.holding then
			b.popPending = false
		end
	end
end

local function drive(b: Bot, out: MovementSim.Output, v: Vector3)
	local h, r = b.humanoid, b.root
	local sp = v.Magnitude
	h.WalkSpeed = sp
	h:Move(if sp > 0.05 then v / sp else Vector3.zero, false)
	local vy = out.setVertical
	if out.jump and vy then
		h.JumpPower = vy
		h:ChangeState(Enum.HumanoidStateType.Jumping)
		b.jumpArmed = true
	end
	if out.impulse or vy then
		local cur = r.AssemblyLinearVelocity
		r.AssemblyLinearVelocity = Vector3.new(v.X, vy or cur.Y, v.Z)
	end
end

local function facingFor(b: Bot, v: Vector3): (Vector3?, boolean)
	local sim = b.sim
	if sim.holding then
		return b.aim or b.face, true
	end
	if sim.mode == "Dive" or sim.mode == "DiveSlide" then
		return sim.diveDir, false
	end
	if b.face then
		return b.face, true
	end
	if v.Magnitude > 4 then
		return VecMath.flatUnit(v), false
	end
	return nil, false
end

local function onTeleport(b: Bot)
	local r = b.root
	r.AssemblyLinearVelocity = Vector3.zero
	r.AssemblyAngularVelocity = Vector3.zero
	MovementSim.reset(b.sim) -- keeps frozen, holding, exertion, cooldowns and the pivot
	b.sim.pos = r.Position
	table.clear(b.presses)
	b.arrived = false
	b.cut = nil
	b.precisionArmed = false
	b.popPending = false
	local yaw = b.model:GetAttribute("UBTeleportYaw")
	local look = if type(yaw) == "number" then VecMath.fromYaw(yaw) else VecMath.flatUnit(r.CFrame.LookVector)
	if look.Magnitude > 0.5 then
		b.facing = look
	end
end

local function motor(b: Bot, dt: number)
	local c, h, r = b.model, b.humanoid, b.root
	if h.Health <= 0 or not r.Parent then
		return
	end
	local sim = b.sim
	local step = math.min(dt, 1 / 15)
	sim.now = now() - step -- the sim clock is server time

	if b.jumpArmed then
		b.jumpArmed = false
		h.JumpPower = 0
	end
	local tp = c:GetAttribute("UBTeleport")
	if tp ~= b.lastTeleport then
		b.lastTeleport = tp
		onTeleport(b)
	end
	local frozen = c:GetAttribute("UBFrozen") == true
	if frozen ~= sim.frozen then
		MovementSim.setFrozen(sim, frozen)
		if frozen then
			table.clear(b.presses)
		end
	end

	local env = buildEnv(b)
	local hasDisc = c:GetAttribute("HasDisc") == true
	if hasDisc ~= b.holding then
		b.holding = hasDisc
		MovementSim.setHolding(sim, hasDisc, env.grounded)
		if not hasDisc then
			b.step = nil
			b.aim = nil
		end
	end
	if sim.holding then
		MovementSim.setPivot(sim, services.MovementService.pivotOf(b.id))
	end
	if b.marking ~= MovementSim.isMarking(sim) then
		MovementSim.setMarking(sim, b.marking)
	end

	local input = runPresses(b, inputFor(b), env)
	reflexes(b, env)
	local out = MovementSim.step(sim, input, env, step)
	if b.marking and not MovementSim.isMarking(sim) then
		b.marking = false -- a Cut / Dive / Burst ended the mark inside the sim
	end

	local v = applyLine(c, r.Position, flat(out.vel))
	if v ~= out.vel then
		sim.vel = v
		sim.lastOutVel = v
	end
	drive(b, out, v)

	local face, aiming = facingFor(b, v)
	if face and face.Magnitude > 0.5 then
		b.facing = VecMath.flatUnit(face)
	end
	local align = b.align
	if aiming ~= b.aiming then
		b.aiming = aiming
		align.Responsiveness = if aiming then 45 else 30
		align.MaxAngularVelocity = if aiming then 40 else 20
	end
	if b.facing:Dot(b.alignFacing) < 0.99995 then
		b.alignFacing = b.facing
		align.CFrame = CFrame.lookAt(Vector3.zero, b.facing)
	end

	local mode = MovementSim.poseMode(sim)
	if mode ~= b.poseMode then
		b.poseMode = mode
		services.MovementService.setBotMode(b.id, mode)
	end
	for _, e in out.events do
		services.MovementService.botTech(b.id, e.tech, e.dir, mode, e.quality, e.info, e.t)
	end
	local pp = out.pivotPos
	if pp then
		services.MovementService.setPivot(b.id, pp)
	end

	local loco = b.loco
	if loco then
		local vel = r.AssemblyLinearVelocity
		local raw = Vector3.new(vel.X, 0, vel.Z).Magnitude
		b.speedSmooth += (raw - b.speedSmooth) * (1 - math.exp(-SPEED_SMOOTH * step))
		local state = h:GetState()
		local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
		local clock = os.clock()
		if airborne then
			b.airSince = b.airSince or clock
		else
			b.airSince = nil
		end
		local lm: Locomotion.Mode = "Ground"
		if POSE_MODES[mode] then
			lm = "Pose"
		elseif airborne and (state == Enum.HumanoidStateType.Jumping or clock - (b.airSince :: number) > AIR_GRACE) then
			lm = if vel.Y > 2 then "Rising" else "Falling"
		end
		Locomotion.update(loco, step, b.speedSmooth, lm)
	end
end

---------------------------------------------------------------------------
-- reading the game (one snapshot per frame)
---------------------------------------------------------------------------

local function flightFor(d: any): Flight?
	local s = d and d.sim
	if not d or d.mode ~= "Flight" or not s then
		return nil
	end
	local key = tostring(d.id) .. ":" .. tostring(d.flightId)
	local cached = flights[d.id]
	if cached and cached.key == key then
		return cached
	end
	local copy = DiscPhysics.copy(s)
	local ground = d.groundY
	local base = d.launchTime
	local samples: { FlightSample } = {}
	local land = Vector3.new(copy.px, ground, copy.pz)
	local landT = base + copy.t
	while copy.t < DiscConfig.Physics.MaxFlightTime do
		DiscPhysics.step(copy, FLIGHT_DT, d.wind)
		local p = Vector3.new(copy.px, copy.py, copy.pz)
		table.insert(samples, { t = base + copy.t, pos = p })
		land = Vector3.new(copy.px, ground, copy.pz)
		landT = base + copy.t
		if copy.py - ground <= DiscConfig.Physics.GroundContact then
			break
		end
	end
	local fl: Flight = { key = key, samples = samples, land = land, landT = landT }
	flights[d.id] = fl
	return fl
end

local function getWorld(): World?
	local w = world
	if w and w.frame == frameNo then
		return w
	end
	local e = services.MatchService.engine()
	if not e then
		return nil
	end
	local bodies: { [number]: Body } = {}
	local team: { [string]: { Body } } = { A = {}, B = {} }
	local lines: { [string]: { number } } = {}
	for _, tm in { "A", "B" } do
		for _, a in services.PlayerService.onTeam(tm) do
			local root = services.PlayerService.root(a)
			if root then
				local body: Body = {
					id = a.id,
					team = tm,
					isBot = a.isBot,
					pos = root.Position,
					vel = root.AssemblyLinearVelocity,
				}
				bodies[a.id] = body
				table.insert(team[tm], body)
			end
		end
		lines[tm] = services.TeamService.lineFor(tm)
	end
	local d = services.MatchService.disc()
	local mode = services.MatchService.mode()
	local nw: World = {
		frame = frameNo,
		t = now(),
		e = e,
		phase = services.MatchService.phase(),
		d = d,
		f = e.field,
		bodies = bodies,
		team = team,
		lines = lines,
		flight = flightFor(d),
		chasers = {},
		markerChecked = {},
		teamSize = mode.TeamSize,
		stall = services.DefenseService.stallCount(),
		stallMax = mode.StallMax,
	}
	world = nw
	return nw
end

local function nearest(pos: Vector3, list: { Body }, except: number?): (Body?, number)
	local best, bestD = nil, math.huge
	for _, body in list do
		if body.id ~= except then
			local dd = flat(body.pos - pos).Magnitude
			if dd < bestD then
				best, bestD = body, dd
			end
		end
	end
	return best, bestD
end

-- Clearance of the lane from `from` to `to`, ignoring anyone within `ignore`
-- studs of the thrower (the marker: the step-out goes around them).
local function laneClearance(from: Vector3, to: Vector3, list: { Body }, ignore: number): number
	local best = math.huge
	for _, body in list do
		local p = flat(body.pos)
		if (p - flat(from)).Magnitude > ignore then
			local c = VecMath.closestOnSegment(flat(from), flat(to), p)
			best = math.min(best, (c - p).Magnitude)
		end
	end
	return best
end

local function inField(f: FieldGeometry.Field, p: Vector3, inset: number, y: number): Vector3
	local c = FieldGeometry.clampInBounds(f, p, inset)
	return Vector3.new(c.X, y, c.Z)
end

local function forceOf(defense: string): string
	local v = Net.state():GetAttribute("Force" .. defense)
	return if v == "BH" then "BH" else "FH"
end

local function leftHanded(id: number?): boolean
	if not id then
		return false
	end
	local c = Actors.characterOf(id)
	return c ~= nil and c:GetAttribute("LeftHanded") == true
end

-- The open side (world, flat unit) for `team`'s offense: the side the
-- defenders' force leaves open, for a thrower facing upfield (`r` = right).
local function openSide(team: string, holderId: number?, r: Vector3): Vector3
	local mirror = if leftHanded(holderId) then -1 else 1
	local fh = r * mirror
	return if forceOf(RulesEngine.other(team)) == "BH" then -fh else fh
end

-- The holder's possession that team plans are built around (the pull's
-- holder is the puller, not an attacker).
local function possessionHolder(e: RulesEngine.State): number?
	if e.disc == "Held" and e.holderTeam == e.offense then
		return e.holder
	end
	return nil
end

---------------------------------------------------------------------------
-- team plans (roles and marks, sticky for a possession)
---------------------------------------------------------------------------

local function buildOffense(p: TeamPlan, w: World, team: string, ref: Vector3, holder: number?)
	local f = FieldGeometry.attackDirection(w.e.attack[team])
	local mates: { Body } = {}
	for _, body in w.team[team] do
		if body.id ~= holder then
			table.insert(mates, body)
		end
	end
	table.sort(mates, function(a, b)
		return flat(a.pos - ref).Magnitude < flat(b.pos - ref).Magnitude
	end)
	local handlers = math.min(if w.teamSize >= 5 then 2 else 1, #mates)
	for i, body in mates do
		if i <= handlers then
			p.roles[body.id] = "Handler"
			table.insert(p.handlers, body.id)
		else
			p.roles[body.id] = "Cutter"
			table.insert(p.cutters, body.id)
		end
	end
	table.sort(p.cutters, function(a, b)
		local pa, pb = w.bodies[a], w.bodies[b]
		return (pa.pos - ref):Dot(f) < (pb.pos - ref):Dot(f)
	end)
end

local function buildDefense(p: TeamPlan, w: World, team: string, ref: Vector3, holder: number?)
	local attackers: { Body } = {}
	for _, body in w.team[RulesEngine.other(team)] do
		if body.id ~= holder then
			table.insert(attackers, body)
		end
	end
	local marker = nearest(ref, w.team[team], nil)
	p.marker = if marker then marker.id else nil
	-- greedy closest pairs: every bot defender (but the marker) guards one attacker
	local pairs: { { d: number, def: number, att: number } } = {}
	for _, def in w.team[team] do
		if def.isBot and def.id ~= p.marker then
			for _, att in attackers do
				table.insert(pairs, { d = flat(def.pos - att.pos).Magnitude, def = def.id, att = att.id })
			end
		end
	end
	table.sort(pairs, function(a, b)
		return a.d < b.d
	end)
	local taken: { [number]: boolean } = {}
	for _, pr in pairs do
		if p.guards[pr.def] == nil and not taken[pr.att] then
			p.guards[pr.def] = pr.att
			taken[pr.att] = true
		end
	end
end

local function teamPlan(w: World, team: string, ref: Vector3): TeamPlan
	local e = w.e
	local offense = e.offense == team
	local holder = possessionHolder(e)
	local p = plans[team]
	if p and p.point == e.pointNumber and p.offense == offense and (holder == nil or holder == p.holder) then
		return p
	end
	local np: TeamPlan = {
		point = e.pointNumber,
		offense = offense,
		holder = holder,
		roles = {},
		handlers = {},
		cutters = {},
		nextCutAt = w.t + planRng:NextNumber(0.5, 1.2),
		guards = {},
		marker = nil,
		markerAwaySince = nil,
	}
	plans[team] = np
	if offense then
		buildOffense(np, w, team, ref, holder)
	else
		buildDefense(np, w, team, ref, holder)
	end
	return np
end

-- A human marker who never steps up loses the mark to the nearest bot.
local function checkMarker(p: TeamPlan, w: World, team: string, holder: number, pivot: Vector3)
	if w.markerChecked[team] then
		return
	end
	w.markerChecked[team] = true
	local m = if p.marker then w.bodies[p.marker] else nil
	if m and (m.isBot or flat(m.pos - pivot).Magnitude <= DM.StallRange + 1) then
		p.markerAwaySince = nil
		return
	end
	local since = p.markerAwaySince
	if since == nil then
		p.markerAwaySince = w.t
		if m ~= nil then
			return
		end
	elseif w.t - since < 1.2 then
		return
	end
	local best, bestD = nil, math.huge
	for _, body in w.team[team] do
		if body.isBot and body.id ~= holder then
			local dd = flat(body.pos - pivot).Magnitude
			if dd < bestD then
				best, bestD = body, dd
			end
		end
	end
	if best then
		p.marker = best.id
		p.guards[best.id] = nil
		p.markerAwaySince = nil
	end
end

---------------------------------------------------------------------------
-- flights: chasing, jumping, reaching, laying out
---------------------------------------------------------------------------

-- Earliest catchable point of the flight `pos` can reach in time (inside
-- `field` when given: a catch out of bounds is a turnover).
local function interceptFrom(
	pos: Vector3,
	fl: Flight,
	groundY: number,
	reaction: number,
	t: number,
	field: FieldGeometry.Field?
): FlightSample?
	for _, smp in fl.samples do
		local tLeft = smp.t - t
		if
			tLeft > 0
			and smp.pos.Y - groundY < CATCH_HEIGHT
			and (field == nil or FieldGeometry.inBounds(field, smp.pos))
		then
			if flat(smp.pos - pos).Magnitude / SPRINT + reaction <= tLeft + 0.05 then
				return smp
			end
		end
	end
	return nil
end

-- The bot of `team` that should chase the current flight (0 = none): the
-- earliest arrival, unless a human teammate gets there about as fast.
local function chaserOf(w: World, team: string): number
	local cached = w.chasers[team]
	if cached ~= nil then
		return cached
	end
	local fl = w.flight
	local bestBot, bestBotT = 0, math.huge
	local bestHumanT = math.huge
	if fl then
		local groundY = w.d.groundY
		for _, body in w.team[team] do
			local b = brains[body.id]
			local reaction = if b then b.reaction * (1.4 - b.skill) else 0.15
			local smp = interceptFrom(body.pos, fl, groundY, reaction, w.t, if w.d.pull then nil else w.f)
			if smp then
				if body.isBot then
					if smp.t < bestBotT then
						bestBot, bestBotT = body.id, smp.t
					end
				elseif smp.t < bestHumanT then
					bestHumanT = smp.t
				end
			end
		end
		if bestHumanT <= bestBotT + 0.1 then
			bestBot = 0
		end
		-- a pull nobody can catch: the nearest receiver goes to where it lands
		if bestBot == 0 and bestHumanT == math.huge and w.d.pull and team == w.e.offense then
			local n = nearest(fl.land, w.team[team], nil)
			if n and n.isBot then
				bestBot = n.id
			end
		end
	end
	w.chasers[team] = bestBot
	return bestBot
end

-- Closest approach of the flight to `pos` (chest height) within `horizon`.
local function closestApproach(fl: Flight, pos: Vector3, t: number, horizon: number): (number, FlightSample?)
	local best, bestS = math.huge, nil
	local chest = pos + Vector3.new(0, DiscConfig.Catch.ChestHeight, 0)
	for _, smp in fl.samples do
		if smp.t > t + horizon then
			break
		end
		if smp.t > t then
			local dd = (smp.pos - chest).Magnitude
			if dd < best then
				best, bestS = dd, smp
			end
		end
	end
	return best, bestS
end

local function reachFor(b: Bot, point: Vector3)
	local dir = point - (b.root.Position + Vector3.new(0, 1.5, 0))
	services.CatchingService.reach(b.id, dir)
	if MovementSim.isAirborne(b.sim) then
		MovementSim.noteAerialReach(b.sim, dir)
	end
end

-- Runs toward the earliest reachable point of disc `d`'s flight (inside
-- `field` when given); jumps, reaches and lays out like a player. Returns
-- false when it can't get there.
local function chase(b: Bot, d: any, field: FieldGeometry.Field?): boolean
	local fl = flightFor(d)
	if not fl then
		return false
	end
	local t = now()
	local sim = b.sim
	local pos = b.root.Position
	local groundY = d.groundY
	local smp = interceptFrom(pos, fl, groundY, b.reaction * (1.4 - b.skill), t, field)
	local point = if smp then smp.pos elseif d.pull then fl.land else nil
	if not point then
		return false
	end
	b.cut = nil
	b.face = nil
	clearMark(b)
	local goal = Vector3.new(point.X, pos.Y, point.Z)
	b.target = goal
	b.targetVel = nil
	b.speed = SPRINT

	local miss, near = closestApproach(fl, pos, t, 0.6)
	if near then
		local tc = near.t - t
		local height = near.pos.Y - groundY
		local flatDist = flat(near.pos - pos).Magnitude
		local grounded = sim.mode == "Ground" or sim.mode == "Landing"
		-- a high disc: jump so the apex meets it
		if grounded and height > 6 and flatDist < 4 and tc > 0.12 and tc < 0.4 then
			press(b, "Jump")
		end
		-- reach for anything passing just outside the body
		if flatDist < 5 and tc < 0.3 and miss > 1.6 then
			reachFor(b, near.pos)
		end
		-- lay out for a low disc that will pass just out of reach
		if b.diveRoll ~= fl.key and miss > 2.4 and miss < 7.5 and tc < 0.42 and height < 4.5 and flatDist > 2.5 then
			b.diveRoll = fl.key
			if b.rng:next() < b.skill and ready(b, "Dive") then
				press(b, "Dive", flat(near.pos - pos))
			end
		end
		-- in the air: redirect toward a catch point that moved
		if sim.mode == "Air" and not sim.airRedirectUsed and sim.vel.Magnitude > 6 then
			local toGoal = flat(goal - pos)
			if toGoal.Magnitude > 3 and VecMath.flatAngle(sim.vel, toGoal) > 35 then
				press(b, "Cut", toGoal)
			end
		end
	end
	return true
end

---------------------------------------------------------------------------
-- offense
---------------------------------------------------------------------------

-- Starts a cut to `target`: a short set-up step first, either across the
-- cut (it then fires as a Snap Cut) or away from it (a plant and an
-- explosive restart), optionally a jab when a defender is tight.
local function startCut(b: Bot, w: World, kind: string, target: Vector3)
	local pos = b.root.Position
	local goal = inField(w.f, target, 4, pos.Y)
	local cutDir = VecMath.flatUnit(goal - pos)
	if cutDir.Magnitude < 0.5 then
		cutDir = FieldGeometry.attackDirection(w.e.attack[b.team])
	end
	local turn = if b.rng:next() < 0.55
		then math.rad(b.rng:range(70, 100)) * (if b.rng:next() < 0.5 then -1 else 1)
		else math.pi + math.rad(b.rng:range(-20, 20))
	local setLen = b.rng:range(3, 5)
	local setDir = CFrame.Angles(0, turn, 0):VectorToWorldSpace(cutDir)
	if not FieldGeometry.inBounds(w.f, pos + setDir * (setLen + 3)) then
		setDir = CFrame.Angles(0, -turn, 0):VectorToWorldSpace(cutDir) -- step the other way
	end
	local opp = w.team[RulesEngine.other(b.team)]
	local _, defDist = nearest(pos, opp, nil)
	local t = now()
	b.cut = {
		kind = kind,
		phase = "Set",
		target = goal,
		setFrom = pos,
		setDir = VecMath.flatUnit(setDir),
		setLen = setLen,
		phaseAt = t,
		untilT = t + 3.2,
		juke = defDist < 5 and b.rng:next() < 0.4 * b.skill,
	}
end

-- Runs the current cut. Returns false once it is over.
local function runCut(b: Bot): boolean
	local c = b.cut
	if not c then
		return false
	end
	local t = now()
	local pos = b.root.Position
	local sim = b.sim
	if t > c.untilT then
		b.cut = nil
		return false
	end
	if c.phase == "Set" then
		-- the set-up step away from the cut, kept at speed
		steerTo(b, c.setFrom + c.setDir * (c.setLen + 10), JOG + 4, false)
		local done = (pos - c.setFrom):Dot(c.setDir) >= c.setLen or t - c.phaseAt > 0.55
		if done then
			c.phaseAt = t
			if c.juke and sim.vel.Magnitude > 8 and sim.mode == "Ground" and canSpend(b, 20) then
				-- jab along the line (Fake Commit), then cut away (Sold)
				local line = VecMath.flatUnit(sim.vel)
				press(b, "Cut", line)
				b.target = pos + line * 8
				c.phase = "Jab"
			else
				c.phase = "Go"
				steerTo(b, c.target, SPRINT, true)
			end
		end
		return true
	elseif c.phase == "Jab" then
		if t - c.phaseAt >= 0.28 then
			c.phase = "Go"
			c.phaseAt = t
			steerTo(b, c.target, SPRINT, true, true)
		end
		return true
	end
	steerTo(b, c.target, SPRINT, false)
	if flat(c.target - pos).Magnitude < 3 then
		b.cut = nil
		return false
	end
	return true
end

-- Stack slot k of n: a central lane ~18 studs downfield of the disc,
-- compressed near the back of the attacking end zone.
local function stackSlot(w: World, ref: Vector3, f: Vector3, r: Vector3, k: number, n: number, y: number): Vector3
	local field = w.f
	local center = field.center
	local lat = math.clamp((ref - center):Dot(r) * 0.35, -(field.halfWidth - 12), field.halfWidth - 12)
	local back = field.halfLength + field.endZone - 4
	local start = (ref - center):Dot(f) + 18
	local spacing = math.min(8, (back - start) / math.max(n, 1))
	if spacing < 3 then
		spacing = 3
		start = back - 3 * n
	end
	local along = math.min(start + (k - 1) * spacing, back)
	local p = center + f * along + r * lat
	return Vector3.new(p.X, y, p.Z)
end

local function handler(b: Bot, w: World, plan: TeamPlan, ref: Vector3, f: Vector3, open: Vector3, holder: number?)
	local pos = b.root.Position
	local idx = table.find(plan.handlers, b.id) or 1
	-- the dump comes back for the disc when the stall climbs
	if idx == 1 and holder and not b.cut and w.stall >= math.max(3, math.floor(w.stallMax * 0.5)) then
		local spot = ref - f * 3 - open * 11
		local d = flat(spot - pos)
		if d.Magnitude > 6 then
			startCut(b, w, "Dump", spot)
			runCut(b)
			return
		end
	end
	local spot = if idx == 1 then ref - f * 8 - open * 7 else ref + f * 3 + open * 14
	spot = inField(w.f, spot, 4, pos.Y)
	local dist = flat(spot - pos).Magnitude
	steerTo(b, spot, if dist > 10 then SPRINT else JOG, dist > 12)
end

local function stackCutter(
	b: Bot,
	w: World,
	plan: TeamPlan,
	ref: Vector3,
	f: Vector3,
	r: Vector3,
	open: Vector3,
	holder: number?
)
	local t = w.t
	local pos = b.root.Position
	-- the front-most bot cutter takes the next cut
	local nextUp: number? = nil
	for _, id in plan.cutters do
		if brains[id] and not brains[id].cut then
			nextUp = id
			break
		end
	end
	if holder and nextUp == b.id and t >= plan.nextCutAt then
		local i = table.find(plan.cutters, b.id)
		if i then
			table.remove(plan.cutters, i)
			table.insert(plan.cutters, b.id)
		end
		plan.nextCutAt = t + planRng:NextNumber(1.0, 1.9)
		if b.rng:next() < 0.6 then
			startCut(b, w, "Under", ref + f * b.rng:range(9, 20) + open * b.rng:range(8, 18))
		else
			local deep = math.max(40, b.rng:range(0.3, 0.48) * w.f.length)
			startCut(b, w, "Deep", ref + f * deep + open * b.rng:range(2, 12))
		end
		runCut(b)
		return
	end
	local k = table.find(plan.cutters, b.id) or #plan.cutters
	local slot = stackSlot(w, ref, f, r, k, #plan.cutters, pos.Y)
	local dist = flat(slot - pos).Magnitude
	steerTo(b, slot, if dist > 12 then SPRINT else JOG, dist > 14)
end

local function spreadCutter(b: Bot, w: World, plan: TeamPlan, ref: Vector3, f: Vector3, r: Vector3, open: Vector3)
	local t = w.t
	local pos = b.root.Position
	if t < b.nextSpotAt and b.target then
		return
	end
	b.nextSpotAt = t + b.rng:range(1.2, 2.6)
	local field = w.f
	local n = math.max(#plan.cutters, 1)
	local k = table.find(plan.cutters, b.id) or 1
	local laneW = (field.width - 16) / n
	local laneCenter = -field.halfWidth + 8 + (k - 0.5) * laneW
	local opp = w.team[RulesEngine.other(b.team)]
	local mates = w.team[b.team]
	local best, bestScore = nil, -math.huge
	for _ = 1, 10 do
		local along = (ref - field.center):Dot(f) + b.rng:range(0.10, 0.38) * field.length
		local lat = laneCenter + b.rng:range(-laneW / 2 + 2, laneW / 2 - 2)
		local spot = inField(field, field.center + f * along + r * lat, 6, pos.Y)
		local _, openD = nearest(spot, opp, nil)
		local _, crowd = nearest(spot, mates, b.id)
		local score = math.min(openD, 20) * 1.5
			+ math.min(crowd, 15)
			+ (spot - ref):Dot(f) * 0.05
			+ (if (spot - ref):Dot(open) > 0 then 3 else 0)
		if score > bestScore then
			best, bestScore = spot, score
		end
	end
	if not best then
		return
	end
	local away = flat(best - pos)
	if away.Magnitude > 10 then
		startCut(b, w, "Spot", best)
		runCut(b)
	else
		steerTo(b, best, JOG, false)
	end
end

local function thinkOffense(b: Bot, w: World, ref: Vector3, holder: number?)
	clearMark(b)
	b.face = nil
	local plan = teamPlan(w, b.team, ref)
	local f = FieldGeometry.attackDirection(w.e.attack[b.team])
	local r = rightOf(f)
	local open = openSide(b.team, holder, r)
	local role = plan.roles[b.id]
	if role == nil then
		role = "Cutter"
		plan.roles[b.id] = role
		table.insert(plan.cutters, b.id)
	end
	if b.cut and runCut(b) then
		return
	end
	if role == "Handler" then
		handler(b, w, plan, ref, f, open, holder)
	elseif w.teamSize >= 5 then
		stackCutter(b, w, plan, ref, f, r, open, holder)
	else
		spreadCutter(b, w, plan, ref, f, r, open)
	end
end

---------------------------------------------------------------------------
-- defense
---------------------------------------------------------------------------

local function windupLive(c: Model, t: number): (boolean, number)
	local windup = c:GetAttribute("Windup")
	if type(windup) ~= "number" or windup <= 0 or t - windup > 3 then
		return false, 0
	end
	local release = c:GetAttribute("Release")
	local fake = c:GetAttribute("Fake")
	if (type(release) == "number" and release >= windup) or (type(fake) == "number" and fake >= windup) then
		return false, 0
	end
	return true, windup
end

-- The marker (diag 3 §5): shade the break side of the pivot, mirror the
-- lagged step, bite on fakes, stance from the live windup, jump-block hops.
-- `up` points from the thrower toward the end zone they attack.
local function runMark(b: Bot, holderId: number, up: Vector3, force: string)
	local hroot = Actors.rootOf(holderId)
	local hc = hroot and hroot.Parent
	if not hroot or not hc or not hc:IsA("Model") then
		return
	end
	local t = now()
	local m = b.mark
	if not m or m.holder ~= holderId then
		local ft = hc:GetAttribute("FakeT")
		m = {
			holder = holderId,
			lastFakeT = if type(ft) == "number" then ft else 0,
			lastBite = -math.huge,
			biteStart = 0,
			biteUntil = 0,
			biteLateral = 0,
			biteHigh = false,
			hopKey = 0,
		}
		b.mark = m
	end
	local mk = m :: MarkState
	b.cut = nil
	local skill = b.skill
	local pos = b.root.Position
	local pivot = services.MovementService.pivotOf(holderId)
	local P = pivot or hroot.Position
	local upU = VecMath.flatUnit(up)
	local r = rightOf(upU)
	local mirrorSign = if hc:GetAttribute("LeftHanded") == true then -1 else 1
	-- FH force: take away the backhand side (the thrower's left)
	local shade = if force == "BH" then r * mirrorSign else -r * mirrorSign

	-- mirror the step the thrower had a reaction time ago
	local lag = 0.30 - 0.15 * skill
	local lagged = services.MovementService.positionAt(holderId, t - lag)
	local stepLat = flat(lagged - P):Dot(r) / HD.BodyShare
	local mirror = math.clamp(stepLat * (0.55 + 0.35 * skill), -DM.MirrorMax, DM.MirrorMax)

	-- bite on a fake
	local ft = hc:GetAttribute("FakeT")
	if type(ft) == "number" and ft > mk.lastFakeT then
		mk.lastFakeT = ft
		if t - mk.lastBite > 1.2 and b.rng:next() < 0.6 - 0.4 * skill then
			local side = hc:GetAttribute("FakeSide")
			local fs = if type(side) == "number" then side else 0
			local thrRight = VecMath.flatUnit(hroot.CFrame.RightVector)
			local lat = thrRight:Dot(r) * fs
			mk.lastBite = t
			mk.biteStart = t + b.reaction * (1.2 - skill)
			mk.biteUntil = mk.biteStart + 0.45
			mk.biteLateral = if math.abs(lat) > 0.2 then math.sign(lat) * 1.4 else 0
			mk.biteHigh = OVERHEAD[hc:GetAttribute("WindupType") :: any] == true
		end
	end
	local biting = t >= mk.biteStart and t < mk.biteUntil
	local lateral = mirror + (if biting then mk.biteLateral else 0)
	local spot = P + upU * DM.MarkDistance + shade * DM.Shade + r * lateral
	local target = Vector3.new(spot.X, pos.Y, spot.Z)

	-- stance: Low, High only for a live overhead windup (seen after the reaction)
	local stance = "Low"
	local live, windupAt = windupLive(hc, t)
	if live and OVERHEAD[hc:GetAttribute("WindupType") :: any] and t - windupAt >= b.reaction * (1.4 - skill) then
		stance = "High"
	end
	if biting and mk.biteHigh then
		stance = "High"
	end
	setStance(b, true, stance)

	-- jump-block a hop (one roll per possession: the holder hops once)
	if pivot and hc:GetAttribute("MS") == "Air" and stance == "Low" then
		local held = hc:GetAttribute("HeldSince")
		local key = if type(held) == "number" then held else 1
		if mk.hopKey ~= key then
			mk.hopKey = key
			if b.rng:next() < 0.35 * skill then
				press(b, "Jump", nil, b.reaction * (1.2 - skill))
			end
		end
	end

	local away = flat(target - pos).Magnitude
	if away > (if b.marking then 8 else 5) then
		-- still getting there: run (facing the way we run)
		b.face = nil
		b.marking = false
		steerTo(b, target, SPRINT, false)
	else
		b.face = VecMath.flatUnit(P - pos)
		b.marking = true
		b.target = target
		b.targetVel = nil
		b.speed = MK.ShuffleSpeed
	end
end

local function guard(b: Bot, w: World, plan: TeamPlan, ref: Vector3, holder: number?)
	clearMark(b)
	b.face = nil
	local offense = RulesEngine.other(b.team)
	local up = FieldGeometry.attackDirection(w.e.attack[offense])
	local pos = b.root.Position
	local attId = plan.guards[b.id]
	local att = if attId and attId ~= holder then w.bodies[attId] else nil
	if not att then
		-- pick up the nearest attacker nobody else guards
		local taken: { [number]: boolean } = {}
		for def, a in plan.guards do
			if def ~= b.id then
				taken[a] = true
			end
		end
		local best, bestD = nil, math.huge
		for _, body in w.team[offense] do
			if body.id ~= holder and not taken[body.id] then
				local dd = flat(body.pos - pos).Magnitude
				if dd < bestD then
					best, bestD = body, dd
				end
			end
		end
		att = best
		if best then
			plan.guards[b.id] = best.id
		else
			plan.guards[b.id] = nil
		end
	end
	if not att then
		-- nobody left: help deep
		local spot = inField(w.f, ref + up * (0.12 * w.f.length), 4, pos.Y)
		steerTo(b, spot, JOG, false)
		return
	end
	local lag = b.reaction * (1.5 - b.skill)
	local lagged = services.MovementService.positionAt(att.id, w.t - lag)
	local toDisc = VecMath.flatUnit(ref - lagged)
	local deep = (lagged - ref):Dot(up)
	local spot = lagged + up * (if deep > 25 then 4 else 3) + toDisc * 2 + flat(att.vel) * 0.3
	spot = inField(w.f, spot, 2, pos.Y)
	local dist = flat(spot - pos).Magnitude
	-- on the man: square up between him and the disc (shuffle, backpedal)
	b.squared = if b.squared then dist < 6 else dist < 3
	b.face = if b.squared then VecMath.flatUnit((att.pos + ref) / 2 - pos) else nil
	steerTo(b, spot, SPRINT, dist > 10)
	b.targetVel = flat(att.vel)
end

local function thinkDefense(b: Bot, w: World, ref: Vector3, holder: number?)
	local plan = teamPlan(w, b.team, ref)
	if holder then
		local hb = w.bodies[holder]
		local pivot = services.MovementService.pivotOf(holder) or (if hb then hb.pos else ref)
		checkMarker(plan, w, b.team, holder, pivot)
		if plan.marker == b.id then
			local up = FieldGeometry.attackDirection(w.e.attack[RulesEngine.other(b.team)])
			runMark(b, holder, up, forceOf(b.team))
			return
		end
	elseif plan.marker == b.id and w.e.disc == "Ground" then
		-- set up the mark on the disc before it is picked up
		clearMark(b)
		local up = FieldGeometry.attackDirection(w.e.attack[RulesEngine.other(b.team)])
		local pos = b.root.Position
		local spot = inField(w.f, ref + up * DM.MarkDistance, 2, pos.Y)
		b.face = if flat(spot - pos).Magnitude < 4 then VecMath.flatUnit(ref - pos) else nil
		steerTo(b, spot, SPRINT, false)
		return
	end
	guard(b, w, plan, ref, holder)
end

---------------------------------------------------------------------------
-- the holder
---------------------------------------------------------------------------

local function markerNear(w: World, team: string, P: Vector3): Body?
	local markerId = Net.state():GetAttribute("MarkerId")
	if type(markerId) == "number" and markerId ~= 0 then
		local m = w.bodies[markerId]
		if m and m.team ~= team and flat(m.pos - P).Magnitude < 7 then
			return m
		end
	end
	local m, dist = nearest(P, w.team[RulesEngine.other(team)], nil)
	if m and dist < 6 then
		return m
	end
	return nil
end

local function chooseReceiver(b: Bot, w: World, P: Vector3, urgent: boolean): (Body?, number)
	local field = w.f
	local side: FieldGeometry.Side = w.e.attack[b.team] :: any
	local up = FieldGeometry.attackDirection(side)
	local opp = w.team[RulesEngine.other(b.team)]
	local best, bestScore = nil, -math.huge
	for _, body in w.team[b.team] do
		if body.id ~= b.id then
			local lead = body.pos + flat(body.vel) * 0.9
			if FieldGeometry.inBounds(field, lead) then
				local _, openD = nearest(lead, opp, nil)
				local lane = math.min(laneClearance(P, lead, opp, 4.5), 10)
				local progress = (lead - P):Dot(up)
				local dist = flat(lead - P).Magnitude
				local score = math.min(openD, 18) * 1.2
					+ lane * 1.6
					+ progress * 0.08
					- math.max(0, dist - 0.45 * field.length) * 0.15
				if dist < 8 then
					score -= 20
				end
				if FieldGeometry.inEndZone(field, lead, side) then
					score += 12
				end
				if urgent then
					score += 30 - dist * 0.2 -- anyone close will do
				end
				if score > bestScore then
					best, bestScore = body, score
				end
			end
		end
	end
	return best, bestScore
end

-- Plans the release against the marker: side away from the shade in the
-- throw frame, step out (0.6 + 0.4 x skill) R, Low against a High mark,
-- a hammer over a closed lane.
local function planRelease(b: Bot, w: World, h: HoldPlan, rec: Body, P: Vector3, urgent: boolean)
	local lead = rec.pos + flat(rec.vel) * 0.6
	local aim = VecMath.flatUnit(lead - P)
	if aim.Magnitude < 0.5 then
		aim = FieldGeometry.attackDirection(w.e.attack[b.team])
	end
	b.aim = aim
	local ra = rightOf(aim)
	local m = markerNear(w, b.team, P)
	local mLat = if m then flat(m.pos - P):Dot(ra) else 0
	local side = if m and math.abs(mLat) > 0.3 then (if mLat > 0 then -1 else 1) elseif b.rng:next() < 0.6 then -1 else 1
	local height = "Mid"
	if m then
		local mc = Actors.characterOf(m.id)
		local stance = mc and mc:GetAttribute("Mark")
		local tight = flat(m.pos - P).Magnitude < 4.5 and b.rng:next() < 0.4
		if stance == "High" or tight then
			height = "Low" -- under High hands, or a wide step-out past a tight mark
		end
	end
	local throwType = if side < 0 then "Backhand" else "Forehand"
	local opp = w.team[RulesEngine.other(b.team)]
	local dist = flat(lead - P).Magnitude
	if laneClearance(P, lead, opp, 4.5) < 3 and dist > 30 and b.rng:next() < 0.5 then
		throwType = "Hammer"
		height = "Mid"
	end
	h.receiver = rec.id
	h.throwType = throwType
	h.height = height
	h.side = side
	h.attempts += 1
	local t = now()
	local fake = m ~= nil
		and not urgent
		and not OVERHEAD[throwType]
		and b.rng:next() < 0.35 * b.skill
		and ready(b, "PivotSwing")
		and canSpend(b, HD.SwingCost)
	if fake then
		-- fake toward the mark, then Quick Swing away inside the Sold window
		-- (timed here, not by the 10 Hz think); releasing right after the
		-- swing is a Break
		local delay = b.rng:range(0.15, 0.24)
		services.ThrowService.fake(b.id, throwType, -side)
		press(b, "Fake", nil, 0, -side)
		press(b, "Swing", nil, delay, side)
		b.step = nil
		task.delay(delay, function()
			if brains[b.id] == b and b.hold == h then
				services.ThrowService.beginCharge(b.id, throwType)
			end
		end)
		h.phase = "Swing"
		h.at = t
		h.charged = t + delay
		h.swingEnd = t + delay + HD.SwingTime
	else
		local stepLen = if OVERHEAD[throwType] then 0.25 * R else (0.6 + 0.4 * b.skill) * R
		b.step = ra * (side * stepLen) + aim * (0.1 * R)
		services.ThrowService.beginCharge(b.id, throwType)
		h.charged = t
		h.phase = "Setup"
		h.at = t
	end
end

local function variant(params: any, changes: { [string]: any }): any
	local c = table.clone(params)
	for k, v in changes do
		c[k] = v
	end
	return c
end

-- Solves the pass from the real pivot + step, tests the release against the
-- mark and throws. When it would be blocked, the first of 2-3 candidate
-- releases (Low, the other side, a hammer) that gets through is planned for
-- the next think (re-solved then); when none does, the bot Quick Swings to
-- the other side and looks again. At most one solve runs per frame.
local function release(b: Bot, w: World, h: HoldPlan, urgent: boolean)
	if lastSolveFrame == frameNo then
		return -- another bot solved this frame; try again next think
	end
	local t = now()
	local rec = if h.receiver then w.bodies[h.receiver] else nil
	if not rec then
		h.phase = "Look"
		h.waitUntil = t + 0.2
		b.step = nil
		return
	end
	local P = services.MovementService.pivotOf(b.id) or b.root.Position
	lastSolveFrame = frameNo
	local sol = Solver.solve({
		rootPos = b.root.Position,
		pivot = P,
		step = b.sim.step,
		throwType = h.throwType,
		height = h.height,
		target = rec.pos + Vector3.new(0, 1, 0),
		targetVel = flat(rec.vel),
		groundY = w.f.groundY,
		wind = services.ArenaService.wind(),
		coarse = true,
	})
	if not sol or (sol.miss > 3.5 and not urgent) then
		h.phase = "Look"
		h.waitUntil = t + 0.3
		b.step = nil
		return
	end
	local params: any = sol.params
	local noise = (1 - b.skill) * 0.07
	params.yaw += b.rng:range(-noise, noise)
	params.pitch += b.rng:range(-noise, noise) * 0.6
	params.swinging = t < h.swingEnd

	local preview = services.ThrowService.previewBlock
	local skip = urgent or h.attempts > 4 or (b.skill < 0.7 and b.rng:next() < HAND_CHECK_SKIP)
	if preview and not skip and preview(b.id, params) then
		h.attempts += 1
		local other = if h.throwType == "Backhand" then "Forehand" else "Backhand"
		local candidates: { any } = {}
		if not OVERHEAD[h.throwType] and h.height ~= "Low" then
			table.insert(candidates, variant(params, { height = "Low" }))
		end
		table.insert(candidates, variant(params, { throwType = other }))
		if flat(rec.pos - P).Magnitude > 20 and h.throwType ~= "Hammer" then
			table.insert(candidates, variant(params, { throwType = "Hammer", height = "Mid" }))
		end
		for _, c in candidates do
			if not preview(b.id, c) then
				-- this one gets through: release it next think (re-solved)
				h.throwType = c.throwType
				h.height = c.height
				h.phase = "Setup"
				h.at = t - 1
				h.charged = t - 1
				return
			end
		end
		-- every release is blocked: pivot to the other side and look again
		if ready(b, "PivotSwing") and canSpend(b, HD.SwingCost) then
			h.side = -h.side
			h.throwType = if h.side < 0 then "Backhand" else "Forehand"
			press(b, "Swing", nil, 0, h.side)
			b.step = nil
			services.ThrowService.beginCharge(b.id, h.throwType)
			h.charged = t
			h.swingEnd = t + HD.SwingTime
			h.phase = "Swing"
		else
			h.phase = "Look"
			h.waitUntil = t + 0.3
		end
		return
	end
	local result = services.ThrowService.throw(b.id, params, true)
	if result then
		b.hold = nil
		b.step = nil
	else
		h.phase = "Look"
		h.waitUntil = t + 0.25
	end
end

local function thinkHolder(b: Bot, w: World)
	local t = w.t
	local sim = b.sim
	local e = w.e
	clearMark(b)
	b.target = nil
	b.targetVel = nil
	b.cut = nil
	local h = b.hold
	if not h then
		h = {
			phase = "Settle",
			at = t,
			since = t,
			waitUntil = t + math.max(0.25, b.rng:range(0.35, 1.1) * (1.3 - b.skill)),
			receiver = nil,
			throwType = "Backhand",
			height = "Mid",
			side = -1,
			charged = 0,
			swingEnd = 0,
			attempts = 0,
		}
		b.hold = h
	end
	local hp = h :: HoldPlan
	if not b.aim then
		b.aim = FieldGeometry.attackDirection(e.attack[b.team])
	end
	if w.phase ~= "Live" then
		-- the puller faces the receivers; MatchService releases the pull
		b.aim = FieldGeometry.attackDirection(e.attack[b.team])
		b.step = nil
		return
	end
	if sim.holdPhase ~= "Pivot" and t - hp.since < 2.5 then
		return -- still slowing down onto the pivot
	end
	local urgent = w.stall >= w.stallMax - 2
	local P = services.MovementService.pivotOf(b.id) or b.root.Position
	if hp.phase == "Settle" then
		if t < hp.waitUntil and w.stall < w.stallMax - 3 then
			b.step = nil
			return
		end
		hp.phase = "Look"
	end
	if hp.phase == "Look" then
		if t < hp.waitUntil and not urgent then
			return
		end
		local rec, score = chooseReceiver(b, w, P, urgent)
		if not rec or (score < 10 and not urgent) then
			hp.waitUntil = t + 0.35
			b.step = nil
			-- keep the mark honest: an occasional swing to look the other way
			if b.rng:next() < 0.2 and ready(b, "PivotSwing") and canSpend(b, HD.SwingCost + 20) then
				press(b, "Swing", nil, 0, if b.rng:next() < 0.5 then -1 else 1)
			end
			return
		end
		planRelease(b, w, hp, rec, P, urgent)
		return
	end
	if hp.phase == "Swing" then
		if t >= hp.swingEnd + 0.06 or urgent then
			release(b, w, hp, urgent)
		end
		return
	end
	if hp.phase == "Setup" then
		local want = b.step or Vector3.zero
		local inPlace = (flat(sim.step) - flat(want)).Magnitude < 0.6
		if urgent or (t - hp.charged >= 0.28 and (inPlace or t - hp.at > 0.5)) then
			release(b, w, hp, urgent)
		end
	end
end

---------------------------------------------------------------------------
-- match brain
---------------------------------------------------------------------------

local function thinkFlight(b: Bot, w: World)
	local e, d = w.e, w.d
	local fl = w.flight
	if not fl then
		return
	end
	local offense = if d.pull then b.team == e.offense else b.team == d.throwerTeam
	-- the pulling team never chases its own pull: it runs down onto its marks
	local mayChase = not d.pull or offense
	if mayChase and chaserOf(w, b.team) == b.id and chase(b, d, if d.pull then nil else w.f) then
		return
	end
	local ref = inField(w.f, fl.land, 2, w.f.groundY)
	if offense then
		if d.pull then
			thinkOffense(b, w, ref, nil)
		elseif b.cut then
			runCut(b)
		elseif d.thrower == b.id and b.target == nil then
			-- the thrower follows the throw up the field
			local pos = b.root.Position
			local f = FieldGeometry.attackDirection(e.attack[b.team])
			steerTo(b, inField(w.f, pos + f * 8, 4, pos.Y), JOG, false)
		end
		-- otherwise keep running where we were going
	else
		thinkDefense(b, w, ref, nil)
	end
end

local function thinkGround(b: Bot, w: World)
	local e, d = w.e, w.d
	local spot = d and d.folder:GetAttribute("GroundPos")
	if typeof(spot) ~= "Vector3" then
		stand(b)
		return
	end
	if b.team == e.offense then
		local n = nearest(spot, w.team[b.team], nil)
		if n and n.id == b.id then
			clearMark(b)
			b.cut = nil
			b.face = nil
			steerTo(b, Vector3.new(spot.X, b.root.Position.Y, spot.Z), SPRINT, true)
			return
		end
		thinkOffense(b, w, spot, nil)
	else
		thinkDefense(b, w, spot, nil)
	end
end

local function thinkMatch(b: Bot)
	local w = getWorld()
	if not w then
		stand(b)
		clearMark(b)
		return
	end
	local e = w.e
	if not b.sim.holding then
		b.hold = nil
	end
	if b.sim.frozen or not table.find(w.lines[b.team] or {}, b.id) then
		stand(b)
		clearMark(b)
		return
	end
	local phase = w.phase
	if phase == "PointOver" then
		stand(b)
		clearMark(b)
		if b.rng:next() < 0.03 then
			press(b, "Jump")
		end
		return
	end
	if phase == "PointSetup" or phase == "Pull" then
		clearMark(b)
		b.target = nil
		b.targetVel = nil
		b.cut = nil
		b.face = FieldGeometry.attackDirection(e.attack[b.team])
		if b.sim.holding then
			thinkHolder(b, w)
		end
		return
	end
	if phase ~= "Live" then
		stand(b)
		clearMark(b)
		return
	end
	local d = w.d
	if e.disc == "Held" and e.holder then
		local holder = e.holder :: number
		local hb = w.bodies[holder]
		local ref = services.MovementService.pivotOf(holder) or (if hb then hb.pos else b.root.Position)
		if holder == b.id then
			thinkHolder(b, w)
		elseif e.holderTeam == b.team then
			thinkOffense(b, w, ref, holder)
		else
			thinkDefense(b, w, ref, holder)
		end
	elseif e.disc == "Flight" and d and d.mode == "Flight" then
		thinkFlight(b, w)
	elseif e.disc == "Ground" then
		thinkGround(b, w)
	end
end

function BotService.schedulePull(id: number)
	local b = brains[id]
	if not b then
		return
	end
	task.delay(b.rng:range(1.0, 2.2), function()
		if brains[id] and services.MatchService.phase() == "Pull" then
			services.MatchService.pullNow(id)
		end
	end)
end

local function update(dt: number)
	frameNo += 1
	refreshFilter()
	local t = now()
	for id, b in brains do
		if b.model.Parent == nil then
			brains[id] = nil
			if b.loco then
				Locomotion.destroy(b.loco)
			end
			continue
		end
		local ok, err = pcall(function()
			if b.custom then
				b.custom(b, dt)
			elseif t >= b.nextThink then
				b.nextThink = t + THINK_EVERY
				thinkMatch(b)
			end
			motor(b, dt)
		end)
		if not ok then
			local clock = os.clock()
			if clock - (lastWarn[id] or -math.huge) > 5 then
				lastWarn[id] = clock
				warn("[BotService] " .. b.name .. ": " .. tostring(err))
			end
			pcall(function()
				b.humanoid:Move(Vector3.zero, false)
				b.humanoid.WalkSpeed = 0
			end)
		end
	end
	-- forget flights of discs that no longer fly
	for key, fl in flights do
		if fl.landT < t - 1 then
			flights[key] = nil
		end
	end
end

---------------------------------------------------------------------------
-- helpers for scripted (training) bots
---------------------------------------------------------------------------

-- Walk / run to `target` (nil = stand) at up to `speed` studs/s. With
-- `tech`, a sharp change of direction at speed is a Snap Cut / plant.
function BotService.setGoal(b: Bot, target: Vector3?, speed: number?, tech: boolean?)
	b.marking = false
	if target then
		steerTo(b, target, speed or JOG, tech)
	else
		b.target = nil
		b.targetVel = nil
		b.speed = speed or JOG
	end
end

-- Marks `holderId` (diag 3 §5 marker). `up` points from the thrower toward
-- the end zone they attack; `force` is "FH" or "BH".
function BotService.mark(b: Bot, holderId: number, up: Vector3, force: string)
	runMark(b, holderId, up, force)
end

-- Stops marking (stance down).
function BotService.unmark(b: Bot)
	clearMark(b)
end

-- Chases disc `d`'s current flight like a match bot. False when out of reach.
function BotService.chase(b: Bot, d: any): boolean
	return chase(b, d)
end

function BotService.press(b: Bot, action: string, dir: Vector3?, side: number?)
	press(b, action, dir, 0, side)
end

function BotService.setSkill(b: Bot, skill: number)
	b.skill = math.clamp(skill, 0, 1)
end

function BotService.stand(b: Bot)
	stand(b)
	clearMark(b)
end

function BotService.Init(s: any)
	services = s
	local f = workspace:FindFirstChild(Actors.BotFolderName)
	if not f then
		local nf = Instance.new("Folder")
		nf.Name = Actors.BotFolderName
		nf.Parent = workspace
		f = nf
	end
	folder = f :: Folder
end

function BotService.Start()
	RunService.Heartbeat:Connect(update)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		for _, p in plans do
			p.guards[actor.id] = nil
			for def, att in p.guards do
				if att == actor.id then
					p.guards[def] = nil
				end
			end
			if p.marker == actor.id then
				p.marker = nil
			end
		end
	end)
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">CatchingService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CatchingService — every catch, block and bobble is decided here.

	Humans: the client sees its own body where it really is and the disc at
	the shared server time, so it detects contact itself, keeps tracking the
	disc until the closest approach (at most ClaimTrackTime) and sends a
	claim (discId, tFirst, zoneKind, reachDir, rootPos, rootVel). The server:
	  * builds the claimer's zones from the body position the client sent
	    when it is within CatchGeometry.claimRoot's tolerance of the server's
	    (lagging) view, otherwise from the server root led by its velocity
	  * widens them by CatchGeometry.slack(ping, body speed)
	  * judges quality at the closest approach: the minimum depth over
	    [tFirst, tFirst + QualityWindow] of the disc's deterministic history,
	    in the body's moving frame (CatchGeometry.bestOverPath). tFirst still
	    orders contests; running into a disc never makes it a rim catch
	  * collects claims for ResolveDelay so near-simultaneous touches become a
	    fair contest (ContestWindow) instead of first-packet-wins.
	Every claim is answered: CatchResult(discId, accepted, result, flightId)
	with "Denied" at once for a refused claim (also when rate-limited at
	ClaimRateLimit, or when the disc stopped being catchable before the
	resolve), otherwise the outcome at resolve time.

	Bots: checked directly on the server every simulation step, with the same
	closest-approach rule over the next QualityWindow of the flight.

	Outcomes (CatchGeometry.outcome):
	  Catch    the winner holds on (an interception when it is a defender)
	  Block    a defender who only got the rim (depth > BlockDepth)
	  Bobble   a contested, or very fast (disc speed > BobbleSpeed),
	           fingertip catch pops the disc up
	Blocks and bobbles re-launch the disc from the contact point at the
	contact time (DiscService.deflect), so every client sees it continue from
	the touch instead of rewinding. The disc stays live; the toucher may not
	re-claim it for a moment.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local VecMath = require(Shared.Util.VecMath)
local Actors = require(Shared.Actors)
local Net = require(Shared.Net)

local C = DiscConfig.Catch

-- quality window sampling: first contact + QualitySamples steps
local SAMPLE_DT = C.QualityWindow / math.max(C.QualitySamples, 1)
-- a client-reported body velocity faster than this is junk
local MAX_BODY_SPEED = MovementConfig.HardCap + 12
-- how far into the future a claim time may be (clock jitter) before it is clamped
local FUTURE_SLACK = 0.05

local CatchingService = {}

local services: any

type ReachState = { at: number, dir: Vector3 }
local reaches: { [number]: ReachState } = {}
local lastClaim: { [number]: number } = {}

local function now(): number
	return Net.now()
end

local function finiteVec(v: any): Vector3?
	if typeof(v) ~= "Vector3" then
		return nil
	end
	local p = v :: Vector3
	local m = p.Magnitude
	if m ~= m or m > 1e6 then
		return nil
	end
	return p
end

local function facingOf(root: BasePart): Vector3
	return VecMath.flatUnit(root.CFrame.LookVector)
end

local function bodyFor(
	actorId: number,
	body: Vector3,
	facing: Vector3,
	reachDir: Vector3?,
	t: number,
	ping: number
): CatchGeometry.BodyState
	local reach = reaches[actorId]
	local reaching = false
	local dir: Vector3? = nil
	-- the Reach remote arrived about one ping after the press
	if reach and t >= reach.at - 0.12 - ping and t <= reach.at + C.ReachWindow + 0.12 then
		reaching = true
		dir = if reachDir and reachDir.Magnitude > 0.5 then reachDir.Unit else reach.dir
	end
	local diving = services.MovementService.isDiving(actorId)
	local diveDir: Vector3? = nil
	if diving then
		local c = Actors.characterOf(actorId)
		local td = c and c:GetAttribute("TechDir")
		diveDir = if typeof(td) == "Vector3" and (td :: Vector3).Magnitude > 0.5 then td :: Vector3 else facing
	end
	return {
		root = body,
		facing = facing,
		reaching = reaching,
		reachDir = dir,
		diving = diving,
		diveDir = diveDir,
		sliding = services.MovementService.isSliding(actorId),
	}
end

local function claimable(d: any, t: number): boolean
	if d.mode == "Flight" then
		return true
	end
	return d.mode == "Landed" and t <= d.landAt + 0.02
end

-- The disc's path over the quality window after first contact (history,
-- extrapolated from the live flight for the last few steps if needed).
local function pathAfter(d: any, t: number): { CatchGeometry.PathSample }
	local samples: { CatchGeometry.PathSample } = {}
	for k = 0, C.QualitySamples do
		local tk = t + k * SAMPLE_DT
		local p = services.DiscService.positionAt(d, tk)
		if p then
			table.insert(samples, { t = tk, pos = p })
		end
	end
	return samples
end

-- Disc velocity at the start of a sampled path (falls back to the live flight).
local function velocityOf(d: any, samples: { CatchGeometry.PathSample }): Vector3
	local a, b = samples[1], samples[2]
	if a and b and b.t > a.t then
		return (b.pos - a.pos) / (b.t - a.t)
	end
	return services.DiscService.velocity(d)
end

local function addClaim(
	d: any,
	actorId: number,
	team: string,
	t: number,
	ev: CatchGeometry.Evaluation,
	discVel: Vector3,
	body: Vector3
)
	local discPos = services.DiscService.positionAt(d, t)
	for _, c in d.claims do
		if c.id == actorId then
			-- a repeated claim: the earliest touch orders it, the deepest
			-- point of either window is its quality
			if ev.depth < c.depth - 1e-6 then
				c.depth, c.quality, c.zone, c.hand = ev.depth, ev.quality, ev.zone.kind, ev.hand
			end
			if t < c.t then
				c.t, c.discVel, c.body = t, discVel, body
				c.relativeSpeed = discVel.Magnitude
				c.discPos = discPos
			end
			return
		end
	end
	table.insert(d.claims, {
		id = actorId,
		team = team,
		t = t,
		depth = ev.depth,
		quality = ev.quality,
		relativeSpeed = discVel.Magnitude, -- disc speed only: running at a disc never makes it harder
		zone = ev.zone.kind,
		hand = ev.hand,
		discVel = discVel,
		discPos = discPos,
		body = body,
	})
	if d.resolveAt == nil then
		d.resolveAt = now() + C.ResolveDelay
	end
end

-- Validates a claim. Returns true if it was queued (the answer then comes at
-- resolve time). `clientRoot` / `clientVel` are the claimer's own body at
-- first contact (untrusted).
function CatchingService.claim(
	actorId: number,
	d: any,
	t: number,
	_kind: string?,
	reachDir: Vector3?,
	clientRoot: any?,
	clientVel: any?
): boolean
	local actor = services.PlayerService.get(actorId)
	if not actor or actor.role == "Spectate" or actor.role == "Bench" then
		return false
	end
	local root = services.PlayerService.root(actor)
	if not root then
		return false
	end
	local tNow = now()
	if t ~= t or t < tNow - C.MaxRewind or t > tNow + FUTURE_SLACK then
		t = math.clamp(if t == t then t else tNow, tNow - C.MaxRewind, tNow)
	end
	t = math.min(t, tNow)
	if not claimable(d, t) or t < d.noCatchUntil then
		return false
	end
	if d.thrower == actorId and not d.touched then
		return false
	end
	if services.DiscService.claimLocked(d, actorId) then
		return false
	end
	if actor.character and actor.character:GetAttribute("UBFrozen") == true then
		return false
	end
	if not d.handler.canClaim(d, actorId, actor.team) then
		return false
	end

	local ping = services.MovementService.ping(actorId)
	local serverVel = root.AssemblyLinearVelocity
	local body = root.Position
	local bodyVel = serverVel
	if not actor.isBot then
		local accepted: boolean
		body, accepted = CatchGeometry.claimRoot(clientRoot, root.Position, serverVel, ping)
		local cv = finiteVec(clientVel)
		if accepted and cv and cv.Magnitude <= MAX_BODY_SPEED then
			bodyVel = cv
		end
	end
	local zones = CatchGeometry.zones(bodyFor(actorId, body, facingOf(root), reachDir, t, ping))
	local slack = if actor.isBot then 0 else CatchGeometry.slack(ping, serverVel.Magnitude)
	local samples = pathAfter(d, t)
	local ev = CatchGeometry.bestOverPath(zones, samples, t, bodyVel, slack)
	if not ev then
		return false
	end
	addClaim(d, actorId, actor.team, t, ev, velocityOf(d, samples), body)
	return true
end

-- Server-side check for bots along one simulation step of a flight.
function CatchingService.sweepBots(d: any, _from: Vector3, to: Vector3, t: number)
	if t < d.noCatchUntil then
		return
	end
	for _, actor in services.PlayerService.all() do
		if actor.isBot and (actor.role == "Match" or actor.role == "Training") then
			local root = services.PlayerService.root(actor)
			if root and (root.Position - to).Magnitude < 9 then
				if
					not (d.thrower == actor.id and not d.touched)
					and not services.DiscService.claimLocked(d, actor.id)
					and d.handler.canClaim(d, actor.id, actor.team)
				then
					local zones = CatchGeometry.zones(bodyFor(actor.id, root.Position, facingOf(root), nil, t, 0))
					if CatchGeometry.evaluate(zones, to, 0) then
						local samples = pathAfter(d, t)
						local ev = CatchGeometry.bestOverPath(zones, samples, t, root.AssemblyLinearVelocity, 0)
						if ev then
							addClaim(d, actor.id, actor.team, t, ev, velocityOf(d, samples), root.Position)
						end
					end
				end
			end
		end
	end
end

local function answer(actorId: number, d: any, accepted: boolean, result: string)
	local player = Actors.playerOf(actorId)
	if player then
		Net.event("CatchResult"):FireClient(player, d.id, accepted, result, d.flightId)
	end
end

local function notifyClaimers(d: any, winnerId: number?, result: string)
	for _, c in d.claims do
		local mine = c.id == winnerId
		answer(c.id, d, mine and result == "Catch", if mine then result else "Lost")
	end
end

-- Forgets every pending claim, telling each claimer it was Denied (the disc
-- changed state before the claims could be resolved).
function CatchingService.discard(d: any)
	local claims = d.claims
	d.claims = {}
	d.resolveAt = nil
	for _, c in claims do
		answer(c.id, d, false, "Denied")
	end
end

function CatchingService.resolve(d: any)
	if #d.claims == 0 then
		return
	end
	if d.mode ~= "Flight" and d.mode ~= "Landed" then
		CatchingService.discard(d)
		return
	end
	local resolution = CatchGeometry.resolve(d.claims)
	if not resolution then
		CatchingService.discard(d)
		return
	end
	local w = resolution.winner :: any
	local winnerActor = services.PlayerService.get(w.id)
	local root = winnerActor and services.PlayerService.root(winnerActor)
	if not winnerActor or not root then
		CatchingService.discard(d)
		return
	end
	local body: Vector3 = w.body or root.Position
	local discPos: Vector3 = w.discPos or services.DiscService.positionAt(d, w.t) or body
	local discVel: Vector3 = w.discVel or services.DiscService.velocity(d)
	local isDefender = d.throwerTeam ~= nil and d.throwerTeam ~= "" and w.team ~= d.throwerTeam and not d.pull
	local outcome = CatchGeometry.outcome(resolution, isDefender)

	notifyClaimers(d, w.id, outcome)
	local claims = d.claims
	d.claims = {}
	d.resolveAt = nil

	if outcome == "Catch" then
		local track = services.MovementService.track(w.id)
		local grounded = if track then track.grounded else true
		local jumpOrigin = if track then track.lastGroundedPos else body
		services.DiscService.giveTo(d, w.id)
		Net.event("Effect"):FireAllClients("Catch", discPos, w.id, w.quality, w.zone)
		d.handler.onCaught(d, {
			id = w.id,
			team = w.team,
			pos = body, -- where the catcher's body was at the catch (validated)
			grounded = grounded,
			jumpOrigin = jumpOrigin,
			quality = w.quality,
			zone = w.zone,
			depth = w.depth,
			relativeSpeed = w.relativeSpeed,
			contested = resolution.contested,
			t = w.t,
			discPos = discPos,
			claims = claims,
		})
		return
	end

	-- deflections keep the disc alive, continuing from the contact
	local away = VecMath.flatUnit(discPos - body)
	local newVel: Vector3
	if outcome == "Block" then
		newVel = discVel * C.BlockCarry + Vector3.new(0, C.BlockDown, 0) + away * 6
	else
		newVel = discVel * C.BobbleCarry + Vector3.new(0, C.BobbleUp, 0) + away * 2
	end
	local pos = Vector3.new(discPos.X, math.max(discPos.Y, d.groundY + 0.6), discPos.Z)
	services.DiscService.deflect(d, pos, newVel, Vector3.new(0.3, 1, 0.2).Unit, 12, w.t, w.id)
	Net.event("Effect"):FireAllClients(outcome, discPos, w.id, w.quality, w.zone)
	d.handler.onTouched(
		d,
		{ id = w.id, team = w.team, kind = outcome, pos = discPos, zone = w.zone, reason = resolution.reason }
	)
end

function CatchingService.reachState(actorId: number): ReachState?
	return reaches[actorId]
end

-- Opens a reach window (humans via remote, bots directly).
function CatchingService.reach(actorId: number, dir: Vector3)
	local tNow = now()
	local prev = reaches[actorId]
	if prev and tNow - prev.at < C.ReachWindow + C.ReachCooldown * 0.6 then
		return
	end
	local unit = if dir.Magnitude > 0.1 and dir.Magnitude == dir.Magnitude then dir.Unit else Vector3.new(0, 0, -1)
	reaches[actorId] = { at = tNow, dir = unit }
	local actor = services.PlayerService.get(actorId)
	if actor and actor.character then
		actor.character:SetAttribute("ReachDir", unit)
		actor.character:SetAttribute("Reach", tNow)
	end
end

function CatchingService.Init(s: any)
	services = s
end

function CatchingService.Start()
	Net.event("Reach").OnServerEvent:Connect(function(player, dir)
		local actor = services.PlayerService.fromPlayer(player)
		local v = finiteVec(dir)
		if actor and v then
			CatchingService.reach(actor.id, v)
		end
	end)
	Net.event("Catch").OnServerEvent:Connect(function(player, discId, t, kind, reachDir, rootPos, rootVel)
		local actor = services.PlayerService.fromPlayer(player)
		if not actor or type(discId) ~= "string" then
			return
		end
		local d = services.DiscService.get(discId)
		local function deny()
			Net.event("CatchResult"):FireClient(player, discId, false, "Denied", if d then d.flightId else 0)
		end
		if not d or type(t) ~= "number" then
			deny()
			return
		end
		local clock = os.clock()
		if (lastClaim[actor.id] or -math.huge) > clock - C.ClaimRateLimit then
			deny()
			return
		end
		lastClaim[actor.id] = clock
		local ok = CatchingService.claim(
			actor.id,
			d,
			t,
			if type(kind) == "string" then kind else nil,
			finiteVec(reachDir),
			rootPos,
			rootVel
		)
		if not ok then
			deny()
		end
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		reaches[actor.id] = nil
		lastClaim[actor.id] = nil
	end)
end

return CatchingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — player profiles with DataStoreService.

	  * UpdateAsync everywhere (no blind SetAsync), with retries + backoff.
	  * Session lock: a profile records the JobId that owns it; another server
	    must wait for the lock to expire (or the owner to release it) before
	    taking over, which prevents two servers overwriting each other.
	  * Template merge + validation on load, so old or damaged data upgrades.
	    Settings values are merged key by key, so a setting added later
	    (e.g. AutoSprint, on by default) gets its default in old profiles.
	    SettingsVersion is deliberately not filled in: a missing version
	    tells the client the profile predates Input.Migrations.
	  * Releasing fires (synchronously) just before a leaving player's final
	    save, so last-moment changes (a ranked leaver's loss) are saved.
	  * Autosave every 90 s, save on leave, save-all in BindToClose.
	  * No API access (e.g. Studio without "Enable Studio Access to API
	    Services") -> profiles live in memory and are marked non-persistent.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local InputConfig = require(Shared.Config.Input)
local ProgressionConfig = require(Shared.Config.Progression)

local DataService = {}

DataService.Loaded = Signal.new() -- (player, data)
DataService.Releasing = Signal.new() -- (player, data) right before the final save on leave

local STORE_NAME = "UB_Profiles_v1"
local LOCK_TIMEOUT = 180 -- seconds before a crashed server's lock is considered stale
local AUTOSAVE = 90
local VERSION = 1

local store: DataStore? = nil
local persistentAvailable = false
local jobId = if game.JobId ~= "" then game.JobId else ("studio-" .. HttpService:GenerateGUID(false))

export type Profile = {
	data: { [string]: any },
	persistent: boolean,
	dirty: boolean,
	loadedAt: number,
	released: boolean,
}

local profiles: { [Player]: Profile } = {}

local function template(): { [string]: any }
	return {
		version = VERSION,
		xp = 0,
		stats = {},
		techMastery = {},
		rating = ProgressionConfig.Rating.Start,
		ratedGames = 0,
		peakRating = ProgressionConfig.Rating.Start,
		personalBests = {},
		drillsDone = {},
		achievements = {},
		cosmetics = { disc = "Classic", trail = "None", celebration = "Point", banner = "Slate", title = "Rookie" },
		settings = { values = table.clone(InputConfig.DefaultSettings), keyboard = {}, gamepad = {} },
		firstJoin = os.time(),
		lastJoin = os.time(),
	}
end

-- Fills missing keys from the template and drops values of the wrong type.
local function reconcile(data: any): { [string]: any }
	local base = template()
	if type(data) ~= "table" then
		return base
	end
	for k, v in base do
		local cur = data[k]
		if cur == nil or type(cur) ~= type(v) then
			data[k] = v
		elseif type(v) == "table" and k ~= "stats" and k ~= "techMastery" and k ~= "personalBests" then
			for k2, v2 in v do
				if cur[k2] == nil or type(cur[k2]) ~= type(v2) then
					cur[k2] = v2
				end
			end
		end
	end
	for k, v in data.stats do
		if type(v) ~= "number" then
			data.stats[k] = nil
		end
	end
	-- settings added after a profile was saved get their defaults
	local values = data.settings.values
	if type(values) ~= "table" then
		values = {}
		data.settings.values = values
	end
	for k, default in InputConfig.DefaultSettings :: any do
		if k ~= "SettingsVersion" and type(values[k]) ~= type(default) then
			values[k] = default
		end
	end
	for _, scheme in { "keyboard", "gamepad" } do
		if type(data.settings[scheme]) ~= "table" then
			data.settings[scheme] = {}
		end
	end
	data.version = VERSION
	return data
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T?)
	local delay = 1
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[DataService] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < 4 then
			task.wait(delay)
			delay *= 2
		end
	end
	return false, nil
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function load(player: Player): Profile
	if not persistentAvailable or not store then
		return { data = template(), persistent = false, dirty = false, loadedAt = os.clock(), released = false }
	end
	local ds = store :: DataStore
	local loaded: any = nil
	for _ = 1, 5 do
		local stolen = false
		local ok = withRetries("load " .. player.UserId, function()
			ds:UpdateAsync(key(player), function(old: any)
				local now = os.time()
				if type(old) == "table" and type(old.lock) == "table" then
					local lock = old.lock
					if lock.job ~= jobId and type(lock.at) == "number" and now - lock.at < LOCK_TIMEOUT then
						loaded = nil
						return nil -- someone else owns it; don't write
					end
					stolen = lock.job ~= jobId
				end
				local data = reconcile(if type(old) == "table" then old.data else nil)
				data.lastJoin = now
				loaded = data
				return { data = data, lock = { job = jobId, at = now } }
			end)
			return true
		end)
		if not ok then
			break
		end
		if loaded then
			if stolen then
				warn("[DataService] took over a stale session lock for " .. player.UserId)
			end
			return { data = loaded, persistent = true, dirty = false, loadedAt = os.clock(), released = false }
		end
		task.wait(6) -- another server is releasing it
		if not player.Parent then
			break
		end
	end
	warn("[DataService] could not lock profile for " .. player.UserId .. "; using a temporary profile")
	return { data = template(), persistent = false, dirty = false, loadedAt = os.clock(), released = false }
end

local function save(player: Player, release: boolean)
	local profile = profiles[player]
	if not profile or not profile.persistent or profile.released or not store then
		return
	end
	local ds = store :: DataStore
	local data = profile.data
	withRetries("save " .. player.UserId, function()
		ds:UpdateAsync(key(player), function(old: any)
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= jobId then
				-- we lost the lock (another server took over after a timeout)
				return nil
			end
			return { data = data, lock = if release then nil else { job = jobId, at = os.time() } }
		end)
		return true
	end)
	profile.dirty = false
	if release then
		profile.released = true
	end
end

function DataService.get(player: Player): { [string]: any }?
	local p = profiles[player]
	return if p then p.data else nil
end

function DataService.isPersistent(player: Player): boolean
	local p = profiles[player]
	return p ~= nil and p.persistent
end

-- Applies fn(data) and marks the profile dirty.
function DataService.update(player: Player, fn: ({ [string]: any }) -> ())
	local p = profiles[player]
	if not p then
		return
	end
	fn(p.data)
	p.dirty = true
end

function DataService.saveNow(player: Player)
	task.spawn(save, player, false)
end

function DataService.Init(_services: any)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok and result then
		store = result
		-- probe once: Studio without API access throws here
		local probeOk = pcall(function()
			(result :: DataStore):GetAsync("__probe")
		end)
		persistentAvailable = probeOk
	end
	if not persistentAvailable then
		warn(
			"[DataService] DataStores unavailable — profiles will not be saved this session."
				.. (
					if RunService:IsStudio()
						then " (Enable 'Studio Access to API Services' in Game Settings > Security.)"
						else ""
				)
		)
	end
end

function DataService.Start()
	local function onJoin(player: Player)
		local profile = load(player)
		if not player.Parent then
			if profile.persistent then
				profiles[player] = profile
				save(player, true)
				profiles[player] = nil
			end
			return
		end
		profiles[player] = profile
		DataService.Loaded:Fire(player, profile.data)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		if profile then
			DataService.Releasing:Fire(player, profile.data)
		end
		save(player, true)
		profiles[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for player, profile in profiles do
				if profile.dirty then
					task.spawn(save, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">DefenseService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DefenseService — the mark.

	Everything is measured from the holder's planted pivot foot P
	(MovementService.pivotOf; the holder's root until P is planted), not from
	the holder's root, so a thrower's lunge cannot change who is marking or
	cause a disc-space call.

	  Stall count   advances once per StallInterval while an opposing player
	                is within StallRange of P. Pauses when nobody is marking,
	                on a double team (a second defender in range who is not
	                guarding anyone else), or on a disc-space violation (the
	                marker inside DiscSpace of P for 0.4 s). Resets after
	                1.5 s unmarked.
	  Mark stance   defenders hold Secondary near the holder to mark-shuffle
	                with their hands up (MarkStance remote: on, stance); the
	                Slide key toggles High (hammers / hop throws) and Low
	                (wide, knees to chest: normal and step-out releases).
	                Replicated as the character attribute Mark so the thrower
	                sees it.
	  Hand blocks   on release the first HandBlockCheckTime seconds of the
	                flight are tested against every nearby defender's hand box
	                (CatchGeometry.markBox: the marker's facing blended toward
	                P, Low / High bands, a small chest sphere when Relaxed,
	                lifted by a jump). Markers are rewound (MovementService.
	                positionAt) by about two one-way pings plus a little,
	                capped at Mark.RewindMax, so the test uses where the
	                thrower saw them: a pivot that visibly beats the mark beats
	                it. Contact = a point block. Pure geometry, no hidden roll.
	  Force side    each team's markers force a side per point (UBState
	                ForceA / ForceB = "FH" | "BH", set by MatchService);
	                forceFor(team) reads it for bots and the HUD.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local M = DiscConfig.Mark

-- only defenders this close to P (rewound) can reach the early flight
local HAND_BLOCK_RADIUS = 14
-- a rewound root this far above standing counts as a jump (filters noise)
local JUMP_NOISE = 0.3

local DefenseService = {}

DefenseService.StallOut = Signal.new() -- (holderId)
DefenseService.StallTick = Signal.new() -- (count)

local services: any

type Stance = { on: boolean, stance: CatchGeometry.MarkStance, at: number }
local stances: { [number]: Stance } = {}

local stall = {
	active = false,
	holder = nil :: number?,
	clock = 0,
	count = 0,
	unmarkedFor = 0,
	discSpaceFor = 0,
	stateName = "None",
	interval = 1,
	max = 10,
	marker = nil :: number?,
}

local function now(): number
	return Net.now()
end

function DefenseService.setStance(actorId: number, on: boolean, stance: string?)
	local st: CatchGeometry.MarkStance = if stance == "High" then "High" else "Low"
	stances[actorId] = { on = on, stance = st, at = now() }
	local actor = services.PlayerService.get(actorId)
	if actor and actor.character then
		actor.character:SetAttribute("Mark", if on then st else "")
	end
end

function DefenseService.stanceOf(actorId: number): CatchGeometry.MarkStance
	local s = stances[actorId]
	if s and s.on then
		return s.stance
	end
	return "Relaxed"
end

-- The side ("FH" | "BH") the markers of `team` force this point.
function DefenseService.forceFor(team: string): string
	local v = Net.state():GetAttribute("Force" .. team)
	return if v == "BH" then "BH" else "FH"
end

-- The holder's pivot foot P, or their root until it is planted.
local function pivotOf(actorId: number, root: BasePart): Vector3
	return services.MovementService.pivotOf(actorId) or root.Position
end

-- Called by MatchService whenever possession changes hands.
function DefenseService.startStall(holderId: number?, interval: number, maxCount: number)
	stall.active = holderId ~= nil
	stall.holder = holderId
	stall.clock = 0
	stall.count = 0
	stall.unmarkedFor = 0
	stall.discSpaceFor = 0
	stall.interval = interval
	stall.max = maxCount
	stall.marker = nil
	local state = Net.state()
	state:SetAttribute("Stall", 0)
	state:SetAttribute("StallMax", maxCount)
	state:SetAttribute("StallState", if holderId then "Unmarked" else "None")
	state:SetAttribute("MarkerId", 0)
end

function DefenseService.stopStall()
	DefenseService.startStall(nil, stall.interval, stall.max)
end

function DefenseService.stallCount(): number
	return stall.count
end

local function setState(name: string)
	if stall.stateName ~= name then
		stall.stateName = name
		Net.state():SetAttribute("StallState", name)
	end
end

local function stepStall(dt: number)
	if not stall.active or not stall.holder then
		return
	end
	local holder = services.PlayerService.get(stall.holder)
	local hroot = holder and services.PlayerService.root(holder)
	if not holder or not hroot then
		return
	end
	local pivot = pivotOf(holder.id, hroot)
	local defenders = {}
	local offenders = {}
	for _, a in services.PlayerService.all() do
		if a.role == "Match" and a.id ~= holder.id then
			local r = services.PlayerService.root(a)
			if r then
				if a.team ~= holder.team then
					table.insert(
						defenders,
						{ actor = a, root = r, dist = CatchGeometry.markDistance(r.Position, pivot) }
					)
				else
					table.insert(offenders, r.Position)
				end
			end
		end
	end
	table.sort(defenders, function(x, y)
		return x.dist < y.dist
	end)
	local marker = defenders[1]
	if not marker or marker.dist > M.StallRange then
		stall.unmarkedFor += dt
		stall.marker = nil
		Net.state():SetAttribute("MarkerId", 0)
		if stall.unmarkedFor > 1.5 and stall.count > 0 then
			stall.count = 0
			stall.clock = 0
			Net.state():SetAttribute("Stall", 0)
		end
		setState("Unmarked")
		return
	end
	stall.unmarkedFor = 0
	if stall.marker ~= marker.actor.id then
		stall.marker = marker.actor.id
		Net.state():SetAttribute("MarkerId", marker.actor.id)
	end

	-- double team: a second defender in range who is not guarding anyone else
	local second = defenders[2]
	if second and second.dist <= M.StallRange then
		local guarding = false
		for _, op in offenders do
			if (op - second.root.Position).Magnitude <= M.StallRange then
				guarding = true
				break
			end
		end
		if not guarding then
			setState("DoubleTeam")
			return
		end
	end

	-- disc space: only the marker can cause it (measured from P)
	if CatchGeometry.isDiscSpace(marker.root.Position, pivot) then
		stall.discSpaceFor += dt
		if stall.discSpaceFor > 0.4 then
			setState("DiscSpace")
			return
		end
	else
		stall.discSpaceFor = 0
	end

	setState("Counting")
	stall.clock += dt
	local count = math.floor(stall.clock / stall.interval)
	if count ~= stall.count then
		stall.count = count
		Net.state():SetAttribute("Stall", count)
		DefenseService.StallTick:Fire(count)
		if count >= stall.max then
			local h = stall.holder
			stall.active = false
			DefenseService.StallOut:Fire(h)
		end
	end
end

type Candidate = { id: number, box: CatchGeometry.MarkBox }

-- How far back the thrower saw the markers when the release reaches us.
-- MovementService.ping is one-way: the release took one ping to arrive, and
-- the thrower's view of other bodies was another ping (plus interpolation)
-- behind the server. CatchGeometry.markerRewind takes a round trip.
local function markerRewind(oneWay: number): number
	return math.min(CatchGeometry.markerRewind(2 * oneWay) + oneWay, M.RewindMax)
end

-- Returns (blockerId, timeIntoFlight, blockPosition) if the release hits a
-- defender's hands, else nil. Defenders are taken where the thrower saw
-- them: rewound by markerRewind(thrower ping) from `at` (default now).
function DefenseService.checkHandBlock(
	launch: DiscPhysics.State,
	throwerId: number,
	throwerTeam: string,
	groundY: number,
	wind: DiscPhysics.Wind?,
	at: number?
): (number?, number?, Vector3?)
	local thrower = services.PlayerService.get(throwerId)
	local troot = thrower and services.PlayerService.root(thrower)
	if not troot then
		return nil, nil, nil
	end
	local pivot = pivotOf(throwerId, troot)
	local rewindT = (at or now()) - markerRewind(services.MovementService.ping(throwerId))
	local candidates: { Candidate } = {}
	for _, a in services.PlayerService.all() do
		if a.role == "Match" and a.team ~= throwerTeam and a.team ~= "N" then
			local pos, facing = services.MovementService.positionAt(a.id, rewindT)
			if (pos - pivot).Magnitude < HAND_BLOCK_RADIUS then
				local rise = pos.Y - groundY - services.MovementService.standHeight(a.id)
				local stance: CatchGeometry.MarkStance = DefenseService.stanceOf(a.id)
				table.insert(candidates, {
					id = a.id,
					box = CatchGeometry.markBox(
						pos,
						facing,
						pivot,
						stance,
						groundY,
						if rise > JUMP_NOISE then rise else 0
					),
				})
			end
		end
	end
	if #candidates == 0 then
		return nil, nil, nil
	end
	local s = DiscPhysics.copy(launch)
	local dt = DiscConfig.Physics.Dt
	while s.t < DiscConfig.Throw.HandBlockCheckTime do
		DiscPhysics.step(s, dt, wind)
		local p = Vector3.new(s.px, s.py, s.pz)
		for _, c in candidates do
			if CatchGeometry.inMarkBox(c.box, p) then
				return c.id, s.t, p
			end
		end
	end
	return nil, nil, nil
end

function DefenseService.Init(s: any)
	services = s
end

function DefenseService.Start()
	Net.event("MarkStance").OnServerEvent:Connect(function(player, on, stance)
		local actor = services.PlayerService.fromPlayer(player)
		if actor and type(on) == "boolean" then
			DefenseService.setStance(actor.id, on, if type(stance) == "string" then stance else "Low")
		end
	end)
	RunService.Heartbeat:Connect(stepStall)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		stances[actor.id] = nil
	end)
end

return DefenseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">DiscService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DiscService — server-authoritative discs.

	Each disc is a Configuration in ReplicatedStorage.UBDiscs whose attributes
	are the single source of truth every client renders from:
	  Mode        "None" | "Held" | "Flight" | "Ground"
	  HolderId    actor id while held
	  FlightId    increments for every new flight segment (throw, tip, block)
	  LaunchTime  server time at which the segment starts
	  LaunchPos / LaunchVel / LaunchNormal (Vector3), Spin, Wind, GroundY
	  StopAt      flight time at which a marker's hands stop this segment (a
	              hand block; 0 = none): clients hold the disc there until
	              the deflection segment arrives instead of flying it on
	  GroundPos   resting spot while on the ground
	  ThrowerId, ThrowerTeam, ThrowType, Quality, Skin, Context, Owner, Pull

	Flights are deterministic (DiscPhysics with a fixed step from identical
	launch values), so clients reproduce the server's trajectory exactly
	without any per-frame position replication. The server keeps a short
	position history for lag-compensated catch validation.

	A segment may start in the recent past (launch `startT`, deflect
	`contactT`): a throw starts at the thrower's own release time
	(ThrowService clamps it to [now - min(ping, 0.25), now]) and a block or
	bobble continues from the contact point at the contact time, so the
	flight every client re-simulates is in sync with what the players saw
	instead of rewinding in space. The player who just touched the disc
	cannot claim it again for TOUCH_LOCK seconds (no repeated self-blocks off
	the same rim contact).

	Claims are never dropped silently: whenever a segment change, a pickup or
	a placement discards pending claims, the claimers are told (Denied) so
	their clients stop predicting at once. Losing the disc also clears the
	holder's windup attributes, so nothing reads a stale WindupType.

	Multiple discs exist at once: the match disc plus one per training session.
	A context handler decides what catches and landings mean for each disc.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)

local P = DiscConfig.Physics

local DiscService = {}

export type Sample = { t: number, x: number, y: number, z: number }

export type Handler = {
	-- may this actor claim this disc right now?
	canClaim: (disc: Disc, actorId: number, team: string) -> boolean,
	onCaught: (disc: Disc, info: { [string]: any }) -> (),
	onTouched: (disc: Disc, info: { [string]: any }) -> (),
	onGrounded: (disc: Disc, landPos: Vector3, history: { Sample }) -> (),
	-- may this holder throw right now? (e.g. a puller must wait for the whistle)
	canThrow: (disc: Disc, actorId: number) -> boolean,
	onThrown: (disc: Disc, info: { [string]: any }) -> (),
}

export type Disc = {
	id: string,
	folder: Configuration,
	context: string,
	owner: number?,
	handler: Handler,
	mode: string,
	holder: number?,
	sim: DiscPhysics.State?,
	flightId: number,
	launchTime: number,
	wind: DiscPhysics.Wind,
	groundY: number,
	history: { Sample },
	flightSamples: { Sample },
	thrower: number?,
	throwerTeam: string?,
	throwType: string?,
	quality: string?,
	releasePos: Vector3?,
	releaseAt: number,
	noCatchUntil: number,
	touched: boolean,
	claims: { any },
	resolveAt: number?,
	pull: boolean,
	skin: string,
	meta: { [string]: any },
	landAt: number,
	landPos: Vector3?,
	groundAt: number,
	lockedId: number?, -- the last toucher, who may not re-claim until lockedUntil
	lockedUntil: number,
}

-- Late catch claims (lag compensation) may still arrive for this long after
-- the server sees the disc touch down.
local GROUND_GRACE = 0.2
-- A segment can start at most this far in the past (backdated release / contact).
local MAX_BACKDATE = 0.3
-- Nobody claims a deflected disc for this long after the server re-launched it ...
local DEFLECT_NO_CATCH = 0.06
-- ... and the player who touched it not for this long.
local TOUCH_LOCK = 0.25

local discs: { [string]: Disc } = {}
local services: any

local function now(): number
	return Net.now()
end

local function write(d: Disc, key: string, value: any)
	d.folder:SetAttribute(key, value)
end

function DiscService.create(context: string, owner: number?, handler: Handler): Disc
	local id = string.sub(HttpService:GenerateGUID(false), 1, 8)
	local folder = Instance.new("Configuration")
	folder.Name = "Disc_" .. id
	local d: Disc = {
		id = id,
		folder = folder,
		context = context,
		owner = owner,
		handler = handler,
		mode = "None",
		holder = nil,
		sim = nil,
		flightId = 0,
		launchTime = 0,
		wind = { x = 0, y = 0, z = 0 },
		groundY = 0,
		history = {},
		flightSamples = {},
		thrower = nil,
		throwerTeam = nil,
		throwType = nil,
		quality = nil,
		releasePos = nil,
		releaseAt = 0,
		noCatchUntil = 0,
		touched = false,
		claims = {},
		resolveAt = nil,
		pull = false,
		skin = "Classic",
		meta = {},
		landAt = 0,
		landPos = nil,
		groundAt = 0,
		lockedId = nil,
		lockedUntil = 0,
	}
	folder:SetAttribute("Id", id)
	folder:SetAttribute("Context", context)
	folder:SetAttribute("Owner", owner or 0)
	folder:SetAttribute("Mode", "None")
	folder:SetAttribute("FlightId", 0)
	folder:SetAttribute("Skin", "Classic")
	folder.Parent = Net.discs()
	discs[id] = d
	return d
end

function DiscService.destroy(d: Disc)
	if d.holder and services.MovementService then
		services.MovementService.setHolding(d.holder, false)
	end
	discs[d.id] = nil
	d.folder:Destroy()
end

function DiscService.get(id: string): Disc?
	return discs[id]
end

function DiscService.all(): { Disc }
	local list = {}
	for _, d in discs do
		table.insert(list, d)
	end
	return list
end

function DiscService.heldBy(actorId: number): Disc?
	for _, d in discs do
		if d.mode == "Held" and d.holder == actorId then
			return d
		end
	end
	return nil
end

-- Tells every pending claimer that their claim is gone (the server always
-- answers a claim), then forgets the claims.
local function dropClaims(d: Disc)
	if #d.claims > 0 then
		services.CatchingService.discard(d)
	end
	d.claims = {}
	d.resolveAt = nil
end

local function setHolderAttr(d: Disc, actorId: number?)
	local prev = d.holder
	if prev and prev ~= actorId then
		local actor = services.PlayerService.get(prev)
		if actor and actor.character then
			actor.character:SetAttribute("HasDisc", false)
			-- no stale windup: a new possession starts from a clean slate
			actor.character:SetAttribute("Windup", 0)
			actor.character:SetAttribute("WindupType", "")
		end
		services.MovementService.setHolding(prev, false)
	end
	d.holder = actorId
	write(d, "HolderId", actorId or 0)
	if actorId then
		local actor = services.PlayerService.get(actorId)
		if actor and actor.character then
			actor.character:SetAttribute("HasDisc", true)
			actor.character:SetAttribute("HeldSince", now())
		end
	end
end

function DiscService.setSkin(d: Disc, skin: string)
	d.skin = skin
	write(d, "Skin", skin)
end

function DiscService.giveTo(d: Disc, actorId: number)
	dropClaims(d)
	d.mode = "Held"
	d.sim = nil
	d.pull = false
	setHolderAttr(d, actorId)
	write(d, "Mode", "Held")
	write(d, "Pull", false)
	services.MovementService.setHolding(actorId, true)
end

function DiscService.placeOnGround(d: Disc, pos: Vector3)
	dropClaims(d)
	d.mode = "Ground"
	d.sim = nil
	setHolderAttr(d, nil)
	write(d, "GroundPos", Vector3.new(pos.X, d.groundY + 0.15, pos.Z))
	write(d, "Mode", "Ground")
end

function DiscService.hide(d: Disc)
	dropClaims(d)
	d.mode = "None"
	d.sim = nil
	setHolderAttr(d, nil)
	write(d, "Mode", "None")
end

export type LaunchMeta = {
	thrower: number?,
	throwerTeam: string?,
	throwType: string?,
	quality: string?,
	pull: boolean?,
	noCatch: number?,
	keepThrower: boolean?,
	groundY: number?,
	wind: Vector3?,
	stopAt: number?, -- a hand block will deflect the disc this far into the flight
}

-- Starts a new flight segment from (pos, vel, normal, spin). `startT` is the
-- server time the segment starts (default now; clamped to at most
-- MAX_BACKDATE in the past): the release time of a throw or the contact time
-- of a deflection. noCatch counts from that start.
function DiscService.launch(
	d: Disc,
	pos: Vector3,
	vel: Vector3,
	normal: Vector3,
	spin: number,
	meta: LaunchMeta,
	startT: number?
)
	local tNow = now()
	local t0 = tNow
	if startT and startT == startT then
		t0 = math.clamp(startT, tNow - MAX_BACKDATE, tNow)
	end
	dropClaims(d)
	d.flightId += 1
	d.mode = "Flight"
	if not meta.keepThrower then
		d.thrower = meta.thrower
		d.throwerTeam = meta.throwerTeam
		d.throwType = meta.throwType
		d.quality = meta.quality
		d.releasePos = pos
		d.releaseAt = t0
		d.touched = false
		d.pull = meta.pull == true
		d.flightSamples = {}
		d.lockedId = nil
		d.lockedUntil = 0
	end
	d.noCatchUntil = t0 + (meta.noCatch or DiscConfig.Throw.NoCatchTime)
	d.groundY = meta.groundY or d.groundY
	local windVec = meta.wind or Vector3.new(d.wind.x, d.wind.y, d.wind.z)
	setHolderAttr(d, nil)

	write(d, "LaunchPos", pos)
	write(d, "LaunchVel", vel)
	write(d, "LaunchNormal", normal)
	write(d, "Spin", spin)
	write(d, "LaunchTime", t0)
	write(d, "Wind", windVec)
	write(d, "GroundY", d.groundY)
	write(d, "ThrowerId", d.thrower or 0)
	write(d, "ThrowerTeam", d.throwerTeam or "")
	write(d, "ThrowType", d.throwType or "")
	write(d, "Quality", d.quality or "")
	write(d, "Pull", d.pull)
	write(d, "StopAt", meta.stopAt or 0)
	write(d, "Mode", "Flight")
	write(d, "FlightId", d.flightId)

	-- Simulate from the replicated (read-back) values so the server runs
	-- exactly what clients will run.
	local rp = d.folder:GetAttribute("LaunchPos") :: Vector3
	local rv = d.folder:GetAttribute("LaunchVel") :: Vector3
	local rn = d.folder:GetAttribute("LaunchNormal") :: Vector3
	local rw = d.folder:GetAttribute("Wind") :: Vector3
	d.wind = { x = rw.X, y = rw.Y, z = rw.Z }
	d.sim = DiscPhysics.fromVectors(rp, rv, rn, spin)
	d.launchTime = t0
	d.history = { { t = t0, x = rp.X, y = rp.Y, z = rp.Z } }
	table.insert(d.flightSamples, { t = t0, x = rp.X, y = rp.Y, z = rp.Z })
end

-- Re-launches the current flight from a contact (tips, blocks, bobbles):
-- from `pos` at server time `contactT` (default now), so the new segment
-- continues where and when the touch happened. `toucher` may not claim it
-- again for TOUCH_LOCK seconds.
function DiscService.deflect(
	d: Disc,
	pos: Vector3,
	vel: Vector3,
	normal: Vector3?,
	spin: number?,
	contactT: number?,
	toucher: number?
)
	local n = normal or Vector3.new(0, 1, 0)
	local s = spin or (if d.sim then (d.sim :: DiscPhysics.State).spin * 0.5 else 20)
	local tNow = now()
	local t0 = if contactT and contactT == contactT then math.clamp(contactT, tNow - MAX_BACKDATE, tNow) else tNow
	d.touched = true
	-- nobody catches it in the instant after the server re-launches it
	local noCatch = (tNow - t0) + DEFLECT_NO_CATCH
	DiscService.launch(d, pos, vel, n, s, { keepThrower = true, noCatch = noCatch }, t0)
	d.lockedId = toucher
	d.lockedUntil = if toucher then tNow + TOUCH_LOCK else 0
end

-- May this actor claim the disc right now (the toucher lock)?
function DiscService.claimLocked(d: Disc, actorId: number): boolean
	return d.lockedId == actorId and now() < d.lockedUntil
end

-- Disc position at absolute server time t (interpolated from history).
function DiscService.positionAt(d: Disc, t: number): Vector3?
	if d.mode ~= "Flight" and d.mode ~= "Landed" then
		return nil
	end
	if d.mode == "Landed" and t >= d.landAt and d.landPos then
		return d.landPos
	end
	local h = d.history
	local n = #h
	if n == 0 then
		return nil
	end
	if t >= h[n].t then
		local s = d.sim
		if s then
			local x, y, z = DiscPhysics.positionAt(s, t - d.launchTime)
			return Vector3.new(x, y, z)
		end
		return Vector3.new(h[n].x, h[n].y, h[n].z)
	end
	if t <= h[1].t then
		return Vector3.new(h[1].x, h[1].y, h[1].z)
	end
	-- binary search
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if h[mid].t <= t then
			lo = mid
		else
			hi = mid
		end
	end
	local a, b = h[lo], h[hi]
	local f = (t - a.t) / math.max(b.t - a.t, 1e-6)
	return Vector3.new(a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f, a.z + (b.z - a.z) * f)
end

function DiscService.velocity(d: Disc): Vector3
	local s = d.sim
	if s then
		return DiscPhysics.velocity(s)
	end
	return Vector3.zero
end

function DiscService.currentPosition(d: Disc): Vector3?
	if d.mode == "Flight" or d.mode == "Landed" then
		return DiscService.positionAt(d, now())
	elseif d.mode == "Ground" then
		return d.folder:GetAttribute("GroundPos") :: Vector3?
	elseif d.mode == "Held" and d.holder then
		local root = Actors.rootOf(d.holder)
		if root then
			return root.Position
		end
	end
	return nil
end

local function stepFlight(d: Disc, tNow: number)
	local s = d.sim
	if not s then
		return
	end
	local target = tNow - d.launchTime
	local dt = P.Dt
	local ground = d.groundY + P.GroundContact
	while s.t + dt <= target + 1e-9 do
		local ox, oy, oz = s.px, s.py, s.pz
		DiscPhysics.step(s, dt, d.wind)
		local absT = d.launchTime + s.t
		table.insert(d.history, { t = absT, x = s.px, y = s.py, z = s.pz })
		if #d.flightSamples == 0 or absT - d.flightSamples[#d.flightSamples].t >= 0.05 then
			table.insert(d.flightSamples, { t = absT, x = s.px, y = s.py, z = s.pz })
		end
		-- bots catch on the server, sweeping each step segment
		services.CatchingService.sweepBots(d, Vector3.new(ox, oy, oz), Vector3.new(s.px, s.py, s.pz), absT)
		if d.mode ~= "Flight" then
			return
		end
		if s.py <= ground or s.t > P.MaxFlightTime or math.abs(s.px) > 5000 or math.abs(s.pz) > 5000 then
			local f = if oy - s.py > 1e-9 then math.clamp((oy - ground) / (oy - s.py), 0, 1) else 1
			local land = Vector3.new(ox + (s.px - ox) * f, d.groundY, oz + (s.pz - oz) * f)
			d.mode = "Landed"
			d.landAt = d.launchTime + s.t - dt + dt * f
			d.landPos = land
			d.groundAt = tNow + GROUND_GRACE
			table.insert(d.flightSamples, { t = d.landAt, x = land.X, y = land.Y, z = land.Z })
			return
		end
	end
	-- trim history
	local cutoff = tNow - P.HistorySeconds
	local trim = 0
	for i = 1, #d.history do
		if d.history[i].t < cutoff then
			trim = i
		else
			break
		end
	end
	if trim > 1 then
		local kept = table.move(d.history, trim, #d.history, 1, {})
		d.history = kept
	end
end

function DiscService.Init(s: any)
	services = s
end

function DiscService.Start()
	RunService.Heartbeat:Connect(function()
		local t = now()
		for _, d in discs do
			if d.mode == "Flight" then
				stepFlight(d, t)
			end
			if d.resolveAt and t >= (d.resolveAt :: number) then
				d.resolveAt = nil
				services.CatchingService.resolve(d)
			end
			if d.mode == "Landed" and d.resolveAt == nil and t >= d.groundAt then
				d.mode = "Grounding"
				d.sim = nil
				d.handler.onGrounded(d, d.landPos or Vector3.zero, d.flightSamples)
				if (d.mode :: string) == "Grounding" then
					-- handler did not place it; rest where it landed
					DiscService.placeOnGround(d, d.landPos or Vector3.zero)
				end
			end
		end
	end)
end

return DiscService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">HighlightService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HighlightService — recognises plays worth celebrating.

	Highlights come only from validated server facts: the zone that made a
	catch, whether the catcher was airborne, distances, defenders nearby,
	technique chains the server accepted and converted into the play (at the
	claim time, so a catch that ended a chain on the catcher's screen counts).
	A highlight never pauses play: clients show a short banner, the crowd
	reacts.

	  LAYOUT        catch made with the dive zone
	  SKY           airborne catch with a defender within 4.5 studs
	  HUCK          completion longer than HuckFraction (55 %) of the playing
	                field (Mini ~88 studs, Normal ~132)
	  CONTESTED     clean catch that won a contest
	  FLOW xN       N consecutive quick releases (catch-and-go passing)
	  COMBO         movement chain converted into the catch (tiered)
	  LAYOUT D / HAND BLOCK / BLOCK / INTERCEPTION
	  CALLAHAN, GREATEST, HAMMER / BLADE GOAL, CLUTCH, UNIVERSE, FLOW STATE
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local ProgressionConfig = require(Shared.Config.Progression)

local HighlightService = {}

-- A completion at least this share of the playing field's length is a HUCK.
HighlightService.HuckFraction = 0.55

local services: any

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function HighlightService.broadcast(kind: string, actorId: number, score: number, text: string, tags: { string }?)
	local actor = services.PlayerService.get(actorId)
	local root = actor and services.PlayerService.root(actor)
	Net.event("Highlight"):FireAllClients({
		kind = kind,
		id = actorId,
		name = if actor then actor.name else "",
		team = if actor then actor.team else "",
		text = text,
		score = score,
		tags = tags or {},
		pos = if root then root.Position else nil,
	})
	if services.MatchService.phase() ~= "Intermission" then
		services.MatchService.stat(actorId, "highlights")
	end
end

local function defenderNear(actorId: number, team: string, radius: number): boolean
	local root = Actors.rootOf(actorId)
	if not root then
		return false
	end
	for _, a in services.PlayerService.all() do
		if a.role == "Match" and a.team ~= team and a.team ~= "N" then
			local r = services.PlayerService.root(a)
			if r and (r.Position - root.Position).Magnitude <= radius then
				return true
			end
		end
	end
	return false
end

local function has(outcomes: { any }, kind: string): any
	for _, o in outcomes do
		if o.kind == kind then
			return o
		end
	end
	return nil
end

-- Converts the actor's movement chain into this play (x2 score and XP).
local function convertCombo(actorId: number, payoff: string, at: number?): any
	local summary = services.MovementService.convertCombo(actorId, payoff, at)
	if not summary then
		return nil
	end
	local player = Actors.playerOf(actorId)
	if player then
		Net.event("Combo"):FireClient(player, summary)
		services.ProgressionService.combo(player, summary)
	end
	return summary
end

function HighlightService.onCatch(info: any, lastPass: any, outcomes: { any })
	local tags: { string } = {}
	local score = 0
	local completion = has(outcomes, "Completion")
	local interception = has(outcomes, "Interception")
	if info.zone == "Dive" then
		table.insert(tags, if interception then "LAYOUT D" else "LAYOUT")
		score += 500
		services.MatchService.stat(info.id, "layouts")
	end
	if not info.grounded and info.zone ~= "Dive" and defenderNear(info.id, info.team, 4.5) then
		table.insert(tags, "SKY")
		score += 450
	end
	if completion and lastPass and lastPass.releasePos then
		local dist = flat(info.pos - lastPass.releasePos).Magnitude
		if dist >= HighlightService.HuckFraction * services.ArenaService.field().length then
			table.insert(tags, "HUCK")
			score += 300
			services.MatchService.stat(info.id, "hucks")
			if lastPass.thrower then
				services.MatchService.stat(lastPass.thrower, "hucks")
			end
		end
		if (lastPass.flow or 0) >= 3 then
			table.insert(tags, "FLOW x" .. lastPass.flow)
			score += 120 * lastPass.flow
		end
	end
	if info.contested and info.quality == "Clean" then
		table.insert(tags, "CONTESTED")
		score += 250
	end
	if interception then
		table.insert(tags, "INTERCEPTION")
		score += 300
	end
	local payoff = if info.zone == "Dive" then "Layout Catch" elseif interception then "Interception" else "Catch"
	local combo = convertCombo(info.id, payoff, if type(info.t) == "number" then info.t else nil)
	if combo and combo.tier then
		table.insert(tags, combo.tier .. " COMBO")
		score += math.floor(combo.score / 4)
	end
	if #tags > 0 and score >= 250 then
		HighlightService.broadcast("Catch", info.id, score, table.concat(tags, "  ·  "), tags)
	end
end

function HighlightService.onTouched(info: any, _lastPass: any)
	if info.kind == "Bobble" then
		return
	end
	local tags: { string } = {}
	local score = 250
	if info.kind == "HandBlock" then
		table.insert(tags, "HAND BLOCK")
		score = 600
	elseif info.zone == "Dive" then
		table.insert(tags, "LAYOUT D")
		score = 650
		services.MatchService.stat(info.id, "layouts")
	else
		table.insert(tags, "BLOCK")
	end
	local combo = convertCombo(info.id, "Block")
	if combo and combo.tier then
		table.insert(tags, combo.tier .. " COMBO")
		score += math.floor(combo.score / 4)
	end
	HighlightService.broadcast("Block", info.id, score, table.concat(tags, "  ·  "), tags)
end

function HighlightService.onGoal(o: any, lastPass: any, clutch: boolean)
	local tags: { string } = {}
	local score = 400
	if o.callahan then
		table.insert(tags, "CALLAHAN")
		score += 1200
	end
	if lastPass and not o.callahan then
		if lastPass.throwType == "Hammer" then
			table.insert(tags, "HAMMER")
			score += 250
		elseif lastPass.throwType == "Blade" then
			table.insert(tags, "BLADE")
			score += 200
		elseif lastPass.throwType == "Scoober" then
			table.insert(tags, "SCOOBER")
			score += 250
		end
	end
	if (o.passes or 0) >= 10 then
		table.insert(tags, "FLOW STATE")
		score += 300
	end
	if o.universe then
		table.insert(tags, "UNIVERSE")
		score += 500
	elseif clutch then
		table.insert(tags, "CLUTCH")
		score += 300
	end
	local name = Actors.nameOf(o.scorer)
	local text = if #tags > 0 then table.concat(tags, "  ·  ") else "GOAL"
	HighlightService.broadcast("Goal", o.scorer, score, text, tags)
	local _ = name
	local _ = ProgressionConfig
end

function HighlightService.Init(s: any)
	services = s
end

function HighlightService.Start() end

return HighlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- LeaderboardService — seasonal ranked leaderboard on an OrderedDataStore.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ProgressionConfig = require(Shared.Config.Progression)

local LeaderboardService = {}

local store: OrderedDataStore? = nil
local cache: { any } = {}
local cachedAt = -math.huge
local lastSubmit: { [number]: number } = {}
local names: { [number]: string } = {}

function LeaderboardService.submit(player: Player, rating: number)
	local ods = store
	if not ods then
		return
	end
	local clock = os.clock()
	if (lastSubmit[player.UserId] or -math.huge) > clock - 30 then
		return
	end
	lastSubmit[player.UserId] = clock
	task.spawn(function()
		pcall(function()
			(ods :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(rating))
		end)
	end)
end

local function refresh()
	local ods = store
	if not ods then
		return
	end
	local ok, pages = pcall(function()
		return (ods :: OrderedDataStore):GetSortedAsync(false, 50)
	end)
	if not ok or not pages then
		return
	end
	local list = {}
	for rank, entry in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(entry.key) or 0
		local name = names[userId]
		if not name then
			local okName, result = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			name = if okName and type(result) == "string" then result else ("Player " .. entry.key)
			names[userId] = name
		end
		table.insert(list, {
			rank = rank,
			userId = userId,
			name = name,
			rating = entry.value,
			division = ProgressionConfig.division(entry.value).name,
		})
	end
	cache = list
	cachedAt = os.clock()
end

function LeaderboardService.Init(_s: any)
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("UB_Rating_" .. ProgressionConfig.Rating.Season)
	end)
	if ok then
		store = result
	end
end

function LeaderboardService.Start()
	Net.func("GetLeaderboard").OnServerInvoke = function(_player)
		return { season = ProgressionConfig.Rating.Season, entries = cache, age = os.clock() - cachedAt }
	end
	-- refresh in the background so the remote never yields on DataStore calls
	task.spawn(function()
		while true do
			refresh()
			task.wait(90)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MatchService — the match loop.

	  Intermission  free-play warm-up disc and the mode + arena votes. The
	                head count decides which modes are eligible
	                (Config/Modes.eligible: Mini 3v3 up to 6 humans, Normal
	                7v7 from 10, a vote in between); the list refreshes on
	                every join / leave / training change. 20 s countdown with
	                2+ humans, 30 s alone ("Practice vs bots — waiting for
	                players"). In a private server or Studio the host picks
	                the mode and rules and can start at once.
	  PointSetup    TeamService picks the line (MatchPlan: whoever sat out
	                longest, bots fill to exactly 3v3 / 7v7); the lines are
	                teleported behind the goal lines they defend, substitutes
	                to their team's bench. Everyone is frozen only 0.6 s, then
	                may move behind their own goal line (UBLineX / UBLineSide).
	                End zones glow in the attacking team's colour.
	  Pull          the defending team's puller throws to the receivers; at
	                the release anyone more than 3 studs offside is pulled
	                back behind their line and the restriction lifts (modes
	                without pulls skip straight to Live)
	  Live          the RulesEngine decides what every catch, landing, block
	                and stall-out means; this service applies the result.
	                A grounded disc is picked up (no teleport) by an
	                offensive player who reaches it slower than 12 studs/s or
	                presses the pickup key; the pivot is set on the disc and
	                the client glides onto it.
	  PointOver     celebration, then the next point (teams switch ends)
	  MatchOver     summary, progression, ranked rating, back to Intermission

	Ranked is automatic: a public server (not private, not Studio), a
	RankedEligible mode and both lines all human at the start. Ranked matches
	never take private-server rules. A ranked roster player who leaves (or
	goes to training) takes a loss and the result is void for everyone else.

	Every relocation and pickup sets the holder's pivot through
	MovementService.setPivot, so the client always agrees where P is.

	Match state is published as attributes on ReplicatedStorage.UBState so
	late joiners and every UI read the same truth (Phase, Mode, TeamSize,
	HumansA/B, BotsA/B, ForceA/B, VoteModes, RankedReady, Lobby, ...).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ModesConfig = require(Shared.Config.Modes)
local ArenasConfig = require(Shared.Config.Arenas)
local TeamsConfig = require(Shared.Config.Teams)
local DiscConfig = require(Shared.Config.Disc)
local RulesEngine = require(Shared.Rules.RulesEngine)
local FieldGeometry = require(Shared.Rules.FieldGeometry)
local MatchPlan = require(Shared.Rules.MatchPlan)
local Solver = require(Shared.Disc.Solver)

local MatchService = {}

local services: any
local stateFolder: Folder

local INTERMISSION_PVP = 20 -- seconds with 2+ humans
local INTERMISSION_SOLO = 30 -- seconds with one human (practice vs bots)
local SOLO_TEXT = "Practice vs bots — waiting for players"
local LINEUP_FREEZE = 0.6 -- the line-up teleport settles, then players may move
local OFFSIDE_PULLBACK = 3 -- studs past the line at the pull release
local PICKUP_SPEED = 12 -- studs/s: slower than this near the disc picks it up
local PICKUP_KEY_WINDOW = 0.35 -- a pickup key press counts this long
local GATHER_SKIP = 0.6 -- travel checks pause while the client glides onto the disc (+ a round trip)
local BOT_WAIT = 8 -- seconds a match start waits for its bots
local FORCE_FH_CHANCE = 0.65

type Stats = { [string]: number }

type PointInfo = {
	offense: string,
	defense: string,
	pull: boolean,
	discTeam: string, -- who gets the disc to start the point (puller / holder)
}

type MatchState = {
	phase: string,
	phaseEnd: number,
	mode: ModesConfig.ModeRules,
	arenaId: string,
	engine: RulesEngine.State?,
	disc: any,
	warmupDisc: any,
	matchEnd: number,
	matchCount: number,
	rotation: { [string]: number },
	puller: number?,
	starter: number?, -- puller (pull) or first holder (no pull) of this point
	point: PointInfo?,
	stats: { [number]: Stats },
	lastPass: { [string]: any }?,
	lastCatchAt: { [number]: number },
	flow: number,
	votes: { mode: { [number]: string }, arena: { [number]: string } },
	voteModes: { string },
	voteDefault: string,
	voteArenas: { string },
	privateConfig: { [string]: any },
	hostId: number,
	groundSince: number,
	pendingMatchOver: boolean,
	pointStartedAt: number,
	unfreezeAt: number?,
	lineSides: { [number]: FieldGeometry.Side }, -- actors held behind a goal line until the pull
	slots: { [string]: { [number]: number } }, -- team -> line-up index -> actor
	placed: { [number]: string }, -- actor -> "point:team:role" it was placed for
	suppressPlacement: boolean,
	pickupWanted: { [number]: number },
	pendingJoin: { any },
	penalized: { [number]: boolean },
	pvp: boolean,
	holderPos: Vector3?,
	lobbyText: string,
}

local S: MatchState = {
	phase = "Boot",
	phaseEnd = 0,
	mode = ModesConfig.copy(ModesConfig.Default),
	arenaId = ArenasConfig.Default,
	engine = nil,
	disc = nil,
	warmupDisc = nil,
	matchEnd = 0,
	matchCount = 0,
	rotation = { A = 0, B = 0 },
	puller = nil,
	starter = nil,
	point = nil,
	stats = {},
	lastPass = nil,
	lastCatchAt = {},
	flow = 0,
	votes = { mode = {}, arena = {} },
	voteModes = {},
	voteDefault = ModesConfig.Default,
	voteArenas = {},
	privateConfig = {},
	hostId = 0,
	groundSince = 0,
	pendingMatchOver = false,
	pointStartedAt = 0,
	unfreezeAt = nil,
	lineSides = {},
	slots = { A = {}, B = {} },
	placed = {},
	suppressPlacement = false,
	pickupWanted = {},
	pendingJoin = {},
	penalized = {},
	pvp = false,
	holderPos = nil,
	lobbyText = "",
}

local rng = Random.new()

local function now(): number
	return Net.now()
end

local function set(key: string, value: any)
	stateFolder:SetAttribute(key, value)
end

local function notifyAll(kind: string, text: string, data: any?)
	Net.event("Notify"):FireAllClients(kind, text, data)
end

local function notify(actorId: number, kind: string, text: string, data: any?)
	local p = services.Actors.playerOf(actorId)
	if p then
		Net.event("Notify"):FireClient(p, kind, text, data)
	end
end

function MatchService.phase(): string
	return S.phase
end

-- The rules the current (or last) match plays: TeamSize, FillWithBots,
-- RankedEligible, Ranked, Field, ...
function MatchService.mode(): ModesConfig.ModeRules
	return S.mode
end

function MatchService.engine(): RulesEngine.State?
	return S.engine
end

function MatchService.disc(): any
	return S.disc
end

---------------------------------------------------------------------------
-- stats
---------------------------------------------------------------------------

function MatchService.stat(actorId: number, key: string, n: number?)
	local st = S.stats[actorId]
	if not st then
		st = {}
		S.stats[actorId] = st
	end
	local amount = n or 1
	st[key] = (st[key] or 0) + amount
	local actor = services.PlayerService.get(actorId)
	if actor and not actor.isBot and S.phase ~= "Intermission" then
		services.ProgressionService.stat(actor, key, amount)
	end
end

---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------

local function setPhase(name: string, duration: number?)
	S.phase = name
	S.phaseEnd = if duration then now() + duration else math.huge
	set("Phase", name)
	set("PhaseEnd", if duration then S.phaseEnd else 0)
end

local function teamColor(team: string): Color3
	return if team == "A" then TeamsConfig.A.Color else TeamsConfig.B.Color
end

local function teamName(team: string): string
	return if team == "A" then TeamsConfig.A.Name else TeamsConfig.B.Name
end

local function field(): FieldGeometry.Field
	return services.ArenaService.field()
end

local function recolorEndZones()
	local e = S.engine
	for _, side in { "East", "West" } do
		local part = services.ArenaService.endZone(side)
		if part then
			local attacker: string? = nil
			if e then
				if e.attack.A == side then
					attacker = "A"
				elseif e.attack.B == side then
					attacker = "B"
				end
			end
			part.Color = if attacker then teamColor(attacker) else Color3.fromRGB(200, 200, 210)
			local gui = part:FindFirstChild("Label")
			local text = gui and gui:FindFirstChild("Text")
			if text and text:IsA("TextLabel") then
				text.Text = if attacker then (teamName(attacker) .. " SCORES HERE") else ""
			end
		end
	end
end

local function publishScore()
	local e = S.engine
	set("ScoreA", if e then e.score.A else 0)
	set("ScoreB", if e then e.score.B else 0)
	set("Offense", if e then e.offense else "")
	set("AttackA", if e then e.attack.A else "East")
	set("AttackB", if e then e.attack.B else "West")
	set("Universe", if e then e.universe else false)
	set("CapReached", if e then e.capReached else false)
	set("Point", if e then e.pointNumber else 0)
end

-- TeamSize and the human / bot head count per team (A/B).
local function publishCounts()
	local c = services.TeamService.counts()
	set("TeamSize", S.mode.TeamSize)
	set("HumansA", if c then c.A.humans else 0)
	set("HumansB", if c then c.B.humans else 0)
	set("BotsA", if c then c.A.bots else 0)
	set("BotsB", if c then c.B.bots else 0)
	if c and c.A.humans > 0 and c.B.humans > 0 then
		S.pvp = true
	end
end

local function setHolderAttr(id: number?)
	set("HolderId", id or 0)
end

local function applySkin(d: any, actorId: number)
	local actor = services.PlayerService.get(actorId)
	if actor and actor.player then
		services.DiscService.setSkin(d, services.ProgressionService.equipped(actor.player, "disc"))
	else
		services.DiscService.setSkin(d, "Classic")
	end
end

local function faceField(pos: Vector3): CFrame
	local target = Vector3.new(0, pos.Y, 0)
	if (target - pos).Magnitude < 1 then
		target = pos + Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(pos, target)
end

-- Root position for an actor standing on a ground point.
local function standingAt(actorId: number, ground: Vector3): Vector3
	return Vector3.new(ground.X, field().groundY + services.MovementService.standHeight(actorId) + 0.1, ground.Z)
end

local function benchSign(team: string): number
	return if team == "A" then MatchPlan.BenchSign.A else MatchPlan.BenchSign.B
end

-- Lets every non-training actor move (drills manage their own freezes).
local function unfreezeAll()
	services.PlayerService.setAllFrozen(false, function(a: any): boolean
		return a.role ~= "Training"
	end)
end

local function startStallFor(id: number)
	services.DefenseService.startStall(id, S.mode.StallInterval, S.mode.StallMax)
end

local function rankedEnv(): MatchPlan.RankedEnv
	return { privateServer = game.PrivateServerId ~= "", studio = RunService:IsStudio() }
end

---------------------------------------------------------------------------
-- placement: line-ups, benches, relocations
---------------------------------------------------------------------------

local function placedKey(actor: any): string
	local e = S.engine
	return string.format("%d:%s:%s", if e then e.pointNumber else 0, actor.team, actor.role)
end

-- Lowest free line-up index of a team (1..TeamSize, then beyond).
local function freeSlot(team: string, id: number): number
	local slots = S.slots[team]
	for i, other in slots do
		if other == id then
			return i
		end
	end
	local i = 1
	while slots[i] ~= nil and slots[i] ~= id do
		i += 1
	end
	return i
end

local function releaseSlot(id: number)
	for _, slots in S.slots do
		for i, other in slots do
			if other == id then
				slots[i] = nil
			end
		end
	end
end

-- A field player on line-up spot `index` behind the goal line their team
-- defends; `restrict` keeps them behind it until the pull.
local function lineUp(actor: any, index: number, restrict: boolean, frozen: boolean)
	local e = S.engine
	if not e then
		return
	end
	local f = field()
	local side: FieldGeometry.Side = RulesEngine.defends(e, actor.team)
	local count = math.max(S.mode.TeamSize, index)
	local ground = FieldGeometry.lineupSpot(f, side, index, count)
	releaseSlot(actor.id)
	S.slots[actor.team][index] = actor.id
	services.PlayerService.teleport(actor, faceField(standingAt(actor.id, ground)), { face = true })
	if restrict then
		local x, sign = FieldGeometry.lineRestriction(f, side)
		services.PlayerService.setLine(actor, x, sign)
		S.lineSides[actor.id] = side
	else
		services.PlayerService.setLine(actor, nil, nil)
		S.lineSides[actor.id] = nil
	end
	services.PlayerService.setFrozen(actor, frozen)
	S.placed[actor.id] = placedKey(actor)
end

-- A substitute on their team's bench, facing the field.
local function seatOnBench(actor: any)
	local bench = services.TeamService.benchFor(actor.team)
	local index = table.find(bench, actor.id) or (#bench + 1)
	local spots = FieldGeometry.benchSpots(field(), benchSign(actor.team), math.max(#bench, index))
	local ground = spots[math.clamp(index, 1, #spots)]
	local pos = standingAt(actor.id, ground)
	releaseSlot(actor.id)
	services.PlayerService.teleport(actor, CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)), { face = true })
	services.PlayerService.setLine(actor, nil, nil)
	S.lineSides[actor.id] = nil
	services.PlayerService.setFrozen(actor, false)
	S.placed[actor.id] = placedKey(actor)
end

-- Puts an actor where their team and role belong right now.
local function placeActor(actor: any)
	local e = S.engine
	if not e or (actor.team ~= "A" and actor.team ~= "B") then
		if actor.role ~= "Training" then
			services.PlayerService.setLine(actor, nil, nil)
			services.PlayerService.teleport(actor, services.ArenaService.spawnCFrame(), { face = true })
		end
		return
	end
	if actor.role == "Bench" then
		seatOnBench(actor)
	elseif actor.role == "Match" then
		local beforePull = S.phase == "PointSetup" or S.phase == "Pull"
		local frozen = S.phase == "PointSetup" and S.unfreezeAt ~= nil
		lineUp(actor, freeSlot(actor.team, actor.id), beforePull, frozen)
	end
end

-- Moves the holder onto a ground spot and plants their pivot there.
local function moveHolder(actor: any, ground: Vector3)
	local root = services.PlayerService.root(actor)
	local pos = standingAt(actor.id, ground)
	services.MovementService.setPivot(actor.id, pos)
	local rot = if root then root.CFrame.Rotation else CFrame.identity
	services.PlayerService.teleport(actor, CFrame.new(pos) * rot)
end

-- At the pull release: anyone well past their line goes back behind it, then
-- every line restriction lifts.
local function releaseLines(exceptId: number?)
	local f = field()
	for id, lineSide in S.lineSides do
		local side: FieldGeometry.Side = if lineSide == "East" then "East" else "West"
		local actor = services.PlayerService.get(id)
		local root = actor and services.PlayerService.root(actor)
		if actor and root and id ~= exceptId and actor.role == "Match" then
			local pos = root.Position
			if FieldGeometry.offsideBy(f, pos, side) > OFFSIDE_PULLBACK then
				local back = FieldGeometry.behindLine(f, pos, side, 1)
				services.PlayerService.teleport(actor, CFrame.new(back) * root.CFrame.Rotation)
			end
		end
	end
	S.lineSides = {}
	services.PlayerService.clearLines()
end

---------------------------------------------------------------------------
-- disc handlers
---------------------------------------------------------------------------

local applyOutcomes: (outcomes: { any }, ctx: { [string]: any }?) -> ()

local matchHandler = {} :: any

function matchHandler.canClaim(d: any, actorId: number, team: string): boolean
	local e = S.engine
	if not e or e.phase ~= "Live" or (team ~= "A" and team ~= "B") then
		return false
	end
	local actor = services.PlayerService.get(actorId)
	if not actor or actor.role ~= "Match" then
		return false
	end
	if d.pull then
		return team == e.offense
	end
	return true
end

function matchHandler.canThrow(_d: any, actorId: number): boolean
	local e = S.engine
	if not e or e.holder ~= actorId then
		return false
	end
	if S.phase == "Pull" then
		return e.phase == "Pull"
	end
	return S.phase == "Live" and e.phase == "Live"
end

function matchHandler.onThrown(d: any, info: any)
	local e = S.engine
	if not e then
		return
	end
	local wasPull = S.phase == "Pull"
	d.meta.pullPending = false
	local caughtAt = S.lastCatchAt[info.id]
	local quick = caughtAt ~= nil and now() - caughtAt <= DiscConfig.Throw.QuickReleaseWindow
	if quick then
		S.flow += 1
	else
		S.flow = 1
	end
	S.lastPass = {
		thrower = info.id,
		team = info.team,
		throwType = info.params.throwType,
		quality = info.launch.quality,
		releasePos = info.launch.releasePos,
		releaseAt = now(),
		pull = wasPull,
		quick = quick,
		flow = S.flow,
		blocked = info.blocked,
	}
	services.DefenseService.stopStall()
	setHolderAttr(nil)
	if not wasPull then
		MatchService.stat(info.id, "throws")
		if info.launch.quality == "Perfect" then
			MatchService.stat(info.id, "perfectReleases")
		end
	end
	applyOutcomes(RulesEngine.throw(e, info.id, info.pos), { thrower = info.id })
end

function matchHandler.onCaught(d: any, info: any)
	local e = S.engine
	if not e then
		return
	end
	local outcomes = RulesEngine.catch(e, info.id, info.team, info.pos, info.grounded, info.jumpOrigin)
	if #outcomes == 0 then
		-- engine refused (should not happen); keep the world consistent
		services.DiscService.placeOnGround(d, info.pos)
		return
	end
	S.lastCatchAt[info.id] = now()
	if not info.grounded then
		services.MovementService.expectLanding(info.id)
	end
	applySkin(d, info.id)
	services.HighlightService.onCatch(info, S.lastPass, outcomes)
	applyOutcomes(outcomes, { catch = info })
end

function matchHandler.onTouched(_d: any, info: any)
	local e = S.engine
	if not e then
		return
	end
	local outcomes = RulesEngine.touch(e, info.id, info.team)
	services.HighlightService.onTouched(info, S.lastPass)
	applyOutcomes(outcomes, { touch = info })
end

local function exitPointFromSamples(samples: { any }, land: Vector3): Vector3?
	local f = field()
	local lastIn: Vector3? = nil
	for _, s in samples do
		local p = Vector3.new(s.x, f.groundY, s.z)
		if FieldGeometry.inBounds(f, p) then
			lastIn = p
		elseif lastIn then
			return FieldGeometry.exitPoint(f, lastIn, p)
		end
	end
	if lastIn and not FieldGeometry.inBounds(f, land) then
		return FieldGeometry.exitPoint(f, lastIn, land)
	end
	return nil
end

function matchHandler.onGrounded(d: any, land: Vector3, samples: { any })
	local e = S.engine
	if not e then
		services.DiscService.placeOnGround(d, land)
		return
	end
	local exitPos = exitPointFromSamples(samples, land)
	local outcomes = RulesEngine.ground(e, land, exitPos)
	if #outcomes == 0 then
		services.DiscService.placeOnGround(d, field().center)
	end
	applyOutcomes(outcomes, { land = land })
end

-- Warm-up free play: anyone can catch, throw and pick up.
local warmupHandler = {} :: any
function warmupHandler.canClaim(_d: any, actorId: number, _team: string): boolean
	local a = services.PlayerService.get(actorId)
	return a ~= nil and a.role ~= "Training"
end
function warmupHandler.canThrow(_d: any, _id: number): boolean
	return true
end
function warmupHandler.onThrown(_d: any, _info: any) end
function warmupHandler.onCaught(d: any, info: any)
	applySkin(d, info.id)
end
function warmupHandler.onTouched(_d: any, _info: any) end
function warmupHandler.onGrounded(d: any, land: Vector3, _samples: any)
	services.DiscService.placeOnGround(d, FieldGeometry.clampInBounds(field(), land, 2))
end

---------------------------------------------------------------------------
-- outcomes
---------------------------------------------------------------------------

local function goal(o: any)
	local e = S.engine :: RulesEngine.State
	publishScore()
	services.DefenseService.stopStall()
	setHolderAttr(nil)
	-- the point is over: the disc rests at the scorer's feet during the celebration
	local scorerRoot = services.Actors.rootOf(o.scorer)
	if S.disc then
		services.DiscService.placeOnGround(
			S.disc,
			if scorerRoot then scorerRoot.Position - Vector3.new(0, 3, 0) else Vector3.zero
		)
	end
	MatchService.stat(o.scorer, "goals")
	if o.callahan then
		MatchService.stat(o.scorer, "callahans")
	end
	if o.assist then
		MatchService.stat(o.assist, "assists")
		local lp = S.lastPass
		if lp and lp.throwType == "Hammer" then
			MatchService.stat(o.assist, "hammerGoals")
		end
	end
	if (o.passes or 0) >= 10 then
		for _, a in services.PlayerService.onTeam(o.team) do
			MatchService.stat(a.id, "flowGoals")
		end
	end
	local clutch = e.universe or e.capReached or (S.matchEnd - now() < 15)
	services.HighlightService.onGoal(o, S.lastPass, clutch)
	notifyAll("Goal", teamName(o.team) .. " SCORE", {
		team = o.team,
		scorer = o.scorer,
		assist = o.assist,
		callahan = o.callahan,
		score = o.score,
	})
	-- everyone may move and celebrate
	S.lineSides = {}
	services.PlayerService.clearLines()
	unfreezeAll()
	setPhase("PointOver", S.mode.CelebrationTime)
end

function applyOutcomes(outcomes: { any }, ctx: { [string]: any }?)
	local e = S.engine
	if not e then
		return
	end
	local d = S.disc
	local _ = ctx
	for _, o in outcomes do
		local kind = o.kind
		if kind == "Turnover" then
			services.DefenseService.stopStall()
			setHolderAttr(nil)
			services.DiscService.placeOnGround(d, o.spot)
			S.groundSince = now()
			S.flow = 0
			local lp = S.lastPass
			if lp and o.reason ~= "Stall" then
				MatchService.stat(lp.thrower, "turnovers")
			end
			notifyAll("Turnover", "TURNOVER", { reason = o.reason, team = o.team })
			publishScore()
		elseif kind == "Completion" or kind == "Interception" or kind == "PullCaught" or kind == "Pickup" then
			setHolderAttr(o.id)
			startStallFor(o.id)
			publishScore()
			if kind == "Completion" then
				MatchService.stat(o.id, "catches")
				if o.from then
					MatchService.stat(o.from, "completions")
				end
			elseif kind == "Interception" then
				MatchService.stat(o.id, "interceptions")
				MatchService.stat(o.id, "catches")
				notifyAll("Turnover", "INTERCEPTION", { reason = "Interception", team = o.team, id = o.id })
			end
		elseif kind == "Relocate" then
			local actor = services.PlayerService.get(o.id)
			if actor then
				moveHolder(actor, o.spot)
			end
		elseif kind == "PullReleased" then
			releaseLines(o.id)
			unfreezeAll()
			S.unfreezeAt = nil
			setPhase("Live")
			notifyAll("Banner", "PULL!", nil)
		elseif kind == "PullLanded" then
			services.DiscService.placeOnGround(d, o.spot)
			S.groundSince = now()
			if o.brick then
				notifyAll("Toast", "Pull out of bounds — brick", nil)
			end
		elseif kind == "DiscDropped" then
			services.DefenseService.stopStall()
			setHolderAttr(nil)
			services.DiscService.placeOnGround(d, o.spot)
		elseif kind == "Block" then
			MatchService.stat(o.id, "blocks")
		elseif kind == "Greatest" then
			MatchService.stat(o.id, "greatests")
			services.HighlightService.broadcast("GREATEST", o.id, 900, "The Greatest!")
		elseif kind == "Goal" then
			goal(o)
		elseif kind == "UniversePoint" then
			notifyAll("Banner", "UNIVERSE POINT", nil)
			publishScore()
		elseif kind == "CapReached" then
			notifyAll("Banner", "TIME CAP", { sub = "Finish the point" })
			publishScore()
		elseif kind == "MatchOver" then
			S.pendingMatchOver = true
		end
	end
end

---------------------------------------------------------------------------
-- phases
---------------------------------------------------------------------------

-- The next player of `team`'s line to start a point with the disc.
local function chooseRotating(team: string): number?
	local line = services.TeamService.lineFor(team)
	if #line == 0 then
		return nil
	end
	S.rotation[team] = (S.rotation[team] % #line) + 1
	return line[S.rotation[team]]
end

-- Each team's markers force one side this point (FH / BH relative to the thrower).
local function pickForce()
	set("ForceA", if rng:NextNumber() < FORCE_FH_CHANCE then "FH" else "BH")
	set("ForceB", if rng:NextNumber() < FORCE_FH_CHANCE then "FH" else "BH")
end

-- Hands the point's disc to its starter (already on their line-up spot).
local function giveStarter(id: number)
	local p = S.point
	local actor = services.PlayerService.get(id)
	if not p or not actor or not actor.character then
		return
	end
	S.starter = id
	services.DiscService.giveTo(S.disc, id)
	applySkin(S.disc, id)
	local attrs = actor.character:GetAttribute("UBTeleportPos")
	local root = services.PlayerService.root(actor)
	local at = if typeof(attrs) == "Vector3" then attrs elseif root then root.Position else nil
	if at then
		services.MovementService.setPivot(id, at)
	end
	if p.pull then
		S.puller = id
		S.disc.meta.pullPending = true
	else
		S.disc.meta.pullHolder = id
	end
end

-- Bots can still be spawning when a point is set up: give the disc to the
-- first starter that exists.
local function tryGiveStarter()
	local p = S.point
	if not p or S.starter ~= nil or S.phase ~= "PointSetup" then
		return
	end
	local id = chooseRotating(p.discTeam)
	if id then
		giveStarter(id)
	end
end

-- Lines every field player up and seats the benches for a new point.
local function placeLines(starter: number?, discTeam: string)
	S.slots = { A = {}, B = {} }
	for _, team in { "A", "B" } do
		local line = services.TeamService.lineFor(team)
		if team == discTeam and starter then
			-- the starter takes the most central spot
			local i = table.find(line, starter)
			if i then
				table.remove(line, i)
				table.insert(line, math.min(#line + 1, math.ceil(S.mode.TeamSize / 2)), starter)
			end
		end
		for i, id in line do
			local actor = services.PlayerService.get(id)
			if actor then
				lineUp(actor, i, true, true)
			end
		end
		for _, id in services.TeamService.benchFor(team) do
			local actor = services.PlayerService.get(id)
			if actor then
				seatOnBench(actor)
			end
		end
	end
end

local function setupPoint()
	local e = S.engine :: RulesEngine.State
	local setup = RulesEngine.setupPoint(e)
	S.pointStartedAt = now()
	S.lastPass = nil
	S.flow = 0
	S.placed = {}
	S.lineSides = {}
	S.puller = nil
	S.starter = nil
	S.pickupWanted = {}
	S.disc.meta.pullHolder = nil
	S.disc.meta.pullPending = false
	recolorEndZones()
	publishScore()
	services.DefenseService.stopStall()
	services.DiscService.hide(S.disc)
	setHolderAttr(nil)
	pickForce()

	local discTeam = if setup.pull then setup.defense else setup.offense
	S.point = { offense = setup.offense, defense = setup.defense, pull = setup.pull, discTeam = discTeam }
	-- pick the line (MatchPlan) without placing anyone twice
	S.suppressPlacement = true
	services.TeamService.setupLine(e.pointNumber)
	S.suppressPlacement = false
	setPhase("PointSetup", S.mode.PointSetupTime)
	S.unfreezeAt = now() + LINEUP_FREEZE

	local starter = chooseRotating(discTeam)
	placeLines(starter, discTeam)
	if starter then
		giveStarter(starter)
	end
	publishCounts()
	notifyAll("Point", if setup.universe then "UNIVERSE POINT" else ("POINT " .. setup.point), {
		offense = setup.offense,
		pull = setup.pull,
	})
end

local function autoPull()
	local e = S.engine
	local pullerId = S.puller
	if not e or not pullerId then
		return false
	end
	local root = services.Actors.rootOf(pullerId)
	if not root then
		return false
	end
	local f = field()
	local target = FieldGeometry.endZoneCenter(f, RulesEngine.defends(e, e.offense))
	local d = target - root.Position
	local sol = Solver.solve({
		rootPos = root.Position,
		pivot = services.MovementService.pivotOf(pullerId),
		throwType = "Backhand",
		target = target + Vector3.new(0, 3, 0),
		groundY = f.groundY,
		wind = services.ArenaService.wind(),
		flightTimeWeight = -0.2, -- prefer hang time on a pull
		coarse = true,
	})
	local params = if sol
		then sol.params
		else {
			throwType = "Backhand",
			yaw = math.atan2(-d.X, -d.Z),
			pitch = math.rad(18),
			holdTime = 0.6,
			bank = 0,
			height = "Mid",
		}
	return services.ThrowService.throw(pullerId, params, true) ~= nil
end

function MatchService.pullNow(id: number)
	if S.phase == "Pull" and S.puller == id then
		autoPull()
	end
end

-- Nobody could pull (or hold): the receivers start with the disc on their brick.
local function startAtBrick()
	local e = S.engine :: RulesEngine.State
	RulesEngine.beginLive(e, nil)
	e.holder = nil
	e.holderTeam = nil
	e.disc = "Ground"
	S.puller = nil
	setHolderAttr(nil)
	services.DefenseService.stopStall()
	local spot = FieldGeometry.brickPoint(field(), RulesEngine.defends(e, e.offense))
	e.discSpot = spot
	services.DiscService.placeOnGround(S.disc, spot)
	S.groundSince = now()
	releaseLines(nil)
	unfreezeAll()
	S.unfreezeAt = nil
	setPhase("Live")
	notifyAll("Banner", "GO!", nil)
end

local function endPointSetup()
	local e = S.engine :: RulesEngine.State
	if S.mode.UsePull then
		local pullerId = S.puller
		local puller = pullerId and services.PlayerService.get(pullerId)
		if not pullerId or not puller then
			startAtBrick()
			return
		end
		RulesEngine.beginPull(e, pullerId)
		setPhase("Pull", S.mode.PullTimeout)
		services.PlayerService.setFrozen(puller, false)
		if puller.isBot then
			services.BotService.schedulePull(puller.id)
		else
			notify(puller.id, "Banner", "YOU'RE PULLING", { sub = "Throw it deep to the other team" })
		end
	else
		local holder = S.disc.meta.pullHolder
		if not holder or not services.PlayerService.get(holder) then
			startAtBrick()
			return
		end
		RulesEngine.beginLive(e, holder)
		releaseLines(holder)
		unfreezeAll()
		S.unfreezeAt = nil
		setPhase("Live")
		setHolderAttr(holder)
		startStallFor(holder)
		notifyAll("Banner", "GO!", nil)
	end
end

local function summary()
	local e = S.engine :: RulesEngine.State
	local rows = {}
	local mvp, mvpScore = nil, -1
	for _, a in services.PlayerService.all() do
		if a.team == "A" or a.team == "B" then
			local st: Stats = S.stats[a.id] or {}
			local score = (st.goals or 0) * 3
				+ (st.assists or 0) * 3
				+ (st.blocks or 0) * 2
				+ (st.interceptions or 0) * 2
				+ (st.catches or 0) * 0.5
				+ (st.highlights or 0)
			table.insert(rows, {
				id = a.id,
				name = a.name,
				team = a.team,
				bot = a.isBot,
				bench = a.role == "Bench",
				goals = st.goals or 0,
				assists = st.assists or 0,
				blocks = st.blocks or 0,
				catches = st.catches or 0,
				throws = st.throws or 0,
				completions = st.completions or 0,
				turnovers = st.turnovers or 0,
				highlights = st.highlights or 0,
			})
			if score > mvpScore then
				mvp, mvpScore = a.id, score
			end
		end
	end
	local result: { [string]: any } = {
		winner = e.winner,
		score = { A = e.score.A, B = e.score.B },
		rows = rows,
		mvp = mvp,
		mode = S.mode.Display,
	}
	return result
end

local function endMatch()
	local e = S.engine :: RulesEngine.State
	local sum = summary()
	local rr = services.TeamService.rankedResult()
	local rankedValid = S.mode.Ranked and rr ~= nil and rr.valid
	local ratingChanges = services.ProgressionService.matchEnded(e.winner, sum.rows, {
		ranked = rankedValid,
		roster = if rr then rr.roster else {},
		ratings = services.TeamService.rosterRatings(),
		margin = math.abs(e.score.A - e.score.B),
		pvp = S.pvp,
	})
	sum.ratingChanges = ratingChanges
	sum.ranked = rankedValid
	sum.rankedVoid = S.mode.Ranked and not rankedValid
	sum.pvp = S.pvp
	Net.event("Summary"):FireAllClients(sum)
	notifyAll(
		"Banner",
		(if e.winner then teamName(e.winner) else "") .. " WIN",
		{ sub = string.format("%d - %d", e.score.A, e.score.B) }
	)
	services.DefenseService.stopStall()
	S.lineSides = {}
	services.PlayerService.clearLines()
	unfreezeAll()
	setPhase("MatchOver", 12)
end

local function tally(votes: { [number]: string }, options: { string }, fallback: string): string
	local counts: { [string]: number } = {}
	for id, v in votes do
		if services.PlayerService.get(id) then
			counts[v] = (counts[v] or 0) + 1
		end
	end
	local best, bestN = fallback, 0
	for _, opt in options do
		if (counts[opt] or 0) > bestN then
			best, bestN = opt, counts[opt]
		end
	end
	return best
end

local function publishVotes()
	local counts = { mode = {}, arena = {} }
	for _, v in S.votes.mode do
		counts.mode[v] = (counts.mode[v] or 0) + 1
	end
	for _, v in S.votes.arena do
		counts.arena[v] = (counts.arena[v] or 0) + 1
	end
	set("VoteCounts", HttpService:JSONEncode(counts))
end

local function humansNotTraining(): number
	local n = 0
	for _, a in services.PlayerService.humans() do
		if a.role ~= "Training" then
			n += 1
		end
	end
	return n
end

-- The mode the next match would play: the vote among the eligible modes;
-- the private-server / Studio host's Mode setting or vote decides.
local function pickMode(humans: number): string
	local options, default = ModesConfig.eligible(humans)
	if S.hostId ~= 0 then
		options = table.clone(ModesConfig.Order)
	end
	local modeId = tally(S.votes.mode, options, default)
	if S.hostId ~= 0 then
		local hostMode = S.votes.mode[S.hostId]
		if hostMode and table.find(options, hostMode) then
			modeId = hostMode
		end
		local configured = S.privateConfig.Mode
		if type(configured) == "string" and ModesConfig.has(configured) then
			modeId = configured
		end
	end
	return modeId
end

-- Ranked progress for the mode the next match would play ("4/6") and
-- whether it would be ranked.
local function publishRanked()
	local humans = humansNotTraining()
	local rules = ModesConfig.copy(pickMode(humans))
	local ok, reason = MatchPlan.rankedEligible(rules, humans, rankedEnv())
	set("RankedReady", MatchPlan.rankedReady(rules, humans))
	set("RankedStatus", reason)
	set("RankedNext", ok and S.hostId == 0)
	if S.phase == "Intermission" then
		set("TeamSize", rules.TeamSize)
	end
end

-- Which modes this head count may play (the host may pick either).
local function refreshVoteOptions()
	local humans = humansNotTraining()
	local options, default = ModesConfig.eligible(humans)
	if S.hostId ~= 0 then
		options = table.clone(ModesConfig.Order)
	end
	S.voteModes = options
	S.voteDefault = default
	for id, v in S.votes.mode do
		if not table.find(options, v) then
			S.votes.mode[id] = nil
		end
	end
	set("VoteModes", table.concat(options, ","))
	set("VoteDefault", default)
	publishVotes()
	publishRanked()
end

local function setLobbyText(text: string)
	if S.lobbyText ~= text then
		S.lobbyText = text
		set("Lobby", text)
	end
end

local function lobbyDuration(humans: number): number?
	if humans <= 0 then
		return nil
	end
	return if humans >= 2 then INTERMISSION_PVP else INTERMISSION_SOLO
end

local function startIntermission()
	S.engine = nil
	S.point = nil
	S.pendingMatchOver = false
	S.lineSides = {}
	S.unfreezeAt = nil
	services.TeamService.clearMatch()
	services.DefenseService.stopStall()
	services.PlayerService.clearLines()
	if S.disc then
		services.DiscService.hide(S.disc)
	end
	-- warm-up disc on the field
	if not S.warmupDisc then
		S.warmupDisc = services.DiscService.create("Warmup", nil, warmupHandler)
	end
	services.DiscService.placeOnGround(S.warmupDisc, Vector3.new(0, 0, -20))
	recolorEndZones()
	publishScore()
	setHolderAttr(nil)
	S.votes = { mode = {}, arena = {} }
	local arenas = {}
	local order = ArenasConfig.Order
	for i = 0, 2 do
		table.insert(arenas, order[((S.matchCount + i) % #order) + 1])
	end
	S.voteArenas = arenas
	set("VoteArenas", table.concat(arenas, ","))
	unfreezeAll()
	local humans = humansNotTraining()
	setPhase("Intermission", lobbyDuration(humans))
	setLobbyText(if humans == 1 then SOLO_TEXT else "")
	set("Ranked", false)
	set("HumansA", 0)
	set("HumansB", 0)
	set("BotsA", 0)
	set("BotsB", 0)
	refreshVoteOptions()
end

local placeIntoMatch: (actor: any) -> ()

local function startMatch()
	if S.warmupDisc then
		services.DiscService.hide(S.warmupDisc)
	end
	local humans = humansNotTraining()
	if humans == 0 then
		startIntermission()
		return
	end
	-- resolve votes (the private-server / Studio host decides)
	local modeId = pickMode(humans)
	local arenaId = tally(S.votes.arena, S.voteArenas, S.voteArenas[1] or ArenasConfig.Default)
	local host = S.hostId
	if host ~= 0 then
		arenaId = S.votes.arena[host] or arenaId
	end
	local ranked = false
	if host == 0 then
		ranked = (MatchPlan.rankedEligible(ModesConfig.copy(modeId), humans, rankedEnv()))
	end
	-- a ranked match never takes private rules; the host's Mode key wins otherwise
	local mode = ModesConfig.resolve(modeId, {
		ranked = ranked,
		private = if host ~= 0 then S.privateConfig else nil,
	})
	local arena = (ArenasConfig.List :: any)[arenaId] or ArenasConfig.List[ArenasConfig.Default]
	if (mode.Ranked and not arena.Competitive) or (not mode.SpecialArenas and arena.Rebound) then
		arena = ArenasConfig.List[ArenasConfig.Default]
	end
	S.mode = mode
	S.matchCount += 1
	if arena.id ~= S.arenaId or mode.Field ~= services.ArenaService.fieldName() then
		S.arenaId = arena.id
		services.ArenaService.build(arena.id, mode.Field)
	end
	set("Mode", mode.id)
	set("ModeName", mode.Display)
	set("TeamSize", mode.TeamSize)
	set("PointsToWin", mode.PointsToWin)
	set("StallMax", mode.StallMax)
	set("PreviewFraction", mode.PreviewFraction)
	set("LandingShadow", mode.LandingShadow)
	set("Ranked", mode.Ranked)
	setLobbyText("")

	S.stats = {}
	S.lastCatchAt = {}
	S.rotation = { A = 0, B = 0 }
	S.penalized = {}
	S.pvp = false
	services.ProgressionService.matchStarted()
	services.TeamService.assignForMatch(mode)
	services.TeamService.waitForBots(BOT_WAIT)

	local engine = RulesEngine.new(field(), { pointsToWin = mode.PointsToWin, usePull = mode.UsePull })
	local first = if S.matchCount % 2 == 0 then "A" else "B"
	RulesEngine.startMatch(engine, first, "East")
	engine.universe = mode.StartUniverse
	S.engine = engine
	S.matchEnd = now() + mode.TimeCap
	set("MatchEnd", S.matchEnd)
	if not S.disc then
		S.disc = services.DiscService.create("Match", nil, matchHandler)
	end
	set("DiscId", S.disc.id)
	notifyAll("Banner", string.upper(mode.Display), { sub = if mode.Ranked then "RANKED" else arena.Display })
	setupPoint()
	-- humans who arrived while the match was starting
	local pending = S.pendingJoin
	S.pendingJoin = {}
	for _, a in pending do
		if services.PlayerService.get(a.id) and a.role ~= "Training" then
			placeIntoMatch(a)
		end
	end
end

---------------------------------------------------------------------------
-- per-frame
---------------------------------------------------------------------------

-- No teleport: an eligible player who reaches the disc slowly (or presses the
-- pickup key) gets it, the pivot is planted on the disc and their client
-- glides onto it.
local function pickupCheck(d: any, allowTeam: string?)
	if not d or d.mode ~= "Ground" then
		return
	end
	local spot = d.folder:GetAttribute("GroundPos")
	if typeof(spot) ~= "Vector3" then
		return
	end
	local tNow = now()
	local best, bestDist = nil, DiscConfig.Catch.PickupRadius
	for _, a in services.PlayerService.all() do
		local eligible = if allowTeam then (a.team == allowTeam and a.role == "Match") else a.role ~= "Training"
		local root = eligible and services.PlayerService.root(a)
		if root then
			local pos = root.Position
			local dist = Vector3.new(pos.X - spot.X, 0, pos.Z - spot.Z).Magnitude
			if dist < bestDist and math.abs(pos.Y - spot.Y) < 8 then
				local v = root.AssemblyLinearVelocity
				local slow = Vector3.new(v.X, 0, v.Z).Magnitude < PICKUP_SPEED
				local pressed = (S.pickupWanted[a.id] or -math.huge) >= tNow - PICKUP_KEY_WINDOW
				if a.isBot or slow or pressed then
					best, bestDist = a, dist
				end
			end
		end
	end
	if not best then
		return
	end
	local outcomes = {}
	if allowTeam then
		local e = S.engine :: RulesEngine.State
		outcomes = RulesEngine.pickup(e, best.id, best.team)
		if #outcomes == 0 then
			return
		end
	end
	S.pickupWanted[best.id] = nil
	services.DiscService.giveTo(d, best.id)
	services.MovementService.setPivot(best.id, standingAt(best.id, spot))
	services.MovementService.skipTravel(best.id, GATHER_SKIP + 2 * services.MovementService.ping(best.id))
	applySkin(d, best.id)
	if allowTeam then
		applyOutcomes(outcomes)
	end
end

-- The pickup key (humans via Action "Pickup", bots directly).
function MatchService.requestPickup(actorId: number)
	S.pickupWanted[actorId] = now()
end

local function stepIntermission(t: number)
	pickupCheck(S.warmupDisc, nil)
	local humans = humansNotTraining()
	setLobbyText(if humans == 1 then SOLO_TEXT else "")
	if humans == 0 then
		if S.phaseEnd ~= math.huge then
			setPhase("Intermission", nil)
		end
		return
	end
	if S.phaseEnd == math.huge then
		S.phaseEnd = t + (lobbyDuration(humans) :: number)
		set("PhaseEnd", S.phaseEnd)
	elseif humans >= 2 and S.phaseEnd - t > INTERMISSION_PVP then
		-- someone joined a solo countdown: PvP starts sooner
		S.phaseEnd = t + INTERMISSION_PVP
		set("PhaseEnd", S.phaseEnd)
	end
	if t >= S.phaseEnd then
		-- startMatch yields (arena rebuild, bot spawning); mark the phase
		-- first so later Heartbeats cannot start a second match
		setPhase("Starting")
		task.spawn(function()
			local ok, err = pcall(function()
				startMatch()
			end)
			if not ok then
				warn("[MatchService] startMatch failed: " .. tostring(err))
				startIntermission()
			end
		end)
	end
end

local function step()
	local t = now()
	local phase = S.phase
	if phase == "Intermission" then
		stepIntermission(t)
		return
	end
	if phase == "Starting" or phase == "Boot" then
		return
	end
	local e = S.engine
	if not e then
		return
	end
	local holder = e.holder
	if holder then
		local r = services.Actors.rootOf(holder)
		if r then
			S.holderPos = r.Position
		end
	end
	if
		t >= S.matchEnd
		and not e.capReached
		and (phase == "Live" or phase == "Pull" or phase == "PointSetup" or phase == "PointOver")
	then
		applyOutcomes(RulesEngine.reachCap(e))
	end
	if phase == "PointSetup" then
		local unfreezeAt = S.unfreezeAt
		if unfreezeAt and t >= unfreezeAt then
			-- the line-up has settled: move freely behind your own goal line
			S.unfreezeAt = nil
			unfreezeAll()
		end
		tryGiveStarter()
		if t >= S.phaseEnd then
			endPointSetup()
		end
	elseif phase == "Pull" then
		if t >= S.phaseEnd then
			if not autoPull() then
				-- the puller vanished: give the receivers the disc at the brick
				startAtBrick()
			end
		end
	elseif phase == "Live" then
		if e.disc == "Ground" then
			pickupCheck(S.disc, e.offense)
		end
		if e.phase == "MatchOver" and not S.pendingMatchOver then
			S.pendingMatchOver = true
		end
	elseif phase == "PointOver" then
		if t >= S.phaseEnd then
			if S.pendingMatchOver or e.phase == "MatchOver" then
				endMatch()
			else
				setupPoint()
			end
		end
	elseif phase == "MatchOver" then
		if t >= S.phaseEnd then
			startIntermission()
		end
	end
	-- time cap reached between points ends the match
	if e.phase == "MatchOver" and (S.phase == "PointSetup" or S.phase == "Pull") then
		endMatch()
	end
end

---------------------------------------------------------------------------
-- roster changes
---------------------------------------------------------------------------

-- Bots arrived, a joiner was benched, a leaver was replaced: put everyone who
-- is not where their team and role belong in place.
local function onLineChanged()
	publishCounts()
	local e = S.engine
	if not e or S.suppressPlacement then
		return
	end
	local phase = S.phase
	if phase ~= "PointSetup" and phase ~= "Pull" and phase ~= "Live" and phase ~= "PointOver" then
		return
	end
	for _, team in { "A", "B" } do
		local ids = services.TeamService.lineFor(team)
		for _, id in services.TeamService.benchFor(team) do
			table.insert(ids, id)
		end
		for _, id in ids do
			local actor = services.PlayerService.get(id)
			if actor and actor.character and S.placed[id] ~= placedKey(actor) then
				placeActor(actor)
			end
		end
	end
	tryGiveStarter()
end

function placeIntoMatch(actor: any)
	if actor.isBot or actor.role == "Training" then
		return
	end
	local phase = S.phase
	if phase == "Starting" then
		if not table.find(S.pendingJoin, actor) then
			table.insert(S.pendingJoin, actor)
		end
		return
	end
	if not S.engine or phase == "Intermission" or phase == "Boot" or phase == "MatchOver" then
		services.PlayerService.setLine(actor, nil, nil)
		services.PlayerService.teleport(actor, services.ArenaService.spawnCFrame(), { face = true })
		if phase == "Intermission" then
			refreshVoteOptions()
		end
		return
	end
	-- joins the team with fewer humans on its bench; placed by onLineChanged
	services.TeamService.placeLateJoiner(actor)
end

-- A ranked roster player abandoned the match (left the game or went to
-- training): they take the loss (once). The result is void for the rest.
local function penalizeLeaver(actor: any)
	local e = S.engine
	local player = actor.player
	if not e or not player or S.penalized[actor.id] or S.pendingMatchOver or e.phase == "MatchOver" then
		return
	end
	local team = services.TeamService.rankedRosterTeam(actor.id)
	if not team then
		return
	end
	S.penalized[actor.id] = true
	local ratings = services.TeamService.rosterRatings()
	local mine = if team == "A" then ratings.A else ratings.B
	local theirs = if team == "A" then ratings.B else ratings.A
	services.ProgressionService.rankedLoss(player, mine, theirs)
	notifyAll("Toast", actor.name .. " left a ranked match — result void", nil)
end

-- The holder vanished (left, or their character respawned).
local function holderGone(actor: any, pos: Vector3)
	local e = S.engine
	if not e or e.holder ~= actor.id then
		return
	end
	if S.phase == "Pull" then
		-- no pull is coming: the receivers start on their brick
		startAtBrick()
	else
		applyOutcomes(RulesEngine.holderLeft(e, pos))
	end
end

-- An actor stops playing this point (left the game or went to training).
local function forgetActor(actor: any)
	local e = S.engine
	if e and e.holder == actor.id then
		local root = services.PlayerService.root(actor)
		holderGone(actor, if root then root.Position else (S.holderPos or field().center))
	end
	if S.starter == actor.id then
		-- the point's disc goes to someone else (tryGiveStarter)
		S.starter = nil
		S.puller = nil
	end
	releaseSlot(actor.id)
	S.lineSides[actor.id] = nil
	S.placed[actor.id] = nil
	S.pickupWanted[actor.id] = nil
end

local function onActorRemoving(actor: any)
	forgetActor(actor)
	S.votes.mode[actor.id] = nil
	S.votes.arena[actor.id] = nil
	local pendingIndex = table.find(S.pendingJoin, actor)
	if pendingIndex then
		table.remove(S.pendingJoin, pendingIndex)
	end
	if actor.isBot then
		return
	end
	penalizeLeaver(actor)
	if services.TeamService.inMatch() then
		services.TeamService.remove(actor)
	elseif S.phase == "Intermission" then
		-- the leaver still counts until this signal returns
		task.defer(function()
			if S.phase == "Intermission" then
				refreshVoteOptions()
			end
		end)
	end
end

---------------------------------------------------------------------------
-- actions
---------------------------------------------------------------------------

local function isHost(actorId: number): boolean
	return S.hostId ~= 0 and actorId == S.hostId
end

function MatchService.action(player: Player, kind: string, payload: any)
	local actor = services.PlayerService.fromPlayer(player)
	if not actor then
		return
	end
	if kind == "Vote" and S.phase == "Intermission" and type(payload) == "table" then
		if payload.mode and table.find(S.voteModes, payload.mode) then
			S.votes.mode[actor.id] = payload.mode
		end
		if payload.arena and table.find(S.voteArenas, payload.arena) then
			S.votes.arena[actor.id] = payload.arena
		end
		publishVotes()
		publishRanked()
	elseif kind == "StartNow" and isHost(actor.id) and S.phase == "Intermission" then
		S.phaseEnd = now()
	elseif kind == "PrivateConfig" and isHost(actor.id) and type(payload) == "table" then
		if type(payload.key) == "string" then
			local v = ModesConfig.sanitize(payload.key, payload.value)
			if v ~= nil then
				S.privateConfig[payload.key] = v
				set("PrivateConfig", HttpService:JSONEncode(S.privateConfig))
				if S.phase == "Intermission" then
					publishRanked()
				end
			end
		end
	elseif kind == "Pickup" then
		MatchService.requestPickup(actor.id)
	elseif kind == "Celebrate" and (S.phase == "PointOver" or S.phase == "MatchOver") then
		if actor.character and actor.player then
			actor.character:SetAttribute("Celebrate", services.ProgressionService.equipped(actor.player, "celebration"))
			actor.character:SetAttribute("CelebrateT", now())
		end
	elseif kind == "JoinMatch" then
		if actor.role == "Training" then
			services.TrainingService.leave(actor)
		end
		if actor.role ~= "Match" and actor.role ~= "Bench" then
			placeIntoMatch(actor)
		end
	end
end

function MatchService.onLeftTraining(actor: any)
	placeIntoMatch(actor)
end

function MatchService.Init(s: any)
	services = s
	stateFolder = Net.state()
end

function MatchService.Start()
	-- host for private servers (or the first player in Studio)
	if game.PrivateServerOwnerId ~= 0 then
		S.hostId = game.PrivateServerOwnerId
	end
	set("HostId", S.hostId)

	services.PlayerService.ActorAdded:Connect(function(actor)
		if actor.isBot then
			return
		end
		if S.hostId == 0 and RunService:IsStudio() then
			S.hostId = actor.id
			set("HostId", S.hostId)
		end
		task.defer(function()
			placeIntoMatch(actor)
		end)
	end)
	services.PlayerService.ActorRemoving:Connect(onActorRemoving)
	services.PlayerService.CharacterSpawned:Connect(function(actor, _model)
		if actor.isBot then
			return
		end
		task.defer(function()
			local e = S.engine
			if e and (actor.team == "A" or actor.team == "B") and (actor.role == "Match" or actor.role == "Bench") then
				holderGone(actor, S.holderPos or field().center)
				S.placed[actor.id] = nil
				placeActor(actor)
				if S.phase == "PointSetup" and S.starter == actor.id then
					-- the point's starter respawned: hand the disc to the new body
					giveStarter(actor.id)
				end
			elseif actor.role == "Training" then
				services.TrainingService.respawned(actor)
			else
				services.PlayerService.teleport(actor, services.ArenaService.spawnCFrame(), { face = true })
			end
		end)
	end)
	services.TeamService.LineChanged:Connect(onLineChanged)
	services.TeamService.TrainingChanged:Connect(function(actor, training)
		if training then
			forgetActor(actor)
			penalizeLeaver(actor)
		end
		if S.phase == "Intermission" then
			refreshVoteOptions()
		end
	end)
	-- a ranked leaver's loss must be written before their profile is released
	services.DataService.Releasing:Connect(function(player)
		local actor = services.PlayerService.fromPlayer(player)
		if actor then
			penalizeLeaver(actor)
		end
	end)
	services.MovementService.Landed:Connect(function(id, pos)
		local e = S.engine
		if e and e.holder == id and e.pending then
			applyOutcomes(RulesEngine.land(e, id, pos))
		end
	end)
	services.MovementService.Travel:Connect(function(id)
		notify(id, "Toast", "Travel — reset to your pivot", nil)
	end)
	services.DefenseService.StallOut:Connect(function(holderId)
		local e = S.engine
		if e and e.holder == holderId and S.phase == "Live" then
			local root = services.Actors.rootOf(holderId)
			notifyAll("Turnover", "STALL", { reason = "Stall" })
			applyOutcomes(RulesEngine.stall(e, if root then root.Position else Vector3.zero))
		end
	end)
	Net.event("Action").OnServerEvent:Connect(function(player, kind, payload)
		if type(kind) ~= "string" then
			return
		end
		MatchService.action(player, kind, payload)
		services.ProgressionService.action(player, kind, payload)
		services.TrainingService.action(player, kind, payload)
	end)
	RunService.Heartbeat:Connect(step)
	startIntermission()
	local _ = Players
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MovementService (server) — authority over how actors are allowed to move.

	Movement is simulated on each client for responsiveness (the client owns
	its character's physics and drives its Humanoid from MovementSim). The
	server stays the referee, but it never punishes legit play on a real
	network and it never moves anyone without telling their client exactly
	what happened (PlayerService.teleport protocol):

	  * Kinematics: every actor's position/velocity is sampled each Heartbeat.
	    A per-character ground probe (stand height = HipHeight + root half
	    height, so tall avatars work) gives an authoritative grounded flag,
	    the last grounded point ("did they jump from in bounds?") and
	    touchdown events. A 1 s, ~60 Hz history of position + flat facing per
	    actor (players and bots) backs positionAt(id, t) for lag-compensated
	    hand blocks.
	  * Techniques: clients report technique events stamped with their own
	    time `t`. Each event is judged on that timestamp (clamped to at most
	    0.35 s old and kept monotonic per player): names, a rate limit,
	    cooldowns (Config TechCooldowns), an exertion mirror (Config costs and
	    regen) and per-technique rules (a PivotSwing only while holding, and
	    "Sold" only after a real fake; a Break only right after a Sold swing).
	    Accepted events are replicated as character attributes so every client
	    can pose that character, and feed the server combo tracker on their
	    timestamps. Rejected events earn nothing and are counted.
	  * Combos: catches/blocks convert the chain at the claim time
	    (convertCombo); chains that can no longer be converted are settled a
	    few times a second and pay 25 % XP through ProgressionService.
	  * Speed budget: a 1 s sliding window of flat displacement, checked once
	    a second. Over HardCap x 1.15 + 8 studs flags that second; only two
	    flagged seconds in a row (a sustained ~50 studs/s, i.e. a speed hack)
	    snap the player back, keeping their rotation. After any teleport the
	    history is cleared and checks wait for a grace period
	    (max(0.8, 2 x ping + 0.3)) and until the server sees the root arrive.
	  * Pivot authority: the holder's pivot foot P is replicated as the
	    character attribute UBPivot. The client proposes P with the Pivot
	    remote; it is accepted when it is within 2 + 26 x min(ping, 0.3)
	    studs of the server's root (and a sane distance from the catch).
	    Without a proposal the server plants P itself. Server relocations and
	    pickups set P directly (setPivot). Travel: the root may stray at most
	    PivotRadius + 1.5 + 10 x min(ping, 0.3) from P; beyond that on samples
	    0.1 s apart the holder is snapped back onto P (at most once per
	    1.5 s). The one hop per possession is allowed; skipTravel() pauses the
	    check (pickup gather glide).
	  * Fake Commit replicates as a generic "Lean" so opponents see a real
	    sell, not a label that says "this is a fake".

	Ping: player:GetNetworkPing() clamped to [0, 0.35]; bots have 0.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MovementConfig = require(Shared.Config.Movement)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)

local MovementService = {}

MovementService.Landed = Signal.new() -- (actorId, position)
MovementService.TechAccepted = Signal.new() -- (actorId, tech, quality, info)
MovementService.Travel = Signal.new() -- (actorId)

local services: any

local HD = MovementConfig.Holding

export type Track = {
	id: number,
	pos: Vector3,
	vel: Vector3,
	grounded: boolean,
	heightAboveGround: number, -- root height above the ground below (math.huge when none in reach)
	stand: number, -- root height above the ground when standing (per character)
	jumpHeight: number, -- how far the root is above its standing height (0 when grounded)
	lastGroundedPos: Vector3, -- ground point under the root when last grounded
	airborneSince: number?, -- os.clock()
	lastAirborneAt: number, -- Net.now() of the last airborne sample
	wasGrounded: boolean,
	pendingLanding: boolean,
	-- history (ring buffer, Net.now() times): positionAt + the speed budget
	histT: { number },
	histPos: { Vector3 },
	histLook: { Vector3 },
	histHead: number,
	histCount: number,
	-- anti-cheat
	graceUntil: number, -- os.clock()
	teleportTarget: Vector3?,
	teleportAt: number, -- os.clock()
	speedCheckAt: number, -- Net.now()
	speedFlags: number,
	lastGoodPos: Vector3,
	-- techniques
	techAt: { [string]: number }, -- timestamp of the last accepted event per technique
	lastTs: number, -- latest accepted event timestamp (kept monotonic)
	exertion: number,
	regenAt: number,
	techTimes: { number }, -- os.clock() arrivals in the last second (rate limit)
	rejected: number,
	combo: ComboEvaluator.Tracker,
	mode: string,
	lastTech: string?,
	lastTechAt: number,
	lastDiveAt: number,
	lastSwingAt: number, -- timestamp of the last accepted PivotSwing
	breakSwingAt: number, -- the PivotSwing a Break was already credited for
	-- holding
	holding: boolean,
	holdStart: number,
	holdEnd: number,
	holdPos: Vector3, -- server root when the possession started
	pivot: Vector3?,
	pivotSource: string, -- "None" | "Auto" | "Client" | "Server"
	pivotAt: number,
	earlyPivot: Vector3?, -- a proposal that arrived just before the possession did
	earlyPivotAt: number,
	hopUsed: boolean,
	hopping: boolean,
	travelSince: number?,
	travelSkipUntil: number,
	lastTravelSnap: number,
}

local tracks: { [number]: Track } = {}

local KNOWN_TECHS = MovementConfig.TechCosts
local VALID_MODES = {
	Ground = true,
	Air = true,
	Slide = true,
	Dive = true,
	DiveSlide = true,
	Recover = true,
	Landing = true,
	Frozen = true,
	Pivot = true, -- holder pivoting (MovementSim.poseMode)
	Mark = true, -- mark shuffle
}
local VALID_QUALITY = { Perfect = true, Clean = true, Sloppy = true, Gassed = true }

local MAX_TECHS_PER_SECOND = 12
local MAX_EVENT_AGE = 0.35 -- event timestamps older than this (at arrival) are clamped
local COOLDOWN_SLACK = 0.05
local EXERTION_FLOOR = -40
local EXERTION_SLACK = 30 -- the mirror may lag the client by this much before claims are refused
local HISTORY = 72 -- samples (~1.2 s at 60 Hz)
local SPEED_WINDOW = 1.0
local SPEED_LIMIT = MovementConfig.HardCap * 1.15 + 8 -- studs per second of window
local SPEED_FLAGS_TO_SNAP = 2
local HOVER_TIME = 6
local TELEPORT_ARRIVE = 4 -- studs: the server has seen the root reach the teleport target
local TELEPORT_WAIT = 1.5 -- ... or this long has passed
local TRAVEL_CONFIRM = 0.1 -- a travel violation must persist this long (two samples)
local TRAVEL_SNAP_EVERY = 1.5
local SETTLE_EVERY = 0.25
local SETTLE_LAG = 0.4 -- settle a little in the past so late events / claims still count

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function now(): number
	return Net.now()
end

local function finite(v: number): boolean
	return v == v and v ~= math.huge and v ~= -math.huge
end

local function finiteVec(v: Vector3): boolean
	return finite(v.X) and finite(v.Y) and finite(v.Z)
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatLook(cf: CFrame): Vector3
	local l = flat(cf.LookVector)
	if l.Magnitude < 1e-3 then
		return Vector3.new(0, 0, -1)
	end
	return l.Unit
end

local function newTrack(id: number, pos: Vector3): Track
	return {
		id = id,
		pos = pos,
		vel = Vector3.zero,
		grounded = true,
		heightAboveGround = 0,
		stand = 3,
		jumpHeight = 0,
		lastGroundedPos = pos,
		airborneSince = nil,
		lastAirborneAt = -math.huge,
		wasGrounded = true,
		pendingLanding = false,
		histT = table.create(HISTORY, 0),
		histPos = table.create(HISTORY, pos),
		histLook = table.create(HISTORY, Vector3.new(0, 0, -1)),
		histHead = 0,
		histCount = 0,
		graceUntil = os.clock() + 1,
		teleportTarget = nil,
		teleportAt = -math.huge,
		speedCheckAt = now() + SPEED_WINDOW,
		speedFlags = 0,
		lastGoodPos = pos,
		techAt = {},
		lastTs = -math.huge,
		exertion = MovementConfig.ExertionMax,
		regenAt = -math.huge,
		techTimes = {},
		rejected = 0,
		combo = ComboEvaluator.newTracker(),
		mode = "Ground",
		lastTech = nil,
		lastTechAt = -math.huge,
		lastDiveAt = -math.huge,
		lastSwingAt = -math.huge,
		breakSwingAt = -math.huge,
		holding = false,
		holdStart = -math.huge,
		holdEnd = -math.huge,
		holdPos = pos,
		pivot = nil,
		pivotSource = "None",
		pivotAt = -math.huge,
		earlyPivot = nil,
		earlyPivotAt = -math.huge,
		hopUsed = false,
		hopping = false,
		travelSince = nil,
		travelSkipUntil = -math.huge,
		lastTravelSnap = -math.huge,
	}
end

function MovementService.track(id: number): Track?
	return tracks[id]
end

-- One-way-ish network delay of an actor in seconds, clamped to [0, 0.35]
-- (bots: 0).
function MovementService.ping(id: number): number
	if Actors.isBotId(id) then
		return 0
	end
	local p = Actors.playerOf(id)
	if not p then
		return 0
	end
	local ok, value = pcall(function()
		return p:GetNetworkPing()
	end)
	if not ok or type(value) ~= "number" or not finite(value) then
		return 0
	end
	return math.clamp(value, 0, 0.35)
end

local function character(id: number): Model?
	local actor = services.PlayerService.get(id)
	return actor and actor.character
end

---------------------------------------------------------------------------
-- history
---------------------------------------------------------------------------

local function clearHistory(t: Track)
	t.histCount = 0
	t.speedFlags = 0
	t.speedCheckAt = now() + SPEED_WINDOW
end

local function pushHistory(t: Track, time: number, pos: Vector3, look: Vector3)
	t.histHead = (t.histHead % HISTORY) + 1
	t.histT[t.histHead] = time
	t.histPos[t.histHead] = pos
	t.histLook[t.histHead] = look
	t.histCount = math.min(t.histCount + 1, HISTORY)
end

-- i-th newest sample (0 = newest).
local function histIndex(t: Track, back: number): number
	return ((t.histHead - 1 - back) % HISTORY) + 1
end

-- Position and flat facing of an actor at server time `t`, interpolated
-- from the last ~1 s of samples (clamped to the oldest / newest sample).
function MovementService.positionAt(id: number, time: number): (Vector3, Vector3)
	local t = tracks[id]
	if not t or t.histCount == 0 then
		local root = Actors.rootOf(id)
		if root then
			return root.Position, flatLook(root.CFrame)
		end
		if t then
			return t.pos, Vector3.new(0, 0, -1)
		end
		return Vector3.zero, Vector3.new(0, 0, -1)
	end
	local newest = histIndex(t, 0)
	if time >= t.histT[newest] then
		return t.histPos[newest], t.histLook[newest]
	end
	for back = 1, t.histCount - 1 do
		local i = histIndex(t, back)
		if t.histT[i] <= time then
			local j = histIndex(t, back - 1)
			local t0, t1 = t.histT[i], t.histT[j]
			local a = if t1 > t0 then (time - t0) / (t1 - t0) else 1
			local look = t.histLook[i]:Lerp(t.histLook[j], a)
			look = if look.Magnitude > 1e-3 then look.Unit else t.histLook[j]
			return t.histPos[i]:Lerp(t.histPos[j], a), look
		end
	end
	local oldest = histIndex(t, t.histCount - 1)
	return t.histPos[oldest], t.histLook[oldest]
end

---------------------------------------------------------------------------
-- teleports and grace
---------------------------------------------------------------------------

-- Called by PlayerService.teleport: history is meaningless across a
-- teleport, and the server's view of a client-owned root takes about a round
-- trip to arrive, so the checks wait for it.
function MovementService.noteTeleport(id: number, target: Vector3?)
	local t = tracks[id]
	if not t then
		return
	end
	local clock = os.clock()
	t.graceUntil = math.max(t.graceUntil, clock + math.max(0.8, 2 * MovementService.ping(id) + 0.3))
	t.teleportTarget = target
	t.teleportAt = clock
	t.airborneSince = nil
	t.travelSince = nil
	if target then
		t.lastGoodPos = target
	end
	clearHistory(t)
end

local function checking(t: Track, clock: number): boolean
	return clock >= t.graceUntil and t.teleportTarget == nil
end

---------------------------------------------------------------------------
-- pivot authority
---------------------------------------------------------------------------

local function writePivot(id: number, pivot: Vector3?)
	local c = character(id)
	if c then
		c:SetAttribute("UBPivot", pivot)
	end
end

local function plant(t: Track, pos: Vector3, source: string)
	t.pivot = pos
	t.pivotSource = source
	t.pivotAt = now()
	t.travelSince = nil
	t.hopUsed = false
	t.hopping = false
	writePivot(t.id, pos)
end

-- Sets the holder's pivot foot P (root height) and replicates it as UBPivot.
-- Used for server relocations and pickups; a client proposal cannot replace it.
function MovementService.setPivot(id: number, pos: Vector3)
	local t = tracks[id]
	if not t or not finiteVec(pos) then
		return
	end
	plant(t, pos, "Server")
end

function MovementService.clearPivot(id: number)
	local t = tracks[id]
	if t then
		t.pivot = nil
		t.pivotSource = "None"
		t.travelSince = nil
	end
	writePivot(id, nil)
end

function MovementService.pivotOf(id: number): Vector3?
	local t = tracks[id]
	return if t then t.pivot else nil
end

-- Pauses travel enforcement (e.g. the pickup gather glide).
function MovementService.skipTravel(id: number, seconds: number)
	local t = tracks[id]
	if t then
		t.travelSkipUntil = math.max(t.travelSkipUntil, now() + seconds)
		t.travelSince = nil
	end
end

-- Root height above the ground when standing (for placing a pivot or a
-- teleport on the ground).
function MovementService.standHeight(id: number): number
	local t = tracks[id]
	return if t then t.stand else 3
end

-- Validates a client-proposed pivot foot and plants it.
local function proposePivot(track: Track, pos: Vector3): boolean
	-- only the first plant of a possession, or a late proposal replacing the
	-- server's own guess
	if track.pivot ~= nil and not (track.pivotSource == "Auto" and now() - track.pivotAt <= 1.5) then
		return false
	end
	local ping = math.min(MovementService.ping(track.id), 0.3)
	local fromRoot = flat(pos - track.pos).Magnitude
	if fromRoot > 2 + 26 * ping or math.abs(pos.Y - track.pos.Y) > 4 + 20 * ping then
		return false
	end
	-- the slow-down after a catch (including an airborne catch) can't carry
	-- the holder further than this from where the server saw the catch
	if flat(pos - track.holdPos).Magnitude > 20 + 40 * ping then
		return false
	end
	plant(track, pos, "Client")
	return true
end

-- The client's proposed pivot foot. One that arrives a moment before the
-- server has handed over the disc (predicted catch) is kept briefly.
local function onPivot(player: Player, pos: any)
	local actor = services.PlayerService.fromPlayer(player)
	local t = actor and tracks[actor.id]
	if not t or typeof(pos) ~= "Vector3" or not finiteVec(pos) then
		return
	end
	local track = t :: Track
	if not track.holding then
		track.earlyPivot = pos
		track.earlyPivotAt = now()
		return
	end
	proposePivot(track, pos)
end

local function updateHolding(actor: any, t: Track, root: BasePart, grounded: boolean, clock: number)
	local tNow = now()
	if t.pivot == nil then
		-- server fallback plant (humans normally propose theirs first)
		if grounded then
			local held = tNow - t.holdStart
			local speed = flat(t.vel).Magnitude
			if actor.isBot then
				if held >= HD.DecelMaxTime + 0.15 or (held >= 0.1 and speed < HD.PlantSpeed + 2) then
					plant(t, t.pos, "Auto")
				end
			elseif held >= HD.DecelMaxTime + 0.3 + 2 * MovementService.ping(t.id) then
				plant(t, t.pos, "Auto")
			end
		end
		return
	end
	if actor.isBot then
		return
	end
	local pivot = t.pivot :: Vector3
	-- the one hop per possession
	if not grounded then
		if not t.hopUsed then
			t.hopping = true
		end
	elseif t.hopping then
		t.hopping = false
		t.hopUsed = true
	end
	if t.hopping or tNow < t.travelSkipUntil or not checking(t, clock) then
		t.travelSince = nil
		return
	end
	local tolerance = HD.PivotRadius + 1.5 + 10 * math.min(MovementService.ping(t.id), 0.3)
	local d = flat(t.pos - pivot).Magnitude
	if d <= tolerance then
		t.travelSince = nil
		return
	end
	if t.travelSince == nil then
		t.travelSince = tNow
		return
	end
	if tNow - (t.travelSince :: number) < TRAVEL_CONFIRM or tNow - t.lastTravelSnap < TRAVEL_SNAP_EVERY then
		return
	end
	t.lastTravelSnap = tNow
	t.travelSince = nil
	services.PlayerService.teleport(actor, CFrame.new(pivot) * root.CFrame.Rotation)
	writePivot(t.id, pivot)
	MovementService.Travel:Fire(t.id)
end

---------------------------------------------------------------------------
-- kinematics
---------------------------------------------------------------------------

local function standFor(model: Model, root: BasePart): number
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	-- R6: legs are 2 studs, the root sits at torso centre
	return root.Size.Y / 2 + 2
end

local function speedBudget(actor: any, t: Track, root: BasePart, tNow: number)
	if tNow < t.speedCheckAt then
		return
	end
	t.speedCheckAt = tNow + SPEED_WINDOW
	if t.histCount < 2 then
		return
	end
	-- the sample closest to one window ago
	local newest = histIndex(t, 0)
	local oldIndex = histIndex(t, t.histCount - 1)
	for back = 1, t.histCount - 1 do
		local i = histIndex(t, back)
		oldIndex = i
		if tNow - t.histT[i] >= SPEED_WINDOW then
			break
		end
	end
	local span = t.histT[newest] - t.histT[oldIndex]
	if span < SPEED_WINDOW * 0.9 then
		return
	end
	local disp = flat(t.histPos[newest] - t.histPos[oldIndex]).Magnitude
	if disp <= SPEED_LIMIT * span then
		t.speedFlags = 0
		t.lastGoodPos = t.histPos[newest]
		return
	end
	t.speedFlags += 1
	warn(
		string.format(
			"[MovementService] %s covered %.1f studs in %.2f s (%d/%d)",
			actor.name,
			disp,
			span,
			t.speedFlags,
			SPEED_FLAGS_TO_SNAP
		)
	)
	if t.speedFlags >= SPEED_FLAGS_TO_SNAP then
		t.speedFlags = 0
		services.PlayerService.teleport(actor, CFrame.new(t.lastGoodPos) * root.CFrame.Rotation)
	end
end

-- Updates kinematics for every actor (runs every Heartbeat; cheap).
local function updateKinematics()
	local exclude: { Instance } = {}
	for _, c in Actors.characters() do
		table.insert(exclude, c)
	end
	rayParams.FilterDescendantsInstances = exclude
	local clock = os.clock()
	local tNow = now()
	for _, actor in services.PlayerService.all() do
		local root = services.PlayerService.root(actor)
		local model = actor.character
		if root and model then
			local track = tracks[actor.id]
			local pos = root.Position
			if not track then
				track = newTrack(actor.id, pos)
				tracks[actor.id] = track
			end
			local t = track :: Track
			t.pos = pos
			t.vel = root.AssemblyLinearVelocity
			t.stand = standFor(model, root)

			-- ground probe sized to this character
			local hit = workspace:Raycast(pos, Vector3.new(0, -(t.stand + 4), 0), rayParams)
			local h = if hit then pos.Y - hit.Position.Y else math.huge
			t.heightAboveGround = h
			t.jumpHeight = if hit then math.max(0, h - t.stand) else t.stand + 4
			local grounded = h <= t.stand + 1.2 and t.vel.Y < 8
			t.grounded = grounded
			if grounded then
				t.lastGroundedPos = Vector3.new(pos.X, if hit then hit.Position.Y else pos.Y - t.stand, pos.Z)
				t.airborneSince = nil
			else
				t.lastAirborneAt = tNow
				if t.airborneSince == nil then
					t.airborneSince = clock
				end
			end
			if grounded and not t.wasGrounded and t.pendingLanding then
				t.pendingLanding = false
				MovementService.Landed:Fire(actor.id, t.lastGroundedPos)
			end
			t.wasGrounded = grounded

			-- arrival after a teleport
			local target = t.teleportTarget
			if target then
				if (pos - target).Magnitude <= TELEPORT_ARRIVE or clock - t.teleportAt > TELEPORT_WAIT then
					t.teleportTarget = nil
					clearHistory(t)
				end
			end
			if not checking(t, clock) then
				clearHistory(t)
			end
			pushHistory(t, tNow, pos, flatLook(root.CFrame))

			if not actor.isBot and checking(t, clock) then
				speedBudget(actor, t, root, tNow)
				-- a long hover with no ground in reach and no vertical motion
				-- (gravity 160 makes a legit one impossible)
				local since = t.airborneSince
				if
					since
					and clock - since > HOVER_TIME
					and h > t.stand + 3
					and math.abs(t.vel.Y) < 1
					and checking(t, clock)
				then
					t.airborneSince = clock
					services.PlayerService.teleport(
						actor,
						CFrame.new(t.lastGroundedPos + Vector3.new(0, t.stand, 0)) * root.CFrame.Rotation
					)
				end
			end

			if t.holding then
				updateHolding(actor, t, root, grounded, clock)
			end
		end
	end
end

---------------------------------------------------------------------------
-- exertion mirror
---------------------------------------------------------------------------

-- Mirrors the client sim: sprinting drains a little and regenerates a little
-- more (sprint is effectively free), anything else regenerates fast; regen
-- pauses briefly only after a technique spend.
local function regen(dt: number)
	local tNow = now()
	for _, t in tracks do
		local regenOk = tNow >= t.regenAt
		local sprinting = t.grounded
			and not t.holding
			and t.mode ~= "Mark"
			and flat(t.vel).Magnitude > MovementConfig.JogSpeed + 0.5
		if sprinting then
			t.exertion -= MovementConfig.SprintDrain * dt
			if regenOk then
				t.exertion += MovementConfig.SprintRegen * dt
			end
		elseif regenOk then
			t.exertion += MovementConfig.ExertionRegen * dt
		end
		t.exertion = math.clamp(t.exertion, EXERTION_FLOOR, MovementConfig.ExertionMax)
	end
end

---------------------------------------------------------------------------
-- techniques
---------------------------------------------------------------------------

local function replicate(actorId: number, tech: string, quality: string, dir: Vector3, info: string?)
	local c = character(actorId)
	if not c then
		return
	end
	local public = tech
	if tech == "FakeCommit" then
		public = "Lean"
	end
	c:SetAttribute("TechDir", dir)
	c:SetAttribute("TechQ", quality)
	c:SetAttribute("TechInfo", info or "")
	c:SetAttribute("Tech", public)
	c:SetAttribute("TechT", now())
end

local function costOf(tech: string, info: string?): number
	if tech == "BurstStep" and info == "Explosive" then
		return 0 -- the explosive plant restart is free in the sim
	end
	return (MovementConfig.TechCosts :: any)[tech] or 0
end

-- The PivotSwing a Break would link to (the chain's last entry), or nil.
local function breakSwing(t: Track, ts: number): number?
	local chain = ComboEvaluator.active(t.combo, ts)
	if not chain then
		return nil
	end
	local last = chain.entries[#chain.entries]
	if last and last.tech == "PivotSwing" then
		return last.t
	end
	return nil
end

-- Per-technique rules beyond cooldown and cost. Returns the quality to
-- record, or nil to refuse.
local function judge(t: Track, tech: string, quality: string, ts: number): string?
	if tech == "PivotSwing" then
		-- only while holding (or just before the release reached us)
		if not (t.holding or ts <= t.holdEnd + 0.1) or ts < t.holdStart - 0.5 then
			return nil
		end
		if quality == "Perfect" then
			-- "Sold" needs a real fake shortly before the swing
			local c = character(t.id)
			local fakeT = c and c:GetAttribute("FakeT")
			if type(fakeT) ~= "number" or ts - fakeT > HD.SwingSoldWindow + 0.15 or fakeT - ts > 0.4 then
				return "Clean"
			end
		end
		return quality
	elseif tech == "Break" then
		-- scored only right after a Sold swing, once per swing
		local q = ComboEvaluator.breakQuality(t.combo, ts)
		local swingAt = breakSwing(t, ts)
		if q == nil or swingAt == nil or swingAt == t.breakSwingAt then
			return nil
		end
		return q
	end
	return quality
end

-- Validates one reported technique at timestamp ts. Returns the accepted
-- quality, or nil.
local function accept(t: Track, tech: string, quality: string, info: string?, ts: number): string?
	local clock = os.clock()
	if KNOWN_TECHS[tech] == nil then
		return nil
	end
	-- rate limit (arrival time)
	while #t.techTimes > 0 and clock - t.techTimes[1] > 1 do
		table.remove(t.techTimes, 1)
	end
	if #t.techTimes >= MAX_TECHS_PER_SECOND then
		return nil
	end
	-- cooldown mirror, on the events' own timestamps
	local cd = (MovementConfig.TechCooldowns :: any)[tech] or 0
	if cd > 0 and ts - (t.techAt[tech] or -math.huge) < cd - COOLDOWN_SLACK then
		return nil
	end
	local q = judge(t, tech, quality, ts)
	if q == nil then
		return nil
	end
	local cost = costOf(tech, info)
	if cost > 0 and q ~= "Gassed" and t.exertion < cost * MovementConfig.GassedFraction - EXERTION_SLACK then
		-- a full-strength technique the player cannot have afforded
		return nil
	end
	table.insert(t.techTimes, clock)
	t.techAt[tech] = ts
	if cost > 0 then
		t.exertion = math.max(EXERTION_FLOOR, t.exertion - cost)
		t.regenAt = ts + MovementConfig.ExertionRegenDelay
	end
	return q
end

-- Records an accepted technique: pose attributes, combo chain, listeners.
local function record(id: number, t: Track, tech: string, quality: string, dir: Vector3, info: string?, ts: number)
	t.lastTech = tech
	t.lastTechAt = ts
	if tech == "Dive" then
		t.lastDiveAt = ts
	elseif tech == "PivotSwing" then
		t.lastSwingAt = ts
	elseif tech == "Break" then
		t.breakSwingAt = breakSwing(t, ts) or ts
	end
	replicate(id, tech, quality, dir, info)
	ComboEvaluator.add(t.combo, tech, quality, ts)
	MovementService.TechAccepted:Fire(id, tech, quality, info)
end

local function cleanDir(v: any): Vector3
	if typeof(v) ~= "Vector3" or not finiteVec(v) or v.Magnitude > 1.01 then
		return Vector3.zero
	end
	return v
end

local function onTech(player: Player, events: any, mode: any)
	local actor = services.PlayerService.fromPlayer(player)
	if not actor then
		return
	end
	local t = tracks[actor.id]
	if not t then
		return
	end
	if type(mode) == "string" and VALID_MODES[mode] and mode ~= t.mode then
		t.mode = mode
		if actor.character then
			actor.character:SetAttribute("MS", mode)
		end
	end
	if type(events) ~= "table" then
		return
	end
	local arrival = now()
	local n = 0
	for _, e in events do
		n += 1
		if n > 6 then
			break
		end
		if type(e) == "table" and type(e.tech) == "string" then
			local quality = if type(e.quality) == "string" and VALID_QUALITY[e.quality] then e.quality else "Clean"
			local dir = cleanDir(e.dir)
			local info = if type(e.info) == "string" and #e.info <= 24 then e.info else nil
			-- judged on when it happened: at most MAX_EVENT_AGE old, never in
			-- the future, never before an earlier event
			local raw = if type(e.t) == "number" and finite(e.t) then e.t else arrival
			local ts = math.max(math.clamp(raw, arrival - MAX_EVENT_AGE, arrival), t.lastTs)
			local q = accept(t, e.tech, quality, info, ts)
			if q then
				t.lastTs = ts
				record(actor.id, t, e.tech, q, dir, info, ts)
			else
				t.rejected += 1
			end
		end
	end
end

-- Server-driven technique for bots (no validation needed). `t` is the
-- event time (defaults to now).
function MovementService.botTech(
	id: number,
	tech: string,
	dir: Vector3,
	mode: string?,
	quality: string?,
	info: string?,
	at: number?
)
	local t = tracks[id]
	local ts = if at and finite(at) then math.min(at, now()) else now()
	local q = if quality and VALID_QUALITY[quality] then quality else "Clean"
	if t then
		ts = math.max(ts, t.lastTs)
		t.lastTs = ts
		if mode then
			t.mode = mode
		end
		if KNOWN_TECHS[tech] ~= nil then
			t.techAt[tech] = ts
			record(id, t, tech, q, dir, info, ts)
		else
			replicate(id, tech, q, dir, info)
		end
	else
		replicate(id, tech, q, dir, info)
	end
	local c = character(id)
	if c and mode then
		c:SetAttribute("MS", mode)
	end
end

function MovementService.setBotMode(id: number, mode: string)
	local t = tracks[id]
	if t then
		t.mode = mode
	end
	local c = character(id)
	if c then
		c:SetAttribute("MS", mode)
	end
end

-- Is the actor currently in a layout (dive) or its ground slide?
function MovementService.isDiving(id: number): boolean
	local t = tracks[id]
	if not t then
		return false
	end
	return t.mode == "Dive" or t.mode == "DiveSlide" or now() - t.lastDiveAt < 0.9
end

function MovementService.isSliding(id: number): boolean
	local t = tracks[id]
	return t ~= nil and t.mode == "Slide"
end

function MovementService.isOnGroundAfterLayout(id: number): boolean
	local t = tracks[id]
	return t ~= nil and (t.mode == "DiveSlide" or t.mode == "Recover") and now() - t.lastDiveAt < 2
end

-- Was the holder mid Quick Swing at server time `at`?
function MovementService.isSwinging(id: number, at: number): boolean
	local t = tracks[id]
	return t ~= nil and at >= t.lastSwingAt and at <= t.lastSwingAt + HD.SwingTime
end

-- Possession bookkeeping (DiscService.giveTo / release). Repeating the
-- current value changes nothing.
function MovementService.setHolding(id: number, holding: boolean)
	local t = tracks[id]
	if not t then
		if not holding then
			writePivot(id, nil)
		end
		return
	end
	if t.holding == holding then
		return
	end
	t.holding = holding
	if holding then
		t.holdStart = now()
		t.holdPos = t.pos
		t.pendingLanding = not t.grounded
		t.pivot = nil
		t.pivotSource = "None"
		t.hopUsed = false
		t.hopping = false
		t.travelSince = nil
		writePivot(id, nil)
		local early = t.earlyPivot
		t.earlyPivot = nil
		if early and now() - t.earlyPivotAt <= 0.5 then
			proposePivot(t, early)
		end
	else
		t.holdEnd = now()
		t.pendingLanding = false
		MovementService.clearPivot(id)
	end
end

function MovementService.expectLanding(id: number)
	local t = tracks[id]
	if t then
		t.pendingLanding = true
	end
end

-- A play (catch, interception, block) converts the actor's chain. `at` is
-- when it happened (the claim time); defaults to now.
function MovementService.convertCombo(id: number, payoff: string, at: number?): ComboEvaluator.Summary?
	local t = tracks[id]
	if not t then
		return nil
	end
	local tNow = now()
	local when = if at and finite(at) then math.clamp(at, tNow - 0.5, tNow) else tNow
	return ComboEvaluator.convert(t.combo, when, payoff)
end

-- The throw path's hook at release: adds the "Break" link when the release
-- follows a Sold swing (once per swing; a client "Break" Tech event for the
-- same swing counts as the same link). Returns the Break quality, or nil.
function MovementService.noteRelease(id: number, at: number?): string?
	local t = tracks[id]
	if not t then
		return nil
	end
	local tNow = now()
	local when = if at and finite(at) then math.clamp(at, tNow - 0.5, tNow) else tNow
	local ts = math.max(when, t.lastTs)
	local q = judge(t, "Break", "Clean", ts)
	if q == nil then
		return nil
	end
	t.lastTs = ts
	t.techAt.Break = ts
	record(id, t, "Break", q, Vector3.zero, nil, ts)
	return q
end

-- Pays the 25 % share of chains that can no longer be converted.
local function settleCombos()
	local tNow = now() - SETTLE_LAG
	for id, t in tracks do
		local done = ComboEvaluator.settle(t.combo, tNow)
		if #done > 0 then
			local player = Actors.playerOf(id)
			if player then
				for _, summary in done do
					services.ProgressionService.comboUnconverted(player, summary)
				end
			end
		end
	end
end

function MovementService.Init(s: any)
	services = s
end

function MovementService.Start()
	Net.event("Tech").OnServerEvent:Connect(onTech)
	Net.event("Pivot").OnServerEvent:Connect(onPivot)
	local settleAt = 0
	RunService.Heartbeat:Connect(function(dt)
		updateKinematics()
		regen(dt)
		local clock = os.clock()
		if clock >= settleAt then
			settleAt = clock + SETTLE_EVERY
			settleCombos()
		end
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		tracks[actor.id] = nil
	end)
	services.PlayerService.CharacterSpawned:Connect(function(actor, model)
		local root = model:WaitForChild("HumanoidRootPart", 5) :: BasePart?
		if root then
			local t = newTrack(actor.id, root.Position)
			t.stand = standFor(model, root)
			tracks[actor.id] = t
		end
	end)
	local _ = Players
end

return MovementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	PlayerService — the roster of actors (human players and bots).

	Owns team objects, character setup (collision group, attributes the rest
	of the game keys on), teleports, the per-actor "frozen" flag and the
	pre-pull line restriction. Players never collide with each other (ultimate
	is a non-contact sport; body positioning is resolved by catch geometry).

	Roles: "Match" (on the field this point), "Bench" (on the team, waiting
	for the next point on the sideline bench), "Training", "Spectate".
	onTeam() lists the field players; roster() includes the bench.

	Movement is client-driven: each client sets its own Humanoid WalkSpeed /
	Move every frame from its MovementSim. The server only sets the spawn
	defaults (AutoRotate off, jump power 0) once and never writes WalkSpeed on
	a player's Humanoid afterwards, so it never fights the client.

	Teleports are an explicit protocol (character attributes, written in this
	order):
	  UBTeleportPos  Vector3   where the root goes
	  UBTeleportYaw  number    facing (CameraController.getYaw convention)
	  UBTeleportFace boolean   the client also turns its camera (line-ups,
	                           drills, spawns); false keeps the camera
	  UBTeleport     number    counter, bumped last
	The client puts its root there if it is more than a stud away, zeroes its
	velocity and resets its sim (keeping frozen, holding, exertion, pivot).

	Line restriction (before the pull): UBLineX / UBLineSide; the character
	must keep (pos.X - UBLineX) * UBLineSide >= 0. nil = free.
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeamsService = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local TeamsConfig = require(Shared.Config.Teams)

local PlayerService = {}

export type Actor = {
	id: number,
	name: string,
	player: Player?,
	isBot: boolean,
	team: string, -- "A" | "B" | "N"
	role: string, -- "Match" | "Bench" | "Training" | "Spectate"
	character: Model?,
	teleportCount: number,
	joinedAt: number,
	lineX: number?, -- pre-pull restriction (UBLineX / UBLineSide), re-stamped on respawn
	lineSide: number?,
}

export type TeleportOptions = {
	face: boolean?, -- the client also turns its camera to the new facing
}

local actors: { [number]: Actor } = {}
local teamObjects: { [string]: Team } = {}
local services: any

PlayerService.ActorAdded = Signal.new()
PlayerService.ActorRemoving = Signal.new()
PlayerService.CharacterSpawned = Signal.new()
PlayerService.TeamChanged = Signal.new()

PlayerService.CollisionGroup = "UBPlayers"

-- Root parts collide with the world but not with each other. Limbs collide
-- with nothing: the procedural layout/slide poses must never snag the ground
-- (the Humanoid floats on its root part, so limbs need no collision).
PlayerService.LimbGroup = "UBLimbs"

local function setupCollisionGroups()
	for _, g in { PlayerService.CollisionGroup, PlayerService.LimbGroup } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(g)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable(PlayerService.CollisionGroup, PlayerService.CollisionGroup, false)
	PhysicsService:CollisionGroupSetCollidable(PlayerService.LimbGroup, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(PlayerService.LimbGroup, PlayerService.CollisionGroup, false)
	PhysicsService:CollisionGroupSetCollidable(PlayerService.LimbGroup, PlayerService.LimbGroup, false)
end

local function setupTeams()
	local list: { [string]: any } = { A = TeamsConfig.A, B = TeamsConfig.B, N = TeamsConfig.Neutral }
	for key, cfg in list do
		local t = TeamsService:FindFirstChild(cfg.Name) :: Team?
		if not t then
			local nt = Instance.new("Team")
			nt.Name = cfg.Name
			nt.TeamColor = cfg.BrickColor
			nt.AutoAssignable = false
			nt.Parent = TeamsService
			t = nt
		end
		teamObjects[key] = t :: Team
	end
end

local function groupFor(part: BasePart): string
	return if part.Name == "HumanoidRootPart" then PlayerService.CollisionGroup else PlayerService.LimbGroup
end

local function applyCollision(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = groupFor(d)
		end
	end
	model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = groupFor(d)
		end
	end)
end

local function stampCharacter(actor: Actor, model: Model)
	model:SetAttribute("UBId", actor.id)
	model:SetAttribute("UBTeam", actor.team)
	model:SetAttribute("UBName", actor.name)
	model:SetAttribute("UBRole", actor.role)
	model:SetAttribute("UBTeleport", actor.teleportCount)
	model:SetAttribute("UBLineX", actor.lineX)
	model:SetAttribute("UBLineSide", actor.lineSide)
end

function PlayerService.setupCharacter(actor: Actor, model: Model)
	actor.character = model
	applyCollision(model)
	stampCharacter(actor, model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- one-time spawn defaults; the owner (client MovementController for
		-- players, BotService for bots) drives WalkSpeed / Move / JumpPower
		humanoid.BreakJointsOnDeath = false
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 0
		humanoid.AutoRotate = false
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	PlayerService.CharacterSpawned:Fire(actor, model)
end

local function onPlayerAdded(player: Player)
	local actor: Actor = {
		id = player.UserId,
		name = player.DisplayName,
		player = player,
		isBot = false,
		team = "N",
		role = "Spectate",
		character = nil,
		teleportCount = 0,
		joinedAt = os.clock(),
		lineX = nil,
		lineSide = nil,
	}
	actors[actor.id] = actor
	player.Team = teamObjects.N
	player.CharacterAdded:Connect(function(model)
		PlayerService.setupCharacter(actor, model)
	end)
	PlayerService.ActorAdded:Fire(actor)
	if player.Character then
		PlayerService.setupCharacter(actor, player.Character)
	end
end

local function onPlayerRemoving(player: Player)
	local actor = actors[player.UserId]
	if actor then
		PlayerService.ActorRemoving:Fire(actor)
		actors[player.UserId] = nil
	end
end

function PlayerService.registerBot(id: number, name: string, team: string, model: Model): Actor
	local actor: Actor = {
		id = id,
		name = name,
		player = nil,
		isBot = true,
		team = team,
		role = "Match",
		character = model,
		teleportCount = 0,
		joinedAt = os.clock(),
		lineX = nil,
		lineSide = nil,
	}
	actors[id] = actor
	PlayerService.setupCharacter(actor, model)
	PlayerService.ActorAdded:Fire(actor)
	return actor
end

function PlayerService.unregisterBot(id: number)
	local actor = actors[id]
	if actor and actor.isBot then
		PlayerService.ActorRemoving:Fire(actor)
		actors[id] = nil
		if actor.character then
			actor.character:Destroy()
		end
	end
end

function PlayerService.get(id: number): Actor?
	return actors[id]
end

function PlayerService.fromPlayer(player: Player): Actor?
	return actors[player.UserId]
end

function PlayerService.all(): { Actor }
	local list = {}
	for _, a in actors do
		table.insert(list, a)
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

function PlayerService.humans(): { Actor }
	local list = {}
	for _, a in PlayerService.all() do
		if not a.isBot then
			table.insert(list, a)
		end
	end
	return list
end

-- Field players of a team (role "Match").
function PlayerService.onTeam(team: string, includeBots: boolean?): { Actor }
	local list = {}
	for _, a in PlayerService.all() do
		if a.team == team and a.role == "Match" and (includeBots ~= false or not a.isBot) then
			table.insert(list, a)
		end
	end
	return list
end

-- Everyone on a team: field players and the bench.
function PlayerService.roster(team: string, includeBots: boolean?): { Actor }
	local list = {}
	for _, a in PlayerService.all() do
		if a.team == team and (a.role == "Match" or a.role == "Bench") and (includeBots ~= false or not a.isBot) then
			table.insert(list, a)
		end
	end
	return list
end

-- The bench of a team (humans waiting for the next point).
function PlayerService.bench(team: string): { Actor }
	local list = {}
	for _, a in PlayerService.all() do
		if a.team == team and a.role == "Bench" then
			table.insert(list, a)
		end
	end
	return list
end

function PlayerService.setTeam(actor: Actor, team: string, role: string?)
	actor.team = team
	if role then
		actor.role = role
	end
	if actor.player then
		actor.player.Team = teamObjects[team] or teamObjects.N
	end
	if actor.character then
		stampCharacter(actor, actor.character)
	end
	PlayerService.TeamChanged:Fire(actor)
end

function PlayerService.root(actor: Actor): BasePart?
	local c = actor.character
	if c and c.Parent then
		return c:FindFirstChild("HumanoidRootPart") :: BasePart?
	end
	return nil
end

function PlayerService.humanoid(actor: Actor): Humanoid?
	local c = actor.character
	if c then
		return c:FindFirstChildOfClass("Humanoid")
	end
	return nil
end

-- Facing yaw of a CFrame in the CameraController.getYaw convention
-- (CFrame.Angles(0, yaw, 0) looks along the flat LookVector).
local function yawOf(cf: CFrame): number?
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		return nil
	end
	return math.atan2(-flat.X, -flat.Z)
end

-- Moves an actor's root to cf (kept upright) and tells their client exactly
-- where it went (see the protocol in the header). opts.face also turns the
-- camera; without it the client keeps its camera.
function PlayerService.teleport(actor: Actor, cf: CFrame, opts: TeleportOptions?)
	local c = actor.character
	if not c or not c.Parent then
		return
	end
	local root = PlayerService.root(actor)
	local yaw = yawOf(cf) or (if root then yawOf(root.CFrame) else nil) or 0
	local target = CFrame.new(cf.Position) * CFrame.Angles(0, yaw, 0)
	c:SetAttribute("UBTeleportPos", target.Position)
	c:SetAttribute("UBTeleportYaw", yaw)
	c:SetAttribute("UBTeleportFace", opts ~= nil and opts.face == true)
	if root then
		-- sticks for server-owned bots; the owning client zeroes its own
		root.AssemblyLinearVelocity = Vector3.zero
	end
	c:PivotTo(target)
	actor.teleportCount += 1
	c:SetAttribute("UBTeleport", actor.teleportCount)
	if services and services.MovementService then
		services.MovementService.noteTeleport(actor.id, target.Position)
	end
end

-- Pre-pull line restriction: keep (pos.X - x) * side >= 0. nil clears it.
function PlayerService.setLine(actor: Actor, x: number?, side: number?)
	if x == nil or side == nil then
		actor.lineX = nil
		actor.lineSide = nil
	else
		actor.lineX = x
		actor.lineSide = if side < 0 then -1 else 1
	end
	local c = actor.character
	if c then
		c:SetAttribute("UBLineX", actor.lineX)
		c:SetAttribute("UBLineSide", actor.lineSide)
	end
end

-- Clears every actor's line restriction.
function PlayerService.clearLines()
	for _, a in PlayerService.all() do
		if a.lineX ~= nil then
			PlayerService.setLine(a, nil, nil)
		end
	end
end

function PlayerService.setFrozen(actor: Actor, frozen: boolean)
	local c = actor.character
	if c then
		c:SetAttribute("UBFrozen", frozen)
	end
end

function PlayerService.setAllFrozen(frozen: boolean, filter: ((Actor) -> boolean)?)
	for _, a in PlayerService.all() do
		if filter == nil or filter(a) then
			PlayerService.setFrozen(a, frozen)
		end
	end
end

function PlayerService.Init(s: any)
	services = s
	setupCollisionGroups()
	setupTeams()
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ProgressionService — XP, levels, stats, technique mastery, achievements,
	cosmetics and ranked rating. Everything it grants is cosmetic or a record;
	nothing affects movement, throwing or catching.

	  * Match XP is x XP.PvPMultiplier when both teams had human players.
	  * Combos pay from Summary.xpScore: a chain converted into a play pays its
	    doubled score (capped at ComboCap) and counts as converted; a chain
	    that was not converted pays its 25 % share (capped per chain and per
	    match, match play only) once MovementService settles it.
	  * Ranked: rated against the roster's average ratings at the start. A
	    roster player who abandons the match is rated as a loss right away
	    (rankedLoss); the result is then void for everyone else.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ProgressionConfig = require(Shared.Config.Progression)
local InputConfig = require(Shared.Config.Input)
local MovementConfig = require(Shared.Config.Movement)
local Rating = require(Shared.Rules.Rating)

local ProgressionService = {}

local services: any
local pushQueued: { [Player]: boolean } = {}
local unconvertedPaid: { [number]: number } = {} -- UserId -> unconverted combo XP this match

local XP = ProgressionConfig.XP

local function data(player: Player): { [string]: any }?
	return services.DataService.get(player)
end

local function levelOf(d: { [string]: any }): number
	local level = Rating.levelFromXp(d.xp)
	return level
end

local function unlockedList(d: { [string]: any }, list: { any }): { string }
	local level = levelOf(d)
	local out = {}
	for _, item in list do
		if (item.level and level >= item.level) or (item.achievement and d.achievements[item.achievement]) then
			table.insert(out, item.id)
		end
	end
	return out
end

local SLOTS: { [string]: { any } } = {
	disc = ProgressionConfig.DiscSkins,
	trail = ProgressionConfig.Trails,
	celebration = ProgressionConfig.Celebrations,
	banner = ProgressionConfig.Banners,
	title = ProgressionConfig.Titles,
}

local function isUnlocked(d: { [string]: any }, slot: string, id: string): boolean
	local list = (SLOTS :: any)[slot]
	if not list then
		return false
	end
	return table.find(unlockedList(d, list), id) ~= nil
end

function ProgressionService.equipped(player: Player, slot: string): string
	local d = data(player)
	local fallback = (
		{ disc = "Classic", trail = "None", celebration = "Point", banner = "Slate", title = "Rookie" } :: any
	)[slot] or ""
	if not d then
		return fallback
	end
	local id = d.cosmetics[slot]
	if type(id) == "string" and isUnlocked(d, slot, id) then
		return id
	end
	return fallback
end

local function stampCharacter(player: Player)
	local c = player.Character
	local d = data(player)
	if not c or not d then
		return
	end
	local titleId = ProgressionService.equipped(player, "title")
	local title = titleId
	for _, t in ProgressionConfig.Titles do
		if t.id == titleId then
			title = t.name
		end
	end
	c:SetAttribute("UBTitle", title)
	c:SetAttribute("UBBanner", ProgressionService.equipped(player, "banner"))
	c:SetAttribute("UBTrail", ProgressionService.equipped(player, "trail"))
	c:SetAttribute("UBLevel", levelOf(d))
	c:SetAttribute("LeftHanded", d.settings.values.LeftHanded == true)
	c:SetAttribute("UBDivision", ProgressionConfig.division(d.rating).name)
end

local function snapshot(player: Player): { [string]: any }?
	local d = data(player)
	if not d then
		return nil
	end
	local level, into, need = Rating.levelFromXp(d.xp)
	local achievements = {}
	for _, a in ProgressionConfig.Achievements do
		table.insert(achievements, {
			id = a.id,
			name = a.name,
			description = a.description,
			progress = math.min(d.stats[a.stat] or 0, a.goal),
			goal = a.goal,
			done = d.achievements[a.id] == true,
		})
	end
	local unlocked = {}
	for slot, list in SLOTS do
		unlocked[slot] = unlockedList(d, list)
	end
	local division = ProgressionConfig.division(d.rating)
	return {
		level = level,
		xpInto = into,
		xpNeed = need,
		xp = d.xp,
		rating = d.rating,
		peakRating = d.peakRating,
		division = division.name,
		ratedGames = d.ratedGames,
		stats = d.stats,
		techMastery = d.techMastery,
		achievements = achievements,
		unlocked = unlocked,
		equipped = d.cosmetics,
		personalBests = d.personalBests,
		drillsDone = d.drillsDone,
		settings = d.settings,
		persistent = services.DataService.isPersistent(player),
	}
end

ProgressionService.snapshot = snapshot

local function push(player: Player)
	if pushQueued[player] then
		return
	end
	pushQueued[player] = true
	task.delay(0.5, function()
		pushQueued[player] = nil
		if player.Parent then
			local snap = snapshot(player)
			if snap then
				Net.event("Profile"):FireClient(player, snap)
			end
		end
	end)
end

ProgressionService.push = push

local function checkAchievements(player: Player)
	local d = data(player)
	if not d then
		return
	end
	for _, a in ProgressionConfig.Achievements do
		if not d.achievements[a.id] and (d.stats[a.stat] or 0) >= a.goal then
			d.achievements[a.id] = true
			Net.event("Notify"):FireClient(player, "Achievement", a.name, { description = a.description })
			stampCharacter(player)
		end
	end
end

function ProgressionService.xp(player: Player, amount: number, reason: string?)
	local d = data(player)
	if not d or amount <= 0 then
		return
	end
	local before = levelOf(d)
	services.DataService.update(player, function(dd: { [string]: any })
		dd.xp += math.floor(amount)
	end)
	local after = levelOf(d)
	if after > before then
		local unlocks = {}
		for slot, list in SLOTS do
			for _, item in list do
				if item.level and item.level > before and item.level <= after then
					table.insert(unlocks, { slot = slot, name = item.name })
				end
			end
		end
		Net.event("Notify"):FireClient(player, "LevelUp", "LEVEL " .. after, { unlocks = unlocks })
		stampCharacter(player)
	end
	local _ = reason
	push(player)
end

function ProgressionService.stat(actor: any, key: string, n: number)
	local player = actor.player
	if not player then
		return
	end
	services.DataService.update(player, function(d: { [string]: any })
		d.stats[key] = (d.stats[key] or 0) + n
	end)
	local reward = (XP :: any)[({
		goals = "Goal",
		assists = "Assist",
		callahans = "Callahan",
		catches = "Catch",
		completions = "Completion",
		interceptions = "Interception",
		blocks = "Block",
		layouts = "Layout",
		greatests = "Greatest",
		highlights = "Highlight",
	} :: any)[key] or ""]
	if reward then
		ProgressionService.xp(player, reward * n, key)
	end
	checkAchievements(player)
	push(player)
end

local function comboXp(summary: any, cap: number): number
	local points = if type(summary.xpScore) == "number" then summary.xpScore else (summary.score or 0)
	return math.clamp(math.floor(points / 100 * XP.ComboPerHundred), 0, cap)
end

-- A chain converted into a play (catch, interception, block).
function ProgressionService.combo(player: Player, summary: any)
	local amount = comboXp(summary, XP.ComboCap)
	if amount > 0 then
		ProgressionService.xp(player, amount, "combo")
	end
	services.DataService.update(player, function(d: { [string]: any })
		d.stats.combosConverted = (d.stats.combosConverted or 0) + 1
		if summary.tier == "BREAKPOINT" then
			d.stats.breakpointCombos = (d.stats.breakpointCombos or 0) + 1
		end
	end)
	checkAchievements(player)
end

-- A chain that was not converted: its 25 % share, during match play only.
function ProgressionService.comboUnconverted(player: Player, summary: any)
	local actor = services.PlayerService.fromPlayer(player)
	local phase = services.MatchService.phase()
	if not actor or actor.role ~= "Match" or (phase ~= "Live" and phase ~= "Pull") then
		return
	end
	local paid = unconvertedPaid[player.UserId] or 0
	local amount = math.min(comboXp(summary, XP.UnconvertedComboCap), XP.UnconvertedMatchCap - paid)
	if amount > 0 then
		unconvertedPaid[player.UserId] = paid + amount
		ProgressionService.xp(player, amount, "combo")
	end
end

local function onTech(actorId: number, tech: string, quality: string)
	local actor = services.PlayerService.get(actorId)
	if not actor or not actor.player then
		return
	end
	services.DataService.update(actor.player, function(d: { [string]: any })
		local m = d.techMastery[tech]
		if type(m) ~= "table" then
			m = { count = 0, perfect = 0 }
			d.techMastery[tech] = m
		end
		m.count += 1
		if quality == "Perfect" then
			m.perfect += 1
		end
		if (MovementConfig.ComboPoints :: any)[tech] and (MovementConfig.ComboPoints :: any)[tech] > 0 then
			d.stats.techs = (d.stats.techs or 0) + 1
		end
	end)
end

export type MatchResult = {
	ranked: boolean, -- the match counts for rating (ranked and nobody on the roster left)
	roster: { [number]: string }, -- ranked roster: actor id -> team
	ratings: { [string]: number }, -- average roster rating per team at the start
	margin: number,
	pvp: boolean, -- both teams had human players
}

function ProgressionService.matchStarted()
	unconvertedPaid = {}
end

local function rate(player: Player, mine: number, theirs: number, won: boolean, margin: number): { [string]: number }?
	local d = data(player)
	if not d then
		return nil
	end
	local old = d.rating
	local new = Rating.update(old, d.ratedGames, mine, theirs, won, margin)
	services.DataService.update(player, function(dd: { [string]: any })
		dd.rating = new
		dd.ratedGames += 1
		dd.peakRating = math.max(dd.peakRating, new)
	end)
	services.LeaderboardService.submit(player, new)
	return { old = old, new = new }
end

-- A ranked roster player abandoned the match: rated as a loss now. (No
-- immediate save: when they are leaving, DataService's release save follows
-- right after and a second concurrent save could re-take the session lock.)
function ProgressionService.rankedLoss(player: Player, mine: number, theirs: number)
	if rate(player, mine, theirs, false, 0) then
		ProgressionService.stat({ player = player }, "matches", 1)
		stampCharacter(player)
	end
end

-- Called once per finished match. Returns rating changes for the summary.
function ProgressionService.matchEnded(winner: string?, rows: { any }, result: MatchResult): { [string]: any }
	local changes = {}
	local mult = if result.pvp then XP.PvPMultiplier else 1
	for _, row in rows do
		local player = services.Actors.playerOf(row.id)
		if player then
			local won = winner == row.team
			ProgressionService.stat({ player = player }, "matches", 1)
			if won then
				ProgressionService.stat({ player = player }, "wins", 1)
			end
			ProgressionService.xp(player, (XP.MatchPlayed + (if won then XP.MatchWon else 0)) * mult, "match")
			local rosterTeam = result.roster[row.id]
			if result.ranked and rosterTeam then
				local mine = if rosterTeam == "A" then result.ratings.A else result.ratings.B
				local theirs = if rosterTeam == "A" then result.ratings.B else result.ratings.A
				local change = rate(player, mine, theirs, winner == rosterTeam, result.margin)
				if change then
					changes[tostring(row.id)] = change
				end
			end
			stampCharacter(player)
			services.DataService.saveNow(player)
			push(player)
		end
	end
	return changes
end

function ProgressionService.recordPersonalBest(
	player: Player,
	drill: string,
	value: number,
	lowerIsBetter: boolean
): boolean
	local d = data(player)
	if not d then
		return false
	end
	local prev = d.personalBests[drill]
	local better = prev == nil or (if lowerIsBetter then value < prev else value > prev)
	services.DataService.update(player, function(dd: { [string]: any })
		if better then
			dd.personalBests[drill] = value
		end
		if not dd.drillsDone[drill] then
			dd.drillsDone[drill] = true
			local count = 0
			for _ in dd.drillsDone do
				count += 1
			end
			dd.stats.drillsCompleted = count
		end
	end)
	ProgressionService.xp(player, XP.TrainingDrill + (if better and prev ~= nil then XP.PersonalBest else 0), "drill")
	checkAchievements(player)
	push(player)
	return better
end

local function sanitizeSettings(raw: any): any
	if type(raw) ~= "table" then
		return nil
	end
	local out = { values = {}, keyboard = {}, gamepad = {} }
	if type(raw.values) == "table" then
		for k, default in InputConfig.DefaultSettings do
			local v = raw.values[k]
			if type(v) == type(default) then
				if type(v) == "number" then
					v = math.clamp(v, 0, 200)
				end
				out.values[k] = v
			else
				out.values[k] = default
			end
		end
	end
	for _, scheme in { "keyboard", "gamepad" } do
		local src = raw[scheme]
		if type(src) == "table" then
			for _, action in InputConfig.Actions do
				local keys = src[action]
				if type(keys) == "table" then
					local clean = {}
					for i, k in keys do
						if i <= 3 and type(k) == "string" and #k <= 32 then
							table.insert(clean, k)
						end
					end
					out[scheme][action] = clean
				end
			end
		end
	end
	return out
end

function ProgressionService.action(player: Player, kind: string, payload: any)
	if
		kind == "Equip"
		and type(payload) == "table"
		and type(payload.slot) == "string"
		and type(payload.id) == "string"
	then
		local d = data(player)
		if d and isUnlocked(d, payload.slot, payload.id) then
			services.DataService.update(player, function(dd: { [string]: any })
				dd.cosmetics[payload.slot] = payload.id
			end)
			stampCharacter(player)
			push(player)
		end
	elseif kind == "SaveSettings" then
		local clean = sanitizeSettings(payload)
		if clean then
			services.DataService.update(player, function(dd: { [string]: any })
				dd.settings = clean
			end)
			stampCharacter(player)
		end
	end
end

function ProgressionService.Init(s: any)
	services = s
end

function ProgressionService.Start()
	services.DataService.Loaded:Connect(function(player)
		stampCharacter(player)
		push(player)
	end)
	services.PlayerService.CharacterSpawned:Connect(function(actor)
		if actor.player then
			task.defer(stampCharacter, actor.player)
		end
	end)
	services.MovementService.TechAccepted:Connect(onTech)
	Net.func("GetProfile").OnServerInvoke = function(player)
		return snapshot(player)
	end
	Players.PlayerRemoving:Connect(function(p)
		pushQueued[p] = nil
		unconvertedPaid[p.UserId] = nil
	end)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">TeamService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TeamService — makes the world match the match plan (Rules/MatchPlan).

	MatchPlan (pure, unit-tested) decides who plays for which team and who is
	on the field each point; this service applies it to real actors:

	  * match start   every non-training human is split by rating (counts
	                  within one); at most TeamSize per team play ("Match"),
	                  the rest sit on the bench ("Bench"). A ranked match
	                  records its roster (and the roster's ratings) here.
	  * each point    setupLine(point) picks the line (whoever sat out
	                  longest first) and tops it up with bots to exactly
	                  TeamSize when the mode has FillWithBots.
	  * late joiner   goes to the team with fewer humans, on the bench until
	                  the next point, then takes a bot's spot.
	  * leaver        removed at once; a bot takes their spot straight away
	                  (FillWithBots) so the point is not played short.

	Bots are spawned in the background (model creation yields), one pass at
	a time; LineChanged fires after every pass so MatchService can put new
	arrivals where they belong. Nothing here teleports.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MatchPlan = require(Shared.Rules.MatchPlan)
local Rating = require(Shared.Rules.Rating)
local Signal = require(Shared.Util.Signal)

local TeamService = {}

TeamService.LineChanged = Signal.new() -- () roles, lines or bots changed
TeamService.TrainingChanged = Signal.new() -- (actor, training)

local services: any
local plan: MatchPlan.Plan? = nil
local rosterRatings: { [string]: number } = { A = 0, B = 0 }

local working = false
local again = false

local function humansAvailable(): { any }
	local list = {}
	for _, a in services.PlayerService.humans() do
		if a.role ~= "Training" then
			table.insert(list, a)
		end
	end
	return list
end

local function entryFor(actor: any): MatchPlan.Entry
	local data = actor.player and services.DataService.get(actor.player)
	local rating = if data and type(data.rating) == "number" then data.rating else nil
	return { id = actor.id, rating = rating }
end

-- Every human's team and role as the plan says.
local function syncRoles(p: MatchPlan.Plan)
	for _, m in MatchPlan.members(p) do
		local actor = services.PlayerService.get(m.id)
		if actor and (actor.team ~= m.team or actor.role ~= m.role) then
			services.PlayerService.setTeam(actor, m.team, m.role)
		end
	end
end

-- One reconciliation of the registered bots with what the line needs.
-- Spawning yields; the plan may be replaced meanwhile.
local function botPass(p: MatchPlan.Plan)
	for _, team in { "A", "B" } do
		for _, id in table.clone(p.teams[team].bots) do
			if not services.PlayerService.get(id) then
				MatchPlan.removeBot(p, id)
			end
		end
	end
	local work = MatchPlan.botWork(p)
	for _, id in work.remove do
		MatchPlan.removeBot(p, id)
		services.BotService.remove(id)
	end
	for _, team in { "A", "B" } do
		for _ = 1, work.spawn[team] do
			local id = services.BotService.spawn(team)
			if plan ~= p then
				-- the match ended while the model was being built
				services.BotService.remove(id)
				return
			end
			if not services.PlayerService.get(id) then
				-- model creation failed; the next apply() tries again
				return
			end
			MatchPlan.addBot(p, team, id)
			-- place each bot as soon as it exists
			TeamService.LineChanged:Fire()
		end
	end
end

-- Serialised background bot work; a request during a pass schedules another.
local function runBots()
	if working then
		again = true
		return
	end
	working = true
	task.spawn(function()
		repeat
			again = false
			local p = plan
			if p then
				local ok, err = pcall(function()
					botPass(p)
				end)
				if not ok then
					warn("[TeamService] " .. tostring(err))
				end
			end
			TeamService.LineChanged:Fire()
		until not again
		working = false
	end)
end

local function apply()
	local p = plan
	if not p then
		return
	end
	syncRoles(p)
	TeamService.LineChanged:Fire()
	runBots()
end

-- Waits (up to `timeout` seconds) until no bot is being spawned.
function TeamService.waitForBots(timeout: number)
	local deadline = os.clock() + timeout
	while working and os.clock() < deadline do
		task.wait(0.05)
	end
end

-- Splits every non-training human into teams for a new match.
function TeamService.assignForMatch(mode: any)
	local entries: { MatchPlan.Entry } = {}
	for _, a in humansAvailable() do
		table.insert(entries, entryFor(a))
	end
	local p = MatchPlan.new(mode, entries, { ranked = mode.Ranked == true })
	plan = p
	-- the roster's average ratings at the start (ranked rating updates)
	local byTeam: { [string]: { number } } = { A = {}, B = {} }
	for _, e in entries do
		local team = MatchPlan.slot(p, e.id)
		if team then
			table.insert(byTeam[team], Rating.ratingOf(e))
		end
	end
	rosterRatings = { A = Rating.teamRating(byTeam.A), B = Rating.teamRating(byTeam.B) }
	apply()
end

-- Picks the line for a point (idempotent per point number) and applies it.
function TeamService.setupLine(point: number)
	local p = plan
	if not p then
		return
	end
	MatchPlan.line(p, point)
	apply()
end

local function existing(ids: { number }): { number }
	local out = {}
	for _, id in ids do
		if services.PlayerService.get(id) then
			table.insert(out, id)
		end
	end
	return out
end

-- Actor ids on the field for `team` (line humans first, then bots).
function TeamService.lineFor(team: string): { number }
	local p = plan
	if not p then
		return {}
	end
	return existing(MatchPlan.lineFor(p, team))
end

-- Benched humans of `team`.
function TeamService.benchFor(team: string): { number }
	local p = plan
	if not p then
		return {}
	end
	return existing(MatchPlan.benchFor(p, team))
end

-- (index, count) of an actor's line-up spot, or (nil, count) off the line.
function TeamService.lineIndex(id: number): (number?, number)
	local p = plan
	if not p then
		return nil, 0
	end
	return MatchPlan.lineIndex(p, id)
end

-- Per-team counts (humans incl. bench, line, bench, bots), or nil between matches.
function TeamService.counts(): { [string]: MatchPlan.TeamCounts }?
	local p = plan
	if not p then
		return nil
	end
	return MatchPlan.counts(p)
end

function TeamService.rankedResult(): MatchPlan.RankedResult?
	local p = plan
	if not p then
		return nil
	end
	return MatchPlan.rankedResult(p)
end

-- Average rating of each team's ranked roster at the start.
function TeamService.rosterRatings(): { [string]: number }
	return table.clone(rosterRatings)
end

-- The team an actor was on in this ranked match's roster, or nil.
function TeamService.rankedRosterTeam(id: number): string?
	local p = plan
	if not p or not p.ranked then
		return nil
	end
	return p.roster[id]
end

function TeamService.inMatch(): boolean
	return plan ~= nil
end

-- A player arriving (or leaving training) during a match. Returns their
-- team and role ("Bench" until the next point is picked).
function TeamService.placeLateJoiner(actor: any): (string, string)
	local p = plan
	if not p then
		services.PlayerService.setTeam(actor, "N", "Spectate")
		return "N", "Spectate"
	end
	local team, role = MatchPlan.join(p, entryFor(actor))
	services.PlayerService.setTeam(actor, team, role)
	apply()
	return team, role
end

-- A human leaving the match (left the game or went to training).
function TeamService.remove(actor: any): MatchPlan.LeaveResult?
	local p = plan
	if not p or actor.isBot then
		return nil
	end
	local result = MatchPlan.leave(p, actor.id)
	if result then
		apply()
	end
	return result
end

function TeamService.rebalance()
	apply()
end

function TeamService.setTraining(actor: any, training: boolean)
	if training then
		TeamService.remove(actor)
		services.PlayerService.setTeam(actor, "N", "Training")
	elseif plan then
		TeamService.placeLateJoiner(actor)
	else
		services.PlayerService.setTeam(actor, "N", "Spectate")
	end
	TeamService.TrainingChanged:Fire(actor, training)
end

function TeamService.clearMatch()
	local p = plan
	plan = nil
	rosterRatings = { A = 0, B = 0 }
	for _, a in services.PlayerService.all() do
		if a.isBot then
			local inPlan = p ~= nil and p.botTeam[a.id] ~= nil
			if inPlan or a.role == "Match" or a.role == "Bench" then
				services.BotService.remove(a.id)
			end
		elseif a.role ~= "Training" then
			services.PlayerService.setTeam(a, "N", "Spectate")
		end
	end
end

function TeamService.Init(s: any)
	services = s
end

function TeamService.Start() end

return TeamService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">ThrowService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ThrowService — validates throws and launches discs.

	The client sends its INPUTS (type, aim, hold time, bank, release height)
	plus where it threw from: its step from the pivot (`step`), the pivot it
	used (`pivot`, informative only), its root (`rootPos`) and its release
	time (`releaseT`). The server rebuilds the launch with the same
	ThrowModel from values it validates itself:
	  * pivot     always the server's authoritative P (MovementService.pivotOf,
	              replicated as UBPivot); the client's is ignored
	  * step      clamped (ThrowModel.clampStep) and accepted only when the
	              root is where that step puts it (ThrowModel.resolveStep);
	              otherwise the step implied by the root is used
	  * rootPos   the client's root when it is within ROOT_TOLERANCE (+ speed x
	              ping) of the server's view, else the server's root. With a
	              pivot it only supplies the hop height; without one (a throw
	              on the run) it is the release origin
	  * releaseT  clamped to [now - min(ping, 0.25), now]; the flight starts
	              then (DiscService.launch), so the thrower's predicted disc
	              and the real one leave together
	  * height    High needs recent airborne evidence (airborne now, hopping,
	              airborne within HIGH_AIR_WINDOW, or the client's reported
	              mode Air); otherwise it is released Mid
	  * swinging  from the server's own PivotSwing record
	              (MovementService.isSwinging at the release time)
	  * hold time measured by the server (ThrowCharge -> Throw) unless the
	              two agree within 0.2 s
	A planted pivot has no run-up, so a pivot release ignores thrower velocity
	(ThrowModel). Releases tell the thrower what was used (Feedback "Release":
	heightUsed / heightAsked / stepUsed / stepAccepted / blocked ...).

	Hand blocks (match play, not pulls) test the first HandBlockCheckTime of
	the flight against defenders rewound to where the thrower saw them
	(DefenseService.checkHandBlock); a block deflects the disc from the
	contact point at the contact time. previewBlock() runs the same test
	without throwing (bots choosing a release).

	Fakes (rate-limited at FakeCooldown, with a little jitter allowance) carry
	the side the fake stepped to: character attributes Fake (server time, for
	poses), FakeT (the estimated time the fake happened: arrival minus ping;
	MovementService judges a "Sold" PivotSwing against it, bots react to it)
	and FakeSide (-1 thrower's left, 0 none, +1 thrower's right). Windups set
	WindupType + Windup; a release resets Windup and WindupType so no stale
	windup is ever read (DiscService also clears them when possession ends).

	Combo: the release reports to MovementService.noteRelease, which adds the
	"Break" link after a Sold swing (the client's own "Break" Tech event for
	the same swing is the same link, never counted twice).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local ThrowModel = require(Shared.Disc.ThrowModel)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local Net = require(Shared.Net)

local T = DiscConfig.Throw
local C = DiscConfig.Catch

-- the client's root is trusted within this many studs of the server's view
-- (plus speed x ping for the replication lag of a moving body), capped
local ROOT_TOLERANCE = 3
local ROOT_TOLERANCE_MAX = 6
-- a release may be backdated by at most min(ping, this)
local MAX_RELEASE_BACKDATE = 0.25
-- a High release needs the thrower airborne within this long
local HIGH_AIR_WINDOW = 0.3
-- the server's view of a body lags about this much beyond the ping
local AIR_LAG = 0.1
-- arrival jitter allowed on the fake rate limit
local FAKE_JITTER = 0.05
-- min seconds between two throws of one actor
local THROW_COOLDOWN = 0.25

local ThrowService = {}

local services: any
local chargeStart: { [number]: number } = {}
local lastFake: { [number]: number } = {}
local lastThrow: { [number]: number } = {}

local function now(): number
	return Net.now()
end

local function setAttr(actorId: number, key: string, value: any)
	local actor = services.PlayerService.get(actorId)
	if actor and actor.character then
		actor.character:SetAttribute(key, value)
	end
end

local function finite(v: number): boolean
	return v == v and v ~= math.huge and v ~= -math.huge
end

function ThrowService.beginCharge(actorId: number, throwType: string)
	if not services.DiscService.heldBy(actorId) then
		return
	end
	chargeStart[actorId] = os.clock()
	setAttr(actorId, "WindupType", throwType)
	setAttr(actorId, "Windup", now())
end

-- A pump fake. `side` is where the fake stepped (-1 left, 0 none, +1 right
-- in the thrower's aim frame).
function ThrowService.fake(actorId: number, throwType: string, side: number?)
	local clock = os.clock()
	if (lastFake[actorId] or -math.huge) > clock - (T.FakeCooldown - FAKE_JITTER) then
		return
	end
	if not services.DiscService.heldBy(actorId) then
		return
	end
	lastFake[actorId] = clock
	chargeStart[actorId] = nil -- a fake ends the windup
	local s = if type(side) == "number" and finite(side) then side else 0
	local fakeSide = if s > 0.5 then 1 elseif s < -0.5 then -1 else 0
	local tNow = now()
	setAttr(actorId, "WindupType", throwType)
	setAttr(actorId, "FakeSide", fakeSide)
	setAttr(actorId, "FakeT", tNow - services.MovementService.ping(actorId))
	setAttr(actorId, "Fake", tNow)
end

export type Result = {
	launch: ThrowModel.Launch,
	blocked: number?,
}

type Prepared = {
	params: ThrowModel.Params,
	actor: any,
	root: BasePart,
	disc: any,
	rootPos: Vector3,
	velocity: Vector3,
	t0: number,
	ping: number,
	heightAsked: string,
	stepAccepted: boolean,
}

-- Validates raw throw parameters into what the server will actually throw.
-- Pure apart from reading state (no side effects), so previewBlock can use it.
local function prepare(actorId: number, raw: any, isBot: boolean): Prepared?
	local params = ThrowModel.sanitize(raw)
	if not params then
		return nil
	end
	local p = params :: ThrowModel.Params
	local d = services.DiscService.heldBy(actorId)
	if not d then
		return nil
	end
	local actor = services.PlayerService.get(actorId)
	local root = actor and services.PlayerService.root(actor)
	if not actor or not root then
		return nil
	end
	local tNow = now()
	local ping = if isBot then 0 else services.MovementService.ping(actorId)
	local serverRoot = root.Position
	local vel = root.AssemblyLinearVelocity

	-- release time: the client's, within one ping of now
	local t0 = tNow
	local releaseT = p.releaseT
	if not isBot and releaseT then
		t0 = math.clamp(releaseT, tNow - math.min(ping, MAX_RELEASE_BACKDATE), tNow)
	end

	-- the body the throw leaves from
	local rootPos = serverRoot
	local clientRoot = p.rootPos
	if not isBot and clientRoot then
		local flatSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local tolerance = math.min(ROOT_TOLERANCE + flatSpeed * ping, ROOT_TOLERANCE_MAX)
		if (clientRoot - serverRoot).Magnitude <= tolerance then
			rootPos = clientRoot
		end
	end

	-- pivot + step: P is the server's; the step must match where the body is
	local pivot = services.MovementService.pivotOf(actorId)
	local stepAccepted = true
	p.pivot = pivot
	if pivot then
		local step, ok = ThrowModel.resolveStep(p.step, pivot, rootPos, ping, p.yaw)
		p.step = step
		stepAccepted = ok
	else
		p.step = Vector3.zero
	end
	local swinging = pivot ~= nil and services.MovementService.isSwinging(actorId, t0)
	p.swinging = swinging or (isBot and p.swinging == true)

	-- release height and balance must match what the server has seen
	local heightAsked = p.height
	local track = services.MovementService.track(actorId)
	local grounded = if track then track.grounded else true
	if p.height == "High" then
		local airborne = track ~= nil
			and (
				not track.grounded
				or track.hopping
				or tNow - track.lastAirborneAt <= HIGH_AIR_WINDOW
				or track.mode == "Air"
			)
		if not airborne then
			p.height = "Mid"
		end
	end
	-- off balance: the client says so, or the server has seen the thrower in
	-- the air for longer than the replication lag (a fresh landing is fine)
	local since = if track then track.airborneSince else nil
	local seenAirborne = not grounded and since ~= nil and os.clock() - since > ping + AIR_LAG
	p.offBalance = p.height ~= "High" and (p.offBalance == true or seenAirborne)
	p.groundThrow = services.MovementService.isOnGroundAfterLayout(actorId)
	if p.groundThrow then
		p.height = "Mid"
	end
	p.leftHanded = actor.character ~= nil and actor.character:GetAttribute("LeftHanded") == true

	return {
		params = p,
		actor = actor,
		root = root,
		disc = d,
		rootPos = rootPos,
		velocity = vel,
		t0 = t0,
		ping = ping,
		heightAsked = heightAsked,
		stepAccepted = stepAccepted,
	}
end

local function handBlocksApply(d: any): boolean
	return d.context == "Match" and d.meta.pullPending ~= true
end

-- Would this throw be hand-blocked right now? (Bots test candidate releases.)
function ThrowService.previewBlock(actorId: number, raw: any): boolean
	local prep = prepare(actorId, raw, true)
	if not prep or not handBlocksApply(prep.disc) then
		return false
	end
	local launch = ThrowModel.launch(prep.params, prep.rootPos, prep.velocity)
	local blocker = services.DefenseService.checkHandBlock(
		launch.state,
		actorId,
		prep.actor.team,
		prep.disc.groundY,
		prep.disc.wind
	)
	return blocker ~= nil
end

-- Core throw path shared by humans, bots and pulls.
function ThrowService.throw(actorId: number, raw: any, isBot: boolean?): Result?
	local bot = isBot == true
	local clock = os.clock()
	if (lastThrow[actorId] or -math.huge) > clock - THROW_COOLDOWN then
		return nil
	end
	local prep = prepare(actorId, raw, bot)
	if not prep then
		return nil
	end
	local d = prep.disc
	if not d.handler.canThrow(d, actorId) then
		return nil
	end
	local p = prep.params
	local actor = prep.actor

	-- hold time: trust the server's measurement unless the two agree
	if not bot then
		local started = chargeStart[actorId]
		local measured = if started then clock - started else 0
		if math.abs(measured - p.holdTime) > 0.2 then
			p.holdTime = measured
		end
	end
	chargeStart[actorId] = nil

	local launch = ThrowModel.launch(p, prep.rootPos, prep.velocity)
	lastThrow[actorId] = clock
	local t0 = prep.t0

	-- hand blocks (match play only)
	local blocker: number? = nil
	local blockT: number? = nil
	local blockPos: Vector3? = nil
	local pull = d.meta.pullPending == true
	if handBlocksApply(d) then
		blocker, blockT, blockPos =
			services.DefenseService.checkHandBlock(launch.state, actorId, actor.team, d.groundY, d.wind)
	end

	services.DiscService.launch(d, launch.releasePos, launch.velocity, launch.normal, launch.state.spin, {
		thrower = actorId,
		throwerTeam = actor.team,
		throwType = p.throwType,
		quality = launch.quality,
		pull = pull,
		noCatch = if blockT then (blockT :: number) + 0.02 else T.NoCatchTime,
		stopAt = blockT,
	}, t0)
	-- the launch above cleared the holder's windup; mark the release
	setAttr(actorId, "ReleaseType", p.throwType)
	setAttr(actorId, "Release", now())
	services.MovementService.noteRelease(actorId, t0)

	d.handler.onThrown(d, {
		id = actorId,
		team = actor.team,
		params = p,
		launch = launch,
		pos = prep.rootPos,
		blocked = blocker,
	})

	if actor.player then
		Net.event("Feedback"):FireClient(actor.player, "Release", {
			quality = launch.quality,
			power = launch.power,
			spin = launch.spinFactor,
			speed = launch.speed,
			pitch = launch.pitchDeg,
			bank = launch.bankDeg,
			throwType = p.throwType,
			offBalance = p.offBalance,
			groundThrow = p.groundThrow,
			blocked = blocker ~= nil,
			heightUsed = p.height,
			heightAsked = prep.heightAsked,
			stepUsed = p.step,
			stepAccepted = prep.stepAccepted,
			pivot = p.pivot ~= nil,
		})
	end

	if blocker and blockT and blockPos then
		local flightId = d.flightId
		local bt = blockT :: number
		local bp = blockPos :: Vector3
		local blockerId = blocker :: number
		local contactT = (d.launchTime :: number) + bt
		-- the disc's velocity at the contact (deterministic replay of the launch)
		local at = DiscPhysics.copy(launch.state)
		DiscPhysics.advanceTo(at, bt, d.wind, d.groundY - 100)
		local discVel = DiscPhysics.velocity(at)
		local origin = p.pivot or prep.rootPos
		local function applyBlock()
			if (d.mode ~= "Flight" and d.mode ~= "Landed") or d.flightId ~= flightId then
				return
			end
			local away = Vector3.new(bp.X - origin.X, 0, bp.Z - origin.Z)
			local push = if away.Magnitude > 0.1 then away.Unit * 3 else Vector3.zero
			local newVel = discVel * C.BlockCarry + Vector3.new(0, C.BlockDown, 0) + push
			services.DiscService.deflect(d, bp, newVel, nil, nil, contactT, blockerId)
			Net.event("Effect"):FireAllClients("HandBlock", bp, blockerId, "Clean", "Mark")
			local blockerActor = services.PlayerService.get(blockerId)
			d.handler.onTouched(d, {
				id = blockerId,
				team = if blockerActor then blockerActor.team else "",
				kind = "HandBlock",
				pos = bp,
				zone = "Mark",
			})
		end
		-- a backdated release may already be past the hands: block right away
		local wait = contactT - now()
		if wait <= 0 then
			applyBlock()
		else
			task.delay(wait, applyBlock)
		end
	end
	return { launch = launch, blocked = blocker }
end

-- Launches a disc without a thrower (training launchers, scripted drills).
function ThrowService.launchFrom(d: any, params: ThrowModel.Params, origin: Vector3, meta: { [string]: any }?)
	local launch = ThrowModel.launch(params, origin, Vector3.zero)
	local m: { [string]: any } = meta or {}
	services.DiscService.launch(d, launch.releasePos, launch.velocity, launch.normal, launch.state.spin, {
		thrower = m.thrower,
		throwerTeam = m.throwerTeam,
		throwType = params.throwType,
		quality = launch.quality,
		noCatch = m.noCatch or 0.05,
	})
	return launch
end

function ThrowService.Init(s: any)
	services = s
end

function ThrowService.Start()
	Net.event("ThrowCharge").OnServerEvent:Connect(function(player, throwType)
		local actor = services.PlayerService.fromPlayer(player)
		if actor and type(throwType) == "string" and (DiscConfig.Types :: any)[throwType] then
			ThrowService.beginCharge(actor.id, throwType)
		end
	end)
	Net.event("Fake").OnServerEvent:Connect(function(player, throwType, side)
		local actor = services.PlayerService.fromPlayer(player)
		if actor and type(throwType) == "string" and (DiscConfig.Types :: any)[throwType] then
			ThrowService.fake(actor.id, throwType, if type(side) == "number" then side else 0)
		end
	end)
	Net.event("Throw").OnServerEvent:Connect(function(player, raw)
		local actor = services.PlayerService.fromPlayer(player)
		if actor then
			ThrowService.throw(actor.id, raw, false)
		end
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		chargeStart[actor.id] = nil
		lastFake[actor.id] = nil
		lastThrow[actor.id] = nil
	end)
end

return ThrowService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">TrainingService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TrainingService — drills with actionable feedback.

	Every drill reports WHY something worked or failed in plain terms:
	gate splits and where speed was lost, reversal times with the technique
	that would shorten them, how far a missed catch was and in which
	direction, a throw's release quality, spin, bank and miss vector, the
	defender's distance from the passing lane at release, and which side of
	a mark was open.

	Drills: Tutorial (Movement School), Cutting, Shuttle, Aerial, Range,
	Interception, Combo (lab challenges), BreakMark (Break the Mark),
	Launcher (free, custom launches). Each session owns its own training
	disc; drills never touch the match.

	Movement School teaches the current keys and the forgiving press rules
	(every step can be completed with the MovementSim as it is): running and
	auto-sprint, Snap Cut (hold A or D, then tap Q), plant and restart, burst,
	the jab and the Sold cut, slide and slide cut, air redirect, precision
	landing, layout and pop-up, catching, throwing, then the pivot with the
	disc: stepping, the Quick Swing and the Break (fake, swing, release).

	Break the Mark: the player holds the disc on a pivot mark against a
	scripted bot marker (BotService.mark: shades the force's break side,
	mirrors the step with a reaction lag, bites on fakes, jump-blocks hops;
	its skill ramps 0.5 -> 0.85 over the reps) with two receivers downfield.
	A rep is a success when a throw gets past the mark and is caught; a
	throw on the marker's side scores extra and so does a Break. The drill
	runs its own hand-block test (training discs are not match discs) on the
	marker rewound to where the player saw it, and every rep says which side
	was open and how to beat the side that was not.

	Drills move players with PlayerService.teleport(actor, cf, { face = true })
	so the client turns its camera with them.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ArenasConfig = require(Shared.Config.Arenas)
local DiscConfig = require(Shared.Config.Disc)
local MovementConfig = require(Shared.Config.Movement)
local ThrowModel = require(Shared.Disc.ThrowModel)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local Solver = require(Shared.Disc.Solver)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local VecMath = require(Shared.Util.VecMath)
local TrainingBuilder = require(script.Parent.Parent.Arena.TrainingBuilder)

local TrainingService = {}

local services: any
local layout: TrainingBuilder.Layout

export type Session = {
	actor: any,
	player: Player?,
	drill: string,
	phase: string,
	t0: number,
	data: { [string]: any },
	disc: any?,
	bots: { number },
	ended: boolean,
}

local sessions: { [number]: Session } = {}
local stopDrill: (actor: any) -> ()

local HD = MovementConfig.Holding
local GROUND_RETURN = 5 -- a training disc left on the ground comes back to the hand after this

local function now(): number
	return Net.now()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function send(s: Session, kind: string, payload: any)
	if s.player then
		Net.event("Feedback"):FireClient(s.player, kind, payload)
	end
end

local function hud(s: Session, title: string, text: string, extra: { [string]: any }?)
	local payload: { [string]: any } = { drill = s.drill, title = title, text = text }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	send(s, "DrillHud", payload)
end

local function report(s: Session, title: string, lines: { string }, extra: { [string]: any }?)
	local payload: { [string]: any } = { drill = s.drill, title = title, lines = lines }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	send(s, "Drill", payload)
end

local function root(s: Session): BasePart?
	return services.PlayerService.root(s.actor)
end

-- Moves any actor (player or drill bot) and turns them (and a player's
-- camera) toward `facing`.
local function place(actor: any, pos: Vector3, facing: Vector3?)
	local f = VecMath.flatUnit(facing or Vector3.new(0, 0, 1))
	if f.Magnitude < 0.5 then
		f = Vector3.new(0, 0, 1)
	end
	services.PlayerService.teleport(actor, CFrame.lookAt(pos, pos + f), { face = true })
end

local function teleport(s: Session, pos: Vector3, facing: Vector3?)
	place(s.actor, pos, facing)
end

-- Root position for an actor standing on a ground point of the hall.
local function standingAt(actorId: number, ground: Vector3): Vector3
	return Vector3.new(ground.X, layout.origin.Y + services.MovementService.standHeight(actorId) + 0.1, ground.Z)
end

local function bot(id: number?): any
	return if id then services.BotService.brain(id) else nil
end

-- Bot models load one at a time (spawning yields): a drill cancelled
-- meanwhile must not leave its bots behind.
local function dropIfStopped(s: Session): boolean
	if sessions[s.actor.id] == s then
		return false
	end
	for _, id in s.bots do
		services.BotService.remove(id)
	end
	s.bots = {}
	return true
end

---------------------------------------------------------------------------
-- session disc
---------------------------------------------------------------------------

local DRILLS: { [string]: any } = {}

local function discFor(s: Session): any
	if s.disc then
		return s.disc
	end
	local handler = {} :: any
	function handler.canClaim(_d: any, id: number, _team: string): boolean
		local drill = DRILLS[s.drill]
		if drill and drill.canClaim then
			return drill.canClaim(s, id)
		end
		return id == s.actor.id or table.find(s.bots, id) ~= nil
	end
	function handler.canThrow(_d: any, id: number): boolean
		return id == s.actor.id or table.find(s.bots, id) ~= nil
	end
	function handler.onCaught(d: any, info: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onCaught then
			drill.onCaught(s, d, info)
		end
	end
	function handler.onTouched(d: any, info: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onTouched then
			drill.onTouched(s, d, info)
		end
	end
	function handler.onThrown(d: any, info: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onThrown then
			drill.onThrown(s, d, info)
		end
	end
	function handler.onGrounded(d: any, land: Vector3, samples: any)
		local drill = DRILLS[s.drill]
		if drill and drill.onGrounded then
			drill.onGrounded(s, d, land, samples)
		else
			services.DiscService.placeOnGround(d, land)
		end
	end
	local d = services.DiscService.create("Training", s.actor.id, handler)
	if s.player then
		services.DiscService.setSkin(d, services.ProgressionService.equipped(s.player, "disc"))
	end
	s.disc = d
	return d
end

local function launchAt(
	s: Session,
	origin: Vector3,
	target: Vector3,
	throwType: string,
	bank: number?,
	floaty: boolean?
): any
	local d = discFor(s)
	local sol = Solver.solve({
		rootPos = origin,
		throwType = throwType,
		bank = bank or 0,
		target = target,
		groundY = layout.origin.Y,
		flightTimeWeight = if floaty then 0.05 else 0.6,
		coarse = true,
	})
	if not sol then
		return nil
	end
	services.ThrowService.launchFrom(d, sol.params, origin, { noCatch = 0.1 })
	return sol
end

local function finish(
	s: Session,
	title: string,
	lines: { string },
	pbKey: string?,
	value: number?,
	lowerIsBetter: boolean?
)
	if s.ended then
		return
	end
	s.ended = true
	local isPB = false
	if pbKey and value and s.player then
		local prev = nil
		local data = services.DataService.get(s.player)
		if data then
			prev = data.personalBests[pbKey]
		end
		isPB = services.ProgressionService.recordPersonalBest(s.player, pbKey, value, lowerIsBetter == true)
		if prev ~= nil then
			table.insert(
				lines,
				if isPB then "NEW PERSONAL BEST!" else string.format("Personal best: %s", tostring(prev))
			)
		else
			table.insert(lines, "First completion recorded.")
		end
	end
	report(s, title, lines, { done = true, pb = isPB })
	stopDrill(s.actor)
end

---------------------------------------------------------------------------
-- Movement School
---------------------------------------------------------------------------

-- `any` lists the techniques (and info) that complete a step; `disc` steps
-- are done holding the session disc.
local TUTORIAL: { any } = {
	{ text = "RUN: hold W. You start sprinting by yourself after a moment (or hold SHIFT).", kind = "speed" },
	{
		text = "SNAP CUT: while running, hold A or D, then tap Q. The longer your straight line, the better the cut.",
		any = { { tech = "SnapCut" } },
	},
	{
		text = "PLANT: while running, tap Q with no direction held (or while holding S).",
		any = { { tech = "MomentumCancel" } },
	},
	{
		text = "RESTART: plant (Q), then as you stop hold a direction and press Q, F or SPACE.",
		any = {
			{ tech = "SnapCut", info = "Restart" },
			{ tech = "BurstStep", info = "Explosive" },
			{ tech = "Jump", info = "PlantJump" },
		},
	},
	{ text = "BURST: press F to explode into space (it has a short cooldown).", any = { { tech = "BurstStep" } } },
	{ text = "JAB: run straight and tap Q without steering: a Fake Commit.", any = { { tech = "FakeCommit" } } },
	{
		text = "SOLD CUT: jab (Q), then within half a second hold A or D and tap Q again.",
		any = { { tech = "SnapCut", info = "Sold" } },
	},
	{ text = "SLIDE: while running, press C (or LEFT CTRL).", any = { { tech = "Slide" } } },
	{ text = "SLIDE CUT: during a slide, hold a new direction and tap Q.", any = { { tech = "SlideCut" } } },
	{
		text = "AIR REDIRECT: jump (SPACE), then hold a NEW direction and tap Q in the air.",
		any = { { tech = "AirRedirect" } },
	},
	{
		text = "PRECISION LANDING: jump, then press C just before you touch down.",
		any = { { tech = "PrecisionLanding" } },
	},
	{ text = "LAYOUT: while running, press E to dive.", any = { { tech = "Dive" } } },
	{
		text = "RECOVERY CHAIN: as your dive slide stops, press SPACE, Q or F to pop up.",
		any = { { tech = "RecoveryChain" } },
	},
	{ text = "CATCH: run to the disc. CLICK to reach for ones outside your body.", kind = "catch" },
	{ text = "THROW: hold LEFT MOUSE and release at the peak of the meter (PERFECT).", kind = "throw", disc = true },
	{
		text = "PIVOT: with the disc your pivot foot stays planted. Step out with WASD: the free foot reaches past a marker.",
		kind = "pivot",
		disc = true,
	},
	{
		text = "QUICK SWING: holding the disc, tap Q to swing to the left or E to swing to the right.",
		any = { { tech = "PivotSwing" } },
		disc = true,
	},
	{
		text = "BREAK: fake (RIGHT MOUSE), swing (Q or E) and throw within 0.3 s of the swing.",
		any = { { tech = "Break" } },
		kind = "break",
		disc = true,
	},
}

-- Hands the session disc to the player for a disc step (a disc still in
-- flight comes back when it lands).
local function tutorialGive(s: Session)
	local d = discFor(s)
	if d.mode == "Flight" or (d.mode == "Held" and d.holder == s.actor.id) then
		return
	end
	services.DiscService.giveTo(d, s.actor.id)
end

local function tutorialShow(s: Session)
	local step = TUTORIAL[s.data.step]
	hud(
		s,
		string.format("MOVEMENT SCHOOL  %d/%d", s.data.step, #TUTORIAL),
		step.text,
		{ progress = (s.data.step - 1) / #TUTORIAL }
	)
	s.data.tries = 0
	if step.kind == "catch" then
		local r = root(s)
		if r then
			local d = s.disc
			if d and d.mode == "Held" then
				services.DiscService.hide(d)
			end
			local origin = r.Position + VecMath.flatUnit(r.CFrame.LookVector) * 40
			task.delay(1.0, function()
				if sessions[s.actor.id] == s and TUTORIAL[s.data.step].kind == "catch" then
					launchAt(s, origin, r.Position + Vector3.new(0, 1.5, 0), "Backhand", 0, true)
				end
			end)
		end
	elseif step.disc then
		tutorialGive(s)
	end
end

local function tutorialAdvance(s: Session, note: string?)
	s.data.step += 1
	send(s, "DrillTick", { text = note or "Nice!" })
	if s.data.step > #TUTORIAL then
		finish(s, "MOVEMENT SCHOOL COMPLETE", {
			"You know the whole vocabulary, with and without the disc.",
			"Next: Combo Lab to chain it, Cutting Course to use it at speed, Break the Mark to beat a marker.",
		}, "Tutorial", 1, false)
		return
	end
	tutorialShow(s)
end

local function stepWants(step: any, tech: string, info: string?): boolean
	for _, want in step.any or {} do
		if want.tech == tech and (want.info == nil or want.info == info) then
			return true
		end
	end
	return false
end

DRILLS.Tutorial = {
	start = function(s: Session)
		s.data.step = 1
		s.data.soldSwingAt = -math.huge
		s.data.groundAt = nil
		tutorialShow(s)
	end,
	step = function(s: Session)
		local step = TUTORIAL[s.data.step]
		if not step then
			return
		end
		if step.kind == "speed" then
			local t = services.MovementService.track(s.actor.id)
			if t and flat(t.vel).Magnitude >= MovementConfig.SprintSpeed - 4 then
				tutorialAdvance(s)
			end
		elseif step.kind == "pivot" then
			local r = root(s)
			local P = services.MovementService.pivotOf(s.actor.id)
			if r and P and services.DiscService.heldBy(s.actor.id) then
				-- the root sits at P + BodyShare x step: a real step-out
				if flat(r.Position - P).Magnitude >= 0.66 * HD.StepRadius * HD.BodyShare then
					tutorialAdvance(s, "That's a step-out. The pivot foot never moved.")
				end
			end
		end
		-- a disc on the ground: walk to it, or it comes back after a moment
		local d = s.disc
		if step.disc and d and d.mode == "Ground" then
			local r = root(s)
			local spot = d.folder:GetAttribute("GroundPos")
			local at = s.data.groundAt or now()
			s.data.groundAt = at
			local near = r
				and typeof(spot) == "Vector3"
				and flat(spot - r.Position).Magnitude <= DiscConfig.Catch.PickupRadius
			if near or now() - at > GROUND_RETURN then
				s.data.groundAt = nil
				services.DiscService.giveTo(d, s.actor.id)
			end
		end
	end,
	onTech = function(s: Session, tech: string, quality: string, info: string?)
		local step = TUTORIAL[s.data.step]
		if tech == "PivotSwing" and quality == "Perfect" then
			s.data.soldSwingAt = now()
		end
		if step and stepWants(step, tech, info) then
			tutorialAdvance(s)
		end
	end,
	onCaught = function(s: Session, _d: any, _info: any)
		local step = TUTORIAL[s.data.step]
		if step and step.kind == "catch" then
			tutorialAdvance(s)
		end
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		s.data.groundAt = now()
		local step = TUTORIAL[s.data.step]
		if step and step.kind == "catch" then
			send(s, "DrillTick", { text = "Missed — here comes another." })
			tutorialShow(s)
		elseif step and step.disc then
			send(s, "DrillTick", { text = "Walk over to the disc to pick it up (it comes back by itself too)." })
		end
	end,
	onThrown = function(s: Session, _d: any, info: any)
		local step = TUTORIAL[s.data.step]
		if not step then
			return
		end
		s.data.tries += 1
		if step.kind == "throw" then
			local q = info.launch.quality
			if q == "Perfect" then
				tutorialAdvance(s)
			elseif s.data.tries >= 4 then
				tutorialAdvance(s, "Good enough for now: chase PERFECT releases in the Throwing Range.")
			else
				send(s, "DrillTick", {
					text = if q == "Over"
						then "Held too long (spin lost). Release right as the meter peaks."
						else "Released early. Hold until the meter fills, then let go.",
				})
			end
		elseif step.kind == "break" then
			-- the Break itself arrives as a technique (onTech); a Sold swing
			-- followed by a throw a little late still counts here
			task.defer(function()
				if sessions[s.actor.id] ~= s or TUTORIAL[s.data.step] ~= step then
					return
				end
				if now() - s.data.soldSwingAt <= 1.2 then
					tutorialAdvance(s, "Close! Release a little sooner after the swing for the Break bonus.")
				elseif s.data.tries >= 2 then
					send(s, "DrillTick", {
						text = "Fake first (RIGHT MOUSE), swing straight after (Q or E), then throw at once.",
					})
				end
			end)
		end
	end,
}

---------------------------------------------------------------------------
-- Cutting course
---------------------------------------------------------------------------

DRILLS.Cutting = {
	start = function(s: Session)
		local st = layout.stations.Cutting
		teleport(s, st.start + Vector3.new(0, 3, 0), st.facing)
		s.data.gate = 1
		s.data.splits = {}
		s.data.minSpeed = {}
		s.data.penalty = 0
		s.data.techs = 0
		s.data.lastZ = nil
		hud(s, "CUTTING COURSE", "Cross the green gate to start. Weave through every gate.", { progress = 0 })
	end,
	step = function(s: Session)
		local r = root(s)
		if not r then
			return
		end
		local pos = r.Position
		local gates = layout.gates
		local g = gates[s.data.gate]
		if not g then
			return
		end
		local lastZ = s.data.lastZ or pos.Z
		s.data.lastZ = pos.Z
		if s.data.startAt then
			local sp = flat(r.AssemblyLinearVelocity).Magnitude
			local i = s.data.gate
			s.data.minSpeed[i] = math.min(s.data.minSpeed[i] or math.huge, sp)
			if now() - s.data.startAt > 60 then
				finish(s, "CUTTING COURSE", { "Timed out after 60 s." })
				return
			end
		end
		if lastZ < g.a.Z and pos.Z >= g.a.Z then
			local inside = pos.X >= g.a.X - 0.8 and pos.X <= g.b.X + 0.8
			if not inside then
				s.data.penalty += 2
				send(s, "DrillTick", { text = "Missed gate " .. s.data.gate .. " (+2 s)" })
			end
			if s.data.gate == 1 then
				s.data.startAt = now()
			else
				table.insert(
					s.data.splits,
					{ gate = s.data.gate, t = now() - s.data.startAt, speed = flat(r.AssemblyLinearVelocity).Magnitude }
				)
			end
			s.data.gate += 1
			hud(s, "CUTTING COURSE", string.format("Gate %d / %d", math.min(s.data.gate, #gates), #gates), {
				timerStart = s.data.startAt,
				progress = (s.data.gate - 1) / #gates,
			})
			if s.data.gate > #gates then
				local total = now() - s.data.startAt + s.data.penalty
				local lines = { string.format("Time: %.2f s (penalties %d s)", total, s.data.penalty) }
				local worst, worstGate = math.huge, 0
				for i = 2, #gates do
					local m = s.data.minSpeed[i]
					if m and m < worst then
						worst, worstGate = m, i
					end
				end
				if worstGate > 0 then
					table.insert(
						lines,
						string.format("Slowest section: before gate %d (dropped to %.0f studs/s).", worstGate, worst)
					)
					if worst < 12 then
						table.insert(
							lines,
							string.format(
								"Tip: hold A or D, then tap Q at each gate — a Snap Cut off a straight line keeps %d%% of your speed.",
								math.floor(MovementConfig.SnapCut.Retention.Perfect * 100)
							)
						)
					elseif worst < 18 then
						table.insert(
							lines,
							string.format(
								"Tip: press F within %.2f s of a Snap Cut for a Perfect Burst out of the turn.",
								MovementConfig.BurstStep.CutChainWindow
							)
						)
					else
						table.insert(
							lines,
							"You held speed all the way. Try Slide Cuts (C, then Q) on the tight gates."
						)
					end
				end
				table.insert(lines, string.format("Techniques used: %d", s.data.techs))
				finish(s, "CUTTING COURSE", lines, "Cutting", math.floor(total * 100) / 100, true)
			end
		end
	end,
	onTech = function(s: Session)
		if s.data.startAt then
			s.data.techs += 1
		end
	end,
}

---------------------------------------------------------------------------
-- Momentum shuttle
---------------------------------------------------------------------------

DRILLS.Shuttle = {
	start = function(s: Session)
		local st = layout.stations.Shuttle
		teleport(s, st.start + Vector3.new(0, 3, 0), st.facing)
		s.data.leg = 0
		s.data.reversals = {}
		s.data.lastZ = nil
		s.data.crossedAt = nil
		hud(s, "MOMENTUM SHUTTLE", "Run north across the green line to start: A -> B -> A -> B -> A", { progress = 0 })
	end,
	step = function(s: Session)
		local r = root(s)
		if not r then
			return
		end
		local z = r.Position.Z
		local lastZ = s.data.lastZ or z
		s.data.lastZ = z
		local A, B = layout.shuttleA, layout.shuttleB
		local leg = s.data.leg
		local function crossed(line: number, north: boolean): boolean
			if north then
				return lastZ < line and z >= line
			end
			return lastZ > line and z <= line
		end
		if leg == 0 and crossed(A, true) then
			s.data.startAt = now()
			s.data.leg = 1
		elseif leg == 1 and crossed(B, true) then
			s.data.turnAt = now()
			s.data.leg = 2
		elseif leg == 2 and crossed(B, false) then
			table.insert(s.data.reversals, { line = "B", t = now() - s.data.turnAt })
			s.data.leg = 3
		elseif leg == 3 and crossed(A, false) then
			s.data.turnAt = now()
			s.data.leg = 4
		elseif leg == 4 and crossed(A, true) then
			table.insert(s.data.reversals, { line = "A", t = now() - s.data.turnAt })
			s.data.leg = 5
		elseif leg == 5 and crossed(B, true) then
			s.data.turnAt = now()
			s.data.leg = 6
		elseif leg == 6 and crossed(B, false) then
			table.insert(s.data.reversals, { line = "B", t = now() - s.data.turnAt })
			s.data.leg = 7
		elseif leg == 7 and crossed(A, false) then
			local total = now() - s.data.startAt
			local lines = { string.format("Time: %.2f s", total) }
			for i, rv in s.data.reversals do
				local verdict = if rv.t < 0.3
					then "elite"
					elseif rv.t < 0.5 then "good"
					else "slow — plant (tap Q with no direction), then hold the way back and press Q, F or SPACE as you stop"
				table.insert(lines, string.format("Reversal %d at %s: %.2f s (%s)", i, rv.line, rv.t, verdict))
			end
			finish(s, "MOMENTUM SHUTTLE", lines, "Shuttle", math.floor(total * 100) / 100, true)
			return
		end
		if s.data.startAt then
			hud(s, "MOMENTUM SHUTTLE", string.format("Leg %d / 4", math.clamp(math.ceil(s.data.leg / 2), 1, 4)), {
				timerStart = s.data.startAt,
				progress = s.data.leg / 7,
			})
			if now() - s.data.startAt > 40 then
				finish(s, "MOMENTUM SHUTTLE", { "Timed out." })
			end
		end
	end,
}

---------------------------------------------------------------------------
-- Aerial catch
---------------------------------------------------------------------------

local AERIAL: { any } = {
	{ x = 0, z = 0, h = 4.5, type = "Backhand", label = "Chest-high floater", floaty = true },
	{ x = -10, z = 4, h = 8.5, type = "Backhand", label = "High floater: jump", floaty = true },
	{ x = 10, z = -4, h = 1.6, type = "Forehand", label = "Low skimmer: slide or dive" },
	{ x = 16, z = 2, h = 2.6, type = "Backhand", label = "Wide: lay out" },
	{ x = -6, z = -22, h = 4, type = "Hammer", label = "Hammer over the top: get back" },
	{ x = -14, z = 6, h = 3.5, type = "Forehand", bank = 0.8, label = "Curving away" },
	{ x = 12, z = 10, h = 2.2, type = "Blade", label = "Fast blade: read it early" },
	{ x = -12, z = -2, h = 8.0, type = "Backhand", bank = -0.6, label = "Jump + Air Redirect", floaty = true },
	{ x = 4, z = -34, h = 4, type = "Backhand", label = "Deep floater: sprint", floaty = true },
	{ x = -18, z = -8, h = 2.2, type = "Forehand", label = "Full layout" },
}

local function aerialNext(s: Session)
	s.data.index += 1
	local p = AERIAL[s.data.index]
	if not p then
		local lines = { string.format("Score: %d (%d / %d caught)", s.data.score, s.data.caught, #AERIAL) }
		for _, line in s.data.notes do
			table.insert(lines, line)
		end
		finish(s, "AERIAL CATCH", lines, "Aerial", s.data.score, false)
		return
	end
	s.data.closest = math.huge
	s.data.closestRel = Vector3.zero
	s.data.closestAt = 0
	s.data.inFlight = false
	hud(
		s,
		string.format("AERIAL CATCH  %d/%d", s.data.index, #AERIAL),
		p.label,
		{ progress = (s.data.index - 1) / #AERIAL }
	)
	task.delay(1.4, function()
		if sessions[s.actor.id] ~= s then
			return
		end
		local mark = layout.catchMark
		local target = mark + Vector3.new(p.x, p.h, p.z)
		launchAt(s, layout.launcher, target, p.type, p.bank, p.floaty)
		s.data.inFlight = true
	end)
end

local function aerialResult(s: Session, caught: boolean, info: any?)
	if not s.data.inFlight then
		return
	end
	s.data.inFlight = false
	local p = AERIAL[s.data.index]
	if caught then
		local pts = 100
		if info and info.quality == "Clean" then
			pts += 50
		end
		if info and info.zone == "Dive" then
			pts += 100
		end
		s.data.score += pts
		s.data.caught += 1
		send(s, "DrillTick", { text = string.format("Caught! +%d", pts) })
	else
		local rel: Vector3 = s.data.closestRel
		local lines = { string.format("%s — missed by %.1f studs.", p.label, s.data.closest) }
		if rel.Y > 2 then
			table.insert(lines, "It was above you: jump (SPACE) and reach (CLICK).")
		elseif rel.Y < -1.5 then
			table.insert(lines, "It was low: slide (C) or lay out (E) to get under it.")
		end
		if flat(rel).Magnitude > 3 then
			table.insert(lines, "Too far away: move on the launch, or lay out (E) toward it.")
		end
		local reach = services.CatchingService.reachState(s.actor.id)
		if reach and math.abs(reach.at - s.data.closestAt) < 1.5 then
			local diff = reach.at - s.data.closestAt
			if diff < -0.3 then
				table.insert(lines, string.format("You reached %.2f s too early.", -diff))
			elseif diff > 0.05 then
				table.insert(lines, string.format("You reached %.2f s late.", diff))
			end
		end
		send(s, "DrillTick", { text = table.concat(lines, "  ") })
		table.insert(s.data.notes, lines[1])
	end
	task.delay(1.0, function()
		if sessions[s.actor.id] == s then
			if s.disc and s.disc.mode == "Held" then
				services.DiscService.hide(s.disc)
			end
			teleport(s, layout.catchMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
			aerialNext(s)
		end
	end)
end

DRILLS.Aerial = {
	start = function(s: Session)
		teleport(s, layout.catchMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
		s.data.index = 0
		s.data.score = 0
		s.data.caught = 0
		s.data.notes = {}
		aerialNext(s)
	end,
	step = function(s: Session)
		local d = s.disc
		if not d or not s.data.inFlight or d.mode ~= "Flight" then
			return
		end
		local r = root(s)
		local p = services.DiscService.currentPosition(d)
		if r and p then
			local chest = r.Position + Vector3.new(0, DiscConfig.Catch.ChestHeight, 0)
			local dist = (p - chest).Magnitude
			if dist < s.data.closest then
				s.data.closest = dist
				s.data.closestRel = p - chest
				s.data.closestAt = now()
			end
		end
	end,
	onCaught = function(s: Session, _d: any, info: any)
		aerialResult(s, true, info)
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		aerialResult(s, false, nil)
	end,
}

---------------------------------------------------------------------------
-- Free launcher
---------------------------------------------------------------------------

DRILLS.Launcher = {
	start = function(s: Session)
		teleport(s, layout.catchMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
		send(s, "OpenLauncher", {})
		hud(s, "FREE LAUNCHER", "Set type, power, angle and curve in the panel, then Launch.", {})
	end,
	launch = function(s: Session, payload: any)
		local r = root(s)
		if not r or type(payload) ~= "table" then
			return
		end
		local params = ThrowModel.sanitize({
			throwType = payload.throwType,
			yaw = 0,
			pitch = math.rad(if type(payload.pitch) == "number" then payload.pitch else 8),
			holdTime = (if type(payload.power) == "number" then math.clamp(payload.power, 0.05, 1) else 0.5)
				* DiscConfig.Throw.ChargeTime,
			bank = payload.bank,
			height = "Mid",
		})
		if not params then
			return
		end
		local p = params :: ThrowModel.Params
		local d = flat(r.Position - layout.launcher)
		p.yaw = math.atan2(-d.X, -d.Z)
			+ math.rad(if type(payload.offset) == "number" then math.clamp(payload.offset, -30, 30) else 0)
		services.ThrowService.launchFrom(discFor(s), p, layout.launcher, { noCatch = 0.1 })
	end,
	onCaught = function(s: Session, _d: any, info: any)
		send(s, "DrillTick", { text = string.format("Caught (%s, %s zone)", info.quality, info.zone) })
		task.delay(0.6, function()
			if s.disc and s.disc.mode == "Held" then
				services.DiscService.hide(s.disc)
			end
		end)
	end,
}

---------------------------------------------------------------------------
-- Throwing range
---------------------------------------------------------------------------

local RANGE_THROWS = 10

local function moverPos(t: number): Vector3
	local m = layout.mover
	return TrainingBuilder.moverPosition(m.center, m.amplitude, m.period, t)
end

local function rangeGive(s: Session)
	if sessions[s.actor.id] ~= s then
		return
	end
	teleport(s, layout.throwMark + Vector3.new(0, 3, 0), Vector3.new(0, 0, 1))
	services.DiscService.giveTo(discFor(s), s.actor.id)
	hud(
		s,
		string.format("THROWING RANGE  %d/%d", s.data.throws + 1, RANGE_THROWS),
		"Hit the rings. The yellow one moves.",
		{
			progress = s.data.throws / RANGE_THROWS,
		}
	)
end

local function rangeResult(s: Session)
	if not s.data.inFlight then
		return
	end
	s.data.inFlight = false
	local info = s.data.throwInfo
	local launch = info.launch
	local lines = {}
	local hit = s.data.hit
	if hit then
		s.data.score += hit.points
		table.insert(lines, string.format("HIT %s! +%d", hit.name, hit.points))
	else
		local near = s.data.nearest
		if near then
			local forward = VecMath.flatUnit(near.target - launch.releasePos)
			local right = Vector3.new(-forward.Z, 0, forward.X)
			local miss = near.discPos - near.target
			local lateral = miss:Dot(right)
			local long = miss:Dot(forward)
			table.insert(lines, string.format("Missed %s by %.1f studs.", near.name, near.dist))
			if math.abs(lateral) > 2 then
				table.insert(
					lines,
					string.format(
						"%.0f studs %s: aim %s or bank %s.",
						math.abs(lateral),
						if lateral > 0 then "right" else "left",
						if lateral > 0 then "left" else "right",
						if lateral > 0 then "left (Z)" else "right (X)"
					)
				)
			end
			if miss.Y < -2.5 or long < -3 then
				table.insert(lines, "Short / low: hold longer or raise your aim.")
			elseif miss.Y > 2.5 or long > 3 then
				table.insert(lines, "Long / high: release earlier or lower your aim.")
			end
		end
	end
	table.insert(
		lines,
		string.format(
			"Release: %s  power %d%%  spin %d%%  bank %+d deg",
			launch.quality,
			math.floor(launch.power * 100),
			math.floor(launch.spinFactor * 100),
			math.floor(launch.bankDeg)
		)
	)
	if launch.quality == "Over" then
		table.insert(lines, "Overcharged: low spin makes the disc roll (turn/fade) more. Release at the peak.")
	end
	send(s, "DrillTick", { text = table.concat(lines, "  ") })
	s.data.throws += 1
	if s.data.throws >= RANGE_THROWS then
		task.delay(1.0, function()
			finish(s, "THROWING RANGE", {
				string.format("Score: %d", s.data.score),
				string.format("Rings hit: %d / %d", s.data.hits, RANGE_THROWS),
			}, "Range", s.data.score, false)
		end)
	else
		task.delay(1.2, function()
			rangeGive(s)
		end)
	end
end

DRILLS.Range = {
	start = function(s: Session)
		s.data.throws = 0
		s.data.score = 0
		s.data.hits = 0
		rangeGive(s)
	end,
	onThrown = function(s: Session, _d: any, info: any)
		s.data.inFlight = true
		s.data.throwInfo = info
		s.data.hit = nil
		s.data.nearest = nil
	end,
	step = function(s: Session)
		local d = s.disc
		if not d or not s.data.inFlight or d.mode ~= "Flight" then
			return
		end
		local p = services.DiscService.currentPosition(d)
		if not p then
			return
		end
		local t = now()
		local candidates = {}
		for _, tg in layout.targets do
			table.insert(candidates, { name = tg.name, pos = tg.pos, radius = tg.radius, points = tg.points })
		end
		table.insert(
			candidates,
			{ name = "MOVER", pos = moverPos(t), radius = layout.mover.radius, points = layout.mover.points }
		)
		for _, c in candidates do
			local dist = (p - c.pos).Magnitude
			if dist <= c.radius + 0.6 then
				s.data.hit = c
				s.data.hits += 1
				Net.event("Effect"):FireAllClients("TargetHit", p, s.actor.id, "Clean", c.name)
				services.DiscService.placeOnGround(d, Vector3.new(c.pos.X, layout.origin.Y, c.pos.Z))
				rangeResult(s)
				return
			end
			if s.data.nearest == nil or dist < s.data.nearest.dist then
				s.data.nearest = { name = c.name, dist = dist, target = c.pos, discPos = p }
			end
		end
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		rangeResult(s)
	end,
	onCaught = function(_s: Session) end,
}

---------------------------------------------------------------------------
-- Interception drill
---------------------------------------------------------------------------

local ROUTES = {
	{ Vector3.new(0, 0, 34) },
	{ Vector3.new(-14, 0, 10), Vector3.new(-30, 0, 30) },
	{ Vector3.new(0, 0, 18), Vector3.new(-24, 0, 4) },
	{ Vector3.new(-30, 0, 0) },
	{ Vector3.new(0, 0, 50) },
	{ Vector3.new(-10, 0, 30), Vector3.new(10, 0, 10) },
	{ Vector3.new(-26, 0, 24) },
	{ Vector3.new(6, 0, 40), Vector3.new(-20, 0, 50) },
}

local function interceptionRep(s: Session)
	if sessions[s.actor.id] ~= s then
		return
	end
	s.data.rep += 1
	if s.data.rep > #ROUTES then
		finish(s, "INTERCEPTION DRILL", {
			string.format("Score: %d", s.data.score),
			string.format(
				"Interceptions %d  Blocks %d  Completions allowed %d",
				s.data.ints,
				s.data.blocks,
				s.data.allowed
			),
		}, "Interception", s.data.score, false)
		return
	end
	local L = layout.interception
	local thrower = services.PlayerService.get(s.bots[1])
	local receiver = services.PlayerService.get(s.bots[2])
	if not thrower or not receiver then
		return
	end
	place(thrower, L.thrower, L.receiverStart - L.thrower)
	place(receiver, L.receiverStart, Vector3.new(0, 0, 1))
	teleport(s, L.playerStart, Vector3.new(1, 0, 0))
	local d = discFor(s)
	services.DiscService.giveTo(d, thrower.id)
	s.data.route = ROUTES[s.data.rep]
	s.data.leg = 0
	s.data.resolved = false
	hud(
		s,
		string.format("INTERCEPTION  %d/%d", s.data.rep, #ROUTES),
		"The receiver cuts, the thrower leads them. Get the D.",
		{
			progress = (s.data.rep - 1) / #ROUTES,
		}
	)
	task.delay(1.2, function()
		if sessions[s.actor.id] == s then
			s.data.leg = 1
			s.data.routeStart = now()
		end
	end)
	task.delay(1.95, function()
		if sessions[s.actor.id] ~= s or d.mode ~= "Held" or d.holder ~= thrower.id then
			return
		end
		local rroot = services.PlayerService.root(receiver)
		local troot = services.PlayerService.root(thrower)
		if not rroot or not troot then
			return
		end
		local tb = bot(thrower.id)
		local sol = Solver.solve({
			rootPos = troot.Position,
			pivot = services.MovementService.pivotOf(thrower.id),
			step = if tb then tb.sim.step else nil,
			throwType = "Backhand",
			target = rroot.Position + Vector3.new(0, 1, 0),
			targetVel = flat(rroot.AssemblyLinearVelocity),
			groundY = layout.origin.Y,
			coarse = true,
		})
		if sol then
			local pr = root(s)
			if pr then
				local lane = VecMath.closestOnSegment(flat(troot.Position), flat(sol.catchPoint), flat(pr.Position))
				s.data.laneDist = (lane - flat(pr.Position)).Magnitude
			end
			services.ThrowService.throw(thrower.id, sol.params, true)
		end
	end)
end

local function interceptionResolve(s: Session, text: string, pts: number)
	if s.data.resolved then
		return
	end
	s.data.resolved = true
	s.data.score += pts
	local extra = if s.data.laneDist
		then string.format("  (you were %.1f studs from the lane at release)", s.data.laneDist)
		else ""
	send(s, "DrillTick", { text = text .. extra })
	task.delay(1.6, function()
		interceptionRep(s)
	end)
end

DRILLS.Interception = {
	start = function(s: Session)
		s.data.rep = 0
		s.data.score = 0
		s.data.ints = 0
		s.data.blocks = 0
		s.data.allowed = 0
		local function receiverBrain(b: any, _dt: number)
			local route = s.data.route
			local wp = if route and s.data.leg > 0 then route[s.data.leg] else nil
			if not wp then
				services.BotService.setGoal(b, nil)
				return
			end
			local goal = layout.interception.receiverStart + wp
			local first = b.target == nil
			-- each new leg of the route is a real cut (Snap Cut at speed)
			services.BotService.setGoal(b, goal, 23, not first)
			if flat(goal - b.root.Position).Magnitude < 4 then
				s.data.leg += 1
			end
		end
		local function throwerBrain(b: any, _dt: number)
			services.BotService.setGoal(b, nil)
		end
		local t = services.BotService.spawn("N", throwerBrain, "Training")
		local r = services.BotService.spawn("N", receiverBrain, "Training")
		s.bots = { t, r }
		if dropIfStopped(s) then
			return
		end
		task.delay(0.5, function()
			interceptionRep(s)
		end)
	end,
	onCaught = function(s: Session, d: any, info: any)
		if info.id == s.actor.id then
			s.data.ints += 1
			interceptionResolve(s, "INTERCEPTION! +200", 200)
		else
			s.data.allowed += 1
			interceptionResolve(s, "Completed.", 0)
		end
		task.delay(0.5, function()
			if d.mode == "Held" then
				services.DiscService.hide(d)
			end
		end)
	end,
	onTouched = function(s: Session, _d: any, info: any)
		if info.id == s.actor.id and info.kind ~= "Bobble" then
			s.data.blocks += 1
			interceptionResolve(s, "BLOCK! +150", 150)
		end
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		interceptionResolve(s, "Incomplete.", 50)
	end,
}

---------------------------------------------------------------------------
-- Break the Mark
---------------------------------------------------------------------------

local BREAK_REPS = 8
local BREAK_CLOCK = 8 -- seconds to get the throw off (the drill's stall count)
local BREAK_FLIGHT = 7 -- a flight nobody resolves in this long is incomplete
local BREAK_SKILL_FROM, BREAK_SKILL_TO = 0.5, 0.85
local BREAK_POINTS = { complete = 100, breakSide = 150, breakTech = 50 }

local function sideName(lateral: number): string
	return if lateral >= 0 then "forehand" else "backhand"
end

-- The drill's own hand-block test (training discs are not match discs):
-- the first HandBlockCheckTime of the flight against the marker's hand box,
-- with the marker rewound to where the player saw it.
local function markBlock(s: Session, d: any, info: any, pivot: Vector3): (number?, Vector3?)
	local markerId = s.data.marker
	if not markerId or not services.PlayerService.get(markerId) then
		return nil, nil
	end
	local rewind = CatchGeometry.markerRewind(services.MovementService.ping(s.actor.id))
	local pos, facing = services.MovementService.positionAt(markerId, now() - rewind)
	local raw = services.DefenseService.stanceOf(markerId)
	local stance: CatchGeometry.MarkStance = if raw == "High" then "High" elseif raw == "Low" then "Low" else "Relaxed"
	local track = services.MovementService.track(markerId)
	local rise = if track then track.jumpHeight else 0
	local box = CatchGeometry.markBox(pos, facing, pivot, stance, layout.origin.Y, rise)
	local sim = DiscPhysics.copy(info.launch.state)
	while sim.t < DiscConfig.Throw.HandBlockCheckTime do
		DiscPhysics.step(sim, DiscConfig.Physics.Dt, d.wind)
		local p = Vector3.new(sim.px, sim.py, sim.pz)
		if CatchGeometry.inMarkBox(box, p) then
			return sim.t, p
		end
	end
	return nil, nil
end

local breakRep: (s: Session) -> ()

local function breakResult(s: Session, kind: string)
	local D = s.data
	if D.resolved then
		return
	end
	D.resolved = true
	D.phase = "Result"
	local rel = D.release
	local lines: { string } = {}
	local pts = 0
	if kind == "Complete" and rel then
		D.completed += 1
		pts = BREAK_POINTS.complete
		if rel.broke then
			D.breaks += 1
			pts += BREAK_POINTS.breakSide
			table.insert(lines, string.format("BREAK! Past the mark on your %s side.", rel.throwSide))
		else
			table.insert(
				lines,
				string.format(
					"Completed on the open %s side. The mark covered your %s: beat it there next.",
					rel.throwSide,
					rel.markSide
				)
			)
		end
		if rel.breakTech then
			pts += BREAK_POINTS.breakTech
			table.insert(lines, "Fake, swing, release: a Break link.")
		end
		table.insert(lines, string.format("+%d", pts))
	elseif kind == "Blocked" and rel then
		D.blocked += 1
		local open = if rel.markSide == "forehand" then "backhand" else "forehand"
		table.insert(
			lines,
			string.format(
				"BLOCKED on your %s side — the mark was covering it. Your %s side was open.",
				rel.throwSide,
				open
			)
		)
		if rel.step < 0.6 * HD.StepRadius then
			table.insert(lines, "Step out further (WASD): a full step-out reaches past the hands.")
		elseif rel.height ~= "Low" and rel.stance ~= "High" then
			table.insert(lines, "Go Low (hold C) with the step-out, or fake (RIGHT MOUSE) and swing (Q / E) away.")
		else
			table.insert(lines, "Fake first (RIGHT MOUSE): when the mark bites, swing (Q / E) to the other side.")
		end
	elseif kind == "Stalled" then
		table.insert(lines, string.format("STALLED — get the throw off within %d s.", BREAK_CLOCK))
	else
		table.insert(lines, "Past the mark, but nobody caught it: lead your receiver.")
	end
	D.score += pts
	table.insert(D.notes, string.format("Rep %d: %s", D.rep, lines[1]))
	send(s, "DrillTick", { text = table.concat(lines, "  ") })
	task.delay(1.8, function()
		breakRep(s)
	end)
end

breakRep = function(s: Session)
	if sessions[s.actor.id] ~= s then
		return
	end
	local D = s.data
	D.rep += 1
	if D.rep > BREAK_REPS then
		local lines = {
			string.format("Score: %d", D.score),
			string.format(
				"Completed %d / %d  ·  breaks %d  ·  blocked %d",
				D.completed,
				BREAK_REPS,
				D.breaks,
				D.blocked
			),
		}
		for _, n in D.notes do
			table.insert(lines, n)
		end
		if D.breaks == 0 then
			table.insert(
				lines,
				"Next time beat the mark on its side: a full step-out Low (hold C), or fake then swing (Q / E) and release."
			)
		end
		finish(s, "BREAK THE MARK", lines, "BreakMark", D.score, false)
		return
	end
	local rep = D.rep
	local B = layout.breakMark
	local f = VecMath.flatUnit(B.facing)
	local skill = BREAK_SKILL_FROM + (BREAK_SKILL_TO - BREAK_SKILL_FROM) * (rep - 1) / math.max(BREAK_REPS - 1, 1)
	D.force = if rep % 2 == 1 then "FH" else "BH"
	D.phase = "Setup"
	D.resolved = false
	D.release = nil
	D.breakTech = false
	local d = discFor(s)
	if d.mode ~= "None" then
		services.DiscService.hide(d)
	end
	local marker = bot(D.marker)
	if marker then
		services.BotService.setSkill(marker, skill)
		services.BotService.unmark(marker)
	end
	teleport(s, standingAt(s.actor.id, B.mark), f)
	local mActor = services.PlayerService.get(D.marker)
	if mActor then
		place(mActor, standingAt(D.marker, B.mark + f * DiscConfig.Mark.MarkDistance), -f)
	end
	for i, id in D.receivers do
		local a = services.PlayerService.get(id)
		if a then
			place(a, standingAt(id, B.receivers[i]), -f)
		end
	end
	local closed = if D.force == "FH" then "BACKHAND" else "FOREHAND"
	local text = string.format(
		"The mark forces %s: your %s side is covered. Complete a pass past it — step out (WASD), go Low (hold C), or fake (RIGHT MOUSE) + swing (Q / E).",
		if D.force == "FH" then "FOREHAND" else "BACKHAND",
		closed
	)
	hud(s, string.format("BREAK THE MARK  %d/%d", rep, BREAK_REPS), text, {
		progress = (rep - 1) / BREAK_REPS,
	})
	task.delay(0.6, function()
		if sessions[s.actor.id] ~= s or D.rep ~= rep then
			return
		end
		services.DiscService.giveTo(d, s.actor.id)
		services.MovementService.setPivot(s.actor.id, standingAt(s.actor.id, B.mark))
		D.phase = "Hold"
		D.holdStart = now()
		hud(s, string.format("BREAK THE MARK  %d/%d", rep, BREAK_REPS), text, {
			progress = (rep - 1) / BREAK_REPS,
			timerStart = D.holdStart,
		})
	end)
end

DRILLS.BreakMark = {
	start = function(s: Session)
		local D = s.data
		D.rep = 0
		D.score = 0
		D.completed = 0
		D.breaks = 0
		D.blocked = 0
		D.notes = {}
		D.phase = "Setup"
		D.force = "FH"
		D.resolved = true
		local function markerBrain(b: any, _dt: number)
			if D.phase == "Setup" or D.phase == "Hold" or D.phase == "Flight" then
				services.BotService.mark(b, s.actor.id, layout.breakMark.facing, D.force)
			else
				services.BotService.stand(b)
			end
		end
		local function receiverBrain(b: any, _dt: number)
			-- (bot models load one by one: D.receivers is set once all exist)
			local i = table.find(D.receivers or {}, b.id) or 1
			local d = s.disc
			if D.phase == "Flight" and d and d.mode == "Flight" and services.BotService.chase(b, d) then
				return
			end
			-- show open: drift around the pad
			local t = now()
			local home = layout.breakMark.receivers[i]
			local drift = Vector3.new(math.sin(t * 1.3 + i * 2) * 3, 0, math.cos(t * 0.9 + i) * 2)
			services.BotService.setGoal(b, home + drift, MovementConfig.JogSpeed * 0.6)
		end
		local m = services.BotService.spawn("N", markerBrain, "Training")
		local r1 = services.BotService.spawn("N", receiverBrain, "Training")
		local r2 = services.BotService.spawn("N", receiverBrain, "Training")
		s.bots = { m, r1, r2 }
		D.marker = m
		D.receivers = { r1, r2 }
		if dropIfStopped(s) then
			return
		end
		hud(s, "BREAK THE MARK", "Get ready: the mark sets up in front of your pivot.", { progress = 0 })
		task.delay(0.5, function()
			breakRep(s)
		end)
	end,
	canClaim = function(s: Session, id: number): boolean
		-- only the receivers catch; a throw into the marker is resolved as a block
		return table.find(s.data.receivers or {}, id) ~= nil
	end,
	step = function(s: Session)
		local D = s.data
		if D.phase == "Hold" and now() - D.holdStart > BREAK_CLOCK then
			if s.disc then
				services.DiscService.hide(s.disc)
			end
			breakResult(s, "Stalled")
		elseif D.phase == "Flight" and now() - D.flightAt > BREAK_FLIGHT then
			breakResult(s, "Incomplete")
		end
	end,
	onTech = function(s: Session, tech: string, _quality: string, _info: string?)
		local D = s.data
		if tech == "Break" and (D.phase == "Hold" or D.phase == "Flight") then
			D.breakTech = true
			if D.release then
				D.release.breakTech = true
			end
		end
	end,
	onThrown = function(s: Session, d: any, info: any)
		local D = s.data
		if D.phase ~= "Hold" or info.id ~= s.actor.id then
			return
		end
		D.phase = "Flight"
		D.flightAt = now()
		local p = info.params
		local _, right = ThrowModel.basis(p.yaw)
		local mirror = if p.leftHanded then -1 else 1
		local pivot = p.pivot or services.MovementService.pivotOf(s.actor.id) or info.pos
		local releaseLat = (info.launch.releasePos - pivot):Dot(right) * mirror
		local mActor = services.PlayerService.get(D.marker)
		local mroot = if mActor then services.PlayerService.root(mActor) else nil
		local markLat = if mroot then (mroot.Position - pivot):Dot(right) * mirror else -releaseLat
		D.release = {
			throwSide = sideName(releaseLat),
			markSide = sideName(markLat),
			broke = (releaseLat >= 0) == (markLat >= 0),
			breakTech = D.breakTech == true,
			step = flat(p.step or Vector3.zero).Magnitude,
			height = p.height,
			stance = services.DefenseService.stanceOf(D.marker),
		}
		local bt, bp = markBlock(s, d, info, pivot)
		if bt and bp then
			-- deflect the disc at the hands, when it gets there
			local contactT = (d.launchTime :: number) + bt
			local at = DiscPhysics.copy(info.launch.state)
			DiscPhysics.advanceTo(at, bt, d.wind, layout.origin.Y - 100)
			local discVel = DiscPhysics.velocity(at)
			local flightId = d.flightId
			local markerId = D.marker
			local C = DiscConfig.Catch
			task.delay(math.max(0, contactT - now()), function()
				if d.mode ~= "Flight" or d.flightId ~= flightId then
					return
				end
				local away = flat(bp - pivot)
				local push = if away.Magnitude > 0.1 then away.Unit * 3 else Vector3.zero
				local newVel = discVel * C.BlockCarry + Vector3.new(0, C.BlockDown, 0) + push
				services.DiscService.deflect(d, bp, newVel, nil, nil, contactT, markerId)
				Net.event("Effect"):FireAllClients("HandBlock", bp, markerId, "Clean", "Mark")
			end)
			breakResult(s, "Blocked")
		end
	end,
	onCaught = function(s: Session, d: any, info: any)
		local D = s.data
		if D.phase == "Flight" and table.find(D.receivers or {}, info.id) then
			breakResult(s, "Complete")
		end
		task.delay(0.5, function()
			if sessions[s.actor.id] == s and d.mode == "Held" and d.holder ~= s.actor.id then
				services.DiscService.hide(d)
			end
		end)
	end,
	onGrounded = function(s: Session, d: any, land: Vector3)
		services.DiscService.placeOnGround(d, land)
		if s.data.phase == "Flight" then
			breakResult(s, "Incomplete")
		end
	end,
}

---------------------------------------------------------------------------
-- Combo lab
---------------------------------------------------------------------------

local CHALLENGES = {
	{
		name = "Sold!",
		hint = "Jab (Q, no steer), then hold A or D and Q again",
		seq = { { tech = "FakeCommit" }, { tech = "SnapCut", info = "Sold" } },
	},
	{
		name = "Plant and Go",
		hint = "Plant (Q, no direction), then a PERFECT restart (Q / F / SPACE as you stop)",
		seq = { { tech = "MomentumCancel" }, { tech = "SnapCut", info = "Restart", quality = "Perfect" } },
	},
	{
		name = "Cut-Burst",
		hint = string.format(
			"Snap Cut, then Burst (F) within %.2f s (Perfect)",
			MovementConfig.BurstStep.CutChainWindow
		),
		seq = { { tech = "SnapCut" }, { tech = "BurstStep", quality = "Perfect" } },
	},
	{
		name = "Stick the Landing",
		hint = "Jump, Air Redirect (Q), Precision Landing (C)",
		seq = { { tech = "Jump" }, { tech = "AirRedirect" }, { tech = "PrecisionLanding" } },
	},
	{
		name = "Slide Cut",
		hint = "Slide (C), then cut out of it (Q)",
		seq = { { tech = "Slide" }, { tech = "SlideCut" } },
	},
	{
		name = "Get Up!",
		hint = "Dive (E), then pop up (SPACE / Q / F)",
		seq = { { tech = "Dive" }, { tech = "RecoveryChain" } },
	},
	{
		name = "Off the Wall",
		hint = "Wall Rebound (SPACE beside a pink wall in the air), then Air Redirect",
		seq = { { tech = "WallRebound" }, { tech = "AirRedirect" } },
	},
	{
		name = "Full Send",
		hint = "Snap Cut, Burst Step, Layout",
		seq = { { tech = "SnapCut" }, { tech = "BurstStep" }, { tech = "Dive" } },
	},
}

local function comboStatus(s: Session)
	local lines = {}
	local done = 0
	for i, c in CHALLENGES do
		local ok = s.data.done[i] == true
		if ok then
			done += 1
		end
		table.insert(lines, (if ok then "[x] " else "[ ] ") .. c.name .. " — " .. c.hint)
	end
	hud(
		s,
		string.format("COMBO LAB  %d/%d", done, #CHALLENGES),
		table.concat(lines, "\n"),
		{ progress = done / #CHALLENGES, list = true }
	)
	return done
end

local function matches(recent: { any }, seq: { any }): boolean
	local n = #seq
	if #recent < n then
		return false
	end
	-- the last n techniques must match in order, each within the chain window
	for k = 1, n do
		local e = recent[#recent - n + k]
		local want = seq[k]
		if e.tech ~= want.tech then
			return false
		end
		if want.info and e.info ~= want.info then
			return false
		end
		if want.quality and e.quality ~= want.quality then
			return false
		end
		if k > 1 and e.t - recent[#recent - n + k - 1].t > MovementConfig.ChainWindow + 0.2 then
			return false
		end
	end
	return true
end

DRILLS.Combo = {
	start = function(s: Session)
		local st = layout.stations.Combo
		teleport(s, st.start, st.facing)
		s.data.done = {}
		s.data.recent = {}
		comboStatus(s)
	end,
	onTech = function(s: Session, tech: string, quality: string, info: string?)
		table.insert(s.data.recent, { tech = tech, quality = quality, info = info, t = now() })
		while #s.data.recent > 8 do
			table.remove(s.data.recent, 1)
		end
		for i, c in CHALLENGES do
			if not s.data.done[i] and matches(s.data.recent, c.seq) then
				s.data.done[i] = true
				send(s, "DrillTick", { text = "Challenge complete: " .. c.name })
				if comboStatus(s) >= #CHALLENGES then
					finish(
						s,
						"COMBO LAB COMPLETE",
						{ "Every chain landed. Now do it with a disc in the air." },
						"Combo",
						1,
						false
					)
				end
			end
		end
	end,
}

---------------------------------------------------------------------------
-- session lifecycle
---------------------------------------------------------------------------

function stopDrill(actor: any)
	local s = sessions[actor.id]
	if not s then
		return
	end
	sessions[actor.id] = nil
	s.ended = true
	for _, id in s.bots do
		services.BotService.remove(id)
	end
	if s.disc then
		services.DiscService.destroy(s.disc)
		s.disc = nil
	end
	send(s, "DrillHud", { drill = "", title = "", text = "", clear = true })
end

TrainingService.stopDrill = stopDrill

function TrainingService.startDrill(actor: any, drill: string)
	if not DRILLS[drill] then
		return
	end
	TrainingService.stopDrill(actor)
	local s: Session = {
		actor = actor,
		player = actor.player,
		drill = drill,
		phase = "Running",
		t0 = now(),
		data = {},
		disc = nil,
		bots = {},
		ended = false,
	}
	sessions[actor.id] = s
	DRILLS[drill].start(s)
end

function TrainingService.enter(actor: any)
	if actor.role ~= "Training" then
		services.TeamService.setTraining(actor, true)
	end
	services.PlayerService.setFrozen(actor, false)
	services.PlayerService.setLine(actor, nil, nil)
	services.PlayerService.teleport(actor, layout.entry, { face = true })
end

function TrainingService.leave(actor: any)
	TrainingService.stopDrill(actor)
	if actor.role == "Training" then
		services.PlayerService.setTeam(actor, "N", "Spectate")
		services.MatchService.onLeftTraining(actor)
	end
end

function TrainingService.respawned(actor: any)
	TrainingService.stopDrill(actor)
	services.PlayerService.teleport(actor, layout.entry, { face = true })
end

function TrainingService.action(player: Player, kind: string, payload: any)
	local actor = services.PlayerService.fromPlayer(player)
	if not actor then
		return
	end
	if kind == "EnterTraining" then
		TrainingService.enter(actor)
	elseif kind == "LeaveTraining" then
		TrainingService.leave(actor)
	elseif kind == "CancelDrill" then
		TrainingService.stopDrill(actor)
	elseif kind == "StartDrill" and type(payload) == "string" and DRILLS[payload] then
		if actor.role ~= "Training" then
			TrainingService.enter(actor)
		end
		TrainingService.startDrill(actor, payload)
	elseif kind == "LaunchCustom" then
		local s = sessions[actor.id]
		if s and s.drill == "Launcher" then
			DRILLS.Launcher.launch(s, payload)
		end
	end
end

function TrainingService.layout(): TrainingBuilder.Layout
	return layout
end

function TrainingService.Init(s: any)
	services = s
	layout = TrainingBuilder.build(ArenasConfig.TrainingOrigin, workspace)
end

function TrainingService.Start()
	for id, prompt in layout.prompts do
		prompt.Triggered:Connect(function(player)
			local actor = services.PlayerService.fromPlayer(player)
			if not actor then
				return
			end
			if actor.role ~= "Training" then
				services.TeamService.setTraining(actor, true)
			end
			TrainingService.startDrill(actor, id)
		end)
	end
	services.MovementService.TechAccepted:Connect(function(actorId, tech, quality, info)
		local s = sessions[actorId]
		if s then
			local drill = DRILLS[s.drill]
			if drill and drill.onTech then
				drill.onTech(s, tech, quality, info)
			end
		end
	end)
	services.PlayerService.ActorRemoving:Connect(function(actor)
		if sessions[actor.id] then
			TrainingService.stopDrill(actor)
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		for _, s in sessions do
			local drill = DRILLS[s.drill]
			if drill and drill.step and not s.ended then
				local ok, err = pcall(drill.step, s, dt)
				if not ok then
					warn("[TrainingService] " .. tostring(err))
				end
			end
		end
	end)
	Net.state():SetAttribute("TrainingOrigin", ArenasConfig.TrainingOrigin)
end

return TrainingService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="57">
