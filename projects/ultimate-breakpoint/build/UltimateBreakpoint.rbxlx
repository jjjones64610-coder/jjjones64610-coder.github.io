        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- AUDIO CUES
-- Built-in engine sounds (rbxasset://) are used so the place works out of the
-- box. Swap any SoundId for your own uploaded audio (rbxassetid://...) to get
-- custom crowd beds, whistles and commentary stingers. Empty ids are skipped.

local Audio = {}

Audio.Cues = {
	Throw = { id = "rbxasset://sounds/swoosh.wav", volume = 0.5, pitch = 1.1 },
	PerfectRelease = { id = "rbxasset://sounds/swoosh.wav", volume = 0.7, pitch = 1.35 },
	Catch = { id = "rbxasset://sounds/clickfast.wav", volume = 0.7, pitch = 0.8 },
	CleanCatch = { id = "rbxasset://sounds/clickfast.wav", volume = 0.9, pitch = 0.65 },
	Layout = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.9, pitch = 0.85 },
	Block = { id = "rbxasset://sounds/snap.mp3", volume = 0.9, pitch = 0.9 },
	Bobble = { id = "rbxasset://sounds/snap.mp3", volume = 0.6, pitch = 1.4 },
	Turnover = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 0.6 },
	Goal = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.9, pitch = 1.2 },
	Stall = { id = "rbxasset://sounds/button.wav", volume = 0.25, pitch = 1.0 },
	StallOut = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, pitch = 0.5 },
	Whistle = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1.6 },
	Tech = { id = "rbxasset://sounds/swoosh.wav", volume = 0.25, pitch = 1.6 },
	TechPerfect = { id = "rbxasset://sounds/swoosh.wav", volume = 0.35, pitch = 1.9 },
	Burst = { id = "rbxasset://sounds/swoosh.wav", volume = 0.45, pitch = 0.75 },
	Land = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.35, pitch = 1.0 },
	PrecisionLand = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.5, pitch = 1.4 },
	Rebound = { id = "rbxasset://sounds/snap.mp3", volume = 0.5, pitch = 1.2 },
	UiClick = { id = "rbxasset://sounds/button.wav", volume = 0.4, pitch = 1.0 },
	Highlight = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1.45 },
	-- Supply your own looping crowd ambience and cheer to enable these.
	CrowdLoop = { id = "", volume = 0.35, pitch = 1.0, looped = true },
	CrowdCheer = { id = "", volume = 0.7, pitch = 1.0 },
}

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Disc</string>
            <string name="Source"><![CDATA[--!strict
-- DISC + THROW + CATCH TUNING
-- Scale: 1 metre ~= 3 studs (a 5.3-stud avatar is ~1.77 m). The flight model
-- uses real-world frisbee coefficients (Hummel 2003) converted to studs, then
-- lightly tuned so throws read clearly on a Roblox field. See docs/DESIGN.md.

local Disc = {
	Physics = {
		Dt = 1 / 120, -- fixed simulation step, identical on client and server
		Gravity = 29.4, -- studs/s^2 (9.81 m/s^2 * 3)
		AirK = 0.0665, -- 0.5 * rho * area / mass, per stud
		CL0 = 0.15,
		CLa = 1.4, -- per radian
		StallAlpha = 0.45, -- radians; lift collapses beyond this
		CD0 = 0.08,
		CDa = 2.72,
		CDMax = 1.2,
		Alpha0 = -0.0698, -- -4 degrees
		CM0 = -0.01, -- pitching moment at zero angle of attack (nose down => "turn")
		CMa = 1.0, -- grows with angle of attack (nose up => "fade")
		RollK = 0.07, -- gyroscopic precession gain (tuned, see tests/disc_spec)
		SpinDecay = 0.04, -- per second
		MinSpin = 8,
		Radius = 1.1, -- visual/catch radius in studs (~0.27 m disc)
		GroundContact = 0.14, -- disc centre height that counts as touching the ground
		MaxFlightTime = 9,
		HistorySeconds = 0.6, -- server keeps this much flight history for lag compensation
	},

	Throw = {
		SpinBase = 50, -- rad/s (~8 rev/s)
		ChargeTime = 0.55, -- seconds of holding to reach full power
		PerfectWindow = 0.10, -- release within [ChargeTime, ChargeTime + PerfectWindow] = Perfect
		OverchargeDecay = 0.8, -- spin factor lost per second held beyond the window
		MinOverSpin = 0.6,
		PerfectSpeedMult = 1.05,
		PerfectSpinMult = 1.15,
		OffBalancePowerCap = 0.75,
		OffBalanceSpin = 0.8,
		GroundThrowPowerCap = 0.6,
		MovingSpinPenaltySpeed = 12, -- throwing while still moving faster than this costs spin
		MovingSpinPenalty = 0.85,
		ThrowerVelocityCarry = 0.45,
		MinSpeed = 28,
		MaxSpeed = 78,
		PowerCurve = 0.85,
		BankRange = 35, -- degrees of player-controlled bank either side
		BankSteps = 7, -- discrete bank positions for keyboard/gamepad (-3..3)
		FakeCooldown = 0.3,
		FakeDuration = 0.22,
		MinPitch = -12,
		MaxPitch = 60,
		QuickReleaseWindow = 0.6, -- release within this long after a catch = Quick Release
		HandBlockCheckTime = 0.3, -- seconds of early flight checked against markers' hands
		NoCatchTime = 0.15, -- nobody can catch in the first moments (hand blocks cover that)
	},

	-- Per-throw definition. side/height are release offsets from the root part
	-- (right-handed thrower; mirrored for left-handed). bank/alpha/pitch are
	-- degrees. spin is the sign of rotation about the disc's top-face normal.
	Types = {
		Backhand = {
			Display = "Backhand",
			Short = "BH",
			Order = 1,
			SpeedMult = 1.0,
			Spin = -1,
			Bank = 0,
			Alpha = 6,
			PitchOffset = 4,
			Side = -0.6,
			LowSide = -2.2,
			ChargeMult = 1.0,
			Description = "Reliable baseline. Fades left (right-handed).",
		},
		Forehand = {
			Display = "Forehand",
			Short = "FH",
			Order = 2,
			SpeedMult = 0.95,
			Spin = 1,
			Bank = 0,
			Alpha = 6,
			PitchOffset = 3,
			Side = 1.4,
			LowSide = 2.4,
			ChargeMult = 1.2, -- quicker release
			Description = "Fast flick release from the other side. Fades right.",
		},
		Hammer = {
			Display = "Hammer",
			Short = "HAM",
			Order = 3,
			SpeedMult = 0.85,
			Spin = 1,
			Bank = -100,
			Alpha = 6,
			PitchOffset = 30,
			Side = 0.8,
			LowSide = 0.8,
			Overhead = true,
			ChargeMult = 1.0,
			Description = "Overhead. Inverts mid-flight and drops steeply over defenders.",
		},
		Scoober = {
			Display = "Scoober",
			Short = "SCB",
			Order = 4,
			SpeedMult = 0.6,
			Spin = -1,
			Bank = 100,
			Alpha = 6,
			PitchOffset = 22,
			Side = -0.4,
			LowSide = -0.4,
			Overhead = true,
			ChargeMult = 1.3,
			Description = "Short upside-down flip over a close mark. Breaks right.",
		},
		Blade = {
			Display = "Blade",
			Short = "BLD",
			Order = 5,
			SpeedMult = 0.95,
			Spin = -1,
			Bank = -55,
			Alpha = -4,
			PitchOffset = 6,
			Side = -0.6,
			LowSide = -2.2,
			ChargeMult = 1.0,
			Description = "Steep edge, fast dive. Short hang time: hard to intercept.",
		},
	},

	TypeOrder = { "Backhand", "Forehand", "Hammer", "Scoober", "Blade" },

	-- Release heights relative to the root part centre.
	Heights = {
		High = 2.6,
		Mid = 0.5,
		Low = -1.6,
	},
	OverheadHeight = 2.6,

	-- Catch geometry (studs, relative to the root part centre).
	Catch = {
		ChestHeight = 1.0,
		SecureRadius = 2.4, -- passive catch zone around the chest
		CleanFraction = 0.6, -- inside this fraction of a zone radius = clean catch
		ReachLength = 3.6,
		ReachRadius = 1.15,
		ReachWindow = 0.28,
		ReachCooldown = 0.4,
		DiveLength = 5.2,
		DiveRadius = 1.4,
		SlideDrop = 1.4, -- slide lowers the secure zone this much
		ShoulderHeight = 1.5,
		ShoulderWidth = 1.0,
		BobbleSpeed = 70, -- fingertip catch of a disc faster than this bobbles
		ContestWindow = 0.06, -- claims this close in time are contested
		ResolveDelay = 0.1, -- server waits this long to collect competing claims
		MaxRewind = 0.3, -- max seconds a claim can be backdated (lag compensation)
		BaseSlack = 1.0, -- positional tolerance for claims (studs)
		PingSlackPerSecond = 26, -- extra tolerance per second of ping (≈ sprint speed)
		MaxSlack = 3.5,
		PickupRadius = 3.5,
		BobbleUp = 16,
		BobbleCarry = 0.25,
		BlockCarry = 0.18,
		BlockDown = -6,
	},

	-- Marker hand zones (for hand blocks on release).
	Mark = {
		StallRange = 9, -- studs: ~10 ft
		DiscSpace = 2.6, -- defenders closer than this to the thrower trigger a disc-space call
		LowY = { 0.6, 4.4 }, -- above the ground: low/wide stance, knees to chest
		HighY = { 4.6, 8.6 }, -- hands up: shoulders to well above the head
		LowHalfWidth = 3.2,
		HighHalfWidth = 2.6,
		JumpBonus = 5,
		DepthMin = -1.0,
		DepthMax = 2.2,
		RelaxedRadius = 1.8, -- hands-down marker: small zone at the chest
	},
}

return Disc
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!strict
-- DEFAULT BINDINGS
-- One small vocabulary. Advanced techniques come from pressing these in
-- context and on time (see MovementSim header), not from extra keys.
--   Movement actions: Sprint, Jump, Cut, Slide, Dive, Burst
--   Disc actions:     Primary (throw / reach), Secondary (fake / mark stance)
--   With the disc:    Q/E bank, 1-5 throw type, C = low release, Space = hop (high release)
-- Players can rebind everything in Settings > Controls; choices are saved.

local Input = {}

Input.Actions = {
	"Sprint",
	"Jump",
	"Cut",
	"Slide",
	"Dive",
	"Burst",
	"Primary",
	"Secondary",
	"BankLeft",
	"BankRight",
	"TypeNext",
	"TypePrev",
	"Type1",
	"Type2",
	"Type3",
	"Type4",
	"Type5",
	"LeadLock",
	"Celebrate",
	"Menu",
	"CameraLock",
}

Input.Display = {
	Sprint = "Sprint",
	Jump = "Jump / Hop",
	Cut = "Cut (Snap / Cancel / Fake / Air Redirect)",
	Slide = "Slide / Precision Landing / Low Release",
	Dive = "Dive (Layout)",
	Burst = "Burst Step",
	Primary = "Throw (hold) / Reach",
	Secondary = "Fake Throw / Mark Stance",
	BankLeft = "Bank Left (with disc)",
	BankRight = "Bank Right (with disc)",
	TypeNext = "Next Throw Type",
	TypePrev = "Previous Throw Type",
	Type1 = "Backhand",
	Type2 = "Forehand",
	Type3 = "Hammer",
	Type4 = "Scoober",
	Type5 = "Blade",
	LeadLock = "Lead Pass Assist",
	Celebrate = "Celebrate",
	Menu = "Menu",
	CameraLock = "Toggle Mouse Lock",
}

-- Values are Enum.KeyCode / Enum.UserInputType names so they can be saved.
Input.Keyboard = {
	Sprint = { "LeftShift" },
	Jump = { "Space" },
	Cut = { "Q" },
	Slide = { "LeftControl", "C" },
	Dive = { "E" },
	Burst = { "F" },
	Primary = { "MouseButton1" },
	Secondary = { "MouseButton2" },
	BankLeft = { "Q" },
	BankRight = { "E" },
	TypeNext = { "X" },
	TypePrev = { "Z" },
	Type1 = { "One" },
	Type2 = { "Two" },
	Type3 = { "Three" },
	Type4 = { "Four" },
	Type5 = { "Five" },
	LeadLock = { "R" },
	Celebrate = { "B" },
	Menu = { "M" },
	CameraLock = { "LeftAlt" },
} :: { [string]: { string } }

Input.Gamepad = {
	Sprint = { "ButtonL1" },
	Jump = { "ButtonA" },
	Cut = { "ButtonX" },
	Slide = { "ButtonB" },
	Dive = { "ButtonY" },
	Burst = { "ButtonR1" },
	Primary = { "ButtonR2" },
	Secondary = { "ButtonL2" },
	BankLeft = { "DPadLeft" },
	BankRight = { "DPadRight" },
	TypeNext = { "DPadUp" },
	TypePrev = { "DPadDown" },
	LeadLock = { "ButtonR3" },
	Celebrate = { "DPadDown" },
	Menu = { "ButtonSelect" },
} :: { [string]: { string } }

Input.DefaultSettings = {
	MouseSensitivity = 1.0,
	GamepadSensitivity = 1.0,
	TouchSensitivity = 1.0,
	InvertY = false,
	FieldOfView = 72,
	CameraShake = true,
	ShowComboFeed = true,
	ShowTechLabels = true,
	ToggleSprint = false,
	AutoSprintTouch = true,
	LeftHanded = false,
	TrajectoryPreview = true,
	TouchButtonScale = 1.0,
	MasterVolume = 0.8,
	SfxVolume = 1.0,
	CrowdVolume = 0.7,
}

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Modes</string>
            <string name="Source"><![CDATA[--!strict
-- MATCH RULE PRESETS
-- Private servers start from Casual and may edit any field marked Editable.

local Modes = {}

Modes.Fields = {
	Standard = { width = 100, length = 190, endZone = 40, brick = 40 },
	Small = { width = 76, length = 124, endZone = 28, brick = 26 },
}

export type ModeRules = {
	id: string,
	Display: string,
	Description: string,
	PointsToWin: number,
	TimeCap: number, -- seconds; when reached the current point finishes
	StallMax: number,
	StallInterval: number,
	UsePull: boolean,
	Field: string,
	BotsFillTo: number, -- per team (0 = no bots)
	TeamSize: number,
	PreviewFraction: number, -- how much of the throw arc the thrower sees (0..1)
	LandingShadow: boolean, -- show the disc's ground shadow
	Ranked: boolean,
	SpecialArenas: boolean,
	StartUniverse: boolean,
	PointSetupTime: number,
	PullTimeout: number,
	CelebrationTime: number,
	Selectable: boolean,
}

local function mode(t: ModeRules): ModeRules
	return t
end

Modes.List = {
	Casual = mode({
		id = "Casual",
		Display = "Casual",
		Description = "Full field, first to 5, bots fill empty spots.",
		PointsToWin = 5,
		TimeCap = 480,
		StallMax = 10,
		StallInterval = 1.0,
		UsePull = true,
		Field = "Standard",
		BotsFillTo = 3,
		TeamSize = 7,
		PreviewFraction = 0.5,
		LandingShadow = true,
		Ranked = false,
		SpecialArenas = true,
		StartUniverse = false,
		PointSetupTime = 4,
		PullTimeout = 10,
		CelebrationTime = 4,
		Selectable = true,
	}),
	Ranked = mode({
		id = "Ranked",
		Display = "Ranked",
		Description = "First to 7, no bots, short throw preview, rating on the line.",
		PointsToWin = 7,
		TimeCap = 720,
		StallMax = 10,
		StallInterval = 1.0,
		UsePull = true,
		Field = "Standard",
		BotsFillTo = 0,
		TeamSize = 7,
		PreviewFraction = 0.2,
		LandingShadow = true,
		Ranked = true,
		SpecialArenas = false,
		StartUniverse = false,
		PointSetupTime = 4,
		PullTimeout = 10,
		CelebrationTime = 3.5,
		Selectable = true,
	}),
	Rush = mode({
		id = "Rush",
		Display = "Rush",
		Description = "Small field, 7-count stall, no pulls, 5 minutes.",
		PointsToWin = 5,
		TimeCap = 300,
		StallMax = 7,
		StallInterval = 0.9,
		UsePull = false,
		Field = "Small",
		BotsFillTo = 2,
		TeamSize = 5,
		PreviewFraction = 0.5,
		LandingShadow = true,
		Ranked = false,
		SpecialArenas = true,
		StartUniverse = false,
		PointSetupTime = 3,
		PullTimeout = 8,
		CelebrationTime = 3,
		Selectable = true,
	}),
	Clutch = mode({
		id = "Clutch",
		Display = "Clutch Point",
		Description = "One point. Universe from the start. 90 seconds.",
		PointsToWin = 1,
		TimeCap = 90,
		StallMax = 8,
		StallInterval = 1.0,
		UsePull = false,
		Field = "Small",
		BotsFillTo = 2,
		TeamSize = 5,
		PreviewFraction = 0.35,
		LandingShadow = true,
		Ranked = false,
		SpecialArenas = true,
		StartUniverse = true,
		PointSetupTime = 4,
		PullTimeout = 8,
		CelebrationTime = 5,
		Selectable = true,
	}),
}

Modes.Order = { "Casual", "Rush", "Clutch", "Ranked" }

-- Keys a private-server host can change, with legal ranges.
Modes.Editable = {
	PointsToWin = { min = 1, max = 15, step = 1 },
	TimeCap = { min = 60, max = 1800, step = 30 },
	StallMax = { min = 5, max = 10, step = 1 },
	StallInterval = { min = 0.7, max = 1.2, step = 0.1 },
	UsePull = { bool = true },
	BotsFillTo = { min = 0, max = 7, step = 1 },
	PreviewFraction = { min = 0, max = 1, step = 0.1 },
	LandingShadow = { bool = true },
	Field = { options = { "Standard", "Small" } },
}

function Modes.copy(id: string): ModeRules
	local base = (Modes.List :: any)[id] or Modes.List.Casual
	return table.clone(base)
end

return Modes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- MOVEMENT TUNING
-- Every number that shapes how a player moves lives here. Units are studs and
-- seconds. See docs/DESIGN.md ("Movement model") for the reasoning behind each
-- value and the intended counterplay of every technique.

local Movement = {
	-- Locomotion -----------------------------------------------------------
	JogSpeed = 17,
	SprintSpeed = 26,
	ExhaustedSprintSpeed = 21, -- sprint top speed while exertion is empty
	HardCap = 34, -- absolute horizontal speed limit, enforced client + server
	Gravity = 160, -- workspace gravity for characters (the disc uses its own, see Config/Disc)

	Accel = 58, -- speeding up along the current direction
	AccelFromRest = 95, -- isotropic acceleration below RestSpeed (fast starts)
	RestSpeed = 7,
	Brake = 80, -- input opposes motion
	Coast = 50, -- no input
	LateralAccel = 92, -- max sideways acceleration => sprint turn radius ~7.3 studs
	OverspeedDecay = 38, -- bleeds speed above the current top speed (after bursts)

	AirAccel = 20,
	AirMinControlSpeed = 10,
	AirGainAllowance = 3, -- air control can never add more than this over takeoff speed

	JumpVelocity = 44,
	JumpSpeedBonus = 5, -- extra jump velocity at full sprint (momentum-sensitive jump)
	CoyoteTime = 0.1,

	LandingRecovery = 0.12,
	LandingSteer = 0.35,
	LandingRetention = 0.88,

	-- Exertion -------------------------------------------------------------
	ExertionMax = 100,
	ExertionRegen = 20, -- per second, when not sprinting
	ExertionRegenDelay = 0.6,
	SprintDrain = 4.5, -- per second while sprinting above jog speed

	ChainWindow = 1.0, -- techniques within this gap count as one combo chain
	CommitAngle = 12, -- running line considered "the same line" within this many degrees

	Quality = {
		Perfect = "Perfect",
		Clean = "Clean",
		Sloppy = "Sloppy",
		Gassed = "Gassed",
	},

	-- Techniques -----------------------------------------------------------
	SnapCut = {
		Cost = 10,
		MinInterval = 0.2,
		MinSpeed = 9,
		MinAngle = 25,
		MaxAngle = 115,
		CommitClean = 0.32, -- seconds on one line before a cut is "clean"
		CommitPerfect = 0.6,
		PerfectSpeedFraction = 0.85, -- must also be near full speed for Perfect
		SpamWindow = 0.4, -- a cut this soon after another cut is always Sloppy
		AnglePenalty = 0.15, -- extra retention lost as the cut approaches MaxAngle
		PerfectBoost = 2,
		Retention = { Perfect = 0.96, Clean = 0.86, Sloppy = 0.62, Gassed = 0.55 },
		SoldMinSpeedFraction = 0.8, -- a cut out of a Fake Commit leaves at >= this x sprint
	},

	MomentumCancel = {
		Cost = 10,
		Cooldown = 0.45,
		MinSpeed = 12,
		MinAngle = 115,
		PlantTime = 0.12,
		BrakeDecel = 330,
		WindowOpen = 0.10, -- restart inputs before this are "too early" (lockout)
		PerfectUntil = 0.21,
		WindowClose = 0.32,
		EarlyLockout = 0.15,
		RestartRetention = { Perfect = 0.92, Clean = 0.76 }, -- x SprintSpeed
	},

	FakeCommit = {
		Cost = 6,
		Cooldown = 0.7,
		MaxAngle = 25, -- Cut pressed within this angle of travel (or standing) = jab
		JabTime = 0.14,
		JabSlow = 0.8,
		JabSpeed = 9,
		SoldWindow = 0.45,
		SoldMinAngle = 30,
	},

	BurstStep = {
		Cost = 22,
		Cooldown = 1.6,
		Duration = 0.2,
		SpeedMult = 1.2,
		MinSpeed = 29,
		MaxSpeed = 32.5,
		GassedMult = 1.05,
		CutChainWindow = 0.15,
	},

	Slide = {
		Cost = 8,
		Cooldown = 0.7,
		MinSpeed = 14,
		Boost = 3,
		BoostCeiling = 29, -- slide boost can never push speed past this
		Friction = 13,
		SteerRate = 50, -- degrees per second
		MaxTime = 0.9,
		ExitSpeed = 9,
	},

	SlideCut = {
		Cost = 8,
		MinSlideTime = 0.15,
		PerfectFrom = 0.3,
		PerfectTo = 0.6,
		MaxAngle = 120,
		Retention = { Perfect = 0.94, Clean = 0.84, Gassed = 0.6 },
	},

	Dive = {
		Cost = 18,
		Cooldown = 1.1,
		GroundBonus = 4,
		GroundMin = 24,
		GroundMax = 32,
		GassedMin = 18,
		GassedMax = 24,
		GroundVertical = 20,
		AirBoost = 9,
		AirMax = 31,
		AirVertical = 4,
		MaxVertical = 24,
		ChainWindow = 0.25,
	},

	DiveSlide = {
		Friction = 42,
		StopSpeed = 5,
		MaxTime = 0.8,
	},

	Recover = {
		Time = 0.5,
		Decel = 60,
		PopWindow = 0.2,
		PopPerfect = 0.09,
		EarlyLockout = 0.25,
		Retention = { Perfect = 0.75, Clean = 0.55 }, -- x SprintSpeed
		PopJumpFraction = 0.8,
	},

	RollOut = {
		RecoverTime = 0.16,
		Retention = { Perfect = 0.72, Clean = 0.58 },
	},

	AirRedirect = {
		Cost = 12,
		MaxAngle = 80,
		ApexWindow = 9, -- |vertical velocity| below this = Perfect
		MinVertical = -6, -- redirect briefly arrests a fall to at most this
		MinSpeed = 4,
		StillSpeed = 8, -- redirecting a near-vertical jump gives this much drift
		Retention = { Perfect = 0.92, Clean = 0.82, Gassed = 0.6 },
	},

	PrecisionLanding = {
		EarlyWindow = 0.15,
		PerfectWindow = 0.05,
		LateWindow = 0.06,
		Lockout = 0.3,
		Retention = { Perfect = 1.0, Clean = 0.96 },
	},

	WallRebound = {
		Cost = 10,
		MaxPerAir = 2,
		Retention = 0.9,
		PushOff = 6,
		Vertical = 36,
		PerfectDistance = 1.2,
		DetectDistance = 3,
	},

	Holding = {
		DecelRate = 52,
		DecelMaxTime = 0.65,
		PivotRadius = 3.2,
		PivotSpeed = 10,
		PivotAccel = 120,
		HopVertical = 20,
		StopSpeed = 1.5,
	},

	-- Combo base points per technique (see ComboEvaluator).
	ComboPoints = {
		SnapCut = 100,
		MomentumCancel = 120,
		AirRedirect = 140,
		SlideCut = 120,
		WallRebound = 150,
		PrecisionLanding = 130,
		BurstStep = 90,
		FakeCommit = 110,
		Dive = 160,
		RecoveryChain = 150,
		AerialReach = 120,
		Slide = 60,
		Jump = 0,
	},

	-- Display names for UI / feedback.
	TechNames = {
		SnapCut = "Snap Cut",
		MomentumCancel = "Momentum Cancel",
		AirRedirect = "Air Redirect",
		SlideCut = "Slide Cut",
		WallRebound = "Wall Rebound",
		PrecisionLanding = "Precision Landing",
		BurstStep = "Burst Step",
		FakeCommit = "Fake Commit",
		Dive = "Layout",
		RecoveryChain = "Recovery Chain",
		AerialReach = "Aerial Reach",
		Slide = "Slide",
		Jump = "Jump",
	},
}

-- Techniques the server validates (cost + cooldown mirror). Cooldown 0 means
-- rate-limited only.
Movement.TechCosts = {
	SnapCut = Movement.SnapCut.Cost,
	MomentumCancel = Movement.MomentumCancel.Cost,
	FakeCommit = Movement.FakeCommit.Cost,
	BurstStep = Movement.BurstStep.Cost,
	Slide = Movement.Slide.Cost,
	SlideCut = Movement.SlideCut.Cost,
	Dive = Movement.Dive.Cost,
	AirRedirect = Movement.AirRedirect.Cost,
	WallRebound = Movement.WallRebound.Cost,
	PrecisionLanding = 0,
	RecoveryChain = 0,
	AerialReach = 0,
	Jump = 0,
}

Movement.TechCooldowns = {
	SnapCut = Movement.SnapCut.MinInterval,
	MomentumCancel = Movement.MomentumCancel.Cooldown,
	FakeCommit = Movement.FakeCommit.Cooldown,
	BurstStep = Movement.BurstStep.Cooldown,
	Slide = Movement.Slide.Cooldown,
	SlideCut = 0,
	Dive = Movement.Dive.Cooldown,
	AirRedirect = 0,
	WallRebound = 0,
	PrecisionLanding = 0,
	RecoveryChain = 0,
	AerialReach = 0,
	Jump = 0,
}

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict
-- PROGRESSION, COSMETICS, ACHIEVEMENTS
-- Nothing here changes how a player moves, throws or catches. Every unlock is
-- visual. There are no purchases that affect competition.

local Progression = {}

Progression.XP = {
	MatchPlayed = 100,
	MatchWon = 60,
	Goal = 25,
	Assist = 20,
	Callahan = 80,
	Catch = 4,
	Completion = 3,
	Interception = 20,
	Block = 18,
	Layout = 15,
	Greatest = 60,
	Highlight = 20,
	ComboPerHundred = 1, -- converted combos: 1 XP per 100 combo points
	ComboCap = 60,
	TrainingDrill = 15,
	PersonalBest = 25,
}

function Progression.xpForLevel(level: number): number
	return 300 + 75 * level
end

Progression.MaxLevel = 100

Progression.Divisions = {
	{ name = "Bronze", min = -math.huge, color = Color3.fromRGB(176, 120, 72) },
	{ name = "Silver", min = 900, color = Color3.fromRGB(190, 196, 206) },
	{ name = "Gold", min = 1100, color = Color3.fromRGB(242, 196, 64) },
	{ name = "Platinum", min = 1300, color = Color3.fromRGB(96, 220, 210) },
	{ name = "Diamond", min = 1500, color = Color3.fromRGB(120, 160, 255) },
	{ name = "Breakpoint", min = 1700, color = Color3.fromRGB(255, 92, 160) },
} :: { any }

Progression.Rating = {
	Start = 1000,
	KNew = 40, -- first PlacementGames
	K = 24,
	PlacementGames = 10,
	Season = "S1",
}

-- Disc skins: purely visual (colour, material, rim, stripe).
Progression.DiscSkins = {
	{
		id = "Classic",
		name = "Classic White",
		level = 1,
		color = Color3.fromRGB(245, 245, 240),
		rim = Color3.fromRGB(210, 210, 205),
		stripe = Color3.fromRGB(30, 140, 255),
	},
	{
		id = "Sunset",
		name = "Sunset",
		level = 2,
		color = Color3.fromRGB(255, 140, 60),
		rim = Color3.fromRGB(255, 80, 90),
		stripe = Color3.fromRGB(255, 230, 120),
	},
	{
		id = "Glacier",
		name = "Glacier",
		level = 4,
		color = Color3.fromRGB(170, 230, 255),
		rim = Color3.fromRGB(90, 170, 230),
		stripe = Color3.fromRGB(255, 255, 255),
	},
	{
		id = "Volt",
		name = "Volt",
		level = 6,
		color = Color3.fromRGB(230, 255, 60),
		rim = Color3.fromRGB(40, 40, 40),
		stripe = Color3.fromRGB(40, 40, 40),
		neon = true,
	},
	{
		id = "Ember",
		name = "Ember",
		level = 9,
		color = Color3.fromRGB(60, 20, 20),
		rim = Color3.fromRGB(255, 90, 30),
		stripe = Color3.fromRGB(255, 160, 40),
		neon = true,
	},
	{
		id = "Nebula",
		name = "Nebula",
		level = 13,
		color = Color3.fromRGB(70, 40, 140),
		rim = Color3.fromRGB(255, 120, 220),
		stripe = Color3.fromRGB(120, 230, 255),
		neon = true,
	},
	{
		id = "Gold",
		name = "Gilded",
		level = 20,
		color = Color3.fromRGB(240, 200, 80),
		rim = Color3.fromRGB(190, 140, 40),
		stripe = Color3.fromRGB(255, 250, 220),
	},
	{
		id = "Callahan",
		name = "Callahan Crest",
		achievement = "Callahan",
		color = Color3.fromRGB(20, 20, 30),
		rim = Color3.fromRGB(255, 215, 0),
		stripe = Color3.fromRGB(255, 215, 0),
		neon = true,
	},
	{
		id = "Layout",
		name = "Grass Stain",
		achievement = "LayoutArtist",
		color = Color3.fromRGB(90, 170, 80),
		rim = Color3.fromRGB(60, 120, 50),
		stripe = Color3.fromRGB(240, 240, 230),
	},
} :: { any }

-- Movement trails: thin, translucent, never obscuring the disc.
Progression.Trails = {
	{ id = "None", name = "None", level = 1 },
	{ id = "Wisp", name = "Wisp", level = 3, a = Color3.fromRGB(255, 255, 255), b = Color3.fromRGB(150, 200, 255) },
	{ id = "Heat", name = "Heat", level = 7, a = Color3.fromRGB(255, 200, 60), b = Color3.fromRGB(255, 60, 60) },
	{ id = "Aurora", name = "Aurora", level = 11, a = Color3.fromRGB(80, 255, 180), b = Color3.fromRGB(140, 80, 255) },
	{ id = "Prism", name = "Prism", level = 16, a = Color3.fromRGB(255, 80, 200), b = Color3.fromRGB(80, 220, 255) },
	{
		id = "Breakpoint",
		name = "Breakpoint",
		achievement = "Breakpoint",
		a = Color3.fromRGB(255, 92, 160),
		b = Color3.fromRGB(255, 255, 255),
	},
} :: { any }

Progression.Celebrations = {
	{ id = "Point", name = "Point to the Sky", level = 1 },
	{ id = "Flex", name = "Flex", level = 5 },
	{ id = "Bow", name = "Take a Bow", level = 8 },
	{ id = "Spin", name = "Disc Spin", level = 12 },
	{ id = "Slide", name = "Knee Slide", level = 18 },
} :: { any }

Progression.Banners = {
	{ id = "Slate", name = "Slate", level = 1, color = Color3.fromRGB(40, 44, 56) },
	{ id = "Tide", name = "Tide", level = 3, color = Color3.fromRGB(20, 110, 200) },
	{ id = "Blaze", name = "Blaze", level = 3, color = Color3.fromRGB(230, 100, 30) },
	{ id = "Grass", name = "Field Day", level = 6, color = Color3.fromRGB(50, 140, 70) },
	{ id = "Night", name = "Night Game", level = 10, color = Color3.fromRGB(30, 20, 70) },
	{ id = "Champion", name = "Champion", level = 25, color = Color3.fromRGB(200, 160, 40) },
} :: { any }

Progression.Titles = {
	{ id = "Rookie", name = "Rookie", level = 1 },
	{ id = "Cutter", name = "Cutter", level = 4 },
	{ id = "Handler", name = "Handler", level = 8 },
	{ id = "Veteran", name = "Veteran", level = 15 },
	{ id = "LayoutArtist", name = "Layout Artist", achievement = "LayoutArtist" },
	{ id = "HammerTime", name = "Hammer Time", achievement = "HammerTime" },
	{ id = "Callahan", name = "Callahan Club", achievement = "Callahan" },
	{ id = "Greatest", name = "The Greatest", achievement = "Greatest" },
	{ id = "Lockdown", name = "Lockdown", achievement = "Lockdown" },
	{ id = "Engine", name = "The Engine", achievement = "Engine" },
	{ id = "Breakpoint", name = "Breakpoint", achievement = "Breakpoint" },
	{ id = "Flow", name = "Flow State", achievement = "Flow" },
} :: { any }

Progression.Achievements = {
	{ id = "FirstGoal", name = "On the Board", description = "Score your first goal.", stat = "goals", goal = 1 },
	{
		id = "LayoutArtist",
		name = "Layout Artist",
		description = "Make 25 diving (layout) catches.",
		stat = "layouts",
		goal = 25,
	},
	{
		id = "HammerTime",
		name = "Hammer Time",
		description = "Throw 10 goals with a hammer.",
		stat = "hammerGoals",
		goal = 10,
	},
	{
		id = "Callahan",
		name = "Callahan",
		description = "Intercept a pass in the end zone you defend.",
		stat = "callahans",
		goal = 1,
	},
	{
		id = "Greatest",
		name = "The Greatest",
		description = "Catch in the air past the line and throw before landing.",
		stat = "greatests",
		goal = 1,
	},
	{ id = "Lockdown", name = "Lockdown", description = "Record 50 blocks.", stat = "blocks", goal = 50 },
	{
		id = "Engine",
		name = "The Engine",
		description = "Perform 2,000 movement techniques.",
		stat = "techs",
		goal = 2000,
	},
	{
		id = "Flow",
		name = "Flow State",
		description = "Be part of a 10-pass possession that scores.",
		stat = "flowGoals",
		goal = 1,
	},
	{
		id = "Breakpoint",
		name = "Breakpoint",
		description = "Convert a BREAKPOINT-tier combo.",
		stat = "breakpointCombos",
		goal = 1,
	},
	{
		id = "Huck",
		name = "Huck It",
		description = "Complete 10 throws longer than 120 studs.",
		stat = "hucks",
		goal = 10,
	},
	{
		id = "Perfectionist",
		name = "Perfectionist",
		description = "Land 100 Perfect releases.",
		stat = "perfectReleases",
		goal = 100,
	},
	{
		id = "Student",
		name = "Student of the Game",
		description = "Finish every training drill once.",
		stat = "drillsCompleted",
		goal = 6,
	},
} :: { any }

function Progression.division(rating: number): any
	local current = Progression.Divisions[1]
	for _, d in Progression.Divisions do
		if rating >= d.min then
			current = d
		end
	end
	return current
end

return Progression
]]></string>
          </Properties>
