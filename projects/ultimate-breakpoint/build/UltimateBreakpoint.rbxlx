      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Disc</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DiscPhysics</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DiscPhysics — deterministic flying-disc simulation.

	State is stored as plain numbers (doubles), not Vector3 (float32), so the
	server and every client step the exact same arithmetic from the same launch
	values. Launch values are themselves read back from replicated attributes,
	so all machines start from bit-identical inputs.

	Forces (per unit mass):
	  gravity      (0, -g, 0)
	  lift         K |v|^2 CL(alpha) along the disc normal's component
	               perpendicular to the airflow  -> banking curves the flight
	  drag         K |v|^2 CD(alpha) against the airflow
	Orientation:
	  The spin axis is gyroscopically stable; the aerodynamic pitching moment
	  CM(alpha) makes it precess (roll) at a rate proportional to |v|^2 / spin.
	  CM < 0 at low alpha (fast, flat flight) rolls the disc one way ("turn"),
	  CM > 0 at high alpha (slow, descending) the other ("fade"). Spin sign
	  decides which way is which, so a right-handed backhand turns right early
	  and fades left late, and a forehand mirrors it. More spin = less roll =
	  a more stable line, which is why a clean release matters.
	  Wind enters through the airflow vector (velocity relative to the air).
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)

local P = DiscConfig.Physics

local DiscPhysics = {}

export type State = {
	px: number,
	py: number,
	pz: number,
	vx: number,
	vy: number,
	vz: number,
	nx: number,
	ny: number,
	nz: number,
	spin: number,
	t: number,
}

export type Wind = { x: number, y: number, z: number }

local NO_WIND: Wind = { x = 0, y = 0, z = 0 }

local sqrt = math.sqrt
local asin = math.asin
local clamp = math.clamp
local abs = math.abs

function DiscPhysics.new(
	px: number,
	py: number,
	pz: number,
	vx: number,
	vy: number,
	vz: number,
	nx: number,
	ny: number,
	nz: number,
	spin: number
): State
	local nm = sqrt(nx * nx + ny * ny + nz * nz)
	if nm < 1e-9 then
		nx, ny, nz, nm = 0, 1, 0, 1
	end
	return {
		px = px,
		py = py,
		pz = pz,
		vx = vx,
		vy = vy,
		vz = vz,
		nx = nx / nm,
		ny = ny / nm,
		nz = nz / nm,
		spin = spin,
		t = 0,
	}
end

function DiscPhysics.fromVectors(pos: Vector3, vel: Vector3, normal: Vector3, spin: number): State
	return DiscPhysics.new(pos.X, pos.Y, pos.Z, vel.X, vel.Y, vel.Z, normal.X, normal.Y, normal.Z, spin)
end

function DiscPhysics.copy(s: State): State
	return {
		px = s.px,
		py = s.py,
		pz = s.pz,
		vx = s.vx,
		vy = s.vy,
		vz = s.vz,
		nx = s.nx,
		ny = s.ny,
		nz = s.nz,
		spin = s.spin,
		t = s.t,
	}
end

function DiscPhysics.position(s: State): Vector3
	return Vector3.new(s.px, s.py, s.pz)
end

function DiscPhysics.velocity(s: State): Vector3
	return Vector3.new(s.vx, s.vy, s.vz)
end

function DiscPhysics.normal(s: State): Vector3
	return Vector3.new(s.nx, s.ny, s.nz)
end

function DiscPhysics.speed(s: State): number
	return sqrt(s.vx * s.vx + s.vy * s.vy + s.vz * s.vz)
end

local function liftCoefficient(alpha: number): number
	local a = abs(alpha)
	if a <= P.StallAlpha then
		return P.CL0 + P.CLa * alpha
	end
	local edge = P.CL0 + P.CLa * P.StallAlpha * (if alpha >= 0 then 1 else -1)
	local fall = 1 - (a - P.StallAlpha) / (math.pi / 2 - P.StallAlpha)
	return edge * clamp(fall, 0, 1)
end

-- Angle of attack (radians) of the disc for a given airflow direction.
function DiscPhysics.alpha(s: State, wind: Wind?): number
	local w = wind or NO_WIND
	local ax, ay, az = s.vx - w.x, s.vy - w.y, s.vz - w.z
	local sp = sqrt(ax * ax + ay * ay + az * az)
	if sp < 1e-6 then
		return 0
	end
	local d = (s.nx * ax + s.ny * ay + s.nz * az) / sp
	return -asin(clamp(d, -1, 1))
end

-- Advances the state in place by dt seconds.
function DiscPhysics.step(s: State, dt: number, wind: Wind?)
	local w = wind or NO_WIND
	local ax, ay, az = s.vx - w.x, s.vy - w.y, s.vz - w.z
	local speed2 = ax * ax + ay * ay + az * az
	local fx, fy, fz = 0, -P.Gravity, 0

	if speed2 > 1e-4 then
		local speed = sqrt(speed2)
		local ux, uy, uz = ax / speed, ay / speed, az / speed
		local nx, ny, nz = s.nx, s.ny, s.nz
		local nDotU = nx * ux + ny * uy + nz * uz
		local alpha = -asin(clamp(nDotU, -1, 1))
		local q = P.AirK * speed2

		-- lift: along n with the airflow component removed
		local lx, ly, lz = nx - nDotU * ux, ny - nDotU * uy, nz - nDotU * uz
		local lm = sqrt(lx * lx + ly * ly + lz * lz)
		if lm > 1e-6 then
			local lift = q * liftCoefficient(alpha) / lm
			fx += lift * lx
			fy += lift * ly
			fz += lift * lz
		end

		-- drag
		local da = alpha - P.Alpha0
		local cd = math.min(P.CD0 + P.CDa * da * da, P.CDMax)
		local drag = q * cd
		fx -= drag * ux
		fy -= drag * uy
		fz -= drag * uz

		-- gyroscopic precession of the spin axis
		local spin = s.spin
		if abs(spin) < P.MinSpin then
			spin = if spin >= 0 then P.MinSpin else -P.MinSpin
		end
		local fpx, fpy, fpz = ux - nDotU * nx, uy - nDotU * ny, uz - nDotU * nz
		local fm = sqrt(fpx * fpx + fpy * fpy + fpz * fpz)
		if fm > 1e-6 then
			fpx, fpy, fpz = fpx / fm, fpy / fm, fpz / fm
			-- f x n : the direction the normal moves for a nose-up moment
			local cx = fpy * nz - fpz * ny
			local cy = fpz * nx - fpx * nz
			local cz = fpx * ny - fpy * nx
			local cm = P.CM0 + P.CMa * clamp(alpha, -P.StallAlpha, P.StallAlpha)
			local rate = P.RollK * speed2 * cm / spin
			nx += cx * rate * dt
			ny += cy * rate * dt
			nz += cz * rate * dt
			local nm = sqrt(nx * nx + ny * ny + nz * nz)
			s.nx, s.ny, s.nz = nx / nm, ny / nm, nz / nm
		end
	end

	-- semi-implicit Euler
	s.vx += fx * dt
	s.vy += fy * dt
	s.vz += fz * dt
	s.px += s.vx * dt
	s.py += s.vy * dt
	s.pz += s.vz * dt
	s.spin *= (1 - P.SpinDecay * dt)
	s.t += dt
end

export type Sample = { t: number, x: number, y: number, z: number }

export type Result = {
	samples: { Sample },
	landed: boolean,
	landT: number,
	landX: number,
	landY: number,
	landZ: number,
	maxHeight: number,
	final: State,
}

-- Simulates from `start` (not modified) until ground contact or maxTime,
-- recording a sample every `sampleEvery` steps.
function DiscPhysics.simulate(
	start: State,
	maxTime: number?,
	wind: Wind?,
	groundY: number?,
	sampleEvery: number?
): Result
	local s = DiscPhysics.copy(start)
	local dt = P.Dt
	local limit = maxTime or P.MaxFlightTime
	local ground = (groundY or 0) + P.GroundContact
	local every = sampleEvery or 1
	local samples: { Sample } = { { t = s.t, x = s.px, y = s.py, z = s.pz } }
	local steps = 0
	local maxH = s.py
	local landed = false
	while s.t < limit do
		local ox, oy, oz = s.px, s.py, s.pz
		DiscPhysics.step(s, dt, wind)
		steps += 1
		if s.py > maxH then
			maxH = s.py
		end
		if s.py <= ground then
			-- interpolate the exact contact point inside this step
			local f = if oy - s.py > 1e-9 then (oy - ground) / (oy - s.py) else 1
			f = clamp(f, 0, 1)
			s.px = ox + (s.px - ox) * f
			s.pz = oz + (s.pz - oz) * f
			s.py = ground
			s.t = s.t - dt + dt * f
			landed = true
			table.insert(samples, { t = s.t, x = s.px, y = s.py, z = s.pz })
			break
		end
		if steps % every == 0 then
			table.insert(samples, { t = s.t, x = s.px, y = s.py, z = s.pz })
		end
	end
	return {
		samples = samples,
		landed = landed,
		landT = s.t,
		landX = s.px,
		landY = s.py,
		landZ = s.pz,
		maxHeight = maxH,
		final = s,
	}
end

-- Advances a state forward to absolute flight time `t` using fixed steps.
-- Returns false if the disc reached the ground first.
function DiscPhysics.advanceTo(s: State, t: number, wind: Wind?, groundY: number?): boolean
	local dt = P.Dt
	local ground = (groundY or 0) + P.GroundContact
	while s.t + dt <= t + 1e-9 do
		DiscPhysics.step(s, dt, wind)
		if s.py <= ground then
			s.py = ground
			return false
		end
	end
	return true
end

-- Position at fractional time `t` between fixed steps (for smooth rendering):
-- linearly extrapolates from the current state, which must be at s.t <= t.
function DiscPhysics.positionAt(s: State, t: number): (number, number, number)
	local f = t - s.t
	return s.px + s.vx * f, s.py + s.vy * f, s.pz + s.vz * f
end

return DiscPhysics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Solver</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Solver — finds throw inputs that deliver the disc to a (possibly moving)
	receiver. Used by bots, by the training launcher, and by the optional
	Lead Pass assist (which only extrapolates the receiver's CURRENT velocity —
	it cannot predict a cut, so reading your receiver is still the skill).

	Strategy: coarse grid over (power, aim pitch) with a cheap low-rate sim,
	refine around the best cell, and correct yaw twice for the curve.
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(script.Parent.DiscPhysics)
local ThrowModel = require(script.Parent.ThrowModel)

local Solver = {}

export type Options = {
	rootPos: Vector3,
	throwerVel: Vector3?,
	throwType: string,
	bank: number?,
	height: string?,
	target: Vector3,
	targetVel: Vector3?,
	wind: DiscPhysics.Wind?,
	groundY: number?,
	leftHanded: boolean?,
	maxPower: number?,
	coarse: boolean?, -- smaller search for client-side assist
	flightTimeWeight: number?,
}

export type Solution = {
	params: ThrowModel.Params,
	miss: number,
	flightTime: number,
	catchPoint: Vector3,
}

local function holdForPower(power: number, throwType: string): number
	local info = ThrowModel.typeInfo(throwType)
	local mult = info.ChargeMult or 1
	if power >= 0.999 then
		-- land inside the Perfect window
		return (DiscConfig.Throw.ChargeTime + DiscConfig.Throw.PerfectWindow * 0.5) / mult
	end
	return power * DiscConfig.Throw.ChargeTime / mult
end

-- Simulates one candidate; returns closest catchable approach to the moving
-- target: distance, time, lateral error (signed, relative to aim right).
local function evaluate(
	o: Options,
	yaw: number,
	pitch: number,
	power: number,
	dt: number
): (number, number, number, Vector3)
	local params: ThrowModel.Params = {
		throwType = o.throwType,
		yaw = yaw,
		pitch = pitch,
		holdTime = holdForPower(power, o.throwType),
		bank = o.bank or 0,
		height = o.height or "Mid",
		leftHanded = o.leftHanded,
	}
	local launch = ThrowModel.launch(params, o.rootPos, o.throwerVel or Vector3.zero)
	local s = launch.state
	local ground = (o.groundY or 0)
	local tv = o.targetVel or Vector3.zero
	local tx, ty, tz = o.target.X, o.target.Y, o.target.Z
	local best, bestT = math.huge, 0
	local bx, by, bz = s.px, s.py, s.pz
	local limit = 6
	while s.t < limit do
		DiscPhysics.step(s, dt, o.wind)
		local h = s.py - ground
		if h <= DiscConfig.Physics.GroundContact then
			break
		end
		if h > 0.8 and h < 9.5 then
			local cx = tx + tv.X * s.t
			local cz = tz + tv.Z * s.t
			local dx, dy, dz = s.px - cx, s.py - ty, s.pz - cz
			local d = math.sqrt(dx * dx + dy * dy * 0.6 + dz * dz)
			if d < best then
				best, bestT = d, s.t
				bx, by, bz = s.px, s.py, s.pz
			end
		end
	end
	local _, right = ThrowModel.basis(yaw)
	local cxb = tx + tv.X * bestT
	local czb = tz + tv.Z * bestT
	local lateral = (bx - cxb) * right.X + (bz - czb) * right.Z
	return best, bestT, lateral, Vector3.new(bx, by, bz)
end

function Solver.solve(o: Options): Solution?
	local maxPower = o.maxPower or 1
	local flightW = o.flightTimeWeight or 0.6
	local tv = o.targetVel or Vector3.zero
	local origin = o.rootPos

	-- initial yaw toward a lead point
	local tGuess = (o.target - origin).Magnitude / 55
	local aim = o.target + Vector3.new(tv.X, 0, tv.Z) * tGuess
	local d = aim - origin
	local yaw = math.atan2(-d.X, -d.Z)

	local powers: { number } = {}
	local pitches: { number } = {}
	local dtCoarse: number
	if o.coarse then
		for p = 0.1, 1.0001, 0.15 do
			table.insert(powers, math.min(p, maxPower))
		end
		for a = -12, 30, 7 do
			table.insert(pitches, math.rad(a))
		end
		dtCoarse = 1 / 30
	else
		for p = 0.05, 1.0001, 0.095 do
			table.insert(powers, math.min(p, maxPower))
		end
		table.insert(powers, maxPower)
		for a = -14, 34, 4 do
			table.insert(pitches, math.rad(a))
		end
		dtCoarse = 1 / 40
	end

	local bestScore, bestMiss, bestT = math.huge, math.huge, 0
	local bestPower, bestPitch = 0.5, 0
	local bestPoint = o.target

	for iteration = 1, 3 do
		bestScore = math.huge
		for _, power in powers do
			for _, pitch in pitches do
				local miss, t, _, point = evaluate(o, yaw, pitch, power, dtCoarse)
				local score = miss + flightW * t
				if score < bestScore then
					bestScore, bestMiss, bestT = score, miss, t
					bestPower, bestPitch, bestPoint = power, pitch, point
				end
			end
		end
		-- refine around the best cell at the real step size
		local dt = DiscConfig.Physics.Dt
		local refinedScore = math.huge
		local rp, ra = bestPower, bestPitch
		for dp = -0.04, 0.0401, 0.02 do
			for da = -2, 2.001, 1 do
				local power = math.clamp(bestPower + dp, 0, maxPower)
				local pitch = bestPitch + math.rad(da)
				local miss, t, _, point = evaluate(o, yaw, pitch, power, dt)
				local score = miss + flightW * t
				if score < refinedScore then
					refinedScore, bestMiss, bestT = score, miss, t
					rp, ra, bestPoint = power, pitch, point
				end
			end
		end
		bestPower, bestPitch = rp, ra
		-- correct yaw for curve / lead
		local _, _, lateral = evaluate(o, yaw, bestPitch, bestPower, dt)
		local horiz = Vector3.new(bestPoint.X - origin.X, 0, bestPoint.Z - origin.Z).Magnitude
		if horiz < 1 or math.abs(lateral) < 0.4 or iteration == 3 then
			break
		end
		yaw += math.atan2(lateral, horiz)
		-- narrow the grid around the current solution for the next pass
		powers = {}
		pitches = {}
		for p = bestPower - 0.15, bestPower + 0.1501, 0.05 do
			if p >= 0 and p <= maxPower then
				table.insert(powers, p)
			end
		end
		for a = -6, 6.001, 2 do
			table.insert(pitches, bestPitch + math.rad(a))
		end
	end

	if bestMiss == math.huge then
		return nil
	end

	return {
		params = {
			throwType = o.throwType,
			yaw = yaw,
			pitch = bestPitch,
			holdTime = holdForPower(bestPower, o.throwType),
			bank = o.bank or 0,
			height = o.height or "Mid",
			leftHanded = o.leftHanded,
		},
		miss = bestMiss,
		flightTime = bestT,
		catchPoint = bestPoint,
	}
end

Solver.holdForPower = holdForPower

return Solver
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ThrowModel</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ThrowModel — turns a player's throw inputs into a disc launch state.

	Inputs that matter (all deterministic, no hidden accuracy roll):
	  throw type      Backhand / Forehand / Hammer / Scoober / Blade
	  aim yaw/pitch   from the camera
	  hold time       charge -> power; releasing in the Perfect window at full
	                  charge gives +speed and +spin; holding too long (Over)
	                  bleeds spin, which makes the disc roll more (turn/fade)
	  bank            -1..1, tilts the disc so lift curves the flight
	  release height  High (hop / over the mark), Mid, Low (step-out under the mark)
	  balance         throwing airborne / from the ground / on the move costs
	                  power cap and spin
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(script.Parent.DiscPhysics)

local T = DiscConfig.Throw

local ThrowModel = {}

export type Params = {
	throwType: string,
	yaw: number, -- radians, 0 = -Z
	pitch: number, -- radians, aim elevation (type offset is added here)
	holdTime: number, -- seconds the throw was charged
	bank: number, -- -1..1
	height: string, -- "High" | "Mid" | "Low"
	offBalance: boolean?,
	groundThrow: boolean?,
	leftHanded: boolean?,
}

export type Launch = {
	state: DiscPhysics.State,
	releasePos: Vector3,
	velocity: Vector3,
	normal: Vector3,
	quality: string, -- "Perfect" | "Clean" | "Over"
	power: number,
	spinFactor: number,
	speed: number,
	pitchDeg: number,
	bankDeg: number,
}

local VALID_HEIGHTS = { High = true, Mid = true, Low = true }

function ThrowModel.typeInfo(throwType: string): any
	return (DiscConfig.Types :: any)[throwType] or DiscConfig.Types.Backhand
end

-- Charge time -> (power, quality, spinFactor). Power rises linearly to full at
-- ChargeTime (scaled by the throw's ChargeMult). Releasing inside the Perfect
-- window at full charge is a Perfect release.
function ThrowModel.charge(holdTime: number, throwType: string): (number, string, number)
	local info = ThrowModel.typeInfo(throwType)
	local t = math.max(0, holdTime) * (info.ChargeMult or 1)
	if t < T.ChargeTime then
		return math.clamp(t / T.ChargeTime, 0, 1), "Clean", 1
	end
	local over = t - T.ChargeTime
	if over <= T.PerfectWindow then
		return 1, "Perfect", T.PerfectSpinMult
	end
	local spin = math.max(T.MinOverSpin, 1 - (over - T.PerfectWindow) * T.OverchargeDecay)
	return 1, "Over", spin
end

-- Clamps untrusted client parameters into the legal range.
function ThrowModel.sanitize(raw: any): Params?
	if type(raw) ~= "table" then
		return nil
	end
	local throwType = if type(raw.throwType) == "string" and (DiscConfig.Types :: any)[raw.throwType]
		then raw.throwType
		else nil
	if not throwType then
		return nil
	end
	local function num(v: any, lo: number, hi: number, default: number): number
		if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
			return default
		end
		return math.clamp(v, lo, hi)
	end
	return {
		throwType = throwType,
		yaw = num(raw.yaw, -1000, 1000, 0),
		pitch = num(raw.pitch, math.rad(-80), math.rad(80), 0),
		holdTime = num(raw.holdTime, 0, 5, 0),
		bank = num(raw.bank, -1, 1, 0),
		height = if type(raw.height) == "string" and VALID_HEIGHTS[raw.height] then raw.height else "Mid",
		offBalance = raw.offBalance == true,
		groundThrow = raw.groundThrow == true,
		leftHanded = raw.leftHanded == true,
	}
end

local UP = Vector3.new(0, 1, 0)

function ThrowModel.basis(yaw: number): (Vector3, Vector3)
	local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	return forward, right
end

-- Where the disc leaves the hand, relative to the thrower's root part.
function ThrowModel.releasePosition(p: Params, rootPos: Vector3): Vector3
	local info = ThrowModel.typeInfo(p.throwType)
	local forward, right = ThrowModel.basis(p.yaw)
	local mirror = if p.leftHanded then -1 else 1
	local side: number
	local up: number
	if info.Overhead then
		side = info.Side
		up = DiscConfig.OverheadHeight + (if p.height == "High" then 0.6 else 0)
	elseif p.height == "Low" then
		side = info.LowSide
		up = DiscConfig.Heights.Low
	else
		side = info.Side
		up = (DiscConfig.Heights :: any)[p.height] or DiscConfig.Heights.Mid
	end
	if p.groundThrow then
		up = -1.9
	end
	return rootPos + right * (side * mirror) + UP * up + forward * 0.8
end

function ThrowModel.launch(p: Params, rootPos: Vector3, throwerVel: Vector3): Launch
	local info = ThrowModel.typeInfo(p.throwType)
	local mirror = if p.leftHanded then -1 else 1

	local power, quality, spinFactor = ThrowModel.charge(p.holdTime, p.throwType)
	if p.offBalance then
		power = math.min(power, T.OffBalancePowerCap)
		spinFactor *= T.OffBalanceSpin
		if quality == "Perfect" then
			quality = "Clean"
		end
	end
	if p.groundThrow then
		power = math.min(power, T.GroundThrowPowerCap)
		spinFactor *= T.OffBalanceSpin
		if quality == "Perfect" then
			quality = "Clean"
		end
	end
	local flatSpeed = Vector3.new(throwerVel.X, 0, throwerVel.Z).Magnitude
	if flatSpeed > T.MovingSpinPenaltySpeed then
		spinFactor *= T.MovingSpinPenalty
	end

	local minPitch = if info.Overhead then 10 else T.MinPitch
	local maxPitch = if info.Overhead then 72 else T.MaxPitch
	local pitchDeg = math.clamp(math.deg(p.pitch) + info.PitchOffset, minPitch, maxPitch)
	local pitch = math.rad(pitchDeg)

	local speed = (T.MinSpeed + (T.MaxSpeed - T.MinSpeed) * (power ^ T.PowerCurve)) * info.SpeedMult
	if quality == "Perfect" then
		speed *= T.PerfectSpeedMult
	end

	local forward, right = ThrowModel.basis(p.yaw)
	local dir = forward * math.cos(pitch) + UP * math.sin(pitch)

	-- Orientation: start flat relative to the flight path, bank about the
	-- flight direction, then tilt the nose by the throw's release angle.
	local bankDeg = (info.Bank + p.bank * T.BankRange) * mirror
	local beta = math.rad(bankDeg)
	local alpha = math.rad(info.Alpha)
	local n0 = UP * math.cos(pitch) - forward * math.sin(pitch)
	local nRot = n0 * math.cos(beta) + right * math.sin(beta)
	local normal = (nRot * math.cos(alpha) - dir * math.sin(alpha)).Unit

	local carry = Vector3.new(throwerVel.X, 0, throwerVel.Z) * T.ThrowerVelocityCarry
	local velocity = dir * speed + carry
	local releasePos = ThrowModel.releasePosition(p, rootPos)
	local spin = T.SpinBase * spinFactor * info.Spin * mirror

	return {
		state = DiscPhysics.fromVectors(releasePos, velocity, normal, spin),
		releasePos = releasePos,
		velocity = velocity,
		normal = normal,
		quality = quality,
		power = power,
		spinFactor = spinFactor,
		speed = speed,
		pitchDeg = pitchDeg,
		bankDeg = bankDeg,
	}
end

return ThrowModel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Movement</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MovementSim</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MovementSim — the movement-tech engine.

	Pure simulation of one player's horizontal momentum, technique timing,
	exertion and cooldowns. It knows nothing about Instances: the client
	MovementController feeds it input + an environment snapshot (grounded,
	time-to-land, nearby rebound wall, pivot offset) and applies the returned
	velocity with a LinearVelocity constraint. Because it is pure, the same code
	is fuzz-tested offline (tests/movement.spec.luau) to prove that no input
	sequence can exceed the speed caps.

	Inputs map to five actions. Every advanced technique is one of these
	actions pressed in a particular context and at a particular time:

	  Cut   ground, input 25-115 deg off travel      -> Snap Cut
	        ground, input >115 deg / no input        -> Momentum Cancel (plant)
	        ground, input along travel / standing    -> Fake Commit (jab step)
	        during a plant's restart window          -> restart cut (Perfect/Clean)
	        in the air                               -> Air Redirect
	        mid-slide                                -> Slide Cut
	        in the dive recovery pop window          -> Recovery Chain
	  Burst ground                                   -> Burst Step
	        during a plant window                    -> Explosive restart (free)
	  Slide ground, fast                             -> Slide
	        airborne, <=0.15 s before touchdown      -> Precision Landing / Roll-out
	  Dive  ground or air                            -> Layout dive
	  Jump  ground / slide                           -> Jump / slide hop
	        airborne beside a Rebound wall           -> Wall Rebound
	        in the pop window                        -> Recovery Chain pop-up
]]

local Shared = script.Parent.Parent
local Config = require(Shared.Config.Movement)
local VecMath = require(Shared.Util.VecMath)

local MovementSim = {}

export type Mode = "Ground" | "Air" | "Slide" | "Dive" | "DiveSlide" | "Recover" | "Landing" | "Frozen"
export type HoldPhase = "None" | "Air" | "Decel" | "Pivot"
export type Action = "Jump" | "Cut" | "Slide" | "Dive" | "Burst"

export type TechEvent = {
	tech: string,
	quality: string,
	t: number,
	dir: Vector3,
	chain: boolean,
	info: string?,
}

export type Feedback = { kind: string, value: number? }

export type Input = { move: Vector3, sprint: boolean }

export type Env = {
	grounded: boolean,
	actualVel: Vector3,
	timeToLand: number?,
	wallNormal: Vector3?,
	wallDistance: number?,
	wallId: string?,
	pivotOffset: Vector3?,
	facing: Vector3?,
}

export type Output = {
	vel: Vector3,
	setVertical: number?,
	jump: boolean,
	events: { TechEvent },
	feedback: { Feedback },
	pivotEstablished: boolean,
	landed: boolean,
	tookOff: boolean,
}

export type State = {
	mode: Mode,
	now: number,
	modeStart: number,
	vel: Vector3,
	exertion: number,
	regenAt: number,
	ready: { [string]: number },
	lastTech: string?,
	lastTechAt: number,
	lastCutAt: number,
	commitDir: Vector3,
	commitSince: number,
	blockedSince: number?,

	plantAt: number,
	plantEnd: number,
	plantDecel: number,
	plantGassed: boolean,
	restartLockUntil: number,

	jabUntil: number,
	soldUntil: number,
	soldDir: Vector3,

	burstUntil: number,
	burstDir: Vector3,
	burstSpeed: number,

	airStart: number,
	groundLostAt: number?,
	takeoffSpeed: number,
	airRedirectUsed: boolean,
	airDiveUsed: boolean,
	aerialReachUsed: boolean,
	rebounds: number,
	lastWall: string?,

	landingUntil: number,
	landedAt: number,
	landedFromDive: boolean,
	landingVel: Vector3,
	precisionArmedAt: number?,
	precisionLockUntil: number,
	lateLandingUntil: number,

	recoverUntil: number,
	popStart: number,
	popEnd: number,
	popLockUntil: number,

	diveDir: Vector3,

	holding: boolean,
	holdPhase: HoldPhase,
	holdStart: number,
	holdHopped: boolean,

	frozen: boolean,

	pendingVertical: number?,
	pendingJump: boolean,
	pendingEvents: { TechEvent },
	pendingFeedback: { Feedback },
	pendingPivot: boolean,
}

local Q = Config.Quality
local SC = Config.SnapCut
local MC = Config.MomentumCancel
local FC = Config.FakeCommit
local BS = Config.BurstStep
local SL = Config.Slide
local SLC = Config.SlideCut
local DV = Config.Dive
local DS = Config.DiveSlide
local RC = Config.Recover
local RO = Config.RollOut
local AR = Config.AirRedirect
local PL = Config.PrecisionLanding
local WR = Config.WallRebound
local HD = Config.Holding

local FORWARD = Vector3.new(0, 0, -1)

---------------------------------------------------------------------------
-- construction
---------------------------------------------------------------------------

function MovementSim.new(now: number?): State
	local t = now or 0
	return {
		mode = "Ground",
		now = t,
		modeStart = t,
		vel = Vector3.zero,
		exertion = Config.ExertionMax,
		regenAt = t,
		ready = {},
		lastTech = nil,
		lastTechAt = -math.huge,
		lastCutAt = -math.huge,
		commitDir = FORWARD,
		commitSince = t,
		blockedSince = nil,

		plantAt = 0,
		plantEnd = 0,
		plantDecel = MC.BrakeDecel,
		plantGassed = false,
		restartLockUntil = 0,

		jabUntil = 0,
		soldUntil = 0,
		soldDir = FORWARD,

		burstUntil = 0,
		burstDir = FORWARD,
		burstSpeed = 0,

		airStart = t,
		groundLostAt = nil,
		takeoffSpeed = 0,
		airRedirectUsed = false,
		airDiveUsed = false,
		aerialReachUsed = false,
		rebounds = 0,
		lastWall = nil,

		landingUntil = 0,
		landedAt = -math.huge,
		landedFromDive = false,
		landingVel = Vector3.zero,
		precisionArmedAt = nil,
		precisionLockUntil = 0,
		lateLandingUntil = 0,

		recoverUntil = 0,
		popStart = 0,
		popEnd = 0,
		popLockUntil = 0,

		diveDir = FORWARD,

		holding = false,
		holdPhase = "None",
		holdStart = 0,
		holdHopped = false,

		frozen = false,

		pendingVertical = nil,
		pendingJump = false,
		pendingEvents = {},
		pendingFeedback = {},
		pendingPivot = false,
	}
end

-- Clears momentum and transient technique state (respawn / teleport).
function MovementSim.reset(s: State)
	local now = s.now
	local exertion = s.exertion
	local holding: boolean = s.holding
	local holdPhase: HoldPhase = s.holdPhase
	local fresh = MovementSim.new(now)
	for k, v in fresh :: any do
		(s :: any)[k] = v
	end
	s.exertion = exertion
	s.holding = holding
	s.holdPhase = holdPhase
end

---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------

local function setMode(s: State, m: Mode)
	s.mode = m
	s.modeStart = s.now
end

local function isReady(s: State, tech: string): boolean
	return (s.ready[tech] or -math.huge) <= s.now
end

local function setCooldown(s: State, tech: string)
	local cd = (Config.TechCooldowns :: any)[tech] or 0
	s.ready[tech] = s.now + cd
end

local function spend(s: State, cost: number)
	s.exertion = math.max(0, s.exertion - cost)
	s.regenAt = s.now + Config.ExertionRegenDelay
end

local function emit(s: State, tech: string, quality: string, dir: Vector3, info: string?)
	local chain = s.lastTech ~= nil and (s.now - s.lastTechAt) <= Config.ChainWindow
	table.insert(s.pendingEvents, {
		tech = tech,
		quality = quality,
		t = s.now,
		dir = dir,
		chain = chain,
		info = info,
	})
	s.lastTech = tech
	s.lastTechAt = s.now
end

local function feedback(s: State, kind: string, value: number?)
	table.insert(s.pendingFeedback, { kind = kind, value = value })
end

local function queueJump(s: State, vy: number)
	s.pendingVertical = vy
	s.pendingJump = true
end

local function queueVertical(s: State, vy: number)
	s.pendingVertical = vy
end

local function cancelTransients(s: State)
	s.burstUntil = 0
	s.plantAt = 0
	s.plantEnd = 0
	s.jabUntil = 0
end

local function enterAir(s: State)
	setMode(s, "Air")
	s.airStart = s.now
	s.takeoffSpeed = s.vel.Magnitude
	s.plantAt = 0
	s.plantEnd = 0
	s.jabUntil = 0
	s.groundLostAt = nil
end

local function enterRecover(s: State, duration: number)
	setMode(s, "Recover")
	s.recoverUntil = s.now + duration
	s.popStart = s.now
	s.popEnd = s.now + RC.PopWindow
end

local function velDirOr(s: State, fallback: Vector3): Vector3
	local speed = s.vel.Magnitude
	if speed > 1e-3 then
		return s.vel / speed
	end
	return fallback
end

local function facingOr(env: Env): Vector3
	if env.facing then
		local f = VecMath.flatUnit(env.facing)
		if f.Magnitude > 0.5 then
			return f
		end
	end
	return FORWARD
end

local function topSpeed(s: State, sprint: boolean): number
	if not sprint then
		return Config.JogSpeed
	end
	if s.exertion >= 15 then
		return Config.SprintSpeed
	end
	local t = s.exertion / 15
	return Config.ExhaustedSprintSpeed + (Config.SprintSpeed - Config.ExhaustedSprintSpeed) * t
end

local function inPlantWindow(s: State): boolean
	if s.plantAt <= 0 then
		return false
	end
	local since = s.now - s.plantAt
	return since >= MC.WindowOpen and since <= MC.WindowClose
end

local function plantTooEarly(s: State): boolean
	if s.plantAt <= 0 then
		return false
	end
	local since = s.now - s.plantAt
	return since >= 0 and since < MC.WindowOpen
end

---------------------------------------------------------------------------
-- steering models
---------------------------------------------------------------------------

-- Ground steering: acceleration split into along-velocity (accelerate/brake)
-- and perpendicular (turning) components with separate limits. This is what
-- makes sprinting a commitment: at 26 studs/s the turn radius is ~7 studs, so
-- sharp changes of direction require a technique.
function MovementSim.steerGround(v: Vector3, wish: Vector3, top: number, dt: number, lateralMult: number): Vector3
	local wishMag = math.min(wish.Magnitude, 1)
	local target = if wishMag > 0.05 then VecMath.flatUnit(wish) * (top * wishMag) else Vector3.zero
	local speed = v.Magnitude
	if speed < Config.RestSpeed then
		return VecMath.moveToward(v, target, Config.AccelFromRest * dt * math.max(lateralMult, 0.5))
	end
	local fwd = v / speed
	local tPar = target:Dot(fwd)
	local tPerp = target - fwd * tPar
	local newPar: number
	if tPar > speed then
		newPar = math.min(tPar, speed + Config.Accel * dt * math.max(lateralMult, 0.5))
	else
		local decel = if wishMag <= 0.05 then Config.Coast else Config.Brake
		if tPar >= 0 and speed > top + 0.5 and tPar >= top - 0.5 then
			decel = Config.OverspeedDecay
		end
		newPar = math.max(tPar, speed - decel * dt)
	end
	local perpMag = tPerp.Magnitude
	local maxPerp = Config.LateralAccel * lateralMult * dt
	local newPerp = if perpMag > maxPerp then tPerp * (maxPerp / perpMag) else tPerp
	return fwd * newPar + newPerp
end

local function steerAir(s: State, wish: Vector3, dt: number): Vector3
	local wishMag = math.min(wish.Magnitude, 1)
	if wishMag <= 0.05 then
		return s.vel
	end
	local base = math.max(s.takeoffSpeed, Config.AirMinControlSpeed)
	local limit = base + Config.AirGainAllowance
	local target = VecMath.flatUnit(wish) * (base * wishMag)
	local nv = VecMath.moveToward(s.vel, target, Config.AirAccel * dt)
	local ceiling = math.max(limit, s.vel.Magnitude)
	return VecMath.clampMagnitude(nv, ceiling)
end

local function updateHolding(s: State, wish: Vector3, env: Env, dt: number)
	if s.holdPhase == "Air" then
		s.holdPhase = "Decel"
		s.holdStart = s.now
	end
	if s.holdPhase == "Decel" then
		local speed = s.vel.Magnitude
		local newSpeed = math.max(0, speed - HD.DecelRate * dt)
		s.vel = if speed > 1e-3 then s.vel * (newSpeed / speed) else Vector3.zero
		if newSpeed <= HD.StopSpeed or s.now - s.holdStart >= HD.DecelMaxTime then
			s.vel = Vector3.zero
			s.holdPhase = "Pivot"
			s.pendingPivot = true
		end
	elseif s.holdPhase == "Pivot" then
		local wishMag = math.min(wish.Magnitude, 1)
		local target = if wishMag > 0.05 then VecMath.flatUnit(wish) * (HD.PivotSpeed * wishMag) else Vector3.zero
		local off = env.pivotOffset
		if off then
			local flatOff = VecMath.flat(off)
			local r = flatOff.Magnitude
			if r > 1e-3 then
				local outward = flatOff / r
				if r >= HD.PivotRadius - 0.05 then
					local o = target:Dot(outward)
					if o > 0 then
						target -= outward * o
					end
				end
				if r > HD.PivotRadius then
					target -= outward * ((r - HD.PivotRadius) * 12)
				end
			end
		end
		s.vel = VecMath.moveToward(s.vel, target, HD.PivotAccel * dt)
	end
end

---------------------------------------------------------------------------
-- landing
---------------------------------------------------------------------------

local function land(s: State)
	local now = s.now
	local fromDive = s.mode == "Dive"
	s.airRedirectUsed = false
	s.airDiveUsed = false
	s.aerialReachUsed = false
	s.rebounds = 0
	s.lastWall = nil
	s.landedAt = now
	s.landedFromDive = fromDive
	s.landingVel = s.vel
	s.groundLostAt = nil

	if s.holding and s.holdHopped then
		feedback(s, "HopLanded")
	end

	local armed = s.precisionArmedAt
	s.precisionArmedAt = nil
	if armed ~= nil and now - armed <= PL.EarlyWindow + 0.035 then
		local offset = now - armed
		local q = if offset <= PL.PerfectWindow then Q.Perfect else Q.Clean
		if fromDive then
			s.vel = s.vel * (RO.Retention :: any)[q]
			enterRecover(s, RO.RecoverTime)
			emit(s, "PrecisionLanding", q, velDirOr(s, s.diveDir), "RollOut")
		else
			s.vel = s.vel * (PL.Retention :: any)[q]
			setMode(s, "Ground")
			emit(s, "PrecisionLanding", q, velDirOr(s, FORWARD), nil)
		end
		feedback(s, "LandingOffset", offset)
		return
	end

	s.lateLandingUntil = now + PL.LateWindow
	if fromDive then
		setMode(s, "DiveSlide")
	else
		setMode(s, "Landing")
		s.landingUntil = now + Config.LandingRecovery
		s.vel = s.vel * Config.LandingRetention
	end
end

---------------------------------------------------------------------------
-- techniques
---------------------------------------------------------------------------

local function pressSnapCut(s: State, dir: Vector3, speed: number, angle: number, sold: boolean): boolean
	local now = s.now
	if now - s.lastCutAt < SC.MinInterval then
		return false
	end
	local q: string
	if s.exertion < SC.Cost then
		q = Q.Gassed
	elseif sold then
		q = Q.Perfect
	elseif now - s.lastCutAt < SC.SpamWindow then
		q = Q.Sloppy
	else
		local commit = now - s.commitSince
		if commit >= SC.CommitPerfect and speed >= Config.SprintSpeed * SC.PerfectSpeedFraction then
			q = Q.Perfect
		elseif commit >= SC.CommitClean then
			q = Q.Clean
		else
			q = Q.Sloppy
		end
	end
	local over = math.clamp((angle - 45) / (SC.MaxAngle - 45), 0, 1)
	local retention = (SC.Retention :: any)[q] * (1 - SC.AnglePenalty * over)
	local newSpeed = speed * retention
	if q == Q.Perfect then
		newSpeed = math.min(newSpeed + SC.PerfectBoost, Config.SprintSpeed)
	end
	if sold then
		newSpeed = math.max(newSpeed, Config.SprintSpeed * SC.SoldMinSpeedFraction)
	end
	spend(s, SC.Cost)
	s.vel = dir * newSpeed
	s.lastCutAt = now
	s.commitDir = dir
	s.commitSince = now
	s.soldUntil = 0
	s.burstUntil = 0
	s.jabUntil = 0
	emit(s, "SnapCut", q, dir, if sold then "Sold" else nil)
	return true
end

local function pressMomentumCancel(s: State, velDir: Vector3): boolean
	if not isReady(s, "MomentumCancel") then
		feedback(s, "Cooldown", (s.ready.MomentumCancel or 0) - s.now)
		return false
	end
	local speed = s.vel.Magnitude
	local q: string
	if s.exertion < MC.Cost then
		q = Q.Gassed
	elseif speed >= 18 then
		q = Q.Clean
	else
		q = Q.Sloppy
	end
	spend(s, MC.Cost)
	setCooldown(s, "MomentumCancel")
	s.burstUntil = 0
	s.jabUntil = 0
	s.plantAt = s.now
	s.plantEnd = s.now + MC.PlantTime
	s.plantGassed = q == Q.Gassed
	s.plantDecel = if q == Q.Gassed then MC.BrakeDecel * 0.5 else MC.BrakeDecel
	s.restartLockUntil = 0
	emit(s, "MomentumCancel", q, velDir, nil)
	return true
end

local function pressFakeCommit(s: State, dir: Vector3, speed: number): boolean
	if not isReady(s, "FakeCommit") then
		return false
	end
	local q = if s.exertion < FC.Cost then Q.Gassed else Q.Clean
	spend(s, FC.Cost)
	setCooldown(s, "FakeCommit")
	if speed < SC.MinSpeed then
		s.vel = dir * (FC.JabSpeed * (if q == Q.Gassed then 0.6 else 1))
		s.soldDir = dir
	else
		s.vel = s.vel * FC.JabSlow
		s.soldDir = velDirOr(s, dir)
	end
	s.jabUntil = s.now + FC.JabTime
	s.soldUntil = s.now + FC.JabTime + FC.SoldWindow
	emit(s, "FakeCommit", q, s.soldDir, nil)
	return true
end

local function restartFromPlant(s: State, dir: Vector3): boolean
	local since = s.now - s.plantAt
	local q = if since <= MC.PerfectUntil and not s.plantGassed then Q.Perfect else Q.Clean
	s.vel = dir * (Config.SprintSpeed * (MC.RestartRetention :: any)[q])
	s.plantAt = 0
	s.plantEnd = 0
	s.lastCutAt = s.now
	s.commitDir = dir
	s.commitSince = s.now
	emit(s, "SnapCut", q, dir, "Restart")
	return true
end

local function doBurst(s: State, dir: Vector3, free: boolean, forcedQuality: string?): boolean
	local now = s.now
	local speed = s.vel.Magnitude
	local q: string
	if forcedQuality then
		q = forcedQuality
	elseif s.exertion < BS.Cost then
		q = Q.Gassed
	elseif s.lastTech == "SnapCut" and now - s.lastCutAt <= BS.CutChainWindow then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	local base = math.max(speed, Config.SprintSpeed)
	local bs: number
	if q == Q.Gassed then
		bs = math.min(base * BS.GassedMult, BS.MaxSpeed)
	else
		bs = math.clamp(base * BS.SpeedMult, BS.MinSpeed, BS.MaxSpeed)
	end
	if not free then
		spend(s, BS.Cost)
	end
	setCooldown(s, "BurstStep")
	s.burstDir = dir
	s.burstSpeed = bs
	s.burstUntil = now + BS.Duration
	s.vel = dir * bs
	s.plantAt = 0
	s.plantEnd = 0
	s.jabUntil = 0
	s.commitDir = dir
	s.commitSince = now
	emit(s, "BurstStep", q, dir, if free then "Explosive" else nil)
	return true
end

local function tryPop(s: State, action: Action, dir: Vector3, hasDir: boolean, env: Env): boolean
	local now = s.now
	if s.mode == "DiveSlide" then
		s.popLockUntil = now + RC.EarlyLockout
		feedback(s, "PopEarly")
		return false
	end
	if now < s.popLockUntil then
		return false
	end
	if now > s.popEnd then
		feedback(s, "PopLate", now - s.popEnd)
		return false
	end
	local q = if now - s.popStart <= RC.PopPerfect then Q.Perfect else Q.Clean
	local d = if hasDir then dir else velDirOr(s, facingOr(env))
	local out = Config.SprintSpeed * (RC.Retention :: any)[q]
	setMode(s, "Ground")
	s.recoverUntil = 0
	emit(s, "RecoveryChain", q, d, action)
	if action == "Jump" then
		s.vel = if hasDir then d * out else Vector3.zero
		enterAir(s)
		queueJump(s, Config.JumpVelocity * RC.PopJumpFraction)
	elseif action == "Cut" then
		s.vel = d * out
		s.lastCutAt = now
		s.commitDir = d
		s.commitSince = now
	elseif action == "Burst" then
		s.vel = d * out
		if isReady(s, "BurstStep") then
			doBurst(s, d, false, nil)
		end
	end
	return true
end

local function pressJump(s: State, dir: Vector3, hasDir: boolean, env: Env): boolean
	if s.holding then
		local grounded = s.mode == "Ground" or s.mode == "Landing"
		if s.holdPhase == "Pivot" and not s.holdHopped and grounded then
			s.holdHopped = true
			enterAir(s)
			queueJump(s, HD.HopVertical)
			return true
		end
		return false
	end
	if s.mode == "Recover" or s.mode == "DiveSlide" then
		return tryPop(s, "Jump", dir, hasDir, env)
	end
	if s.mode == "Ground" or s.mode == "Landing" or s.mode == "Slide" then
		local speed = s.vel.Magnitude
		local vy = Config.JumpVelocity + Config.JumpSpeedBonus * math.clamp(speed / Config.SprintSpeed, 0, 1)
		local fromSlide = s.mode == "Slide"
		local fromPlant = inPlantWindow(s)
		enterAir(s)
		queueJump(s, vy)
		local info: string? = nil
		if fromSlide then
			info = "SlideHop"
		elseif fromPlant then
			info = "PlantJump"
		end
		emit(s, "Jump", Q.Clean, velDirOr(s, facingOr(env)), info)
		return true
	end
	if s.mode == "Air" or s.mode == "Dive" then
		local wall = env.wallNormal
		if wall and s.rebounds < WR.MaxPerAir and env.wallId ~= s.lastWall then
			local n = VecMath.flatUnit(wall)
			if n.Magnitude < 0.5 then
				return false
			end
			local v = s.vel
			local into = v:Dot(n)
			local reflected = if into < 0 then VecMath.reflect(v, n) else v
			local q: string
			if s.exertion < WR.Cost then
				q = Q.Gassed
			elseif (env.wallDistance or math.huge) <= WR.PerfectDistance then
				q = Q.Perfect
			else
				q = Q.Clean
			end
			local retention = if q == Q.Gassed then WR.Retention * 0.7 else WR.Retention
			local nv = VecMath.clampMagnitude((reflected + n * WR.PushOff) * retention, Config.HardCap)
			spend(s, WR.Cost)
			s.vel = nv
			s.rebounds += 1
			s.lastWall = env.wallId
			s.airRedirectUsed = false
			enterAir(s)
			queueJump(s, WR.Vertical)
			emit(s, "WallRebound", q, velDirOr(s, n), nil)
			return true
		end
	end
	return false
end

local function pressAirRedirect(s: State, dir: Vector3, hasDir: boolean, env: Env): boolean
	if s.airRedirectUsed or not hasDir then
		return false
	end
	local speed = s.vel.Magnitude
	local vy = env.actualVel.Y
	local q: string
	if s.exertion < AR.Cost then
		q = Q.Gassed
	elseif math.abs(vy) < AR.ApexWindow then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	local newVel: Vector3
	if speed < AR.MinSpeed then
		newVel = dir * AR.StillSpeed
	else
		local nd = VecMath.rotateToward(s.vel / speed, dir, AR.MaxAngle)
		newVel = nd * (speed * (AR.Retention :: any)[q])
	end
	spend(s, AR.Cost)
	s.airRedirectUsed = true
	s.vel = newVel
	if s.mode == "Dive" then
		s.diveDir = velDirOr(s, s.diveDir)
	end
	if vy < AR.MinVertical then
		queueVertical(s, AR.MinVertical)
	end
	emit(s, "AirRedirect", q, velDirOr(s, dir), nil)
	return true
end

local function pressSlideCut(s: State, dir: Vector3, hasDir: boolean): boolean
	local t = s.now - s.modeStart
	if t < SLC.MinSlideTime or not hasDir then
		return false
	end
	local speed = s.vel.Magnitude
	local velDir = velDirOr(s, dir)
	if VecMath.flatAngle(velDir, dir) > SLC.MaxAngle then
		return false
	end
	local q: string
	if s.exertion < SLC.Cost then
		q = Q.Gassed
	elseif t >= SLC.PerfectFrom and t <= SLC.PerfectTo then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	spend(s, SLC.Cost)
	s.vel = dir * (speed * (SLC.Retention :: any)[q])
	setMode(s, "Ground")
	s.lastCutAt = s.now
	s.commitDir = dir
	s.commitSince = s.now
	emit(s, "SlideCut", q, dir, nil)
	return true
end

local function pressCut(s: State, dir: Vector3, hasDir: boolean, env: Env): boolean
	if s.holding then
		return false
	end
	local now = s.now
	if s.mode == "Air" or s.mode == "Dive" then
		return pressAirRedirect(s, dir, hasDir, env)
	end
	if s.mode == "Slide" then
		return pressSlideCut(s, dir, hasDir)
	end
	if s.mode == "Recover" or s.mode == "DiveSlide" then
		return tryPop(s, "Cut", dir, hasDir, env)
	end
	if s.mode ~= "Ground" and s.mode ~= "Landing" then
		return false
	end

	-- Restart out of a Momentum Cancel plant.
	if s.plantAt > 0 and now - s.plantAt <= MC.WindowClose then
		if now < s.restartLockUntil then
			return false
		end
		if plantTooEarly(s) then
			s.restartLockUntil = now + MC.EarlyLockout
			feedback(s, "PlantEarly", MC.WindowOpen - (now - s.plantAt))
			return false
		end
		if hasDir then
			return restartFromPlant(s, dir)
		end
		return false
	end

	local speed = s.vel.Magnitude
	local velDir = velDirOr(s, facingOr(env))

	-- A cut out of a Fake Commit's sold window is always allowed.
	if hasDir and now <= s.soldUntil and VecMath.flatAngle(s.soldDir, dir) >= FC.SoldMinAngle then
		return pressSnapCut(s, dir, math.max(speed, SC.MinSpeed), VecMath.flatAngle(velDir, dir), true)
	end

	if not hasDir then
		if speed >= MC.MinSpeed then
			return pressMomentumCancel(s, velDir)
		end
		return false
	end
	if speed < SC.MinSpeed then
		return pressFakeCommit(s, dir, speed)
	end
	local angle = VecMath.flatAngle(velDir, dir)
	if angle < FC.MaxAngle then
		return pressFakeCommit(s, dir, speed)
	end
	if angle <= SC.MaxAngle then
		return pressSnapCut(s, dir, speed, angle, false)
	end
	if speed >= MC.MinSpeed then
		return pressMomentumCancel(s, velDir)
	end
	return pressSnapCut(s, dir, speed, angle, false)
end

local function pressBurst(s: State, dir: Vector3, hasDir: boolean, env: Env): boolean
	if s.holding then
		return false
	end
	if s.mode == "Recover" or s.mode == "DiveSlide" then
		return tryPop(s, "Burst", dir, hasDir, env)
	end
	if s.mode ~= "Ground" and s.mode ~= "Landing" then
		return false
	end
	local now = s.now
	if now < s.restartLockUntil then
		return false
	end
	if plantTooEarly(s) then
		s.restartLockUntil = now + MC.EarlyLockout
		feedback(s, "PlantEarly", MC.WindowOpen - (now - s.plantAt))
		return false
	end
	if not isReady(s, "BurstStep") then
		feedback(s, "Cooldown", (s.ready.BurstStep or 0) - now)
		return false
	end
	local d = if hasDir then dir else velDirOr(s, facingOr(env))
	if inPlantWindow(s) then
		local q = if (now - s.plantAt) <= MC.PerfectUntil and not s.plantGassed then Q.Perfect else Q.Clean
		return doBurst(s, d, true, q)
	end
	return doBurst(s, d, false, nil)
end

local function armPrecision(s: State, env: Env): boolean
	local now = s.now
	if now < s.precisionLockUntil or s.precisionArmedAt ~= nil then
		return false
	end
	local ttl = env.timeToLand
	if ttl ~= nil and ttl <= PL.EarlyWindow then
		s.precisionArmedAt = now
		return true
	end
	s.precisionLockUntil = now + PL.Lockout
	feedback(s, "LandingEarly", ttl or -1)
	return false
end

local function pressSlide(s: State, env: Env): boolean
	if s.holding then
		return false
	end
	local now = s.now
	if s.mode == "Air" or s.mode == "Dive" then
		return armPrecision(s, env)
	end
	-- Late Precision Landing (pressed just after touchdown).
	if now <= s.lateLandingUntil then
		if s.mode == "Landing" and not s.landedFromDive then
			s.vel = s.landingVel * PL.Retention.Clean
			setMode(s, "Ground")
			s.lateLandingUntil = 0
			emit(s, "PrecisionLanding", Q.Clean, velDirOr(s, FORWARD), "Late")
			feedback(s, "LandingOffset", -(now - s.landedAt))
			return true
		elseif s.mode == "DiveSlide" and s.landedFromDive then
			s.vel = s.landingVel * RO.Retention.Clean
			s.lateLandingUntil = 0
			enterRecover(s, RO.RecoverTime)
			emit(s, "PrecisionLanding", Q.Clean, velDirOr(s, s.diveDir), "RollOut")
			feedback(s, "LandingOffset", -(now - s.landedAt))
			return true
		end
	end
	if s.mode ~= "Ground" and s.mode ~= "Landing" then
		return false
	end
	if not isReady(s, "Slide") then
		return false
	end
	local speed = s.vel.Magnitude
	if speed < SL.MinSpeed then
		return false
	end
	local q = if s.exertion < SL.Cost then Q.Gassed else Q.Clean
	local newSpeed = speed
	if q ~= Q.Gassed and speed < SL.BoostCeiling then
		newSpeed = math.min(speed + SL.Boost, SL.BoostCeiling)
	end
	spend(s, SL.Cost)
	setCooldown(s, "Slide")
	s.vel = (s.vel / speed) * newSpeed
	cancelTransients(s)
	setMode(s, "Slide")
	emit(s, "Slide", q, s.vel / newSpeed, nil)
	return true
end

local function pressDive(s: State, dir: Vector3, hasDir: boolean, env: Env): boolean
	if s.holding then
		return false
	end
	local now = s.now
	local groundish = s.mode == "Ground" or s.mode == "Landing" or s.mode == "Slide"
	local air = s.mode == "Air"
	if not groundish and not air then
		return false
	end
	if air and s.airDiveUsed then
		return false
	end
	if not isReady(s, "Dive") then
		feedback(s, "Cooldown", (s.ready.Dive or 0) - now)
		return false
	end
	local speed = s.vel.Magnitude
	local d = if hasDir then dir else velDirOr(s, facingOr(env))
	local last = s.lastTech
	local chained = last ~= nil
		and (last == "SnapCut" or last == "BurstStep" or last == "SlideCut" or last == "AirRedirect" or last == "RecoveryChain")
		and now - s.lastTechAt <= DV.ChainWindow
	local q: string
	if s.exertion < DV.Cost then
		q = Q.Gassed
	elseif chained then
		q = Q.Perfect
	else
		q = Q.Clean
	end
	spend(s, DV.Cost)
	setCooldown(s, "Dive")
	if groundish then
		local hs: number
		if q == Q.Gassed then
			hs = math.clamp(speed, DV.GassedMin, DV.GassedMax)
		else
			hs = math.clamp(math.max(speed + DV.GroundBonus, DV.GroundMin), DV.GroundMin, DV.GroundMax)
		end
		s.vel = d * hs
		cancelTransients(s)
		setMode(s, "Dive")
		s.airStart = now
		s.groundLostAt = nil
		queueJump(s, DV.GroundVertical)
	else
		local nv = VecMath.clampMagnitude(s.vel + d * DV.AirBoost, math.max(DV.AirMax, speed))
		s.vel = nv
		s.airDiveUsed = true
		setMode(s, "Dive")
		queueVertical(s, math.min(env.actualVel.Y + DV.AirVertical, DV.MaxVertical))
	end
	s.takeoffSpeed = s.vel.Magnitude
	s.diveDir = velDirOr(s, d)
	emit(s, "Dive", q, s.diveDir, if air then "Air" else nil)
	return true
end

---------------------------------------------------------------------------
-- public API
---------------------------------------------------------------------------

function MovementSim.press(s: State, action: Action, input: Input, env: Env): boolean
	if s.frozen or s.mode == "Frozen" then
		return false
	end
	local wishMag = input.move.Magnitude
	local hasDir = wishMag > 0.2
	local dir = if hasDir then VecMath.flatUnit(input.move) else Vector3.zero
	if action == "Jump" then
		return pressJump(s, dir, hasDir, env)
	elseif action == "Cut" then
		return pressCut(s, dir, hasDir, env)
	elseif action == "Burst" then
		return pressBurst(s, dir, hasDir, env)
	elseif action == "Slide" then
		return pressSlide(s, env)
	elseif action == "Dive" then
		return pressDive(s, dir, hasDir, env)
	end
	return false
end

-- Called by the catch controller when the player reaches while airborne.
function MovementSim.noteAerialReach(s: State, dir: Vector3): boolean
	if (s.mode == "Air" or s.mode == "Dive") and not s.aerialReachUsed then
		s.aerialReachUsed = true
		emit(s, "AerialReach", Q.Clean, VecMath.flatUnit(dir), nil)
		return true
	end
	return false
end

function MovementSim.setFrozen(s: State, frozen: boolean)
	s.frozen = frozen
	if frozen then
		s.vel = Vector3.zero
		cancelTransients(s)
		setMode(s, "Frozen")
	elseif s.mode == "Frozen" then
		setMode(s, "Ground")
	end
end

function MovementSim.setHolding(s: State, holding: boolean, grounded: boolean)
	if holding then
		s.holding = true
		s.holdHopped = false
		s.holdStart = s.now
		s.holdPhase = if grounded and s.mode ~= "Air" and s.mode ~= "Dive" then "Decel" else "Air"
		s.burstUntil = 0
		s.plantAt = 0
		s.plantEnd = 0
		s.jabUntil = 0
		s.soldUntil = 0
	else
		s.holding = false
		s.holdPhase = "None"
		s.holdHopped = false
	end
end

function MovementSim.isAirborne(s: State): boolean
	return s.mode == "Air" or s.mode == "Dive"
end

-- 0 = just used, 1 = ready.
function MovementSim.readiness(s: State, tech: string): number
	local cd = (Config.TechCooldowns :: any)[tech] or 0
	if cd <= 0 then
		return 1
	end
	local readyAt = s.ready[tech] or -math.huge
	return math.clamp(1 - (readyAt - s.now) / cd, 0, 1)
end

function MovementSim.step(s: State, input: Input, env: Env, dt: number): Output
	s.now += dt
	local now = s.now
	local landed, tookOff = false, false

	-- 1. ground / air transitions -------------------------------------------
	if s.mode == "Air" or s.mode == "Dive" then
		if env.grounded and now - s.airStart > 0.08 then
			land(s)
			landed = true
		end
	elseif s.mode ~= "Frozen" then
		if not env.grounded then
			if s.groundLostAt == nil then
				s.groundLostAt = now
			end
			if now - (s.groundLostAt :: number) > Config.CoyoteTime then
				enterAir(s)
				tookOff = true
			end
		else
			s.groundLostAt = nil
		end
	end

	-- 2. collision reconciliation: if something solid holds us back for a
	-- moment, stop accumulating phantom speed against it.
	local simSpeed = s.vel.Magnitude
	if simSpeed > 6 and s.mode ~= "Frozen" then
		local along = VecMath.flat(env.actualVel):Dot(s.vel / simSpeed)
		if along < simSpeed * 0.5 - 2 then
			if s.blockedSince == nil then
				s.blockedSince = now
			elseif now - (s.blockedSince :: number) > 0.12 then
				s.vel = VecMath.flat(env.actualVel)
				s.blockedSince = nil
				s.burstUntil = 0
			end
		else
			s.blockedSince = nil
		end
	else
		s.blockedSince = nil
	end

	-- 3. per-mode velocity ------------------------------------------------------
	local wish = VecMath.flat(input.move)
	local wishMag = math.min(wish.Magnitude, 1)
	local top = topSpeed(s, input.sprint)
	local mode = s.mode

	if s.frozen or mode == "Frozen" then
		s.vel = Vector3.zero
	elseif s.holding and (mode == "Ground" or mode == "Landing") then
		updateHolding(s, wish, env, dt)
		if mode == "Landing" and now >= s.landingUntil then
			setMode(s, "Ground")
		end
	elseif mode == "Ground" or mode == "Landing" then
		if now < s.burstUntil then
			s.vel = s.burstDir * s.burstSpeed
		elseif now < s.plantEnd then
			s.vel = VecMath.moveToward(s.vel, Vector3.zero, s.plantDecel * dt)
		elseif now >= s.jabUntil then
			-- (during a jab step the player is committed: no steering)
			local lat = if mode == "Landing" then Config.LandingSteer else 1
			s.vel = MovementSim.steerGround(s.vel, wish, top, dt, lat)
		end
		if mode == "Landing" and now >= s.landingUntil then
			setMode(s, "Ground")
		end
		if s.plantAt > 0 and now - s.plantAt > MC.WindowClose then
			s.plantAt = 0
		end
	elseif mode == "Air" then
		if not s.holding then
			s.vel = steerAir(s, wish, dt)
		end
	-- (Dive: a commitment, no steering; Air Redirect is the only adjustment)
	elseif mode == "Slide" then
		local speed = s.vel.Magnitude
		local newSpeed = math.max(0, speed - SL.Friction * dt)
		local d = velDirOr(s, s.diveDir)
		if not s.holding and wishMag > 0.05 then
			d = VecMath.rotateToward(d, VecMath.flatUnit(wish), SL.SteerRate * dt)
		end
		s.vel = d * newSpeed
		if newSpeed < SL.ExitSpeed or now - s.modeStart > SL.MaxTime then
			setMode(s, "Ground")
		end
	elseif mode == "DiveSlide" then
		local speed = s.vel.Magnitude
		local newSpeed = math.max(0, speed - DS.Friction * dt)
		s.vel = velDirOr(s, s.diveDir) * newSpeed
		if newSpeed < DS.StopSpeed or now - s.modeStart > DS.MaxTime then
			enterRecover(s, RC.Time)
		end
	elseif mode == "Recover" then
		s.vel = VecMath.moveToward(s.vel, Vector3.zero, RC.Decel * dt)
		if now >= s.recoverUntil then
			setMode(s, "Ground")
		end
	end

	-- 4. exertion ---------------------------------------------------------------
	local speedNow = s.vel.Magnitude
	local sprinting = input.sprint
		and wishMag > 0.05
		and speedNow > Config.JogSpeed + 0.5
		and (s.mode == "Ground" or s.mode == "Landing")
	if sprinting then
		s.exertion = math.max(0, s.exertion - Config.SprintDrain * dt)
		s.regenAt = math.max(s.regenAt, now + Config.ExertionRegenDelay * 0.5)
	elseif now >= s.regenAt then
		s.exertion = math.min(Config.ExertionMax, s.exertion + Config.ExertionRegen * dt)
	end

	-- 5. running-line commitment (feeds Snap Cut quality) -------------------
	if s.mode == "Ground" and not s.holding then
		if speedNow > 10 then
			local d = s.vel / speedNow
			if s.commitDir:Dot(d) < math.cos(math.rad(Config.CommitAngle)) then
				s.commitDir = d
				s.commitSince = now
			end
		else
			s.commitSince = now
		end
	end

	-- 6. hard safety cap ----------------------------------------------------------
	s.vel = VecMath.clampMagnitude(VecMath.flat(s.vel), Config.HardCap)

	local out: Output = {
		vel = s.vel,
		setVertical = s.pendingVertical,
		jump = s.pendingJump,
		events = s.pendingEvents,
		feedback = s.pendingFeedback,
		pivotEstablished = s.pendingPivot,
		landed = landed,
		tookOff = tookOff,
	}
	s.pendingVertical = nil
	s.pendingJump = false
	s.pendingEvents = {}
	s.pendingFeedback = {}
	s.pendingPivot = false
	return out
end

return MovementSim
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Net — one place that names every remote and replicated-state folder.

	The server creates everything in Net.init(); clients wait for it. Remotes
	are coarse and event-driven (a technique, a throw, a catch claim) — there is
	no per-frame client->server traffic except the optional unreliable
	MarkAim stream while a defender holds Mark Stance (10 Hz).

	Client -> server
	  Tech        (events: {{tech, quality, dir, t, info}}, mode)   validated, replicated as pose attributes
	  ThrowCharge (throwType)                                        windup pose for everyone
	  Throw       (params)                                           server computes the launch itself
	  Fake        (throwType)
	  Catch       (discId, clientServerTime, zoneKind, reachDir)      claim, validated with lag compensation
	  Reach       (dir)                                              opens the reach window server-side
	  MarkStance  (on, stance)
	  MarkAim     (pitch)          [unreliable]
	  Action      (kind, payload)                                    votes, training, settings, cosmetics
	Server -> client
	  Notify, Highlight, CatchResult, Profile, Summary, Feedback, Effect, Combo
	Replicated state (attributes, late-join safe)
	  ReplicatedStorage.UBState   match phase, score, clock, possession, stall
	  ReplicatedStorage.UBDiscs   one Configuration per disc (flight launch params)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

Net.FolderName = "UBRemotes"
Net.StateName = "UBState"
Net.DiscsName = "UBDiscs"

Net.Events = {
	"Tech",
	"ThrowCharge",
	"Throw",
	"Fake",
	"Catch",
	"Reach",
	"MarkStance",
	"Action",
	"Notify",
	"Highlight",
	"CatchResult",
	"Profile",
	"Summary",
	"Feedback",
	"Effect",
	"Combo",
}

Net.Unreliable = { "MarkAim" }

Net.Functions = { "GetProfile", "GetLeaderboard" }

local folder: Folder? = nil

local function ensureChild(parent: Instance, className: string, name: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst
end

function Net.init()
	assert(RunService:IsServer(), "Net.init is server-only")
	local f = ensureChild(ReplicatedStorage, "Folder", Net.FolderName) :: Folder
	for _, name in Net.Events do
		ensureChild(f, "RemoteEvent", name)
	end
	for _, name in Net.Unreliable do
		ensureChild(f, "UnreliableRemoteEvent", name)
	end
	for _, name in Net.Functions do
		ensureChild(f, "RemoteFunction", name)
	end
	ensureChild(ReplicatedStorage, "Folder", Net.StateName)
	ensureChild(ReplicatedStorage, "Folder", Net.DiscsName)
	folder = f
end

local function getFolder(): Folder
	if folder then
		return folder :: Folder
	end
	local f = ReplicatedStorage:WaitForChild(Net.FolderName, 60) :: Folder
	assert(f, "UBRemotes folder missing (is the server running?)")
	folder = f
	return f
end

function Net.event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.unreliable(name: string): UnreliableRemoteEvent
	return getFolder():WaitForChild(name) :: UnreliableRemoteEvent
end

function Net.func(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

function Net.state(): Folder
	return ReplicatedStorage:WaitForChild(Net.StateName) :: Folder
end

function Net.discs(): Folder
	return ReplicatedStorage:WaitForChild(Net.DiscsName) :: Folder
end

-- Server time shared by every machine (used for disc flights and windows).
function Net.now(): number
	return workspace:GetServerTimeNow()
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Rules</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CatchGeometry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CatchGeometry — readable, deterministic catch and block volumes.

	A player's catch envelope is a small set of capsules derived from their
	root position, facing and movement state:
	  Secure   sphere at the chest (always on; drops low while sliding)
	  Reach    capsule from the near shoulder along the aim direction, active
	           for a short window after pressing Reach (also used airborne for
	           the Aerial Catch Adjustment)
	  Dive     long capsule from the chest along the dive direction (Layout)

	A disc inside the inner part of a zone is a Clean catch; near the rim it is
	a Fingertip catch. Fingertip catches of fast or contested discs bobble —
	an explainable rule, not a dice roll.
]]

local Shared = script.Parent.Parent
local DiscConfig = require(Shared.Config.Disc)
local VecMath = require(Shared.Util.VecMath)

local C = DiscConfig.Catch
local M = DiscConfig.Mark

local CatchGeometry = {}

export type Zone = {
	kind: string, -- "Secure" | "Reach" | "Dive"
	a: Vector3,
	b: Vector3,
	radius: number,
}

export type BodyState = {
	root: Vector3,
	facing: Vector3, -- horizontal unit
	reaching: boolean,
	reachDir: Vector3?,
	diving: boolean,
	diveDir: Vector3?,
	sliding: boolean,
}

local UP = Vector3.new(0, 1, 0)

function CatchGeometry.zones(body: BodyState): { Zone }
	local zones: { Zone } = {}
	local facing = VecMath.flatUnit(body.facing)
	if facing.Magnitude < 0.5 then
		facing = Vector3.new(0, 0, -1)
	end
	local chest = body.root + UP * C.ChestHeight + facing * 0.4
	if body.sliding then
		chest -= UP * C.SlideDrop
	end
	table.insert(zones, { kind = "Secure", a = chest, b = chest, radius = C.SecureRadius })

	if body.reaching and body.reachDir then
		local dir = VecMath.safeUnit(body.reachDir, facing)
		local right = Vector3.new(-facing.Z, 0, facing.X)
		local side = if dir:Dot(right) >= 0 then 1 else -1
		local shoulder = body.root + UP * C.ShoulderHeight + right * (C.ShoulderWidth * side)
		table.insert(zones, {
			kind = "Reach",
			a = shoulder,
			b = shoulder + dir * C.ReachLength,
			radius = C.ReachRadius,
		})
	end

	if body.diving and body.diveDir then
		local dir = VecMath.safeUnit(body.diveDir, facing)
		local start = body.root + UP * 0.2
		table.insert(zones, {
			kind = "Dive",
			a = start,
			b = start + dir * C.DiveLength,
			radius = C.DiveRadius,
		})
	end
	return zones
end

function CatchGeometry.coreDistance(zone: Zone, p: Vector3): (number, Vector3)
	local core = VecMath.closestOnSegment(zone.a, zone.b, p)
	return (p - core).Magnitude, core
end

export type Evaluation = {
	zone: Zone,
	distance: number, -- distance from disc to the zone core
	depth: number, -- 0 = core, 1 = rim
	quality: string, -- "Clean" | "Fingertip"
	hand: Vector3,
}

-- Best zone containing point p (disc centre), or nil. `slack` widens every
-- zone (server-side latency tolerance).
function CatchGeometry.evaluate(zones: { Zone }, p: Vector3, slack: number?): Evaluation?
	local extra = slack or 0
	local best: Evaluation? = nil
	for _, z in zones do
		local d, core = CatchGeometry.coreDistance(z, p)
		local r = z.radius + DiscConfig.Physics.Radius * 0.5
		if d <= r + extra then
			local depth = math.clamp(d / r, 0, 1)
			if best == nil or depth < (best :: Evaluation).depth then
				best = {
					zone = z,
					distance = d,
					depth = depth,
					quality = if depth <= C.CleanFraction then "Clean" else "Fingertip",
					hand = core,
				}
			end
		end
	end
	return best
end

export type Claim = {
	id: number,
	team: string,
	t: number,
	depth: number,
	quality: string,
	relativeSpeed: number,
}

export type Resolution = {
	winner: Claim,
	contested: boolean,
	bobble: boolean,
	reason: string,
}

-- Picks the winning claim. Earliest touch wins; touches within ContestWindow
-- of each other are a contest won by the cleaner hand position. A fingertip
-- winner in a contest, or a fingertip catch of a very fast disc, bobbles.
function CatchGeometry.resolve(claims: { Claim }): Resolution?
	if #claims == 0 then
		return nil
	end
	local sorted = table.clone(claims)
	table.sort(sorted, function(x, y)
		if x.t ~= y.t then
			return x.t < y.t
		end
		return x.depth < y.depth
	end)
	local first = sorted[1]
	local contenders = {}
	for _, c in sorted do
		if c.t - first.t <= C.ContestWindow then
			table.insert(contenders, c)
		end
	end
	local winner = contenders[1]
	for _, c in contenders do
		if c.depth < winner.depth - 1e-6 then
			winner = c
		end
	end
	local contested = false
	for _, c in contenders do
		if c ~= winner and c.team ~= winner.team then
			contested = true
		end
	end
	local bobble = false
	local reason = winner.quality
	if winner.quality == "Fingertip" then
		if contested then
			bobble = true
			reason = "Fingertip under pressure"
		elseif winner.relativeSpeed > C.BobbleSpeed then
			bobble = true
			reason = "Fingertip on a fast disc"
		end
	end
	return { winner = winner, contested = contested, bobble = bobble, reason = reason }
end

export type MarkStance = "Relaxed" | "Low" | "High"

-- Is point p inside a marker's hand zone? `toward` points from the marker to
-- the thrower. Low stance = wide hands at waist/chest; High = narrower, above
-- the head. Jumping lifts whichever zone is active.
function CatchGeometry.inMarkZone(
	markerRoot: Vector3,
	groundY: number,
	toward: Vector3,
	stance: MarkStance,
	jumpHeight: number,
	p: Vector3
): boolean
	local fwd = VecMath.flatUnit(toward)
	if fwd.Magnitude < 0.5 then
		return false
	end
	if stance == "Relaxed" then
		local chest = markerRoot + UP * C.ChestHeight
		return (p - chest).Magnitude <= M.RelaxedRadius
	end
	local right = Vector3.new(-fwd.Z, 0, fwd.X)
	local rel = p - markerRoot
	local depth = rel:Dot(fwd)
	local lateral = math.abs(rel:Dot(right))
	local height = p.Y - groundY - math.max(jumpHeight, 0)
	local band = if stance == "High" then M.HighY else M.LowY
	local halfW = if stance == "High" then M.HighHalfWidth else M.LowHalfWidth
	return depth >= M.DepthMin and depth <= M.DepthMax and lateral <= halfW and height >= band[1] and height <= band[2]
end

return CatchGeometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ComboEvaluator</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ComboEvaluator — scores movement chains so that difficulty, variety and
	timing matter and spam does not.

	  event score  = base(tech) * quality * variety
	                 quality: Perfect 1.5, Clean 1.0, Sloppy 0.5, Gassed 0.3
	                 variety: same as previous 0.25, in last three 0.6, new 1.0
	  chain score  = sum(event scores) * length bonus * unique bonus
	                 length bonus  1 + 0.2 per extra scoring tech (max x3)
	                 unique bonus  1 + 0.08 per distinct tech beyond the first (max x1.4)

	A chain ends after ChainWindow seconds without a technique. Chains only
	pay out (XP, highlights) when CONVERTED into a play — a catch, an
	interception, a block — during the chain or within ConvertWindow after it.
	Pure movement spam shows labels on screen and nothing else.
]]

local Shared = script.Parent.Parent
local MovementConfig = require(Shared.Config.Movement)

local ComboEvaluator = {}

ComboEvaluator.ChainWindow = MovementConfig.ChainWindow
ComboEvaluator.ConvertWindow = 1.25

local QUALITY_MULT: { [string]: number } = {
	Perfect = 1.5,
	Clean = 1.0,
	Sloppy = 0.5,
	Gassed = 0.3,
}

ComboEvaluator.Tiers = {
	{ min = 2600, name = "BREAKPOINT" },
	{ min = 1600, name = "FILTHY" },
	{ min = 900, name = "SLICK" },
	{ min = 400, name = "NICE" },
}

export type Entry = {
	tech: string,
	quality: string,
	t: number,
	score: number,
}

export type Chain = {
	entries: { Entry },
	raw: number,
	scoring: number,
	unique: { [string]: boolean },
	uniqueCount: number,
	startT: number,
	lastT: number,
}

export type Summary = {
	score: number,
	length: number,
	uniqueCount: number,
	techs: { string },
	tier: string?,
	perfects: number,
	converted: boolean,
	payoff: string?,
}

export type Tracker = {
	chain: Chain?,
	lastFinished: Summary?,
	lastFinishedAt: number,
}

function ComboEvaluator.newTracker(): Tracker
	return { chain = nil, lastFinished = nil, lastFinishedAt = -math.huge }
end

local function newChain(t: number): Chain
	return { entries = {}, raw = 0, scoring = 0, unique = {}, uniqueCount = 0, startT = t, lastT = t }
end

function ComboEvaluator.total(c: Chain): number
	local lengthBonus = math.min(3, 1 + 0.2 * math.max(0, c.scoring - 1))
	local uniqueBonus = math.min(1.4, 1 + 0.08 * math.max(0, c.uniqueCount - 1))
	return math.floor(c.raw * lengthBonus * uniqueBonus + 0.5)
end

function ComboEvaluator.tier(score: number): string?
	for _, t in ComboEvaluator.Tiers do
		if score >= t.min then
			return t.name
		end
	end
	return nil
end

local function summarize(c: Chain, converted: boolean, payoff: string?): Summary
	local techs = {}
	local perfects = 0
	for _, e in c.entries do
		table.insert(techs, e.tech)
		if e.quality == "Perfect" then
			perfects += 1
		end
	end
	local score = ComboEvaluator.total(c)
	if converted then
		score *= 2
	end
	return {
		score = score,
		length = c.scoring,
		uniqueCount = c.uniqueCount,
		techs = techs,
		tier = ComboEvaluator.tier(score),
		perfects = perfects,
		converted = converted,
		payoff = payoff,
	}
end

-- Closes the active chain if it has timed out. Returns its summary.
function ComboEvaluator.expire(tr: Tracker, now: number): Summary?
	local c = tr.chain
	if c and now - c.lastT > ComboEvaluator.ChainWindow then
		tr.chain = nil
		local s = summarize(c, false, nil)
		tr.lastFinished = s
		tr.lastFinishedAt = c.lastT
		return s
	end
	return nil
end

-- Adds a technique; returns the points it added (before chain bonuses) and
-- the chain's running total.
function ComboEvaluator.add(tr: Tracker, tech: string, quality: string, t: number): (number, number)
	ComboEvaluator.expire(tr, t)
	local c = tr.chain
	if c == nil then
		c = newChain(t)
		tr.chain = c
	end
	local chain = c :: Chain
	local base = (MovementConfig.ComboPoints :: any)[tech] or 0
	local variety = 1.0
	local n = #chain.entries
	if base > 0 then
		local lastScoring: Entry? = nil
		local recent = 0
		for i = n, 1, -1 do
			local e = chain.entries[i]
			if ((MovementConfig.ComboPoints :: any)[e.tech] or 0) > 0 then
				if lastScoring == nil then
					lastScoring = e
				end
				recent += 1
				if e.tech == tech and recent <= 3 and variety > 0.6 then
					variety = 0.6
				end
				if recent >= 3 then
					break
				end
			end
		end
		if lastScoring and lastScoring.tech == tech then
			variety = 0.25
		end
	end
	local score = base * (QUALITY_MULT[quality] or 1) * variety
	table.insert(chain.entries, { tech = tech, quality = quality, t = t, score = score })
	if base > 0 then
		chain.scoring += 1
		if not chain.unique[tech] then
			chain.unique[tech] = true
			chain.uniqueCount += 1
		end
	end
	chain.raw += score
	chain.lastT = t
	return score, ComboEvaluator.total(chain)
end

-- A meaningful play happened (catch, interception, block). Converts the active
-- chain, or one that ended within ConvertWindow. Returns the summary or nil.
function ComboEvaluator.convert(tr: Tracker, now: number, payoff: string): Summary?
	local c = tr.chain
	if c and now - c.lastT <= ComboEvaluator.ConvertWindow and c.scoring > 0 then
		tr.chain = nil
		local s = summarize(c, true, payoff)
		tr.lastFinished = s
		tr.lastFinishedAt = now
		return s
	end
	local last = tr.lastFinished
	if c == nil and last and not last.converted and now - tr.lastFinishedAt <= ComboEvaluator.ConvertWindow then
		last.converted = true
		last.payoff = payoff
		last.score *= 2
		last.tier = ComboEvaluator.tier(last.score)
		return last
	end
	return nil
end

function ComboEvaluator.active(tr: Tracker, now: number): Chain?
	local c = tr.chain
	if c and now - c.lastT <= ComboEvaluator.ChainWindow then
		return c
	end
	return nil
end

return ComboEvaluator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">FieldGeometry</string>
            <string name="Source"><![CDATA[--!strict
--[[
	FieldGeometry — boundaries, end zones and spots on an axis-aligned field.

	Layout (top view, +X = East):

	   West end zone |        playing field proper        | East end zone
	  x: -half-ez .. -half   -half .. +half             +half .. +half+ez
	  z: -width/2 .. +width/2

	Lines are part of out-of-bounds in real ultimate; here the line itself is
	treated as in-bounds for readability on a Roblox field (documented).
]]

local FieldGeometry = {}

export type Side = "East" | "West"

export type Field = {
	center: Vector3,
	groundY: number,
	width: number,
	length: number, -- playing field proper
	endZone: number,
	brick: number, -- distance of the brick mark from the goal line
	halfLength: number,
	halfWidth: number,
}

export type Spec = {
	center: Vector3,
	width: number,
	length: number,
	endZone: number,
	brick: number?,
}

function FieldGeometry.new(spec: Spec): Field
	return {
		center = spec.center,
		groundY = spec.center.Y,
		width = spec.width,
		length = spec.length,
		endZone = spec.endZone,
		brick = spec.brick or math.floor(spec.length * 0.2),
		halfLength = spec.length / 2,
		halfWidth = spec.width / 2,
	}
end

local function localXZ(f: Field, pos: Vector3): (number, number)
	return pos.X - f.center.X, pos.Z - f.center.Z
end

function FieldGeometry.other(side: Side): Side
	return if side == "East" then "West" else "East"
end

function FieldGeometry.inBounds(f: Field, pos: Vector3): boolean
	local x, z = localXZ(f, pos)
	return math.abs(x) <= f.halfLength + f.endZone and math.abs(z) <= f.halfWidth
end

function FieldGeometry.inEndZone(f: Field, pos: Vector3, side: Side): boolean
	if not FieldGeometry.inBounds(f, pos) then
		return false
	end
	local x = pos.X - f.center.X
	if side == "East" then
		return x > f.halfLength
	end
	return x < -f.halfLength
end

-- "East" | "West" | "Field" | "Out"
function FieldGeometry.region(f: Field, pos: Vector3): string
	if not FieldGeometry.inBounds(f, pos) then
		return "Out"
	end
	if FieldGeometry.inEndZone(f, pos, "East") then
		return "East"
	elseif FieldGeometry.inEndZone(f, pos, "West") then
		return "West"
	end
	return "Field"
end

function FieldGeometry.toWorld(f: Field, x: number, z: number): Vector3
	return Vector3.new(f.center.X + x, f.groundY, f.center.Z + z)
end

-- Nearest in-bounds ground point.
function FieldGeometry.clampInBounds(f: Field, pos: Vector3, inset: number?): Vector3
	local i = inset or 1
	local x, z = localXZ(f, pos)
	local maxX = f.halfLength + f.endZone - i
	local maxZ = f.halfWidth - i
	return FieldGeometry.toWorld(f, math.clamp(x, -maxX, maxX), math.clamp(z, -maxZ, maxZ))
end

-- Point on the goal line of `side` closest to pos (in bounds).
function FieldGeometry.goalLinePoint(f: Field, pos: Vector3, side: Side): Vector3
	local _, z = localXZ(f, pos)
	local x = if side == "East" then f.halfLength else -f.halfLength
	return FieldGeometry.toWorld(f, x, math.clamp(z, -f.halfWidth + 1, f.halfWidth - 1))
end

-- Brick mark in front of the end zone on `side` (the end zone a team defends).
function FieldGeometry.brickPoint(f: Field, side: Side): Vector3
	local x = if side == "East" then f.halfLength - f.brick else -f.halfLength + f.brick
	return FieldGeometry.toWorld(f, x, 0)
end

function FieldGeometry.endZoneCenter(f: Field, side: Side): Vector3
	local x = (f.halfLength + f.endZone / 2) * (if side == "East" then 1 else -1)
	return FieldGeometry.toWorld(f, x, 0)
end

-- Where a turnover is put into play: in bounds, and pulled out of an end zone
-- onto its goal line.
function FieldGeometry.turnoverSpot(f: Field, pos: Vector3): Vector3
	local p = FieldGeometry.clampInBounds(f, pos, 1)
	local region = FieldGeometry.region(f, p)
	if region == "East" or region == "West" then
		return FieldGeometry.goalLinePoint(f, p, region :: Side)
	end
	return p
end

-- Point where the segment from -> to first leaves the field (for discs that
-- fly out of bounds). Falls back to clamping `to`.
function FieldGeometry.exitPoint(f: Field, from: Vector3, to: Vector3): Vector3
	if not FieldGeometry.inBounds(f, from) then
		return FieldGeometry.clampInBounds(f, to)
	end
	local lo, hi = 0, 1
	for _ = 1, 20 do
		local mid = (lo + hi) / 2
		local p = from:Lerp(to, mid)
		if FieldGeometry.inBounds(f, p) then
			lo = mid
		else
			hi = mid
		end
	end
	return FieldGeometry.clampInBounds(f, from:Lerp(to, lo), 1)
end

-- Evenly spaced line-up spots on a team's goal line, facing the field.
function FieldGeometry.lineup(f: Field, side: Side, count: number): { Vector3 }
	local spots = {}
	local x = if side == "East" then f.halfLength + 2 else -f.halfLength - 2
	local span = math.min(f.width - 10, count * 9)
	for i = 1, count do
		local t = if count == 1 then 0.5 else (i - 1) / (count - 1)
		local z = -span / 2 + span * t
		table.insert(spots, FieldGeometry.toWorld(f, x, z))
	end
	return spots
end

-- Unit direction (+X or -X) a team attacking `side` runs toward.
function FieldGeometry.attackDirection(side: Side): Vector3
	return if side == "East" then Vector3.new(1, 0, 0) else Vector3.new(-1, 0, 0)
end

return FieldGeometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Rating</string>
            <string name="Source"><![CDATA[--!strict
-- Team Elo for ranked matches and level math for progression. Pure.

local Shared = script.Parent.Parent
local Progression = require(Shared.Config.Progression)

local Rating = {}

function Rating.expected(ra: number, rb: number): number
	return 1 / (1 + 10 ^ ((rb - ra) / 400))
end

function Rating.teamRating(ratings: { number }): number
	if #ratings == 0 then
		return Progression.Rating.Start
	end
	local sum = 0
	for _, r in ratings do
		sum += r
	end
	return sum / #ratings
end

-- New rating for one player after a match. `won` is true/false.
-- A modest margin factor (1.0 .. 1.25) rewards decisive wins without making
-- blowouts the only way to climb.
function Rating.update(
	rating: number,
	gamesPlayed: number,
	myTeam: number,
	theirTeam: number,
	won: boolean,
	margin: number
): number
	local k = if gamesPlayed < Progression.Rating.PlacementGames then Progression.Rating.KNew else Progression.Rating.K
	local e = Rating.expected(myTeam, theirTeam)
	local s = if won then 1 else 0
	local marginFactor = 1 + math.clamp(margin, 0, 5) * 0.05
	return math.floor(rating + k * marginFactor * (s - e) + 0.5)
end

-- (level, xpIntoLevel, xpForThisLevel) from total XP.
function Rating.levelFromXp(totalXp: number): (number, number, number)
	local level = 1
	local remaining = math.max(0, totalXp)
	while level < Progression.MaxLevel do
		local need = Progression.xpForLevel(level)
		if remaining < need then
			return level, remaining, need
		end
		remaining -= need
		level += 1
	end
	return Progression.MaxLevel, 0, Progression.xpForLevel(Progression.MaxLevel)
end

-- Splits players into two teams of equal size (+-1) with the closest total
-- rating: strongest first, each to the team with the lower total that still
-- has room.
function Rating.balance(entries: { { id: number, rating: number } }): ({ number }, { number })
	local sorted = table.clone(entries)
	table.sort(sorted, function(x, y)
		return x.rating > y.rating
	end)
	local cap = math.ceil(#sorted / 2)
	local a, b = {}, {}
	local sumA, sumB = 0, 0
	for _, e in sorted do
		local toA: boolean
		if #a >= cap then
			toA = false
		elseif #b >= cap then
			toA = true
		else
			toA = sumA <= sumB
		end
		if toA then
			table.insert(a, e.id)
			sumA += e.rating
		else
			table.insert(b, e.id)
			sumB += e.rating
		end
	end
	return a, b
end

return Rating
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">RulesEngine</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RulesEngine — the sport of ultimate as a pure state machine.

	Server services report what physically happened (a throw, a catch, a
	landing, the disc touching the ground, a stall-out) and the engine decides
	what it means: completion, interception, turnover, goal, Callahan, the
	Greatest, match point, universe point. MatchService applies the outcomes to
	the world. Keeping this pure lets the whole rulebook be unit tested
	(tests/rules_spec.luau).

	Rules implemented (beginner-readable defaults, see docs/DESIGN.md):
	  - no running with the disc (enforced by movement + server pivot check)
	  - incomplete, blocked, dropped or out-of-bounds passes are turnovers
	  - a catch counts where the receiver first touches the ground; airborne
	    receivers must have left the ground in bounds
	  - catch in the end zone you attack = goal; defender intercepting in the
	    end zone they defend = Callahan (goal)
	  - airborne receiver may release before landing (the Greatest)
	  - stall-out = turnover at the thrower's feet
	  - turnovers inside an end zone are brought to its goal line
	  - teams switch direction after every goal; scored-on team receives
	  - pulls: receiving team takes it where it stops, or at the brick if it
	    lands out; touching then dropping the pull is a turnover
	  - time cap: finish the point; leader wins, tie -> universe point
]]

local Shared = script.Parent.Parent
local FieldGeometry = require(script.Parent.FieldGeometry)
local _ = Shared

local RulesEngine = {}

export type Team = string -- "A" | "B"
export type Side = FieldGeometry.Side
export type Phase = "Idle" | "Setup" | "Pull" | "Live" | "PointOver" | "MatchOver"
export type DiscMode = "None" | "Held" | "Flight" | "Ground"

export type Config = {
	pointsToWin: number,
	usePull: boolean,
}

export type Outcome = { [string]: any }

export type Pending = {
	id: number,
	team: Team,
	interception: boolean,
	assist: number?,
	pull: boolean,
}

export type State = {
	field: FieldGeometry.Field,
	config: Config,
	phase: Phase,
	score: { [string]: number },
	attack: { [string]: Side },
	offense: Team,
	holder: number?,
	holderTeam: Team?,
	disc: DiscMode,
	discSpot: Vector3?,
	flightIsPull: boolean,
	pullTouched: boolean,
	thrower: number?,
	throwerTeam: Team?,
	lastToucherTeam: Team?,
	pending: Pending?,
	passes: number,
	pointNumber: number,
	capReached: boolean,
	universe: boolean,
	winner: Team?,
}

function RulesEngine.other(t: Team): Team
	return if t == "A" then "B" else "A"
end

function RulesEngine.new(field: FieldGeometry.Field, config: Config): State
	return {
		field = field,
		config = config,
		phase = "Idle",
		score = { A = 0, B = 0 },
		attack = { A = "East", B = "West" },
		offense = "A",
		holder = nil,
		holderTeam = nil,
		disc = "None",
		discSpot = nil,
		flightIsPull = false,
		pullTouched = false,
		thrower = nil,
		throwerTeam = nil,
		lastToucherTeam = nil,
		pending = nil,
		passes = 0,
		pointNumber = 0,
		capReached = false,
		universe = false,
		winner = nil,
	}
end

function RulesEngine.defense(e: State): Team
	return RulesEngine.other(e.offense)
end

-- The end zone a team defends (the one it lines up in).
function RulesEngine.defends(e: State, team: Team): Side
	return FieldGeometry.other(e.attack[team])
end

local function setHolder(e: State, id: number, team: Team)
	e.holder = id
	e.holderTeam = team
	e.disc = "Held"
	e.discSpot = nil
end

local function clearHolder(e: State)
	e.holder = nil
	e.holderTeam = nil
end

function RulesEngine.startMatch(e: State, firstOffense: Team, offenseAttacks: Side?)
	e.score = { A = 0, B = 0 }
	local side: Side = offenseAttacks or "East"
	e.attack[firstOffense] = side
	e.attack[RulesEngine.other(firstOffense)] = FieldGeometry.other(side)
	e.offense = firstOffense
	e.pointNumber = 0
	e.capReached = false
	e.universe = false
	e.winner = nil
	e.phase = "Idle"
end

function RulesEngine.setupPoint(e: State): Outcome
	e.phase = "Setup"
	e.pointNumber += 1
	clearHolder(e)
	e.disc = "None"
	e.discSpot = nil
	e.flightIsPull = false
	e.pullTouched = false
	e.thrower = nil
	e.throwerTeam = nil
	e.lastToucherTeam = nil
	e.pending = nil
	e.passes = 0
	local defense = RulesEngine.defense(e)
	return {
		kind = "Setup",
		offense = e.offense,
		defense = defense,
		offenseLine = RulesEngine.defends(e, e.offense),
		defenseLine = RulesEngine.defends(e, defense),
		pull = e.config.usePull,
		point = e.pointNumber,
		universe = e.universe,
	}
end

function RulesEngine.beginPull(e: State, pullerId: number)
	e.phase = "Pull"
	setHolder(e, pullerId, RulesEngine.defense(e))
end

function RulesEngine.beginLive(e: State, holderId: number?)
	e.phase = "Live"
	if holderId then
		setHolder(e, holderId, e.offense)
	end
end

local function turnover(e: State, reason: string, spot: Vector3): { Outcome }
	local newOffense = if e.throwerTeam then RulesEngine.other(e.throwerTeam :: Team) else RulesEngine.other(e.offense)
	if reason == "Stall" and e.holderTeam then
		newOffense = RulesEngine.other(e.holderTeam :: Team)
	end
	e.offense = newOffense
	clearHolder(e)
	e.disc = "Ground"
	e.discSpot = FieldGeometry.turnoverSpot(e.field, spot)
	e.pending = nil
	e.passes = 0
	e.flightIsPull = false
	return { { kind = "Turnover", reason = reason, team = newOffense, spot = e.discSpot } }
end

local function scoreGoal(e: State, team: Team, scorer: number, assist: number?, callahan: boolean): { Outcome }
	local outcomes: { Outcome } = {}
	e.score[team] += 1
	e.phase = "PointOver"
	clearHolder(e)
	e.disc = "None"
	e.pending = nil
	table.insert(outcomes, {
		kind = "Goal",
		team = team,
		scorer = scorer,
		assist = if callahan then nil else assist,
		callahan = callahan,
		passes = e.passes,
		score = { A = e.score.A, B = e.score.B },
		universe = e.universe,
	})
	-- next point: scored-on team receives, both teams switch direction
	e.offense = RulesEngine.other(team)
	e.attack.A, e.attack.B = e.attack.B, e.attack.A

	local other = RulesEngine.other(team)
	local over = false
	if e.score[team] >= e.config.pointsToWin or e.universe then
		over = true
	elseif e.capReached then
		if e.score[team] ~= e.score[other] then
			over = true
		else
			e.universe = true
			table.insert(outcomes, { kind = "UniversePoint" })
		end
	elseif e.score[team] == e.config.pointsToWin - 1 and e.score[other] == e.config.pointsToWin - 1 then
		e.universe = true
		table.insert(outcomes, { kind = "UniversePoint" })
	end
	if over then
		local winner: Team = if e.score.A > e.score.B then "A" else "B"
		e.winner = winner
		e.phase = "MatchOver"
		table.insert(outcomes, { kind = "MatchOver", winner = winner, score = { A = e.score.A, B = e.score.B } })
	end
	return outcomes
end

local function checkGoal(
	e: State,
	id: number,
	team: Team,
	pos: Vector3,
	interception: boolean,
	assist: number?
): { Outcome }
	local f = e.field
	if interception and e.throwerTeam and FieldGeometry.inEndZone(f, pos, e.attack[e.throwerTeam :: Team]) then
		return scoreGoal(e, team, id, nil, true)
	end
	if FieldGeometry.inEndZone(f, pos, e.attack[team]) then
		return scoreGoal(e, team, id, assist, false)
	end
	return {}
end

-- The holder released the disc. `pos` is the thrower's position at release.
function RulesEngine.throw(e: State, id: number, pos: Vector3): { Outcome }
	if e.holder ~= id or e.disc ~= "Held" then
		return {}
	end
	local outcomes: { Outcome } = {}
	local team = e.holderTeam :: Team
	if e.phase == "Pull" then
		e.flightIsPull = true
		e.pullTouched = false
		e.phase = "Live"
		e.offense = RulesEngine.other(team)
		table.insert(outcomes, { kind = "PullReleased", id = id })
	elseif e.phase ~= "Live" then
		return {}
	end
	local pending = e.pending
	if pending and pending.id == id then
		if not FieldGeometry.inBounds(e.field, pos) then
			table.insert(outcomes, { kind = "Greatest", id = id })
		end
		e.pending = nil
	end
	clearHolder(e)
	e.disc = "Flight"
	e.thrower = id
	e.throwerTeam = team
	e.lastToucherTeam = nil
	table.insert(outcomes, { kind = "Thrown", id = id, team = team, pull = e.flightIsPull })
	return outcomes
end

-- A player touched the disc without securing it (block, tip, bobble).
function RulesEngine.touch(e: State, id: number, team: Team): { Outcome }
	if e.disc ~= "Flight" then
		return {}
	end
	e.lastToucherTeam = team
	if e.flightIsPull then
		if team == e.offense then
			e.pullTouched = true
		end
		return {}
	end
	if team ~= e.throwerTeam then
		return { { kind = "Block", id = id, team = team, thrower = e.thrower } }
	end
	return { { kind = "Tip", id = id, team = team } }
end

-- A player secured the disc. `grounded` = feet on the ground at the catch;
-- `jumpOrigin` = where an airborne catcher last left the ground.
function RulesEngine.catch(
	e: State,
	id: number,
	team: Team,
	pos: Vector3,
	grounded: boolean,
	jumpOrigin: Vector3?
): { Outcome }
	if e.disc ~= "Flight" or e.phase ~= "Live" then
		return {}
	end
	local f = e.field
	local outcomes: { Outcome } = {}

	if e.flightIsPull then
		if team ~= e.offense then
			return {}
		end
		e.flightIsPull = false
		setHolder(e, id, team)
		table.insert(outcomes, { kind = "PullCaught", id = id, team = team })
		if not grounded then
			e.pending = { id = id, team = team, interception = false, assist = nil, pull = true }
		elseif not FieldGeometry.inBounds(f, pos) then
			e.discSpot = FieldGeometry.turnoverSpot(f, pos)
			table.insert(outcomes, { kind = "Relocate", id = id, spot = e.discSpot })
		end
		return outcomes
	end

	-- an airborne catcher who jumped from out of bounds is out of bounds
	if not grounded and jumpOrigin and not FieldGeometry.inBounds(f, jumpOrigin) then
		return turnover(e, "OutOfBounds", pos)
	end
	if grounded and not FieldGeometry.inBounds(f, pos) then
		return turnover(e, "OutOfBounds", pos)
	end

	local interception = team ~= e.throwerTeam
	local assist = e.thrower
	setHolder(e, id, team)
	if interception then
		e.offense = team
		e.passes = 0
		table.insert(outcomes, { kind = "Interception", id = id, team = team, thrower = assist })
	else
		e.passes += 1
		table.insert(outcomes, { kind = "Completion", id = id, team = team, from = assist, passes = e.passes })
	end

	if grounded then
		for _, o in checkGoal(e, id, team, pos, interception, assist) do
			table.insert(outcomes, o)
		end
	else
		e.pending = { id = id, team = team, interception = interception, assist = assist, pull = false }
	end
	return outcomes
end

-- An airborne catcher touched down.
function RulesEngine.land(e: State, id: number, pos: Vector3): { Outcome }
	local p = e.pending
	if p == nil or p.id ~= id or e.holder ~= id then
		return {}
	end
	e.pending = nil
	local f = e.field
	if not FieldGeometry.inBounds(f, pos) then
		if p.pull then
			e.discSpot = FieldGeometry.turnoverSpot(f, pos)
			return { { kind = "Relocate", id = id, spot = e.discSpot } }
		end
		return turnover(e, "OutOfBounds", pos)
	end
	if p.pull then
		return {}
	end
	return checkGoal(e, id, p.team, pos, p.interception, p.assist)
end

-- The disc touched the ground (or left the playable area) without a catch.
function RulesEngine.ground(e: State, landPos: Vector3, exitPos: Vector3?): { Outcome }
	if e.disc ~= "Flight" then
		return {}
	end
	local f = e.field
	local out = not FieldGeometry.inBounds(f, landPos)
	if e.flightIsPull then
		e.flightIsPull = false
		if e.pullTouched then
			e.throwerTeam = e.offense -- the receiving team touched it last; it changes hands
			return turnover(e, "Drop", landPos)
		end
		clearHolder(e)
		e.disc = "Ground"
		local brick = false
		if out then
			e.discSpot = FieldGeometry.brickPoint(f, RulesEngine.defends(e, e.offense))
			brick = true
		else
			e.discSpot = FieldGeometry.turnoverSpot(f, landPos)
		end
		return { { kind = "PullLanded", spot = e.discSpot, brick = brick } }
	end
	local reason: string
	if out then
		reason = "OutOfBounds"
	elseif e.lastToucherTeam ~= nil and e.lastToucherTeam == e.throwerTeam then
		reason = "Drop"
	elseif e.lastToucherTeam ~= nil then
		reason = "Block"
	else
		reason = "Incomplete"
	end
	local spot = if out then (exitPos or landPos) else landPos
	return turnover(e, reason, spot)
end

function RulesEngine.pickup(e: State, id: number, team: Team): { Outcome }
	if e.disc ~= "Ground" or team ~= e.offense or e.phase ~= "Live" then
		return {}
	end
	local spot = e.discSpot
	setHolder(e, id, team)
	e.thrower = nil
	return { { kind = "Pickup", id = id, team = team, spot = spot } }
end

function RulesEngine.stall(e: State, pos: Vector3): { Outcome }
	if e.disc ~= "Held" or e.phase ~= "Live" or e.holder == nil then
		return {}
	end
	return turnover(e, "Stall", pos)
end

-- The holder vanished (left the game). Their team keeps possession at the spot.
function RulesEngine.holderLeft(e: State, pos: Vector3): { Outcome }
	if e.disc ~= "Held" then
		return {}
	end
	clearHolder(e)
	e.pending = nil
	e.disc = "Ground"
	e.discSpot = FieldGeometry.turnoverSpot(e.field, pos)
	return { { kind = "DiscDropped", spot = e.discSpot } }
end

function RulesEngine.reachCap(e: State): { Outcome }
	if e.capReached then
		return {}
	end
	e.capReached = true
	local outcomes: { Outcome } = { { kind = "CapReached" } }
	if e.phase == "PointOver" or e.phase == "Setup" or e.phase == "Idle" then
		if e.score.A ~= e.score.B then
			local winner: Team = if e.score.A > e.score.B then "A" else "B"
			e.winner = winner
			e.phase = "MatchOver"
			table.insert(outcomes, { kind = "MatchOver", winner = winner, score = { A = e.score.A, B = e.score.B } })
		else
			e.universe = true
			table.insert(outcomes, { kind = "UniversePoint" })
		end
	end
	return outcomes
end

return RulesEngine
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic xorshift32 generator. Used wherever a sequence must be
-- reproducible (training drills, bot personalities, fuzz tests). Gameplay
-- outcomes never use randomness.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { state: number }, Rng))

function Rng.new(seed: number): Rng
	local s = bit32.band(math.floor(math.abs(seed)), 0xFFFFFFFF)
	if s == 0 then
		s = 0x9E3779B9
	end
	return setmetatable({ state = s }, Rng)
end

function Rng.nextInt32(self: Rng): number
	local x = self.state
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self.state = x
	return x
end

-- Uniform in [0, 1).
function Rng.next(self: Rng): number
	return self:nextInt32() / 4294967296
end

function Rng.range(self: Rng, a: number, b: number): number
	return a + (b - a) * self:next()
end

function Rng.int(self: Rng, a: number, b: number): number
	return math.min(b, a + math.floor(self:next() * (b - a + 1)))
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal synchronous signal for communication between services/controllers.

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> (), connected: boolean }
export type Signal = typeof(setmetatable({} :: { handlers: { (...any) -> () } }, Signal))

function Signal.new(): Signal
	return setmetatable({ handlers = {} }, Signal)
end

function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
	table.insert(self.handlers, fn)
	local conn = { connected = true } :: any
	function conn.Disconnect(c)
		if not c.connected then
			return
		end
		c.connected = false
		local i = table.find(self.handlers, fn)
		if i then
			table.remove(self.handlers, i)
		end
	end
	return conn
end

function Signal.Fire(self: Signal, ...: any)
	for _, fn in table.clone(self.handlers) do
		local args = table.pack(...)
		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[Signal] handler error: " .. tostring(err))
		end
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">VecMath</string>
            <string name="Source"><![CDATA[--!strict
-- Small, allocation-light vector helpers shared by movement, catching and AI.
-- Everything here is pure math so it runs identically on client, server and in
-- the offline Lune test harness.

local VecMath = {}

local EPS = 1e-6

function VecMath.flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function VecMath.flatUnit(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	local m = f.Magnitude
	if m < EPS then
		return Vector3.zero
	end
	return f / m
end

function VecMath.safeUnit(v: Vector3, fallback: Vector3?): Vector3
	local m = v.Magnitude
	if m < EPS then
		return fallback or Vector3.zero
	end
	return v / m
end

function VecMath.clampMagnitude(v: Vector3, maxLen: number): Vector3
	local m = v.Magnitude
	if m > maxLen and m > EPS then
		return v * (maxLen / m)
	end
	return v
end

-- Moves vector `from` toward `to` by at most `maxDelta` (length of change).
function VecMath.moveToward(from: Vector3, to: Vector3, maxDelta: number): Vector3
	local d = to - from
	local m = d.Magnitude
	if m <= maxDelta or m < EPS then
		return to
	end
	return from + d * (maxDelta / m)
end

-- Unsigned angle between two horizontal directions, in degrees (0..180).
function VecMath.flatAngle(a: Vector3, b: Vector3): number
	local ax, az = a.X, a.Z
	local bx, bz = b.X, b.Z
	local dot = ax * bx + az * bz
	local cross = ax * bz - az * bx
	return math.deg(math.abs(math.atan2(cross, dot)))
end

-- Signed yaw (radians) of a horizontal direction; 0 = -Z (Roblox forward).
function VecMath.yaw(v: Vector3): number
	return math.atan2(-v.X, -v.Z)
end

function VecMath.fromYaw(yaw: number): Vector3
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

-- Rotates horizontal unit vector `dir` toward horizontal unit vector `target`
-- by at most `maxDeg` degrees. Returns a horizontal unit vector.
function VecMath.rotateToward(dir: Vector3, target: Vector3, maxDeg: number): Vector3
	local a = VecMath.yaw(dir)
	local b = VecMath.yaw(target)
	local diff = (b - a + math.pi) % (2 * math.pi) - math.pi
	local maxRad = math.rad(maxDeg)
	if math.abs(diff) <= maxRad then
		return VecMath.fromYaw(b)
	end
	return VecMath.fromYaw(a + math.sign(diff) * maxRad)
end

-- Reflects horizontal velocity off a (horizontal) wall normal.
function VecMath.reflect(v: Vector3, normal: Vector3): Vector3
	return v - normal * (2 * v:Dot(normal))
end

-- Closest point on segment [a, b] to point p.
function VecMath.closestOnSegment(a: Vector3, b: Vector3, p: Vector3): Vector3
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < EPS then
		return a
	end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return a + ab * t
end

function VecMath.lerpNumber(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Frame-rate independent exponential smoothing factor.
function VecMath.smoothAlpha(rate: number, dt: number): number
	return 1 - math.exp(-rate * dt)
end

return VecMath
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="33">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="34">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Arena</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ArenaBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ArenaBuilder — procedurally builds the field and its surroundings.

	The playing surface is identical in every arena (regulation-inspired
	proportions from Config/Modes.Fields) so spacing and muscle memory carry
	over; only the theme, lighting, wind and optional rebound walls change.
	Everything is generated from code, so the place file needs no hand-built
	geometry and every arena can be rebuilt between matches.

	Decorations are CanQuery = false so client ground/wall raycasts only ever
	see the field, the out-of-bounds surround and tagged Rebound walls.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rng = require(Shared.Util.Rng)
local Build = require(script.Parent.Build)

local ArenaBuilder = {}

export type FieldSpec = { width: number, length: number, endZone: number, brick: number }

export type Built = {
	model: Model,
	endZones: { [string]: BasePart },
	spawn: SpawnLocation,
	margin: number,
}

local MARGIN = 34
local WHITE = Color3.fromRGB(250, 250, 250)
local CONE = Color3.fromRGB(255, 110, 20)

local SKIN = {
	Color3.fromRGB(255, 220, 190),
	Color3.fromRGB(234, 184, 146),
	Color3.fromRGB(198, 140, 100),
	Color3.fromRGB(141, 92, 62),
	Color3.fromRGB(96, 62, 42),
}

local SHIRTS = {
	Color3.fromRGB(32, 140, 255),
	Color3.fromRGB(255, 120, 30),
	Color3.fromRGB(240, 240, 240),
	Color3.fromRGB(40, 40, 50),
	Color3.fromRGB(220, 60, 70),
	Color3.fromRGB(60, 190, 120),
	Color3.fromRGB(250, 210, 60),
	Color3.fromRGB(120, 90, 220),
}

local function pick<T>(rng: Rng.Rng, list: { T }): T
	return list[rng:int(1, #list)]
end

---------------------------------------------------------------------------
-- lighting
---------------------------------------------------------------------------

local function applyLighting(arena: any)
	for k, v in arena.Lighting do
		pcall(function()
			(Lighting :: any)[k] = v
		end)
	end
	local function effect(className: string, name: string, props: { [string]: any })
		local e = Lighting:FindFirstChild(name)
		if not e then
			e = Instance.new(className)
			e.Name = name
			e.Parent = Lighting
		end
		for k, v in props do
			pcall(function()
				(e :: any)[k] = v
			end)
		end
	end
	effect("Atmosphere", "UBAtmosphere", arena.Atmosphere)
	effect("ColorCorrectionEffect", "UBColor", arena.ColorCorrection)
	effect("BloomEffect", "UBBloom", arena.Bloom)
	effect("SunRaysEffect", "UBSunRays", { Intensity = if arena.Theme == "Coastal" then 0.12 else 0.04, Spread = 0.6 })
	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		sky = Instance.new("Sky")
		sky.Parent = Lighting
	end
	local s = sky :: Sky
	s.StarCount = if arena.Theme == "Rooftop" or arena.Theme == "Stadium" then 3000 else 600
	s.CelestialBodiesShown = arena.Theme ~= "Indoor"
end

---------------------------------------------------------------------------
-- the field itself
---------------------------------------------------------------------------

local function buildField(model: Model, arena: any, f: FieldSpec): { [string]: BasePart }
	local L = f.length / 2
	local E = f.endZone
	local W = f.width / 2
	local HL = L + E
	local fieldFolder = Build.folder(model, "Field")

	-- out-of-bounds surround (walkable)
	Build.part(fieldFolder, {
		Name = "Surround",
		Size = Vector3.new(2 * HL + 2 * MARGIN + 220, 1, 2 * W + 2 * MARGIN + 200),
		CFrame = CFrame.new(0, -0.5, 0),
		Material = arena.Surround.Material,
		Color = arena.Surround.Color,
		solid = true,
	})

	-- mowed stripes
	local stripeW = 20
	local count = math.ceil((2 * HL + 24) / stripeW)
	local startX = -count * stripeW / 2
	for i = 0, count - 1 do
		Build.part(fieldFolder, {
			Name = "Turf",
			Size = Vector3.new(stripeW, 0.2, 2 * W + 16),
			CFrame = CFrame.new(startX + stripeW * (i + 0.5), -0.08, 0),
			Material = arena.Ground.Material,
			Color = if i % 2 == 0 then arena.Ground.A else arena.Ground.B,
			solid = true,
		})
	end

	local lineMat = if arena.Theme == "Rooftop" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local lineColor = arena.LineColor or WHITE
	local function line(name: string, size: Vector3, cf: CFrame)
		Build.part(fieldFolder, {
			Name = name,
			Size = size,
			CFrame = cf,
			Color = lineColor,
			Material = lineMat,
		})
	end
	local y = 0.035
	line("Sideline", Vector3.new(2 * HL, 0.05, 0.6), CFrame.new(0, y, W))
	line("Sideline", Vector3.new(2 * HL, 0.05, 0.6), CFrame.new(0, y, -W))
	line("EndLine", Vector3.new(0.6, 0.05, 2 * W), CFrame.new(HL, y, 0))
	line("EndLine", Vector3.new(0.6, 0.05, 2 * W), CFrame.new(-HL, y, 0))
	line("GoalLine", Vector3.new(0.8, 0.05, 2 * W), CFrame.new(L, y, 0))
	line("GoalLine", Vector3.new(0.8, 0.05, 2 * W), CFrame.new(-L, y, 0))
	for x = -L + 20, L - 20, 20 do
		line("Hash", Vector3.new(0.4, 0.05, 2.5), CFrame.new(x, y, W - 4))
		line("Hash", Vector3.new(0.4, 0.05, 2.5), CFrame.new(x, y, -(W - 4)))
	end
	for _, sx in { 1, -1 } do
		local bx = sx * (L - f.brick)
		line("Brick", Vector3.new(3.4, 0.05, 0.5), CFrame.new(bx, y, 0) * CFrame.Angles(0, math.rad(45), 0))
		line("Brick", Vector3.new(3.4, 0.05, 0.5), CFrame.new(bx, y, 0) * CFrame.Angles(0, math.rad(-45), 0))
	end

	-- centre logo
	local logo = Build.part(fieldFolder, {
		Name = "Logo",
		Size = Vector3.new(46, 0.02, 12),
		CFrame = CFrame.new(0, 0.045, 0),
		Transparency = 1,
	})
	Build.topText(logo, "BREAKPOINT", lineColor, 0.55)

	-- end zone overlays (recoloured each point by MatchService)
	local endZones: { [string]: BasePart } = {}
	for _, side in { "East", "West" } do
		local sx = if side == "East" then 1 else -1
		local ez = Build.part(fieldFolder, {
			Name = "EndZone" .. side,
			Size = Vector3.new(E - 0.8, 0.04, 2 * W - 0.6),
			CFrame = CFrame.new(sx * (L + E / 2), 0.03, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(200, 200, 210),
			Transparency = 0.86,
		})
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Label"
		gui.Face = Enum.NormalId.Top
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 12
		gui.LightInfluence = 0.4
		gui.Parent = ez
		local text = Instance.new("TextLabel")
		text.Name = "Text"
		text.BackgroundTransparency = 1
		text.Size = UDim2.fromScale(1, 0.5)
		text.Position = UDim2.fromScale(0, 0.25)
		text.Rotation = if side == "East" then -90 else 90
		text.Font = Enum.Font.GothamBlack
		text.TextScaled = true
		text.TextTransparency = 0.45
		text.TextColor3 = Color3.new(1, 1, 1)
		text.Text = ""
		text.Parent = gui
		CollectionService:AddTag(ez, "UBEndZone")
		ez:SetAttribute("Side", side)
		endZones[side] = ez
	end

	-- pylons
	for _, cx in { L, -L, HL, -HL } do
		for _, cz in { W, -W } do
			Build.part(fieldFolder, {
				Name = "Cone",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.8, 1.3, 1.3),
				CFrame = CFrame.new(cx, 0.9, cz) * CFrame.Angles(0, 0, math.rad(90)),
				Color = CONE,
				Material = Enum.Material.Neon,
			})
		end
	end

	-- invisible boundary
	local wallH = 60
	local walls = Build.folder(model, "Bounds")
	for _, sx in { 1, -1 } do
		Build.part(walls, {
			Name = "BoundX",
			Size = Vector3.new(2, wallH, 2 * W + 2 * MARGIN + 4),
			CFrame = CFrame.new(sx * (HL + MARGIN), wallH / 2, 0),
			Transparency = 1,
			solid = true,
		})
		Build.part(walls, {
			Name = "BoundZ",
			Size = Vector3.new(2 * HL + 2 * MARGIN + 4, wallH, 2),
			CFrame = CFrame.new(0, wallH / 2, sx * (W + MARGIN)),
			Transparency = 1,
			solid = true,
		})
	end
	Build.part(walls, {
		Name = "Ceiling",
		Size = Vector3.new(2 * HL + 2 * MARGIN + 4, 2, 2 * W + 2 * MARGIN + 4),
		CFrame = CFrame.new(0, wallH + 1, 0),
		Transparency = 1,
		solid = true,
	})

	if arena.Rebound then
		for i, sz in { 1, -1 } do
			local wall = Build.part(walls, {
				Name = "Rebound" .. i,
				Size = Vector3.new(2 * L, 18, 1),
				CFrame = CFrame.new(0, 9, sz * (W + 7)),
				Material = Enum.Material.Neon,
				Color = arena.LineColor,
				Transparency = 0.55,
				solid = true,
			})
			CollectionService:AddTag(wall, "Rebound")
		end
	end
	return endZones
end

---------------------------------------------------------------------------
-- surroundings
---------------------------------------------------------------------------

local function crowdFigure(parent: Instance, rng: Rng.Rng, pos: Vector3, facing: Vector3)
	local fan = Instance.new("Model")
	fan.Name = "Fan"
	local cf = CFrame.lookAt(pos, pos + facing)
	local torso = Build.part(fan, {
		Name = "Torso",
		Size = Vector3.new(1.5, 1.8, 0.9),
		CFrame = cf * CFrame.new(0, 0.9, 0),
		Color = pick(rng, SHIRTS),
	})
	Build.part(fan, {
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = cf * CFrame.new(0, 2.35, 0),
		Color = pick(rng, SKIN),
	})
	fan.PrimaryPart = torso
	fan:SetAttribute("Phase", rng:next() * 6.28)
	CollectionService:AddTag(fan, "UBCrowd")
	fan.Parent = parent
end

-- Stepped stand along one side. axis = "Z" (sideline) or "X" (end).
local function stand(
	parent: Instance,
	rng: Rng.Rng,
	center: Vector3,
	length: number,
	outward: Vector3,
	rows: number,
	crowd: number,
	color: Color3,
	fanBudget: { n: number }
)
	local m = Build.model(parent, "Stand")
	local along = Vector3.new(-outward.Z, 0, outward.X)
	local rowDepth, rowRise = 3, 2
	for r = 0, rows - 1 do
		local h = rowRise * (r + 1)
		local c = center + outward * (r * rowDepth + rowDepth / 2) + Vector3.new(0, h / 2, 0)
		Build.part(m, {
			Name = "Tier",
			Size = Vector3.new(length, h, rowDepth),
			CFrame = CFrame.lookAt(c, c + outward),
			Color = if r % 2 == 0 then color else color:Lerp(Color3.new(0, 0, 0), 0.15),
			Material = Enum.Material.Concrete,
			CastShadow = true,
		})
		local seatTop = center + outward * (r * rowDepth + rowDepth / 2) + Vector3.new(0, h, 0)
		for s = -length / 2 + 2, length / 2 - 2, 3 do
			if fanBudget.n > 0 and rng:next() < crowd then
				fanBudget.n -= 1
				crowdFigure(m, rng, seatTop + along * (s + rng:range(-0.4, 0.4)), -outward)
			end
		end
	end
	-- back wall and roof edge
	local back = center + outward * (rows * rowDepth + 1) + Vector3.new(0, rows * rowRise / 2 + 3, 0)
	Build.part(m, {
		Name = "BackWall",
		Size = Vector3.new(length, rows * rowRise + 6, 2),
		CFrame = CFrame.lookAt(back, back + outward),
		Color = color:Lerp(Color3.new(0, 0, 0), 0.35),
		Material = Enum.Material.Concrete,
	})
	return m
end

local function floodlights(parent: Instance, f: FieldSpec, brightness: number, color: Color3)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local rig = Build.folder(parent, "Floodlights")
	for x = -L + 20, L - 20, 55 do
		for _, z in { -W * 0.5, W * 0.5 } do
			local p = Build.part(rig, {
				Name = "Lamp",
				Size = Vector3.new(1, 1, 1),
				CFrame = CFrame.new(x, 52, z),
				Transparency = 1,
			})
			Build.light(p, "SpotLight", {
				Face = Enum.NormalId.Bottom,
				Range = 60,
				Angle = 130,
				Brightness = brightness,
				Color = color,
				Shadows = false,
			})
		end
	end
	-- towers (visual) at the corners
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			local base = Vector3.new(sx * (L + MARGIN + 18), 0, sz * (W + MARGIN + 24))
			Build.part(rig, {
				Name = "Pole",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(80, 2.4, 2.4),
				CFrame = CFrame.new(base + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(150, 155, 165),
				Material = Enum.Material.Metal,
			})
			local headPos = base + Vector3.new(0, 82, 0)
			local head = Build.part(rig, {
				Name = "LampHead",
				Size = Vector3.new(18, 8, 2),
				CFrame = CFrame.lookAt(headPos, Vector3.new(0, 0, 0)),
				Color = Color3.fromRGB(255, 250, 235),
				Material = Enum.Material.Neon,
			})
			Build.light(head, "SpotLight", {
				Face = Enum.NormalId.Front,
				Range = 60,
				Angle = 70,
				Brightness = 3,
				Color = color,
				Shadows = false,
			})
		end
	end
end

local function scoreboard(parent: Instance, pos: Vector3, facing: Vector3)
	local board = Build.part(parent, {
		Name = "Scoreboard",
		Size = Vector3.new(56, 20, 2),
		CFrame = CFrame.lookAt(pos, pos + facing),
		Color = Color3.fromRGB(14, 16, 22),
	})
	Build.part(parent, {
		Name = "ScoreboardFrame",
		Size = Vector3.new(58, 22, 1),
		CFrame = CFrame.lookAt(pos - facing * 0.8, pos + facing),
		Color = Color3.fromRGB(90, 230, 255),
		Material = Enum.Material.Neon,
	})
	Build.part(parent, {
		Name = "ScoreboardLeg",
		Size = Vector3.new(3, pos.Y, 3),
		CFrame = CFrame.new(pos.X - facing.X * 2, pos.Y / 2, pos.Z - facing.Z * 2),
		Color = Color3.fromRGB(60, 62, 70),
		Material = Enum.Material.Metal,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Display"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Brightness = 2
	gui.Parent = board
	local function label(name: string, x: number, w: number, y: number, h: number, text: string, color: Color3)
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(x, y)
		t.Size = UDim2.fromScale(w, h)
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.TextColor3 = color
		t.Text = text
		t.Parent = gui
	end
	label("TeamA", 0.02, 0.3, 0.06, 0.25, "TIDE", Color3.fromRGB(32, 140, 255))
	label("TeamB", 0.68, 0.3, 0.06, 0.25, "BLAZE", Color3.fromRGB(255, 120, 30))
	label("ScoreA", 0.02, 0.3, 0.32, 0.55, "0", Color3.new(1, 1, 1))
	label("ScoreB", 0.68, 0.3, 0.32, 0.55, "0", Color3.new(1, 1, 1))
	label("Clock", 0.34, 0.32, 0.12, 0.3, "8:00", Color3.fromRGB(255, 220, 90))
	label("Phase", 0.34, 0.32, 0.48, 0.18, "WARMUP", Color3.fromRGB(190, 200, 215))
	label("Info", 0.34, 0.32, 0.7, 0.16, "", Color3.fromRGB(150, 160, 175))
	CollectionService:AddTag(board, "UBScoreboard")
end

local function palm(parent: Instance, rng: Rng.Rng, pos: Vector3)
	local m = Build.model(parent, "Palm")
	local height = rng:range(16, 26)
	local lean = rng:range(-0.25, 0.25)
	local segments = 6
	local top = pos
	for i = 1, segments do
		local a = pos + Vector3.new(lean * (i - 1) * height / segments, (i - 1) * height / segments, 0)
		local b = pos + Vector3.new(lean * i * height / segments, i * height / segments, 0)
		local mid = (a + b) / 2
		Build.part(m, {
			Name = "Trunk",
			Size = Vector3.new(1.2 - i * 0.08, (b - a).Magnitude + 0.2, 1.2 - i * 0.08),
			CFrame = CFrame.lookAt(mid, b) * CFrame.Angles(math.rad(90), 0, 0),
			Color = Color3.fromRGB(130, 96, 60),
			Material = Enum.Material.Wood,
		})
		top = b
	end
	for k = 0, 6 do
		local ang = k / 7 * math.pi * 2
		local dir = Vector3.new(math.cos(ang), -0.35, math.sin(ang)).Unit
		local c = top + dir * 4
		Build.part(m, {
			Name = "Frond",
			Size = Vector3.new(1.6, 0.2, 8),
			CFrame = CFrame.lookAt(c, c + dir),
			Color = Color3.fromRGB(60, 150, 70),
			Material = Enum.Material.Grass,
		})
	end
end

local function tree(parent: Instance, rng: Rng.Rng, pos: Vector3)
	local m = Build.model(parent, "Tree")
	local h = rng:range(10, 16)
	Build.part(m, {
		Name = "Trunk",
		Size = Vector3.new(1.6, h, 1.6),
		CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)),
		Color = Color3.fromRGB(110, 80, 52),
		Material = Enum.Material.Wood,
	})
	for _ = 1, 3 do
		local s = rng:range(7, 11)
		Build.part(m, {
			Name = "Canopy",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(s, s, s),
			CFrame = CFrame.new(pos + Vector3.new(rng:range(-2.5, 2.5), h + rng:range(-1, 2.5), rng:range(-2.5, 2.5))),
			Color = Color3.fromRGB(70 + rng:int(0, 30), 130 + rng:int(0, 40), 60),
			Material = Enum.Material.Grass,
		})
	end
end

local function windFlags(parent: Instance, f: FieldSpec, wind: Vector3)
	if wind.Magnitude < 0.1 then
		return
	end
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local dir = Vector3.new(wind.X, 0, wind.Z).Unit
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			local base = Vector3.new(sx * (L + 6), 0, sz * (W + 6))
			Build.part(parent, {
				Name = "FlagPole",
				Size = Vector3.new(0.4, 14, 0.4),
				CFrame = CFrame.new(base + Vector3.new(0, 7, 0)),
				Color = Color3.fromRGB(220, 220, 225),
				Material = Enum.Material.Metal,
			})
			local fc = base + Vector3.new(0, 12.6, 0) + dir * 2.2
			local flag = Build.part(parent, {
				Name = "Flag",
				Size = Vector3.new(0.1, 2.4, 4.2),
				CFrame = CFrame.lookAt(fc, fc + dir) * CFrame.Angles(0, math.rad(90), 0),
				Color = Color3.fromRGB(255, 90, 60),
			})
			flag:SetAttribute("Strength", wind.Magnitude)
			CollectionService:AddTag(flag, "UBFlag")
		end
	end
end

local function themeStadium(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	local budget = { n = math.floor(320 * arena.Crowd) }
	local color = Color3.fromRGB(58, 62, 74)
	stand(
		props,
		rng,
		Vector3.new(0, 0, W + MARGIN + 2),
		2 * L,
		Vector3.new(0, 0, 1),
		9,
		0.75 * arena.Crowd,
		color,
		budget
	)
	stand(
		props,
		rng,
		Vector3.new(0, 0, -(W + MARGIN + 2)),
		2 * L,
		Vector3.new(0, 0, -1),
		9,
		0.75 * arena.Crowd,
		color,
		budget
	)
	stand(
		props,
		rng,
		Vector3.new(L + MARGIN + 2, 0, 0),
		2 * W + 20,
		Vector3.new(1, 0, 0),
		6,
		0.6 * arena.Crowd,
		color,
		budget
	)
	floodlights(props, f, 1.4, Color3.fromRGB(255, 248, 230))
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 26, 0), Vector3.new(1, 0, 0))
	-- sideline benches in team colours
	for _, sx in { 1, -1 } do
		Build.part(props, {
			Name = "Bench",
			Size = Vector3.new(30, 1.2, 3),
			CFrame = CFrame.new(sx * 40, 0.6, -(W + 14)),
			Color = if sx > 0 then Color3.fromRGB(255, 120, 30) else Color3.fromRGB(32, 140, 255),
		})
	end
end

local function themeCoastal(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	local budget = { n = math.floor(200 * arena.Crowd) }
	stand(
		props,
		rng,
		Vector3.new(0, 0, -(W + MARGIN + 2)),
		2 * L * 0.7,
		Vector3.new(0, 0, -1),
		5,
		0.7,
		Color3.fromRGB(220, 220, 225),
		budget
	)
	-- the sea beyond the far sideline
	workspace.Terrain:FillBlock(
		CFrame.new(0, -6, W + MARGIN + 160),
		Vector3.new(2 * L + 900, 12, 260),
		Enum.Material.Water
	)
	workspace.Terrain:FillBlock(CFrame.new(0, -9, W + MARGIN + 30), Vector3.new(2 * L + 900, 6, 60), Enum.Material.Sand)
	for x = -L - 40, L + 40, 26 do
		palm(props, rng, Vector3.new(x + rng:range(-6, 6), 0, W + MARGIN + rng:range(8, 20)))
	end
	-- lifeguard tower
	local base = Vector3.new(L + MARGIN + 30, 0, W + MARGIN + 10)
	for _, o in { Vector3.new(-2, 0, -2), Vector3.new(2, 0, -2), Vector3.new(-2, 0, 2), Vector3.new(2, 0, 2) } do
		Build.part(props, {
			Name = "Leg",
			Size = Vector3.new(0.6, 10, 0.6),
			CFrame = CFrame.new(base + o + Vector3.new(0, 5, 0)),
			Color = Color3.fromRGB(240, 240, 240),
		})
	end
	Build.part(props, {
		Name = "Hut",
		Size = Vector3.new(6, 4, 6),
		CFrame = CFrame.new(base + Vector3.new(0, 12, 0)),
		Color = Color3.fromRGB(230, 70, 60),
	})
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 20, 0), Vector3.new(1, 0, 0))
end

local function themeRooftop(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	-- rooftop edge railing
	for _, sz in { 1, -1 } do
		Build.part(props, {
			Name = "Rail",
			Size = Vector3.new(2 * L + 2 * MARGIN, 0.4, 0.4),
			CFrame = CFrame.new(0, 3.6, sz * (W + MARGIN - 1)),
			Color = arena.LineColor,
			Material = Enum.Material.Neon,
		})
	end
	-- skyline ring
	local neon = {
		Color3.fromRGB(255, 80, 200),
		Color3.fromRGB(90, 230, 255),
		Color3.fromRGB(255, 200, 80),
		Color3.fromRGB(140, 120, 255),
	}
	for i = 0, 46 do
		local ang = i / 47 * math.pi * 2
		local radius = rng:range(330, 470)
		local pos = Vector3.new(math.cos(ang) * radius * 1.2, 0, math.sin(ang) * radius)
		local h = rng:range(80, 260)
		local w = rng:range(30, 60)
		Build.part(props, {
			Name = "Tower",
			Size = Vector3.new(w, h, w),
			CFrame = CFrame.new(pos + Vector3.new(0, h / 2 - 60, 0)),
			Color = Color3.fromRGB(22, 24, 36),
			Material = Enum.Material.Glass,
		})
		local strip = pick(rng, neon)
		for k = 1, 3 do
			Build.part(props, {
				Name = "Window",
				Size = Vector3.new(w + 0.4, 1.2, w + 0.4),
				CFrame = CFrame.new(pos + Vector3.new(0, -60 + h * (k / 4), 0)),
				Color = strip,
				Material = Enum.Material.Neon,
				Transparency = 0.2,
			})
		end
	end
	-- billboards
	for _, sx in { 1, -1 } do
		local p = Vector3.new(sx * (L + MARGIN + 10), 18, 0)
		local b = Build.part(props, {
			Name = "Billboard",
			Size = Vector3.new(2, 14, 44),
			CFrame = CFrame.new(p),
			Color = Color3.fromRGB(16, 16, 24),
		})
		local gui = Instance.new("SurfaceGui")
		gui.Face = if sx > 0 then Enum.NormalId.Left else Enum.NormalId.Right
		gui.LightInfluence = 0
		gui.Brightness = 3
		gui.Parent = b
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.TextColor3 = pick(rng, neon)
		t.Text = "BREAKPOINT"
		t.Parent = gui
	end
	scoreboard(props, Vector3.new(0, 30, -(W + MARGIN + 20)), Vector3.new(0, 0, 1))
end

local function themeBeach(model: Model, _arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	workspace.Terrain:FillBlock(
		CFrame.new(L + MARGIN + 150, -6, 0),
		Vector3.new(260, 12, 2 * W + 900),
		Enum.Material.Water
	)
	for _ = 1, 14 do
		local pos =
			Vector3.new(rng:range(-L, L), 0, (if rng:next() < 0.5 then 1 else -1) * (W + rng:range(14, MARGIN - 4)))
		Build.part(props, {
			Name = "Pole",
			Size = Vector3.new(0.3, 7, 0.3),
			CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0)),
			Color = Color3.new(1, 1, 1),
		})
		Build.part(props, {
			Name = "Umbrella",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 8, 8),
			CFrame = CFrame.new(pos + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = pick(rng, SHIRTS),
		})
	end
	for x = -L, L, 40 do
		palm(props, rng, Vector3.new(x, 0, -(W + MARGIN + 16)))
	end
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 18, 0), Vector3.new(1, 0, 0))
end

local function themeIndoor(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	local hx, hz, h = L + MARGIN + 30, W + MARGIN + 30, 70
	local wallColor = Color3.fromRGB(30, 34, 42)
	for _, sx in { 1, -1 } do
		Build.part(props, {
			Name = "Wall",
			Size = Vector3.new(2, h, 2 * hz),
			CFrame = CFrame.new(sx * hx, h / 2, 0),
			Color = wallColor,
		})
		Build.part(props, {
			Name = "Wall",
			Size = Vector3.new(2 * hx, h, 2),
			CFrame = CFrame.new(0, h / 2, sx * hz),
			Color = wallColor,
		})
		for k = 1, 4 do
			Build.part(props, {
				Name = "Strip",
				Size = Vector3.new(2 * hx, 0.6, 2.2),
				CFrame = CFrame.new(0, k * 14, sx * (hz - 0.2)),
				Color = Color3.fromRGB(90, 230, 255),
				Material = Enum.Material.Neon,
			})
		end
	end
	Build.part(props, {
		Name = "Roof",
		Size = Vector3.new(2 * hx, 2, 2 * hz),
		CFrame = CFrame.new(0, h, 0),
		Color = wallColor,
		CastShadow = true,
	})
	for x = -L, L, 45 do
		for _, z in { -W * 0.5, W * 0.5 } do
			local panel = Build.part(props, {
				Name = "LightPanel",
				Size = Vector3.new(24, 0.4, 10),
				CFrame = CFrame.new(x, h - 1.4, z),
				Color = Color3.fromRGB(240, 250, 255),
				Material = Enum.Material.Neon,
			})
			Build.light(
				panel,
				"SurfaceLight",
				{ Face = Enum.NormalId.Bottom, Range = 60, Angle = 120, Brightness = 2.2, Shadows = false }
			)
		end
	end
	local budget = { n = math.floor(220 * arena.Crowd) }
	stand(
		props,
		rng,
		Vector3.new(0, 0, W + MARGIN + 2),
		2 * L,
		Vector3.new(0, 0, 1),
		6,
		0.6,
		Color3.fromRGB(44, 48, 60),
		budget
	)
	stand(
		props,
		rng,
		Vector3.new(0, 0, -(W + MARGIN + 2)),
		2 * L,
		Vector3.new(0, 0, -1),
		6,
		0.6,
		Color3.fromRGB(44, 48, 60),
		budget
	)
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 30, 0), Vector3.new(1, 0, 0))
end

local function themePark(model: Model, arena: any, f: FieldSpec, rng: Rng.Rng)
	local L = f.length / 2 + f.endZone
	local W = f.width / 2
	local props = Build.folder(model, "Props")
	for _ = 1, 34 do
		local side = if rng:next() < 0.5 then 1 else -1
		local pos = Vector3.new(rng:range(-L - 60, L + 60), 0, side * (W + MARGIN + rng:range(8, 70)))
		tree(props, rng, pos)
	end
	-- playground
	local pg = Vector3.new(L + MARGIN + 40, 0, -20)
	local red, yellow, blue = Color3.fromRGB(230, 60, 60), Color3.fromRGB(250, 210, 60), Color3.fromRGB(40, 120, 230)
	Build.part(
		props,
		{ Name = "Tower", Size = Vector3.new(8, 8, 8), CFrame = CFrame.new(pg + Vector3.new(0, 4, 0)), Color = blue }
	)
	Build.part(
		props,
		{ Name = "Roof", Size = Vector3.new(9, 1, 9), CFrame = CFrame.new(pg + Vector3.new(0, 11, 0)), Color = red }
	)
	Build.part(props, {
		Name = "Slide",
		Size = Vector3.new(3, 0.6, 14),
		CFrame = CFrame.new(pg + Vector3.new(0, 4, 10)) * CFrame.Angles(math.rad(-30), 0, 0),
		Color = yellow,
	})
	local swing = pg + Vector3.new(0, 0, -20)
	for _, o in { -6, 6 } do
		Build.part(props, {
			Name = "SwingLeg",
			Size = Vector3.new(0.6, 12, 0.6),
			CFrame = CFrame.new(swing + Vector3.new(o, 6, 0)),
			Color = red,
		})
	end
	Build.part(props, {
		Name = "SwingBar",
		Size = Vector3.new(13, 0.6, 0.6),
		CFrame = CFrame.new(swing + Vector3.new(0, 12, 0)),
		Color = red,
	})
	for _, o in { -2.5, 2.5 } do
		Build.part(props, {
			Name = "Seat",
			Size = Vector3.new(2, 0.3, 1),
			CFrame = CFrame.new(swing + Vector3.new(o, 3, 0)),
			Color = Color3.fromRGB(40, 40, 40),
		})
	end
	-- benches and a couple of spectators
	local budget = { n = math.floor(60 * arena.Crowd) + 12 }
	for x = -L + 10, L - 10, 30 do
		Build.part(props, {
			Name = "Bench",
			Size = Vector3.new(8, 1.2, 2),
			CFrame = CFrame.new(x, 0.6, -(W + 16)),
			Color = Color3.fromRGB(120, 86, 56),
			Material = Enum.Material.Wood,
		})
		if budget.n > 0 then
			budget.n -= 1
			crowdFigure(props, rng, Vector3.new(x, 1.2, -(W + 16)), Vector3.new(0, 0, 1))
		end
	end
	scoreboard(props, Vector3.new(-(L + MARGIN + 14), 14, 0), Vector3.new(1, 0, 0))
end

local THEMES = {
	Stadium = themeStadium,
	Coastal = themeCoastal,
	Rooftop = themeRooftop,
	Beach = themeBeach,
	Indoor = themeIndoor,
	Park = themePark,
}

---------------------------------------------------------------------------
-- public
---------------------------------------------------------------------------

function ArenaBuilder.build(arena: any, f: FieldSpec, parent: Instance): Built
	local old = parent:FindFirstChild("Arena")
	if old then
		old:Destroy()
	end
	workspace.Terrain:Clear()
	applyLighting(arena)

	local model = Instance.new("Model")
	model.Name = "Arena"
	model:SetAttribute("ArenaId", arena.id)
	local rng = Rng.new(#arena.id * 7919 + 17)
	local endZones = buildField(model, arena, f)
	local theme = (THEMES :: any)[arena.Theme] or themeStadium
	theme(model, arena, f, rng)
	windFlags(model, f, arena.Wind)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Sideline"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, -(f.width / 2 + 16))
	spawn.Transparency = 0.6
	spawn.Material = Enum.Material.Neon
	spawn.Color = Color3.fromRGB(90, 230, 255)
	spawn.CanCollide = true
	spawn.Parent = model

	model.Parent = parent
	return { model = model, endZones = endZones, spawn = spawn, margin = MARGIN }
end

ArenaBuilder.Margin = MARGIN

return ArenaBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny construction helpers shared by the arena and training builders.

local Build = {}

export type Props = { [string]: any }

-- Creates an anchored, non-interactive decorative part. Pass `solid = true`
-- for geometry players stand on or collide with.
function Build.part(parent: Instance, props: Props): BasePart
	local className = props.ClassName or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	local solid = props.solid == true
	p.CanCollide = solid
	p.CanTouch = false
	p.CanQuery = solid
	p.CastShadow = props.CastShadow == true
	for k, v in props do
		if k ~= "ClassName" and k ~= "solid" and k ~= "Parent" and k ~= "CastShadow" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end

function Build.model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Build.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- A text label painted on the top face of a flat part.
function Build.topText(p: BasePart, text: string, color: Color3, transparency: number?, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.6
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBlack
	label.TextColor3 = color
	label.TextTransparency = transparency or 0
	label.Parent = gui
end

-- Billboard sign floating above a part.
function Build.sign(adornee: BasePart, title: string, subtitle: string?, color: Color3?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 74)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.Parent = adornee
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(16, 18, 26)
	frame.BackgroundTransparency = 0.15
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Color3.fromRGB(90, 230, 255)
	stroke.Thickness = 2
	stroke.Parent = frame
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.new(1, -16, 0, 34)
	t.Position = UDim2.fromOffset(8, 6)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Text = title
	t.Parent = frame
	if subtitle then
		local s = Instance.new("TextLabel")
		s.BackgroundTransparency = 1
		s.Size = UDim2.new(1, -16, 0, 22)
		s.Position = UDim2.fromOffset(8, 42)
		s.Font = Enum.Font.GothamMedium
		s.TextScaled = true
		s.TextColor3 = Color3.fromRGB(190, 200, 215)
		s.Text = subtitle
		s.Parent = frame
	end
	return gui
end

function Build.light(parent: BasePart, className: string, props: Props): Light
	local l = Instance.new(className) :: Light
	for k, v in props do
		(l :: any)[k] = v
	end
	l.Parent = parent
	return l
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">TrainingBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TrainingBuilder — the Training Grounds hall (built once at startup).

	All positions are relative to Arenas.TrainingOrigin. Layout (top view,
	+Z = north):

	  z 150..230  Interception Drill (W)        | Throwing Range targets (E)
	  z   0..140  Aerial Catch (W) | Combo Lab  | Throwing Range lane (E)
	  z -130..-10 Movement School  | Cutting    | Momentum Shuttle
	              (W)              | Course (C) | (E)
]]

local CollectionService = game:GetService("CollectionService")

local Build = require(script.Parent.Build)

local TrainingBuilder = {}

export type Station = {
	id: string,
	title: string,
	subtitle: string,
	terminal: Vector3,
	start: Vector3,
	facing: Vector3,
}

export type Layout = {
	model: Model,
	origin: Vector3,
	entry: CFrame,
	stations: { [string]: Station },
	gates: { { a: Vector3, b: Vector3 } },
	shuttleA: number, -- world z of shuttle line A
	shuttleB: number,
	shuttleX: { number },
	launcher: Vector3,
	catchMark: Vector3,
	throwMark: Vector3,
	targets: { { pos: Vector3, radius: number, points: number, name: string } },
	mover: { center: Vector3, amplitude: number, period: number, radius: number, points: number },
	interception: { thrower: Vector3, receiverStart: Vector3, playerStart: Vector3 },
	prompts: { [string]: ProximityPrompt },
}

local FLOOR = Color3.fromRGB(40, 46, 58)
local LINE = Color3.fromRGB(90, 230, 255)
local CONE = Color3.fromRGB(255, 110, 20)

local function cone(parent: Instance, pos: Vector3, color: Color3?)
	Build.part(parent, {
		Name = "Cone",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 1.4, 1.4),
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color or CONE,
		Material = Enum.Material.Neon,
	})
end

local function terminal(parent: Instance, pos: Vector3, title: string, subtitle: string, id: string): ProximityPrompt
	local base = Build.part(parent, {
		Name = "Terminal_" .. id,
		Size = Vector3.new(4, 4, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)),
		Color = Color3.fromRGB(24, 28, 36),
		solid = true,
	})
	Build.part(parent, {
		Name = "TerminalGlow",
		Size = Vector3.new(4.2, 0.3, 2.2),
		CFrame = CFrame.new(pos + Vector3.new(0, 4.1, 0)),
		Color = LINE,
		Material = Enum.Material.Neon,
	})
	Build.sign(base, title, subtitle, LINE)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Start"
	prompt.ObjectText = title
	prompt.KeyboardKeyCode = Enum.KeyCode.G
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Drill", id)
	prompt.Parent = base
	return prompt
end

function TrainingBuilder.build(origin: Vector3, parent: Instance): Layout
	local old = parent:FindFirstChild("TrainingGrounds")
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "TrainingGrounds"
	local function at(x: number, z: number, y: number?): Vector3
		return origin + Vector3.new(x, y or 0, z)
	end

	-- hall
	local W, Z0, Z1, H = 170, -140, 240, 64
	Build.part(model, {
		Name = "Floor",
		Size = Vector3.new(2 * W, 1, Z1 - Z0),
		CFrame = CFrame.new(at(0, (Z0 + Z1) / 2, -0.5)),
		Color = FLOOR,
		Material = Enum.Material.SmoothPlastic,
		solid = true,
	})
	-- floor grid
	for x = -W + 20, W - 20, 20 do
		Build.part(model, {
			Name = "Grid",
			Size = Vector3.new(0.2, 0.04, Z1 - Z0),
			CFrame = CFrame.new(at(x, (Z0 + Z1) / 2, 0.02)),
			Color = Color3.fromRGB(60, 70, 88),
		})
	end
	for z = Z0 + 20, Z1 - 20, 20 do
		Build.part(model, {
			Name = "Grid",
			Size = Vector3.new(2 * W, 0.04, 0.2),
			CFrame = CFrame.new(at(0, z, 0.02)),
			Color = Color3.fromRGB(60, 70, 88),
		})
	end
	local wallColor = Color3.fromRGB(28, 32, 42)
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2, H, Z1 - Z0),
		CFrame = CFrame.new(at(-W, (Z0 + Z1) / 2, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2, H, Z1 - Z0),
		CFrame = CFrame.new(at(W, (Z0 + Z1) / 2, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2 * W, H, 2),
		CFrame = CFrame.new(at(0, Z0, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Wall",
		Size = Vector3.new(2 * W, H, 2),
		CFrame = CFrame.new(at(0, Z1, H / 2)),
		Color = wallColor,
		solid = true,
	})
	Build.part(model, {
		Name = "Roof",
		Size = Vector3.new(2 * W, 2, Z1 - Z0),
		CFrame = CFrame.new(at(0, (Z0 + Z1) / 2, H + 1)),
		Color = wallColor,
		solid = true,
	})
	for x = -W + 40, W - 40, 60 do
		for z = Z0 + 40, Z1 - 40, 60 do
			local panel = Build.part(model, {
				Name = "LightPanel",
				Size = Vector3.new(26, 0.4, 12),
				CFrame = CFrame.new(at(x, z, H - 1)),
				Color = Color3.fromRGB(235, 245, 255),
				Material = Enum.Material.Neon,
			})
			Build.light(
				panel,
				"SurfaceLight",
				{ Face = Enum.NormalId.Bottom, Range = 60, Angle = 120, Brightness = 2.5, Shadows = false }
			)
		end
	end
	for _, z in { Z0 + 0.8, Z1 - 0.8 } do
		Build.part(model, {
			Name = "Strip",
			Size = Vector3.new(2 * W, 0.8, 0.4),
			CFrame = CFrame.new(at(0, z, 10)),
			Color = LINE,
			Material = Enum.Material.Neon,
		})
	end

	local entry = CFrame.lookAt(at(0, -125, 3.5), at(0, 0, 3.5))
	local entryPad = Build.part(model, {
		Name = "EntryPad",
		Size = Vector3.new(14, 0.4, 10),
		CFrame = CFrame.new(at(0, -125, 0.2)),
		Color = LINE,
		Material = Enum.Material.Neon,
		Transparency = 0.5,
	})
	Build.sign(entryPad, "TRAINING GROUNDS", "Walk up to a terminal and press G to start a drill", LINE)

	local stations: { [string]: Station } = {}
	local prompts: { [string]: ProximityPrompt } = {}
	local function station(id: string, title: string, subtitle: string, term: Vector3, start: Vector3, facing: Vector3)
		stations[id] = { id = id, title = title, subtitle = subtitle, terminal = term, start = start, facing = facing }
		prompts[id] = terminal(model, term, title, subtitle, id)
	end

	-- Movement School
	station(
		"Tutorial",
		"MOVEMENT SCHOOL",
		"Learn every technique, step by step",
		at(-120, -118),
		at(-110, -90),
		Vector3.new(0, 0, 1)
	)
	-- Cutting course: zig-zag gates
	local gates = {}
	local courseFolder = Build.folder(model, "CuttingCourse")
	local gx = { 0, -18, 14, -10, 20, -20, 8, 0 }
	for i, x in gx do
		local z = -112 + (i - 1) * 13
		local a, b = at(x - 3.2, z), at(x + 3.2, z)
		cone(courseFolder, a, if i == 1 or i == #gx then Color3.fromRGB(80, 255, 140) else nil)
		cone(courseFolder, b, if i == 1 or i == #gx then Color3.fromRGB(80, 255, 140) else nil)
		table.insert(gates, { a = a, b = b })
	end
	station(
		"Cutting",
		"CUTTING COURSE",
		"Slalom through every gate. Keep your speed.",
		at(-30, -126),
		at(0, -124),
		Vector3.new(0, 0, 1)
	)

	-- Momentum shuttle
	local shuttleFolder = Build.folder(model, "Shuttle")
	local zA, zB = -118, -82
	for _, z in { zA, zB } do
		Build.part(shuttleFolder, {
			Name = "ShuttleLine",
			Size = Vector3.new(56, 0.06, 0.8),
			CFrame = CFrame.new(at(110, z, 0.04)),
			Color = if z == zA then Color3.fromRGB(80, 255, 140) else Color3.fromRGB(255, 200, 60),
			Material = Enum.Material.Neon,
		})
	end
	station(
		"Shuttle",
		"MOMENTUM SHUTTLE",
		"A-B-A-B-A. Reverse fast without losing it.",
		at(146, -126),
		at(110, -126),
		Vector3.new(0, 0, 1)
	)

	-- Aerial catch: launcher at the north end of the west side
	local launcher = at(-100, 128, 4)
	Build.part(model, {
		Name = "LauncherBase",
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(launcher - Vector3.new(0, 1, 0)),
		Color = Color3.fromRGB(50, 56, 70),
		solid = true,
	})
	Build.part(model, {
		Name = "LauncherBarrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, 2.4, 2.4),
		CFrame = CFrame.lookAt(launcher + Vector3.new(0, 2, 0), at(-100, 40, 4)) * CFrame.Angles(0, math.rad(90), 0),
		Color = LINE,
		Material = Enum.Material.Neon,
	})
	local catchMark = at(-100, 40)
	Build.part(model, {
		Name = "CatchMark",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 6, 6),
		CFrame = CFrame.new(catchMark + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 200, 60),
		Material = Enum.Material.Neon,
	})
	station(
		"Aerial",
		"AERIAL CATCH",
		"10 launches: floaters, skimmers, layouts",
		at(-150, 20),
		catchMark + Vector3.new(0, 3, 0),
		Vector3.new(0, 0, 1)
	)
	station(
		"Launcher",
		"FREE LAUNCHER",
		"Custom launches (opens the launcher panel)",
		at(-150, 60),
		catchMark + Vector3.new(0, 3, 0),
		Vector3.new(0, 0, 1)
	)

	-- Throwing range (east): throw north from the mark
	local throwMark = at(70, 20)
	Build.part(model, {
		Name = "ThrowMark",
		Size = Vector3.new(6, 0.08, 6),
		CFrame = CFrame.new(throwMark + Vector3.new(0, 0.05, 0)),
		Color = Color3.fromRGB(80, 255, 140),
		Material = Enum.Material.Neon,
		Transparency = 0.3,
	})
	local targets = {}
	local function target(name: string, x: number, z: number, y: number, radius: number, points: number)
		local pos = at(x, z, y)
		local ring = Build.part(model, {
			Name = "Target_" .. name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, radius * 2, radius * 2),
			CFrame = CFrame.lookAt(pos, throwMark + Vector3.new(0, y, 0)) * CFrame.Angles(0, math.rad(90), 0),
			Color = Color3.fromRGB(255, 80, 120),
			Material = Enum.Material.Neon,
			Transparency = 0.55,
		})
		Build.part(model, {
			Name = "TargetPole",
			Size = Vector3.new(0.4, y - radius, 0.4),
			CFrame = CFrame.new(at(x, z, (y - radius) / 2)),
			Color = Color3.fromRGB(200, 200, 210),
		})
		Build.sign(ring, name, points .. " pts", Color3.fromRGB(255, 80, 120))
		CollectionService:AddTag(ring, "UBTarget")
		table.insert(targets, { pos = pos, radius = radius, points = points, name = name })
	end
	target("40", 62, 60, 5, 4.5, 100)
	target("70", 88, 90, 6, 4, 150)
	target("100", 52, 120, 7, 4, 200)
	target("140", 80, 160, 8, 4.5, 300)
	local moverCenter = at(70, 200, 6)
	local mover = { center = moverCenter, amplitude = 38, period = 7, radius = 4.5, points = 250 }
	local moverPart = Build.part(model, {
		Name = "MovingTarget",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 9, 9),
		CFrame = CFrame.lookAt(moverCenter, throwMark + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(255, 200, 60),
		Material = Enum.Material.Neon,
		Transparency = 0.45,
	})
	moverPart:SetAttribute("Amplitude", mover.amplitude)
	moverPart:SetAttribute("Period", mover.period)
	moverPart:SetAttribute("Center", moverCenter)
	CollectionService:AddTag(moverPart, "UBMover")
	Build.part(model, {
		Name = "Rail",
		Size = Vector3.new(mover.amplitude * 2 + 10, 0.4, 0.6),
		CFrame = CFrame.new(moverCenter - Vector3.new(0, 5, 0)),
		Color = Color3.fromRGB(90, 96, 110),
	})
	station(
		"Range",
		"THROWING RANGE",
		"10 throws at the rings (and the mover)",
		at(100, 8),
		throwMark + Vector3.new(0, 3, 0),
		Vector3.new(0, 0, 1)
	)

	-- Interception drill (north-west)
	local interception = {
		thrower = at(-140, 160, 3),
		receiverStart = at(-70, 160, 3),
		playerStart = at(-100, 175, 3),
	}
	Build.part(model, {
		Name = "DrillZone",
		Size = Vector3.new(110, 0.05, 80),
		CFrame = CFrame.new(at(-100, 190, 0.03)),
		Color = Color3.fromRGB(255, 120, 30),
		Material = Enum.Material.Neon,
		Transparency = 0.9,
	})
	station(
		"Interception",
		"INTERCEPTION DRILL",
		"Read the throw. Get the D.",
		at(-150, 145),
		interception.playerStart,
		Vector3.new(0, 0, 1)
	)

	-- Combo lab with rebound walls
	local lab = Build.folder(model, "ComboLab")
	for i, x in { -26, -6 } do
		local wall = Build.part(lab, {
			Name = "LabRebound" .. i,
			Size = Vector3.new(1, 16, 40),
			CFrame = CFrame.new(at(x, 70, 8)),
			Color = Color3.fromRGB(255, 90, 200),
			Material = Enum.Material.Neon,
			Transparency = 0.5,
			solid = true,
		})
		CollectionService:AddTag(wall, "Rebound")
	end
	station(
		"Combo",
		"COMBO LAB",
		"Chain challenges. Rebound walls inside.",
		at(-16, 10),
		at(-16, 30, 3),
		Vector3.new(0, 0, 1)
	)

	model.Parent = parent
	return {
		model = model,
		origin = origin,
		entry = entry,
		stations = stations,
		gates = gates,
		shuttleA = origin.Z + zA,
		shuttleB = origin.Z + zB,
		shuttleX = { origin.X + 82, origin.X + 138 },
		launcher = launcher + Vector3.new(0, 2, 0),
		catchMark = catchMark,
		throwMark = throwMark,
		targets = targets,
		mover = mover,
		interception = interception,
		prompts = prompts,
	}
end

-- Moving target position at server time t (clients use the same formula).
function TrainingBuilder.moverPosition(center: Vector3, amplitude: number, period: number, t: number): Vector3
	return center + Vector3.new(math.sin(t * 2 * math.pi / period) * amplitude, 0, 0)
end

return TrainingBuilder
]]></string>
          </Properties>
        </Item>
