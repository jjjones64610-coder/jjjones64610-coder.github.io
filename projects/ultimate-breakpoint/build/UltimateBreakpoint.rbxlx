			Decay = Color3.fromRGB(60, 20, 90),
			Glare = 0,
			Haze = 2,
		},
		ColorCorrection = {
			Brightness = 0.02,
			Contrast = 0.15,
			Saturation = 0.35,
			TintColor = Color3.fromRGB(255, 230, 250),
		},
		Bloom = { Intensity = 1.2, Size = 28, Threshold = 1.0 },
	},
	Beach = {
