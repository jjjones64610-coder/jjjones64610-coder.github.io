            <string name="Name">Arenas</string>
            <string name="Source"><![CDATA[--!strict
-- ARENAS
-- The field itself follows the mode (Config/Modes.Fields: Mini 240 x 90 for
-- 3v3, Normal 360 x 136 for 7v7) and is identical in every arena, so spacing
-- and muscle memory carry over. Arenas differ in look, lighting, wind and
-- (special variants only) optional rebound walls; their dressing scales with
-- the field. Ranked uses Competitive arenas, whose wind is zero or light and
-- always shown on the HUD.

export type Arena = {
	id: string,
	Display: string,
	Description: string,
	Theme: string,
	Competitive: boolean,
	Wind: Vector3, -- studs/s, constant for the whole match, flips with the teams
	Rebound: boolean,
	Ground: { Material: Enum.Material, A: Color3, B: Color3 },
	Surround: { Material: Enum.Material, Color: Color3 },
	LineColor: Color3,
	Lights: boolean,
	Crowd: number,
	Lighting: { [string]: any },
	Atmosphere: { [string]: any },
	ColorCorrection: { [string]: any },
	Bloom: { [string]: any },
}

local Arenas = {}

Arenas.List = {
	Championship = {
		id = "Championship",
		Display = "Championship Stadium",
		Description = "The big stage. Floodlights, packed stands, still air.",
		Theme = "Stadium",
		Competitive = true,
		Wind = Vector3.zero,
		Rebound = false,
		Ground = { Material = Enum.Material.Grass, A = Color3.fromRGB(62, 128, 58), B = Color3.fromRGB(54, 116, 52) },
		Surround = { Material = Enum.Material.Concrete, Color = Color3.fromRGB(70, 72, 80) },
		LineColor = Color3.fromRGB(250, 250, 250),
		Lights = true,
		Crowd = 1,
		Lighting = {
			ClockTime = 20.6,
			Brightness = 1.6,
			Ambient = Color3.fromRGB(70, 74, 92),
			OutdoorAmbient = Color3.fromRGB(110, 116, 140),
			ExposureCompensation = 0.25,
			EnvironmentDiffuseScale = 0.6,
			EnvironmentSpecularScale = 0.6,
		},
		Atmosphere = {
			Density = 0.28,
			Offset = 0.2,
			Color = Color3.fromRGB(150, 160, 200),
			Decay = Color3.fromRGB(60, 70, 110),
			Glare = 0.2,
			Haze = 1.2,
		},
		ColorCorrection = {
			Brightness = 0.02,
			Contrast = 0.12,
			Saturation = 0.15,
			TintColor = Color3.fromRGB(255, 252, 245),
		},
		Bloom = { Intensity = 0.6, Size = 30, Threshold = 1.6 },
	},
	Coastal = {
		id = "Coastal",
		Display = "Coastal Sunset",
		Description = "Golden hour over the water. A light, steady sea breeze.",
		Theme = "Coastal",
		Competitive = true,
		Wind = Vector3.new(0, 0, 2.5),
		Rebound = false,
		Ground = { Material = Enum.Material.Grass, A = Color3.fromRGB(96, 150, 70), B = Color3.fromRGB(86, 138, 64) },
		Surround = { Material = Enum.Material.Sand, Color = Color3.fromRGB(226, 200, 150) },
		LineColor = Color3.fromRGB(255, 250, 240),
		Lights = false,
		Crowd = 0.6,
		Lighting = {
			ClockTime = 17.9,
			Brightness = 2.6,
			Ambient = Color3.fromRGB(120, 90, 80),
			OutdoorAmbient = Color3.fromRGB(170, 130, 110),
			ExposureCompensation = 0.1,
			EnvironmentDiffuseScale = 0.8,
			EnvironmentSpecularScale = 0.8,
		},
		Atmosphere = {
			Density = 0.33,
			Offset = 0.1,
			Color = Color3.fromRGB(255, 190, 150),
			Decay = Color3.fromRGB(255, 120, 90),
			Glare = 0.8,
			Haze = 1.6,
		},
		ColorCorrection = {
			Brightness = 0.03,
			Contrast = 0.08,
			Saturation = 0.2,
			TintColor = Color3.fromRGB(255, 236, 220),
		},
		Bloom = { Intensity = 0.8, Size = 34, Threshold = 1.4 },
	},
	Rooftop = {
		id = "Rooftop",
		Display = "Neon Rooftop",
		Description = "A field on top of the city. Neon lines, skyline glow.",
		Theme = "Rooftop",
		Competitive = true,
		Wind = Vector3.new(1.5, 0, 0),
		Rebound = false,
		Ground = {
			Material = Enum.Material.SmoothPlastic,
			A = Color3.fromRGB(30, 34, 52),
			B = Color3.fromRGB(26, 30, 46),
		},
		Surround = { Material = Enum.Material.Concrete, Color = Color3.fromRGB(40, 42, 54) },
		LineColor = Color3.fromRGB(90, 230, 255),
		Lights = false,
		Crowd = 0.35,
		Lighting = {
			ClockTime = 0.2,
			Brightness = 1.2,
			Ambient = Color3.fromRGB(70, 60, 110),
			OutdoorAmbient = Color3.fromRGB(90, 80, 140),
			ExposureCompensation = 0.4,
			EnvironmentDiffuseScale = 0.4,
			EnvironmentSpecularScale = 1,
		},
		Atmosphere = {
			Density = 0.35,
			Offset = 0.3,
			Color = Color3.fromRGB(120, 80, 200),
			Decay = Color3.fromRGB(40, 20, 90),
			Glare = 0,
			Haze = 2,
		},
		ColorCorrection = {
			Brightness = 0.02,
			Contrast = 0.15,
			Saturation = 0.3,
			TintColor = Color3.fromRGB(235, 230, 255),
		},
		Bloom = { Intensity = 1.1, Size = 28, Threshold = 1.1 },
	},
	RooftopRebound = {
		id = "RooftopRebound",
		Display = "Neon Rooftop: Rebound",
		Description = "Special rules: glowing sideline walls you can rebound off.",
		Theme = "Rooftop",
		Competitive = false,
		Wind = Vector3.zero,
		Rebound = true,
		Ground = {
			Material = Enum.Material.SmoothPlastic,
			A = Color3.fromRGB(30, 34, 52),
			B = Color3.fromRGB(26, 30, 46),
		},
		Surround = { Material = Enum.Material.Concrete, Color = Color3.fromRGB(40, 42, 54) },
		LineColor = Color3.fromRGB(255, 90, 200),
		Lights = false,
		Crowd = 0.35,
		Lighting = {
			ClockTime = 0.2,
			Brightness = 1.2,
			Ambient = Color3.fromRGB(80, 60, 110),
			OutdoorAmbient = Color3.fromRGB(100, 80, 140),
			ExposureCompensation = 0.4,
			EnvironmentDiffuseScale = 0.4,
			EnvironmentSpecularScale = 1,
		},
		Atmosphere = {
			Density = 0.35,
			Offset = 0.3,
			Color = Color3.fromRGB(200, 80, 200),
			Decay = Color3.fromRGB(60, 20, 90),
			Glare = 0,
			Haze = 2,
		},
		ColorCorrection = {
			Brightness = 0.02,
			Contrast = 0.15,
			Saturation = 0.35,
			TintColor = Color3.fromRGB(255, 230, 250),
		},
		Bloom = { Intensity = 1.2, Size = 28, Threshold = 1.0 },
	},
	Beach = {
		id = "Beach",
		Display = "Windy Beach",
		Description = "Sand, surf and a strong, steady crosswind. Unranked matches only.",
		Theme = "Beach",
		Competitive = false,
		Wind = Vector3.new(0, 0, -7),
		Rebound = false,
		Ground = { Material = Enum.Material.Sand, A = Color3.fromRGB(232, 210, 160), B = Color3.fromRGB(224, 200, 150) },
		Surround = { Material = Enum.Material.Sand, Color = Color3.fromRGB(236, 216, 168) },
		LineColor = Color3.fromRGB(30, 120, 220),
		Lights = false,
		Crowd = 0.3,
		Lighting = {
			ClockTime = 13.5,
			Brightness = 3,
			Ambient = Color3.fromRGB(140, 140, 150),
			OutdoorAmbient = Color3.fromRGB(170, 170, 180),
			ExposureCompensation = 0,
			EnvironmentDiffuseScale = 1,
			EnvironmentSpecularScale = 1,
		},
		Atmosphere = {
			Density = 0.25,
			Offset = 0,
			Color = Color3.fromRGB(200, 225, 255),
			Decay = Color3.fromRGB(120, 170, 230),
			Glare = 0.3,
			Haze = 0.8,
		},
		ColorCorrection = {
			Brightness = 0.02,
			Contrast = 0.05,
			Saturation = 0.12,
			TintColor = Color3.fromRGB(255, 252, 245),
		},
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
	},
	Indoor = {
		id = "Indoor",
		Display = "The Lab",
		Description = "Futuristic indoor arena. Zero wind, perfect light.",
		Theme = "Indoor",
		Competitive = true,
		Wind = Vector3.zero,
		Rebound = false,
		Ground = {
			Material = Enum.Material.SmoothPlastic,
			A = Color3.fromRGB(46, 120, 96),
			B = Color3.fromRGB(42, 110, 88),
		},
		Surround = { Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(34, 38, 46) },
		LineColor = Color3.fromRGB(240, 255, 250),
		Lights = false,
		Crowd = 0.5,
		Lighting = {
			ClockTime = 12,
			Brightness = 1,
			Ambient = Color3.fromRGB(110, 120, 130),
			OutdoorAmbient = Color3.fromRGB(120, 130, 140),
			ExposureCompensation = 0.2,
			EnvironmentDiffuseScale = 0.5,
			EnvironmentSpecularScale = 1,
		},
		Atmosphere = {
			Density = 0.15,
			Offset = 0,
			Color = Color3.fromRGB(200, 230, 240),
			Decay = Color3.fromRGB(150, 180, 200),
			Glare = 0,
			Haze = 0.5,
		},
		ColorCorrection = {
			Brightness = 0.03,
			Contrast = 0.1,
			Saturation = 0.05,
			TintColor = Color3.fromRGB(245, 252, 255),
		},
		Bloom = { Intensity = 0.7, Size = 24, Threshold = 1.3 },
	},
	Park = {
		id = "Park",
		Display = "Community Park",
		Description = "Where everyone learned. Trees, a playground, a soft breeze.",
		Theme = "Park",
		Competitive = false,
		Wind = Vector3.new(-1.5, 0, 1),
		Rebound = false,
		Ground = { Material = Enum.Material.Grass, A = Color3.fromRGB(104, 160, 72), B = Color3.fromRGB(96, 150, 66) },
		Surround = { Material = Enum.Material.Grass, Color = Color3.fromRGB(90, 140, 64) },
		LineColor = Color3.fromRGB(255, 255, 255),
		Lights = false,
		Crowd = 0.15,
		Lighting = {
			ClockTime = 10.5,
			Brightness = 2.8,
			Ambient = Color3.fromRGB(130, 130, 120),
			OutdoorAmbient = Color3.fromRGB(160, 160, 150),
			ExposureCompensation = 0,
			EnvironmentDiffuseScale = 1,
			EnvironmentSpecularScale = 0.8,
		},
		Atmosphere = {
			Density = 0.22,
			Offset = 0,
			Color = Color3.fromRGB(210, 230, 255),
			Decay = Color3.fromRGB(150, 190, 230),
			Glare = 0.2,
			Haze = 0.6,
		},
		ColorCorrection = {
			Brightness = 0.02,
			Contrast = 0.06,
			Saturation = 0.15,
			TintColor = Color3.fromRGB(255, 252, 240),
		},
		Bloom = { Intensity = 0.4, Size = 24, Threshold = 2 },
	},
} :: { [string]: Arena }

Arenas.Order = { "Championship", "Coastal", "Rooftop", "Indoor", "Park", "Beach", "RooftopRebound" }
Arenas.Default = "Championship"

-- Training ground is a fixed location beside the main field. The hall spans
-- z 760..1140; the furthest +Z arena geometry on the Normal field (the
-- scaled Rooftop skyline) ends near z 660, so the hall stays clear.
Arenas.TrainingOrigin = Vector3.new(0, 0, 900)

return Arenas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- AUDIO CUES
-- Built-in engine sounds (rbxasset://) are used so the place works out of the
-- box. Swap any SoundId for your own uploaded audio (rbxassetid://...) to get
-- custom crowd beds, whistles and commentary stingers. Empty ids are skipped.
--
-- Combo feedback: ComboTick plays once per technique in a chain, pitched up
-- ComboTickStep semitones per link (capped at ComboTickMaxSteps links), so a
-- long chain audibly climbs; ComboEnd closes a chain that reached a tier and
-- ComboConvert plays when a catch / block converts it. Your own catch plays
-- Catch / CleanCatch the moment you claim it (CatchController), not a round
-- trip later.

local Audio = {}

Audio.Cues = {
	Throw = { id = "rbxasset://sounds/swoosh.wav", volume = 0.5, pitch = 1.1 },
	PerfectRelease = { id = "rbxasset://sounds/swoosh.wav", volume = 0.7, pitch = 1.35 },
	Catch = { id = "rbxasset://sounds/clickfast.wav", volume = 0.7, pitch = 0.8 },
	CleanCatch = { id = "rbxasset://sounds/clickfast.wav", volume = 0.9, pitch = 0.65 },
	Layout = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.9, pitch = 0.85 },
	Block = { id = "rbxasset://sounds/snap.mp3", volume = 0.9, pitch = 0.9 },
	Bobble = { id = "rbxasset://sounds/snap.mp3", volume = 0.6, pitch = 1.4 },
	Turnover = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 0.6 },
	Goal = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.9, pitch = 1.2 },
	Stall = { id = "rbxasset://sounds/button.wav", volume = 0.25, pitch = 1.0 },
	StallOut = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, pitch = 0.5 },
	Whistle = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1.6 },
	Tech = { id = "rbxasset://sounds/swoosh.wav", volume = 0.25, pitch = 1.6 },
	TechPerfect = { id = "rbxasset://sounds/swoosh.wav", volume = 0.35, pitch = 1.9 },
	Burst = { id = "rbxasset://sounds/swoosh.wav", volume = 0.45, pitch = 0.75 },
	Land = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.35, pitch = 1.0 },
	PrecisionLand = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.5, pitch = 1.4 },
	Rebound = { id = "rbxasset://sounds/snap.mp3", volume = 0.5, pitch = 1.2 },
	UiClick = { id = "rbxasset://sounds/button.wav", volume = 0.4, pitch = 1.0 },
	Highlight = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1.45 },
	ComboTick = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.2, pitch = 1.25 },
	ComboEnd = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.3, pitch = 1.05 },
	ComboConvert = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.55, pitch = 1.7 },
	-- Supply your own looping crowd ambience and cheer to enable these.
	CrowdLoop = { id = "", volume = 0.35, pitch = 1.0, looped = true },
	CrowdCheer = { id = "", volume = 0.7, pitch = 1.0 },
}

Audio.ComboTickStep = 2 -- semitones per chain link
Audio.ComboTickMaxSteps = 7 -- links after which the tick stops climbing
Audio.ComboTickPerfect = 1.06 -- extra pitch for a Perfect link

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Disc</string>
            <string name="Source"><![CDATA[--!strict
-- DISC + THROW + CATCH TUNING
-- Scale: 1 metre ~= 3 studs (a 5.3-stud avatar is ~1.77 m). The flight model
-- uses real-world frisbee coefficients (Hummel 2003) converted to studs, then
-- lightly tuned so throws read clearly on a Roblox field. See docs/DESIGN.md.
--
-- Field fit (Config/Modes.Fields): a full-power Perfect backhand flies
-- ~160-170 studs aimed flat and ~185 at its best aim, so a Normal pull from
-- the goal line lands around the receivers' brick, a Mini pull can reach the
-- end zone, and light touches (~0.1-0.2 s holds) stay short. tests/disc_spec
-- encodes this; tests/flight_table prints the numbers.

local Disc = {
	Physics = {
		Dt = 1 / 120, -- fixed simulation step, identical on client and server
		Gravity = 29.4, -- studs/s^2 (9.81 m/s^2 * 3)
		AirK = 0.0665, -- 0.5 * rho * area / mass, per stud
		CL0 = 0.15,
		CLa = 1.4, -- per radian
		StallAlpha = 0.45, -- radians; lift collapses beyond this
		CD0 = 0.08,
		CDa = 2.72,
		CDMax = 1.2,
		Alpha0 = -0.0698, -- -4 degrees
		CM0 = -0.01, -- pitching moment at zero angle of attack (nose down => "turn")
		CMa = 1.0, -- grows with angle of attack (nose up => "fade")
		RollK = 0.07, -- gyroscopic precession gain (tuned, see tests/disc_spec)
		SpinDecay = 0.04, -- per second
		MinSpin = 8,
		Radius = 1.1, -- visual/catch radius in studs (~0.27 m disc)
		GroundContact = 0.14, -- disc centre height that counts as touching the ground
		MaxFlightTime = 9,
		HistorySeconds = 0.6, -- server keeps this much flight history for lag compensation
	},

	Throw = {
		SpinBase = 50, -- rad/s (~8 rev/s)
		ChargeTime = 0.55, -- seconds of holding to reach full power
		PerfectWindow = 0.10, -- release within [ChargeTime, ChargeTime + PerfectWindow] = Perfect
		OverchargeDecay = 0.8, -- spin factor lost per second held beyond the window
		MinOverSpin = 0.6,
		PerfectSpeedMult = 1.05,
		PerfectSpinMult = 1.15,
		OffBalancePowerCap = 0.75,
		OffBalanceSpin = 0.8,
		GroundThrowPowerCap = 0.6,
		MovingSpinPenaltySpeed = 12, -- throwing on the run faster than this costs spin (no pivot yet)
		MovingSpinPenalty = 0.85,
		ThrowerVelocityCarry = 0.45, -- share of the run-up added to the disc (no pivot yet)
		SwingSpinPenalty = 0.9, -- releasing mid Quick Swing costs 10% spin (no power cap)
		MinSpeed = 28,
		MaxSpeed = 88, -- sized for the Normal field (see the header)
		PowerCurve = 0.85,
		BankRange = 35, -- degrees of player-controlled bank either side
		BankSteps = 7, -- discrete bank positions for keyboard/gamepad (-3..3)
		FakeCooldown = 0.45,
		FakeDuration = 0.22,
		MinPitch = -12,
		MaxPitch = 60,
		QuickReleaseWindow = 0.6, -- release within this long after a catch = Quick Release
		HandBlockCheckTime = 0.3, -- seconds of early flight checked against markers' hands
		NoCatchTime = 0.15, -- nobody can catch in the first moments (hand blocks cover that)

		-- Release from the pivot (ThrowModel.releasePosition with params.pivot):
		-- P + step + right * (Side * PivotSideScale, +-LowReach for Low)
		--   + forward * ReleaseForward + up * (height + hop).
		PivotSideScale = 0.5, -- squared up: BH -0.3, FH +0.7 from the pivot
		LowReach = 0.9, -- a Low release extends this much further to the throw's side
		ReleaseForward = 0.8,
		MaxHopLift = 3.2, -- cap on the hop height added to a pivot release (peak ~2.8)
		-- Server check of the client's step (ThrowModel.resolveStep): accepted if
		-- the server root is within Base + Ping * min(ping, MaxPing) of P + share * step.
		StepCheckBase = 1.5,
		StepCheckPing = 12,
		StepCheckMaxPing = 0.35,
	},

	-- Per-throw definition. Side/LowSide are release offsets from the root part
	-- when no pivot is planted (right-handed thrower; mirrored for left-handed);
	-- from a pivot the release uses Side * Throw.PivotSideScale plus the step.
	-- bank/alpha/pitch are degrees. spin is the sign of rotation about the
	-- disc's top-face normal.
	Types = {
		Backhand = {
			Display = "Backhand",
			Short = "BH",
			Order = 1,
			SpeedMult = 1.0,
			Spin = -1,
			Bank = 0,
			Alpha = 6,
			PitchOffset = 4,
			Side = -0.6,
			LowSide = -2.2,
			ChargeMult = 1.0,
			Description = "Reliable baseline. Fades left (right-handed).",
		},
		Forehand = {
			Display = "Forehand",
			Short = "FH",
			Order = 2,
			SpeedMult = 0.95,
			Spin = 1,
			Bank = 0,
			Alpha = 6,
			PitchOffset = 3,
			Side = 1.4,
			LowSide = 2.4,
			ChargeMult = 1.2, -- quicker release
			Description = "Fast flick release from the other side. Fades right.",
		},
		Hammer = {
			Display = "Hammer",
			Short = "HAM",
			Order = 3,
			SpeedMult = 0.85,
			Spin = 1,
			Bank = -100,
			Alpha = 6,
			PitchOffset = 30,
			Side = 0.8,
			LowSide = 0.8,
			Overhead = true,
			ChargeMult = 1.0,
			Description = "Overhead. Inverts mid-flight and drops steeply over defenders.",
		},
		Scoober = {
			Display = "Scoober",
			Short = "SCB",
			Order = 4,
			SpeedMult = 0.6,
			Spin = -1,
			Bank = 100,
			Alpha = 6,
			PitchOffset = 22,
			Side = -0.4,
			LowSide = -0.4,
			Overhead = true,
			ChargeMult = 1.3,
			Description = "Short upside-down flip over a close mark. Breaks right.",
		},
		Blade = {
			Display = "Blade",
			Short = "BLD",
			Order = 5,
			SpeedMult = 0.95,
			Spin = -1,
			Bank = -55,
			Alpha = -4,
			PitchOffset = 6,
			Side = -0.6,
			LowSide = -2.2,
			ChargeMult = 1.0,
			Description = "Steep edge, fast dive. Short hang time: hard to intercept.",
		},
	},

	TypeOrder = { "Backhand", "Forehand", "Hammer", "Scoober", "Blade" },

	-- Release heights relative to the root part centre (from a pivot: relative
	-- to P, plus the hop height). High without a pivot is the hop itself.
	Heights = {
		High = 2.6,
		Mid = 0.5,
		Low = -1.6,
	},
	OverheadHeight = 2.6,

	-- Catch geometry (studs, relative to the root part centre).
	Catch = {
		ChestHeight = 1.0,
		SecureRadius = 2.4, -- passive catch zone around the chest
		CleanFraction = 0.8, -- min depth (over QualityWindow) inside this fraction = clean catch
		QualityWindow = 0.1, -- a claim's quality is its minimum depth over this long after first contact
		QualitySamples = 12, -- ... sampled every 1/120 s: first contact + this many steps
		ReachLength = 3.6,
		ReachRadius = 1.15,
		ReachWindow = 0.28,
		ReachCooldown = 0.4,
		DiveLength = 5.2,
		DiveRadius = 1.4,
		SlideDrop = 1.4, -- slide lowers the secure zone this much
		ShoulderHeight = 1.5,
		ShoulderWidth = 1.0,
		BobbleSpeed = 95, -- fingertip catch of a disc faster than this bobbles (disc speed only)
		BlockDepth = 0.9, -- a defender's touch is a Block only this deep at the rim; else an interception
		ContestWindow = 0.04, -- claims this close in time are contested
		ResolveDelay = 0.04, -- server waits this long to collect competing claims
		MaxRewind = 0.3, -- max seconds a claim can be backdated (lag compensation)
		ClaimThrottle = 0.03, -- client: min seconds between claims for one disc (a Denied clears it)
		ClaimTrackTime = 0.08, -- client: keeps tracking after first contact up to this long before claiming
		ClaimRateLimit = 0.02, -- server: min seconds between claims per actor (replies Denied)
		-- Claim slack (CatchGeometry.slack): Base + ping * PingSlackPerSecond
		-- + body speed * SpeedSlack, capped at MaxSlack.
		BaseSlack = 1.0, -- positional tolerance for claims (studs)
		PingSlackPerSecond = 26, -- extra tolerance per second of ping (≈ sprint speed)
		SpeedSlack = 0.06, -- extra tolerance per stud/s of body speed
		MaxSlack = 5,
		-- Client-sent body position (CatchGeometry.claimRoot): accepted within
		-- Base + speed * SpeedTime + ping * speed of the server root (cap Max);
		-- otherwise the server root is led by its velocity * Lead.
		ClientRootBase = 2,
		ClientRootSpeedTime = 0.25,
		ClientRootMax = 8,
		ClientRootLead = 0.08,
		PickupRadius = 3.5,
		BobbleUp = 16,
		BobbleCarry = 0.25,
		BlockCarry = 0.18,
		BlockDown = -6,
	},

	-- Marker hand zones (for hand blocks on release). The box is centred on the
	-- marker and faces the marker's facing blended FacingBlend toward the
	-- thrower's pivot P, never more than MaxFacingOff degrees off P, so a
	-- marker aims the hands but cannot turn them away from the thrower.
	-- Distances (StallRange, DiscSpace) are measured from P, not the thrower's
	-- root, so a lunge cannot cause a disc-space call.
	Mark = {
		StallRange = 9, -- studs from P: ~10 ft
		DiscSpace = 2.4, -- a marker closer than this to P is a disc-space call
		MarkDistance = 3.2, -- where a marker stands upfield of P ...
		Shade = 1.6, -- ... shaded this far toward the break side
		MirrorMax = 2.4, -- bots mirror the thrower's step by at most this much
		FacingBlend = 0.5,
		MaxFacingOff = 35, -- degrees
		LowY = { 0.8, 4.6 }, -- above the ground: low/wide stance, knees to chest
		HighY = { 4.4, 8.2 }, -- hands up: shoulders to well above the head
		LowHalfWidth = 2.8,
		HighHalfWidth = 2.2,
		JumpBonus = 1, -- jumping lifts the box by the jump height plus up to this (arms stretch)
		DepthMin = -0.8, -- along the box forward (toward the thrower)
		DepthMax = 2.0,
		RelaxedRadius = 1.6, -- hands-down marker: small zone at the chest
		RewindBase = 0.05, -- hand blocks rewind markers by min(ping / 2 + RewindBase, RewindMax)
		RewindMax = 0.25,
	},
}

return Disc
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!strict
-- DEFAULT BINDINGS
-- One small vocabulary. Advanced techniques come from pressing these in
-- context and on time (see MovementSim header), not from extra keys.
--   Movement actions: Sprint, Jump, Cut, Slide, Dive, Burst
--   Disc actions:     Primary (throw / reach), Secondary (fake / mark)
--   With the disc:    Q / E quick swing left / right (the Cut / Dive keys),
--                     Space hop (high release), C low release, Z / X bank,
--                     mouse wheel or 1-5 throw type (T cycles too), R lead
--                     pass assist
--   Gamepad:          A jump, X cut (holding: swing to the other side),
--                     R1 burst, B slide, Y dive, L1 or L3 sprint
--   Marking:          hold Secondary near the holder; C toggles High / Low
-- Sprinting is automatic by default (AutoSprint: a full push held in one
-- direction for 0.3 s); Shift sprints at once and ToggleSprint still works.
-- Players can rebind everything in Settings > Controls; choices are saved.

local Input = {}

Input.Actions = {
	"Sprint",
	"Jump",
	"Cut",
	"Slide",
	"Dive",
	"Burst",
	"Primary",
	"Secondary",
	"BankLeft",
	"BankRight",
	"TypeNext",
	"TypePrev",
	"Type1",
	"Type2",
	"Type3",
	"Type4",
	"Type5",
	"LeadLock",
	"Celebrate",
	"Menu",
	"CameraLock",
}

Input.Display = {
	Sprint = "Sprint (hold; automatic when AutoSprint is on)",
	Jump = "Jump / Pop-up / Wall Rebound / Hop (with disc)",
	Cut = "Cut (Snap / Plant / Air Redirect) · Swing Left (with disc)",
	Slide = "Slide / Precision Landing · Low Release · Mark Stance",
	Dive = "Layout Dive · Swing Right (with disc)",
	Burst = "Burst Step (also restarts a plant)",
	Primary = "Throw (hold) / Reach",
	Secondary = "Fake Throw / Mark (hold near the holder)",
	BankLeft = "Bank Left (with disc)",
	BankRight = "Bank Right (with disc)",
	TypeNext = "Next Throw Type",
	TypePrev = "Previous Throw Type",
	Type1 = "Backhand",
	Type2 = "Forehand",
	Type3 = "Hammer",
	Type4 = "Scoober",
	Type5 = "Blade",
	LeadLock = "Lead Pass Assist",
	Celebrate = "Celebrate",
	Menu = "Menu",
	CameraLock = "Free / Lock Mouse",
}

-- Values are Enum.KeyCode / Enum.UserInputType names so they can be saved.
-- The first key of each list is the one shown in HUD key pips.
Input.Keyboard = {
	Sprint = { "LeftShift" },
	Jump = { "Space" },
	Cut = { "Q" },
	Slide = { "C", "LeftControl" },
	Dive = { "E" },
	Burst = { "F" },
	Primary = { "MouseButton1" },
	Secondary = { "MouseButton2" },
	BankLeft = { "Z" },
	BankRight = { "X" },
	TypeNext = { "T" },
	TypePrev = {},
	Type1 = { "One" },
	Type2 = { "Two" },
	Type3 = { "Three" },
	Type4 = { "Four" },
	Type5 = { "Five" },
	LeadLock = { "R" },
	Celebrate = { "B" },
	Menu = { "M" },
	CameraLock = { "LeftAlt" },
} :: { [string]: { string } }

Input.Gamepad = {
	Sprint = { "ButtonL1", "ButtonL3" },
	Jump = { "ButtonA" },
	Cut = { "ButtonX" },
	Slide = { "ButtonB" },
	Dive = { "ButtonY" },
	Burst = { "ButtonR1" },
	Primary = { "ButtonR2" },
	Secondary = { "ButtonL2" },
	BankLeft = { "DPadLeft" },
	BankRight = { "DPadRight" },
	TypeNext = { "DPadUp" },
	TypePrev = { "DPadDown" },
	LeadLock = { "ButtonR3" },
	Celebrate = { "DPadDown" },
	Menu = { "ButtonSelect" },
} :: { [string]: { string } }

-- Stick shaping (applied by InputController): below Dead the stick reads 0,
-- from Full it reads 1, linear in between, so small tilts start at a crawl and
-- pads that never report a full 1.0 still reach top speed.
Input.Stick = {
	GamepadDead = 0.15,
	GamepadFull = 0.92,
	TouchDead = 0.1,
	TouchFull = 0.92,
}

-- AutoSprint: sprint once the move input has been at least MinMagnitude for
-- ChargeTime without leaving a MaxAngle cone; it then lasts while the input
-- stays strong (short dips under Grace are forgiven, e.g. switching keys).
Input.AutoSprint = {
	MinMagnitude = 0.9,
	ChargeTime = 0.3,
	MaxAngle = 35,
	Grace = 0.15,
}

-- Short key names for HUD pips / hints ("Q", "LMB", "SHIFT"). Anything not
-- listed is shown upper-cased.
Input.KeyLabels = {
	LeftShift = "SHIFT",
	RightShift = "SHIFT",
	LeftControl = "CTRL",
	RightControl = "CTRL",
	LeftAlt = "ALT",
	RightAlt = "ALT",
	Space = "SPACE",
	Return = "ENTER",
	Tab = "TAB",
	Backspace = "BKSP",
	MouseButton1 = "LMB",
	MouseButton2 = "RMB",
	MouseButton3 = "MMB",
	One = "1",
	Two = "2",
	Three = "3",
	Four = "4",
	Five = "5",
	Six = "6",
	Seven = "7",
	Eight = "8",
	Nine = "9",
	Zero = "0",
	ButtonA = "A",
	ButtonB = "B",
	ButtonX = "X",
	ButtonY = "Y",
	ButtonL1 = "L1",
	ButtonR1 = "R1",
	ButtonL2 = "L2",
	ButtonR2 = "R2",
	ButtonL3 = "L3",
	ButtonR3 = "R3",
	ButtonSelect = "VIEW",
	ButtonStart = "MENU",
	DPadLeft = "D-LEFT",
	DPadRight = "D-RIGHT",
	DPadUp = "D-UP",
	DPadDown = "D-DOWN",
	Up = "UP",
	Down = "DOWN",
	Left = "LEFT",
	Right = "RIGHT",
} :: { [string]: string }

-- Label for one key name ("LeftShift" -> "SHIFT"); "" for nil.
function Input.keyLabel(name: string?): string
	if name == nil or name == "" then
		return ""
	end
	return Input.KeyLabels[name] or string.upper(name)
end

-- Bump SettingsVersion when a default changes on purpose; keys listed under
-- the new version in Migrations are reset to their default for profiles saved
-- by an older version (everything else a player saved is kept).
Input.SettingsVersion = 2
Input.Migrations = {
	[2] = { "ShowTechLabels" }, -- technique labels are now off by default (less HUD noise)
} :: { [number]: { string } }

Input.DefaultSettings = {
	SettingsVersion = Input.SettingsVersion,
	MouseSensitivity = 1.0,
	GamepadSensitivity = 1.0,
	TouchSensitivity = 1.0,
	InvertY = false,
	FieldOfView = 72,
	CameraShake = true,
	ShowComboFeed = true,
	ShowTechLabels = false,
	AutoSprint = true,
	ToggleSprint = false,
	AutoSprintTouch = true,
	LeftHanded = false,
	TrajectoryPreview = true,
	TouchButtonScale = 1.0,
	MasterVolume = 0.8,
	SfxVolume = 1.0,
	CrowdVolume = 0.7,
}

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Modes</string>
            <string name="Source"><![CDATA[--!strict
--[[
	MATCH RULE PRESETS — exactly two modes, both PvP first:

	  Mini    3v3 on the Mini field (240 x 90 including end zones)
	  Normal  7v7 on the Normal field (360 x 136 including end zones)

	Which mode is played follows the head count (Modes.eligible): up to 6
	humans play Mini, 10 or more play Normal, and 7-9 humans may vote between
	them. Empty spots are filled with bots (FillWithBots) so the field is always
	exactly 3v3 or 7v7; Rules/MatchPlan decides who is on the line each point.

	Ranked is not a mode. A match is ranked automatically when its mode is
	RankedEligible, the server is public (not private, not Studio) and both
	lines are all human (MatchPlan.rankedEligible). Ranked matches play the
	preset plus Modes.RankedOverrides and never take private-server rules.

	Private servers (and Studio) let the host change the keys in
	Modes.Editable, including which mode is played; Modes.resolve applies them.
]]

local Modes = {}

-- Field sizes in studs. `length` is the playing field proper (between the
-- goal lines); the total length is length + 2 * endZone. `brick` is measured
-- from the goal line into the playing field.
export type FieldSpec = {
	width: number,
	length: number,
	endZone: number,
	brick: number,
}

Modes.Fields = {
	Mini = { width = 90, length = 160, endZone = 40, brick = 44 },
	Normal = { width = 136, length = 240, endZone = 60, brick = 64 },
} :: { [string]: FieldSpec }

export type ModeRules = {
	id: string,
	Display: string,
	Short: string, -- "3v3" / "7v7" for compact HUD lines
	Description: string,
	TeamSize: number, -- players per team on the field
	Field: string, -- key into Modes.Fields
	PointsToWin: number,
	TimeCap: number, -- seconds; when reached the current point finishes
	StallMax: number,
	StallInterval: number,
	UsePull: boolean,
	PullTimeout: number,
	PointSetupTime: number,
	CelebrationTime: number,
	FillWithBots: boolean, -- bots take every empty spot so the line is always TeamSize
	PreviewFraction: number, -- how much of the throw arc the thrower sees (0..1)
	LandingShadow: boolean, -- show the disc's ground shadow
	RankedEligible: boolean, -- may become ranked when the lines are all human
	Ranked: boolean, -- true only on rules resolved for a ranked match
	SpecialArenas: boolean, -- arenas with rebound walls may be picked
	StartUniverse: boolean, -- the first point is already universe point
}

local function mode(t: ModeRules): ModeRules
	return t
end

Modes.List = {
	Mini = mode({
		id = "Mini",
		Display = "Mini 3v3",
		Short = "3v3",
		Description = "3 v 3 on a compact field, first to 5. Bots fill empty spots.",
		TeamSize = 3,
		Field = "Mini",
		PointsToWin = 5,
		TimeCap = 420,
		StallMax = 8,
		StallInterval = 1.0,
		UsePull = true,
		PullTimeout = 8,
		PointSetupTime = 3,
		CelebrationTime = 3,
		FillWithBots = true,
		PreviewFraction = 0.5,
		LandingShadow = true,
		RankedEligible = true,
		Ranked = false,
		SpecialArenas = true,
		StartUniverse = false,
	}),
	Normal = mode({
		id = "Normal",
		Display = "Normal 7v7",
		Short = "7v7",
		Description = "7 v 7 on the full field, first to 5. Bots fill empty spots.",
		TeamSize = 7,
		Field = "Normal",
		PointsToWin = 5,
		TimeCap = 720,
		StallMax = 10,
		StallInterval = 1.0,
		UsePull = true,
		PullTimeout = 10,
		PointSetupTime = 4,
		CelebrationTime = 4,
		FillWithBots = true,
		PreviewFraction = 0.35,
		LandingShadow = true,
		RankedEligible = true,
		Ranked = false,
		SpecialArenas = true,
		StartUniverse = false,
	}),
} :: { [string]: ModeRules }

-- Smallest mode first; also the order modes are shown in.
Modes.Order = { "Mini", "Normal" }
Modes.Default = "Mini"

-- Applied on top of the preset when a match is ranked.
Modes.RankedOverrides = {
	PreviewFraction = 0.2,
	SpecialArenas = false,
} :: { [string]: any }

export type EditSpec = {
	label: string,
	bool: boolean?,
	options: { string }?,
	min: number?,
	max: number?,
	step: number?,
}

-- Keys a private-server (or Studio) host can change, with legal ranges.
-- `Mode` picks the preset itself; the field always follows the mode.
Modes.Editable = {
	Mode = { label = "Mode", options = { "Mini", "Normal" } },
	FillWithBots = { label = "Fill with bots", bool = true },
	PointsToWin = { label = "Points to win", min = 1, max = 15, step = 1 },
	TimeCap = { label = "Time cap (s)", min = 60, max = 1800, step = 30 },
	StallMax = { label = "Stall count", min = 5, max = 10, step = 1 },
	StallInterval = { label = "Stall interval (s)", min = 0.7, max = 1.2, step = 0.1 },
	UsePull = { label = "Pulls", bool = true },
	PreviewFraction = { label = "Throw preview", min = 0, max = 1, step = 0.1 },
	LandingShadow = { label = "Landing shadow", bool = true },
} :: { [string]: EditSpec }

-- Display order for the host's rules panel.
Modes.EditableOrder = {
	"Mode",
	"FillWithBots",
	"PointsToWin",
	"TimeCap",
	"StallMax",
	"StallInterval",
	"UsePull",
	"PreviewFraction",
	"LandingShadow",
}

function Modes.has(id: string?): boolean
	return id ~= nil and Modes.List[id] ~= nil
end

-- A fresh copy of a preset (unknown ids give the default mode).
function Modes.copy(id: string?): ModeRules
	local base = if id and Modes.List[id] then Modes.List[id] else Modes.List[Modes.Default]
	return table.clone(base)
end

-- Which modes a lobby of `humans` players may play, and the one picked when
-- nobody votes. Players only vote when more than one mode is returned.
--   <= 6 humans: Mini        7: Mini or Normal (default Mini)
--   8-9: Mini or Normal (default Normal)   >= 10: Normal
function Modes.eligible(humans: number): ({ string }, string)
	if humans <= 6 then
		return { "Mini" }, "Mini"
	elseif humans <= 9 then
		return { "Mini", "Normal" }, if humans == 7 then "Mini" else "Normal"
	end
	return { "Normal" }, "Normal"
end

-- The legal form of a host-edited value, or nil when it can't be used.
-- Numbers are clamped to the range; keys with whole-number steps take whole
-- numbers, the rest are rounded to 1e-6 so stepping 0.1 at a time stays tidy.
function Modes.sanitize(key: string, value: any): any
	local spec = Modes.Editable[key]
	if spec == nil then
		return nil
	end
	if spec.bool then
		return if type(value) == "boolean" then value else nil
	end
	local options = spec.options
	if options then
		return if type(value) == "string" and table.find(options, value) then value else nil
	end
	if type(value) ~= "number" or value ~= value then
		return nil
	end
	local v = math.clamp(value, spec.min or -math.huge, spec.max or math.huge)
	if (spec.step or 0) >= 1 then
		return math.floor(v + 0.5)
	end
	return math.floor(v * 1e6 + 0.5) / 1e6
end

-- Current value of every editable key for a preset (what the host panel shows
-- before anything is changed). `Mode` is the preset id.
function Modes.editableDefaults(id: string?): { [string]: any }
	local base = Modes.copy(id)
	local out: { [string]: any } = {}
	for _, key in Modes.EditableOrder do
		out[key] = if key == "Mode" then base.id else (base :: any)[key]
	end
	return out
end

export type ResolveOptions = {
	ranked: boolean?, -- this match is ranked: apply RankedOverrides, ignore `private`
	private: { [string]: any }?, -- host-edited keys (private server / Studio)
}

-- The rules a match actually plays. A ranked match is the preset plus
-- RankedOverrides and never takes private config. Otherwise the host's
-- `Mode` (when valid) picks the preset and the other editable keys are
-- applied after sanitising; unknown keys are ignored.
function Modes.resolve(id: string?, opts: ResolveOptions?): ModeRules
	local o: ResolveOptions = opts or {}
	if o.ranked then
		local rules = Modes.copy(id)
		for k, v in Modes.RankedOverrides do
			(rules :: any)[k] = v
		end
		rules.Ranked = true
		return rules
	end
	local private = o.private
	local pick = id
	if private and Modes.has(private.Mode) then
		pick = private.Mode
	end
	local rules = Modes.copy(pick)
	if private then
		for _, key in Modes.EditableOrder do
			if key ~= "Mode" and private[key] ~= nil then
				local v = Modes.sanitize(key, private[key])
				if v ~= nil then
					(rules :: any)[key] = v
				end
			end
		end
	end
	rules.Ranked = false
	return rules
end

return Modes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- MOVEMENT TUNING
-- Every number that shapes how a player moves lives here. Units are studs and
-- seconds. See docs/DESIGN.md ("Movement model") for the reasoning behind each
-- value and the intended counterplay of every technique.
--
-- The Humanoid moves the body; MovementSim decides the velocity. These numbers
-- are therefore the real feel of the game: the client feeds the sim's output
-- straight into Humanoid:Move / WalkSpeed (and writes AssemblyLinearVelocity on
-- technique impulses), so nothing downstream softens them.
--
-- Philosophy: every press does something visible; timing only changes the
-- bonus. Technique speed thresholds are scaled x1.08 from the original tuning
-- to keep their relation to the faster sprint (26 -> 28).

local Movement = {
	-- Locomotion -----------------------------------------------------------
	JogSpeed = 18,
	SprintSpeed = 28,
	ExhaustedSprintSpeed = 23, -- sprint top speed while exertion is (nearly) empty
	HardCap = 36, -- absolute horizontal speed limit, enforced client + server
	Gravity = 160, -- workspace gravity for characters (the disc uses its own, see Config/Disc)

	Accel = 70, -- speeding up along the current direction (95% of sprint in ~0.32 s)
	AccelFromRest = 140, -- isotropic acceleration below RestSpeed (fast starts)
	RestSpeed = 9,
	Brake = 130, -- input opposes motion
	Coast = 100, -- no input (stop from sprint in ~0.28 s)
	-- Sideways (turning) acceleration depends on speed: nimble at jog, committed
	-- at sprint. Turn radius ~1.2 studs at jog, ~6 studs at full sprint.
	LateralAccelLow = 260, -- at or below JogSpeed
	LateralAccel = 130, -- at SprintSpeed and above
	OverspeedDecay = 45, -- bleeds speed above the current top speed (after bursts)

	AirAccel = 30,
	AirMinControlSpeed = 12,
	AirGainAllowance = 4, -- air control can never add more than this over takeoff speed

	JumpVelocity = 46,
	JumpSpeedBonus = 4, -- extra jump velocity at full sprint (momentum-sensitive jump)
	CoyoteTime = 0.12,

	LandingRecovery = 0.08,
	LandingSteer = 0.7,
	LandingRetention = 0.96,

	-- Collision reconciliation: the sim adopts the body's real velocity only when
	-- something solid is really in the way (the client's ray says env.blocked)
	-- and the body has lagged behind the sim for a moment.
	ReconcileFraction = 0.6, -- real speed along the sim direction below this x sim speed ...
	ReconcileTime = 0.08, -- ... for longer than this

	-- A frame whose output velocity jumps by more than this (studs/s) is an
	-- impulse: the client writes AssemblyLinearVelocity directly on it.
	ImpulseThreshold = 4,

	-- Presses that are a little early / in a short cooldown / about to become
	-- valid are kept this long inside the sim and retried every step.
	InputBuffer = 0.15,

	-- Exertion -------------------------------------------------------------
	ExertionMax = 100,
	ExertionRegen = 25, -- per second when not sprinting
	SprintRegen = 8, -- per second while sprinting (still offsets SprintDrain)
	SprintDrain = 2.0, -- per second while sprinting above jog speed
	ExertionRegenDelay = 0.5, -- pause before regen, only after a technique spend
	ExhaustedBelow = 15, -- sprint top speed fades toward ExhaustedSprintSpeed below this
	GassedFraction = 0.5, -- a technique is Gassed only when exertion < cost x this

	ChainWindow = 1.5, -- techniques within this gap count as one combo chain

	-- Running line ("commitment") that grades Snap Cuts and Plants.
	CommitAngle = 30, -- velocity within this many degrees stays on "the same line"
	CommitMinSpeed = 10.8, -- below this you are not committed to any line
	LineMemory = 0.2, -- after the line breaks, cuts are still judged against the old line this long
	LineSpeedDecay = 40, -- the remembered line speed fades this fast (studs/s per s)

	Quality = {
		Perfect = "Perfect",
		Clean = "Clean",
		Sloppy = "Sloppy",
		Gassed = "Gassed",
	},

	-- Techniques -----------------------------------------------------------
	SnapCut = {
		Cost = 10,
		MinInterval = 0.15, -- cuts closer than this are buffered, not dropped
		MinSpeed = 5.4, -- below this, Q with a direction is a quick side step
		MaxAngle = 120, -- beyond this (from the running line) Q plants instead
		CommitClean = 0.2, -- seconds on one line before a cut is "clean"
		CommitPerfect = 0.45,
		PerfectSpeedFraction = 0.75, -- must also be near full speed for Perfect
		SpamWindow = 0.3, -- a cut this soon after another cut is always Sloppy
		AnglePenalty = 0.08, -- extra retention lost as the cut approaches MaxAngle
		PerfectBoost = 2,
		Retention = { Perfect = 0.98, Clean = 0.92, Sloppy = 0.80, Gassed = 0.72 },
		ExitFloor = 0.7, -- non-Gassed cuts leave at >= this x SprintSpeed (JogSpeed if slower): beats plain steering
		SoldMinSpeedFraction = 0.8, -- a cut out of a Fake Commit leaves at >= this x sprint
	},

	MomentumCancel = {
		Cost = 10,
		Cooldown = 0.45,
		MinSpeed = 10.8,
		PlantTime = 0.12,
		BrakeDecel = 330,
		WindowOpen = 0.06, -- restart presses before this are buffered until it opens
		PerfectUntil = 0.22,
		WindowClose = 0.40,
		RestartRetention = { Perfect = 0.95, Clean = 0.85 }, -- x SprintSpeed (pressed restart)
		AutoRestart = 0.8, -- x SprintSpeed when a direction is simply held as the plant ends
	},

	FakeCommit = {
		Cost = 6,
		Cooldown = 0.5,
		MaxAngle = 25, -- Cut pressed within this angle of the line = look-ahead, then jab
		LookAhead = 0.1, -- a steer >= MaxAngle this soon after the press becomes a Snap Cut
		JabTime = 0.08,
		JabSlow = 0.92,
		JabSteer = 0.5, -- lateral steering kept during the jab
		SideStepSpeed = 14, -- Q below SnapCut.MinSpeed: quick side step
		SideStepTime = 0.15,
		SoldWindow = 0.6,
		SoldMinAngle = 30,
	},

	BurstStep = {
		Cost = 22,
		Cooldown = 1.2,
		Duration = 0.2,
		SpeedMult = 1.2,
		MinSpeed = 31,
		MaxSpeed = 35,
		GassedMult = 1.12,
		CutChainWindow = 0.25, -- Perfect within this of a Snap Cut / Slide Cut / pop / plant
	},

	Slide = {
		Cost = 8,
		Cooldown = 0.5,
		MinSpeed = 10.8,
		Boost = 3,
		BoostCeiling = 31, -- slide boost can never push speed past this
		Friction = 13,
		SteerRate = 50, -- degrees per second
		MaxTime = 0.9,
		ExitSpeed = 9.7,
	},

	SlideCut = {
		Cost = 8,
		MinSlideTime = 0.05, -- earlier presses are buffered
		PerfectFrom = 0.2,
		PerfectTo = 0.6,
		MaxAngle = 160,
		Retention = { Perfect = 0.94, Clean = 0.84, Gassed = 0.7 },
	},

	Dive = {
		Cost = 18,
		Cooldown = 0.9,
		GroundBonus = 4,
		GroundMin = 26,
		GroundMax = 34,
		GassedMin = 23,
		GassedMax = 28,
		GroundVertical = 22,
		AirBoost = 9,
		AirMax = 33,
		AirVertical = 4,
		MaxVertical = 24,
		ChainWindow = 0.4, -- Perfect layout within this of a Snap Cut, Burst, Slide, ...
	},

	DiveSlide = {
		Friction = 60,
		StopSpeed = 5.4,
		MaxTime = 0.5,
	},

	Recover = {
		Time = 0.3,
		Steer = 0.35, -- lateral steering while getting up
		PopFrom = 0.15, -- the pop-up is accepted from this long after the dive touches down ...
		PopPerfect = 0.10, -- ... and is Perfect within this of the slide stopping
		Retention = { Perfect = 0.75, Clean = 0.55 }, -- x SprintSpeed (never below current speed)
		PopJumpFraction = 0.8,
	},

	RollOut = {
		RecoverTime = 0.16,
		Retention = { Perfect = 0.72, Clean = 0.58 },
	},

	AirRedirect = {
		Cost = 8,
		MaxAngle = 80,
		MinAngle = 20, -- input closer than this to travel: no-op, not consumed
		ApexWindow = 15, -- |vertical velocity| below this = Perfect
		MinVertical = -6, -- redirect briefly arrests a fall to at most this
		MinSpeed = 4,
		StillSpeed = 8.6, -- redirecting a near-vertical jump gives this much drift
		Retention = { Perfect = 0.97, Clean = 0.9, Gassed = 0.7 },
	},

	PrecisionLanding = {
		ArmWindow = 0.35, -- Slide in the air arms it once time-to-land is at most this
		PerfectWindow = 0.08, -- armed this close to touchdown = Perfect
		CleanWindow = 0.22, -- = Clean; armed earlier = soft landing (no label)
		LateWindow = 0.12, -- pressed this soon after touchdown = Clean (late)
		Retention = { Perfect = 1.0, Clean = 0.98, Soft = 0.96 },
	},

	WallRebound = {
		Cost = 10,
		MaxPerAir = 2,
		Retention = 0.9,
		PushOff = 6,
		Vertical = 36,
		PerfectDistance = 1.2,
		DetectDistance = 3.5, -- client ray length (along velocity, look, and both sides)
	},

	-- Holding the disc: the pivot. A planted pivot foot P and a free-foot step
	-- vector s in the throw frame (forward = aim yaw). The root follows
	-- P + BodyShare * s.
	Holding = {
		DecelRate = 70, -- slow-down after the (predicted) catch
		DecelMaxTime = 0.45,
		PlantSpeed = 4, -- the pivot foot plants as soon as speed drops below this
		StepRadius = 3.6, -- R: the free foot reaches this far from P
		ForwardMax = 0.75, -- forward part of the step <= this x R (lunge)
		BackMax = 0.9, -- backward part <= this x R (drop step)
		StepSpring = 22, -- critically damped spring on the step length (1/s)
		StepAngular = 720, -- deg/s the step turns around the pivot (through the front)
		BodyShare = 0.55, -- the root sits at P + BodyShare * s
		DriveGain = 14, -- root velocity = gain x distance to its target ...
		DriveMax = 18, -- ... capped here (Humanoid WalkSpeed while pivoting)
		SwingLateral = 0.95, -- Quick Swing target = (side x 0.95R, +0.25R)
		SwingForward = 0.25,
		SwingAngular = 1100,
		SwingSpring = 30,
		SwingTime = 0.18,
		SwingCooldown = 0.4,
		SwingCost = 4,
		SwingSoldWindow = 0.35, -- a swing this soon after a fake is Perfect ("Sold")
		FakeStep = 0.6, -- the fake lunges the step 0.6R toward the held side ...
		FakeStepOut = 0.12, -- ... in this long ...
		FakeStepBack = 0.15, -- ... and springs back in about this long
		HopVertical = 30, -- one hop per possession (2.8-stud peak, ~0.375 s airtime)
		PivotRadius = 0, -- derived below: the furthest the root may be from P
	},

	-- Marking: hold RMB within Range of the holder to mark-shuffle.
	Marking = {
		ShuffleSpeed = 15,
		Accel = 140,
		Brake = 160,
		Range = 8,
	},

	-- Combo base points per technique (see ComboEvaluator).
	ComboPoints = {
		SnapCut = 100,
		MomentumCancel = 120,
		AirRedirect = 140,
		SlideCut = 120,
		WallRebound = 150,
		PrecisionLanding = 130,
		BurstStep = 90,
		FakeCommit = 110,
		Dive = 160,
		RecoveryChain = 150,
		AerialReach = 120,
		Slide = 60,
		Jump = 20,
		PivotSwing = 120,
		Break = 250,
	},

	-- Display names for UI / feedback.
	TechNames = {
		SnapCut = "Snap Cut",
		MomentumCancel = "Momentum Cancel",
		AirRedirect = "Air Redirect",
		SlideCut = "Slide Cut",
		WallRebound = "Wall Rebound",
		PrecisionLanding = "Precision Landing",
		BurstStep = "Burst Step",
		FakeCommit = "Fake Commit",
		Dive = "Layout",
		RecoveryChain = "Recovery Chain",
		AerialReach = "Aerial Reach",
		Slide = "Slide",
		Jump = "Jump",
		PivotSwing = "Pivot Swing",
		Break = "Break",
	},
}

-- The root never strays further than this from the pivot foot (server travel
-- checks add their latency slack on top).
Movement.Holding.PivotRadius = Movement.Holding.StepRadius * Movement.Holding.BodyShare

-- Techniques the server validates (cost + cooldown mirror). Cooldown 0 means
-- rate-limited only.
Movement.TechCosts = {
	SnapCut = Movement.SnapCut.Cost,
	MomentumCancel = Movement.MomentumCancel.Cost,
	FakeCommit = Movement.FakeCommit.Cost,
	BurstStep = Movement.BurstStep.Cost,
	Slide = Movement.Slide.Cost,
	SlideCut = Movement.SlideCut.Cost,
	Dive = Movement.Dive.Cost,
	AirRedirect = Movement.AirRedirect.Cost,
	WallRebound = Movement.WallRebound.Cost,
	PivotSwing = Movement.Holding.SwingCost,
	PrecisionLanding = 0,
	RecoveryChain = 0,
	AerialReach = 0,
	Jump = 0,
	Break = 0,
}

Movement.TechCooldowns = {
	SnapCut = Movement.SnapCut.MinInterval,
	MomentumCancel = Movement.MomentumCancel.Cooldown,
	FakeCommit = Movement.FakeCommit.Cooldown,
	BurstStep = Movement.BurstStep.Cooldown,
	Slide = Movement.Slide.Cooldown,
	SlideCut = 0,
	Dive = Movement.Dive.Cooldown,
	AirRedirect = 0,
	WallRebound = 0,
	PivotSwing = Movement.Holding.SwingCooldown,
	PrecisionLanding = 0,
	RecoveryChain = 0,
	AerialReach = 0,
	Jump = 0,
	Break = 0,
}

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict
-- PROGRESSION, COSMETICS, ACHIEVEMENTS
-- Nothing here changes how a player moves, throws or catches. Every unlock is
-- visual. There are no purchases that affect competition.

local Progression = {}

Progression.XP = {
	MatchPlayed = 100,
	MatchWon = 60,
	PvPMultiplier = 1.5, -- match XP when both teams had human players (vs bots: x1)
	Goal = 25,
	Assist = 20,
	Callahan = 80,
	Catch = 4,
	Completion = 3,
	Interception = 20,
	Block = 18,
	Layout = 15,
	Greatest = 60,
	Highlight = 20,
	-- Combos pay from Summary.xpScore (converted: x2 score; not converted:
	-- 25 % of it, settled once the chain can no longer be converted).
	ComboPerHundred = 1, -- 1 XP per 100 xpScore points
	ComboCap = 60, -- per converted chain
	UnconvertedComboCap = 30, -- per unconverted chain
	UnconvertedMatchCap = 120, -- unconverted chains, per player per match (match play only)
	TrainingDrill = 15,
	PersonalBest = 25,
}

function Progression.xpForLevel(level: number): number
	return 300 + 75 * level
end

Progression.MaxLevel = 100

Progression.Divisions = {
	{ name = "Bronze", min = -math.huge, color = Color3.fromRGB(176, 120, 72) },
	{ name = "Silver", min = 900, color = Color3.fromRGB(190, 196, 206) },
	{ name = "Gold", min = 1100, color = Color3.fromRGB(242, 196, 64) },
	{ name = "Platinum", min = 1300, color = Color3.fromRGB(96, 220, 210) },
	{ name = "Diamond", min = 1500, color = Color3.fromRGB(120, 160, 255) },
	{ name = "Breakpoint", min = 1700, color = Color3.fromRGB(255, 92, 160) },
} :: { any }

Progression.Rating = {
	Start = 1000,
	KNew = 40, -- first PlacementGames
	K = 24,
	PlacementGames = 10,
	Season = "S1",
}

-- Disc skins: purely visual (colour, material, rim, stripe).
Progression.DiscSkins = {
	{
		id = "Classic",
		name = "Classic White",
		level = 1,
		color = Color3.fromRGB(245, 245, 240),
		rim = Color3.fromRGB(210, 210, 205),
		stripe = Color3.fromRGB(30, 140, 255),
	},
