    <Item class="StarterCharacterScripts" referent="58">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="59">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[--!strict
-- Replaces Roblox's default "Animate" script (same name in
-- StarterCharacterScripts). Plays base locomotion from the character's real
-- velocity so animation always matches the movement engine. The local
-- MovementController publishes its mode in the "UB_LocalMode" attribute.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local character = script.Parent :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local root = character:WaitForChild("HumanoidRootPart") :: BasePart

local Locomotion =
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Animation"):WaitForChild("Locomotion"))

local controller = Locomotion.new(humanoid)

local POSE_MODES = {
	Slide = true,
	Dive = true,
	DiveSlide = true,
	Recover = true,
}

local connection = RunService.Heartbeat:Connect(function(dt)
	if humanoid.Health <= 0 then
		return
	end
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local localMode = character:GetAttribute("UB_LocalMode")
	local state = humanoid:GetState()
	local mode: Locomotion.Mode = "Ground"
	if type(localMode) == "string" and POSE_MODES[localMode] then
		mode = "Pose"
	elseif state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
		mode = if v.Y > 2 then "Rising" else "Falling"
	end
	Locomotion.update(controller, dt, speed, mode)
end)

humanoid.Died:Connect(function()
	connection:Disconnect()
	Locomotion.destroy(controller)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="60">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="62">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
-- AudioController — plays cues from Config/Audio, 2D or positioned in the world.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AudioConfig = require(Shared.Config.Audio)

local AudioController = {}

local controllers: any
local templates: { [string]: Sound } = {}
local loops: { [string]: Sound } = {}

local function volumeFor(cue: string): number
	local settings = controllers.SettingsController
	local master = settings.get("MasterVolume") or 1
	local group = if string.find(cue, "Crowd") then settings.get("CrowdVolume") else settings.get("SfxVolume")
	return master * (group or 1)
end

local function template(cue: string): Sound?
	local cfg = (AudioConfig.Cues :: any)[cue]
	if not cfg or cfg.id == "" then
		return nil
	end
	local s = templates[cue]
	if not s then
		local snd = Instance.new("Sound")
		snd.Name = cue
		snd.SoundId = cfg.id
		snd.Volume = cfg.volume
		snd.PlaybackSpeed = cfg.pitch or 1
		snd.Looped = cfg.looped == true
		snd.Parent = SoundService
		templates[cue] = snd
		s = snd
	end
	return s
end

-- 2D cue (UI, your own actions).
function AudioController.play(cue: string, pitchJitter: number?)
	local t = template(cue)
	if not t then
		return
	end
	local s = t:Clone()
	local cfg = (AudioConfig.Cues :: any)[cue]
	s.Volume = cfg.volume * volumeFor(cue)
	if pitchJitter then
		s.PlaybackSpeed = (cfg.pitch or 1) * (1 + (math.random() - 0.5) * pitchJitter)
	end
	s.Parent = SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
	task.delay(6, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

-- Positional cue in the world.
function AudioController.playAt(cue: string, position: Vector3)
	local t = template(cue)
	if not t then
		return
	end
	local att = Instance.new("Attachment")
	att.WorldPosition = position
	att.Parent = workspace.Terrain
	local s = t:Clone()
	local cfg = (AudioConfig.Cues :: any)[cue]
	s.Volume = cfg.volume * volumeFor(cue)
	s.RollOffMaxDistance = 260
	s.RollOffMinDistance = 20
	s.Parent = att
	s:Play()
	task.delay(4, function()
		att:Destroy()
	end)
end

function AudioController.loop(cue: string, on: boolean)
	local t = template(cue)
	if not t then
		return
	end
	local s = loops[cue]
	if on and not s then
		local snd = t:Clone()
		snd.Looped = true
		snd.Volume = (AudioConfig.Cues :: any)[cue].volume * volumeFor(cue)
		snd.Parent = SoundService
		snd:Play()
		loops[cue] = snd
	elseif not on and s then
		s:Destroy()
		loops[cue] = nil
	end
end

function AudioController.Init(c: any)
	controllers = c
end

function AudioController.Start()
	AudioController.loop("CrowdLoop", true)
	controllers.SettingsController.Changed:Connect(function()
		for cue, s in loops do
			s.Volume = (AudioConfig.Cues :: any)[cue].volume * volumeFor(cue)
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CameraController — over-the-shoulder orbit camera that doubles as the aim.

	Yaw/pitch come from the mouse (locked to the centre during play), the right
	gamepad stick or a touch drag. The camera pulls in when something solid is
	behind the player, widens its FOV slightly with speed and can add a small,
	optional shake. It never takes control away (no forced cinematics).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CameraController = {}

local controllers: any
local camera: Camera
local yaw = 0
local pitch = math.rad(-12)
local distance = 12
local targetDistance = 12
local focus: Vector3? = nil
local fov = 72
local kick = 0
local shakeAmp = 0
local shakeUntil = 0
local locked = true
local gamepadLook = Vector2.zero
local touchDelta = Vector2.zero

local MIN_PITCH = math.rad(-70)
local MAX_PITCH = math.rad(55)
local SHOULDER = 1.7

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

function CameraController.getYaw(): number
	return yaw
end

function CameraController.getPitch(): number
	return pitch
end

function CameraController.setYaw(y: number)
	yaw = y
end

function CameraController.getAimDirection(): Vector3
	return camera.CFrame.LookVector
end

function CameraController.getCFrame(): CFrame
	return camera.CFrame
end

-- Horizontal forward of the camera.
function CameraController.forward(): Vector3
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

function CameraController.kick(amount: number)
	kick = math.max(kick, amount)
end

function CameraController.shake(amplitude: number, duration: number)
	if not controllers.SettingsController.get("CameraShake") then
		return
	end
	shakeAmp = math.max(shakeAmp, amplitude)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

function CameraController.setLocked(l: boolean)
	locked = l
end

function CameraController.isLocked(): boolean
	return locked and not controllers.InputController.menuOpen()
end

function CameraController.addTouchDelta(d: Vector2)
	touchDelta += d
end

local function update(dt: number)
	local player = Players.LocalPlayer
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	camera.CameraType = Enum.CameraType.Scriptable
	local settings = controllers.SettingsController
	local active = CameraController.isLocked()

	UserInputService.MouseBehavior = if active then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = not active

	local invert = if settings.get("InvertY") then -1 else 1
	if active then
		local md = UserInputService:GetMouseDelta()
		local sens = 0.0042 * settings.get("MouseSensitivity")
		yaw -= md.X * sens
		pitch -= md.Y * sens * invert
	end
	if not controllers.InputController.menuOpen() then
		local gs = gamepadLook
		if gs.Magnitude > 0.12 then
			local sens = 3.4 * settings.get("GamepadSensitivity") * dt
			yaw -= gs.X * math.abs(gs.X) * sens
			pitch += gs.Y * math.abs(gs.Y) * sens * 0.7 * invert
		end
		if touchDelta.Magnitude > 0 then
			local sens = 0.006 * settings.get("TouchSensitivity")
			yaw -= touchDelta.X * sens
			pitch -= touchDelta.Y * sens * invert
		end
	end
	touchDelta = Vector2.zero
	pitch = math.clamp(pitch, MIN_PITCH, MAX_PITCH)

	if not root then
		return
	end
	local target = root.Position + Vector3.new(0, 2.3, 0)
	local f = focus
	if f == nil or (f - target).Magnitude > 30 then
		f = target
	else
		f = f:Lerp(target, 1 - math.exp(-28 * dt))
	end
	focus = f

	local rot = CFrame.fromOrientation(pitch, yaw, 0)
	local look = rot.LookVector
	local right = rot.RightVector
	distance += (targetDistance - distance) * (1 - math.exp(-10 * dt))
	local pivot = (f :: Vector3) + right * SHOULDER
	local desired = pivot - look * distance

	-- pull in when blocked
	local exclude: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("UBBots")
	if bots then
		table.insert(exclude, bots)
	end
	local visuals = workspace:FindFirstChild("UBVisuals")
	if visuals then
		table.insert(exclude, visuals)
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pivot, desired - pivot, rayParams)
	local camPos = if hit then hit.Position + hit.Normal * 0.4 else desired

	-- feel: speed FOV, kick, shake
	local v = root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local baseFov = settings.get("FieldOfView")
	local targetFov = baseFov + math.clamp((speed - 17) / 9, 0, 1) * 5 + kick
	fov += (targetFov - fov) * (1 - math.exp(-8 * dt))
	kick = math.max(0, kick - 30 * dt)
	camera.FieldOfView = fov

	local cf = CFrame.lookAt(camPos, camPos + look)
	local clock = os.clock()
	if clock < shakeUntil then
		local a = shakeAmp * (shakeUntil - clock) / 0.3
		cf *= CFrame.new(math.noise(clock * 30, 1) * a, math.noise(clock * 30, 2) * a, 0)
	else
		shakeAmp = 0
	end
	camera.CFrame = cf
	camera.Focus = CFrame.new(f :: Vector3)
end

function CameraController.Init(c: any)
	controllers = c
	camera = workspace.CurrentCamera
end

function CameraController.Start()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		camera = workspace.CurrentCamera
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject, gameProcessed: boolean)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			gamepadLook = Vector2.new(input.Position.X, input.Position.Y)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not gameProcessed then
			-- wheel zooms only while not holding a disc (then it cycles throw type)
			if not controllers.ThrowController.isHolding() then
				targetDistance = math.clamp(targetDistance - input.Position.Z * 1.5, 7, 22)
			end
		end
	end)
	controllers.InputController.ActionBegan:Connect(function(action)
		if action == "CameraLock" then
			locked = not locked
		end
	end)
	-- initial yaw: face the way the character faces
	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(function(character)
		local root = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
		if root then
			local lv = root.CFrame.LookVector
			yaw = math.atan2(-lv.X, -lv.Z)
			focus = nil
		end
	end)
	RunService:BindToRenderStep("UBCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">CatchController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CatchController — catching, reaching and marking for the local player.

	Contact is detected here, where your body is exactly where you see it and
	the disc is at shared server time. Each frame the disc's path since the
	last frame is swept against your catch zones (CatchGeometry, the same
	module the server validates with); on contact a claim stamped with server
	time is sent and the disc snaps to your hand immediately (prediction). The
	server's verdict follows within a round trip.

	Reach (Primary while not holding): opens a 0.28 s window where your hand
	extends toward your aim. A light assist bends the reach toward a disc that
	is close and roughly where you are looking, so it reads naturally.
	Mark stance (hold Secondary): hands up; aim up/down for High/Low.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local CatchGeometry = require(Shared.Rules.CatchGeometry)
local VecMath = require(Shared.Util.VecMath)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local C = DiscConfig.Catch

local CatchController = {}

CatchController.Reached = Signal.new() -- (dir)
CatchController.Claimed = Signal.new() -- (discId, zoneKind)

local controllers: any
local player = Players.LocalPlayer

local reachAt = -math.huge
local reachDir = Vector3.new(0, 0, -1)
local marking = false
local markStance = "Low"
local lastAim = 0
local lastClaim: { [string]: number } = {}
local lastSample: { [string]: Vector3 } = {}

local function now(): number
	return Net.now()
end

function CatchController.reachActive(): boolean
	return now() - reachAt <= C.ReachWindow
end

function CatchController.isMarking(): boolean
	return marking
end

function CatchController.markStance(): string
	return markStance
end

function CatchController.reachState(): (number, Vector3)
	return reachAt, reachDir
end

local function myTeam(): string?
	local c = player.Character
	return if c then c:GetAttribute("UBTeam") :: string? else nil
end

local function canClaim(folder: Configuration): boolean
	local context = folder:GetAttribute("Context")
	local c = player.Character
	if not c or c:GetAttribute("UBFrozen") == true then
		return false
	end
	if context == "Training" then
		return folder:GetAttribute("Owner") == player.UserId
	elseif context == "Warmup" then
		return true
	end
	local team = myTeam()
	if team ~= "A" and team ~= "B" then
		return false
	end
	if folder:GetAttribute("Pull") == true then
		return Net.state():GetAttribute("Offense") == team
	end
	return Net.state():GetAttribute("Phase") == "Live"
end

local function nearestFlyingDisc(maxDist: number): (Vector3?, string?)
	local root = controllers.MovementController.root()
	if not root then
		return nil, nil
	end
	local best, bestId, bestD = nil, nil, maxDist
	for _, f in controllers.DiscRenderer.folders() do
		if f:GetAttribute("Mode") == "Flight" then
			local id = f:GetAttribute("Id") :: string
			local p = controllers.DiscRenderer.positionOf(id)
			if p then
				local d = (p - root.Position).Magnitude
				if d < bestD then
					best, bestId, bestD = p, id, d
				end
			end
		end
	end
	return best, bestId
end

function CatchController.reach()
	local t = now()
	if t - reachAt < C.ReachWindow + C.ReachCooldown then
		return
	end
	local root = controllers.MovementController.root()
	if not root then
		return
	end
	local aim = controllers.CameraController.getAimDirection()
	local discPos = nearestFlyingDisc(8)
	if discPos then
		local toDisc = (discPos - (root.Position + Vector3.new(0, C.ShoulderHeight, 0))).Unit
		if aim:Dot(toDisc) > math.cos(math.rad(55)) then
			aim = aim:Lerp(toDisc, 0.6).Unit
		end
	end
	reachAt = t
	reachDir = aim
	Net.event("Reach"):FireServer(aim)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalReach", t)
		c:SetAttribute("UB_LocalReachDir", aim)
	end
	controllers.MovementController.noteAerialReach(aim)
	CatchController.Reached:Fire(aim)
end

local function setMarking(on: boolean)
	if marking == on then
		return
	end
	marking = on
	local pitch = controllers.CameraController.getPitch()
	markStance = if pitch > math.rad(12) then "High" else "Low"
	Net.event("MarkStance"):FireServer(on, markStance)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalMark", if on then markStance else "")
	end
end

local function bodyState(root: BasePart): CatchGeometry.BodyState
	local sim = controllers.MovementController.sim()
	local diving = sim.mode == "Dive" or sim.mode == "DiveSlide"
	return {
		root = root.Position,
		facing = VecMath.flatUnit(root.CFrame.LookVector),
		reaching = CatchController.reachActive(),
		reachDir = reachDir,
		diving = diving,
		diveDir = sim.diveDir,
		sliding = sim.mode == "Slide",
	}
end

local function step()
	local root = controllers.MovementController.root()
	if not root then
		return
	end
	-- mark stance aim stream (10 Hz)
	if marking then
		local t = os.clock()
		if t - lastAim > 0.1 then
			lastAim = t
			local pitch = controllers.CameraController.getPitch()
			Net.unreliable("MarkAim"):FireServer(pitch)
			local stance = if pitch > math.rad(12) then "High" else "Low"
			if stance ~= markStance then
				markStance = stance
				local c = player.Character
				if c then
					c:SetAttribute("UB_LocalMark", stance)
				end
			end
		end
	end
	if controllers.ThrowController.isHolding() then
		return
	end
	local zones = CatchGeometry.zones(bodyState(root))
	local tNow = now()
	for _, folder in controllers.DiscRenderer.folders() do
		local id = folder:GetAttribute("Id") :: string
		local sim, launchTime, _, _, landed = controllers.DiscRenderer.flight(id)
		if sim and not landed and canClaim(folder) then
			local thrower = folder:GetAttribute("ThrowerId")
			local noCatch = launchTime + DiscConfig.Throw.NoCatchTime
			if thrower ~= player.UserId and tNow >= noCatch then
				local x, y, z = DiscPhysics.positionAt(sim, tNow - launchTime)
				local p = Vector3.new(x, y, z)
				local prev = lastSample[id] or p
				lastSample[id] = p
				-- sweep the path travelled since last frame
				local hitEval = nil
				for k = 1, 3 do
					local sample = prev:Lerp(p, k / 3)
					local ev = CatchGeometry.evaluate(zones, sample)
					if ev then
						hitEval = ev
						break
					end
				end
				if hitEval and (lastClaim[id] or 0) < os.clock() - 0.12 then
					lastClaim[id] = os.clock()
					Net.event("Catch"):FireServer(id, tNow, hitEval.zone.kind, reachDir)
					controllers.DiscRenderer.predictCatch(id)
					CatchController.Claimed:Fire(id, hitEval.zone.kind)
				end
			end
		else
			lastSample[id] = nil
		end
	end
end

function CatchController.Init(c: any)
	controllers = c
end

function CatchController.Start()
	controllers.InputController.ActionBegan:Connect(function(action)
		if controllers.ThrowController.isHolding() then
			return
		end
		if action == "Primary" then
			CatchController.reach()
		elseif action == "Secondary" then
			setMarking(true)
		end
	end)
	controllers.InputController.ActionEnded:Connect(function(action)
		if action == "Secondary" then
			setMarking(false)
		end
	end)
	player.CharacterAdded:Connect(function()
		marking = false
		reachAt = -math.huge
	end)
	RunService:BindToRenderStep("UBCatch", Enum.RenderPriority.Camera.Value + 3, step)
end

return CatchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">DiscRenderer</string>
              <string name="Source"><![CDATA[--!strict
--[[
	DiscRenderer — draws every disc from its replicated state.

	Flight segments are re-simulated locally from the replicated launch values
	with the same fixed-step DiscPhysics the server runs, synchronised to
	workspace:GetServerTimeNow(): smooth 60+ fps motion, zero per-frame
	network traffic, identical trajectory to the server's.

	Prediction:
	  * your own throw starts flying the instant you release; when the
	    authoritative flight arrives the visual blends onto it over 0.25 s
	  * your own catch snaps to your hand immediately; if the server awards
	    the disc to someone else the visual simply follows the new state

	Visuals: spinning disc with a stripe so spin is readable, a team-coloured
	trail (brighter on a Perfect release) and an optional ground shadow that
	helps judge height.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local ProgressionConfig = require(Shared.Config.Progression)
local TeamsConfig = require(Shared.Config.Teams)
local Actors = require(Shared.Actors)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local DiscRenderer = {}

DiscRenderer.FlightStarted = Signal.new() -- (discId, folder)
DiscRenderer.Landed = Signal.new() -- (discId, position)

local controllers: any
local player = Players.LocalPlayer
local visualsFolder: Folder

type Visual = {
	id: string,
	folder: Configuration,
	body: BasePart,
	cap: BasePart,
	stripe: BasePart,
	shadow: BasePart,
	trail: Trail,
	sim: DiscPhysics.State?,
	flightId: number,
	launchTime: number,
	wind: DiscPhysics.Wind,
	groundY: number,
	landed: boolean,
	spinAngle: number,
	spin: number,
	predicted: DiscPhysics.State?,
	predictedT0: number,
	predictedFlightId: number,
	blendOffset: Vector3,
	blendUntil: number,
	predictHoldUntil: number,
	pos: Vector3,
	normal: Vector3,
	skin: string,
	visible: boolean,
}

local visuals: { [string]: Visual } = {}

local SKINS: { [string]: any } = {}
for _, s in ProgressionConfig.DiscSkins do
	SKINS[s.id] = s
end

local function now(): number
	return Net.now()
end

local function part(name: string, shape: Enum.PartType, size: Vector3, color: Color3): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = visualsFolder
	return p
end

local function applySkin(v: Visual, skinId: string)
	local s = SKINS[skinId] or SKINS.Classic
	v.skin = skinId
	v.body.Color = s.color
	v.cap.Color = s.rim
	v.stripe.Color = s.stripe
	v.body.Material = if s.neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
end

local function create(folder: Configuration): Visual
	local r = DiscConfig.Physics.Radius
	local body = part("Disc", Enum.PartType.Cylinder, Vector3.new(0.24, r * 2, r * 2), Color3.new(1, 1, 1))
	local cap = part("DiscCap", Enum.PartType.Cylinder, Vector3.new(0.27, r * 1.1, r * 1.1), Color3.new(0.8, 0.8, 0.8))
	local stripe = part("DiscStripe", Enum.PartType.Block, Vector3.new(0.28, 0.28, r * 1.7), Color3.new(0, 0.5, 1))
	local shadow = part("DiscShadow", Enum.PartType.Cylinder, Vector3.new(0.04, r * 2, r * 2), Color3.new(0, 0, 0))
	shadow.Transparency = 1
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0, r * 0.9)
	a0.Parent = body
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 0, -r * 0.9)
	a1.Parent = body
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
	trail.Enabled = false
	trail.Parent = body
	local v: Visual = {
		id = folder:GetAttribute("Id") :: string,
		folder = folder,
		body = body,
		cap = cap,
		stripe = stripe,
		shadow = shadow,
		trail = trail,
		sim = nil,
		flightId = 0,
		launchTime = 0,
		wind = { x = 0, y = 0, z = 0 },
		groundY = 0,
		landed = false,
		spinAngle = 0,
		spin = 0,
		predicted = nil,
		predictedT0 = 0,
		predictedFlightId = -1,
		blendOffset = Vector3.zero,
		blendUntil = 0,
		predictHoldUntil = 0,
		pos = Vector3.zero,
		normal = Vector3.new(0, 1, 0),
		skin = "",
		visible = true,
	}
	applySkin(v, (folder:GetAttribute("Skin") or "Classic") :: string)
	return v
end

local function destroy(v: Visual)
	v.body:Destroy()
	v.cap:Destroy()
	v.stripe:Destroy()
	v.shadow:Destroy()
end

local function setVisible(v: Visual, on: boolean)
	if v.visible == on then
		return
	end
	v.visible = on
	local t = if on then 0 else 1
	v.body.Transparency = t
	v.cap.Transparency = t
	v.stripe.Transparency = t
	if not on then
		v.shadow.Transparency = 1
		v.trail.Enabled = false
	end
end

local function readFlight(v: Visual)
	local f = v.folder
	local pos = f:GetAttribute("LaunchPos")
	local vel = f:GetAttribute("LaunchVel")
	local n = f:GetAttribute("LaunchNormal")
	local spin = f:GetAttribute("Spin")
	local t0 = f:GetAttribute("LaunchTime")
	local wind = f:GetAttribute("Wind")
	if
		typeof(pos) ~= "Vector3"
		or typeof(vel) ~= "Vector3"
		or typeof(n) ~= "Vector3"
		or type(spin) ~= "number"
		or type(t0) ~= "number"
	then
		return
	end
	local w = if typeof(wind) == "Vector3" then wind else Vector3.zero
	v.sim = DiscPhysics.fromVectors(pos, vel, n, spin)
	v.launchTime = t0
	v.wind = { x = w.X, y = w.Y, z = w.Z }
	v.groundY = (f:GetAttribute("GroundY") :: number?) or 0
	v.landed = false
	v.spin = spin
	-- trail colour: thrower team, brighter for a Perfect release
	local team = f:GetAttribute("ThrowerTeam")
	local color = if team == "A"
		then TeamsConfig.A.Color
		elseif team == "B" then TeamsConfig.B.Color
		else Color3.new(1, 1, 1)
	v.trail.Color = ColorSequence.new(color)
	local perfect = f:GetAttribute("Quality") == "Perfect"
	v.trail.Lifetime = if perfect then 0.55 else 0.35
	v.trail.LightEmission = if perfect then 1 else 0.5
end

local function handCFrame(holderId: number): CFrame?
	local c = Actors.characterOf(holderId)
	if not c then
		return nil
	end
	local leftHanded = c:GetAttribute("LeftHanded") == true
	local hand = c:FindFirstChild(if leftHanded then "LeftHand" else "RightHand") :: BasePart?
	if not hand then
		hand = c:FindFirstChild(if leftHanded then "Left Arm" else "Right Arm") :: BasePart?
	end
	if not hand then
		return nil
	end
	return hand.CFrame * CFrame.new(0, -0.35, -0.75) * CFrame.Angles(0, 0, math.rad(90))
end

local function orient(pos: Vector3, n: Vector3, angle: number): CFrame
	local axis = if n.Magnitude > 0.1 then n.Unit else Vector3.new(0, 1, 0)
	local ref = if math.abs(axis.Y) < 0.95 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)
	local perp = axis:Cross(ref).Unit
	return CFrame.fromMatrix(pos, axis, perp) * CFrame.Angles(angle, 0, 0)
end

local function place(v: Visual, cf: CFrame)
	local r = DiscConfig.Physics.Radius
	local parts = { v.body, v.cap, v.stripe }
	local cfs = { cf, cf, cf * CFrame.new(0, r * 0.35, 0) }
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	v.pos = cf.Position
end

local function updateShadow(v: Visual, height: number, show: boolean)
	if not show or height < 0.4 then
		v.shadow.Transparency = 1
		return
	end
	local h = math.clamp(height, 0, 40)
	local scale = 1 + h * 0.03
	local r = DiscConfig.Physics.Radius
	v.shadow.Size = Vector3.new(0.04, r * 2 * scale, r * 2 * scale)
	v.shadow.Transparency = math.clamp(0.55 + h * 0.012, 0.55, 0.9)
	v.shadow.CFrame = CFrame.new(v.pos.X, v.groundY + 0.07, v.pos.Z) * CFrame.Angles(0, 0, math.rad(90))
end

local function shadowsEnabled(v: Visual): boolean
	if v.folder:GetAttribute("Context") ~= "Match" then
		return true
	end
	return Net.state():GetAttribute("LandingShadow") ~= false
end

local function render(v: Visual, dt: number)
	local f = v.folder
	local t = now()
	local mode = f:GetAttribute("Mode")
	local skin = f:GetAttribute("Skin")
	if type(skin) == "string" and skin ~= v.skin then
		applySkin(v, skin)
	end
	local flightId = (f:GetAttribute("FlightId") :: number?) or 0
	if flightId ~= v.flightId then
		local previousPos = v.pos
		local hadPrediction = v.predicted ~= nil and v.predictedFlightId == v.flightId
		v.flightId = flightId
		if mode == "Flight" then
			readFlight(v)
			DiscRenderer.FlightStarted:Fire(v.id, f)
			if hadPrediction and v.sim then
				local s = DiscPhysics.copy(v.sim :: DiscPhysics.State)
				DiscPhysics.advanceTo(s, t - v.launchTime, v.wind, v.groundY - 100)
				local x, y, z = DiscPhysics.positionAt(s, t - v.launchTime)
				v.blendOffset = previousPos - Vector3.new(x, y, z)
				v.blendUntil = t + 0.25
			end
		end
		v.predicted = nil
	end

	-- local catch prediction
	if t < v.predictHoldUntil and mode == "Flight" then
		local cf = handCFrame(player.UserId)
			or (if player.Character then (player.Character :: Model):GetPivot() else nil)
		if cf then
			setVisible(v, true)
			v.trail.Enabled = false
			place(v, cf)
			updateShadow(v, 0, false)
			return
		end
	end

	-- local throw prediction (server has not confirmed yet)
	local pred = v.predicted
	if pred and mode == "Held" then
		if t - v.predictedT0 > 0.8 then
			v.predicted = nil -- rejected; disc stays in hand
		else
			DiscPhysics.advanceTo(pred, t - v.predictedT0, v.wind, v.groundY)
			local x, y, z = DiscPhysics.positionAt(pred, t - v.predictedT0)
			setVisible(v, true)
			v.trail.Enabled = true
			v.spinAngle += pred.spin * dt
			place(v, orient(Vector3.new(x, y, z), DiscPhysics.normal(pred), v.spinAngle))
			updateShadow(v, y - v.groundY, shadowsEnabled(v))
			return
		end
	end

	if mode == "Flight" then
		local s = v.sim
		if not s then
			setVisible(v, false)
			return
		end
		local target = t - v.launchTime
		if not v.landed then
			local alive = DiscPhysics.advanceTo(s, target, v.wind, v.groundY)
			if not alive then
				v.landed = true
				DiscRenderer.Landed:Fire(v.id, Vector3.new(s.px, v.groundY, s.pz))
			end
		end
		local pos: Vector3
		local n: Vector3
		if v.landed then
			pos = Vector3.new(s.px, v.groundY + 0.13, s.pz)
			n = Vector3.new(0, 1, 0)
			v.trail.Enabled = false
		else
			local x, y, z = DiscPhysics.positionAt(s, target)
			pos = Vector3.new(x, y, z)
			n = DiscPhysics.normal(s)
			v.trail.Enabled = true
			v.spinAngle += s.spin * dt
		end
		if t < v.blendUntil then
			pos += v.blendOffset * ((v.blendUntil - t) / 0.25)
		end
		setVisible(v, true)
		place(v, orient(pos, n, v.spinAngle))
		updateShadow(v, pos.Y - v.groundY, shadowsEnabled(v) and not v.landed)
		return
	end

	v.trail.Enabled = false
	if mode == "Held" then
		local holder = f:GetAttribute("HolderId")
		local cf = if type(holder) == "number" and holder ~= 0 then handCFrame(holder) else nil
		if cf then
			setVisible(v, true)
			v.spinAngle += dt * 0.5
			place(v, cf)
			updateShadow(v, 0, false)
		else
			setVisible(v, false)
		end
	elseif mode == "Ground" then
		local gp = f:GetAttribute("GroundPos")
		if typeof(gp) == "Vector3" then
			setVisible(v, true)
			place(v, orient(gp, Vector3.new(0, 1, 0), v.spinAngle))
			updateShadow(v, 0, false)
		end
	else
		setVisible(v, false)
	end
end

---------------------------------------------------------------------------
-- public API
---------------------------------------------------------------------------

function DiscRenderer.folders(): { Configuration }
	local list = {}
	for _, v in visuals do
		table.insert(list, v.folder)
	end
	return list
end

function DiscRenderer.positionOf(id: string): Vector3?
	local v = visuals[id]
	return if v then v.pos else nil
end

-- Flight info for catch detection (nil unless flying).
function DiscRenderer.flight(id: string): (DiscPhysics.State?, number, DiscPhysics.Wind, number, boolean)
	local v = visuals[id]
	if not v or v.folder:GetAttribute("Mode") ~= "Flight" then
		return nil, 0, { x = 0, y = 0, z = 0 }, 0, true
	end
	return v.sim, v.launchTime, v.wind, v.groundY, v.landed
end

function DiscRenderer.folderOf(id: string): Configuration?
	local v = visuals[id]
	return if v then v.folder else nil
end

function DiscRenderer.heldByMe(): Configuration?
	for _, v in visuals do
		if v.folder:GetAttribute("Mode") == "Held" and v.folder:GetAttribute("HolderId") == player.UserId then
			return v.folder
		end
	end
	return nil
end

function DiscRenderer.predictThrow(id: string, state: DiscPhysics.State)
	local v = visuals[id]
	if not v then
		return
	end
	v.predicted = DiscPhysics.copy(state)
	v.predictedT0 = now()
	v.predictedFlightId = v.flightId
	local w = Net.state():GetAttribute("Wind")
	if typeof(w) == "Vector3" then
		v.wind = { x = w.X, y = w.Y, z = w.Z }
	end
end

function DiscRenderer.predictCatch(id: string)
	local v = visuals[id]
	if v then
		v.predictHoldUntil = now() + 0.5
	end
end

function DiscRenderer.cancelCatchPrediction(id: string)
	local v = visuals[id]
	if v then
		v.predictHoldUntil = 0
	end
end

function DiscRenderer.Init(c: any)
	controllers = c
	local f = workspace:FindFirstChild("UBVisuals")
	if not f then
		local nf = Instance.new("Folder")
		nf.Name = "UBVisuals"
		nf.Parent = workspace
		f = nf
	end
	visualsFolder = f :: Folder
end

function DiscRenderer.Start()
	local discs = Net.discs()
	local function add(child: Instance)
		if child:IsA("Configuration") then
			-- attributes may arrive a frame after the instance
			task.defer(function()
				local id = child:GetAttribute("Id")
				if type(id) == "string" and not visuals[id] then
					visuals[id] = create(child)
				end
			end)
		end
	end
	discs.ChildAdded:Connect(add)
	discs.ChildRemoved:Connect(function(child)
		for id, v in visuals do
			if v.folder == child then
				destroy(v)
				visuals[id] = nil
			end
		end
	end)
	for _, c in discs:GetChildren() do
		add(c)
	end
	RunService:BindToRenderStep("UBDiscs", Enum.RenderPriority.Camera.Value + 2, function(dt)
		for _, v in visuals do
			local ok, err = pcall(function()
				render(v, dt)
			end)
			if not ok then
				warn("[DiscRenderer] " .. tostring(err))
			end
		end
	end)
	Net.event("CatchResult").OnClientEvent:Connect(function(discId, accepted)
		if not accepted and type(discId) == "string" then
			DiscRenderer.cancelCatchPrediction(discId)
		end
	end)
	local _ = controllers
end

return DiscRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	EffectsController — feedback you can read at a glance.

	Every technique has its own colour and shape (Theme.TechColors) so
	experienced players recognise what an opponent just did; nothing hides the
	disc or the players. Also: catch / block / bobble bursts, goal confetti,
	crowd idle and cheering, wind flags, the moving training target, stadium
	scoreboards, cosmetic movement trails and end-zone glow.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local ProgressionConfig = require(Shared.Config.Progression)
local TeamsConfig = require(Shared.Config.Teams)
local Theme = require(script.Parent.Parent.UI.Theme)

local EffectsController = {}

local controllers: any
local player = Players.LocalPlayer
local fx: Folder

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function now(): number
	return Net.now()
end

local function anchorAt(pos: Vector3): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(pos)
	p.Parent = fx
	return p
end

function EffectsController.burst(
	pos: Vector3,
	color: Color3,
	count: number,
	speed: number,
	texture: string?,
	gravity: number?
)
	local holder = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture or SPARK
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.7
	e.Lifetime = NumberRange.new(0.25, 0.6)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Acceleration = Vector3.new(0, -(gravity or 0), 0)
	e.Rate = 0
	e.Parent = holder
	e:Emit(count)
	task.delay(1.5, function()
		holder:Destroy()
	end)
end

function EffectsController.dust(pos: Vector3, count: number)
	local holder = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SMOKE
	e.Color = ColorSequence.new(Color3.fromRGB(200, 190, 170))
	e.Lifetime = NumberRange.new(0.4, 0.8)
	e.Speed = NumberRange.new(3, 7)
	e.SpreadAngle = Vector2.new(70, 70)
	e.EmissionDirection = Enum.NormalId.Top
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.4) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	e.Rate = 0
	e.Parent = holder
	e:Emit(count)
	task.delay(1.5, function()
		holder:Destroy()
	end)
end

function EffectsController.ring(pos: Vector3, color: Color3, radius: number, duration: number, vertical: Vector3?)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.2
	p.Size = Vector3.new(0.12, 1, 1)
	local axis = vertical or Vector3.new(0, 1, 0)
	local ref = if math.abs(axis.Y) < 0.9 then Vector3.new(0, 1, 0) else Vector3.new(1, 0, 0)
	p.CFrame = CFrame.fromMatrix(pos, axis.Unit, axis.Unit:Cross(ref).Unit)
	p.Parent = fx
	local tween = TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, radius * 2, radius * 2),
		Transparency = 1,
	})
	tween:Play()
	task.delay(duration + 0.1, function()
		p:Destroy()
	end)
end

local function skid(pos: Vector3, dir: Vector3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Color = Color3.fromRGB(40, 32, 26)
	p.Transparency = 0.45
	p.Size = Vector3.new(0.9, 0.04, 3.2)
	p.CFrame = CFrame.lookAt(pos, pos + dir) + Vector3.new(0, 0.06, 0)
	p.Parent = fx
	TweenService:Create(p, TweenInfo.new(1.4), { Transparency = 1 }):Play()
	task.delay(1.5, function()
		p:Destroy()
	end)
end

-- short coloured streak on a character's root (per-technique colour)
local function streak(model: Model, color: Color3, duration: number)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local trail = root:FindFirstChild("UBTechTrail") :: Trail?
	if not trail then
		local a0 = Instance.new("Attachment")
		a0.Name = "UBTechA0"
		a0.Position = Vector3.new(0, 0.9, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "UBTechA1"
		a1.Position = Vector3.new(0, -1.4, 0)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Name = "UBTechTrail"
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.22
		t.LightEmission = 0.8
		t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		t.Enabled = false
		t.Parent = root
		trail = t
	end
	local tr = trail :: Trail
	tr.Color = ColorSequence.new(color)
	tr.Enabled = true
	local token = os.clock()
	tr:SetAttribute("Token", token)
	task.delay(duration, function()
		if tr.Parent and tr:GetAttribute("Token") == token then
			tr.Enabled = false
		end
	end)
end

-- Visual for a technique performed by `model` (local or remote).
function EffectsController.tech(model: Model, tech: string, quality: string, dir: Vector3)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local color = (Theme.TechColors :: any)[tech] or Color3.new(1, 1, 1)
	local feet = root.Position - Vector3.new(0, 2.9, 0)
	local isLocal = model == player.Character
	local perfect = quality == "Perfect"
	if tech == "SnapCut" or tech == "SlideCut" then
		EffectsController.dust(feet, 8)
		streak(model, color, 0.25)
		if perfect then
			EffectsController.ring(feet + Vector3.new(0, 0.1, 0), color, 3, 0.25)
		end
	elseif tech == "MomentumCancel" then
		EffectsController.dust(feet, 14)
		skid(feet, dir)
	elseif tech == "BurstStep" then
		EffectsController.ring(feet + Vector3.new(0, 0.1, 0), color, 4.5, 0.3)
		streak(model, color, 0.35)
		if isLocal then
			controllers.CameraController.kick(5)
		end
	elseif tech == "Slide" then
		EffectsController.dust(feet, 16)
	elseif tech == "Dive" then
		streak(model, color, 0.45)
	elseif tech == "AirRedirect" then
		EffectsController.ring(root.Position, color, 3.2, 0.3, dir)
	elseif tech == "PrecisionLanding" then
		EffectsController.ring(feet + Vector3.new(0, 0.1, 0), if perfect then Theme.Colors.Perfect else color, 5, 0.35)
		EffectsController.dust(feet, 6)
	elseif tech == "WallRebound" then
		EffectsController.burst(root.Position - dir * 1.5, color, 16, 14)
	elseif tech == "RecoveryChain" then
		EffectsController.burst(feet + Vector3.new(0, 1, 0), color, 10, 8)
	end
	-- (FakeCommit / "Lean" deliberately has no visual: a fake must look real)
	if isLocal then
		if tech == "BurstStep" or tech == "Dive" then
			controllers.AudioController.play("Burst", 0.1)
		elseif tech ~= "Jump" and tech ~= "FakeCommit" then
			controllers.AudioController.play(if perfect then "TechPerfect" else "Tech", 0.15)
		end
	end
end

---------------------------------------------------------------------------
-- remote technique watcher
---------------------------------------------------------------------------

local watched: { [Model]: RBXScriptConnection } = {}

local function watch(model: Model)
	if watched[model] or model == player.Character then
		return
	end
	watched[model] = model:GetAttributeChangedSignal("TechT"):Connect(function()
		local tech = model:GetAttribute("Tech")
		local q = model:GetAttribute("TechQ")
		local dir = model:GetAttribute("TechDir")
		if type(tech) == "string" and tech ~= "Lean" then
			EffectsController.tech(
				model,
				tech,
				if type(q) == "string" then q else "Clean",
				if typeof(dir) == "Vector3" then dir else Vector3.zero
			)
		end
	end)
end

---------------------------------------------------------------------------
-- crowd, flags, mover, trails, scoreboards
---------------------------------------------------------------------------

type Fan = { model: Model, parts: { BasePart }, base: { CFrame }, phase: number }
local fans: { Fan } = {}
local cheerUntil = 0
local flags: { { part: BasePart, base: CFrame, strength: number } } = {}

local function collectFans()
	fans = {}
	for _, m in CollectionService:GetTagged("UBCrowd") do
		if m:IsA("Model") then
			local parts: { BasePart } = {}
			local base: { CFrame } = {}
			for _, p in m:GetChildren() do
				if p:IsA("BasePart") then
					table.insert(parts, p)
					table.insert(base, p.CFrame)
				end
			end
			local ph = m:GetAttribute("Phase")
			table.insert(
				fans,
				{ model = m, parts = parts, base = base, phase = if type(ph) == "number" then ph else 0 }
			)
		end
	end
	flags = {}
	for _, f in CollectionService:GetTagged("UBFlag") do
		if f:IsA("BasePart") then
			local s = f:GetAttribute("Strength")
			table.insert(flags, { part = f, base = f.CFrame, strength = if type(s) == "number" then s else 2 })
		end
	end
end

function EffectsController.cheer(duration: number)
	cheerUntil = math.max(cheerUntil, os.clock() + duration)
	controllers.AudioController.play("CrowdCheer")
end

local lastCrowd = 0
local function animateCrowd()
	local clock = os.clock()
	if clock - lastCrowd < 0.05 then
		return
	end
	lastCrowd = clock
	local cheering = clock < cheerUntil
	local parts: { BasePart } = {}
	local cfs: { CFrame } = {}
	for _, fan in fans do
		if fan.model.Parent then
			local amp = if cheering then 0.9 else 0.12
			local freq = if cheering then 9 else 1.6
			local y = math.max(0, math.sin(clock * freq + fan.phase)) * amp
			for i, p in fan.parts do
				table.insert(parts, p)
				table.insert(cfs, fan.base[i] + Vector3.new(0, y, 0))
			end
		end
	end
	if #parts > 0 then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for _, f in flags do
		if f.part.Parent then
			local wobble = math.sin(clock * (4 + f.strength) + f.base.Position.X) * 0.12 * math.min(f.strength, 6) / 3
			f.part.CFrame = f.base * CFrame.Angles(0, wobble, 0)
		end
	end
end

local function animateMovers()
	local t = now()
	for _, m in CollectionService:GetTagged("UBMover") do
		if m:IsA("BasePart") then
			local center = m:GetAttribute("Center")
			local amp = m:GetAttribute("Amplitude")
			local period = m:GetAttribute("Period")
			if typeof(center) == "Vector3" and type(amp) == "number" and type(period) == "number" then
				local pos = center + Vector3.new(math.sin(t * 2 * math.pi / period) * amp, 0, 0)
				m.CFrame = m.CFrame.Rotation + pos
			end
		end
	end
end

local TRAILS: { [string]: any } = {}
for _, t in ProgressionConfig.Trails do
	TRAILS[t.id] = t
end

local function cosmeticTrail(model: Model)
	local id = model:GetAttribute("UBTrail")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local trail = root:FindFirstChild("UBCosmeticTrail") :: Trail?
	local def = if type(id) == "string" then TRAILS[id] else nil
	if not def or not def.a then
		if trail then
			trail.Enabled = false
		end
		return
	end
	if not trail then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, -0.6, 0.4)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1.6, 0.4)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Name = "UBCosmeticTrail"
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.3
		t.LightEmission = 0.4
		t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
		t.Parent = root
		trail = t
	end
	local tr = trail :: Trail
	tr.Color = ColorSequence.new(def.a, def.b)
	local v = root.AssemblyLinearVelocity
	tr.Enabled = Vector3.new(v.X, 0, v.Z).Magnitude > 18
end

local lastBoard = 0
local function updateScoreboards()
	local clock = os.clock()
	if clock - lastBoard < 0.25 then
		return
	end
	lastBoard = clock
	local state = Net.state()
	local phase: string = (state:GetAttribute("Phase") or "") :: string
	local matchEnd = state:GetAttribute("MatchEnd")
	local remaining = if type(matchEnd) == "number" then matchEnd - now() else 0
	local phaseEnd = state:GetAttribute("PhaseEnd")
	local clockText = if phase == "Intermission"
			and type(phaseEnd) == "number"
			and phaseEnd > 0
		then Theme.formatTime(phaseEnd - now())
		else Theme.formatTime(remaining)
	for _, board in CollectionService:GetTagged("UBScoreboard") do
		local gui = board:FindFirstChild("Display")
		if gui then
			local function set(name: string, text: string)
				local l = gui:FindFirstChild(name)
				if l and l:IsA("TextLabel") then
					l.Text = text
				end
			end
			set("ScoreA", tostring(state:GetAttribute("ScoreA") or 0))
			set("ScoreB", tostring(state:GetAttribute("ScoreB") or 0))
			set("Clock", clockText)
			set(
				"Phase",
				string.upper(
					if phase == "PointOver" then "GOAL" elseif phase == "Intermission" then "WARMUP" else phase
				)
			)
			set(
				"Info",
				if state:GetAttribute("Universe")
					then "UNIVERSE POINT"
					else (state:GetAttribute("ModeName") or "") :: string
			)
		end
	end
	-- the end zone being attacked by your team pulses
	local myTeam = if player.Character then player.Character:GetAttribute("UBTeam") else nil
	for _, ez in CollectionService:GetTagged("UBEndZone") do
		if ez:IsA("BasePart") then
			local side = ez:GetAttribute("Side")
			local attacking = (myTeam == "A" and state:GetAttribute("AttackA") == side)
				or (myTeam == "B" and state:GetAttribute("AttackB") == side)
			ez.Transparency = if attacking and phase == "Live" then 0.78 + math.sin(clock * 3) * 0.05 else 0.86
		end
	end
end

---------------------------------------------------------------------------

function EffectsController.Init(c: any)
	controllers = c
	local f = Instance.new("Folder")
	f.Name = "UBFx"
	f.Parent = workspace:WaitForChild("UBVisuals")
	fx = f
end

function EffectsController.Start()
	controllers.MovementController.Tech:Connect(function(e)
		local c = player.Character
		if c then
			EffectsController.tech(c, e.tech, e.quality, e.dir)
		end
	end)
	controllers.MovementController.Landed:Connect(function(fromDive, speed)
		local root = controllers.MovementController.root()
		if root then
			local feet = root.Position - Vector3.new(0, 2.9, 0)
			if fromDive then
				EffectsController.dust(feet, 22)
				controllers.CameraController.shake(0.12, 0.2)
				controllers.AudioController.play("Layout", 0.1)
			elseif speed > 8 then
				EffectsController.dust(feet, 5)
				controllers.AudioController.play("Land", 0.2)
			end
		end
	end)
	controllers.ThrowController.Released:Connect(function(launch)
		controllers.AudioController.play(if launch.quality == "Perfect" then "PerfectRelease" else "Throw", 0.08)
		if launch.quality == "Perfect" then
			EffectsController.burst(launch.releasePos, Theme.Colors.Perfect, 10, 10)
		end
	end)

	Net.event("Effect").OnClientEvent:Connect(function(kind, pos, actorId, quality, zone)
		if typeof(pos) ~= "Vector3" then
			return
		end
		local mine = actorId == player.UserId
		if kind == "Catch" then
			local color = if quality == "Clean" then Theme.Colors.Clean else Theme.Colors.Gold
			EffectsController.burst(pos, color, if zone == "Dive" then 26 else 12, 10)
			controllers.AudioController.playAt(if quality == "Clean" then "CleanCatch" else "Catch", pos)
			if mine and zone == "Dive" then
				controllers.CameraController.shake(0.15, 0.25)
			end
		elseif kind == "Block" or kind == "HandBlock" then
			EffectsController.burst(pos, Theme.Colors.Bad, 22, 16)
			controllers.AudioController.playAt("Block", pos)
			EffectsController.cheer(1.2)
		elseif kind == "Bobble" then
			EffectsController.burst(pos, Theme.Colors.Gold, 14, 9)
			controllers.AudioController.playAt("Bobble", pos)
		elseif kind == "TargetHit" then
			EffectsController.burst(pos, Theme.Colors.Good, 40, 18, nil, 20)
			EffectsController.ring(pos, Theme.Colors.Good, 6, 0.4, Vector3.new(0, 0, 1))
			controllers.AudioController.play("Highlight")
		end
	end)

	Net.event("Notify").OnClientEvent:Connect(function(kind, _text, data)
		if kind == "Goal" and type(data) == "table" then
			local team = data.team
			local color = if team == "A" then TeamsConfig.A.Color else TeamsConfig.B.Color
			local scorer = if type(data.scorer) == "number" then Actors.rootOf(data.scorer) else nil
			local pos = if scorer then scorer.Position else Vector3.zero
			for _ = 1, 3 do
				EffectsController.burst(
					pos + Vector3.new(math.random(-6, 6), 6, math.random(-6, 6)),
					color,
					40,
					22,
					nil,
					25
				)
			end
			EffectsController.cheer(3)
			controllers.AudioController.play("Goal")
		elseif kind == "Turnover" then
			controllers.AudioController.play("Turnover")
		end
	end)
	Net.event("Highlight").OnClientEvent:Connect(function(h)
		if type(h) ~= "table" then
			return
		end
		EffectsController.cheer(if (h.score or 0) > 700 then 2.5 else 1.4)
		if h.id == player.UserId then
			controllers.CameraController.kick(3)
		end
	end)

	local collectQueued = false
	local function queueCollect()
		if not collectQueued then
			collectQueued = true
			task.delay(0.5, function()
				collectQueued = false
				collectFans()
			end)
		end
	end
	CollectionService:GetInstanceAddedSignal("UBCrowd"):Connect(queueCollect)
	CollectionService:GetInstanceAddedSignal("UBFlag"):Connect(queueCollect)
	collectFans()

	local lastScan = 0
	RunService.Heartbeat:Connect(function()
		animateCrowd()
		animateMovers()
		updateScoreboards()
		local clock = os.clock()
		if clock - lastScan > 0.5 then
			lastScan = clock
			for _, m in Actors.characters() do
				watch(m)
				cosmeticTrail(m)
			end
			for model, conn in watched do
				if not model.Parent then
					conn:Disconnect()
					watched[model] = nil
				end
			end
		end
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	InputController — one input vocabulary for keyboard/mouse, gamepad and
	touch. Raw inputs become named actions (Config/Input) that the movement,
	throw and catch controllers interpret in context. The same physical key
	may map to several actions (Q = Cut, or Bank Left while holding the disc);
	consumers decide which applies.

	Roblox's default character controls are disabled: this controller reads
	movement itself so every technique responds on the exact frame pressed.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)

local InputController = {}

InputController.ActionBegan = Signal.new() -- (action)
InputController.ActionEnded = Signal.new() -- (action)
InputController.Wheel = Signal.new() -- (delta)
InputController.SchemeChanged = Signal.new() -- (scheme)

local controllers: any
local held: { [string]: boolean } = {}
local keyMap: { [string]: { string } } = {}
local menuOpen = false
local gamepadStick = Vector2.zero
local touchStick = Vector2.zero
local sprintToggle = false
local scheme = "KBM"

local MOVE_KEYS: { { any } } = {
	{ Enum.KeyCode.W, Vector2.new(0, 1) },
	{ Enum.KeyCode.Up, Vector2.new(0, 1) },
	{ Enum.KeyCode.S, Vector2.new(0, -1) },
	{ Enum.KeyCode.Down, Vector2.new(0, -1) },
	{ Enum.KeyCode.A, Vector2.new(-1, 0) },
	{ Enum.KeyCode.Left, Vector2.new(-1, 0) },
	{ Enum.KeyCode.D, Vector2.new(1, 0) },
	{ Enum.KeyCode.Right, Vector2.new(1, 0) },
}

local function rebuild()
	keyMap = {}
	for _, s in { "keyboard", "gamepad" } do
		local b = controllers.SettingsController.bindings(s)
		for action, keys in b do
			for _, k in keys do
				local list = keyMap[k]
				if not list then
					list = {}
					keyMap[k] = list
				end
				if not table.find(list, action) then
					table.insert(list, action)
				end
			end
		end
	end
end

local function inputName(input: InputObject): string
	local t = input.UserInputType
	if
		t == Enum.UserInputType.MouseButton1
		or t == Enum.UserInputType.MouseButton2
		or t == Enum.UserInputType.MouseButton3
	then
		return t.Name
	end
	return input.KeyCode.Name
end

local function setScheme(s: string)
	if s ~= scheme then
		scheme = s
		InputController.SchemeChanged:Fire(s)
	end
end

function InputController.scheme(): string
	return scheme
end

function InputController.fire(action: string, began: boolean)
	if began then
		if held[action] then
			return
		end
		held[action] = true
		if action == "Sprint" and controllers.SettingsController.get("ToggleSprint") then
			sprintToggle = not sprintToggle
		end
		InputController.ActionBegan:Fire(action)
	else
		if not held[action] then
			return
		end
		held[action] = nil
		InputController.ActionEnded:Fire(action)
	end
end

function InputController.isHeld(action: string): boolean
	return held[action] == true
end

function InputController.setMenuOpen(open: boolean)
	menuOpen = open
	if open then
		for action in table.clone(held) do
			InputController.fire(action, false)
		end
	end
end

function InputController.menuOpen(): boolean
	return menuOpen
end

function InputController.setTouchStick(v: Vector2)
	touchStick = v
end

function InputController.toggleTouchSprint()
	sprintToggle = not sprintToggle
end

local function typing(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

-- Raw 2D stick: x = right, y = forward. Magnitude 0..1.
function InputController.rawMove(): Vector2
	if menuOpen or typing() then
		return Vector2.zero
	end
	local kb = Vector2.zero
	for _, entry in MOVE_KEYS do
		if UserInputService:IsKeyDown(entry[1]) then
			kb += entry[2]
		end
	end
	if kb.Magnitude > 1 then
		kb = kb.Unit
	end
	local best = kb
	if gamepadStick.Magnitude > best.Magnitude then
		best = gamepadStick
	end
	if touchStick.Magnitude > best.Magnitude then
		best = touchStick
	end
	return best
end

-- Camera-relative horizontal world direction (magnitude 0..1).
function InputController.moveVector(): Vector3
	local raw = InputController.rawMove()
	if raw.Magnitude < 0.01 then
		return Vector3.zero
	end
	local yaw = controllers.CameraController.getYaw()
	local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	return forward * raw.Y + right * raw.X
end

function InputController.sprinting(): boolean
	if menuOpen then
		return false
	end
	local settings = controllers.SettingsController
	if scheme == "Touch" then
		if settings.get("AutoSprintTouch") and touchStick.Magnitude > 0.85 then
			return true
		end
		return sprintToggle
	end
	if settings.get("ToggleSprint") then
		return sprintToggle
	end
	return held.Sprint == true
end

function InputController.Init(c: any)
	controllers = c
end

function InputController.Start()
	-- take over character controls
	local player = Players.LocalPlayer
	task.spawn(function()
		local ok, PlayerModule = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		end)
		if ok and PlayerModule then
			local controls = PlayerModule:GetControls()
			controls:Disable()
		end
	end)
	GuiService.AutoSelectGuiEnabled = false

	rebuild()
	controllers.SettingsController.Changed:Connect(function(key)
		if key == "Bindings" or key == "All" then
			rebuild()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		local t = input.UserInputType
		if t == Enum.UserInputType.Gamepad1 then
			setScheme("Gamepad")
		elseif
			t == Enum.UserInputType.Keyboard
			or t == Enum.UserInputType.MouseButton1
			or t == Enum.UserInputType.MouseButton2
		then
			setScheme("KBM")
		elseif t == Enum.UserInputType.Touch then
			setScheme("Touch")
		end
		if gameProcessed or typing() then
			return
		end
		local name = inputName(input)
		local actions = keyMap[name]
		if not actions then
			return
		end
		for _, action in actions do
			if action == "Menu" or action == "CameraLock" or not menuOpen then
				InputController.fire(action, true)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input, _gameProcessed)
		local actions = keyMap[inputName(input)]
		if actions then
			for _, action in actions do
				InputController.fire(action, false)
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			if p.Magnitude < 0.15 then
				p = Vector2.zero
			end
			gamepadStick = if p.Magnitude > 1 then p.Unit else p
			if p.Magnitude > 0 then
				setScheme("Gamepad")
			end
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not gameProcessed and not menuOpen then
			InputController.Wheel:Fire(input.Position.Z)
		end
	end)

	UserInputService.WindowFocusReleased:Connect(function()
		for action in table.clone(held) do
			InputController.fire(action, false)
		end
		gamepadStick = Vector2.zero
	end)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		setScheme("Touch")
	end
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MovementController — runs MovementSim for the local character.

	Each frame it builds an environment snapshot with raycasts (grounded,
	time-to-land, a Rebound wall beside you, offset from your pivot), steps the
	sim and applies the result:
	  * horizontal velocity via a LinearVelocity constraint in Plane mode
	    (exact, frame-responsive control; vertical is left to physics)
	  * jumps / dives / air-redirect hangs by setting vertical velocity
	  * facing via AlignOrientation (camera while aiming/holding/marking,
	    travel direction otherwise)
	Technique events go to the server in one small batch per frame (only when
	something happened) and to the local effects/combo UI immediately.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MovementSim = require(Shared.Movement.MovementSim)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local VecMath = require(Shared.Util.VecMath)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local MovementController = {}

MovementController.Tech = Signal.new() -- (event)
MovementController.Feedback = Signal.new() -- (feedback)
MovementController.Landed = Signal.new() -- (fromDive: boolean, speed: number)
MovementController.ComboChanged = Signal.new() -- (chain total, last points, event)

local controllers: any
local player = Players.LocalPlayer

local sim: MovementSim.State = MovementSim.new(0)
local character: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local lv: LinearVelocity? = nil
local ao: AlignOrientation? = nil
local standHeight = 3
local pivot: Vector3? = nil
local holding = false
local lastMode = ""
local lastTeleport: any = nil
local pending: { any } = {}
local combo = ComboEvaluator.newTracker()
local lastFacing = Vector3.new(0, 0, -1)

local MOVEMENT_ACTIONS = { Jump = true, Cut = true, Slide = true, Dive = true, Burst = true }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function now(): number
	return Net.now()
end

function MovementController.sim(): MovementSim.State
	return sim
end

function MovementController.pivot(): Vector3?
	return pivot
end

function MovementController.root(): BasePart?
	return root
end

function MovementController.standHeight(): number
	return standHeight
end

function MovementController.combo(): ComboEvaluator.Tracker
	return combo
end

function MovementController.isGrounded(): boolean
	return not MovementSim.isAirborne(sim)
end

local function filter()
	local list: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	for _, name in { "UBBots", "UBVisuals" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	rayParams.FilterDescendantsInstances = list
end

local function buildEnv(): MovementSim.Env
	local r = root :: BasePart
	local pos = r.Position
	local vel = r.AssemblyLinearVelocity
	local hit = workspace:Raycast(pos, Vector3.new(0, -(standHeight + 0.6), 0), rayParams)
	local grounded = hit ~= nil and vel.Y <= 2.5
	local ttl: number? = nil
	if not grounded then
		local far = workspace:Raycast(pos, Vector3.new(0, -120, 0), rayParams)
		if far then
			local h = math.max(0, pos.Y - standHeight - far.Position.Y)
			local g = workspace.Gravity
			ttl = (vel.Y + math.sqrt(math.max(vel.Y * vel.Y + 2 * g * h, 0))) / g
		end
	end
	local wallNormal: Vector3? = nil
	local wallDistance: number? = nil
	local wallId: string? = nil
	if not grounded then
		local dirs = { VecMath.flatUnit(vel), VecMath.flatUnit(r.CFrame.LookVector) }
		for _, d in dirs do
			if d.Magnitude > 0.5 then
				local w = workspace:Raycast(pos, d * 3, rayParams)
				if w and CollectionService:HasTag(w.Instance, "Rebound") then
					wallNormal = VecMath.flatUnit(w.Normal)
					wallDistance = w.Distance
					wallId = w.Instance:GetFullName()
					break
				end
			end
		end
	end
	return {
		grounded = grounded,
		actualVel = vel,
		timeToLand = ttl,
		wallNormal = wallNormal,
		wallDistance = wallDistance,
		wallId = wallId,
		pivotOffset = if pivot then pos - (pivot :: Vector3) else nil,
		facing = r.CFrame.LookVector,
	}
end

local function currentInput(): MovementSim.Input
	return {
		move = controllers.InputController.moveVector(),
		sprint = controllers.InputController.sprinting(),
	}
end

local function queueEvent(e: MovementSim.TechEvent)
	table.insert(pending, { tech = e.tech, quality = e.quality, dir = e.dir, info = e.info })
	local points, total = ComboEvaluator.add(combo, e.tech, e.quality, now())
	MovementController.Tech:Fire(e)
	MovementController.ComboChanged:Fire(total, points, e)
end

function MovementController.noteAerialReach(dir: Vector3)
	MovementSim.noteAerialReach(sim, dir)
end

local function setupCharacter(c: Model)
	character = c
	local h = c:WaitForChild("Humanoid", 10) :: Humanoid?
	local r = c:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not h or not r then
		return
	end
	humanoid = h
	root = r
	h.AutoRotate = false
	h.WalkSpeed = 0
	h.UseJumpPower = true
	h.JumpPower = 0
	-- states that would fight the movement engine
	for _, st in
		{
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.Seated,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.FallingDown,
		}
	do
		h:SetStateEnabled(st, false)
	end
	standHeight = if h.RigType == Enum.HumanoidRigType.R15 then h.HipHeight + r.Size.Y / 2 else 3

	local att = Instance.new("Attachment")
	att.Name = "UBMoveAttachment"
	att.Parent = r

	local linear = Instance.new("LinearVelocity")
	linear.Name = "UBMove"
	linear.Attachment0 = att
	linear.RelativeTo = Enum.ActuatorRelativeTo.World
	linear.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	linear.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	linear.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	linear.PlaneVelocity = Vector2.zero
	linear.MaxForce = math.max(r.AssemblyMass, 8) * 900
	linear.Parent = r
	lv = linear

	local align = Instance.new("AlignOrientation")
	align.Name = "UBFace"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = false
	align.Responsiveness = 45
	align.MaxTorque = 1e7
	align.MaxAngularVelocity = 40
	align.CFrame = r.CFrame.Rotation
	align.Parent = r
	ao = align
	lastFacing = VecMath.flatUnit(r.CFrame.LookVector)

	sim = MovementSim.new(now())
	pivot = nil
	holding = false
	lastMode = ""
	lastTeleport = c:GetAttribute("UBTeleport")
	h.Died:Connect(function()
		if lv then
			lv.Enabled = false
		end
		if ao then
			ao.Enabled = false
		end
	end)
end

local function step(dtRaw: number)
	local c, h, r = character, humanoid, root
	if not c or not h or not r or not r.Parent or h.Health <= 0 or not lv or not ao then
		return
	end
	local dt = math.min(dtRaw, 1 / 15)
	sim.now = now() - dt -- keep the sim clock on server time

	local frozen = c:GetAttribute("UBFrozen") == true
	if frozen ~= sim.frozen then
		MovementSim.setFrozen(sim, frozen)
	end
	local tp = c:GetAttribute("UBTeleport")
	if tp ~= lastTeleport then
		lastTeleport = tp
		MovementSim.reset(sim)
		pivot = nil
		local lvv = VecMath.flatUnit(r.CFrame.LookVector)
		if lvv.Magnitude > 0.5 then
			controllers.CameraController.setYaw(math.atan2(-lvv.X, -lvv.Z))
			lastFacing = lvv
		end
	end

	filter()
	local env = buildEnv()
	local nowHolding = controllers.ThrowController.isHolding()
	if nowHolding ~= holding then
		holding = nowHolding
		MovementSim.setHolding(sim, holding, env.grounded)
		if not holding then
			pivot = nil
		end
	end

	local out = MovementSim.step(sim, currentInput(), env, dt)

	local linear = lv :: LinearVelocity
	linear.MaxForce = math.max(r.AssemblyMass, 8) * 900
	linear.PlaneVelocity = Vector2.new(out.vel.X, out.vel.Z)
	if out.jump and out.setVertical then
		h.JumpPower = out.setVertical
		h:ChangeState(Enum.HumanoidStateType.Jumping)
		local v = r.AssemblyLinearVelocity
		r.AssemblyLinearVelocity = Vector3.new(v.X, out.setVertical, v.Z)
	elseif out.setVertical then
		local v = r.AssemblyLinearVelocity
		r.AssemblyLinearVelocity = Vector3.new(v.X, out.setVertical, v.Z)
	end

	-- facing
	local face: Vector3? = nil
	local aiming = holding
		or controllers.ThrowController.isCharging()
		or controllers.CatchController.isMarking()
		or controllers.CatchController.reachActive()
	if aiming then
		face = controllers.CameraController.forward()
	elseif sim.mode == "Dive" or sim.mode == "DiveSlide" then
		face = sim.diveDir
	elseif out.vel.Magnitude > 2 then
		face = VecMath.flatUnit(out.vel)
	end
	if face and face.Magnitude > 0.5 then
		lastFacing = face
	end
	(ao :: AlignOrientation).CFrame = CFrame.lookAt(Vector3.zero, lastFacing)

	for _, e in out.events do
		queueEvent(e)
	end
	for _, fb in out.feedback do
		if fb.kind == "HopLanded" and holding then
			MovementController.Feedback:Fire({ kind = "Travel" })
		else
			MovementController.Feedback:Fire(fb)
		end
	end
	if out.pivotEstablished then
		pivot = r.Position
	end
	if out.landed then
		MovementController.Landed:Fire(sim.landedFromDive, sim.landingVel.Magnitude)
	end
	local modeChanged = sim.mode ~= lastMode
	if modeChanged then
		lastMode = sim.mode
		c:SetAttribute("UB_LocalMode", sim.mode)
	end
	if #pending > 0 or modeChanged then
		Net.event("Tech"):FireServer(pending, sim.mode)
		pending = {}
	end
	ComboEvaluator.expire(combo, now())
end

function MovementController.Init(c: any)
	controllers = c
end

function MovementController.Start()
	controllers.InputController.ActionBegan:Connect(function(action)
		if not MOVEMENT_ACTIONS[action] or not root or not character then
			return
		end
		if controllers.InputController.menuOpen() then
			return
		end
		filter()
		MovementSim.press(sim, action :: any, currentInput(), buildEnv())
	end)
	player.CharacterAdded:Connect(setupCharacter)
	if player.Character then
		task.spawn(setupCharacter, player.Character)
	end
	RunService:BindToRenderStep("UBMovement", Enum.RenderPriority.Input.Value + 1, step)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">PoseController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	PoseController — procedural body language for every character.

	Base locomotion comes from animations (src/character/Animate, BotService).
	On top, each client rotates Motor6D.C0 offsets of the root, waist, neck and
	shoulders so that what you see matches what the movement engine is doing:
	  leaning into acceleration and turns, the dip of a Snap Cut, the sit-back
	  of a Momentum Cancel, the forward sell of a Fake Commit or Burst, the
	  feet-first Slide, the horizontal Layout, the reach toward the disc, the
	  throw windup / follow-through (identical for real throws and fakes), mark
	  stances (wide-low or high hands) and celebrations. Heads track the disc.

	C0 edits are local to each client and never replicate, so every client
	poses every character from replicated attributes (the local character from
	its own controllers, with zero latency).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Actors = require(Shared.Actors)
local Net = require(Shared.Net)

local PoseController = {}

local controllers: any
local player = Players.LocalPlayer

type Joint = { motor: Motor6D, base: CFrame, current: CFrame }
type Rig = {
	model: Model,
	root: BasePart,
	joints: { [string]: Joint },
	lastVel: Vector3,
	accel: Vector3,
	isLocal: boolean,
}

local rigs: { [Model]: Rig } = {}
local firstSeen: { [Model]: number } = {}
local localTech = { name = "", t = -math.huge, dir = Vector3.zero }

local R15_JOINTS = {
	Root = { "LowerTorso", "Root" },
	Waist = { "UpperTorso", "Waist" },
	Neck = { "Head", "Neck" },
	RShoulder = { "RightUpperArm", "RightShoulder" },
	LShoulder = { "LeftUpperArm", "LeftShoulder" },
}

local R6_JOINTS = {
	Root = { "HumanoidRootPart", "RootJoint" },
	Neck = { "Torso", "Neck" },
	RShoulder = { "Torso", "Right Shoulder" },
	LShoulder = { "Torso", "Left Shoulder" },
}

local IDENTITY = CFrame.identity
local DOWN = Vector3.new(0, -1, 0)

local function now(): number
	return Net.now()
end

local function buildRig(model: Model): Rig?
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return nil
	end
	local map: { [string]: { string } } = if humanoid.RigType == Enum.HumanoidRigType.R15 then R15_JOINTS else R6_JOINTS
	local joints: { [string]: Joint } = {}
	for key, path in map do
		local partInst = model:FindFirstChild(path[1])
		local motor = partInst and partInst:FindFirstChild(path[2])
		if motor and motor:IsA("Motor6D") then
			joints[key] = { motor = motor, base = motor.C0, current = IDENTITY }
		end
	end
	if not joints.Root then
		return nil
	end
	return {
		model = model,
		root = root,
		joints = joints,
		lastVel = root.AssemblyLinearVelocity,
		accel = Vector3.zero,
		isLocal = model == player.Character,
	}
end

-- rotation taking the hanging arm (0,-1,0) to point along local direction d
local function aimArm(d: Vector3): CFrame
	local dir = if d.Magnitude > 0.01 then d.Unit else DOWN
	local axis = DOWN:Cross(dir)
	local dot = math.clamp(DOWN:Dot(dir), -1, 1)
	if axis.Magnitude < 1e-4 then
		return if dot > 0 then IDENTITY else CFrame.Angles(math.pi, 0, 0)
	end
	return CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
end

local function attrNumber(model: Model, key: string): number
	local v = model:GetAttribute(key)
	return if type(v) == "number" then v else -math.huge
end

type Ctx = {
	mode: string,
	speed: number,
	fwdAccel: number,
	latAccel: number,
	tech: string,
	techAge: number,
	techDir: Vector3, -- local space
	reachAge: number,
	reachDir: Vector3, -- local space
	windup: boolean,
	windupType: string,
	fakeAge: number,
	releaseAge: number,
	releaseType: string,
	mark: string,
	holding: boolean,
	celebrate: string,
	celebrateAge: number,
	leftHanded: boolean,
	lookAt: Vector3?, -- local space
}

local function toLocal(root: BasePart, v: Vector3): Vector3
	return root.CFrame:VectorToObjectSpace(v)
end

local function gather(rig: Rig, dt: number): Ctx
	local m = rig.model
	local root = rig.root
	local t = now()
	local vel = root.AssemblyLinearVelocity
	local flat = Vector3.new(vel.X, 0, vel.Z)
	local rawAccel = (vel - rig.lastVel) / math.max(dt, 1 / 240)
	rig.lastVel = vel
	rig.accel = rig.accel:Lerp(Vector3.new(rawAccel.X, 0, rawAccel.Z), math.min(1, dt * 10))
	local localAccel = toLocal(root, rig.accel)

	local ctx: Ctx = {
		mode = "Ground",
		speed = flat.Magnitude,
		fwdAccel = -localAccel.Z,
		latAccel = localAccel.X,
		tech = "",
		techAge = math.huge,
		techDir = Vector3.zero,
		reachAge = math.huge,
		reachDir = Vector3.new(0, 0, -1),
		windup = false,
		windupType = "Backhand",
		fakeAge = math.huge,
		releaseAge = math.huge,
		releaseType = "Backhand",
		mark = "",
		holding = m:GetAttribute("HasDisc") == true,
		celebrate = "",
		celebrateAge = math.huge,
		leftHanded = m:GetAttribute("LeftHanded") == true,
		lookAt = nil,
	}

	if rig.isLocal then
		local sim = controllers.MovementController.sim()
		ctx.mode = sim.mode
		ctx.tech = localTech.name
		ctx.techAge = t - localTech.t
		ctx.techDir = toLocal(root, localTech.dir)
		local reachAt, reachDir = controllers.CatchController.reachState()
		ctx.reachAge = t - reachAt
		ctx.reachDir = toLocal(root, reachDir)
		ctx.windup = controllers.ThrowController.isCharging()
		ctx.windupType = controllers.ThrowController.hud().throwType
		ctx.fakeAge = t - attrNumber(m, "UB_LocalFake")
		ctx.releaseAge = t - attrNumber(m, "UB_LocalRelease")
		ctx.releaseType = ctx.windupType
		ctx.mark = if controllers.CatchController.isMarking() then controllers.CatchController.markStance() else ""
		ctx.holding = controllers.ThrowController.isHolding()
	else
		local ms = m:GetAttribute("MS")
		ctx.mode = if type(ms) == "string" then ms else "Ground"
		local tech = m:GetAttribute("Tech")
		ctx.tech = if type(tech) == "string" then tech else ""
		ctx.techAge = t - attrNumber(m, "TechT")
		local td = m:GetAttribute("TechDir")
		ctx.techDir = if typeof(td) == "Vector3" then toLocal(root, td) else Vector3.zero
		ctx.reachAge = t - attrNumber(m, "Reach")
		local rd = m:GetAttribute("ReachDir")
		ctx.reachDir = if typeof(rd) == "Vector3" then toLocal(root, rd) else Vector3.new(0, 0, -1)
		local windupT = attrNumber(m, "Windup")
		local releaseT = attrNumber(m, "Release")
		local fakeT = attrNumber(m, "Fake")
		ctx.windup = ctx.holding and windupT > releaseT and windupT > fakeT and t - windupT < 3
		local wt = m:GetAttribute("WindupType")
		ctx.windupType = if type(wt) == "string" then wt else "Backhand"
		ctx.fakeAge = t - fakeT
		ctx.releaseAge = t - releaseT
		local rt = m:GetAttribute("ReleaseType")
		ctx.releaseType = if type(rt) == "string" then rt else "Backhand"
		local mark = m:GetAttribute("Mark")
		ctx.mark = if type(mark) == "string" then mark else ""
	end
	local cel = m:GetAttribute("Celebrate")
	ctx.celebrate = if type(cel) == "string" then cel else ""
	ctx.celebrateAge = t - attrNumber(m, "CelebrateT")

	-- heads follow the nearest flying disc
	local head = root.Position + Vector3.new(0, 2.5, 0)
	local best, bestD = nil, 120
	for _, f in controllers.DiscRenderer.folders() do
		if f:GetAttribute("Mode") == "Flight" then
			local p = controllers.DiscRenderer.positionOf(f:GetAttribute("Id"))
			if p then
				local d = (p - head).Magnitude
				if d < bestD then
					best, bestD = p, d
				end
			end
		end
	end
	if best then
		ctx.lookAt = toLocal(root, (best :: Vector3) - head)
	end
	return ctx
end

type Pose = { Root: CFrame, Waist: CFrame, Neck: CFrame, RShoulder: CFrame, LShoulder: CFrame, rate: number }

local function windupArm(kind: string): CFrame
	if kind == "Forehand" then
		return CFrame.Angles(0.35, 0, 1.25)
	elseif kind == "Hammer" or kind == "Scoober" then
		return CFrame.Angles(2.9, 0, 0.25)
	end
	return CFrame.Angles(1.3, 0, -1.0) -- backhand: arm across the body
end

local function windupWaist(kind: string): CFrame
	if kind == "Forehand" then
		return CFrame.Angles(0, -0.55, 0)
	elseif kind == "Hammer" or kind == "Scoober" then
		return CFrame.Angles(0.3, 0, 0)
	end
	return CFrame.Angles(0, 0.75, 0)
end

local function compute(ctx: Ctx): Pose
	local pose: Pose = {
		Root = IDENTITY,
		Waist = IDENTITY,
		Neck = IDENTITY,
		RShoulder = IDENTITY,
		LShoulder = IDENTITY,
		rate = 12,
	}
	-- base lean from speed, acceleration and turning
	local lean = -math.clamp(ctx.speed / 26, 0, 1) * 0.12 - math.clamp(ctx.fwdAccel / 90, -0.15, 0.22)
	local roll = -math.clamp(ctx.latAccel / 130, -0.32, 0.32)
	local rootCF = CFrame.Angles(lean, 0, roll)

	local age = ctx.techAge
	local tech = ctx.tech
	local dx = ctx.techDir.X
	if tech == "SnapCut" and age < 0.22 then
		rootCF = CFrame.new(0, -0.3, 0) * CFrame.Angles(lean - 0.1, 0, -math.sign(dx) * 0.45)
		pose.rate = 26
	elseif tech == "SlideCut" and age < 0.22 then
		rootCF = CFrame.new(0, -0.5, 0) * CFrame.Angles(-0.2, 0, -math.sign(dx) * 0.5)
		pose.rate = 26
	elseif tech == "MomentumCancel" and age < 0.3 then
		rootCF = CFrame.new(0, -0.6, 0) * CFrame.Angles(0.38, 0, 0)
		pose.rate = 26
	elseif (tech == "Lean" or tech == "FakeCommit" or tech == "BurstStep") and age < 0.25 then
		rootCF = CFrame.new(0, -0.2, 0) * CFrame.Angles(-0.45, 0, -math.clamp(dx, -1, 1) * 0.3)
		pose.rate = 28
	elseif tech == "AirRedirect" and age < 0.3 then
		rootCF = CFrame.Angles(-0.2, 0, -math.sign(dx) * 0.4)
		pose.rate = 22
	elseif tech == "PrecisionLanding" and age < 0.16 then
		rootCF = CFrame.new(0, -0.8, 0) * CFrame.Angles(-0.15, 0, 0)
		pose.rate = 30
	elseif tech == "WallRebound" and age < 0.3 then
		rootCF = CFrame.Angles(0.2, 0, -math.sign(dx) * 0.5)
		pose.rate = 24
	end

	local mode = ctx.mode
	local airUp = false
	if mode == "Slide" then
		rootCF = CFrame.new(0, -1.7, 0) * CFrame.Angles(0.95, 0, 0)
		pose.LShoulder = CFrame.Angles(0.9, 0, -0.7)
		pose.rate = 20
	elseif mode == "Dive" then
		rootCF = CFrame.new(0, -0.5, 0) * CFrame.Angles(-1.35, 0, 0)
		pose.RShoulder = CFrame.Angles(2.95, 0, 0.12)
		pose.LShoulder = CFrame.Angles(2.95, 0, -0.12)
		pose.rate = 18
	elseif mode == "DiveSlide" then
		rootCF = CFrame.new(0, -2.1, 0) * CFrame.Angles(-1.47, 0, 0)
		pose.RShoulder = CFrame.Angles(2.95, 0, 0.12)
		pose.LShoulder = CFrame.Angles(2.95, 0, -0.12)
		pose.rate = 22
	elseif mode == "Recover" then
		rootCF = CFrame.new(0, -1.2, 0) * CFrame.Angles(-0.6, 0, 0)
		pose.rate = 16
	elseif mode == "Air" then
		airUp = true
	end

	-- mark stance
	if ctx.mark == "Low" then
		rootCF = CFrame.new(0, -0.45, 0) * CFrame.Angles(-0.12, 0, 0)
		pose.RShoulder = CFrame.Angles(0.1, 0, 1.4)
		pose.LShoulder = CFrame.Angles(0.1, 0, -1.4)
		pose.rate = 18
	elseif ctx.mark == "High" then
		pose.RShoulder = CFrame.Angles(2.85, 0, 0.25)
		pose.LShoulder = CFrame.Angles(2.85, 0, -0.25)
		pose.rate = 18
	elseif airUp then
		pose.RShoulder = CFrame.Angles(0.7, 0, 0.35)
		pose.LShoulder = CFrame.Angles(0.7, 0, -0.35)
	end

	-- the disc arm
	local throwArm = IDENTITY
	local throwSet = false
	if ctx.holding then
		throwArm = CFrame.Angles(0.55, 0, 0.1)
		throwSet = true
	end
	if ctx.windup or ctx.fakeAge < 0.22 then
		throwArm = windupArm(ctx.windupType)
		pose.Waist = windupWaist(ctx.windupType)
		throwSet = true
		pose.rate = 22
	elseif ctx.releaseAge < 0.25 then
		throwArm = if ctx.releaseType == "Hammer" or ctx.releaseType == "Scoober"
			then CFrame.Angles(2.2, 0, 0.1)
			else CFrame.Angles(1.6, 0, 0.25)
		pose.Waist = if ctx.releaseType == "Forehand" then CFrame.Angles(0, 0.35, 0) else CFrame.Angles(0, -0.45, 0)
		throwSet = true
		pose.rate = 30
	end
	if throwSet then
		if ctx.leftHanded then
			local m = throwArm
			local rx, ry, rz = m:ToEulerAnglesXYZ()
			pose.LShoulder = CFrame.Angles(rx, -ry, -rz)
		else
			pose.RShoulder = throwArm
		end
	end

	-- reach: point the near arm at the disc
	if ctx.reachAge < 0.35 and not ctx.holding then
		local d = ctx.reachDir
		local arm = aimArm(d)
		if d.X >= 0 then
			pose.RShoulder = arm
		else
			pose.LShoulder = arm
		end
		pose.rate = 30
	end

	-- celebrations
	if ctx.celebrate ~= "" and ctx.celebrateAge < 3 then
		local a = ctx.celebrateAge
		if ctx.celebrate == "Point" then
			pose.RShoulder = CFrame.Angles(2.9, 0, 0.3)
		elseif ctx.celebrate == "Flex" then
			pose.RShoulder = CFrame.Angles(0, 0, 1.6)
			pose.LShoulder = CFrame.Angles(0, 0, -1.6)
		elseif ctx.celebrate == "Bow" then
			rootCF = CFrame.Angles(-0.8, 0, 0)
			pose.RShoulder = CFrame.Angles(0.4, 0, 0)
		elseif ctx.celebrate == "Spin" then
			rootCF = CFrame.Angles(0, a * 12, 0)
			pose.RShoulder = CFrame.Angles(2.9, 0, 0.2)
		elseif ctx.celebrate == "Slide" then
			rootCF = CFrame.new(0, -1.5, 0) * CFrame.Angles(0.5, 0, 0)
			pose.RShoulder = CFrame.Angles(2.6, 0, 0.6)
			pose.LShoulder = CFrame.Angles(2.6, 0, -0.6)
		end
		pose.rate = 14
	end
	pose.Root = rootCF

	-- head tracks the disc
	local look = ctx.lookAt
	if look and look.Magnitude > 0.1 then
		local yaw = math.clamp(math.atan2(-look.X, -look.Z), -1.1, 1.1)
		local pitch = math.clamp(math.atan2(look.Y, Vector3.new(look.X, 0, look.Z).Magnitude), -0.6, 0.7)
		pose.Neck = CFrame.Angles(pitch, yaw, 0)
	end
	return pose
end

local function apply(rig: Rig, pose: Pose, dt: number)
	local alpha = 1 - math.exp(-pose.rate * dt)
	for key, joint in rig.joints do
		local target: CFrame = (pose :: any)[key] or IDENTITY
		joint.current = joint.current:Lerp(target, alpha)
		local base = joint.base
		joint.motor.C0 = CFrame.new(base.Position) * joint.current * base.Rotation
	end
end

local function step(dt: number)
	local camPos = workspace.CurrentCamera.CFrame.Position
	local seen: { [Model]: boolean } = {}
	for _, model in Actors.characters() do
		seen[model] = true
		local rig = rigs[model]
		if not rig then
			-- wait for avatars to finish loading (scaling rewrites joint C0s)
			local seenAt = firstSeen[model]
			if not seenAt then
				firstSeen[model] = os.clock()
				continue
			end
			local owner = Players:GetPlayerFromCharacter(model)
			if os.clock() - seenAt < 1.0 or (owner and not owner:HasAppearanceLoaded() and os.clock() - seenAt < 6) then
				continue
			end
			local built = buildRig(model)
			if not built then
				continue
			end
			rigs[model] = built
			rig = built
		end
		local r = rig :: Rig
		if (r.root.Position - camPos).Magnitude > 300 then
			continue
		end
		local ok, err = pcall(function()
			apply(r, compute(gather(r, dt)), dt)
		end)
		if not ok then
			warn("[PoseController] " .. tostring(err))
			rigs[model] = nil
		end
	end
	for model in rigs do
		if not seen[model] then
			rigs[model] = nil
		end
	end
	for model in firstSeen do
		if not seen[model] then
			firstSeen[model] = nil
		end
	end
end

function PoseController.Init(c: any)
	controllers = c
end

function PoseController.Start()
	controllers.MovementController.Tech:Connect(function(e)
		local name = if e.tech == "FakeCommit" then "Lean" else e.tech
		localTech = { name = name, t = now(), dir = e.dir }
	end)
	player.CharacterAdded:Connect(function()
		localTech = { name = "", t = -math.huge, dir = Vector3.zero }
	end)
	RunService:BindToRenderStep("UBPose", Enum.RenderPriority.Character.Value + 1, step)
end

return PoseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
-- SettingsController — local settings and key bindings, synced to the
-- player's saved profile (Settings > Controls rebinding writes here).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local InputConfig = require(Shared.Config.Input)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local SettingsController = {}

SettingsController.Changed = Signal.new() -- (key)

local values: { [string]: any } = table.clone(InputConfig.DefaultSettings)
local overrides: { keyboard: { [string]: { string } }, gamepad: { [string]: { string } } } =
	{ keyboard = {}, gamepad = {} }
local applied = false
local saveQueued = false

function SettingsController.get(key: string): any
	return values[key]
end

function SettingsController.set(key: string, value: any)
	if values[key] == value then
		return
	end
	values[key] = value
	SettingsController.Changed:Fire(key)
	SettingsController.save()
end

function SettingsController.bindings(scheme: string): { [string]: { string } }
	local base: { [string]: { string } } = if scheme == "gamepad" then InputConfig.Gamepad else InputConfig.Keyboard
	local result: { [string]: { string } } = table.clone(base)
	local o = (overrides :: any)[scheme]
	if o then
		for action, keys in o do
			result[action] = keys
		end
	end
	return result
end

function SettingsController.setBinding(scheme: string, action: string, keys: { string })
	local o = (overrides :: any)[scheme]
	if not o then
		return
	end
	o[action] = keys
	SettingsController.Changed:Fire("Bindings")
	SettingsController.save()
end

function SettingsController.resetBindings()
	overrides = { keyboard = {}, gamepad = {} }
	SettingsController.Changed:Fire("Bindings")
	SettingsController.save()
end

function SettingsController.save()
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(1.5, function()
		saveQueued = false
		Net.event("Action"):FireServer("SaveSettings", {
			values = values,
			keyboard = overrides.keyboard,
			gamepad = overrides.gamepad,
		})
	end)
end

local function applyProfile(profile: any)
	if applied or type(profile) ~= "table" or type(profile.settings) ~= "table" then
		return
	end
	applied = true
	local s = profile.settings
	if type(s.values) == "table" then
		for k: string, default: any in InputConfig.DefaultSettings :: any do
			if type(s.values[k]) == type(default) then
				values[k] = s.values[k]
			end
		end
	end
	for _, scheme in { "keyboard", "gamepad" } do
		if type(s[scheme]) == "table" then
			for action, keys in s[scheme] do
				if type(keys) == "table" and #keys > 0 then
					(overrides :: any)[scheme][action] = keys
				end
			end
		end
	end
	SettingsController.Changed:Fire("All")
end

function SettingsController.Init(_c: any) end

function SettingsController.Start()
	Net.event("Profile").OnClientEvent:Connect(applyProfile)
	task.spawn(function()
		local ok, profile = pcall(function()
			return Net.func("GetProfile"):InvokeServer()
		end)
		if ok then
			applyProfile(profile)
		end
	end)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">ThrowController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ThrowController — everything you do with the disc in your hand.

	  hold Primary      charge (power rises to full at ChargeTime; release in
	                    the Perfect window for +speed/+spin; holding longer
	                    bleeds spin = a wobblier line)
	  Secondary         pump fake (same windup the defender sees on a real throw)
	  Q / E             bank the disc left / right (curves the flight)
	  1-5, wheel, Z/X   throw type
	  hold Slide key    low release (step out under the mark)
	  Jump              hop -> high release over the mark (must release before landing)
	  R                 Lead Pass assist: aims at the teammate nearest your
	                    crosshair using their CURRENT velocity and marks the
	                    ideal power on the meter; timing the release is still on you

	The preview arc shows the first part of the flight (how much depends on the
	mode: full in training, half in casual, a fifth in ranked).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local DiscPhysics = require(Shared.Disc.DiscPhysics)
local ThrowModel = require(Shared.Disc.ThrowModel)
local Solver = require(Shared.Disc.Solver)
local Actors = require(Shared.Actors)
local VecMath = require(Shared.Util.VecMath)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local T = DiscConfig.Throw

local ThrowController = {}

ThrowController.Released = Signal.new() -- (launch, params)
ThrowController.Faked = Signal.new()
ThrowController.Changed = Signal.new()

local controllers: any
local player = Players.LocalPlayer

local AIM_OFFSET = math.rad(7) -- the camera looks slightly down over the shoulder
local BANK_STEPS = 3

local state = {
	throwType = "Backhand",
	bankStep = 0,
	low = false,
	charging = false,
	chargeStart = 0,
	releasedAt = -math.huge,
	releasedFlight = -1,
	leadLock = false,
	leadTarget = nil :: number?,
	leadSolution = nil :: Solver.Solution?,
	lastSolve = 0,
	lastFake = 0,
	heldFolder = nil :: Configuration?,
}

local dots: { BasePart } = {}
local DOT_COUNT = 40

local function now(): number
	return Net.now()
end

function ThrowController.heldFolder(): Configuration?
	local f = controllers.DiscRenderer.heldByMe()
	if not f then
		return nil
	end
	-- a just-released disc is no longer ours unless the server rejected it
	if os.clock() - state.releasedAt < 0.8 and (f:GetAttribute("FlightId") :: number? or 0) == state.releasedFlight then
		return nil
	end
	return f
end

function ThrowController.isHolding(): boolean
	return ThrowController.heldFolder() ~= nil
end

function ThrowController.isCharging(): boolean
	return state.charging
end

function ThrowController.chargeFraction(): (number, string)
	if not state.charging then
		return 0, "Idle"
	end
	local hold = os.clock() - state.chargeStart
	local power, quality = ThrowModel.charge(hold, state.throwType)
	local info = ThrowModel.typeInfo(state.throwType)
	local t = hold * (info.ChargeMult or 1)
	return math.min(t / T.ChargeTime, 1.6), if quality == "Clean" and power < 1 then "Charging" else quality
end

local function airborne(): boolean
	return not controllers.MovementController.isGrounded()
end

local function releaseHeight(): string
	if state.low then
		return "Low"
	end
	if airborne() then
		return "High"
	end
	return "Mid"
end

local function currentParams(holdTime: number): ThrowModel.Params
	local yaw = controllers.CameraController.getYaw()
	local pitch = controllers.CameraController.getPitch() + AIM_OFFSET
	local sol = state.leadSolution
	if state.leadLock and sol then
		yaw = sol.params.yaw
		pitch = sol.params.pitch
	end
	local sim = controllers.MovementController.sim()
	local height = releaseHeight()
	return {
		throwType = state.throwType,
		yaw = yaw,
		pitch = pitch,
		holdTime = holdTime,
		bank = state.bankStep / BANK_STEPS,
		height = height,
		offBalance = airborne() and height ~= "High",
		groundThrow = sim.mode == "DiveSlide" or sim.mode == "Recover",
		leftHanded = controllers.SettingsController.get("LeftHanded") == true,
	}
end

function ThrowController.hud(): { [string]: any }
	local fraction, phase = ThrowController.chargeFraction()
	local idealPower: number? = nil
	local sol = state.leadSolution
	if state.leadLock and sol then
		idealPower = math.clamp(
			sol.params.holdTime / T.ChargeTime * (ThrowModel.typeInfo(state.throwType).ChargeMult or 1),
			0,
			1
		)
	end
	return {
		holding = ThrowController.isHolding(),
		throwType = state.throwType,
		bank = state.bankStep,
		bankSteps = BANK_STEPS,
		height = releaseHeight(),
		charge = fraction,
		phase = phase,
		leadLock = state.leadLock,
		leadName = if state.leadTarget then Actors.nameOf(state.leadTarget) else nil,
		idealPower = idealPower,
	}
end

local function setType(t: string)
	if (DiscConfig.Types :: any)[t] and t ~= state.throwType then
		state.throwType = t
		if state.charging then
			-- switching mid-charge restarts the windup (no type-switch exploits)
			state.chargeStart = os.clock()
			Net.event("ThrowCharge"):FireServer(t)
		end
		ThrowController.Changed:Fire()
	end
end

local function cycleType(delta: number)
	local order = DiscConfig.TypeOrder
	local i = table.find(order, state.throwType) or 1
	i = ((i - 1 + delta) % #order) + 1
	setType(order[i])
end

local function release()
	if not state.charging then
		return
	end
	state.charging = false
	local folder = ThrowController.heldFolder()
	local root = controllers.MovementController.root()
	if not folder or not root then
		return
	end
	local hold = os.clock() - state.chargeStart
	local params = currentParams(hold)
	Net.event("Throw"):FireServer({
		throwType = params.throwType,
		yaw = params.yaw,
		pitch = params.pitch,
		holdTime = params.holdTime,
		bank = params.bank,
		height = params.height,
	})
	local launch = ThrowModel.launch(params, root.Position, root.AssemblyLinearVelocity)
	local id = folder:GetAttribute("Id") :: string
	controllers.DiscRenderer.predictThrow(id, launch.state)
	state.releasedAt = os.clock()
	state.releasedFlight = (folder:GetAttribute("FlightId") :: number?) or 0
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalRelease", now())
		c:SetAttribute("UB_LocalWindup", 0)
	end
	ThrowController.Released:Fire(launch, params)
	ThrowController.Changed:Fire()
end

local function fake()
	if os.clock() - state.lastFake < T.FakeCooldown then
		return
	end
	state.lastFake = os.clock()
	state.charging = false
	Net.event("Fake"):FireServer(state.throwType)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalFake", now())
		c:SetAttribute("UB_LocalWindupType", state.throwType)
	end
	ThrowController.Faked:Fire()
end

-- picks the teammate closest to the crosshair and solves a lead pass
local function updateLead()
	if not state.leadLock then
		return
	end
	local root = controllers.MovementController.root()
	local c = player.Character
	if not root or not c then
		return
	end
	local myTeam = c:GetAttribute("UBTeam")
	local aim = controllers.CameraController.getAimDirection()
	local best, bestDot = nil, math.cos(math.rad(35))
	for _, model in Actors.characters() do
		if model ~= c and (model:GetAttribute("UBTeam") == myTeam or myTeam == "N") then
			local r = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				local dir = (r.Position - root.Position)
				if dir.Magnitude > 6 then
					local d = aim:Dot(dir.Unit)
					if d > bestDot then
						best, bestDot = model, d
					end
				end
			end
		end
	end
	local id = if best then Actors.idOf(best) else nil
	state.leadTarget = id
	if not best or os.clock() - state.lastSolve < 0.2 then
		if not best then
			state.leadSolution = nil
		end
		return
	end
	state.lastSolve = os.clock()
	local r = (best :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
	local w = Net.state():GetAttribute("Wind")
	local wind = if typeof(w) == "Vector3" then { x = w.X, y = w.Y, z = w.Z } else nil
	local sol = Solver.solve({
		rootPos = root.Position,
		throwerVel = root.AssemblyLinearVelocity,
		throwType = state.throwType,
		bank = state.bankStep / BANK_STEPS,
		height = releaseHeight(),
		target = r.Position + Vector3.new(0, 1, 0),
		targetVel = VecMath.flat(r.AssemblyLinearVelocity),
		wind = wind,
		groundY = 0,
		coarse = true,
		leftHanded = controllers.SettingsController.get("LeftHanded") == true,
	})
	-- only offer a lead when a catchable pass exists
	state.leadSolution = if sol and sol.miss <= 4 then sol else nil
end

local function previewFraction(folder: Configuration): number
	local context = folder:GetAttribute("Context")
	if context ~= "Match" then
		return 1
	end
	local f = Net.state():GetAttribute("PreviewFraction")
	return if type(f) == "number" then f else 0.5
end

local function hideDots()
	for _, d in dots do
		d.Transparency = 1
	end
end

local function drawPreview(folder: Configuration)
	if not controllers.SettingsController.get("TrajectoryPreview") then
		hideDots()
		return
	end
	local root = controllers.MovementController.root()
	if not root then
		hideDots()
		return
	end
	local hold: number
	if state.charging then
		hold = os.clock() - state.chargeStart
	elseif state.leadLock and state.leadSolution then
		hold = (state.leadSolution :: Solver.Solution).params.holdTime
	else
		hold = T.ChargeTime * 0.6 / (ThrowModel.typeInfo(state.throwType).ChargeMult or 1)
	end
	local params = currentParams(hold)
	local launch = ThrowModel.launch(params, root.Position, root.AssemblyLinearVelocity)
	local w = Net.state():GetAttribute("Wind")
	local wind = if typeof(w) == "Vector3" then { x = w.X, y = w.Y, z = w.Z } else nil
	local result = DiscPhysics.simulate(launch.state, 8, wind, 0, 6)
	local total = result.landT
	local fraction = previewFraction(folder)
	local limit = total * fraction
	local _, phase = ThrowController.chargeFraction()
	local color = if phase == "Perfect"
		then Color3.fromRGB(255, 215, 80)
		elseif phase == "Over" then Color3.fromRGB(255, 90, 100)
		else Color3.fromRGB(230, 245, 255)
	local idx = 0
	local nextT = 0
	for _, s in result.samples do
		if s.t > limit or idx >= DOT_COUNT then
			break
		end
		if s.t >= nextT then
			idx += 1
			local d = dots[idx]
			d.Position = Vector3.new(s.x, s.y, s.z)
			d.Color = color
			d.Transparency = 0.15 + 0.6 * (s.t / math.max(limit, 0.01))
			nextT = s.t + 0.07
		end
	end
	for i = idx + 1, DOT_COUNT do
		dots[i].Transparency = 1
	end
end

local function step()
	local folder = ThrowController.heldFolder()
	if folder ~= state.heldFolder then
		state.heldFolder = folder
		if not folder then
			state.charging = false
			state.leadSolution = nil
		end
		ThrowController.Changed:Fire()
	end
	if not folder then
		hideDots()
		return
	end
	updateLead()
	drawPreview(folder)
	local c = player.Character
	if c then
		c:SetAttribute("UB_LocalWindup", if state.charging then state.chargeStart else 0)
		c:SetAttribute("UB_LocalWindupType", state.throwType)
	end
end

function ThrowController.Init(c: any)
	controllers = c
end

function ThrowController.Start()
	local visuals = workspace:WaitForChild("UBVisuals")
	for i = 1, DOT_COUNT do
		local d = Instance.new("Part")
		d.Name = "PreviewDot"
		d.Shape = Enum.PartType.Ball
		d.Size = Vector3.new(0.35, 0.35, 0.35)
		d.Anchored = true
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.CastShadow = false
		d.Material = Enum.Material.Neon
		d.Transparency = 1
		d.Parent = visuals
		dots[i] = d
	end

	local input = controllers.InputController
	input.ActionBegan:Connect(function(action)
		if not ThrowController.isHolding() then
			if action == "Celebrate" then
				Net.event("Action"):FireServer("Celebrate", nil)
			end
			return
		end
		if action == "Primary" then
			state.charging = true
			state.chargeStart = os.clock()
			Net.event("ThrowCharge"):FireServer(state.throwType)
		elseif action == "Secondary" then
			fake()
		elseif action == "BankLeft" then
			state.bankStep = math.max(-BANK_STEPS, state.bankStep - 1)
			ThrowController.Changed:Fire()
		elseif action == "BankRight" then
			state.bankStep = math.min(BANK_STEPS, state.bankStep + 1)
			ThrowController.Changed:Fire()
		elseif action == "TypeNext" then
			cycleType(1)
		elseif action == "TypePrev" then
			cycleType(-1)
		elseif string.sub(action, 1, 4) == "Type" then
			local n = tonumber(string.sub(action, 5))
			if n and DiscConfig.TypeOrder[n] then
				setType(DiscConfig.TypeOrder[n])
			end
		elseif action == "Slide" then
			state.low = true
			ThrowController.Changed:Fire()
		elseif action == "LeadLock" then
			state.leadLock = not state.leadLock
			state.leadSolution = nil
			ThrowController.Changed:Fire()
		end
	end)
	input.ActionEnded:Connect(function(action)
		if action == "Primary" then
			release()
		elseif action == "Slide" then
			state.low = false
			ThrowController.Changed:Fire()
		end
	end)
	input.Wheel:Connect(function(delta)
		if ThrowController.isHolding() then
			cycleType(if delta > 0 then -1 else 1)
		end
	end)
	controllers.MovementController.Feedback:Connect(function(fb)
		if fb.kind == "Travel" and state.charging then
			state.charging = false
		end
	end)
	RunService:BindToRenderStep("UBThrow", Enum.RenderPriority.Camera.Value + 4, step)
end

return ThrowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
-- UIController — builds the interface and routes server messages to it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local TeamsConfig = require(Shared.Config.Teams)
local UI = script.Parent.Parent.UI
local Theme = require(UI.Theme)
local Hud = require(UI.Hud)
local ThrowHud = require(UI.ThrowHud)
local Menu = require(UI.Menu)
local Panels = require(UI.Panels)
local Mobile = require(UI.Mobile)

local C = Theme.Colors

local UIController = {}

local controllers: any
local player = Players.LocalPlayer
local lastLevel: number? = nil
local hintedVote = false

local REASONS: { [string]: string } = {
	Incomplete = "Incomplete pass",
	Drop = "Dropped",
	Block = "Blocked",
	OutOfBounds = "Out of bounds",
	Stall = "Stalled out",
	Interception = "Intercepted",
}

function UIController.toggleMenu()
	Menu.toggle()
end

local function teamName(t: string?): string
	return if t == "A" then TeamsConfig.A.Name elseif t == "B" then TeamsConfig.B.Name else ""
end

local function onNotify(kind: string, text: string, data: any)
	local d = if type(data) == "table" then data else {}
	if kind == "Banner" then
		Hud.banner(text, d.sub, nil, 1.8)
	elseif kind == "Goal" then
		local scorer = if type(d.scorer) == "number" then (require(Shared.Actors) :: any).nameOf(d.scorer) else ""
		local sub = if d.callahan
			then ("CALLAHAN by " .. scorer)
			else scorer .. (if d.assist
				then "  ·  assist " .. (require(Shared.Actors) :: any).nameOf(d.assist)
				else "")
		Hud.banner(text, sub, Theme.teamColor(d.team), 3)
	elseif kind == "Turnover" then
		local sub = REASONS[d.reason or ""] or ""
		Hud.banner(text, sub .. (if d.team then ("  ·  " .. teamName(d.team) .. " ball") else ""), C.Bad, 1.6)
	elseif kind == "Point" then
		local myTeam = if player.Character then player.Character:GetAttribute("UBTeam") else nil
		local sub = if d.offense == myTeam then "You receive" else "You pull and defend"
		if d.pull == false then
			sub = if d.offense == myTeam then "Your disc" else "Defend"
		end
		Hud.banner(text, sub, nil, 2.2)
	elseif kind == "Toast" then
		Hud.toast(text, nil, 3.5)
	elseif kind == "Achievement" then
		Hud.toast("ACHIEVEMENT: " .. text .. " — " .. tostring(d.description or ""), C.Gold, 6)
		controllers.AudioController.play("Highlight")
	elseif kind == "LevelUp" then
		Hud.banner(text, "Level up!", C.Gold, 2.5)
		for _, u in d.unlocks or {} do
			Hud.toast("Unlocked " .. u.slot .. ": " .. u.name, C.Accent, 6)
		end
	end
end

local function onFeedback(kind: string, payload: any)
	if kind == "Release" and type(payload) == "table" then
		local color = if payload.quality == "Perfect"
			then C.Perfect
			elseif payload.quality == "Over" then C.Sloppy
			else C.Clean
		local text = string.format(
			"%s RELEASE  ·  power %d%%  ·  spin %d%%",
			string.upper(payload.quality),
			math.floor(payload.power * 100),
			math.floor(payload.spin * 100)
		)
		if payload.blocked then
			text = "HAND BLOCKED — fake, pivot or change your release height"
			color = C.Bad
		elseif payload.offBalance then
			text ..= "  ·  off balance"
		elseif payload.groundThrow then
			text ..= "  ·  from the ground"
		end
		Hud.feedback(text, color, 2.2)
	elseif kind == "DrillHud" then
		Panels.drillHud(payload)
	elseif kind == "Drill" then
		Panels.drillReport(payload)
		controllers.AudioController.play("Highlight")
	elseif kind == "DrillTick" and type(payload) == "table" then
		Hud.feedback(payload.text or "", C.Text, 4)
	elseif kind == "OpenLauncher" then
		Hud.toast("Free launcher: press M > Training to set up and fire launches.", C.Accent, 6)
	end
end

local function onMovementFeedback(fb: any)
	local kind = fb.kind
	if kind == "LandingOffset" then
		local v = fb.value or 0
		Hud.feedback(
			string.format("PRECISION LANDING  %s%d ms", if v >= 0 then "-" else "+", math.floor(math.abs(v) * 1000)),
			C.Perfect,
			1.2
		)
	elseif kind == "LandingEarly" then
		Hud.feedback("TOO EARLY — press Slide just before touchdown", C.Sloppy, 1.3)
	elseif kind == "PlantEarly" then
		Hud.feedback("TOO EARLY — let the plant land (0.1 s), then restart", C.Sloppy, 1.3)
	elseif kind == "PopEarly" then
		Hud.feedback("TOO EARLY — wait until your slide stops", C.Sloppy, 1.3)
	elseif kind == "PopLate" then
		Hud.feedback("MISSED THE POP-UP WINDOW", C.Sloppy, 1.3)
	elseif kind == "Cooldown" then
		Hud.feedback(string.format("COOLDOWN %.1f s", math.max(0, fb.value or 0)), C.Muted, 0.8)
	elseif kind == "Travel" then
		Hud.feedback("TRAVEL — release before you land from a hop", C.Bad, 1.6)
	end
end

local function updateHint()
	local c = player.Character
	local role = if c then c:GetAttribute("UBRole") else nil
	local phase = Net.state():GetAttribute("Phase")
	if controllers.ThrowController.isHolding() then
		Hud.setHint("")
	elseif role == "Training" then
		Hud.setHint("Walk to a terminal and press G to start a drill  ·  M: menu")
	elseif phase == "Intermission" then
		Hud.setHint("Warm-up: grab the disc and throw it around  ·  M: vote / train / settings")
		if not hintedVote then
			hintedVote = true
			Hud.toast("Press M to vote for the next mode and arena, or to train.", C.Accent, 6)
		end
	else
		Hud.setHint("M: menu  ·  B: celebrate after a goal")
	end
end

function UIController.Init(c: any)
	controllers = c
end

function UIController.Start()
	task.spawn(function()
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
				StarterGui:SetCore("ResetButtonCallback", false)
			end)
			if ok then
				break
			end
			task.wait(1)
		end
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "UBInterface"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	Hud.build(gui, controllers)
	ThrowHud.build(gui, controllers)
	Panels.build(gui, controllers)
	Mobile.build(gui, controllers)
	Menu.build(gui, controllers)

	controllers.InputController.ActionBegan:Connect(function(action)
		if action == "Menu" then
			Menu.toggle()
		end
	end)
	controllers.MovementController.Tech:Connect(function(e)
		Hud.techLabel(e.tech, e.quality, e.info)
	end)
	controllers.MovementController.Feedback:Connect(onMovementFeedback)

	Net.event("Notify").OnClientEvent:Connect(onNotify)
	Net.event("Feedback").OnClientEvent:Connect(onFeedback)
	Net.event("Highlight").OnClientEvent:Connect(function(h)
		if type(h) == "table" then
			Hud.highlight(h.name or "", h.text or "", h.team)
		end
	end)
	Net.event("Combo").OnClientEvent:Connect(function(summary)
		if type(summary) == "table" and summary.converted then
			Hud.feedback(
				string.format(
					"%s  ·  COMBO %d%s",
					string.upper(summary.payoff or "PLAY"),
					summary.score,
					if summary.tier then "  · " .. summary.tier else ""
				),
				C.Gold,
				2.6
			)
		end
	end)
	Net.event("Summary").OnClientEvent:Connect(function(sum)
		if type(sum) == "table" then
			Panels.showSummary(sum)
		end
	end)
	Net.event("Profile").OnClientEvent:Connect(function(p)
		if type(p) ~= "table" then
			return
		end
		Menu.setProfile(p)
		lastLevel = p.level
	end)
	task.spawn(function()
		local ok, p = pcall(function()
			return Net.func("GetProfile"):InvokeServer()
		end)
		if ok and type(p) == "table" then
			Menu.setProfile(p)
			lastLevel = p.level
			if not p.persistent then
				Hud.toast("Progress is not being saved this session (DataStores unavailable).", C.Sloppy, 8)
			end
		end
	end)

	local lastHint = 0
	RunService.RenderStepped:Connect(function(dt)
		Hud.update(dt)
		ThrowHud.update()
		Panels.update()
		Mobile.update()
		local clock = os.clock()
		if clock - lastHint > 0.5 then
			lastHint = clock
			updateHint()
		end
	end)
	local _ = lastLevel
end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="74">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- ULTIMATE: BREAKPOINT — client bootstrap. Controllers are initialised and
-- started in dependency order with a shared registry (no circular requires).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Shared")
ReplicatedStorage:WaitForChild("UBRemotes")

local Controllers = script.Parent:WaitForChild("Controllers")

local ORDER = {
	"SettingsController",
	"InputController",
	"CameraController",
	"DiscRenderer",
	"MovementController",
	"CatchController",
	"ThrowController",
	"PoseController",
	"AudioController",
	"EffectsController",
	"UIController",
}

local controllers: { [string]: any } = {}
for _, name in ORDER do
	controllers[name] = require(Controllers:WaitForChild(name)) :: any
end

for _, name in ORDER do
	local ok, err = pcall(controllers[name].Init, controllers)
	if not ok then
		warn(string.format("[Breakpoint] %s.Init failed: %s", name, tostring(err)))
	end
end

for _, name in ORDER do
	local ok, err = pcall(controllers[name].Start)
	if not ok then
		warn(string.format("[Breakpoint] %s.Start failed: %s", name, tostring(err)))
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="75">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Hud — only what helps a decision: score, clock, which way you attack,
	possession, stall count, wind, exertion and cooldowns, plus short-lived
	feedback (technique labels, timing, highlights, banners).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local MovementConfig = require(Shared.Config.Movement)
local TeamsConfig = require(Shared.Config.Teams)
local MovementSim = require(Shared.Movement.MovementSim)
local ComboEvaluator = require(Shared.Rules.ComboEvaluator)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Hud = {}

local controllers: any
local player = Players.LocalPlayer

local refs: { [string]: any } = {}
local feedEntries: { { label: TextLabel, born: number } } = {}

local function now(): number
	return Net.now()
end

local function pill(parent: Instance, name: string, pos: UDim2, size: UDim2, anchor: Vector2?): Frame
	local f = Theme.panel({
		Name = name,
		Position = pos,
		Size = size,
		AnchorPoint = anchor or Vector2.new(0.5, 0),
		Parent = parent,
	})
	return f
end

function Hud.build(parent: ScreenGui, c: any)
	controllers = c

	-- scoreboard ---------------------------------------------------------
	local board = pill(parent, "Scoreboard", UDim2.new(0.5, 0, 0, 10), UDim2.fromOffset(420, 64))
	refs.teamA = Theme.label(TeamsConfig.A.Name, 18, {
		Parent = board,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.fromOffset(110, 22),
		TextColor3 = C.TeamA,
		Font = Theme.Fonts.Heavy,
	})
	refs.scoreA = Theme.label("0", 34, {
		Parent = board,
		Position = UDim2.fromOffset(14, 26),
		Size = UDim2.fromOffset(110, 34),
		Font = Theme.Fonts.Heavy,
	})
	refs.teamB = Theme.label(TeamsConfig.B.Name, 18, {
		Parent = board,
		Position = UDim2.new(1, -124, 0, 8),
		Size = UDim2.fromOffset(110, 22),
		TextColor3 = C.TeamB,
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	refs.scoreB = Theme.label("0", 34, {
		Parent = board,
		Position = UDim2.new(1, -124, 0, 26),
		Size = UDim2.fromOffset(110, 34),
		Font = Theme.Fonts.Heavy,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	refs.clock = Theme.label("0:00", 26, {
		Parent = board,
		Position = UDim2.new(0.5, -70, 0, 4),
		Size = UDim2.fromOffset(140, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Gold,
		Font = Theme.Fonts.Heavy,
	})
	refs.phase = Theme.label("WARMUP", 13, {
		Parent = board,
		Position = UDim2.new(0.5, -90, 0, 36),
		Size = UDim2.fromOffset(180, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})

	-- attack direction arrow ---------------------------------------------
	local arrowHolder = make("Frame", {
		Name = "Attack",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.fromOffset(260, 30),
		Parent = parent,
	})
	refs.attackArrow = Theme.label(">", 26, {
		Parent = arrowHolder,
		Size = UDim2.fromOffset(30, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	refs.attackText = Theme.label("", 14, {
		Parent = arrowHolder,
		Position = UDim2.fromOffset(34, 6),
		Size = UDim2.fromOffset(230, 18),
		TextColor3 = C.Text,
	})

	-- wind ----------------------------------------------------------------
	local wind = pill(parent, "Wind", UDim2.new(1, -16, 0, 10), UDim2.fromOffset(110, 44), Vector2.new(1, 0))
	refs.windArrow = Theme.label(">", 26, {
		Parent = wind,
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(28, 28),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Accent,
	})
	refs.windText = Theme.label("CALM", 14, {
		Parent = wind,
		Position = UDim2.fromOffset(40, 13),
		Size = UDim2.fromOffset(66, 18),
	})
	refs.wind = wind

	-- exertion + cooldowns -------------------------------------------------
	local bottom = make("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(340, 46),
		Parent = parent,
	})
	local barBack = make("Frame", {
		Name = "ExertionBack",
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -8),
		Size = UDim2.new(1, 0, 0, 8),
		Parent = bottom,
		Theme.corner(4),
	})
	refs.exertion = make("Frame", {
		Name = "Exertion",
		BackgroundColor3 = C.Good,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = barBack,
		Theme.corner(4),
	})
	local pips = make("Frame", {
		Name = "Pips",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = bottom,
		Theme.list(8, true),
	});
	(pips:FindFirstChildOfClass("UIListLayout") :: UIListLayout).HorizontalAlignment = Enum.HorizontalAlignment.Center
	refs.pips = {}
	for i, def in
		{
			{ key = "BurstStep", label = "BURST" },
			{ key = "Dive", label = "DIVE" },
			{ key = "MomentumCancel", label = "PLANT" },
			{ key = "Slide", label = "SLIDE" },
			{ key = "Air", label = "AIR" },
		}
	do
		local p = Theme.panel({ Name = def.key, Size = UDim2.fromOffset(60, 26), LayoutOrder = i, Parent = pips })
		local fill = make("Frame", {
			Name = "Fill",
			BackgroundColor3 = (Theme.TechColors :: any)[def.key] or C.Accent,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Parent = p,
			Theme.corner(10),
		})
		Theme.label(def.label, 12, {
			Parent = p,
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		refs.pips[def.key] = fill
	end

	-- combo feed -------------------------------------------------------------
	local feed = make("Frame", {
		Name = "ComboFeed",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 18, 0.55, 0),
		Size = UDim2.fromOffset(260, 260),
		Parent = parent,
	})
	refs.comboTotal = Theme.label("", 22, {
		Parent = feed,
		Size = UDim2.fromOffset(260, 28),
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
	})
	refs.feedList = make("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.fromOffset(260, 220),
		Parent = feed,
		Theme.list(2),
	})
	refs.feed = feed

	-- timing feedback line ------------------------------------------------------
	refs.feedback = Theme.label("", 20, {
		Name = "Feedback",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(700, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		TextTransparency = 1,
		TextStrokeColor3 = Color3.new(0, 0, 0),
	})

	-- big banner + highlight -------------------------------------------------------
	refs.banner = Theme.label("", 56, {
		Name = "Banner",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(900, 64),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextStrokeTransparency = 0.4,
		TextTransparency = 1,
	})
	refs.bannerSub = Theme.label("", 20, {
		Name = "BannerSub",
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.32, 44),
		Size = UDim2.fromOffset(900, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		TextTransparency = 1,
	})
	local hl = pill(parent, "Highlight", UDim2.new(0.5, 0, 0, 118), UDim2.fromOffset(560, 54))
	hl.Visible = false
	refs.hlName = Theme.label("", 14, {
		Parent = hl,
		Position = UDim2.fromOffset(14, 4),
		Size = UDim2.new(1, -28, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})
	refs.hlText = Theme.label("", 24, {
		Parent = hl,
		Position = UDim2.fromOffset(14, 20),
		Size = UDim2.new(1, -28, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
	})
	refs.highlight = hl

	-- toasts ---------------------------------------------------------------------
	refs.toasts = make("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 66),
		Size = UDim2.fromOffset(300, 300),
		Parent = parent,
		Theme.list(6),
	})

	-- stall + crosshair ------------------------------------------------------------
	local stall = pill(parent, "Stall", UDim2.new(0.5, 0, 1, -150), UDim2.fromOffset(180, 46), Vector2.new(0.5, 1))
	stall.Visible = false
	refs.stallText = Theme.label("STALL 0", 26, {
		Parent = stall,
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
	})
	refs.stall = stall
	refs.crosshair = make("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Parent = parent,
		Theme.corner(3),
	})
	refs.hint = Theme.label("", 14, {
		Name = "Hint",
		Parent = parent,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(520, 18),
		TextColor3 = C.Muted,
	})
end

---------------------------------------------------------------------------
-- transient messages
---------------------------------------------------------------------------

local bannerToken = 0
function Hud.banner(text: string, sub: string?, color: Color3?, duration: number?)
	bannerToken += 1
	local token = bannerToken
	local b = refs.banner :: TextLabel
	local s = refs.bannerSub :: TextLabel
	b.Text = text
	b.TextColor3 = color or C.Text
	s.Text = sub or ""
	b.TextTransparency = 0
	s.TextTransparency = if sub then 0 else 1
	b.TextSize = 70
	TweenService:Create(b, TweenInfo.new(0.25, Enum.EasingStyle.Back), { TextSize = 56 }):Play()
	task.delay(duration or 1.8, function()
		if token == bannerToken then
			TweenService:Create(b, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			TweenService:Create(s, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		end
	end)
end

local feedbackToken = 0
function Hud.feedback(text: string, color: Color3?, duration: number?)
	feedbackToken += 1
	local token = feedbackToken
	local f = refs.feedback :: TextLabel
	f.Text = text
	f.TextColor3 = color or C.Text
	f.TextTransparency = 0
	task.delay(duration or 1.6, function()
		if token == feedbackToken then
			TweenService:Create(f, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
		end
	end)
end

function Hud.toast(text: string, color: Color3?, duration: number?)
	local t = Theme.panel({ Size = UDim2.fromOffset(300, 40), Parent = refs.toasts })
	Theme.label(text, 15, {
		Parent = t,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		TextColor3 = color or C.Text,
		TextWrapped = true,
	})
	task.delay(duration or 4, function()
		t:Destroy()
	end)
end

local hlToken = 0
function Hud.highlight(name: string, text: string, team: string?)
	hlToken += 1
	local token = hlToken
	local hl = refs.highlight :: Frame
	refs.hlName.Text = string.upper(name)
	refs.hlText.Text = text
	local stroke = hl:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = Theme.teamColor(team)
		stroke.Transparency = 0
	end
	hl.Visible = true
	hl.Size = UDim2.fromOffset(600, 60)
	TweenService:Create(hl, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(560, 54) }):Play()
	task.delay(2.6, function()
		if token == hlToken then
			hl.Visible = false
		end
	end)
end

function Hud.techLabel(tech: string, quality: string, info: string?)
	if not controllers.SettingsController.get("ShowTechLabels") then
		return
	end
	if tech == "Jump" then
		return
	end
	local name = (MovementConfig.TechNames :: any)[tech] or tech
	if info == "Restart" then
		name = "Restart Cut"
	elseif info == "Sold" then
		name = "Sold Cut"
	elseif info == "RollOut" then
		name = "Roll-out"
	elseif info == "Explosive" then
		name = "Explosive Burst"
	end
	local label =
		Theme.label(string.upper(name) .. (if quality ~= "Clean" then "  " .. string.upper(quality) else ""), 18, {
			Parent = refs.feedList,
			TextColor3 = if quality == "Clean"
				then ((Theme.TechColors :: any)[tech] or C.Text)
				else Theme.qualityColor(quality),
			Font = Theme.Fonts.Heavy,
			TextStrokeTransparency = 0.6,
		})
	table.insert(feedEntries, { label = label, born = os.clock() })
	while #feedEntries > 7 do
		local e = table.remove(feedEntries, 1)
		if e then
			e.label:Destroy()
		end
	end
end

function Hud.setHint(text: string)
	refs.hint.Text = text
end

---------------------------------------------------------------------------
-- per-frame
---------------------------------------------------------------------------

local function screenArrowRotation(worldDir: Vector3): number
	local yaw = controllers.CameraController.getYaw()
	local camForward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local camRight = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	local x = worldDir:Dot(camRight)
	local y = worldDir:Dot(camForward)
	-- the glyph points right (+x screen) at 0 degrees; up the screen = -90
	return math.deg(math.atan2(-y, x))
end

function Hud.update(_dt: number)
	local state = Net.state()
	local t = now()
	local phase = state:GetAttribute("Phase") or "Boot"
	refs.scoreA.Text = tostring(state:GetAttribute("ScoreA") or 0)
	refs.scoreB.Text = tostring(state:GetAttribute("ScoreB") or 0)
	local matchEnd = state:GetAttribute("MatchEnd")
	local phaseEnd = state:GetAttribute("PhaseEnd")
	if phase == "Intermission" then
		refs.clock.Text = if type(phaseEnd) == "number" and phaseEnd > 0
			then Theme.formatTime(phaseEnd - t)
			else "--:--"
		refs.phase.Text = "WARMUP · press M to vote"
	else
		refs.clock.Text = if type(matchEnd) == "number" then Theme.formatTime(matchEnd - t) else "0:00"
		local label = string.upper(tostring(phase))
		if phase == "PointSetup" and type(phaseEnd) == "number" then
			label = "LINE UP  " .. math.max(0, math.ceil(phaseEnd - t))
		elseif phase == "PointOver" then
			label = "GOAL"
		elseif state:GetAttribute("Universe") then
			label = "UNIVERSE POINT"
		elseif state:GetAttribute("CapReached") then
			label = "CAP · FINISH THE POINT"
		end
		refs.phase.Text = label .. "  ·  " .. tostring(state:GetAttribute("ModeName") or "")
	end

	-- attack direction for my team
	local myTeam = if player.Character then player.Character:GetAttribute("UBTeam") else nil
	if (myTeam == "A" or myTeam == "B") and phase ~= "Intermission" then
		local side = state:GetAttribute(if myTeam == "A" then "AttackA" else "AttackB")
		local dir = if side == "East" then Vector3.new(1, 0, 0) else Vector3.new(-1, 0, 0)
		refs.attackArrow.Rotation = screenArrowRotation(dir)
		refs.attackArrow.TextColor3 = Theme.teamColor(myTeam)
		local offense = state:GetAttribute("Offense")
		refs.attackText.Text = if offense == myTeam
			then "YOUR DISC · ATTACK THIS WAY"
			else "DEFENSE · STOP THEM SCORING"
		refs.attackArrow.Visible = true
	else
		refs.attackArrow.Visible = false
		refs.attackText.Text = ""
	end

	-- wind
	local w = state:GetAttribute("Wind")
	if typeof(w) == "Vector3" and w.Magnitude > 0.1 then
		refs.wind.Visible = true
		refs.windArrow.Rotation = screenArrowRotation(Vector3.new(w.X, 0, w.Z).Unit)
		refs.windText.Text = string.format("WIND %.0f", w.Magnitude)
	else
		refs.wind.Visible = false
	end

	-- exertion and cooldowns
	local sim = controllers.MovementController.sim()
	local ex = sim.exertion / MovementConfig.ExertionMax
	refs.exertion.Size = UDim2.fromScale(math.clamp(ex, 0, 1), 1)
	refs.exertion.BackgroundColor3 = if ex > 0.5 then C.Good elseif ex > 0.2 then C.Gold else C.Bad
	for key, fill in refs.pips do
		local ready: number
		if key == "Air" then
			ready = if sim.airRedirectUsed then 0 else 1
		else
			ready = MovementSim.readiness(sim, key)
		end
		fill.Size = UDim2.fromScale(ready, 1)
		fill.BackgroundTransparency = if ready >= 1 then 0.45 else 0.75
	end

	-- combo feed fade + total
	local clock = os.clock()
	for i = #feedEntries, 1, -1 do
		local e = feedEntries[i]
		local age = clock - e.born
		if age > 2.4 then
			e.label:Destroy()
			table.remove(feedEntries, i)
		elseif age > 1.6 then
			e.label.TextTransparency = (age - 1.6) / 0.8
		end
	end
	local chain = ComboEvaluator.active(controllers.MovementController.combo(), t)
	if chain and chain.scoring >= 2 and controllers.SettingsController.get("ShowComboFeed") then
		local total = ComboEvaluator.total(chain)
		local tier = ComboEvaluator.tier(total)
		refs.comboTotal.Text = string.format("COMBO %d%s", total, if tier then "  · " .. tier else "")
	else
		refs.comboTotal.Text = ""
	end
	refs.feed.Visible = controllers.SettingsController.get("ShowComboFeed") ~= false

	-- stall
	local holderId = state:GetAttribute("HolderId")
	local stall: number = (state:GetAttribute("Stall") or 0) :: number
	local stallMax: number = (state:GetAttribute("StallMax") or 10) :: number
	local stallState = state:GetAttribute("StallState") or "None"
	local inPlay = phase == "Live" and type(holderId) == "number" and holderId ~= 0
	local involved = holderId == player.UserId or state:GetAttribute("MarkerId") == player.UserId
	refs.stall.Visible = inPlay and involved
	if inPlay then
		local text = "STALL " .. tostring(stall)
		if stallState == "DoubleTeam" then
			text = "DOUBLE TEAM"
		elseif stallState == "DiscSpace" then
			text = "DISC SPACE"
		elseif stallState == "Unmarked" then
			text = "NO MARK"
		end
		refs.stallText.Text = text
		refs.stallText.TextColor3 = if stall >= stallMax - 3
			then C.Bad
			elseif stall >= stallMax - 5 then C.Gold
			else C.Text
	end

	refs.crosshair.Visible = controllers.CameraController.isLocked()
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[--!strict
-- Menu — Play (votes, join, private rules), Training, Profile, Locker,
-- Leaderboard, Settings and Controls (rebinding + technique reference).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local ModesConfig = require(Shared.Config.Modes)
local ArenasConfig = require(Shared.Config.Arenas)
local InputConfig = require(Shared.Config.Input)
local MovementConfig = require(Shared.Config.Movement)
local DiscConfig = require(Shared.Config.Disc)
local ProgressionConfig = require(Shared.Config.Progression)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Menu = {}

local controllers: any
local player = Players.LocalPlayer
local refs: { [string]: any } = {}
local isOpen = false
local currentTab = "Play"
local profile: any = nil
local rebinding: { action: string, button: TextButton }? = nil
local launcher = { throwType = "Backhand", power = 0.5, pitch = 10, bank = 0, offset = 0 }

local TABS = { "Play", "Training", "Profile", "Locker", "Leaderboard", "Settings", "Controls" }

local DRILLS: { any } = {
	{ id = "Tutorial", name = "Movement School", desc = "Every technique, step by step.", pb = nil },
	{
		id = "Cutting",
		name = "Cutting Course",
		desc = "Slalom time trial. Keep your speed through the gates.",
		pb = "time",
	},
	{
		id = "Shuttle",
		name = "Momentum Shuttle",
		desc = "A-B-A-B-A. Reverse direction without losing it.",
		pb = "time",
	},
	{ id = "Aerial", name = "Aerial Catch", desc = "10 launches: floaters, skimmers, layouts.", pb = "score" },
	{ id = "Range", name = "Throwing Range", desc = "10 throws at static and moving rings.", pb = "score" },
	{ id = "Interception", name = "Interception Drill", desc = "Read the thrower. Get the D.", pb = "score" },
	{ id = "Combo", name = "Combo Lab", desc = "Land eight technique chains. Rebound walls inside.", pb = nil },
}

local TECH_GUIDE = {
	"SNAP CUT — sprint, then Cut while steering 25-115 deg away. Hold a line first: committed full-speed cuts are Perfect.",
	"MOMENTUM CANCEL — Cut while steering backward (or with no direction). Then Cut/Burst 0.10-0.32 s later to restart; 0.10-0.21 s is Perfect.",
	"FAKE COMMIT — Cut while running straight (or standing): a jab step. Cut away within 0.45 s for a Sold cut (always Perfect).",
	"BURST STEP — Burst. Short, explosive, 1.6 s cooldown. Free and Perfect out of a plant; Perfect within 0.15 s of a Snap Cut.",
	"SLIDE / SLIDE CUT — Slide while fast. Cut mid-slide to leave at a new angle (0.3-0.6 s into the slide is Perfect).",
	"AIR REDIRECT — Cut in the air: bend your path up to 80 deg once per jump. Near the apex = Perfect.",
	"PRECISION LANDING — Slide within 0.15 s before touching down (or 0.06 s after): no landing penalty. After a dive it is a Roll-out.",
	"LAYOUT — Dive. Huge reach forward. Recovery Chain: Cut/Burst/Jump as your slide stops (first 0.09 s = Perfect). Too early locks you out.",
	"WALL REBOUND — Jump beside a glowing Rebound wall while airborne (special arenas and the Combo Lab).",
	"REACH — Primary without the disc: extend toward your aim for a moment. Airborne reaches are Aerial Catch Adjustments.",
	"MARK — hold Secondary near the thrower: hands up. Aim low for wide hands, high to cover hammers. Jump to lift them.",
}

local function clear(frame: Instance)
	for _, ch in frame:GetChildren() do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
			ch:Destroy()
		end
	end
end

local function section(parent: Instance, title: string, order: number)
	Theme.label(title, 20, {
		Parent = parent,
		LayoutOrder = order,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Accent,
	})
end

local function row(parent: Instance, order: number, height: number?): Frame
	local f = make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, height or 40),
		LayoutOrder = order,
		Parent = parent,
		Theme.list(8, true),
	}) :: Frame;
	(f:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
	return f
end

local function action(kind: string, payload: any)
	Net.event("Action"):FireServer(kind, payload)
	controllers.AudioController.play("UiClick")
end

local function stepper(
	parent: Instance,
	order: number,
	label: string,
	value: string,
	onMinus: () -> (),
	onPlus: () -> ()
)
	local r = row(parent, order, 36)
	Theme.label(label, 15, { Parent = r, Size = UDim2.fromOffset(250, 30), LayoutOrder = 1 })
	local minus = Theme.button("-", { Parent = r, Size = UDim2.fromOffset(36, 30), LayoutOrder = 2 })
	Theme.label(
		value,
		15,
		{ Parent = r, Size = UDim2.fromOffset(90, 30), LayoutOrder = 3, TextXAlignment = Enum.TextXAlignment.Center }
	)
	local plus = Theme.button("+", { Parent = r, Size = UDim2.fromOffset(36, 30), LayoutOrder = 4 })
	minus.Activated:Connect(onMinus)
	plus.Activated:Connect(onPlus)
end

local function toggleRow(parent: Instance, order: number, label: string, value: boolean, onToggle: () -> ())
	local r = row(parent, order, 36)
	Theme.label(label, 15, { Parent = r, Size = UDim2.fromOffset(250, 30), LayoutOrder = 1 })
	local b = Theme.button(if value then "ON" else "OFF", {
		Parent = r,
		Size = UDim2.fromOffset(80, 30),
		LayoutOrder = 2,
		BackgroundColor3 = if value then C.Good else C.PanelLight,
		TextColor3 = if value then Color3.new(0, 0, 0) else C.Text,
	})
	b.Activated:Connect(onToggle)
end

---------------------------------------------------------------------------
-- tabs
---------------------------------------------------------------------------

local render: { [string]: (Instance) -> () } = {}

function render.Play(content: Instance)
	local state = Net.state()
	local phase = state:GetAttribute("Phase") or ""
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	section(content, "PLAY", nextOrder())
	Theme.label(
		string.format(
			"%s  ·  %s  ·  %s",
			tostring(phase),
			tostring(state:GetAttribute("ModeName") or "Warmup"),
			tostring(state:GetAttribute("ArenaName") or "")
		),
		15,
		{
			Parent = content,
			LayoutOrder = nextOrder(),
			TextColor3 = C.Muted,
		}
	)
	local role = if player.Character then player.Character:GetAttribute("UBRole") else nil
	local r = row(content, nextOrder(), 44)
	if role ~= "Match" then
		local join = Theme.button(
			"JOIN MATCH",
			{ Parent = r, LayoutOrder = 1, BackgroundColor3 = C.Accent, TextColor3 = Color3.new(0, 0, 0) }
		)
		join.Activated:Connect(function()
			action("JoinMatch", nil)
			Menu.toggle(false)
		end)
	end
	local train = Theme.button("TRAINING GROUNDS", { Parent = r, LayoutOrder = 2, Size = UDim2.fromOffset(200, 38) })
	train.Activated:Connect(function()
		action("EnterTraining", nil)
		Menu.toggle(false)
	end)

	if phase == "Intermission" then
		local counts: any = {}
		local okJson, decoded = pcall(function()
			return HttpService:JSONDecode(state:GetAttribute("VoteCounts") or "{}")
		end)
		if okJson and type(decoded) == "table" then
			counts = decoded
		end
		section(content, "VOTE: MODE", nextOrder())
		local mr = row(content, nextOrder(), 44)
		for i, id in string.split((state:GetAttribute("VoteModes") or "") :: string, ",") do
			local m = (ModesConfig.List :: any)[id]
			if m then
				local n = if counts.mode then counts.mode[id] or 0 else 0
				local b = Theme.button(
					string.format("%s (%d)", m.Display, n),
					{ Parent = mr, LayoutOrder = i, Size = UDim2.fromOffset(150, 38) }
				)
				b.Activated:Connect(function()
					action("Vote", { mode = id })
				end)
			end
		end
		section(content, "VOTE: ARENA", nextOrder())
		local ar = row(content, nextOrder(), 44)
		for i, id in string.split((state:GetAttribute("VoteArenas") or "") :: string, ",") do
			local a = (ArenasConfig.List :: any)[id]
			if a then
				local n = if counts.arena then counts.arena[id] or 0 else 0
				local b = Theme.button(
					string.format("%s (%d)", a.Display, n),
					{ Parent = ar, LayoutOrder = i, Size = UDim2.fromOffset(200, 38), TextSize = 13 }
				)
				b.Activated:Connect(function()
					action("Vote", { arena = id })
				end)
			end
		end
	end

	if state:GetAttribute("HostId") == player.UserId then
		section(content, "PRIVATE SERVER RULES (you are the host)", nextOrder())
		local current: any = {}
		pcall(function()
			current = HttpService:JSONDecode(state:GetAttribute("PrivateConfig") or "{}")
		end)
		local base = ModesConfig.copy("Casual")
		for key, spec in ModesConfig.Editable :: any do
			local value = if current[key] ~= nil then current[key] else (base :: any)[key]
			if spec.bool then
				toggleRow(content, nextOrder(), key, value == true, function()
					action("PrivateConfig", { key = key, value = not value })
					task.delay(0.3, Menu.refresh)
				end)
			elseif spec.options then
				local idx = table.find(spec.options, value) or 1
				stepper(content, nextOrder(), key, tostring(value), function()
					action("PrivateConfig", { key = key, value = spec.options[((idx - 2) % #spec.options) + 1] })
					task.delay(0.3, Menu.refresh)
				end, function()
					action("PrivateConfig", { key = key, value = spec.options[(idx % #spec.options) + 1] })
					task.delay(0.3, Menu.refresh)
				end)
			else
				stepper(content, nextOrder(), key, tostring(value), function()
					action("PrivateConfig", { key = key, value = value - spec.step })
					task.delay(0.3, Menu.refresh)
				end, function()
					action("PrivateConfig", { key = key, value = value + spec.step })
					task.delay(0.3, Menu.refresh)
				end)
			end
		end
		local sr = row(content, nextOrder(), 44)
		local start = Theme.button("START MATCH NOW", {
			Parent = sr,
			Size = UDim2.fromOffset(200, 38),
			BackgroundColor3 = C.Good,
			TextColor3 = Color3.new(0, 0, 0),
		})
		start.Activated:Connect(function()
			action("StartNow", nil)
			Menu.toggle(false)
		end)
	end

	section(content, "QUICK CONTROLS", nextOrder())
	Theme.label(
		"WASD move · Shift sprint · Space jump · Q cut · Ctrl slide · E dive · F burst · LMB reach/throw · RMB mark/fake · B celebrate",
		14,
		{
			Parent = content,
			LayoutOrder = nextOrder(),
			TextWrapped = true,
			Size = UDim2.new(1, -10, 0, 40),
			TextColor3 = C.Muted,
		}
	)
end

function render.Training(content: Instance)
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	section(content, "TRAINING GROUNDS", nextOrder())
	local r = row(content, nextOrder(), 44)
	local enter = Theme.button("GO TO TRAINING", {
		Parent = r,
		LayoutOrder = 1,
		Size = UDim2.fromOffset(180, 38),
		BackgroundColor3 = C.Accent,
		TextColor3 = Color3.new(0, 0, 0),
	})
	enter.Activated:Connect(function()
		action("EnterTraining", nil)
		Menu.toggle(false)
	end)
	local leave = Theme.button("BACK TO MATCH", { Parent = r, LayoutOrder = 2, Size = UDim2.fromOffset(180, 38) })
	leave.Activated:Connect(function()
		action("LeaveTraining", nil)
		Menu.toggle(false)
	end)
	local cancel = Theme.button("CANCEL DRILL", { Parent = r, LayoutOrder = 3, Size = UDim2.fromOffset(160, 38) })
	cancel.Activated:Connect(function()
		action("CancelDrill", nil)
	end)
	for _, d in DRILLS do
		local dr = row(content, nextOrder(), 46)
		local pbs = if profile then profile.personalBests else nil
		local pbValue = pbs and pbs[d.id]
		local pbText = if pbValue
			then (if d.pb == "time" then string.format("PB %.2f s", pbValue) else string.format("PB %d", pbValue))
			else ""
		local done = profile and profile.drillsDone and profile.drillsDone[d.id]
		Theme.label(
			(if done then "[x] " else "") .. d.name,
			16,
			{ Parent = dr, LayoutOrder = 1, Size = UDim2.fromOffset(200, 30), Font = Theme.Fonts.Heavy }
		)
		Theme.label(
			d.desc,
			13,
			{ Parent = dr, LayoutOrder = 2, Size = UDim2.fromOffset(330, 30), TextColor3 = C.Muted, TextWrapped = true }
		)
		Theme.label(pbText, 13, { Parent = dr, LayoutOrder = 3, Size = UDim2.fromOffset(90, 30), TextColor3 = C.Gold })
		local go = Theme.button("START", { Parent = dr, LayoutOrder = 4, Size = UDim2.fromOffset(80, 32) })
		go.Activated:Connect(function()
			action("StartDrill", d.id)
			Menu.toggle(false)
		end)
	end

	section(content, "FREE LAUNCHER (advanced practice)", nextOrder())
	stepper(content, nextOrder(), "Throw type", launcher.throwType, function()
		local i = table.find(DiscConfig.TypeOrder, launcher.throwType) or 1
		launcher.throwType = DiscConfig.TypeOrder[((i - 2) % #DiscConfig.TypeOrder) + 1]
		Menu.refresh()
	end, function()
		local i = table.find(DiscConfig.TypeOrder, launcher.throwType) or 1
		launcher.throwType = DiscConfig.TypeOrder[(i % #DiscConfig.TypeOrder) + 1]
		Menu.refresh()
	end)
	stepper(content, nextOrder(), "Power", string.format("%d%%", launcher.power * 100), function()
		launcher.power = math.clamp(launcher.power - 0.1, 0.1, 1)
		Menu.refresh()
	end, function()
		launcher.power = math.clamp(launcher.power + 0.1, 0.1, 1)
		Menu.refresh()
	end)
	stepper(content, nextOrder(), "Launch angle", launcher.pitch .. " deg", function()
		launcher.pitch = math.clamp(launcher.pitch - 4, -10, 40)
		Menu.refresh()
	end, function()
		launcher.pitch = math.clamp(launcher.pitch + 4, -10, 40)
		Menu.refresh()
	end)
	stepper(content, nextOrder(), "Curve (bank)", string.format("%+.1f", launcher.bank), function()
		launcher.bank = math.clamp(launcher.bank - 0.25, -1, 1)
		Menu.refresh()
	end, function()
		launcher.bank = math.clamp(launcher.bank + 0.25, -1, 1)
		Menu.refresh()
	end)
	stepper(content, nextOrder(), "Aim offset", launcher.offset .. " deg", function()
		launcher.offset = math.clamp(launcher.offset - 5, -30, 30)
		Menu.refresh()
	end, function()
		launcher.offset = math.clamp(launcher.offset + 5, -30, 30)
		Menu.refresh()
	end)
	local lr = row(content, nextOrder(), 44)
	local launch = Theme.button(
		"LAUNCH",
		{ Parent = lr, Size = UDim2.fromOffset(160, 38), BackgroundColor3 = C.Gold, TextColor3 = Color3.new(0, 0, 0) }
	)
	launch.Activated:Connect(function()
		local role = if player.Character then player.Character:GetAttribute("UBRole") else nil
		if role ~= "Training" then
			action("StartDrill", "Launcher")
			task.wait(0.4)
		end
		action("LaunchCustom", launcher)
		Menu.toggle(false)
	end)
	local setup = Theme.button("GO TO LAUNCHER", { Parent = lr, Size = UDim2.fromOffset(180, 38) })
	setup.Activated:Connect(function()
		action("StartDrill", "Launcher")
	end)
end

function render.Profile(content: Instance)
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	if not profile then
		Theme.label("Loading profile...", 16, { Parent = content, LayoutOrder = 1 })
		return
	end
	section(content, string.format("LEVEL %d", profile.level), nextOrder())
	local bar = make("Frame", {
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -10, 0, 10),
		LayoutOrder = nextOrder(),
		Parent = content,
		Theme.corner(5),
	})
	make("Frame", {
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(math.clamp(profile.xpInto / math.max(profile.xpNeed, 1), 0, 1), 1),
		Parent = bar,
		Theme.corner(5),
	})
	Theme.label(
		string.format(
			"%d / %d XP to next level%s",
			profile.xpInto,
			profile.xpNeed,
			if profile.persistent then "" else "  (not saved this session)"
		),
		13,
		{
			Parent = content,
			LayoutOrder = nextOrder(),
			TextColor3 = C.Muted,
		}
	)
	section(
		content,
		string.format(
			"RANKED: %s  %d  (peak %d, %d games)",
			profile.division,
			profile.rating,
			profile.peakRating,
			profile.ratedGames
		),
		nextOrder()
	)
	section(content, "CAREER", nextOrder())
	local keys = {
		"matches",
		"wins",
		"goals",
		"assists",
		"catches",
		"completions",
		"blocks",
		"interceptions",
		"layouts",
		"hucks",
		"callahans",
		"greatests",
		"perfectReleases",
		"techs",
	}
	local grid = make("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 130),
		LayoutOrder = nextOrder(),
		Parent = content,
	})
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(150, 26)
	layout.CellPadding = UDim2.fromOffset(6, 4)
	layout.Parent = grid
	for _, k in keys do
		Theme.label(string.format("%s: %d", k, profile.stats[k] or 0), 14, { Parent = grid })
	end
	section(content, "TECHNIQUE MASTERY", nextOrder())
	for tech, name in MovementConfig.TechNames :: any do
		local m = profile.techMastery and profile.techMastery[tech]
		if m and m.count > 0 then
			Theme.label(
				string.format(
					"%s  ·  %d performed  ·  %d%% Perfect",
					name,
					m.count,
					math.floor(m.perfect / m.count * 100)
				),
				14,
				{
					Parent = content,
					LayoutOrder = nextOrder(),
					TextColor3 = (Theme.TechColors :: any)[tech] or C.Text,
				}
			)
		end
	end
	section(content, "ACHIEVEMENTS", nextOrder())
	for _, a in profile.achievements do
		Theme.label(
			string.format(
				"%s %s — %s (%d/%d)",
				if a.done then "[x]" else "[ ]",
				a.name,
				a.description,
				a.progress,
				a.goal
			),
			14,
			{
				Parent = content,
				LayoutOrder = nextOrder(),
				TextColor3 = if a.done then C.Gold else C.Muted,
				TextWrapped = true,
				Size = UDim2.new(1, -10, 0, 34),
			}
		)
	end
end

function render.Locker(content: Instance)
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	if not profile then
		Theme.label("Loading profile...", 16, { Parent = content, LayoutOrder = 1 })
		return
	end
	Theme.label("Everything here is cosmetic. Nothing changes how you move, throw or catch.", 14, {
		Parent = content,
		LayoutOrder = nextOrder(),
		TextColor3 = C.Muted,
	})
	local slots = {
		{ key = "disc", title = "DISC SKINS", list = ProgressionConfig.DiscSkins },
		{ key = "trail", title = "TRAILS", list = ProgressionConfig.Trails },
		{ key = "celebration", title = "CELEBRATIONS", list = ProgressionConfig.Celebrations },
		{ key = "banner", title = "BANNERS", list = ProgressionConfig.Banners },
		{ key = "title", title = "TITLES", list = ProgressionConfig.Titles },
	}
	for _, slot in slots do
		section(content, slot.title, nextOrder())
		local r = make("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -10, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = nextOrder(),
			Parent = content,
		})
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.fromOffset(150, 34)
		grid.CellPadding = UDim2.fromOffset(6, 6)
		grid.Parent = r
		local unlocked = profile.unlocked[slot.key] or {}
		local equipped = profile.equipped[slot.key]
		for _, item in slot.list do
			local has = table.find(unlocked, item.id) ~= nil
			local label = item.name
			if not has then
				label = if item.level then (item.name .. " · Lv " .. item.level) else (item.name .. " · achievement")
			end
			local b = Theme.button(label, {
				Parent = r,
				TextSize = 12,
				BackgroundColor3 = if item.id == equipped then C.Accent elseif has then C.PanelLight else C.Panel,
				TextColor3 = if item.id == equipped then Color3.new(0, 0, 0) elseif has then C.Text else C.Muted,
			})
			if item.color then
				make("Frame", {
					BackgroundColor3 = item.color,
					BorderSizePixel = 0,
					Size = UDim2.new(0, 6, 1, -8),
					Position = UDim2.fromOffset(4, 4),
					Parent = b,
				})
			end
			if has then
				b.Activated:Connect(function()
					action("Equip", { slot = slot.key, id = item.id })
				end)
			end
		end
	end
end

function render.Leaderboard(content: Instance)
	section(content, "SEASON LEADERBOARD", 1)
	local status = Theme.label("Loading...", 14, { Parent = content, LayoutOrder = 2, TextColor3 = C.Muted })
	task.spawn(function()
		local ok, data = pcall(function()
			return Net.func("GetLeaderboard"):InvokeServer()
		end)
		if not ok or type(data) ~= "table" then
			status.Text = "Leaderboard unavailable."
			return
		end
		status.Text = "Season " .. tostring(data.season)
		if #data.entries == 0 then
			status.Text ..= " — no ranked results yet (or DataStores are unavailable in Studio)."
		end
		for i, e in data.entries do
			Theme.label(string.format("#%d  %s  ·  %d  ·  %s", e.rank, e.name, e.rating, e.division), 15, {
				Parent = content,
				LayoutOrder = 2 + i,
				TextColor3 = if e.userId == player.UserId then C.Gold else C.Text,
			})
		end
	end)
end

function render.Settings(content: Instance)
	local s = controllers.SettingsController
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	section(content, "SETTINGS", nextOrder())
	local numeric = {
		{ key = "MouseSensitivity", label = "Mouse sensitivity", step = 0.1, min = 0.2, max = 3 },
		{ key = "GamepadSensitivity", label = "Gamepad sensitivity", step = 0.1, min = 0.2, max = 3 },
		{ key = "TouchSensitivity", label = "Touch sensitivity", step = 0.1, min = 0.2, max = 3 },
		{ key = "FieldOfView", label = "Field of view", step = 2, min = 60, max = 90 },
		{ key = "TouchButtonScale", label = "Touch button size", step = 0.1, min = 0.7, max = 1.5 },
		{ key = "MasterVolume", label = "Master volume", step = 0.1, min = 0, max = 1 },
		{ key = "SfxVolume", label = "Effects volume", step = 0.1, min = 0, max = 1 },
		{ key = "CrowdVolume", label = "Crowd volume", step = 0.1, min = 0, max = 1 },
	}
	for _, n in numeric do
		local v = s.get(n.key)
		stepper(content, nextOrder(), n.label, string.format(if n.step < 1 then "%.1f" else "%d", v), function()
			s.set(n.key, math.clamp(math.floor((v - n.step) * 10 + 0.5) / 10, n.min, n.max))
			Menu.refresh()
		end, function()
			s.set(n.key, math.clamp(math.floor((v + n.step) * 10 + 0.5) / 10, n.min, n.max))
			Menu.refresh()
		end)
	end
	local toggles = {
		{ key = "InvertY", label = "Invert camera Y" },
		{ key = "CameraShake", label = "Camera shake (subtle)" },
		{ key = "ShowComboFeed", label = "Combo feed" },
		{ key = "ShowTechLabels", label = "Technique labels" },
		{ key = "TrajectoryPreview", label = "Throw preview arc" },
		{ key = "ToggleSprint", label = "Toggle sprint (instead of hold)" },
		{ key = "AutoSprintTouch", label = "Auto-sprint on touch (push stick fully)" },
		{ key = "LeftHanded", label = "Left-handed thrower" },
	}
	for _, t in toggles do
		toggleRow(content, nextOrder(), t.label, s.get(t.key) == true, function()
			s.set(t.key, not s.get(t.key))
			Menu.refresh()
		end)
	end
end

function render.Controls(content: Instance)
	local s = controllers.SettingsController
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	section(content, "CONTROLS (click a binding, then press the new key/button)", nextOrder())
	local kb = s.bindings("keyboard")
	local gp = s.bindings("gamepad")
	for _, act in InputConfig.Actions do
		local r = row(content, nextOrder(), 34)
		Theme.label(
			(InputConfig.Display :: any)[act] or act,
			14,
			{ Parent = r, LayoutOrder = 1, Size = UDim2.fromOffset(300, 28) }
		)
		local kbText = table.concat(kb[act] or {}, " / ")
		local b1 = Theme.button(
			if kbText ~= "" then kbText else "—",
			{ Parent = r, LayoutOrder = 2, Size = UDim2.fromOffset(170, 28), TextSize = 13 }
		)
		b1.Activated:Connect(function()
			rebinding = { action = act, button = b1 }
			b1.Text = "press a key..."
		end)
		Theme.label(
			table.concat(gp[act] or {}, " / "),
			13,
			{ Parent = r, LayoutOrder = 3, Size = UDim2.fromOffset(150, 28), TextColor3 = C.Muted }
		)
	end
	local rr = row(content, nextOrder(), 44)
	local reset = Theme.button("RESET TO DEFAULTS", { Parent = rr, Size = UDim2.fromOffset(200, 36) })
	reset.Activated:Connect(function()
		s.resetBindings()
		Menu.refresh()
	end)
	section(content, "TECHNIQUE GUIDE", nextOrder())
	for _, line in TECH_GUIDE do
		Theme.label(line, 13, {
			Parent = content,
			LayoutOrder = nextOrder(),
			TextWrapped = true,
			Size = UDim2.new(1, -10, 0, 36),
			TextColor3 = C.Muted,
			Font = Theme.Fonts.Medium,
		})
	end
end

---------------------------------------------------------------------------

function Menu.refresh()
	if not isOpen then
		return
	end
	local content = refs.content :: ScrollingFrame
	clear(content)
	content.CanvasPosition = Vector2.zero
	local fn = render[currentTab]
	if fn then
		fn(content)
	end
	for name, b in refs.tabButtons do
		b.BackgroundColor3 = if name == currentTab then C.Accent else C.PanelLight
		b.TextColor3 = if name == currentTab then Color3.new(0, 0, 0) else C.Text
	end
end

function Menu.toggle(open: boolean?)
	local target = if open == nil then not isOpen else open
	isOpen = target
	refs.dim.Visible = target
	controllers.InputController.setMenuOpen(target)
	rebinding = nil
	if target then
		Menu.refresh()
		if controllers.InputController.scheme() == "Gamepad" then
			GuiService.SelectedObject = refs.tabButtons[currentTab]
		end
	else
		GuiService.SelectedObject = nil
	end
end

function Menu.isOpen(): boolean
	return isOpen
end

function Menu.setProfile(p: any)
	profile = p
	if isOpen and (currentTab == "Profile" or currentTab == "Locker" or currentTab == "Training") then
		Menu.refresh()
	end
end

function Menu.build(parent: ScreenGui, c: any)
	controllers = c
	local dim = make("Frame", {
		Name = "MenuDim",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	refs.dim = dim
	local window = Theme.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.8, 0, 0.82, 0),
		ZIndex = 21,
		Parent = dim,
	})
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(980, 640)
	constraint.Parent = window
	Theme.label("ULTIMATE: BREAKPOINT", 24, {
		Parent = window,
		Position = UDim2.fromOffset(18, 12),
		Size = UDim2.fromOffset(400, 30),
		Font = Theme.Fonts.Heavy,
		ZIndex = 22,
	})
	local close = Theme.button("CLOSE (M)", {
		Parent = window,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(120, 32),
		ZIndex = 22,
	})
	close.Activated:Connect(function()
		Menu.toggle(false)
	end)
	local tabs = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 54),
		Size = UDim2.new(0, 160, 1, -68),
		Parent = window,
		Theme.list(6),
	})
	refs.tabButtons = {}
	for i, name in TABS do
		local b = Theme.button(string.upper(name), {
			Parent = tabs,
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 40),
			ZIndex = 22,
		})
		b.Activated:Connect(function()
			currentTab = name
			Menu.refresh()
		end)
		refs.tabButtons[name] = b
	end
	local content = make("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(190, 54),
		Size = UDim2.new(1, -204, 1, -68),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 22,
		Parent = window,
		Theme.list(8),
	})
	refs.content = content

	-- capture the next key press while rebinding
	UserInputService.InputBegan:Connect(function(input)
		local rb = rebinding
		if not rb or not isOpen then
			return
		end
		local t = input.UserInputType
		local name: string? = nil
		local scheme = "keyboard"
		if t == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				rebinding = nil
				Menu.refresh()
				return
			end
			name = input.KeyCode.Name
		elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			return -- clicks are for the UI itself
		elseif t == Enum.UserInputType.Gamepad1 then
			name = input.KeyCode.Name
			scheme = "gamepad"
		end
		if name then
			rebinding = nil
			controllers.SettingsController.setBinding(scheme, rb.action, { name })
			task.defer(Menu.refresh)
		end
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Mobile</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Mobile — touch controls with the full technique set.

	Left half: floating thumbstick (push it fully to auto-sprint, or use the
	SPRINT toggle). Right side: THROW/REACH (hold to charge), JUMP, CUT, SLIDE,
	DIVE, BURST, FAKE/MARK. While holding the disc, bank and type buttons
	appear. Dragging on empty screen space turns the camera.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Mobile = {}

local controllers: any
local refs: { [string]: any } = {}
local stickTouch: InputObject? = nil
local stickOrigin = Vector2.zero
local cameraTouches: { [InputObject]: Vector2 } = {}
local buttonTouches: { [InputObject]: boolean } = {}

local STICK_RADIUS = 64

local function circleButton(
	parent: Instance,
	name: string,
	text: string,
	pos: UDim2,
	size: number,
	color: Color3?
): TextButton
	local b = make("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or C.Panel,
		BackgroundTransparency = 0.25,
		Text = text,
		TextSize = if size > 80 then 16 else 12,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Text,
		AutoButtonColor = false,
		Parent = parent,
		Theme.corner(size) :: Instance,
		Theme.stroke(C.Stroke, 2, 0.2) :: Instance,
	}) :: TextButton
	return b
end

local function bindHold(button: TextButton, actionName: string)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			buttonTouches[input] = true
			button.BackgroundTransparency = 0.05
			controllers.InputController.fire(actionName, true)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			buttonTouches[input] = nil
			button.BackgroundTransparency = 0.25
			controllers.InputController.fire(actionName, false)
		end
	end)
end

function Mobile.build(parent: ScreenGui, c: any)
	controllers = c
	local layer = make("Frame", {
		Name = "Touch",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = parent,
	}) :: Frame
	refs.layer = layer

	local stickBase = make("Frame", {
		Name = "StickBase",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(STICK_RADIUS * 2, STICK_RADIUS * 2),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.6,
		Visible = false,
		Parent = layer,
		Theme.corner(STICK_RADIUS),
	}) :: Frame
	local knob = make("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = C.Text,
		BackgroundTransparency = 0.4,
		Parent = stickBase,
		Theme.corner(26),
	}) :: Frame
	refs.stickBase = stickBase
	refs.knob = knob

	local right = make("Frame", {
		Name = "Buttons",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(330, 300),
		BackgroundTransparency = 1,
		Parent = layer,
	})
	refs.buttons = right
	bindHold(circleButton(right, "Primary", "THROW\nREACH", UDim2.fromOffset(250, 220), 104, C.Accent), "Primary")
	bindHold(circleButton(right, "Jump", "JUMP", UDim2.fromOffset(150, 250), 70), "Jump")
	bindHold(circleButton(right, "Cut", "CUT", UDim2.fromOffset(160, 160), 66), "Cut")
	bindHold(circleButton(right, "Slide", "SLIDE", UDim2.fromOffset(60, 260), 60), "Slide")
	bindHold(circleButton(right, "Dive", "DIVE", UDim2.fromOffset(240, 110), 66), "Dive")
	bindHold(circleButton(right, "Burst", "BURST", UDim2.fromOffset(80, 175), 60), "Burst")
	bindHold(circleButton(right, "Secondary", "FAKE\nMARK", UDim2.fromOffset(310, 120), 58), "Secondary")
	local sprint = circleButton(right, "Sprint", "SPRINT", UDim2.fromOffset(40, 90), 54)
	sprint.Activated:Connect(function()
		controllers.InputController.toggleTouchSprint()
	end)

	local discRow = make("Frame", {
		Name = "DiscButtons",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -360, 1, -30),
		Size = UDim2.fromOffset(250, 60),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = layer,
		Theme.list(8, true),
	})
	refs.discRow = discRow
	for i, def in
		{ { "BankLeft", "< BANK" }, { "BankRight", "BANK >" }, { "TypeNext", "TYPE" }, { "LeadLock", "LEAD" } }
	do
		local b =
			Theme.button(def[2], { Parent = discRow, LayoutOrder = i, Size = UDim2.fromOffset(56, 52), TextSize = 12 })
		bindHold(b, def[1])
	end
	local menu = Theme.button("MENU", {
		Parent = layer,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(16, 66),
		Size = UDim2.fromOffset(70, 34),
		TextSize = 13,
	})
	menu.Activated:Connect(function()
		controllers.UIController.toggleMenu()
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if input.UserInputType ~= Enum.UserInputType.Touch or not layer.Visible or gameProcessed then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local screen = workspace.CurrentCamera.ViewportSize
		if pos.X < screen.X * 0.42 and stickTouch == nil then
			stickTouch = input
			stickOrigin = pos
			stickBase.Position = UDim2.fromOffset(pos.X, pos.Y)
			stickBase.Visible = true
		else
			cameraTouches[input] = pos
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if input == stickTouch then
			local delta = pos - stickOrigin
			if delta.Magnitude > STICK_RADIUS then
				delta = delta.Unit * STICK_RADIUS
			end
			knob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
			local v = delta / STICK_RADIUS
			controllers.InputController.setTouchStick(Vector2.new(v.X, -v.Y))
		elseif cameraTouches[input] then
			local last = cameraTouches[input]
			controllers.CameraController.addTouchDelta(pos - last)
			cameraTouches[input] = pos
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input == stickTouch then
			stickTouch = nil
			stickBase.Visible = false
			knob.Position = UDim2.fromScale(0.5, 0.5)
			controllers.InputController.setTouchStick(Vector2.zero)
		end
		cameraTouches[input] = nil
	end)
	local _ = Players
end

function Mobile.update()
	local touch = controllers.InputController.scheme() == "Touch"
	local layer = refs.layer :: Frame
	layer.Visible = touch and not controllers.InputController.menuOpen()
	if not touch then
		return
	end
	local scale = controllers.SettingsController.get("TouchButtonScale") or 1
	local uiScale = refs.buttons:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Parent = refs.buttons
	end
	(uiScale :: UIScale).Scale = scale
	refs.discRow.Visible = controllers.ThrowController.isHolding()
end

return Mobile
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
-- Panels — end-of-match summary, drill HUD and drill reports, nameplates.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Actors = require(Shared.Actors)
local ProgressionConfig = require(Shared.Config.Progression)
local TeamsConfig = require(Shared.Config.Teams)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local Panels = {}

local controllers: any
local player = Players.LocalPlayer
local refs: { [string]: any } = {}

local BANNERS: { [string]: Color3 } = {}
for _, b in ProgressionConfig.Banners do
	BANNERS[b.id] = b.color
end

local function now(): number
	return Net.now()
end

---------------------------------------------------------------------------
-- match summary
---------------------------------------------------------------------------

function Panels.showSummary(sum: any)
	local old = refs.summary
	if old then
		old:Destroy()
	end
	local panel = Theme.panel({
		Name = "Summary",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(720, 440),
		Parent = refs.root,
	})
	refs.summary = panel
	local winnerName = if sum.winner == "A"
		then TeamsConfig.A.Name
		elseif sum.winner == "B" then TeamsConfig.B.Name
		else "DRAW"
	Theme.label(winnerName .. " WIN", 34, {
		Parent = panel,
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextColor3 = Theme.teamColor(sum.winner),
	})
	Theme.label(
		string.format(
			"%d  -  %d   ·   %s%s",
			sum.score.A,
			sum.score.B,
			sum.mode or "",
			if sum.ranked then "  ·  RANKED" else ""
		),
		16,
		{
			Parent = panel,
			Position = UDim2.fromOffset(20, 54),
			Size = UDim2.new(1, -40, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = C.Muted,
		}
	)
	local list = make("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(20, 86),
		Size = UDim2.new(1, -40, 1, -130),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		Parent = panel,
		Theme.list(3),
	})
	Theme.label("PLAYER                          G    A    BLK  CAT  CMP  TO   HL", 13, {
		Parent = list,
		LayoutOrder = 0,
		TextColor3 = C.Muted,
		Font = Enum.Font.Code,
	})
	table.sort(sum.rows, function(a, b)
		if a.team ~= b.team then
			return a.team < b.team
		end
		return (a.goals + a.assists) > (b.goals + b.assists)
	end)
	for i, r in sum.rows do
		local name = string.sub(r.name .. string.rep(" ", 30), 1, 30)
		local mvp = if r.id == sum.mvp then " MVP" else ""
		local change = sum.ratingChanges and sum.ratingChanges[tostring(r.id)]
		local rating = if change then string.format("  %d (%+d)", change.new, change.new - change.old) else ""
		Theme.label(
			string.format(
				"%s  %-4d %-4d %-4d %-4d %-4d %-4d %-3d%s%s",
				name,
				r.goals,
				r.assists,
				r.blocks,
				r.catches,
				r.completions,
				r.turnovers,
				r.highlights,
				mvp,
				rating
			),
			13,
			{
				Parent = list,
				LayoutOrder = i,
				Font = Enum.Font.Code,
				TextColor3 = if r.id == player.UserId then C.Gold else Theme.teamColor(r.team),
			}
		)
	end
	Theme.label("Next match starts shortly · press M to vote", 13, {
		Parent = panel,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -12),
		Size = UDim2.new(1, -40, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
	})
	task.delay(12, function()
		if refs.summary == panel then
			panel:Destroy()
			refs.summary = nil
		end
	end)
end

---------------------------------------------------------------------------
-- drills
---------------------------------------------------------------------------

function Panels.drillHud(payload: any)
	local hud = refs.drillHud :: Frame
	if payload.clear then
		hud.Visible = false
		refs.drillTimer = nil
		return
	end
	hud.Visible = true
	refs.drillTitle.Text = payload.title or ""
	refs.drillText.Text = payload.text or ""
	refs.drillProgress.Size = UDim2.fromScale(math.clamp(payload.progress or 0, 0, 1), 1)
	refs.drillTimer = payload.timerStart
	local lines = 1
	for _ in string.gmatch(payload.text or "", "\n") do
		lines += 1
	end
	hud.Size = UDim2.fromOffset(420, 70 + lines * 18)
end

function Panels.drillReport(payload: any)
	local old = refs.report
	if old then
		old:Destroy()
	end
	local lines: { string } = payload.lines or {}
	local panel = Theme.panel({
		Name = "DrillReport",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 190),
		Size = UDim2.fromOffset(560, 70 + #lines * 22),
		Parent = refs.root,
	})
	refs.report = panel
	Theme.label(payload.title or "DRILL", 22, {
		Parent = panel,
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 28),
		Font = Theme.Fonts.Heavy,
		TextColor3 = if payload.pb then C.Gold else C.Text,
	})
	for i, line in lines do
		Theme.label(line, 15, {
			Parent = panel,
			Position = UDim2.fromOffset(16, 40 + (i - 1) * 22),
			Size = UDim2.new(1, -32, 0, 20),
			TextWrapped = true,
			TextColor3 = if string.find(line, "BEST") then C.Gold else C.Text,
		})
	end
	task.delay(10, function()
		if refs.report == panel then
			panel:Destroy()
			refs.report = nil
		end
	end)
end

---------------------------------------------------------------------------
-- nameplates
---------------------------------------------------------------------------

local plates: { [Model]: BillboardGui } = {}

local function plateFor(model: Model): BillboardGui?
	local existing = plates[model]
	if existing and existing.Parent then
		return existing
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local gui = make("BillboardGui", {
		Name = "UBPlate",
		Size = UDim2.fromOffset(180, 54),
		StudsOffset = Vector3.new(0, 2.6, 0),
		AlwaysOnTop = false,
		MaxDistance = 160,
		LightInfluence = 0,
		Adornee = head,
		Parent = refs.root,
	}) :: BillboardGui
	Theme.label("", 15, {
		Name = "Name",
		Parent = gui,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextStrokeTransparency = 0.4,
	})
	Theme.label("", 11, {
		Name = "Title",
		Parent = gui,
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.fromOffset(0, 36),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		TextStrokeTransparency = 0.6,
	})
	Theme.label("", 18, {
		Name = "Stall",
		Parent = gui,
		Size = UDim2.new(1, 0, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Gold,
		TextStrokeTransparency = 0.3,
	})
	plates[model] = gui
	return gui
end

local lastPlates = 0
function Panels.updateNameplates()
	local clock = os.clock()
	if clock - lastPlates < 0.2 then
		return
	end
	lastPlates = clock
	local state = Net.state()
	local holder = state:GetAttribute("HolderId")
	local stall = state:GetAttribute("Stall") or 0
	local live = state:GetAttribute("Phase") == "Live"
	local seen: { [Model]: boolean } = {}
	for _, model in Actors.characters() do
		if model ~= player.Character then
			seen[model] = true
			local gui = plateFor(model)
			if gui then
				local team = model:GetAttribute("UBTeam")
				local nameLabel = gui:FindFirstChild("Name") :: TextLabel
				local titleLabel = gui:FindFirstChild("Title") :: TextLabel
				local stallLabel = gui:FindFirstChild("Stall") :: TextLabel
				nameLabel.Text = tostring(model:GetAttribute("UBName") or model.Name)
				nameLabel.TextColor3 = Theme.teamColor(if type(team) == "string" then team else nil)
				local title = model:GetAttribute("UBTitle")
				local level = model:GetAttribute("UBLevel")
				titleLabel.Text = string.format(
					"%s%s",
					if type(title) == "string" then title else "",
					if type(level) == "number" then ("  ·  Lv " .. level) else ""
				)
				local banner = model:GetAttribute("UBBanner")
				titleLabel.TextColor3 = if type(banner) == "string" and BANNERS[banner]
					then BANNERS[banner]:Lerp(Color3.new(1, 1, 1), 0.5)
					else C.Muted
				local id = model:GetAttribute("UBId")
				stallLabel.Text = if live and id == holder then ("STALL " .. tostring(stall)) else ""
			end
		end
	end
	for model, gui in plates do
		if not seen[model] then
			gui:Destroy()
			plates[model] = nil
		end
	end
end

function Panels.update()
	local timer = refs.drillTimer
	if type(timer) == "number" then
		refs.drillClock.Text = string.format("%.2f s", now() - timer)
	else
		refs.drillClock.Text = ""
	end
	Panels.updateNameplates()
end

function Panels.build(parent: ScreenGui, c: any)
	controllers = c
	refs.root = parent
	local hud = Theme.panel({
		Name = "DrillHud",
		Position = UDim2.fromOffset(16, 66),
		Size = UDim2.fromOffset(420, 90),
		Parent = parent,
	})
	hud.Visible = false
	refs.drillHud = hud
	refs.drillTitle = Theme.label("", 18, {
		Parent = hud,
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -120, 0, 22),
		Font = Theme.Fonts.Heavy,
		TextColor3 = C.Accent,
	})
	refs.drillClock = Theme.label("", 18, {
		Parent = hud,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 8),
		Size = UDim2.fromOffset(100, 22),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.Gold,
		Font = Theme.Fonts.Heavy,
	})
	refs.drillText = Theme.label("", 14, {
		Parent = hud,
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 1, -50),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Theme.Fonts.Medium,
	})
	local bar = make("Frame", {
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -8),
		Size = UDim2.new(1, -28, 0, 5),
		Parent = hud,
		Theme.corner(3),
	})
	refs.drillProgress = make("Frame", {
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
		Theme.corner(3),
	})
	local _ = controllers
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Visual language for every screen: dark translucent panels, bold condensed
-- type, team colours as accents. `make` builds instance trees declaratively.

local Theme = {}

Theme.Colors = {
	Panel = Color3.fromRGB(14, 16, 24),
	PanelLight = Color3.fromRGB(28, 32, 44),
	Stroke = Color3.fromRGB(70, 80, 104),
	Text = Color3.fromRGB(240, 244, 250),
	Muted = Color3.fromRGB(150, 160, 180),
	Accent = Color3.fromRGB(90, 230, 255),
	Gold = Color3.fromRGB(255, 205, 70),
	Good = Color3.fromRGB(90, 240, 150),
	Bad = Color3.fromRGB(255, 90, 100),
	Perfect = Color3.fromRGB(255, 215, 80),
	Clean = Color3.fromRGB(210, 240, 255),
	Sloppy = Color3.fromRGB(255, 150, 90),
	Gassed = Color3.fromRGB(170, 170, 180),
	TeamA = Color3.fromRGB(32, 140, 255),
	TeamB = Color3.fromRGB(255, 120, 30),
}

Theme.Fonts = {
	Heavy = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
	Body = Enum.Font.Gotham,
}

-- Technique colours: each technique has a distinct, readable colour.
Theme.TechColors = {
	SnapCut = Color3.fromRGB(90, 230, 255),
	MomentumCancel = Color3.fromRGB(255, 120, 200),
	FakeCommit = Color3.fromRGB(200, 160, 255),
	BurstStep = Color3.fromRGB(255, 150, 40),
	Slide = Color3.fromRGB(230, 210, 150),
	SlideCut = Color3.fromRGB(250, 230, 120),
	Dive = Color3.fromRGB(255, 255, 255),
	RecoveryChain = Color3.fromRGB(120, 255, 170),
	AirRedirect = Color3.fromRGB(140, 180, 255),
	PrecisionLanding = Color3.fromRGB(255, 215, 80),
	WallRebound = Color3.fromRGB(255, 90, 200),
	AerialReach = Color3.fromRGB(180, 255, 255),
	Jump = Color3.fromRGB(200, 210, 230),
}

function Theme.qualityColor(q: string): Color3
	return (Theme.Colors :: any)[q] or Theme.Colors.Text
end

function Theme.teamColor(team: string?): Color3
	if team == "A" then
		return Theme.Colors.TeamA
	elseif team == "B" then
		return Theme.Colors.TeamB
	end
	return Theme.Colors.Muted
end

export type Props = { [any]: any }

-- make("Frame", { Size = ..., [1] = child, [2] = child })
function Theme.make(className: string, props: Props?): Instance
	local inst = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = inst
			elseif k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	return c
end

function Theme.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.Stroke
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

function Theme.padding(px: number): UIPadding
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	return p
end

function Theme.panel(props: Props?): Frame
	local f = Theme.make("Frame", {
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Theme.corner(12) :: Instance,
		Theme.stroke() :: Instance,
	}) :: Frame
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = f
			else
				(f :: any)[k] = v
			end
		end
	end
	return f
end

function Theme.label(text: string, size: number, props: Props?): TextLabel
	local l = Theme.make("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, size + 6),
	}) :: TextLabel
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = l
			else
				(l :: any)[k] = v
			end
		end
	end
	return l
end

function Theme.button(text: string, props: Props?): TextButton
	local b = Theme.make("TextButton", {
		BackgroundColor3 = Theme.Colors.PanelLight,
		BackgroundTransparency = 0.05,
		AutoButtonColor = true,
		Text = text,
		TextSize = 16,
		Font = Theme.Fonts.Bold,
		TextColor3 = Theme.Colors.Text,
		Size = UDim2.fromOffset(160, 38),
		Theme.corner(8) :: Instance,
		Theme.stroke(Theme.Colors.Stroke, 1, 0.4) :: Instance,
	}) :: TextButton
	if props then
		for k, v in props do
			if type(k) == "number" then
				(v :: Instance).Parent = b
			else
				(b :: any)[k] = v
			end
		end
	end
	return b
end

function Theme.list(padding: number?, horizontal: boolean?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	return l
end

function Theme.formatTime(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">ThrowHud</string>
              <string name="Source"><![CDATA[--!strict
-- ThrowHud — the thrower's panel: type, bank, release height, the power
-- meter with its Perfect band (and the Lead assist's ideal-power mark).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DiscConfig = require(Shared.Config.Disc)
local Theme = require(script.Parent.Theme)

local make = Theme.make
local C = Theme.Colors

local ThrowHud = {}

local controllers: any
local refs: { [string]: any } = {}

function ThrowHud.build(parent: ScreenGui, c: any)
	controllers = c
	local panel = Theme.panel({
		Name = "ThrowHud",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.fromOffset(300, 196),
		Parent = parent,
	})
	panel.Visible = false
	refs.panel = panel

	refs.type = Theme.label("BACKHAND", 26, {
		Parent = panel,
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.fromOffset(220, 30),
		Font = Theme.Fonts.Heavy,
	})
	refs.desc = Theme.label("", 12, {
		Parent = panel,
		Position = UDim2.fromOffset(14, 40),
		Size = UDim2.fromOffset(220, 30),
		TextColor3 = C.Muted,
		TextWrapped = true,
		Font = Theme.Fonts.Medium,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local types = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 74),
		Size = UDim2.fromOffset(230, 22),
		Parent = panel,
		Theme.list(4, true),
	})
	refs.typeChips = {}
	for i, id in DiscConfig.TypeOrder do
		local info = (DiscConfig.Types :: any)[id]
		local chip = make("TextLabel", {
			BackgroundColor3 = C.PanelLight,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(42, 22),
			Text = i .. " " .. info.Short,
			TextSize = 11,
			Font = Theme.Fonts.Bold,
			TextColor3 = C.Muted,
			LayoutOrder = i,
			Parent = types,
			Theme.corner(6),
		})
		refs.typeChips[id] = chip
	end

	-- bank indicator: a tilting disc
	local bankHolder = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 106),
		Size = UDim2.fromOffset(120, 40),
		Parent = panel,
	})
	refs.bankDisc = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(30, 20),
		Size = UDim2.fromOffset(48, 8),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bankHolder,
		Theme.corner(4),
	})
	refs.bankText = Theme.label("FLAT", 14, {
		Parent = bankHolder,
		Position = UDim2.fromOffset(62, 11),
		Size = UDim2.fromOffset(70, 18),
	})
	refs.height = Theme.label("MID", 14, {
		Parent = panel,
		Position = UDim2.fromOffset(150, 117),
		Size = UDim2.fromOffset(100, 18),
		TextColor3 = C.Accent,
	})
	refs.lead = Theme.label("", 13, {
		Parent = panel,
		Position = UDim2.fromOffset(14, 148),
		Size = UDim2.fromOffset(240, 16),
		TextColor3 = C.Good,
	})
	refs.keys = Theme.label("", 11, {
		Parent = panel,
		Position = UDim2.fromOffset(14, 168),
		Size = UDim2.fromOffset(240, 22),
		TextColor3 = C.Muted,
		TextWrapped = true,
		Font = Theme.Fonts.Medium,
	})

	-- power meter (vertical, right edge). Full = 100%; the gold band is the
	-- Perfect window; red above it is overcharge.
	local meter = make("Frame", {
		Name = "Meter",
		BackgroundColor3 = C.PanelLight,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -40, 0, 14),
		Size = UDim2.fromOffset(22, 168),
		Parent = panel,
		Theme.corner(6),
	})
	local scale = 1.4 -- meter shows up to 140% of the charge time
	local fullY = 1 - 1 / scale
	local perfectH = (DiscConfig.Throw.PerfectWindow / DiscConfig.Throw.ChargeTime) / scale
	make("Frame", {
		Name = "Perfect",
		BackgroundColor3 = C.Perfect,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, fullY - perfectH, 0),
		Size = UDim2.new(1, 0, perfectH, 0),
		ZIndex = 2,
		Parent = meter,
	})
	make("Frame", {
		Name = "Over",
		BackgroundColor3 = C.Bad,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, fullY - perfectH, 0),
		ZIndex = 2,
		Parent = meter,
	})
	refs.fill = make("Frame", {
		Name = "Fill",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 0),
		ZIndex = 3,
		Parent = meter,
		Theme.corner(6),
	})
	refs.ideal = make("Frame", {
		Name = "Ideal",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.Good,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 8, 0, 3),
		Position = UDim2.new(0, -4, 0.5, 0),
		ZIndex = 4,
		Visible = false,
		Parent = meter,
	})
	refs.scale = scale
end

function ThrowHud.update()
	local h = controllers.ThrowController.hud()
	local panel = refs.panel :: Frame
	panel.Visible = h.holding
	if not h.holding then
		return
	end
	local info = (DiscConfig.Types :: any)[h.throwType]
	refs.type.Text = string.upper(info.Display)
	refs.desc.Text = info.Description
	for id, chip in refs.typeChips do
		local selected = id == h.throwType
		chip.BackgroundColor3 = if selected then C.Accent else C.PanelLight
		chip.TextColor3 = if selected then Color3.new(0, 0, 0) else C.Muted
	end
	local bankDeg = h.bank / h.bankSteps * DiscConfig.Throw.BankRange
	refs.bankDisc.Rotation = bankDeg
	refs.bankText.Text = if h.bank == 0 then "FLAT" elseif h.bank > 0 then ("RIGHT " .. h.bank) else ("LEFT " .. -h.bank)
	refs.height.Text = h.height .. " RELEASE"
	refs.lead.Text = if h.leadLock then ("LEAD: " .. (h.leadName or "aim at a teammate")) else ""
	local scheme = controllers.InputController.scheme()
	refs.keys.Text = if scheme == "Gamepad"
		then "RT throw · LT fake · D-pad bank/type · B low · A hop · R3 lead"
		elseif scheme == "Touch" then "Hold THROW · FAKE · bank and type buttons"
		else "Hold LMB · RMB fake · Q/E bank · 1-5 type · Ctrl low · Space hop · R lead"
	local frac = math.clamp(h.charge / refs.scale, 0, 1)
	refs.fill.Size = UDim2.fromScale(1, frac)
	refs.fill.BackgroundColor3 = if h.phase == "Perfect"
		then C.Perfect
		elseif h.phase == "Over" then C.Bad
		else Color3.new(1, 1, 1)
	if h.idealPower then
		refs.ideal.Visible = true
		refs.ideal.Position = UDim2.new(0, -4, 1 - h.idealPower / refs.scale, 0)
	else
		refs.ideal.Visible = false
	end
end

return ThrowHud
]]></string>
